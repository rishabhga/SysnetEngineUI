@model List<ManageEngineWebApp.Models.SoftwareRepoDetails>
@{
    ViewData["Title"] = "Software Repository";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sorted = Model.OrderByDescending(x => x.uploaddate).ToList();
    var grouped = Model.GroupBy(s => s.SoftwareName).ToList();
    var newest = sorted.FirstOrDefault();
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

    :root {
        --brand: #00BCEB;
        --brand-dark: #0096BE;
        --brand-dim: rgba(0,188,235,.1);
        --border: #e2e8f0;
        --text: #0f172a;
        --muted: #64748b;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .repo-page {
        min-height: 100vh;
        background: radial-gradient(ellipse 90% 40% at 50% -5%, rgba(0,188,235,.06), transparent 55%), #f8fafc;
        padding: 1rem 1rem 2rem;
    }

    .page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }

    .page-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0 0 4px;
    }

    .title-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        flex-shrink: 0;
        background: linear-gradient(135deg,var(--brand),var(--brand-dark));
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(0,188,235,.3);
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: linear-gradient(135deg,var(--brand),var(--brand-dark));
        color: #fff;
        border-radius: 10px;
        font-family: inherit;
        font-size: .875rem;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(0,188,235,.3);
        transition: transform .15s, box-shadow .15s;
        white-space: nowrap;
    }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(0,188,235,.4);
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 12px 16px;
        box-shadow: 0 1px 3px rgba(0,0,0,.04);
        display: flex;
        align-items: center;
        gap: 16px;
        animation: fadeUp .4s cubic-bezier(.16,1,.3,1) both;
    }

        .stat-card:nth-child(2) {
            animation-delay: .05s;
        }

        .stat-card:nth-child(3) {
            animation-delay: .10s;
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 1.1rem;
    }

    .stat-value {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.1;
        font-family: 'JetBrains Mono',monospace;
        margin-bottom: 3px;
    }

    .stat-label {
        font-size: .75rem;
        color: var(--muted);
        font-weight: 500;
    }

    .table-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: 0 1px 3px rgba(0,0,0,.04);
        overflow: hidden;
        animation: fadeUp .4s .12s cubic-bezier(.16,1,.3,1) both;
    }

    .table-toolbar {
        padding: 14px 20px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 12px;
        background: #fafcfe;
    }

    .search-wrap {
        position: relative;
        flex: 1;
        max-width: 300px;
    }

        .search-wrap i {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: .75rem;
        }

    .search-input {
        width: 100%;
        padding: 8px 12px 8px 32px;
        border: 1.5px solid var(--border);
        border-radius: 8px;
        font-size: .825rem;
        font-family: inherit;
        outline: none;
        transition: border-color .15s, box-shadow .15s;
    }

        .search-input:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 3px var(--brand-dim);
        }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        padding: 12px 20px;
        text-align: left;
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .07em;
        color: var(--muted);
        background: #f8fafc;
        border-bottom: 1px solid var(--border);
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
    }

        thead th:hover {
            color: var(--text);
        }

    tbody tr {
        border-bottom: 1px solid #f1f5f9;
        transition: background .1s;
    }

        tbody tr:last-child {
            border-bottom: none;
        }

        tbody tr:hover {
            background: #f8feff;
        }

    td {
        padding: 10px 16px;
        vertical-align: middle;
    }

    .sw-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        flex-shrink: 0;
        background: linear-gradient(135deg,var(--brand),var(--brand-dark));
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0,188,235,.2);
    }

    .badge {
        display: inline-flex;
        align-items: center;
        padding: 2px 9px;
        border-radius: 99px;
        font-size: .7rem;
        font-weight: 600;
        letter-spacing: .02em;
    }

    .badge-latest {
        background: #eff9ff;
        color: #0284c7;
        border: 1px solid #bae6fd;
    }

    .badge-version {
        background: #f8fafc;
        color: #475569;
        border: 1px solid var(--border);
        font-family: 'JetBrains Mono',monospace;
    }

    .empty-state {
        text-align: center;
        padding: 72px 20px;
    }

    .empty-ring {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }

    .alert {
        padding: 12px 16px;
        border-radius: 10px;
        font-size: .84rem;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 20px;
        animation: fadeUp .3s ease both;
    }

    .alert-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
    }

    .alert-success {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #065f46;
    }

    @@media(max-width:639px) {
        .stats-grid {
            grid-template-columns: 1fr 1fr;
        }

            .stats-grid .stat-card:last-child {
                grid-column: span 2;
            }

        .page-header {
            flex-direction: column;
        }
    }

    /* Modal & Upload Styles */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.4);
        backdrop-filter: blur(4px);
        z-index: 10000;
        opacity: 0;
        transition: opacity 0.2s ease;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }
    .modal-overlay.active {
        display: flex;
        opacity: 1;
    }
    .modal-box {
        background: #fff;
        border-radius: 20px;
        width: 100%;
        max-width: 540px;
        box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
        transform: scale(0.95) translateY(10px);
        opacity: 0;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
    }
    .modal-overlay.active .modal-box {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
    .modal-header {
        padding: 20px 24px;
        background: linear-gradient(135deg, rgba(0,188,235,0.05), rgba(0,150,190,0.02));
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .modal-body { padding: 24px; }
    .modal-footer { padding: 16px 24px; border-top: 1px solid var(--border); background: #f8fafc; display: flex; justify-content: flex-end; gap: 12px; }

    .drop-zone {
        border: 2px dashed var(--border);
        border-radius: 12px;
        padding: 30px 20px;
        text-align: center;
        cursor: pointer;
        background: #fafcfe;
        transition: all 0.2s;
        margin-bottom: 16px;
    }
    .drop-zone:hover, .drop-zone.drag-over { border-color: var(--brand); background: var(--brand-dim); }
    .drop-zone.has-file { border-color: #10b981; background: rgba(16,185,129,0.05); border-style: solid; }
    .drop-zone.has-error { border-color: #ef4444; }

    .field-group { margin-bottom: 16px; }
    .field-label { display: block; font-size: 0.8rem; font-weight: 600; color: var(--text); margin-bottom: 6px; }
    .field-input { width: 100%; padding: 10px 12px; border: 1.5px solid var(--border); border-radius: 8px; font-size: 0.875rem; transition: all 0.15s; }
    .field-input:focus { border-color: var(--brand); outline: none; box-shadow: 0 0 0 3px var(--brand-dim); }
    .field-input.has-error { border-color: #ef4444; }
    .field-error { display: none; color: #ef4444; font-size: 0.75rem; margin-top: 4px; align-items: center; gap: 4px; }

    .progress-wrap { display: none; margin-top: 16px; }
    .progress-wrap.visible { display: block; }
    .progress-bar { height: 6px; background: #e2e8f0; border-radius: 10px; overflow: hidden; margin-bottom: 6px; }
    .progress-fill { height: 100%; width: 0%; background: var(--brand); transition: width 0.2s; }
</style>

<div class="repo-page">
    <div style="max-width:1100px;margin:0 auto;">

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle" style="margin-top:1px;flex-shrink:0;"></i>
                <span>@TempData["Message"]</span>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle" style="margin-top:1px;flex-shrink:0;"></i>
                <span>@TempData["Error"]</span>
            </div>
        }

        <div class="page-header">
            <div>
                <h1 class="page-title">
                    <div class="title-icon">
                        <i class="fas fa-boxes" style="color:#fff;font-size:.95rem;"></i>
                    </div>
                    Software Repository
                </h1>
                <p style="font-size:.84rem;color:var(--muted);margin:0;">
                    Manage software packages and versions
                </p>
            </div>
            @if (ManageEngineWebApp.Datacontext.RoleHelper.HasPermission(Context, "SoftwareRepo.Upload"))
            {
                <button type="button" onclick="openUploadModal()" class="btn-primary">
                    <i class="fas fa-plus"></i> Upload Package
                </button>
            }
        </div>

        @if (Model.Any())
        {
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon" style="background:rgba(0,188,235,.1);">
                        <i class="fas fa-layer-group" style="color:var(--brand);"></i>
                    </div>
                    <div>
                        <div class="stat-value">@Model.Count</div>
                        <div class="stat-label">Total Packages</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background:rgba(139,92,246,.1);">
                        <i class="fas fa-cube" style="color:#8b5cf6;"></i>
                    </div>
                    <div>
                        <div class="stat-value" style="color:#8b5cf6;">@grouped.Count</div>
                        <div class="stat-label">Unique Software</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background:rgba(16,185,129,.1);">
                        <i class="fas fa-clock" style="color:#10b981;"></i>
                    </div>
                    <div>
                        <div class="stat-value" style="color:#10b981;font-size:1.1rem;">
                            @(newest != null ? newest.uploaddate.ToString("MMM dd") : "—")
                        </div>
                        <div class="stat-label">Last Upload</div>
                    </div>
                </div>
            </div>
        }

        <div class="table-card">
            @if (Model.Any())
            {
                <div class="table-toolbar">
                    <div class="search-wrap">
                        <i class="fas fa-search"></i>
                        <input type="text" id="searchInput" class="search-input"
                               placeholder="Search packages…" oninput="filterTable(this.value)" />
                    </div>
                    <span id="rowCount"
                          style="font-size:.775rem;color:var(--muted);margin-left:auto;white-space:nowrap;">
                        @Model.Count package@(Model.Count != 1 ? "s" : "")
                    </span>
                </div>

                <div style="overflow-x:auto;">
                    <table id="softwareTable">
                        <thead>
                            <tr>
                                <th onclick="sortTable(0)">
                                    Software Name <i class="fas fa-sort" style="opacity:.35;"></i>
                                </th>
                                <th onclick="sortTable(1)">
                                    Version <i class="fas fa-sort" style="opacity:.35;"></i>
                                </th>
                                <th onclick="sortTable(2)">
                                    Upload Date <i class="fas fa-sort" style="opacity:.35;"></i>
                                </th>
                                <th>Age</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody">
                            @foreach (var item in sorted)
                            {
                                bool isLatest = item.Id == newest?.Id;
                                var age = DateTime.Now - item.uploaddate;
                                string ageStr = age.TotalDays < 1 ? "Today"
                                : age.TotalDays < 2 ? "Yesterday"
                                : age.TotalDays < 30 ? $"{(int)age.TotalDays}d ago"
                                : age.TotalDays < 365 ? $"{(int)(age.TotalDays / 30)}mo ago"
                                : $"{(int)(age.TotalDays / 365)}y ago";

                                <tr class="data-row">
                                    <td>
                                        <div style="display:flex;align-items:center;gap:12px;">
                                            <div class="sw-icon">
                                                <i class="fas fa-cube" style="color:#fff;font-size:.8rem;"></i>
                                            </div>
                                            <div>
                                                <div style="font-size:.875rem;font-weight:600;color:var(--text);">
                                                    @item.SoftwareName
                                                </div>
                                                @if (isLatest)
                                                {
                                                    <span class="badge badge-latest" style="margin-top:2px;">
                                                        <i class="fas fa-star" style="font-size:.55rem;margin-right:3px;"></i>
                                                        latest
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge badge-version">v@item.Version</span>
                                    </td>
                                    <td style="font-size:.84rem;color:var(--muted);">
                                        @item.uploaddate.ToString("dd MMM yyyy")
                                        <span style="font-family:'JetBrains Mono',monospace;font-size:.75rem;
                                                         opacity:.6;margin-left:4px;">
                                            @item.uploaddate.ToString("HH:mm")
                                        </span>
                                    </td>
                                    <td>
                                        <span style="font-size:.775rem;color:#94a3b8;background:#f8fafc;
                                                         border:1px solid var(--border);
                                                         padding:2px 8px;border-radius:6px;">
                                            @ageStr
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-ring">
                        <i class="fas fa-box-open" style="font-size:1.6rem;color:#cbd5e1;"></i>
                    </div>
                    <p style="font-weight:600;color:var(--text);margin:0 0 6px;">No packages yet</p>
                    <p style="font-size:.84rem;color:var(--muted);margin:0 0 24px;">
                        Upload your first software package to get started
                    </p>
                    @if (ManageEngineWebApp.Datacontext.RoleHelper.HasPermission(Context, "SoftwareRepo.Upload"))
                    {
                        <a href="@Url.Action("Upload")" class="btn-primary">
                            <i class="fas fa-cloud-upload-alt"></i> Upload Now
                        </a>
                    }
                </div>
            }
        </div>

        </div>

    </div>
</div>

<!-- Upload Modal -->
<div id="uploadModal" class="modal-overlay" onclick="if(event.target===this) closeUploadModal()">
    <form id="uploadForm" class="modal-box" onsubmit="handleUpload(event)">
        @Html.AntiForgeryToken()
        <div class="modal-header">
            <div style="display:flex;align-items:center;gap:12px;">
                <div style="width:36px;height:36px;border-radius:10px;background:var(--brand);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 10px var(--brand-glow);">
                    <i class="fas fa-cloud-upload-alt" style="color:#fff;font-size:0.9rem;"></i>
                </div>
                <h3 style="margin:0;font-size:1rem;font-weight:700;color:var(--text);">Upload Package</h3>
            </div>
            <button type="button" onclick="closeUploadModal()" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:1.1rem;padding:4px;"><i class="fas fa-times"></i></button>
        </div>
        <div class="modal-body">
            <div id="modalAlertArea"></div>
            
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div class="field-group">
                    <label class="field-label">Software Name</label>
                    <input type="text" id="swName" name="softwareName" class="field-input" placeholder="e.g. Chrome" />
                    <div id="err-softwareName" class="field-error"><i class="fas fa-exclamation-circle"></i> <span></span></div>
                </div>
                <div class="field-group">
                    <label class="field-label">Version</label>
                    <input type="text" id="swVer" name="version" class="field-input" placeholder="e.g. 1.0.2" />
                    <div id="err-version" class="field-error"><i class="fas fa-exclamation-circle"></i> <span></span></div>
                </div>
            </div>

            <div class="field-group">
                <label class="field-label">Software File</label>
                <input type="file" id="fileInput" name="file" style="display:none;" onchange="onFileChosen(this)" />
                <div id="dropZone" class="drop-zone" onclick="document.getElementById('fileInput').click()" 
                     ondragover="event.preventDefault();this.classList.add('drag-over')" 
                     ondragleave="this.classList.remove('drag-over')" 
                     ondrop="handleDrop(event)">
                    
                    <div id="dropDefault">
                        <i class="fas fa-file-export" style="color:var(--brand);font-size:1.5rem;margin-bottom:8px;display:block;"></i>
                        <p style="font-size:0.85rem;font-weight:600;margin:0;color:var(--text);">Click or drop file here</p>
                        <p style="font-size:0.75rem;color:var(--muted);margin:4px 0 0;">.exe, .msi, .zip, etc.</p>
                    </div>

                    <div id="dropSelected" style="display:none;align-items:center;justify-content:center;gap:12px;">
                        <div style="width:38px;height:38px;border-radius:8px;background:rgba(16,185,129,0.1);display:flex;align-items:center;justify-content:center;">
                            <i class="fas fa-file-check" style="color:#10b981;"></i>
                        </div>
                        <div style="text-align:left;min-width:0;flex:1;">
                            <p id="selFileName" style="font-size:0.85rem;font-weight:600;margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"></p>
                            <p id="selFileSize" style="font-size:0.7rem;color:var(--muted);margin:0;"></p>
                        </div>
                        <button type="button" onclick="clearFile(event)" style="background:none;border:none;color:#ef4444;cursor:pointer;padding:4px;"><i class="fas fa-trash-alt"></i></button>
                    </div>
                </div>
                <div id="err-file" class="field-error" style="margin-top:-8px;margin-bottom:8px;"><i class="fas fa-exclamation-circle"></i> <span></span></div>
            </div>

            <div id="progWrap" class="progress-wrap">
                <div style="display:flex;justify-content:between;font-size:0.75rem;margin-bottom:4px;">
                    <span id="progLabel">Uploading...</span>
                    <span id="progPct" style="margin-left:auto;font-weight:700;color:var(--brand);">0%</span>
                </div>
                <div class="progress-bar"><div id="progFill" class="progress-fill"></div></div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" onclick="closeUploadModal()" style="padding:8px 16px;border-radius:8px;border:1px solid #e2e8f0;background:#fff;color:var(--muted);font-size:0.85rem;font-weight:600;cursor:pointer;">Cancel</button>
            <button type="submit" id="subBtn" style="padding:8px 20px;border-radius:8px;border:none;background:var(--brand);color:#fff;font-size:0.85rem;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:8px;box-shadow:0 4px 10px var(--brand-glow);">
                <i class="fas fa-cloud-upload-alt"></i> <span id="subBtnText">Upload Package</span>
            </button>
        </div>
    </form>
</div>

<script>
    function openUploadModal() {
        document.getElementById('uploadModal').classList.add('active');
        document.getElementById('uploadForm').reset();
        clearFile(null);
        ['softwareName','version','file'].forEach(clearFieldErr);
        document.getElementById('modalAlertArea').innerHTML = '';
        document.getElementById('progWrap').classList.remove('visible');
    }

    function closeUploadModal() {
        if(document.getElementById('subBtn').disabled) return;
        document.getElementById('uploadModal').classList.remove('active');
    }

    function onFileChosen(input) {
        if (!input.files || !input.files.length) return;
        const f = input.files[0];
        document.getElementById('selFileName').textContent = f.name;
        document.getElementById('selFileSize').textContent = (f.size / (1024 * 1024)).toFixed(2) + ' MB';
        document.getElementById('dropDefault').style.display = 'none';
        document.getElementById('dropSelected').style.display = 'flex';
        document.getElementById('dropZone').classList.add('has-file');
        clearFieldErr('file');
    }

    function clearFile(e) {
        if(e) e.stopPropagation();
        document.getElementById('fileInput').value = '';
        document.getElementById('dropDefault').style.display = 'block';
        document.getElementById('dropSelected').style.display = 'none';
        document.getElementById('dropZone').classList.remove('has-file');
    }

    function handleDrop(e) {
        e.preventDefault();
        this.classList.remove('drag-over');
        if (e.dataTransfer.files.length > 0) {
            const input = document.getElementById('fileInput');
            input.files = e.dataTransfer.files;
            onFileChosen(input);
        }
    }

    function showFieldErr(id, msg) {
        const field = id === 'file' ? document.getElementById('dropZone') : document.getElementById('sw'+id.charAt(0).toUpperCase() + id.slice(1));
        const errBox = document.getElementById('err-' + id);
        if(field) field.classList.add('has-error');
        if(errBox) { errBox.querySelector('span').textContent = msg; errBox.style.display = 'flex'; }
    }

    function clearFieldErr(id) {
        const field = id === 'file' ? document.getElementById('dropZone') : document.getElementById('sw'+id.charAt(0).toUpperCase() + id.slice(1));
        const errBox = document.getElementById('err-' + id);
        if(field) field.classList.remove('has-error');
        if(errBox) errBox.style.display = 'none';
    }

    function handleUpload(e) {
        e.preventDefault();
        ['softwareName','version','file'].forEach(clearFieldErr);
        
        const name = document.getElementById('swName').value.trim();
        const ver = document.getElementById('swVer').value.trim();
        const file = document.getElementById('fileInput').files[0];

        let hasErr = false;
        if(!name) { showFieldErr('softwareName', 'Name is required'); hasErr = true; }
        if(!ver) { showFieldErr('version', 'Version is required'); hasErr = true; }
        if(!file) { showFieldErr('file', 'File is required'); hasErr = true; }
        if(hasErr) return;

        const fd = new FormData(e.target);
        const subBtn = document.getElementById('subBtn');
        const subText = document.getElementById('subBtnText');
        const progWrap = document.getElementById('progWrap');
        const progFill = document.getElementById('progFill');
        const progPct = document.getElementById('progPct');

        subBtn.disabled = true;
        subText.textContent = 'Uploading...';
        progWrap.classList.add('visible');

        const xhr = new XMLHttpRequest();
        xhr.upload.addEventListener('progress', p => {
            if(p.lengthComputable) {
                const pct = Math.round((p.loaded / p.total) * 100);
                progFill.style.width = pct + '%';
                progPct.textContent = pct + '%';
                document.getElementById('progLabel').textContent = pct < 100 ? 'Uploading...' : 'Processing...';
            }
        });

        xhr.onload = function() {
            try {
                const res = JSON.parse(xhr.responseText);
                if(res.success) {
                    window.sysAlert('Software package uploaded successfully!', 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    subBtn.disabled = false; subText.textContent = 'Upload Package';
                    res.errors?.forEach(err => {
                        const lowErr = err.toLowerCase();
                        if(lowErr.includes('name')) showFieldErr('softwareName', err);
                        else if(lowErr.includes('version')) showFieldErr('version', err);
                        else if(lowErr.includes('file')) showFieldErr('file', err);
                    });
                }
            } catch(e) {
                subBtn.disabled = false; subText.textContent = 'Upload Package';
                console.error("Parse error", e);
            }
        };
        
        xhr.onerror = () => {
             subBtn.disabled = false; subText.textContent = 'Upload Package';
             window.sysAlert('Network error occurred.', 'error');
        };

        xhr.open('POST', '@Url.Action("Upload", "SoftwareRepo")');
        xhr.send(fd);
    }

    function filterTable(q) {
        q = q.toLowerCase();
        let n = 0;
        document.querySelectorAll('#tableBody .data-row').forEach(row => {
            const show = row.textContent.toLowerCase().includes(q);
            row.style.display = show ? '' : 'none';
            if (show) n++;
        });
        const el = document.getElementById('rowCount');
        if (el) el.textContent = `${n} package${n !== 1 ? 's' : ''}`;
    }

    let sortDir = {};
    function sortTable(col) {
        const tbody = document.getElementById('tableBody');
        const rows  = Array.from(tbody.querySelectorAll('.data-row'));
        sortDir[col] = !sortDir[col];
        rows.sort((a, b) => {
            const av = a.cells[col]?.textContent.trim() ?? '';
            const bv = b.cells[col]?.textContent.trim() ?? '';
            return sortDir[col] ? av.localeCompare(bv) : bv.localeCompare(av);
        });
        rows.forEach(r => tbody.appendChild(r));
    }
</script>
