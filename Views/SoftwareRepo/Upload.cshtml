@{
    ViewData["Title"] = "Upload Software";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string swName = ViewBag.SoftwareName as string ?? "";
    string swVer = ViewBag.Version as string ?? "";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

    :root {
        --brand: #00BCEB;
        --brand-dark: #0096BE;
        --brand-dim: rgba(0,188,235,.12);
        --brand-glow: rgba(0,188,235,.35);
        --border: #e2e8f0;
        --text: #0f172a;
        --muted: #64748b;
        --error: #ef4444;
        --success: #10b981;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .upload-bg {
        min-height: 100vh;
        background: radial-gradient(ellipse 80% 50% at 50% -10%, rgba(0,188,235,.08), transparent 60%), #f8fafc;
        padding: 40px 20px 60px;
    }

    .upload-card {
        max-width: 620px;
        margin: 0 auto;
        background: #fff;
        border-radius: 20px;
        border: 1px solid var(--border);
        box-shadow: 0 1px 3px rgba(0,0,0,.04), 0 8px 32px rgba(0,0,0,.06);
        overflow: hidden;
        animation: fadeUp .4s cubic-bezier(.16,1,.3,1) both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .card-header {
        padding: 26px 30px 22px;
        background: linear-gradient(135deg, rgba(0,188,235,.07), rgba(0,150,190,.04));
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .header-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        flex-shrink: 0;
        background: linear-gradient(135deg, var(--brand), var(--brand-dark));
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 14px var(--brand-glow);
    }

    .card-body {
        padding: 30px;
        display: flex;
        flex-direction: column;
        gap: 22px;
    }

    .field-label {
        display: block;
        font-size: .8125rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 6px;
        letter-spacing: .02em;
    }

        .field-label .req {
            color: var(--error);
            margin-left: 2px;
        }

    .field-input {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        font-size: .875rem;
        font-family: inherit;
        color: var(--text);
        background: #fff;
        outline: none;
        box-sizing: border-box;
        transition: border-color .15s, box-shadow .15s;
    }

        .field-input:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 3px var(--brand-dim);
        }

        .field-input.has-error {
            border-color: var(--error);
        }

            .field-input.has-error:focus {
                box-shadow: 0 0 0 3px rgba(239,68,68,.1);
            }

    .mono {
        font-family: 'JetBrains Mono', monospace;
    }

    .field-error {
        display: none;
        align-items: center;
        gap: 5px;
        font-size: .76rem;
        color: var(--error);
        margin-top: 5px;
    }

    .fields-row {
        display: grid;
        gap: 18px;
    }

    @@media(min-width:540px) {
        .fields-row {
            grid-template-columns: 1fr 1fr;
        }
    }

    #dropZone {
        border: 2px dashed var(--border);
        border-radius: 14px;
        padding: 34px 20px;
        text-align: center;
        cursor: pointer;
        background: #fafcfe;
        transition: border-color .2s, background .2s, transform .15s;
    }

        #dropZone:hover, #dropZone.drag-over {
            border-color: var(--brand);
            background: var(--brand-dim);
            transform: scale(1.005);
        }

        #dropZone.has-file {
            border-color: var(--success);
            border-style: solid;
            background: rgba(16,185,129,.05);
        }

        #dropZone.has-error {
            border-color: var(--error);
        }

    .drop-ring {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        margin: 0 auto 12px;
        background: linear-gradient(135deg, var(--brand-dim), rgba(0,150,190,.08));
        border: 1.5px solid rgba(0,188,235,.25);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform .2s;
    }

    #dropZone:hover .drop-ring {
        transform: scale(1.1);
    }

    #progressWrapper {
        display: none;
        flex-direction: column;
        gap: 8px;
    }

        #progressWrapper.visible {
            display: flex;
        }

    .progress-track {
        width: 100%;
        height: 6px;
        background: #e2e8f0;
        border-radius: 99px;
        overflow: hidden;
    }

    #progressFill {
        height: 100%;
        width: 0%;
        border-radius: 99px;
        background: linear-gradient(90deg, var(--brand), var(--brand-dark));
        transition: width .2s ease;
    }

    .alert {
        padding: 12px 16px;
        border-radius: 10px;
        font-size: .84rem;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        animation: fadeUp .3s ease both;
    }

    .alert-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
    }

    .alert-success {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #065f46;
    }

    #submitBtn {
        padding: 11px 26px;
        background: linear-gradient(135deg, var(--brand), var(--brand-dark));
        color: #fff;
        border: none;
        border-radius: 10px;
        font-family: inherit;
        font-size: .875rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 14px var(--brand-glow);
        transition: transform .15s, box-shadow .15s, opacity .15s;
    }

        #submitBtn:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px var(--brand-glow);
        }

        #submitBtn:disabled {
            opacity: .65;
            cursor: not-allowed;
            transform: none;
        }

    .btn-cancel {
        padding: 11px 18px;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        font-family: inherit;
        font-size: .875rem;
        font-weight: 500;
        color: var(--muted);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: border-color .15s, color .15s;
    }

        .btn-cancel:hover {
            border-color: #94a3b8;
            color: var(--text);
        }

    .spinner {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,.35);
        border-top-color: #fff;
        animation: spin .7s linear infinite;
        flex-shrink: 0;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .breadcrumb {
        max-width: 620px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .8rem;
        color: var(--muted);
    }

        .breadcrumb a {
            color: var(--muted);
            text-decoration: none;
            transition: color .15s;
        }

            .breadcrumb a:hover {
                color: var(--brand);
            }

        .breadcrumb .current {
            color: var(--text);
            font-weight: 600;
        }
</style>

<div class="upload-bg">

    <nav class="breadcrumb">
        <a href="@Url.Action("Index")">
            <i class="fas fa-arrow-left" style="font-size:.7rem;"></i> Repository
        </a>
        <span style="opacity:.35;">›</span>
        <span class="current">Upload Package</span>
    </nav>

    <div id="alertArea" style="max-width:620px;margin:0 auto 16px;"></div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error" style="max-width:620px;margin:0 auto 16px;">
            <i class="fas fa-exclamation-circle" style="flex-shrink:0;margin-top:1px;"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <div class="upload-card">

        <div class="card-header">
            <div class="header-icon">
                <i class="fas fa-cloud-upload-alt" style="color:#fff;font-size:1.1rem;"></i>
            </div>
            <div>
                <h1 style="font-size:1.05rem;font-weight:700;color:#0f172a;margin:0 0 2px;">
                    Upload Software Package
                </h1>
                <p style="font-size:.82rem;color:#64748b;margin:0;">
                    Add a new software package to the repository
                </p>
            </div>
        </div>

        <form id="uploadForm"
              asp-action="Upload"
              asp-controller="SoftwareRepo"
              method="post"
              enctype="multipart/form-data"
              novalidate>

            <div class="card-body">

                <div class="fields-row">
                    <div>
                        <label class="field-label" for="softwareName">
                            Software Name<span class="req">*</span>
                        </label>
                        <input type="text" id="softwareName" name="softwareName"
                               class="field-input" value="@swName"
                               placeholder="e.g. Chrome, 7-Zip" autocomplete="off" />
                        <div class="field-error" id="err-softwareName">
                            <i class="fas fa-circle-exclamation" style="font-size:.7rem;"></i>
                            <span></span>
                        </div>
                    </div>
                    <div>
                        <label class="field-label" for="version">
                            Version<span class="req">*</span>
                        </label>
                        <input type="text" id="version" name="version"
                               class="field-input mono" value="@swVer"
                               placeholder="e.g. 1.0.0, 22.04" autocomplete="off" />
                        <div class="field-error" id="err-version">
                            <i class="fas fa-circle-exclamation" style="font-size:.7rem;"></i>
                            <span></span>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="field-label">
                        Software File<span class="req">*</span>
                    </label>
                    <input type="file" id="fileInput" name="file"
                           class="sr-only" onchange="onFileChosen(this)" />

                    <div id="dropZone"
                         onclick="document.getElementById('fileInput').click()"
                         ondragover="handleDragOver(event)"
                         ondragleave="handleDragLeave(event)"
                         ondrop="handleDrop(event)">

                        <div id="dropDefault">
                            <div class="drop-ring">
                                <i class="fas fa-cloud-upload-alt"
                                   style="color:var(--brand);font-size:1.25rem;"></i>
                            </div>
                            <p style="font-size:.875rem;font-weight:600;color:#0f172a;margin:0 0 4px;">
                                Drop your file here
                            </p>
                            <p style="font-size:.78rem;color:#94a3b8;margin:0;">
                                or <span style="color:var(--brand);text-decoration:underline;">browse</span>
                                &nbsp;·&nbsp; .exe .msi .zip .tar.gz and more
                            </p>
                        </div>

                        <div id="dropSelected" style="display:none;">
                            <div style="display:flex;align-items:center;gap:14px;justify-content:center;">
                                <div style="width:42px;height:42px;border-radius:12px;flex-shrink:0;
                                            background:rgba(16,185,129,.12);
                                            display:flex;align-items:center;justify-content:center;">
                                    <i class="fas fa-file-alt" style="color:#10b981;font-size:1rem;"></i>
                                </div>
                                <div style="text-align:left;min-width:0;">
                                    <p id="selectedFileName"
                                       style="font-size:.875rem;font-weight:600;color:#0f172a;
                                              margin:0 0 2px;max-width:280px;overflow:hidden;
                                              text-overflow:ellipsis;white-space:nowrap;"></p>
                                    <p id="selectedFileSize"
                                       style="font-size:.75rem;color:#94a3b8;margin:0;
                                              font-family:'JetBrains Mono',monospace;"></p>
                                </div>
                                <button type="button" onclick="clearFile(event)"
                                        style="background:none;border:none;cursor:pointer;padding:4px;
                                               border-radius:6px;color:#94a3b8;font-size:1.1rem;
                                               transition:color .15s;"
                                        onmouseover="this.style.color='#ef4444'"
                                        onmouseout="this.style.color='#94a3b8'">
                                    <i class="fas fa-times-circle"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="field-error" id="err-file">
                        <i class="fas fa-circle-exclamation" style="font-size:.7rem;"></i>
                        <span></span>
                    </div>
                </div>

                <div id="progressWrapper">
                    <div style="display:flex;justify-content:space-between;
                                font-size:.775rem;color:var(--muted);">
                        <span id="progressLabel">Uploading…</span>
                        <span id="progressPct"
                              style="font-family:'JetBrains Mono',monospace;font-weight:500;">0%</span>
                    </div>
                    <div class="progress-track">
                        <div id="progressFill"></div>
                    </div>
                </div>

                <div style="height:1px;background:var(--border);"></div>

                <div style="display:flex;justify-content:flex-end;gap:12px;align-items:center;">
                    <a href="@Url.Action("Index")" class="btn-cancel">
                        <i class="fas fa-arrow-left" style="font-size:.75rem;"></i> Cancel
                    </a>
                    <button type="submit" id="submitBtn">
                        <i class="fas fa-cloud-upload-alt" id="submitIcon"></i>
                        <span id="submitText">Upload Package</span>
                    </button>
                </div>

            </div>
        </form>
    </div>

    <p style="max-width:620px;margin:14px auto 0;text-align:center;font-size:.75rem;color:#94a3b8;">
        <i class="fas fa-shield-alt" style="font-size:.65rem;"></i>
        No file size limit enforced
    </p>

</div>

<script>
    function handleDragOver(e) {
        e.preventDefault();
        document.getElementById('dropZone').classList.add('drag-over');
    }
    function handleDragLeave() {
        document.getElementById('dropZone').classList.remove('drag-over');
    }
    function handleDrop(e) {
        e.preventDefault();
        document.getElementById('dropZone').classList.remove('drag-over');
        if (e.dataTransfer.files.length > 0) {
            const input = document.getElementById('fileInput');
            const dt = new DataTransfer();
            dt.items.add(e.dataTransfer.files[0]);
            input.files = dt.files;
            onFileChosen(input);
        }
    }

    function onFileChosen(input) {
        if (!input.files || !input.files.length) return;
        const f = input.files[0];
        document.getElementById('selectedFileName').textContent = f.name;
        document.getElementById('selectedFileSize').textContent = formatBytes(f.size);
        document.getElementById('dropDefault').style.display  = 'none';
        document.getElementById('dropSelected').style.display = 'flex';
        document.getElementById('dropZone').classList.add('has-file');
        document.getElementById('dropZone').classList.remove('has-error');
        clearErr('file');
    }

    function clearFile(e) {
        e.stopPropagation();
        document.getElementById('fileInput').value = '';
        document.getElementById('dropDefault').style.display  = 'block';
        document.getElementById('dropSelected').style.display = 'none';
        document.getElementById('dropZone').classList.remove('has-file');
    }

    function formatBytes(b) {
        if (!b) return '0 B';
        const u = ['B','KB','MB','GB']; let i = 0, v = b;
        while (v >= 1024 && i < u.length - 1) { v /= 1024; i++; }
        return `${v.toFixed(1)} ${u[i]}`;
    }

    function showErr(id, msg) {
        const inp = id === 'file' ? document.getElementById('dropZone') : document.getElementById(id);
        const box = document.getElementById('err-' + id);
        inp?.classList.add('has-error');
        if (box) { box.querySelector('span').textContent = msg; box.style.display = 'flex'; }
    }

    function clearErr(id) {
        const inp = id === 'file' ? document.getElementById('dropZone') : document.getElementById(id);
        const box = document.getElementById('err-' + id);
        inp?.classList.remove('has-error');
        if (box) box.style.display = 'none';
    }

    function showAlert(type, html) {
        const area = document.getElementById('alertArea');
        area.innerHTML = `<div class="alert alert-${type}">${html}</div>`;
        area.scrollIntoView({ behavior:'smooth', block:'nearest' });
    }

    document.getElementById('uploadForm').addEventListener('submit', function (e) {
        e.preventDefault();
        ['softwareName','version','file'].forEach(clearErr);
        document.getElementById('alertArea').innerHTML = '';

        const name = document.getElementById('softwareName').value.trim();
        const ver  = document.getElementById('version').value.trim();
        const file = document.getElementById('fileInput').files[0];

        let hasError = false;
        if (!name) { showErr('softwareName','Software name is required.'); hasError = true; }
        if (!ver)  { showErr('version','Version is required.');            hasError = true; }
        if (!file) { showErr('file','Please select a file.');              hasError = true; }
        if (hasError) return;

        const fd = new FormData(this);

        const btn   = document.getElementById('submitBtn');
        const label = document.getElementById('submitText');
        const prog  = document.getElementById('progressWrapper');
        const fill  = document.getElementById('progressFill');
        const pct   = document.getElementById('progressPct');

        btn.disabled = true;
        document.getElementById('submitIcon').outerHTML =
            '<div class="spinner" id="submitIcon"></div>';
        label.textContent = 'Uploading…';
        prog.classList.add('visible');

        const xhr = new XMLHttpRequest();

        xhr.upload.addEventListener('progress', function (ev) {
            if (ev.lengthComputable) {
                const p = Math.round((ev.loaded / ev.total) * 100);
                fill.style.width = p + '%';
                pct.textContent  = p + '%';
                document.getElementById('progressLabel').textContent =
                    p < 100 ? 'Uploading…' : 'Processing…';
            }
        });

        xhr.addEventListener('load', function () {
            fill.style.width = '100%';
            pct.textContent  = '100%';
            try {
                const res = JSON.parse(xhr.responseText);
                if (res.success) {
                    document.getElementById('progressLabel').textContent = 'Complete!';
                    showAlert('success',
                        `<i class="fas fa-check-circle" style="flex-shrink:0;color:#10b981;margin-top:1px;"></i>
                         <span>${res.message} Redirecting…</span>`);
                    setTimeout(() => { window.location.href = res.redirect || '@Url.Action("Index")'; }, 1200);
                } else {
                    resetBtn(); prog.classList.remove('visible');
                    const errs = res.errors || ['An unexpected error occurred.'];
                    errs.forEach(err => {
                        if (err.toLowerCase().includes('software name')) showErr('softwareName', err);
                        else if (err.toLowerCase().includes('version'))  showErr('version', err);
                        else if (err.toLowerCase().includes('file'))     showErr('file', err);
                    });
                    showAlert('error',
                        `<i class="fas fa-exclamation-circle" style="flex-shrink:0;margin-top:1px;"></i>
                         <span>${errs.join(' ')}</span>`);
                }
            } catch {
                resetBtn(); prog.classList.remove('visible');
                showAlert('error',
                    `<i class="fas fa-exclamation-circle" style="flex-shrink:0;"></i>
                     <span>Unexpected server response. Please try again.</span>`);
            }
        });

        xhr.addEventListener('error', function () {
            resetBtn(); prog.classList.remove('visible');
            showAlert('error',
                `<i class="fas fa-wifi" style="flex-shrink:0;"></i>
                 <span>Network error — check that the API service is running.</span>`);
        });

        xhr.open('POST', this.action);
        xhr.send(fd);
    });

    function resetBtn() {
        document.getElementById('submitBtn').disabled = false;
        const sp = document.getElementById('submitIcon');
        if (sp) sp.outerHTML = '<i class="fas fa-cloud-upload-alt" id="submitIcon"></i>';
        document.getElementById('submitText').textContent = 'Upload Package';
        document.getElementById('progressFill').style.width = '0%';
        document.getElementById('progressPct').textContent  = '0%';
    }

    ['softwareName','version'].forEach(id =>
        document.getElementById(id)?.addEventListener('input', () => clearErr(id))
    );
</script>
