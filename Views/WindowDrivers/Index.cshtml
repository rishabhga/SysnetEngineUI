@model List<WindowDrivers>
@{
    ViewData["Title"] = "Window Drivers";
}

<div class="max-w-7xl mx-auto px-4 pt-3">
    <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-3">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center shadow-sm" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);">
                <i class="fas fa-microchip text-white text-sm"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold text-gray-900">Window Drivers</h1>
                <p class="text-[10px] text-gray-400 font-medium uppercase tracking-wider">Installed Driver Information</p>
            </div>
        </div>
        <span class="px-3 py-1 bg-red-50 text-red-700 text-xs font-bold rounded-lg border border-red-200">
            @(Model?.Count ?? 0) Drivers
        </span>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-xs" id="driversTable">
                <thead>
                    <tr class="border-b border-gray-100" style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">#</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Name</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Description</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Status</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Date</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @if (Model != null && Model.Any())
                    {
                        var idx = 0;
                        @foreach (var item in Model)
                        {
                            idx++;
                            <tr class="hover:bg-red-50/30 transition-colors">
                                <td class="px-4 py-2.5 text-gray-400 font-mono">@idx</td>
                                <td class="px-4 py-2.5 font-semibold text-gray-800">@item.Name</td>
                                <td class="px-4 py-2.5 text-gray-500 max-w-[300px] truncate" title="@item.Description">@item.Description</td>
                                <td class="px-4 py-2.5">
                                    @if (item.Status == "OK" || item.Status == "Running")
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 bg-green-50 text-green-700 text-[10px] font-bold rounded-md border border-green-200">
                                            <span class="w-1.5 h-1.5 bg-green-500 rounded-full mr-1"></span>@item.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 bg-gray-50 text-gray-500 text-[10px] font-bold rounded-md border border-gray-200">
                                            <span class="w-1.5 h-1.5 bg-gray-400 rounded-full mr-1"></span>@item.Status
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-2.5 text-gray-400">@item.DateTime</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="px-4 py-12 text-center">
                                <div class="flex flex-col items-center">
                                    <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center mb-3">
                                        <i class="fas fa-microchip text-gray-300 text-lg"></i>
                                    </div>
                                    <p class="text-gray-400 font-semibold text-sm">No driver data available</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
