    }

    .horizontal-menu li {
        padding: 14px 20px;
        cursor: pointer;
        color: white;
    }

        .horizontal-menu li:hover {
            background-color: #575757;
        }

    /* Vertical Menu Styles */
    .vertical-menu {
        float: left;
        width: 100%;
        background-color: #f4f4f4;
        padding: 10px;
        height: 100vh; /* Full screen height */
    }

        .vertical-menu ul {
            list-style-type: none;
            padding: 0;
        }

        .vertical-menu li {
            padding: 8px 10px;
            cursor: pointer;
            color: #333;
        }

            .vertical-menu li:hover {
                background-color: #ddd;
            }

    /* Content Area */
    .content-area {
        margin-left: 21%; /* Align next to the vertical menu */
        padding: 20px;
    }
</style>
