@model List<ManageEngineWebApp.Dtos.CompanyHierarchyDto>
@{
    ViewData["Title"] = "Hierarchy Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .hierarchy-nav-pill {
            @@apply px-4 py-2 text-sm font-medium rounded-lg transition-colors;
        }
        .animate-fade-in {
            animation: fadeIn 0.3s ease-out forwards;
        }
        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
    </style>
}

<div class="px-6 py-6">
    <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-slate-900 mb-2">Company Hierarchy</h1>
            <p class="text-slate-600">View and manage organizational structure, groups, and users</p>
        </div>
        
        <div class="flex items-center space-x-1 bg-white p-1 rounded-lg border border-slate-200 shadow-sm">
            <a href="@Url.Action("Index", "Hierarchy")" class="px-4 py-2 text-sm font-medium text-blue-600 bg-blue-50 rounded-lg">
                Tree View
            </a>
            <a href="@Url.Action("GraphView", "Hierarchy")" class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors">
                Graph Canvas
            </a>
        </div>
    </div>

    @* --- FILTERS --- *@
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 mb-8">
        <form method="get" id="hierarchyFilterForm" class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <input type="hidden" name="searchTerm" id="hierarchySearchTerm" value="@ViewBag.SearchTerm" />
            
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-2 uppercase tracking-wide">Company</label>
                <select name="filterCompany" onchange="this.form.submit()" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm">
                    <option value="all">All Companies</option>
                    @foreach (var company in Model)
                    {
                        <option value="@company.CompanyId" selected="@(ViewBag.FilterCompany == company.CompanyId.ToString())">@company.CompanyName</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-2 uppercase tracking-wide">Status</label>
                <select name="filterLicenseStatus" onchange="this.form.submit()" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm">
                    <option value="all">All Status</option>
                    <option value="Active" selected="@(ViewBag.FilterLicenseStatus == "Active")">Active</option>
                    <option value="Licensed" selected="@(ViewBag.FilterLicenseStatus == "Licensed")">Licensed</option>
                    <option value="Inactive" selected="@(ViewBag.FilterLicenseStatus == "Inactive")">Inactive</option>
                </select>
            </div>

            <div class="flex items-end gap-2">
                <button type="submit" class="flex-1 px-4 py-2 bg-slate-100 text-slate-700 rounded-lg hover:bg-slate-200 transition-colors font-medium text-sm">
                    <i class="fas fa-filter mr-2"></i> Update View
                </button>
                <a href="@Url.Action("Index", "Hierarchy")" class="px-4 py-2 border border-slate-200 text-slate-500 rounded-lg hover:bg-slate-50 transition-colors font-medium text-sm">
                    Reset
                </a>
            </div>
        </form>
    </div>

    @{
        // Casting to avoid dynamic dispatch issues in some Razor environments
        var data = Model as List<ManageEngineWebApp.Dtos.CompanyHierarchyDto> ?? new List<ManageEngineWebApp.Dtos.CompanyHierarchyDto>();
        var totalCompanies = data.Count;
        var totalGroups = data.Sum(c => c.Groups.Count);
        var totalLocations = data.Sum(c => c.Groups.Sum(g => g.Locations.Count));
        var totalUsers = data.Sum(c => c.Groups.Sum(g => g.Locations.Sum(l => l.Users.Count)));
        var activeCount = data.Sum(c => c.Groups.Sum(g => g.Locations.Sum(l => l.Users.Count(u => u.OsLicenseStatus == "Active" || u.OsLicenseStatus == "Licensed"))));
    }

    @* --- STATISTICS --- *@
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Companies</p>
                    <p class="text-3xl font-bold text-slate-900">@totalCompanies</p>
                </div>
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16"></path>
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Groups</p>
                    <p class="text-3xl font-bold text-slate-900">@totalGroups</p>
                </div>
                <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Active</p>
                    <p class="text-3xl font-bold text-green-600">@activeCount</p>
                </div>
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Total Users</p>
                    <p class="text-3xl font-bold text-slate-900">@totalUsers</p>
                </div>
                <div class="w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    @* --- HIERARCHY CONTENT --- *@
    <div class="space-y-6">
        @if (data.Count == 0)
        {
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-12 text-center animate-fade-in">
                <svg class="w-16 h-16 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                </svg>
                <h3 class="text-lg font-semibold text-slate-900 mb-2">No Results Found</h3>
                <p class="text-slate-600">Try adjusting your filters or search terms</p>
            </div>
        }

        @foreach (var company in data)
        {
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden animate-fade-in">
                <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16"></path>
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-lg font-bold text-white">@company.CompanyName</h2>
                                <p class="text-xs text-blue-100">Company ID: @company.CompanyId</p>
                            </div>
                        </div>
                        <div class="flex items-center space-x-2 bg-white/10 px-4 py-2 rounded-lg">
                            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            <span class="text-sm font-semibold text-white">@company.Groups.Count Groups</span>
                        </div>
                    </div>
                </div>

                <div class="p-6 space-y-4">
                    @foreach (var group in company.Groups)
                    {
                        <div class="bg-slate-50 rounded-lg border border-slate-200 p-4 shadow-sm hover:border-slate-300 transition-all">
                            <div class="flex items-center justify-between mb-4">
                                <div class="flex items-center space-x-2">
                                    <div class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center font-bold text-indigo-600 text-xs">G</div>
                                    <h3 class="font-bold text-slate-800">@group.GroupName</h3>
                                </div>
                                <span class="px-3 py-1 bg-white border border-slate-200 text-slate-600 rounded-full text-[10px] font-bold uppercase tracking-wider">
                                    @group.Locations.Count Locations
                                </span>
                            </div>

                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                                @foreach (var location in group.Locations)
                                {
                                    <div class="bg-white rounded-lg border border-slate-200 p-4 hover:shadow-md transition-all group/loc">
                                        <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-100">
                                            <div class="flex items-center space-x-2">
                                                <svg class="w-4 h-4 text-slate-400 group-hover/loc:text-blue-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                                </svg>
                                                <h4 class="font-bold text-slate-700">@location.LocationName</h4>
                                            </div>
                                            <div class="flex items-center space-x-2">
                                                <a href="@Url.Action("Tickets", "ServiceDesk", new { companyId = company.CompanyId, locationId = location.LocationId })" 
                                                   class="p-1 px-2 text-[10px] font-bold bg-cyan-50 text-cyan-700 hover:bg-cyan-100 rounded uppercase border border-cyan-100 flex items-center transition-colors">
                                                    Tickets
                                                </a>
                                                <span class="p-1 px-2 text-[10px] font-bold bg-blue-50 text-blue-700 rounded uppercase border border-blue-100">
                                                    @location.Users.Count Users
                                                </span>
                                            </div>
                                        </div>

                                        <div class="space-y-2 overflow-y-auto max-h-[220px] scrollbar-thin">
                                            @foreach (var user in location.Users)
                                            {
                                                <div class="flex items-center justify-between p-2.5 bg-slate-50/50 rounded-lg hover:bg-slate-100 transition-colors border border-transparent hover:border-slate-200">
                                                    <div class="flex items-center space-x-3">
                                                        <div class="w-7 h-7 bg-gradient-to-br from-slate-200 to-slate-300 rounded-full flex items-center justify-center">
                                                            <span class="text-[10px] font-black text-slate-600">@(user.UserName?.Substring(0, 1).ToUpper() ?? "?")</span>
                                                        </div>
                                                        <div>
                                                            <p class="text-xs font-bold text-slate-800">@user.UserName</p>
                                                            <p class="text-[10px] text-slate-500 font-mono">@user.IpAddress</p>
                                                        </div>
                                                    </div>
                                                    <span class="@((user.OsLicenseStatus == "Active" || user.OsLicenseStatus == "Licensed") ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700") px-2 py-0.5 rounded-full text-[9px] font-black uppercase">
                                                        @user.OsLicenseStatus
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).on('searchEvent', function(e, term) {
            $('#hierarchySearchTerm').val(term);
            const form = $('#hierarchyFilterForm');
            
            // Debounce form submission
            clearTimeout(window.hierarchySearchTimeout);
            window.hierarchySearchTimeout = setTimeout(() => {
                form.submit();
            }, 600);
        });

        // Initialize global search value if page was loaded with a term
        $(document).ready(function() {
            const initialTerm = $('#hierarchySearchTerm').val();
            if (initialTerm) {
                $('#globalSearchInput').val(initialTerm);
            }
        });
    </script>
}
