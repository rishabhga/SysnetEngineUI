@using ManageEngineWebApp.Dtos
@model List<CompanyHierarchyDto>
@{
    ViewData["Title"] = "Hierarchy Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50">
    <nav class="bg-white shadow-sm border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 py-4">
            <div class="flex justify-between items-center">
                <div class="flex items-center space-x-8">
                    <a href="@Url.Action("Index", "Home")" class="flex items-center space-x-3 group">
                        <div class="w-9 h-9 bg-gradient-to-br from-blue-600 to-indigo-600 rounded-lg flex items-center justify-center">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                            </svg>
                        </div>
                        <span class="font-bold text-slate-900 group-hover:text-blue-600 transition-colors">ManageEngine</span>
                    </a>

                    <div class="flex items-center space-x-1">
                        <a href="@Url.Action("Index", "Hierarchy")" class="px-4 py-2 text-sm font-medium text-blue-600 bg-blue-50 rounded-lg">
                            Hierarchy View
                        </a>
                        <a href="@Url.Action("GraphView", "Hierarchy")" class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors">
                            Interactive Canvas
                        </a>
                    </div>
                </div>

                <div class="flex items-center space-x-4">
                    <span class="text-sm text-slate-600">Welcome, <span class="font-semibold text-slate-900">Admin</span></span>
                    <a href="@Url.Action("Logout", "Auth")" class="text-sm text-slate-600 hover:text-slate-900 transition-colors">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-6 py-8">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-slate-900 mb-2">Company Hierarchy</h1>
            <p class="text-slate-600">View and manage organizational structure, groups, and users</p>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 mb-6">
            <form method="get" class="space-y-6">
                <div class="flex items-center gap-4">
                    <div class="flex-1">
                        <div class="relative">
                            <input type="text"
                                   name="searchTerm"
                                   value="@ViewBag.SearchTerm"
                                   placeholder="Search users, locations, or IP addresses..."
                                   class="w-full pl-10 pr-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" />
                            <svg class="w-5 h-5 text-slate-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-2 uppercase tracking-wide">Company</label>
                        <select name="filterCompany" class="w-full px-3 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm">
                            <option value="all">All Companies</option>
                            @foreach (var company in Model)
                            {
                                <option value="@company.CompanyId" selected="@(ViewBag.FilterCompany == company.CompanyId.ToString())">@company.CompanyName</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-2 uppercase tracking-wide">Status</label>
                        <select name="filterLicenseStatus" class="w-full px-3 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm">
                            <option value="all">All Status</option>
                            <option value="Active" selected="@(ViewBag.FilterLicenseStatus == "Active")">Active</option>
                            <option value="Licensed" selected="@(ViewBag.FilterLicenseStatus == "Licensed")">Licensed</option>
                            <option value="Inactive" selected="@(ViewBag.FilterLicenseStatus == "Inactive")">Inactive</option>
                        </select>
                    </div>

                    <div class="flex items-end gap-2">
                        <button type="submit" class="flex-1 px-4 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium text-sm">
                            Apply Filters
                        </button>
                        <a href="@Url.Action("Index", "Hierarchy")" class="px-4 py-2.5 bg-slate-100 text-slate-700 rounded-lg hover:bg-slate-200 transition-colors font-medium text-sm">
                            Clear
                        </a>
                    </div>
                </div>
            </form>
        </div>

        @{
            var totalCompanies = Model.Count;
            var totalGroups = Model.Sum(c => c.Groups.Count);
            var totalLocations = Model.Sum(c => c.Groups.Sum(g => g.Locations.Count));
            var totalUsers = Model.Sum(c => c.Groups.Sum(g => g.Locations.Sum(l => l.Users.Count)));
            var activeCount = Model.Sum(c => c.Groups.Sum(g => g.Locations.Sum(l => l.Users.Count(u => u.OsLicenseStatus == "Active" || u.OsLicenseStatus == "Licensed"))));
        }

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Companies</p>
                        <p class="text-3xl font-bold text-slate-900">@totalCompanies</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Groups</p>
                        <p class="text-3xl font-bold text-slate-900">@totalGroups</p>
                    </div>
                    <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Active</p>
                        <p class="text-3xl font-bold text-green-600">@activeCount</p>
                    </div>
                    <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Total Users</p>
                        <p class="text-3xl font-bold text-slate-900">@totalUsers</p>
                    </div>
                    <div class="w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-5">
            @if (Model.Count == 0)
            {
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-12 text-center">
                    <svg class="w-16 h-16 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                    </svg>
                    <h3 class="text-lg font-semibold text-slate-900 mb-2">No Results Found</h3>
                    <p class="text-slate-600">Try adjusting your filters or search terms</p>
                </div>
            }

            @foreach (var company in Model)
            {
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-4">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-3">
                                <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
                                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h2 class="text-lg font-bold text-white">@company.CompanyName</h2>
                                    <p class="text-xs text-blue-100">Company ID: @company.CompanyId</p>
                                </div>
                            </div>
                            <div class="flex items-center space-x-2 bg-white/10 px-4 py-2 rounded-lg">
                                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                                <span class="text-sm font-semibold text-white">@company.Groups.Count Groups</span>
                            </div>
                        </div>
                    </div>

                    <div class="p-6 space-y-4">
                        @foreach (var group in company.Groups)
                        {
                            <div class="bg-slate-50 rounded-lg border border-slate-200 p-4">
                                <div class="flex items-center justify-between mb-4">
                                    <div class="flex items-center space-x-2">
                                        <div class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center">
                                            <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            </svg>
                                        </div>
                                        <h3 class="font-semibold text-slate-900">@group.GroupName</h3>
                                    </div>
                                    <span class="px-3 py-1 bg-slate-200 text-slate-700 rounded-full text-xs font-medium">
                                        @group.Locations.Count Locations
                                    </span>
                                </div>

                                <div class="space-y-3">
                                    @foreach (var location in group.Locations)
                                    {
                                        <div class="bg-white rounded-lg border border-slate-200 p-4">
                                            <div class="flex items-center justify-between mb-3">
                                                <div class="flex items-center space-x-2">
                                                    <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                                    </svg>
                                                    <h4 class="font-medium text-slate-900">@location.LocationName</h4>
                                                </div>
                                            <div class="flex items-center space-x-2">
                                                <a href="@Url.Action("Index", "Tickets", new { companyId = company.CompanyId, locationId = location.LocationId })" 
                                                   class="px-2 py-1 bg-cyan-50 text-cyan-700 hover:bg-cyan-100 rounded text-xs font-medium transition-colors border border-cyan-100 flex items-center">
                                                    <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"></path></svg>
                                                    Tickets
                                                </a>
                                                <span class="px-2 py-1 bg-blue-50 text-blue-700 rounded text-xs font-medium">
                                                    @location.Users.Count Users
                                                </span>
                                            </div>
                                            </div>

                                            <div class="space-y-2">
                                                @foreach (var user in location.Users)
                                                {
                                                    <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg hover:bg-slate-100 transition-colors">
                                                        <div class="flex items-center space-x-3">
                                                            <div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-indigo-500 rounded-full flex items-center justify-center">
                                                                <span class="text-xs font-bold text-white">@(user.UserName?.Substring(0, 1).ToUpper() ?? "?")</span>
                                                            </div>
                                                            <div>
                                                                <p class="text-sm font-medium text-slate-900">@user.UserName</p>
                                                                <p class="text-xs text-slate-500">@user.IpAddress</p>
                                                            </div>
                                                        </div>
                                                        <span class="@((user.OsLicenseStatus == "Active" || user.OsLicenseStatus == "Licensed") ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700") px-3 py-1 rounded-full text-xs font-semibold">
                                                            @user.OsLicenseStatus
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</body>
</html>
