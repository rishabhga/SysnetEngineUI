@model List<WindowsUserDetails>

<h2>Computer Details</h2>

<table class="table table-bordered font-monospace">
    <thead>
        <tr>
            <th>Id</th>
            <th>User Name</th>
            <th>Domain Name</th>
           @*  <th>SID</th> *@
            <th>Account Type</th>
            <th>Full Name</th>
            <th>Status</th>
           @*  <th>Date Time</th> *@
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.UserName</td>
               @*  <td>@item.DomainName</td> *@
                <td> <a href="/WindowsUserDetails/Index?domain=@item.DomainName">@item.DomainName</a></td>
               @*  <td class="col-md-3">@item.SID</td> *@
                <td>@item.AccountType</td>
                <td>@item.FullName</td>
                <td>@item.Status</td>
               @*  <td>@item.DateTime</td> *@
            </tr>
        }
    </tbody>
</table>

