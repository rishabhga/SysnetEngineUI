@model ManageEngineWebApp.Models.VersionInfoModel
@{
    ViewData["Title"] = "Client Version Upload";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isOn = ViewBag.IsAutoUpdateOn == true;
    int intervalSecs = (int)(ViewBag.CurrentInterval ?? 0);
    int normalizedSecs = intervalSecs > 86400 ? intervalSecs / 1000 : intervalSecs;
    int intervalMins = normalizedSecs > 0 ? normalizedSecs / 60 : 0;
}

<style>
    .cv-page {
        max-width: 960px;
        margin: 0 auto;
        padding: 16px 20px;
    }

    .cv-page-header {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
    }

        .cv-page-header h1 {
            font-size: 1.1rem;
            font-weight: 700;
            color: #0e7490;
            margin: 0;
        }

        .cv-page-header p {
            font-size: 0.72rem;
            color: #6b7280;
            margin: 2px 0 0;
        }

    .cv-alert {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding: 9px 12px;
        border-radius: 6px;
        font-size: 0.75rem;
        margin-bottom: 10px;
    }

    .cv-alert-ok {
        background: #ecfdf5;
        border-left: 3px solid #10b981;
        color: #065f46;
    }

    .cv-alert-err {
        background: #fef2f2;
        border-left: 3px solid #ef4444;
        color: #991b1b;
    }

    .cv-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 12px;
    }

    .cv-card-head {
        background: linear-gradient(90deg,#0891b2 0%,#0e7490 100%);
        padding: 8px 14px;
        display: flex;
        align-items: center;
        gap: 7px;
    }

        .cv-card-head h3 {
            font-size: 0.78rem;
            font-weight: 600;
            color: #fff;
            margin: 0;
        }

        .cv-card-head p {
            font-size: 0.68rem;
            color: #cffafe;
            margin: 1px 0 0;
        }

    .cv-card-body {
        padding: 12px 14px;
    }

    .cv-autoupdate-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

        .cv-autoupdate-row p {
            font-size: 0.73rem;
            color: #374151;
            margin: 0;
        }

        .cv-autoupdate-row strong {
            color: #0e7490;
        }

    .cv-btn-group {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .cv-badge-on {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.65rem;
        background: #ecfdf5;
        color: #065f46;
        border: 1px solid #6ee7b7;
        padding: 2px 7px;
        border-radius: 999px;
    }

    .cv-badge-off {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.65rem;
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fca5a5;
        padding: 2px 7px;
        border-radius: 999px;
    }

    .cv-badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        display: inline-block;
    }

    .cv-badge-on .cv-badge-dot {
        background: #10b981;
    }

    .cv-badge-off .cv-badge-dot {
        background: #ef4444;
    }

    .cv-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 14px;
        border-radius: 5px;
        font-size: 0.72rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all .15s;
    }

    .cv-btn-on {
        background: linear-gradient(135deg,#06b6d4,#0891b2);
        color: #fff;
    }

        .cv-btn-on:hover {
            background: linear-gradient(135deg,#0891b2,#0e7490);
            box-shadow: 0 2px 6px rgba(8,145,178,.35);
        }

    .cv-btn-off {
        background: linear-gradient(135deg,#f87171,#ef4444);
        color: #fff;
    }

        .cv-btn-off:hover {
            background: linear-gradient(135deg,#ef4444,#dc2626);
            box-shadow: 0 2px 6px rgba(239,68,68,.35);
        }

    .cv-btn-disabled {
        background: #e5e7eb;
        color: #9ca3af;
        cursor: not-allowed;
    }

    .cv-btn-upload {
        background: linear-gradient(135deg,#06b6d4,#0891b2);
        color: #fff;
        width: 100%;
        justify-content: center;
        padding: 7px;
        margin-top: 10px;
        font-size: 0.75rem;
    }

        .cv-btn-upload:hover {
            background: linear-gradient(135deg,#0891b2,#0e7490);
            box-shadow: 0 2px 8px rgba(8,145,178,.3);
        }

    .cv-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    @@media (max-width: 640px) {
        .cv-grid {
            grid-template-columns: 1fr;
        }

        .cv-autoupdate-row {
            flex-direction: column;
            align-items: flex-start;
        }

        .cv-btn-group {
            width: 100%;
            justify-content: flex-start;
        }

        .cv-btn {
            flex: 1;
            justify-content: center;
        }

        .cv-page {
            padding: 12px 12px;
        }

        .cv-modal {
            max-width: 100%;
            margin: 0 10px;
        }
    }

    .cv-version-box {
        text-align: center;
        background: linear-gradient(135deg,#ecfeff,#cffafe);
        border: 1px solid #a5f3fc;
        border-radius: 6px;
        padding: 14px 10px;
        margin-bottom: 10px;
    }

    a.cv-version-box:hover {
        background: linear-gradient(135deg,#cffafe,#a5f3fc);
        border-color: #06b6d4;
        box-shadow: 0 2px 8px rgba(6,182,212,.2);
        transform: translateY(-1px);
    }

    .cv-version-label {
        font-size: 0.65rem;
        font-weight: 600;
        color: #0891b2;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .cv-version-num {
        font-size: 2rem;
        font-weight: 800;
        color: #0e4f5c;
        line-height: 1.1;
    }

    .cv-url-row {
        display: flex;
        align-items: flex-start;
        gap: 6px;
        font-size: 0.68rem;
    }

        .cv-url-row i {
            color: #9ca3af;
            margin-top: 2px;
            flex-shrink: 0;
        }

        .cv-url-row a {
            color: #0891b2;
            word-break: break-all;
        }

            .cv-url-row a:hover {
                color: #0e7490;
            }

    .cv-no-version {
        text-align: center;
        padding: 18px 0;
        color: #9ca3af;
        font-size: 0.75rem;
    }

        .cv-no-version i {
            font-size: 1.8rem;
            display: block;
            margin-bottom: 6px;
        }

    .cv-label {
        display: block;
        font-size: 0.7rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: 4px;
    }

    .cv-input {
        width: 100%;
        padding: 6px 10px;
        border: 1px solid #d1d5db;
        border-radius: 5px;
        font-size: 0.75rem;
        outline: none;
        transition: border .15s;
        box-sizing: border-box;
    }

        .cv-input:focus {
            border-color: #06b6d4;
            box-shadow: 0 0 0 2px rgba(6,182,212,.15);
        }

    .cv-field {
        margin-bottom: 10px;
    }

    .cv-dropzone {
        border: 2px dashed #d1d5db;
        border-radius: 6px;
        padding: 14px;
        text-align: center;
        cursor: pointer;
        transition: all .15s;
        background: #fafafa;
    }

        .cv-dropzone:hover {
            border-color: #06b6d4;
            background: #ecfeff;
        }

        .cv-dropzone i {
            font-size: 1.4rem;
            color: #9ca3af;
            display: block;
            margin-bottom: 4px;
        }

    .cv-dropzone-label {
        font-size: 0.7rem;
        color: #6b7280;
    }

        .cv-dropzone-label span {
            color: #0891b2;
            font-weight: 600;
            cursor: pointer;
        }

    .cv-dropzone-hint {
        font-size: 0.63rem;
        color: #9ca3af;
        margin-top: 3px;
    }

    .cv-interval-chip {
        font-size: 0.65rem;
        color: #0e7490;
        background: #ecfeff;
        border: 1px solid #a5f3fc;
        border-radius: 999px;
        padding: 2px 8px;
        margin-left: 6px;
        display: inline-flex;
        align-items: center;
        gap: 3px;
    }

    .cv-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 999;
        display: none;
        align-items: center;
        justify-content: center;
    }

        .cv-modal-overlay.active {
            display: flex;
        }

    .cv-modal {
        background: #fff;
        border-radius: 10px;
        width: 100%;
        max-width: 320px;
        margin: 0 16px;
        box-shadow: 0 12px 32px rgba(0,0,0,.18);
    }

    .cv-modal-head {
        padding: 12px 16px 10px;
        border-bottom: 1px solid #f3f4f6;
    }

        .cv-modal-head h4 {
            font-size: 0.82rem;
            font-weight: 700;
            color: #0e7490;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 6px;
        }

    .cv-modal-body {
        padding: 12px 16px;
    }

    .cv-modal-foot {
        padding: 10px 16px 14px;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .cv-btn-cancel {
        background: #f3f4f6;
        color: #374151;
    }

        .cv-btn-cancel:hover {
            background: #e5e7eb;
        }
</style>

<div class="cv-page">

    <div class="cv-page-header" style="justify-content: space-between;">
        <div>
            <h1><i class="fas fa-cloud-upload-alt" style="color:#06b6d4;margin-right:5px;"></i>Client Version Upload</h1>
            <p>Upload and manage the latest client application version for auto-updates.</p>
        </div>
        <div>
            <a href="/ClientVersion/Logs" class="cv-btn cv-btn-on" style="text-decoration: none;">
                <i class="fas fa-history"></i> View Logs
            </a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="cv-alert cv-alert-ok">
            <i class="fas fa-check-circle" style="margin-top:1px;"></i>
            <span>@TempData["Message"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="cv-alert cv-alert-err">
            <i class="fas fa-exclamation-circle" style="margin-top:1px;"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    @if (ManageEngineWebApp.Datacontext.RoleHelper.HasPermission(Context, "ClientVersion.AutoUpdate"))
    {
        <div class="cv-card">
            <div class="cv-card-head">
                <i class="fas fa-sync-alt" style="font-size:.8rem;color:#cffafe;"></i>
                <div>
                    <h3>Auto-Update Control</h3>
                    <p>Auto-update on all connected clients and set the check interval.</p>
                </div>
            </div>
            <div class="cv-card-body">
                <form asp-action="TriggerAutoUpdate" method="post" id="autoUpdateForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="autoUpdateMessage" name="message" value="" />
                    <input type="hidden" id="intervalSeconds" name="intervalSeconds" value="@(intervalSecs > 0 ? intervalSecs : 300)" />

                    <div class="cv-autoupdate-row">
                        <div>
                            <p>
                                Click <strong>Turn On</strong> to enable auto-update and set the check interval.
                                @if (isOn && intervalMins > 0)
                                {
                                    <span class="cv-interval-chip"><i class="fas fa-clock"></i> Every @intervalMins min</span>
                                }
                            </p>
                            <div style="margin-top:5px;">
                                @if (isOn)
                                {
                                    <span class="cv-badge-on"><span class="cv-badge-dot"></span>Auto-update is ON</span>
                                }
                                else
                                {
                                    <span class="cv-badge-off"><span class="cv-badge-dot"></span>Auto-update is OFF</span>
                                }
                            </div>
                        </div>

                        <div class="cv-btn-group">
                            @if (isOn)
                            {
                                <button type="button" class="cv-btn cv-btn-disabled" disabled>
                                    <i class="fas fa-play"></i> Turn On
                                </button>
                                <button type="button" id="btnOff" onclick="turnOffAutoUpdate()" class="cv-btn cv-btn-off">
                                    <i class="fas fa-stop"></i> Turn Off
                                </button>
                            }
                            else
                            {
                                <button type="button" id="btnOn" onclick="turnOnAutoUpdate()" class="cv-btn cv-btn-on">
                                    <i class="fas fa-play"></i> Turn On
                                </button>
                                <button type="button" class="cv-btn cv-btn-disabled" disabled>
                                    <i class="fas fa-stop"></i> Turn Off
                                </button>
                            }
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="cv-grid">

        <div class="cv-card">
            <div class="cv-card-head">
                <i class="fas fa-info-circle" style="font-size:.8rem;color:#cffafe;"></i>
                <h3>Current Active Version</h3>
            </div>
            <div class="cv-card-body">
                @if (Model != null && !string.IsNullOrEmpty(Model.Version))
                {
                    <a href="@Model.Url" target="_blank" class="cv-version-box" style="display:block;text-decoration:none;cursor:pointer;transition:all .2s;">
                        <div class="cv-version-label">Version</div>
                        <div class="cv-version-num">@Model.Version</div>
                        <div style="font-size:0.62rem;color:#0891b2;margin-top:6px;"><i class="fas fa-download" style="margin-right:4px;"></i>Click to download</div>
                    </a>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <div style="text-align:center;margin-top:4px;">
                            <span style="font-size:0.62rem;color:#6b7280;"><i class="fas fa-clock" style="margin-right:3px;color:#9ca3af;"></i>Updated: @Model.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                        </div>
                    }
                    <input type="hidden" id="currentVersion" value="@Model.Version" />
                }
                else
                {
                    <div class="cv-no-version">
                        <i class="fas fa-box-open"></i>
                        No version configured yet.<br>
                        <span style="font-size:0.65rem;">Upload a file to make one active.</span>
                    </div>
                }
            </div>
        </div>

        @if (ManageEngineWebApp.Datacontext.RoleHelper.HasPermission(Context, "ClientVersion.Upload"))
        {
            <div class="cv-card">
                <div class="cv-card-head">
                    <i class="fas fa-file-upload" style="font-size:.8rem;color:#cffafe;"></i>
                    <h3>Upload New Version</h3>
                </div>
                <div class="cv-card-body">
                    <form asp-action="Upload" method="post" enctype="multipart/form-data" id="uploadForm">
                        @Html.AntiForgeryToken()

                        <div class="cv-field">
                            <label class="cv-label" for="newVersion">Version Number <span style="color:#ef4444">*</span></label>
                            <input type="text" id="newVersion" name="newVersion" required placeholder="e.g., 1.0.1 or 1.0.0.5"
                                   pattern="^\d+\.\d+\.\d+(\.\d+)?$" class="cv-input" oninput="validateVersion()" />
                            <div id="versionError" style="font-size:0.63rem;color:#ef4444;margin-top:3px;display:none;"></div>
                        </div>

                        <div class="cv-field">
                            <label class="cv-label">Client Executable (.exe) <span style="color:#ef4444">*</span></label>
                            <div class="cv-dropzone" id="dropZone" onclick="document.getElementById('versionFile').click()">
                                <i class="fas fa-file-archive" id="fileIcon"></i>
                                <div class="cv-dropzone-label">
                                    <span id="fileLabel">Click to upload</span>
                                    <span id="fileSuffix"> or drag and drop</span>
                                </div>
                                <div class="cv-dropzone-hint">.exe · up to 500 MB</div>
                                <input id="versionFile" name="versionFile" type="file" style="display:none" accept=".exe" required onchange="updateFileName(this)">
                            </div>
                        </div>

                        <button type="submit" id="submitBtn" class="cv-btn cv-btn-upload">
                            <i class="fas fa-cloud-upload-alt"></i> Upload &amp; Set Active
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<div id="intervalModal" class="cv-modal-overlay" onclick="if(event.target===this)closeIntervalModal()">
    <div class="cv-modal" onclick="event.stopPropagation()">
        <div class="cv-modal-head">
            <h4><i class="fas fa-clock" style="color:#06b6d4;"></i> Set Update Interval</h4>
        </div>
        <div class="cv-modal-body">
            <label class="cv-label">How often should clients check for updates?</label>
            <input type="number" id="intervalMinutesInput" min="1" max="1440" value="@(intervalMins > 0 ? intervalMins : 5)" step="1"
                   class="cv-input" style="text-align:center;font-size:1rem;font-weight:700;"
                   placeholder="e.g. 5" />
            <div style="font-size:0.62rem;color:#9ca3af;text-align:center;margin-top:4px;">Minutes (1 – 1440)</div>
            <div id="intervalError" style="font-size:0.65rem;color:#ef4444;text-align:center;margin-top:4px;display:none;">
                Please enter a valid number of minutes (1 or more).
            </div>
        </div>
        <div class="cv-modal-foot">
            <button type="button" onclick="closeIntervalModal()" class="cv-btn cv-btn-cancel">Cancel</button>
            <button type="button" id="confirmIntervalBtn" onclick="confirmTurnOn()" class="cv-btn cv-btn-on">
                <i class="fas fa-play"></i> Turn On
            </button>
        </div>
    </div>
</div>

<div id="turnOffModal" class="cv-modal-overlay" onclick="if(event.target===this)closeTurnOffModal()">
    <div class="cv-modal" onclick="event.stopPropagation()">
        <div class="cv-modal-head">
            <h4><i class="fas fa-stop" style="color:#ef4444;"></i> Turn Off Auto-Update?</h4>
        </div>
        <div class="cv-modal-body">
            <p style="font-size:0.73rem;color:#6b7280;margin:0;">
                Are you sure you want to turn off auto-updates for all connected clients?
            </p>
        </div>
        <div class="cv-modal-foot">
            <button onclick="closeTurnOffModal()" class="cv-btn cv-btn-cancel">Cancel</button>
            <button id="confirmTurnOffBtn" onclick="confirmTurnOff()" class="cv-btn cv-btn-off">
                <i class="fas fa-stop"></i> Yes, Turn Off
            </button>
        </div>
    </div>
</div>

<script>
    var savedIntervalSeconds = @(intervalSecs > 0 ? intervalSecs : 300);

    function updateFileName(input) {
        const fileLabel  = document.getElementById('fileLabel');
        const fileSuffix = document.getElementById('fileSuffix');
        const fileIcon   = document.getElementById('fileIcon');
        if (input.files && input.files.length > 0) {
            fileLabel.textContent  = input.files[0].name;
            fileSuffix.style.display = 'none';
            fileIcon.className = 'fas fa-file-code';
            fileIcon.style.color = '#0891b2';
        } else {
            fileLabel.textContent  = 'Click to upload';
            fileSuffix.style.display = '';
            fileIcon.className = 'fas fa-file-archive';
            fileIcon.style.color = '';
        }
    }

    function parseVersion(str) {
        var parts = str.split('.');
        var nums = [];
        for (var i = 0; i < parts.length; i++) {
            var n = parseInt(parts[i], 10);
            if (isNaN(n) || n < 0) return null;
            nums.push(n);
        }
        while (nums.length < 4) nums.push(0);
        return nums;
    }

    function compareVersions(a, b) {
        for (var i = 0; i < 4; i++) {
            if (a[i] > b[i]) return 1;
            if (a[i] < b[i]) return -1;
        }
        return 0;
    }

    function validateVersion() {
        var input = document.getElementById('newVersion');
        var errorDiv = document.getElementById('versionError');
        var submitBtn = document.getElementById('submitBtn');
        var val = input.value.trim();

        if (!val) {
            errorDiv.style.display = 'none';
            input.style.borderColor = '';
            return true;
        }

        var versionRegex = /^\d+\.\d+\.\d+(\.\d+)?$/;
        if (!versionRegex.test(val)) {
            errorDiv.textContent = 'Invalid format. Use x.x.x or x.x.x.x (e.g., 1.0.1 or 1.0.0.5)';
            errorDiv.style.display = 'block';
            input.style.borderColor = '#ef4444';
            return false;
        }

        var newVer = parseVersion(val);
        if (!newVer) {
            errorDiv.textContent = 'Invalid version number.';
            errorDiv.style.display = 'block';
            input.style.borderColor = '#ef4444';
            return false;
        }

        var minVer = [1, 0, 1, 0];
        if (compareVersions(newVer, minVer) < 0) {
            errorDiv.textContent = 'Version must be at least 1.0.1';
            errorDiv.style.display = 'block';
            input.style.borderColor = '#ef4444';
            return false;
        }

        var currentEl = document.getElementById('currentVersion');
        if (currentEl && currentEl.value) {
            var curVer = parseVersion(currentEl.value);
            if (curVer && compareVersions(newVer, curVer) <= 0) {
                errorDiv.textContent = 'New version must be greater than current version (' + currentEl.value + ')';
                errorDiv.style.display = 'block';
                input.style.borderColor = '#ef4444';
                return false;
            }
        }

        errorDiv.style.display = 'none';
        input.style.borderColor = '#10b981';
        return true;
    }

    var uploadFormEl = document.getElementById('uploadForm');
    if (uploadFormEl) {
        uploadFormEl.addEventListener('submit', function (e) {
            if (!validateVersion()) {
                e.preventDefault();
                return false;
            }
            var btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Uploading...';
        });
    }

    function openIntervalModal() {
        document.getElementById('intervalModal').classList.add('active');
        document.getElementById('intervalMinutesInput').focus();
        document.getElementById('intervalError').style.display = 'none';
    }
    function closeIntervalModal() {
        document.getElementById('intervalModal').classList.remove('active');
    }
    function openTurnOffModal() {
        document.getElementById('turnOffModal').classList.add('active');
    }
    function closeTurnOffModal() {
        document.getElementById('turnOffModal').classList.remove('active');
    }

    function turnOnAutoUpdate()  { openIntervalModal(); }
    function turnOffAutoUpdate() { openTurnOffModal(); }

    function confirmTurnOn() {
        var input = document.getElementById('intervalMinutesInput');
        var mins  = parseInt(input.value);
        if (isNaN(mins) || mins <= 0) {
            document.getElementById('intervalError').style.display = 'block';
            input.focus();
            return;
        }
        document.getElementById('autoUpdateMessage').value = 'On';
        document.getElementById('intervalSeconds').value   = mins * 60;

        var btn = document.getElementById('confirmIntervalBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';

        var btnOn = document.getElementById('btnOn');
        if (btnOn) { btnOn.disabled = true; btnOn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>'; }

        closeIntervalModal();
        document.getElementById('autoUpdateForm').submit();
    }

    function confirmTurnOff() {
        document.getElementById('autoUpdateMessage').value = 'Off';
        document.getElementById('intervalSeconds').value   = savedIntervalSeconds;

        var btn = document.getElementById('confirmTurnOffBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';

        var btnOff = document.getElementById('btnOff');
        if (btnOff) { btnOff.disabled = true; btnOff.innerHTML = '<i class="fas fa-spinner fa-spin"></i>'; }

        closeTurnOffModal();
        document.getElementById('autoUpdateForm').submit();
    }

    document.getElementById('intervalMinutesInput').addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); confirmTurnOn(); }
    });
</script>
