@model ManageEngineWebApp.Models.VersionInfoModel
@{
    ViewData["Title"] = "Client Version Upload";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
                <i class="fas fa-cloud-upload-alt text-blue-600"></i> Client Version Upload
            </h1>
            <p class="text-sm text-gray-500 mt-1">Upload and manage the latest client application version for auto-updates.</p>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="mb-6 bg-green-50 border-l-4 border-green-500 p-4 rounded-md shadow-sm">
            <div class="flex">
                <div class="flex-shrink-0">
                    <i class="fas fa-check-circle text-green-500"></i>
                </div>
                <div class="ml-3">
                    <p class="text-sm font-medium text-green-800">
                        @TempData["Message"]
                    </p>
                </div>
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-md shadow-sm">
            <div class="flex">
                <div class="flex-shrink-0">
                    <i class="fas fa-exclamation-circle text-red-500"></i>
                </div>
                <div class="ml-3">
                    <p class="text-sm font-medium text-red-800">
                        @TempData["Error"]
                    </p>
                </div>
            </div>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Current Version Card -->
        <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden">
            <div class="border-b border-gray-100 bg-gray-50 px-6 py-4">
                <h3 class="text-lg font-semibold text-gray-800 flex items-center gap-2">
                    <i class="fas fa-info-circle text-blue-500"></i> Current Active Version
                </h3>
            </div>
            <div class="p-6">
                @if (Model != null && !string.IsNullOrEmpty(Model.Version))
                {
                    <div class="flex items-center justify-center bg-blue-50 rounded-lg p-6 mb-6">
                        <div class="text-center">
                            <span class="block text-sm font-medium text-blue-600 uppercase tracking-wide mb-1">Version</span>
                            <span class="block text-4xl font-extrabold text-blue-900">@Model.Version</span>
                        </div>
                    </div>
                    
                    <div class="space-y-4">
                        <div class="flex items-start">
                            <i class="fas fa-link text-gray-400 mt-1 mr-3"></i>
                            <div>
                                <p class="text-sm font-medium text-gray-500">Download URL</p>
                                <a href="@Model.Url" class="text-sm text-blue-600 hover:text-blue-800 break-all" target="_blank">@Model.Url</a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-8">
                        <i class="fas fa-box-open text-gray-300 text-5xl mb-3"></i>
                        <p class="text-gray-500 font-medium">No client version is currently configured.</p>
                        <p class="text-gray-400 text-sm mt-1">Upload a version using the form to make it active.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Upload Form Card -->
        @if (ManageEngineWebApp.Datacontext.RoleHelper.HasPermission(Context, "ClientVersion.Upload"))
        {
            <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden">
                <div class="border-b border-gray-100 bg-gray-50 px-6 py-4">
                    <h3 class="text-lg font-semibold text-gray-800 flex items-center gap-2">
                        <i class="fas fa-file-upload text-green-500"></i> Upload New Version
                    </h3>
                </div>
                <div class="p-6">
                    <form asp-action="Upload" method="post" enctype="multipart/form-data" id="uploadForm">
                        <div class="mb-5">
                            <label for="newVersion" class="block text-sm font-medium text-gray-700 mb-1">Version Number <span class="text-red-500">*</span></label>
                            <input type="text" id="newVersion" name="newVersion" required placeholder="e.g., 1.0.0.5"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none" />
                        </div>

                        <div class="mb-6">
                            <label class="block text-sm font-medium text-gray-700 mb-1">Client Executable (.exe) <span class="text-red-500">*</span></label>
                            
                            <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-lg hover:bg-gray-50 transition-colors" id="dropZone">
                                <div class="space-y-1 text-center">
                                    <i class="fas fa-file-archive text-gray-400 text-4xl mb-3" id="fileIcon"></i>
                                    <div class="flex text-sm text-gray-600 justify-center">
                                        <label for="versionFile" class="relative cursor-pointer bg-white rounded-md font-medium text-blue-600 hover:text-blue-500 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-blue-500">
                                            <span id="fileLabel">Upload a file</span>
                                            <input id="versionFile" name="versionFile" type="file" class="sr-only" accept=".exe" required onchange="updateFileName(this)">
                                        </label>
                                        <p class="pl-1" id="fileSuffix">or drag and drop</p>
                                    </div>
                                    <p class="text-xs text-gray-500">.exe up to 500MB</p>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center justify-end">
                            <button type="submit" id="submitBtn"
                                    class="px-6 py-2 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-medium rounded-lg shadow-md hover:shadow-lg transition-all flex items-center gap-2">
                                <i class="fas fa-cloud-upload-alt"></i> Upload & Set Active
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<script>
    function updateFileName(input) {
        const fileLabel = document.getElementById('fileLabel');
        const fileSuffix = document.getElementById('fileSuffix');
        const fileIcon = document.getElementById('fileIcon');
        
        if (input.files && input.files.length > 0) {
            const fileName = input.files[0].name;
            fileLabel.textContent = fileName;
            fileSuffix.classList.add('hidden');
            fileIcon.className = 'fas fa-file-code text-blue-500 text-4xl mb-3';
        } else {
            fileLabel.textContent = 'Upload a file';
            fileSuffix.classList.remove('hidden');
            fileIcon.className = 'fas fa-file-archive text-gray-400 text-4xl mb-3';
        }
    }

    document.getElementById('uploadForm').addEventListener('submit', function() {
        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Uploading...';
    });
</script>
