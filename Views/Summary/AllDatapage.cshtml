<script>
    

   
    //debugger;
    function updateVerticalMenu(menuType) {
        // Hide all vertical menus
        const menus = document.querySelectorAll('.vertical-menu');
        menus.forEach(function (menu) {
            menu.style.display = 'none';
        });

        // Show the relevant vertical menu
        const verticalMenu = document.getElementById('vertical-menu-' + menuType);
        if (verticalMenu) {
            verticalMenu.style.display = 'block';
        }
    }
    
    function loadContent(page) {
        // Hide all vertical menus
        const menus = document.querySelectorAll('.table');
        menus.forEach(function (menu) {
            menu.style.display = 'none';
        });

        // Show the relevant vertical menu
            const verticalMenu = document.getElementById('vertical-menu-users');
        if (verticalMenu) {
            verticalMenu.style.display = 'block';
        }

        var domaindata = $('#domainid').val();
               
               
                   

            $.ajax({
                        url: `/Summary/${page}?domain=${domaindata}`, // Replace with your dynamic URL
                type: 'GET',
                success: function (data) {

                    if (data.length > 0) {
                        let headers = Object.keys(data[0]); // Extract column names
                        let columnsToHide = ["id","userCode"]; // List of column names to hide
                        //let columnsToHide = ["id", "status"]; // List of column names to hide
                        let headerHtml = '';
                        let bodyHtml = '';

                                // function formatHeader(header) {
                                //     // Replace camelCase or PascalCase with words separated by spaces
                                //     const formattedHeader = header
                                //         .replace(/([a-z])([A-Z])/g, '$1 $2') // Add space before uppercase letters
                                //         .replace(/_/g, ' ') // Replace underscores with spaces
                                //         .replace(/\b\w/g, char => char.toUpperCase()); // Capitalize first letter of each word
                                //     return formattedHeader;
                                // }
                        // Generate table headers dynamically, skipping hidden columns
                        headers.forEach(header => {
                            if (!columnsToHide.includes(header)) {
                                        const formattedHeader = header.charAt(0).toUpperCase() + header.slice(1) + ' ';
                               headerHtml += `<th>${formattedHeader}</th>`;
                                //headerHtml += `<th>${header}</th>`;
                            }
                        });

                        // Generate table rows dynamically, skipping hidden columns
                        data.forEach(row => {
                            bodyHtml += '<tr>';
                            headers.forEach(header => {
                                if (!columnsToHide.includes(header)) {
                                    bodyHtml += `<td>${row[header]}</td>`; // Add table cells only for visible columns
                                }
                            });
                            bodyHtml += '</tr>';
                        });

                        // Construct the table with headers and rows
                        const table = `
                        <table class="table table-bordered">
                            <thead>
                                <tr>${headerHtml}</tr>
                            </thead>
                            <tbody>${bodyHtml}</tbody>
                        </table>
                    `;

                        // Append the table to the container
                        $('#employeeTableContainer').html(table);
                    } else {
                        $('#employeeTableContainer').html('<p>No data available</p>');
                    }
                },
                error: function (err) {
                    console.error('Error fetching data:', err);
                    $('#employeeTableContainer').html('<p>NO Data </p>');
                }
            });


            
        //}



    }



