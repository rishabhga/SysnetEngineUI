@model List<WindowsUserDetails>
<style>
    /* Horizontal Menu Styles */
    .horizontal-menu ul {
        list-style-type: none;
        display: flex;
       /* background-color: #333;  */
        padding: 0;
    }

    .horizontal-menu li {
        padding: 10px 15px;
        cursor: pointer;
        color: black;
    }

    .horizontal-menu li {
        position: relative;
        list-style: none; /* Remove default bullet points */
        padding: 10px 15px; /* Adjust padding as needed */
        display: inline-block; /* Make items inline */
        color: black; /* Default text color */
        transition: color 0.3s ease; /* Smooth transition for text color */
    }

        .horizontal-menu li:hover {
            color: blue; /* Change text color to blue on hover */
        }

            .horizontal-menu li:hover::after {
                content: ''; /* Add an empty content */
                position: absolute;
                bottom: 0; /* Position it at the bottom */
                left: 0;
                width: 100%; /* Full width of the menu item */
                height: 2px; /* Adjust thickness of the line */
                background-color: blue; /* Blue line on hover */
            }
        /* .horizontal-menu li:hover {
            background-color: #575757;
        } */

    /* Vertical Menu Styles */
    .vertical-menu {
        float: left;
        width: 100%;
        background-color: #f4f4f4;
        padding: 10px;
        height: 100vh; /* Full screen height */
    }

        .vertical-menu ul {
            list-style-type: none;
            padding: 0;
        }

        .vertical-menu li {
            padding: 8px 10px;
            cursor: pointer;
            color: #333;
        }

            .vertical-menu li:hover {
                background-color: #ddd;
            }

    /* Content Area */
    .content-area {
        margin-left: 21%; /* Align next to the vertical menu */
        padding: 20px;
    }
</style>

 
