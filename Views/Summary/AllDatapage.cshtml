@model List<WindowsUserDetails>
@{
    ViewData["Title"] = "Computer Details";
    ViewBag.SomeValue = ViewBag.UserName;
}

<div class="max-w-7xl mx-auto px-4 pt-3">
    <!-- Header -->
    <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-3">
            <a href="/Summary/Index" class="w-8 h-8 bg-white border border-gray-200 hover:bg-gray-50 rounded-lg flex items-center justify-center transition shadow-sm">
                <i class="fas fa-arrow-left text-gray-500 text-xs"></i>
            </a>
            <div class="w-9 h-9 rounded-xl flex items-center justify-center shadow-sm" style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                <i class="fas fa-laptop text-white text-sm"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold text-gray-900">@ViewBag.SomeValue</h1>
                <p class="text-[10px] text-gray-400 font-medium uppercase tracking-wider">Computer Details</p>
            </div>
        </div>
    </div>

    <!-- Info Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-3">
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Last Scan</p>
            <p class="text-sm font-bold text-gray-800">@ViewBag.lastScan</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-3">
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Current User</p>
            <p class="text-sm font-bold text-gray-800">@ViewBag.UserName</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-3">
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Last Login User</p>
            <p class="text-sm font-bold text-gray-800">@ViewBag.LastLogUser</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-3">
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Last Boot Time</p>
            <p class="text-sm font-bold text-gray-800">@ViewBag.LastBootTime</p>
        </div>
    </div>

    <input id="domainid" value="@ViewBag.SomeValue" type="hidden" />

    <!-- Category Tabs -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="flex overflow-x-auto border-b border-gray-100 px-2 pt-2 gap-1" id="categoryTabs">
            <button onclick="selectCategory('summary')" class="cat-tab active-cat px-3 py-2 text-xs font-bold rounded-t-lg transition-all whitespace-nowrap" data-cat="summary">Summary</button>
            <button onclick="selectCategory('system')" class="cat-tab px-3 py-2 text-xs font-bold rounded-t-lg transition-all whitespace-nowrap" data-cat="system">System</button>
            <button onclick="selectCategory('hardware')" class="cat-tab px-3 py-2 text-xs font-bold rounded-t-lg transition-all whitespace-nowrap" data-cat="hardware">Hardware</button>
            <button onclick="selectCategory('software')" class="cat-tab px-3 py-2 text-xs font-bold rounded-t-lg transition-all whitespace-nowrap" data-cat="software">Software</button>
            <button onclick="selectCategory('Certificate')" class="cat-tab px-3 py-2 text-xs font-bold rounded-t-lg transition-all whitespace-nowrap" data-cat="Certificate">Certificate</button>
            <button onclick="selectCategory('GeoTracking')" class="cat-tab px-3 py-2 text-xs font-bold rounded-t-lg transition-all whitespace-nowrap" data-cat="GeoTracking">GeoTracking</button>
            <button onclick="selectCategory('FileDetails')" class="cat-tab px-3 py-2 text-xs font-bold rounded-t-lg transition-all whitespace-nowrap" data-cat="FileDetails">File Details</button>
            <button onclick="selectCategory('security')" class="cat-tab px-3 py-2 text-xs font-bold rounded-t-lg transition-all whitespace-nowrap" data-cat="security">Security</button>
            <button onclick="selectCategory('Restriction')" class="cat-tab px-3 py-2 text-xs font-bold rounded-t-lg transition-all whitespace-nowrap" data-cat="Restriction">Restriction</button>
            <button onclick="selectCategory('UsbAudit')" class="cat-tab px-3 py-2 text-xs font-bold rounded-t-lg transition-all whitespace-nowrap" data-cat="UsbAudit">USB Audit</button>
            <button onclick="selectCategory('LoginHistory')" class="cat-tab px-3 py-2 text-xs font-bold rounded-t-lg transition-all whitespace-nowrap" data-cat="LoginHistory">Login History</button>
        </div>

        <div class="flex min-h-[400px]">
            <!-- Left Sub-Menu -->
            <div class="w-48 border-r border-gray-100 bg-gray-50/50 flex-shrink-0" id="subMenuPanel">
                <!-- Sub-menu items injected by JS -->
            </div>

            <!-- Content Area -->
            <div class="flex-1 p-4" id="dataContent">
                <div class="flex flex-col items-center justify-center h-full py-12">
                    <div class="w-14 h-14 rounded-full bg-gray-100 flex items-center justify-center mb-3">
                        <i class="fas fa-mouse-pointer text-gray-300 text-xl"></i>
                    </div>
                    <p class="text-gray-400 font-semibold text-sm">Select a category and sub-item to view data</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .cat-tab { color: #94a3b8; background: transparent; border: none; cursor: pointer; }
    .cat-tab:hover { color: #0284c7; background: #f0f9ff; }
    .cat-tab.active-cat { color: #0284c7; background: #eff6ff; border-bottom: 2px solid #0284c7; }
    .sub-item { display: block; width: 100%; text-align: left; padding: 8px 16px; font-size: 12px; font-weight: 500; color: #475569; background: transparent; border: none; border-left: 3px solid transparent; cursor: pointer; transition: all 0.15s; }
    .sub-item:hover { background: #f0f9ff; color: #0284c7; border-left-color: #38bdf8; }
    .sub-item.active-sub { background: #eff6ff; color: #0284c7; border-left-color: #0284c7; font-weight: 700; }
</style>

<script>
    const subMenus = {
        summary: ['Summary', 'CustomComputerDetails', 'DeviceSummary', 'OSSummary'],
        system: ['services', 'users', 'groups', 'drivers', 'Share'],
        hardware: ['Battery', 'BIOS', 'HardDisk', 'Keyboard', 'Monitor', 'Motherboard', 'NetworkAdapters', 'PhysicalMemory', 'PointingDevices', 'Printers', 'Processors', 'Sound', 'VideoControllers', 'USBControllers', 'USBHub'],
        software: ['DesktopApps', 'MicrosoftstoreApps', 'MeteredSoftware'],
        security: ['BltLocker', 'Antivirus', 'Firewall', 'MissingPatches'],
        UsbAudit: ['UsbDeviceAudit'],
        Restriction: ['RestrictionOnDevice', 'SecurityPrivacyDetails', 'ApplicationSettings', 'SocialSearchSettings'],
        LoginHistory: ['AuditHistory', 'LoginHistory'],
        Certificate: [],
        GeoTracking: [],
        FileDetails: []
    };

    function selectCategory(cat) {
        document.querySelectorAll('.cat-tab').forEach(t => t.classList.remove('active-cat'));
        document.querySelector(`.cat-tab[data-cat="${cat}"]`)?.classList.add('active-cat');

        const panel = document.getElementById('subMenuPanel');
        const items = subMenus[cat] || [];
        if (items.length === 0) {
            panel.innerHTML = '<div class="p-4 text-center text-gray-400 text-xs">No sub-items</div>';
            return;
        }
        panel.innerHTML = items.map(item => {
            const label = item.replace(/([A-Z])/g, ' $1').replace(/^./, s => s.toUpperCase()).trim();
            return `<button class="sub-item" onclick="loadData('${item}', this)">${label}</button>`;
        }).join('');
    }

    function loadData(page, btn) {
        document.querySelectorAll('.sub-item').forEach(s => s.classList.remove('active-sub'));
        if (btn) btn.classList.add('active-sub');

        const domain = $('#domainid').val();
        const content = document.getElementById('dataContent');
        content.innerHTML = `<div class="flex items-center justify-center py-12"><div class="flex items-center space-x-2 text-gray-400"><i class="fas fa-spinner fa-spin"></i><span class="text-sm font-semibold">Loading...</span></div></div>`;

        $.ajax({
            url: `/Summary/${page}?domain=${domain}`,
            type: 'GET',
            success: function(data) {
                if (data && data.length > 0) {
                    const headers = Object.keys(data[0]);
                    const hide = ['id', 'userCode'];
                    let headerHtml = '';
                    let bodyHtml = '';

                    headers.forEach(h => {
                        if (!hide.includes(h)) {
                            const label = h.replace(/([A-Z])/g, ' $1').replace(/^./, s => s.toUpperCase()).trim();
                            headerHtml += `<th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">${label}</th>`;
                        }
                    });

                    data.forEach(row => {
                        bodyHtml += '<tr class="hover:bg-blue-50/40 transition-colors">';
                        headers.forEach(h => {
                            if (!hide.includes(h)) {
                                bodyHtml += `<td class="px-4 py-2.5 text-xs text-gray-700">${row[h] ?? ''}</td>`;
                            }
                        });
                        bodyHtml += '</tr>';
                    });

                    content.innerHTML = `
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-xs font-bold text-gray-500">${data.length} records</span>
                        </div>
                        <div class="overflow-x-auto rounded-lg border border-gray-200">
                            <table class="w-full text-xs">
                                <thead><tr class="border-b border-gray-100" style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">${headerHtml}</tr></thead>
                                <tbody class="divide-y divide-gray-50">${bodyHtml}</tbody>
                            </table>
                        </div>`;
                } else {
                    content.innerHTML = `
                        <div class="flex flex-col items-center justify-center py-12">
                            <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center mb-3">
                                <i class="fas fa-inbox text-gray-300 text-lg"></i>
                            </div>
                            <p class="text-gray-400 font-semibold text-sm">No data available</p>
                        </div>`;
                }
            },
            error: function(err) {
                content.innerHTML = `
                    <div class="flex flex-col items-center justify-center py-12">
                        <div class="w-12 h-12 rounded-full bg-red-50 flex items-center justify-center mb-3">
                            <i class="fas fa-exclamation-triangle text-red-300 text-lg"></i>
                        </div>
                        <p class="text-red-400 font-semibold text-sm">Error loading data</p>
                    </div>`;
            }
        });
    }

    // Auto-select Summary on load
    selectCategory('summary');
</script>
