@model List<WindowsUserDetails>
@{
    ViewData["Title"] = "Computer List";
}

<div class="max-w-7xl mx-auto px-4 pt-3">
    <!-- Page Header -->
    <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-3">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center shadow-sm" style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                <i class="fas fa-desktop text-white text-sm"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold text-gray-900">Computers</h1>
                <p class="text-[10px] text-gray-400 font-medium uppercase tracking-wider">Enabled User Accounts</p>
            </div>
        </div>
        <span class="px-3 py-1 bg-blue-50 text-blue-700 text-xs font-bold rounded-lg border border-blue-200">
            @(Model?.Count ?? 0) Records
        </span>
    </div>

    <!-- Table Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table id="summaryTable" class="w-full text-xs">
                <thead>
                    <tr class="border-b border-gray-100" style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">#</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">User Name</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Domain Name</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Account Type</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Full Name</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @if (Model != null && Model.Any())
                    {
                        var idx = 0;
                        @foreach (var item in Model)
                        {
                            idx++;
                            <tr class="hover:bg-blue-50/40 transition-colors cursor-pointer" onclick="window.location='/Summary/AllDatapage?domain=@item.DomainName'">
                                <td class="px-4 py-2.5 text-gray-400 font-mono">@idx</td>
                                <td class="px-4 py-2.5 font-semibold text-gray-800">@item.UserName</td>
                                <td class="px-4 py-2.5">
                                    <a href="/Summary/AllDatapage?domain=@item.DomainName" class="text-blue-600 hover:text-blue-800 font-semibold hover:underline">
                                        @item.DomainName
                                    </a>
                                </td>
                                <td class="px-4 py-2.5 text-gray-600">@item.AccountType</td>
                                <td class="px-4 py-2.5 text-gray-600">@item.FullName</td>
                                <td class="px-4 py-2.5">
                                    @if (item.Status == "Enabled" || item.Status == "OK")
                                    {
                                        <span class="px-2 py-0.5 bg-green-50 text-green-700 text-[10px] font-bold rounded-md border border-green-200">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 bg-gray-50 text-gray-500 text-[10px] font-bold rounded-md border border-gray-200">@item.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#summaryTable').DataTable({
                responsive: true,
                pageLength: 10,
                language: {
                    search: "",
                    searchPlaceholder: "Search records...",
                    lengthMenu: "_MENU_ per page",
                    info: "Showing _START_ to _END_ of _TOTAL_",
                    emptyTable: '<div class="cs-dt-empty"><i class="fas fa-inbox"></i><span>No records found</span></div>',
                    paginate: {
                        previous: '<i class="fas fa-chevron-left"></i>',
                        next: '<i class="fas fa-chevron-right"></i>'
                    }
                },
                dom: '<"cs-dt-top"lf>rt<"cs-dt-bottom"ip>',
                initComplete: function () {
                    var $wrapper = $('#summaryTable').closest('.dataTables_wrapper');
                    $wrapper.find('.dataTables_filter').addClass('cs-dt-search-wrapper');
                    $wrapper.find('.dataTables_filter input').addClass('cs-dt-search-input');
                    if ($wrapper.find('.dataTables_filter i.fa-search').length === 0) {
                        $wrapper.find('.dataTables_filter').prepend('<i class="fas fa-search cs-dt-search-icon"></i>');
                    }
                    $wrapper.find('.dataTables_length select').addClass('cs-dt-length-select');
                }
            });
        });
    </script>
}
