@{
    ViewData["Title"] = "SLA Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen p-4" style="background:#F0F4F8;">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="mb-5">
            <div class="flex justify-between items-start mb-3">
                <div>
                    <h1 class="text-xl font-bold text-gray-900">SLA Management & Tracking</h1>
                    <p class="text-gray-600 text-sm mt-0.5">Configure SLA policies and monitor breaches</p>
                </div>
                @if (ViewBag.CanManageSLA == true)
                {
                    <button class="px-3 py-1.5 text-white text-sm font-medium rounded flex items-center" style="background:linear-gradient(135deg,#00BCEB,#0096BE);" " data-toggle="modal" data-target="#addSLAConfigModal">
                        <i class="fas fa-plus mr-1.5 text-xs"></i>
                        Add SLA Policy
                    </button>
                }
            </div>
        </div>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4" id="slaStatsRow">
            <div class="bg-white rounded border border-gray-200 p-3 hover:border-emerald-300 transition-colors">
                <div class="flex justify-between items-start">
                    <div>
                        <div class="text-xs font-medium text-gray-500 uppercase tracking-wider">SLA Compliance</div>
                        <div class="text-lg font-bold mt-1" style="color:#8FB829;" " id="statCompliance">--</div>
                    </div>
                    <div class="w-8 h-8 rounded bg-emerald-50 flex items-center justify-center">
                        <i class="fas fa-percent text-emerald-500 text-sm"></i>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded border border-gray-200 p-3 hover:border-red-300 transition-colors">
                <div class="flex justify-between items-start">
                    <div>
                        <div class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total Breaches</div>
                        <div class="text-lg font-bold mt-1" style="color:#EF4444;" " id="statTotalBreach">--</div>
                    </div>
                    <div class="w-8 h-8 rounded bg-red-50 flex items-center justify-center">
                        <i class="fas fa-exclamation-circle text-red-500 text-sm"></i>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded border border-gray-200 p-3 hover:border-amber-300 transition-colors">
                <div class="flex justify-between items-start">
                    <div>
                        <div class="text-xs font-medium text-gray-500 uppercase tracking-wider">Response Breaches</div>
                        <div class="text-lg font-bold mt-1" style="color:#F97316;" " id="statResponseBreach">--</div>
                    </div>
                    <div class="w-8 h-8 rounded bg-amber-50 flex items-center justify-center">
                        <i class="fas fa-reply text-amber-500 text-sm"></i>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded border border-gray-200 p-3 hover:border-[#00BCEB] transition-colors">
                <div class="flex justify-between items-start">
                    <div>
                        <div class="text-xs font-medium text-gray-500 uppercase tracking-wider">Avg Breach Duration</div>
                        <div class="text-lg font-bold mt-1" style="color:#0096BE;" " id="statAvgDuration">--</div>
                    </div>
                    <div class="w-8 h-8 rounded flex items-center" style="background:#E0F7FD;" justify-center">
                        <i class="fas fa-hourglass-half text-blue-500 text-sm"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- SLA Policies Table -->
        @if (ViewBag.CanManageSLA == true)
        {
            <div class="bg-white rounded border border-gray-200 mb-4">
                <div class="px-3 py-2.5 border-b border-gray-100 bg-gray-50">
                    <h2 class="font-medium text-gray-800 text-sm">Active SLA Policies</h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left min-w-[700px]" id="slaConfigsTable">
                        <thead>
                            <tr class="bg-gray-50 text-gray-500 text-xs border-b border-gray-200">
                                <th class="px-3 py-2 font-medium">PRIORITY</th>
                                <th class="px-3 py-2 font-medium">RESPONSE (mins)</th>
                                <th class="px-3 py-2 font-medium">RESOLUTION (mins)</th>
                                <th class="px-3 py-2 font-medium">AUTO ESCALATE</th>
                                <th class="px-3 py-2 font-medium">NOTIFY EMAIL</th>
                                <th class="px-3 py-2 font-medium">STATUS</th>
                                <th class="px-3 py-2 font-medium">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody class="text-sm"></tbody>
                    </table>
                </div>
            </div>
        }

        <!-- SLA Breach History -->
        <div class="bg-white rounded border border-gray-200">
            <div class="px-3 py-2.5 border-b border-gray-100 bg-red-50 flex items-center gap-2">
                <i class="fas fa-radiation text-red-500 text-sm"></i>
                <h2 class="font-medium text-red-800 text-sm">SLA Breach History</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left min-w-[640px]" id="breachLogsTable">
                    <thead>
                        <tr class="bg-gray-50 text-gray-500 text-xs border-b border-gray-200">
                            <th class="px-3 py-2 font-medium">DATE</th>
                            <th class="px-3 py-2 font-medium">TICKET</th>
                            <th class="px-3 py-2 font-medium">BREACH TYPE</th>
                            <th class="px-3 py-2 font-medium">TARGET</th>
                            <th class="px-3 py-2 font-medium">OVERDUE BY</th>
                            <th class="px-3 py-2 font-medium">PRIORITY</th>
                            <th class="px-3 py-2 font-medium">ASSIGNEE</th>
                        </tr>
                    </thead>
                    <tbody class="text-sm"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- SLA Config Modal -->
<div id="addSLAConfigModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-lg w-full max-w-md shadow-xl">
        <div class="px-4 py-3 border-b" style="background:#F1F8E9; border-color:#d1e8a0;" flex items-center rounded-t-lg">
            <i class="fas fa-sliders-h mr-2" style="color:#0096BE;" "></i>
            <h3 class="font-medium text-sm" style="color:#0096BE;" ">SLA Policy Configuration</h3>
            <button onclick="$('#addSLAConfigModal').addClass('hidden')" class="ml-auto text-gray-400 hover:text-gray-600">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <form id="slaConfigForm" class="p-4">
            <input type="hidden" id="ConfigId" name="Id" value="0">
            <div class="mb-3">
                <label class="block text-xs font-medium text-gray-700 mb-1">Priority Level</label>
                <select name="Priority" id="ConfigPriority" required
                        class="w-full h-9 text-sm border border-gray-300 rounded px-2 outline-none" style="border:1px solid #d1d5db;" onfocus="this.style.borderColor='#00BCEB'" onblur="this.style.borderColor='#d1d5db'" outline-none bg-white">
                    <option value="">-- Loading --</option>
                </select>
            </div>
            <div class="grid grid-cols-2 gap-3 mb-3">
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Response Time (mins)</label>
                    <input type="number" name="ResponseTimeMinutes" id="ConfigResponseTime" required
                           class="w-full h-9 text-sm border border-gray-300 rounded px-3 outline-none" style="border:1px solid #d1d5db;" onfocus="this.style.borderColor='#00BCEB'" onblur="this.style.borderColor='#d1d5db'" outline-none">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Resolution Time (mins)</label>
                    <input type="number" name="ResolutionTimeMinutes" id="ConfigResolutionTime" required
                           class="w-full h-9 text-sm border border-gray-300 rounded px-3 outline-none" style="border:1px solid #d1d5db;" onfocus="this.style.borderColor='#00BCEB'" onblur="this.style.borderColor='#d1d5db'" outline-none">
                </div>
            </div>
            <div class="mb-3">
                <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
                    <input type="checkbox" id="ConfigAutoEscalate" name="AutoEscalate" value="true"
                           class="w-4 h-4 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500">
                    Enable Auto-Escalation on Breach
                </label>
            </div>
            <div class="mb-4">
                <label class="block text-xs font-medium text-gray-700 mb-1">Breach Notification Emails (comma separated)</label>
                <input type="text" name="BreachNotificationEmails" id="ConfigEmails"
                       class="w-full h-9 text-sm border border-gray-300 rounded px-3 outline-none" style="border:1px solid #d1d5db;" onfocus="this.style.borderColor='#00BCEB'" onblur="this.style.borderColor='#d1d5db'" outline-none"
                       placeholder="admin@company.com, manager@company.com">
            </div>
            <div class="flex gap-2 pt-3 border-t border-gray-100">
                <button type="button" onclick="$('#addSLAConfigModal').addClass('hidden')"
                        class="flex-1 py-1.5 text-sm text-gray-600 font-medium hover:bg-gray-50 rounded border border-gray-200">
                    Cancel
                </button>
                <button type="submit"
                        class="flex-1 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium rounded">
                    Save Policy
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto-seed ServiceDesk permissions on first load
            $.ajax({
                url: '@Url.Action("SeedServiceDeskPermissions", "ServiceDesk")',
                type: 'POST',
                success: function(res) {
                    if (res && res.permissionsCreated > 0) {
                        console.log('ServiceDesk permissions seeded:', res.message);
                    }
                },
                error: function() { /* silent fail — permissions may already exist */ }
            });

            loadSLAConfigs();
            loadSLABreaches();
            loadSLAStats();
            loadPriorities();

            // Open modal
            $('[data-toggle="modal"][data-target="#addSLAConfigModal"]').click(function() {
                $('#addSLAConfigModal').removeClass('hidden');
            });

            $('#slaConfigForm').submit(function(e) {
                e.preventDefault();
                var data = $(this).serializeArray().reduce(function(obj, item) {
                    obj[item.name] = item.value;
                    return obj;
                }, {});

                data.AutoEscalate = $('#ConfigAutoEscalate').is(':checked');
                data.IsActive = true;
                data.ResponseTimeMinutes = parseInt(data.ResponseTimeMinutes) || 0;
                data.ResolutionTimeMinutes = parseInt(data.ResolutionTimeMinutes) || 0;
                data.Id = parseInt(data.Id) || 0;

                $.ajax({
                    url: '@Url.Action("SaveSLAConfig", "ServiceDesk")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function(res) {
                        if (res.success) {
                            $('#addSLAConfigModal').addClass('hidden');
                            sysAlert('SLA Policy saved successfully', 'success');
                            loadSLAConfigs();
                            $('#slaConfigForm')[0].reset();
                            $('#ConfigId').val(0);
                        } else {
                            sysAlert('Error saving policy', 'error');
                        }
                    }
                });
            });
        });

        function loadSLAConfigs() {
            $.ajax({
                url: '@Url.Action("GetAllSLAConfigs", "ServiceDesk")',
                type: 'GET',
                success: function(data) {
                    var tbody = $('#slaConfigsTable tbody');
                    tbody.empty();

                    if (!data || !Array.isArray(data) || data.length === 0) {
                        var msg = (data && data.error) ? `<span class="text-red-500">Error: ${data.error}</span>` : 'No SLA policies configured yet. Click "Add SLA Policy" to create one.';
                        tbody.append(`<tr><td colspan="7" class="px-3 py-4 text-center text-gray-400 text-sm">${msg}</td></tr>`);
                        return;
                    }
                    data.forEach(function(c) {
                        var escBadge = c.autoEscalate
                            ? '<span class="px-1.5 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-700">Yes</span>'
                            : '<span class="px-1.5 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-500">No</span>';
                        var btn = `<button class="px-2 py-1 text-xs text-red-600 hover:bg-red-50 rounded" onclick="deleteConfig(${c.id})"><i class="fas fa-trash"></i></button>`;

                        tbody.append(`<tr class="border-b border-gray-50 hover:bg-gray-50">
                            <td class="px-3 py-2 font-medium text-gray-800">${c.priority}</td>
                            <td class="px-3 py-2 text-gray-600">${c.responseTimeMinutes} min</td>
                            <td class="px-3 py-2 text-gray-600">${c.resolutionTimeMinutes} min</td>
                            <td class="px-3 py-2">${escBadge}</td>
                            <td class="px-2 py-2 text-gray-500 text-[10px] break-all max-w-[150px]">${c.breachNotificationEmails || '-'}</td>
                            <td class="px-3 py-2"><span class="px-1.5 py-0.5 rounded text-xs font-medium text-[#5a7a00]" style="background:#F1F8E9;"">Active</span></td>
                            <td class="px-3 py-2">${btn}</td>
                        </tr>`);
                    });
                }
            });
        }

        function loadPriorities() {
            $.ajax({
                url: '@Url.Action("GetAllPriorities", "ServiceDesk")',
                type: 'GET',
                success: function(data) {
                    var $sel = $('#ConfigPriority');
                    $sel.empty();
                    if (data && Array.isArray(data) && data.length) {
                        data.forEach(function(p) {
                            var name = p.priorityName || p.PriorityName || p.label || p.value || p;
                            $sel.append('<option value="' + name + '">' + name + '</option>');
                        });
                    } else {
                        $sel.append('<option value="">No priorities found — add in Admin Settings</option>');
                    }
                },
                error: function() {
                    var $sel = $('#ConfigPriority');
                    $sel.empty();
                    $sel.append('<option value="">Failed to load priorities</option>');
                }
            });
        }

        function deleteConfig(id) {
            sysConfirm("Delete this SLA Policy?", function() {
                $.ajax({
                    url: '@Url.Action("DeleteSLAConfig", "ServiceDesk")/' + id,
                    type: 'POST',
                    success: function(res) {
                        if (res.success || res.status === 200) {
                            sysAlert("Policy deleted", "success");
                            loadSLAConfigs();
                        } else {
                            sysAlert(res.message || "Failed to delete policy", "error");
                        }
                    },
                    error: function() {
                        sysAlert("Connection error", "error");
                    }
                });
            });
        }

        function loadSLABreaches() {
            $.ajax({
                url: '@Url.Action("GetSLABreaches", "ServiceDesk")',
                type: 'GET',
                success: function(data) {
                    var tbody = $('#breachLogsTable tbody');
                    tbody.empty();
                    var breaches = data.items || data.breaches || (Array.isArray(data) ? data : []);
                    if (!breaches || breaches.length === 0) {
                        tbody.append('<tr><td colspan="7" class="px-3 py-4 text-center text-gray-400 text-sm">No SLA breaches recorded.</td></tr>');
                        return;
                    }
                    breaches.forEach(function(b) {
                        var date = new Date(b.breachedAt).toLocaleString();
                        var target = new Date(b.expectedTime).toLocaleString();
                        var pClass = (b.priority === 'Urgent' || b.priority === 'High')
                            ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700';
                        var tClass = b.breachType === 'Response' ? 'bg-[#E0F7FD] text-blue-700' : 'bg-red-100 text-red-700';

                        tbody.append(`<tr class="border-b border-gray-50 hover:bg-gray-50">
                            <td class="px-3 py-2 text-gray-600">${date}</td>
                            <td class="px-3 py-2"><a href="/ServiceDesk/Details/${b.ticketId}" class="text-blue-600 hover:text-blue-800 font-medium">${b.ticketNo}</a></td>
                            <td class="px-3 py-2"><span class="px-1.5 py-0.5 rounded text-xs font-medium ${tClass}">${b.breachType} SLA</span></td>
                            <td class="px-3 py-2 text-gray-500 text-xs">${target}</td>
                            <td class="px-3 py-2 font-bold text-red-600">+${b.breachDurationMinutes} min</td>
                            <td class="px-3 py-2"><span class="px-1.5 py-0.5 rounded text-xs font-medium ${pClass}">${b.priority}</span></td>
                            <td class="px-3 py-2 text-gray-600">${b.assignedToName || 'Unassigned'}</td>
                        </tr>`);
                    });
                }
            });
        }

        function loadSLAStats() {
            $.ajax({
                url: '@Url.Action("GetSLABreachStats", "ServiceDesk")',
                type: 'GET',
                success: function(data) {
                    if(data && data.complianceRate !== undefined) {
                        $('#statCompliance').text(data.complianceRate + '%');
                        $('#statTotalBreach').text(data.breachedTickets);
                        $('#statResponseBreach').text(data.responseBreaches);
                        $('#statAvgDuration').text(data.avgBreachDurationMinutes + ' min');
                    }
                }
            });
        }
    </script>
}
