@{
    ViewData["Title"] = "Parts Inventory";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="p-6 bg-gray-50 min-h-screen">
    <div class="max-w-7xl mx-auto space-y-6">
        
        <!-- Header -->
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Parts Inventory</h1>
                <p class="text-sm text-gray-500">Manage standard parts and pricing</p>
            </div>
            <button onclick="openModal('partModal')" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 shadow-sm flex items-center gap-2 transition-all">
                <i class="fas fa-plus"></i> Add New Part
            </button>
        </div>

        <!-- Search & Filter -->
        <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex gap-4">
            <div class="relative flex-1">
                <i class="fas fa-search absolute left-3 top-3 text-gray-400"></i>
                <input type="text" id="searchInput" placeholder="Search parts..." class="w-full pl-10 pr-4 py-2 bg-gray-50 border-none rounded-lg focus:ring-2 focus:ring-blue-100 text-sm">
            </div>
            <button onclick="loadParts()" class="px-4 py-2 text-gray-600 hover:bg-gray-50 rounded-lg border border-gray-200">
                <i class="fas fa-sync-alt"></i> Refresh
            </button>
        </div>

        <!-- Parts Table -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-100">
                    <tr>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Part Name</th>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase">Part Number</th>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase text-right">Unit Cost</th>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase text-center">Stock</th>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase text-center">Status</th>
                        <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase text-center">Actions</th>
                    </tr>
                </thead>
                <tbody id="partsTableBody" class="divide-y divide-gray-100">
                    <tr><td colspan="6" class="px-6 py-8 text-center text-gray-400">Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add/Edit Part Modal -->
<div id="partModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md transform transition-all scale-95 opacity-0" id="partModalContent">
        <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50 rounded-t-2xl">
            <h3 class="font-bold text-gray-800" id="modalTitle">Add New Part</h3>
            <button onclick="closeModal('partModal')" class="text-gray-400 hover:text-gray-600 transition-colors"><i class="fas fa-times"></i></button>
        </div>
        
        <div class="p-6 space-y-4">
            <input type="hidden" id="partId">
            
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Part Name <span class="text-red-500">*</span></label>
                <input type="text" id="partName" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:border-blue-500 focus:bg-white transition-all text-sm" placeholder="e.g. SSD 1TB">
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Part Number (SKU)</label>
                <input type="text" id="partNumber" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:border-blue-500 focus:bg-white transition-all text-sm" placeholder="e.g. SAMSUNG-980-1TB">
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Unit Cost (₹) <span class="text-red-500">*</span></label>
                    <input type="number" id="unitCost" step="0.01" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:border-blue-500 focus:bg-white transition-all text-sm" placeholder="0.00">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Stock Quantity</label>
                    <input type="number" id="stockQty" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:border-blue-500 focus:bg-white transition-all text-sm" placeholder="0">
                </div>
            </div>
            
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Description</label>
                <textarea id="description" rows="3" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:border-blue-500 focus:bg-white transition-all text-sm resize-none"></textarea>
            </div>
        </div>

        <div class="p-6 bg-gray-50 rounded-b-2xl border-t border-gray-100 flex justify-end gap-3">
            <button onclick="closeModal('partModal')" class="px-4 py-2 text-gray-600 hover:bg-gray-200 rounded-lg text-sm font-medium transition-colors">Cancel</button>
            <button onclick="savePart()" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 shadow-lg shadow-blue-600/20 text-sm font-medium transition-all">Save Part</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', loadParts);

    function openModal(id) {
        const modal = document.getElementById(id);
        const content = document.getElementById(id + 'Content');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => {
            content.classList.remove('scale-95', 'opacity-0');
            content.classList.add('scale-100', 'opacity-100');
        }, 10);

        if(id === 'partModal' && !document.getElementById('partId').value) {
            resetForm();
        }
    }

    function closeModal(id) {
        const modal = document.getElementById(id);
        const content = document.getElementById(id + 'Content');
        content.classList.remove('scale-100', 'opacity-100');
        content.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }, 300);
    }

    function resetForm() {
        document.getElementById('partId').value = '';
        document.getElementById('partName').value = '';
        document.getElementById('partNumber').value = '';
        document.getElementById('unitCost').value = '';
        document.getElementById('stockQty').value = '';
        document.getElementById('description').value = '';
        document.getElementById('modalTitle').innerText = 'Add New Part';
    }

    function editPart(part) {
        document.getElementById('partId').value = part.id;
        document.getElementById('partName').value = part.partName;
        document.getElementById('partNumber').value = part.partNumber || '';
        document.getElementById('unitCost').value = part.unitCost;
        document.getElementById('stockQty').value = part.stockQuantity;
        document.getElementById('description').value = part.description || '';
        document.getElementById('modalTitle').innerText = 'Edit Part';
        openModal('partModal');
    }

    async function loadParts() {
        const tbody = document.getElementById('partsTableBody');
        tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-gray-400"><i class="fas fa-spinner fa-spin mr-2"></i>Loading...</td></tr>';

        try {
            const res = await fetch('/ServiceDesk/GetMasterParts');
            const text = await res.text();
            
            try {
                const data = JSON.parse(text);
                if (!data || data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-gray-400">No parts found. Add one to get started.</td></tr>';
                    return;
                }
                // ... rendering logic ...
                let html = '';
                data.forEach(p => {
                    html += `
                        <tr class="hover:bg-gray-50 transition-colors group">
                            <td class="px-6 py-4 text-sm font-medium text-gray-800">${p.partName}</td>
                            <td class="px-6 py-4 text-sm text-gray-500 font-mono text-xs">${p.partNumber || '-'}</td>
                            <td class="px-6 py-4 text-sm text-right text-gray-800">₹${p.unitCost.toFixed(2)}</td>
                            <td class="px-6 py-4 text-center">
                                <span class="px-2 py-1 text-xs font-medium rounded-full ${p.stockQuantity > 0 ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}">
                                    ${p.stockQuantity}
                                </span>
                            </td>
                             <td class="px-6 py-4 text-center">
                                <span class="px-2 py-1 text-xs font-medium rounded-full ${p.isActive ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-700'}">
                                    ${p.isActive ? 'Active' : 'Inactive'}
                                </span>
                            </td>
                            <td class="px-6 py-4 text-center group-hover:opacity-100 opacity-60 transition-opacity">
                                <button onclick='editPart(${JSON.stringify(p)})' class="text-blue-500 hover:text-blue-700 mx-1" title="Edit"><i class="fas fa-edit"></i></button>
                                <button onclick="deletePart(${p.id})" class="text-red-400 hover:text-red-600 mx-1" title="Delete"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                    `;
                });
                tbody.innerHTML = html;
            } catch (e) {
                console.error("JSON Parse Error:", e, text);
                tbody.innerHTML = `<tr><td colspan="6" class="px-6 py-8 text-center text-red-400">Failed to parse parts data. Response: ${text.substring(0, 100)}...</td></tr>`;
            }
        } catch (error) {
            console.error(error);
            tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-red-400">Failed to load parts</td></tr>';
        }
    }

    async function savePart() {
        const id = document.getElementById('partId').value;
        const part = {
            id: id ? parseInt(id) : 0,
            partName: document.getElementById('partName').value,
            partNumber: document.getElementById('partNumber').value,
            unitCost: parseFloat(document.getElementById('unitCost').value) || 0,
            stockQuantity: parseInt(document.getElementById('stockQty').value) || 0,
            description: document.getElementById('description').value,
            isActive: true
        };

        if (!part.partName || part.unitCost < 0) {
            sysAlert("Please fill in Part Name and a valid Cost.", "warning");
            return;
        }

        try {
            const url = id ? '/ServiceDesk/UpdateMasterPart' : '/ServiceDesk/AddMasterPart';
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(part)
            });
            const text = await res.text();
            
            try {
                const result = JSON.parse(text);
                if (result.success) {
                    closeModal('partModal');
                    loadParts();
                } else {
                    sysAlert(result.message || "Operation failed", "error");
                }
            } catch (e) {
                console.error("JSON Parse Error:", e, text);
                sysAlert(`Error saving part: Server returned invalid JSON. Content: ${text.substring(0, 150)}`, "error");
            }
        } catch (error) {
            console.error(error);
            sysAlert("Error saving part: " + error.message, "error");
        }
    }

    function deletePart(id) {
        sysConfirm("Are you sure you want to delete this part?", async function() {
            try {
                const res = await fetch(`/ServiceDesk/DeleteMasterPart?id=${id}`, { method: 'POST' });
                const result = await res.json();
                if (result.success) {
                    loadParts();
                    sysAlert("Part deleted successfully", "success");
                }
                else sysAlert(result.message || "Failed to delete", "error");
            } catch (error) {
                console.error(error);
                sysAlert("Error deleting part", "error");
            }
        }, { type: 'danger' });
    }
</script>
