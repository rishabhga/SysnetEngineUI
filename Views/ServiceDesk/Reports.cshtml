@{
    ViewData["Title"] = "Reports & Analytics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .rpt-card {
        background: #fff;
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        box-shadow: 0 1px 3px rgba(0,0,0,.05),0 4px 16px rgba(0,0,0,.05);
        overflow: hidden;
    }

    .rpt-card-header {
        padding: 12px 16px 10px;
        border-bottom: 1px solid #F1F5F9;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .rpt-icon {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        flex-shrink: 0;
    }

    .bar-wrap {
        display: flex;
        align-items: flex-end;
        gap: 3px;
        height: 160px;
        padding: 0 4px;
    }

    .bar-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        height: 100%;
        justify-content: flex-end;
    }

    .bar-tooltip {
        font-size: 9px;
        font-weight: 700;
        color: #0F172A;
        opacity: 0;
        transition: opacity .15s;
        white-space: nowrap;
    }

    .bar-col:hover .bar-tooltip {
        opacity: 1;
    }

    .bar-rect {
        width: 100%;
        border-radius: 4px 4px 0 0;
        background: linear-gradient(180deg,#00BCEB 0%,#0096BE 100%);
        transition: filter .15s;
        min-height: 4px;
    }

    .bar-col:hover .bar-rect {
        filter: brightness(1.12);
    }

    .bar-labels {
        display: flex;
        gap: 3px;
        padding: 0 4px;
        margin-top: 4px;
    }

    .bar-label {
        flex: 1;
        text-align: center;
        font-size: 9px;
        color: #94A3B8;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .stat-card {
        background: #fff;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 12px 14px;
        box-shadow: 0 1px 3px rgba(0,0,0,.04);
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            border-radius: 12px 12px 0 0;
        }

    .stat-cyan::before {
        background: linear-gradient(90deg,#00BCEB,#0096BE);
    }

    .stat-lime::before {
        background: linear-gradient(90deg,#B4D334,#8FB829);
    }

    .stat-orange::before {
        background: linear-gradient(90deg,#F97316,#EA580C);
    }

    .stat-slate::before {
        background: linear-gradient(90deg,#64748B,#475569);
    }

    .prog-bar-bg {
        background: #F1F5F9;
        border-radius: 99px;
        height: 8px;
        overflow: hidden;
        flex: 1;
    }

    .prog-bar-fill {
        height: 100%;
        border-radius: 99px;
        transition: width .6s cubic-bezier(.22,1,.36,1);
    }
</style>

<div class="min-h-screen px-3 pt-4 pb-12 sm:px-4 lg:px-6" style="background:#F0F4F8;">
    <div class="max-w-6xl mx-auto">

        <!-- Page Header -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl flex items-center justify-center text-white text-sm" style="background:linear-gradient(135deg,#00BCEB,#0096BE);">
                    <i class="fas fa-chart-bar"></i>
                </div>
                <div>
                    <h1 class="text-[15px] font-bold text-slate-900 leading-tight">Reports &amp; Analytics</h1>
                    <p class="text-[11px] text-slate-500">Ticket trends, engineer performance &amp; SLA compliance</p>
                </div>
            </div>
            <select id="dayRange" onchange="loadAll()"
                    class="h-9 text-sm border border-slate-200 rounded-lg px-3 bg-white outline-none shadow-sm font-medium text-slate-700"
                    onfocus="this.style.borderColor='#00BCEB'" onblur="this.style.borderColor='';">
                <option value="7">Last 7 Days</option>
                <option value="30" selected>Last 30 Days</option>
                <option value="90">Last 90 Days</option>
            </select>
        </div>

        <!-- Summary Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5" id="summaryCards"></div>

        <!-- Row 1 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div class="rpt-card">
                <div class="rpt-card-header">
                    <div class="rpt-icon" style="background:#E0F7FD; color:#0096BE;"><i class="fas fa-chart-line"></i></div>
                    <div>
                        <div class="text-[13px] font-bold text-slate-800">Ticket Volume Trend</div>
                        <div class="text-[10px] text-slate-400">Daily ticket count over selected period</div>
                    </div>
                </div>
                <div class="p-4">
                    <div class="bar-wrap" id="trendChart">
                        <div class="w-full flex items-center justify-center text-slate-300 text-sm"><i class="fas fa-spinner fa-spin mr-2"></i>Loading...</div>
                    </div>
                    <div class="bar-labels" id="trendLabels"></div>
                </div>
            </div>
            <div class="rpt-card">
                <div class="rpt-card-header">
                    <div class="rpt-icon" style="background:#F3E8FF; color:#9333EA;"><i class="fas fa-tags"></i></div>
                    <div>
                        <div class="text-[13px] font-bold text-slate-800">Tickets by Category</div>
                        <div class="text-[10px] text-slate-400">Distribution across categories</div>
                    </div>
                </div>
                <div class="p-4 space-y-2.5" id="categoryChart">
                    <div class="text-center text-slate-300 text-sm py-8"><i class="fas fa-spinner fa-spin"></i></div>
                </div>
            </div>
        </div>

        <!-- Row 2 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div class="rpt-card">
                <div class="rpt-card-header">
                    <div class="rpt-icon" style="background:#FFF7ED; color:#F97316;"><i class="fas fa-exclamation-triangle"></i></div>
                    <div>
                        <div class="text-[13px] font-bold text-slate-800">Tickets by Priority</div>
                        <div class="text-[10px] text-slate-400">Priority level breakdown</div>
                    </div>
                </div>
                <div class="p-4 space-y-2.5" id="priorityChart">
                    <div class="text-center text-slate-300 text-sm py-8"><i class="fas fa-spinner fa-spin"></i></div>
                </div>
            </div>
            <div class="rpt-card">
                <div class="rpt-card-header">
                    <div class="rpt-icon" style="background:#F1F8E9; color:#8FB829;"><i class="fas fa-user-cog"></i></div>
                    <div>
                        <div class="text-[13px] font-bold text-slate-800">Engineer Performance</div>
                        <div class="text-[10px] text-slate-400">Resolution rates per engineer</div>
                    </div>
                </div>
                <div class="p-4" id="engineerTable">
                    <div class="text-center text-slate-300 text-sm py-8"><i class="fas fa-spinner fa-spin"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() { loadAll(); });

        function loadAll() {
            var days = $('#dayRange').val();
            loadTrend(days);
            loadCategoryBreakdown();
            loadPriorityBreakdown();
            loadEngineerPerf();
        }

        function loadTrend(days) {
            $.get('@Url.Action("GetTicketTrends", "ServiceDesk")', { days: days }, function(data) {
                var chartEl = $('#trendChart').empty();
                var labelEl = $('#trendLabels').empty();
                var cardsEl = $('#summaryCards').empty();

                var total = 0, peak = 0;
                if (data && data.length) {
                    total = data.reduce(function(s,d){ return s+d.count; }, 0);
                    peak  = Math.max.apply(null, data.map(function(d){ return d.count; }));
                }
                var avg = data && data.length ? (total / Math.max(parseInt(days),1)).toFixed(1) : '0';

                cardsEl.html(
                    '<div class="stat-card stat-cyan"><div class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider mb-1">Total Tickets</div><div class="text-2xl font-black text-slate-800">'+total+'</div></div>'+
                    '<div class="stat-card stat-lime"><div class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider mb-1">Daily Avg</div><div class="text-2xl font-black" style="color:#8FB829;">'+avg+'</div></div>'+
                    '<div class="stat-card stat-orange"><div class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider mb-1">Peak Day</div><div class="text-2xl font-black" style="color:#F97316;">'+peak+'</div></div>'+
                    '<div class="stat-card stat-slate"><div class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider mb-1">Active Days</div><div class="text-2xl font-black text-slate-700">'+(data?data.length:0)+'</div></div>'
                );

                if (!data || !data.length) {
                    chartEl.html('<div class="w-full flex items-center justify-center text-slate-300 text-sm h-full"><i class="fas fa-chart-bar mr-2 text-2xl"></i>No data for this period</div>');
                    return;
                }

                var max = Math.max.apply(null, data.map(function(d){ return d.count; }));
                if (max === 0) max = 1;

                data.forEach(function(d) {
                    var heightPct = Math.max((d.count / max) * 100, 4);
                    var dateStr = new Date(d.date).toLocaleDateString('en', { month:'short', day:'numeric' });
                    var col = $('<div class="bar-col"></div>');
                    col.append('<div class="bar-tooltip">'+d.count+'</div>');
                    col.append('<div class="bar-rect" style="height:'+heightPct+'%;"></div>');
                    chartEl.append(col);
                    labelEl.append('<div class="bar-label">'+dateStr+'</div>');
                });
            });
        }

        function loadCategoryBreakdown() {
            $.get('@Url.Action("GetCategoryBreakdown", "ServiceDesk")', function(data) {
                var el = $('#categoryChart').empty();
                if (!data||!data.length) { el.html('<div class="text-center text-slate-400 text-sm py-4">No data available</div>'); return; }
                var total = data.reduce(function(s,d){ return s+d.count; }, 0);
                var palette = ['#00BCEB','#B4D334','#F97316','#9333EA','#EF4444','#0096BE','#8FB829'];
                data.forEach(function(d,i) {
                    var pct = total>0 ? ((d.count/total)*100).toFixed(1) : 0;
                    var color = palette[i%palette.length];
                    el.append(
                        '<div class="flex items-center gap-2.5">'+
                        '<div class="w-2 h-2 rounded-full flex-shrink-0" style="background:'+color+';"></div>'+
                        '<span class="w-24 text-xs text-slate-600 truncate">'+d.category+'</span>'+
                        '<div class="prog-bar-bg"><div class="prog-bar-fill" style="width:'+pct+'%;background:'+color+';"></div></div>'+
                        '<span class="text-xs font-bold text-slate-700 w-14 text-right flex-shrink-0">'+d.count+' <span class="text-slate-400 font-normal">('+pct+'%)</span></span>'+
                        '</div>'
                    );
                });
            });
        }

        function loadPriorityBreakdown() {
            $.get('@Url.Action("GetPriorityBreakdown", "ServiceDesk")', function(data) {
                var el = $('#priorityChart').empty();
                if (!data||!data.length) { el.html('<div class="text-center text-slate-400 text-sm py-4">No data available</div>'); return; }
                var total = data.reduce(function(s,d){ return s+d.count; }, 0);
                var colorMap = {'Critical':'#EF4444','Urgent':'#F87171','High':'#F97316','Medium':'#F59E0B','Low':'#B4D334','Normal':'#00BCEB'};
                data.forEach(function(d) {
                    var pct = total>0 ? ((d.count/total)*100).toFixed(1) : 0;
                    var color = colorMap[d.priority]||'#94A3B8';
                    el.append(
                        '<div class="flex items-center gap-2.5">'+
                        '<div class="w-2 h-2 rounded-full flex-shrink-0" style="background:'+color+';"></div>'+
                        '<span class="w-24 text-xs text-slate-600 truncate">'+d.priority+'</span>'+
                        '<div class="prog-bar-bg"><div class="prog-bar-fill" style="width:'+pct+'%;background:'+color+';"></div></div>'+
                        '<span class="text-xs font-bold text-slate-700 w-14 text-right flex-shrink-0">'+d.count+' <span class="text-slate-400 font-normal">('+pct+'%)</span></span>'+
                        '</div>'
                    );
                });
            });
        }

        function loadEngineerPerf() {
            $.get('@Url.Action("GetEngineerPerformance", "ServiceDesk")', function(data) {
                var el = $('#engineerTable').empty();
                if (!data||!data.length) { el.html('<div class="text-center text-slate-400 text-sm py-4">No data available</div>'); return; }
                var html = '<div class="overflow-x-auto"><table class="w-full text-sm min-w-[320px]">'+
                    '<thead><tr class="text-[10px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100">'+
                    '<th class="pb-2 text-left">Engineer</th>'+
                    '<th class="pb-2 text-center">Total</th>'+
                    '<th class="pb-2 text-center">Resolved</th>'+
                    '<th class="pb-2 text-center">Open</th>'+
                    '<th class="pb-2 text-center">Breached</th>'+
                    '</tr></thead><tbody>';
                data.forEach(function(e) {
                    var rate = e.total>0 ? ((e.resolved/e.total)*100).toFixed(0) : 0;
                    var initials = e.engineer ? e.engineer.charAt(0).toUpperCase() : '?';
                    html += '<tr class="border-b border-slate-50 hover:bg-slate-50 transition-colors">'+
                        '<td class="py-2"><div class="flex items-center gap-2"><div class="w-6 h-6 rounded-full flex items-center justify-center text-white text-[10px] font-bold flex-shrink-0" style="background:linear-gradient(135deg,#00BCEB,#0096BE);">'+initials+'</div><span class="font-semibold text-slate-800">'+e.engineer+'</span></div></td>'+
                        '<td class="py-2 text-center font-medium text-slate-700">'+e.total+'</td>'+
                        '<td class="py-2 text-center font-bold" style="color:#8FB829;">'+e.resolved+' <span class="text-slate-400 font-normal text-xs">('+rate+'%)</span></td>'+
                        '<td class="py-2 text-center font-medium" style="color:#0096BE;">'+e.open+'</td>'+
                        '<td class="py-2 text-center font-bold '+(e.breached>0?'text-red-500':'text-slate-300')+'">'+e.breached+'</td>'+
                        '</tr>';
                });
                html += '</tbody></table></div>';
                el.html(html);
            });
        }
    </script>
}
