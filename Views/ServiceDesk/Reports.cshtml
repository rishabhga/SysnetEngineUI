@{
    ViewData["Title"] = "Reports & Analytics";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentUser = Context.Session.GetString("username") ?? "Admin";
}

<style>
    .rpt-card {
        background: #fff;
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        box-shadow: 0 1px 3px rgba(0,0,0,.05),0 4px 16px rgba(0,0,0,.05);
        overflow: hidden;
    }

    .rpt-card-header {
        padding: 12px 16px 10px;
        border-bottom: 1px solid #F1F5F9;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .rpt-icon {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        flex-shrink: 0;
    }

    .bar-wrap {
        display: flex;
        align-items: flex-end;
        gap: 3px;
        height: 160px;
        padding: 0 4px;
    }

    .bar-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        height: 100%;
        justify-content: flex-end;
    }

    .bar-tooltip {
        font-size: 9px;
        font-weight: 700;
        color: #0F172A;
        opacity: 0;
        transition: opacity .15s;
        white-space: nowrap;
    }

    .bar-col:hover .bar-tooltip {
        opacity: 1;
    }

    .bar-rect {
        width: 100%;
        border-radius: 4px 4px 0 0;
        background: linear-gradient(180deg,#00BCEB 0%,#0096BE 100%);
        transition: filter .15s;
        min-height: 4px;
    }

    .bar-col:hover .bar-rect {
        filter: brightness(1.12);
    }

    .bar-labels {
        display: flex;
        gap: 3px;
        padding: 0 4px;
        margin-top: 4px;
    }

    .bar-label {
        flex: 1;
        text-align: center;
        font-size: 9px;
        color: #94A3B8;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .stat-card {
        background: #fff;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 12px 14px;
        box-shadow: 0 1px 3px rgba(0,0,0,.04);
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            border-radius: 12px 12px 0 0;
        }

    .stat-cyan::before {
        background: linear-gradient(90deg,#00BCEB,#0096BE);
    }

    .stat-lime::before {
        background: linear-gradient(90deg,#B4D334,#8FB829);
    }

    .stat-orange::before {
        background: linear-gradient(90deg,#F97316,#EA580C);
    }

    .stat-slate::before {
        background: linear-gradient(90deg,#64748B,#475569);
    }

    .prog-bar-bg {
        background: #F1F5F9;
        border-radius: 99px;
        height: 8px;
        overflow: hidden;
        flex: 1;
    }

    .prog-bar-fill {
        height: 100%;
        border-radius: 99px;
        transition: width .6s cubic-bezier(.22,1,.36,1);
    }

    /* Print styles */
    @@media print {
        body * {
            visibility: hidden;
        }
        #ticketReportPrintArea, #ticketReportPrintArea * {
            visibility: visible;
        }
        #ticketReportPrintArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            margin: 0;
            padding: 15px;
            background: #fff !important;
            color: #000 !important;
        }
        .no-print {
            display: none !important;
        }
        @@page {
            size: A4 portrait;
            margin: 10mm;
        }
    }
</style>

<div class="min-h-screen px-3 pt-4 pb-12 sm:px-4 lg:px-6" style="background:#F0F4F8;">
    <div class="max-w-6xl mx-auto">

        <!-- Page Header -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl flex items-center justify-center text-white text-sm shadow-sm" style="background:linear-gradient(135deg,#00BCEB,#0096BE);">
                    <i class="fas fa-file-invoice"></i>
                </div>
                <div>
                    <h1 class="text-[15px] font-bold text-slate-900 leading-tight">Reports &amp; Analytics</h1>
                    <p class="text-[11px] text-slate-500">Ticket audit reports, lifecycle tracking &amp; performance metrics</p>
                </div>
            </div>

            <!-- Top View Mode Switcher -->
            <div class="flex items-center bg-white border border-slate-200 rounded-lg p-1 shadow-sm gap-1 no-print">
                <button type="button" onclick="switchReportTab('ticketReport')" id="tabBtn-ticketReport"
                        class="px-3 py-1.5 rounded-md text-xs font-bold transition-all text-white"
                        style="background:linear-gradient(135deg,#00BCEB,#0096BE);">
                    <i class="fas fa-file-pdf mr-1.5"></i> Ticket Audit Report (PDF)
                </button>
                <button type="button" onclick="switchReportTab('analytics')" id="tabBtn-analytics"
                        class="px-3 py-1.5 rounded-md text-xs font-semibold transition-all text-slate-600 hover:text-slate-900">
                    <i class="fas fa-chart-line mr-1.5"></i> Analytics &amp; Trends
                </button>
            </div>
        </div>

        <!-- ==================== SECTION 1: TICKET AUDIT & LIFECYCLE PDF REPORT ==================== -->
        <div id="section-ticketReport" class="space-y-4">
            
            <!-- Search & Filter Card -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 no-print">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                    <div class="min-w-0 flex-1">
                        <h2 class="text-sm font-bold text-slate-800 flex items-center gap-1.5">
                            <i class="fas fa-search text-cyan-600"></i> Generate Ticket Audit Report
                        </h2>
                        <p class="text-xs text-slate-500 mt-0.5">
                            Enter a Ticket Number or Reference ID to inspect its complete lifecycle, status transition logs, parts, comments, and export to PDF.
                        </p>
                    </div>
                    <div class="flex items-center gap-2 w-full sm:w-auto">
                        <div class="relative flex-1 sm:w-64">
                            <i class="fas fa-ticket-alt absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input type="text" id="reportTicketNoInput" placeholder="Enter Ticket Number or ID..."
                                   class="w-full h-9 pl-8 pr-3 text-xs border border-slate-200 rounded-lg outline-none font-semibold text-slate-800 uppercase focus:border-cyan-500"
                                   onkeydown="if(event.key==='Enter') searchTicketReport();" />
                        </div>
                        <button type="button" onclick="searchTicketReport()" id="btnSearchReport"
                                class="h-9 px-4 text-xs font-bold text-white rounded-lg shadow-sm flex items-center gap-1.5 transition-all hover:opacity-90 flex-shrink-0"
                                style="background:linear-gradient(135deg,#00BCEB,#0096BE);">
                            <i class="fas fa-search text-[10px]"></i> View Report
                        </button>
                    </div>
                </div>
            </div>

            <!-- Report Results Container -->
            <div id="ticketReportDisplay">
                <!-- Initial State Placeholder -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-12 text-center text-slate-400">
                    <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-3 text-slate-400 text-xl">
                        <i class="fas fa-file-invoice"></i>
                    </div>
                    <h3 class="text-sm font-bold text-slate-700">No Ticket Selected</h3>
                    <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">
                        Enter a ticket number above and click <strong>View Report</strong> to generate the comprehensive audit trail and download the official PDF report.
                    </p>
                </div>
            </div>

        </div>

        <!-- ==================== SECTION 2: ANALYTICS & TRENDS ==================== -->
        <div id="section-analytics" class="hidden space-y-4">
            
            <div class="flex justify-end mb-1">
                <select id="dayRange" onchange="loadAllAnalytics()"
                        class="h-9 text-sm border border-slate-200 rounded-lg px-3 bg-white outline-none shadow-sm font-medium text-slate-700"
                        onfocus="this.style.borderColor='#00BCEB'" onblur="this.style.borderColor='';">
                    <option value="7">Last 7 Days</option>
                    <option value="30" selected>Last 30 Days</option>
                    <option value="90">Last 90 Days</option>
                </select>
            </div>

            <!-- Summary Cards -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3" id="summaryCards"></div>

            <!-- Row 1 -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="rpt-card">
                    <div class="rpt-card-header">
                        <div class="rpt-icon" style="background:#E0F7FD; color:#0096BE;"><i class="fas fa-chart-line"></i></div>
                        <div>
                            <div class="text-[13px] font-bold text-slate-800">Ticket Volume Trend</div>
                            <div class="text-[10px] text-slate-400">Daily ticket count over selected period</div>
                        </div>
                    </div>
                    <div class="p-4">
                        <div class="bar-wrap" id="trendChart">
                            <div class="w-full flex items-center justify-center text-slate-300 text-sm"><i class="fas fa-spinner fa-spin mr-2"></i>Loading...</div>
                        </div>
                        <div class="bar-labels" id="trendLabels"></div>
                    </div>
                </div>
                <div class="rpt-card">
                    <div class="rpt-card-header">
                        <div class="rpt-icon" style="background:#F3E8FF; color:#9333EA;"><i class="fas fa-tags"></i></div>
                        <div>
                            <div class="text-[13px] font-bold text-slate-800">Tickets by Category</div>
                            <div class="text-[10px] text-slate-400">Distribution across categories</div>
                        </div>
                    </div>
                    <div class="p-4 space-y-2.5" id="categoryChart">
                        <div class="text-center text-slate-300 text-sm py-8"><i class="fas fa-spinner fa-spin"></i></div>
                    </div>
                </div>
            </div>

            <!-- Row 2 -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="rpt-card">
                    <div class="rpt-card-header">
                        <div class="rpt-icon" style="background:#FFF7ED; color:#F97316;"><i class="fas fa-exclamation-triangle"></i></div>
                        <div>
                            <div class="text-[13px] font-bold text-slate-800">Tickets by Priority</div>
                            <div class="text-[10px] text-slate-400">Priority level breakdown</div>
                        </div>
                    </div>
                    <div class="p-4 space-y-2.5" id="priorityChart">
                        <div class="text-center text-slate-300 text-sm py-8"><i class="fas fa-spinner fa-spin"></i></div>
                    </div>
                </div>
                <div class="rpt-card">
                    <div class="rpt-card-header">
                        <div class="rpt-icon" style="background:#F1F8E9; color:#8FB829;"><i class="fas fa-user-cog"></i></div>
                        <div>
                            <div class="text-[13px] font-bold text-slate-800">Engineer Performance</div>
                            <div class="text-[10px] text-slate-400">Resolution rates per engineer</div>
                        </div>
                    </div>
                    <div class="p-4" id="engineerTable">
                        <div class="text-center text-slate-300 text-sm py-8"><i class="fas fa-spinner fa-spin"></i></div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            // Check if ticketNo query parameter is provided in URL
            var urlParams = new URLSearchParams(window.location.search);
            var queryTicketNo = urlParams.get('ticketNo');
            if (queryTicketNo) {
                $('#reportTicketNoInput').val(queryTicketNo.trim());
                switchReportTab('ticketReport');
                searchTicketReport();
            } else {
                // Default view is ticket audit report tab
                switchReportTab('ticketReport');
            }
        });

        function switchReportTab(tab) {
            if (tab === 'ticketReport') {
                $('#section-ticketReport').removeClass('hidden');
                $('#section-analytics').addClass('hidden');

                $('#tabBtn-ticketReport')
                    .removeClass('text-slate-600 hover:text-slate-900')
                    .addClass('text-white')
                    .attr('style', 'background:linear-gradient(135deg,#00BCEB,#0096BE);');

                $('#tabBtn-analytics')
                    .removeClass('text-white')
                    .addClass('text-slate-600 hover:text-slate-900')
                    .removeAttr('style');
            } else {
                $('#section-ticketReport').addClass('hidden');
                $('#section-analytics').removeClass('hidden');

                $('#tabBtn-analytics')
                    .removeClass('text-slate-600 hover:text-slate-900')
                    .addClass('text-white')
                    .attr('style', 'background:linear-gradient(135deg,#00BCEB,#0096BE);');

                $('#tabBtn-ticketReport')
                    .removeClass('text-white')
                    .addClass('text-slate-600 hover:text-slate-900')
                    .removeAttr('style');

                loadAllAnalytics();
            }
        }

        function searchTicketReport() {
            var ticketNo = $('#reportTicketNoInput').val().trim();
            if (!ticketNo) {
                alert('Please enter a Ticket Number or Reference ID.');
                $('#reportTicketNoInput').focus();
                return;
            }

            var displayEl = $('#ticketReportDisplay');
            displayEl.html(
                '<div class="bg-white rounded-xl border border-slate-200 shadow-sm p-12 text-center text-slate-500">' +
                '  <i class="fas fa-circle-notch fa-spin text-2xl text-cyan-600 mb-3"></i>' +
                '  <h4 class="text-sm font-bold text-slate-800">Generating Audit Report...</h4>' +
                '  <p class="text-xs text-slate-400 mt-1">Fetching lifecycle logs, status history and metrics for <strong class="text-slate-700">' + ticketNo + '</strong></p>' +
                '</div>'
            );

            $('#btnSearchReport').prop('disabled', true).addClass('opacity-60');

            $.get('@Url.Action("GetTicketReportData", "ServiceDesk")', { ticketNo: ticketNo }, function(res) {
                $('#btnSearchReport').prop('disabled', false).removeClass('opacity-60');
                if (res && res.success && res.data) {
                    renderTicketAuditReport(res.data);
                } else {
                    var errorMsg = (res && res.message) ? res.message : 'Ticket not found or could not be loaded.';
                    displayEl.html(
                        '<div class="bg-white rounded-xl border border-red-200 shadow-sm p-8 text-center">' +
                        '  <div class="w-12 h-12 rounded-full bg-red-50 text-red-500 flex items-center justify-center mx-auto mb-3 text-lg"><i class="fas fa-exclamation-triangle"></i></div>' +
                        '  <h3 class="text-sm font-bold text-slate-800">Ticket Not Found</h3>' +
                        '  <p class="text-xs text-slate-500 mt-1 max-w-md mx-auto">' + errorMsg + '</p>' +
                        '  <button onclick="$(\'#reportTicketNoInput\').focus();" class="mt-4 px-4 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors">Try Another Ticket</button>' +
                        '</div>'
                    );
                }
            }).fail(function() {
                $('#btnSearchReport').prop('disabled', false).removeClass('opacity-60');
                displayEl.html(
                    '<div class="bg-white rounded-xl border border-red-200 shadow-sm p-8 text-center">' +
                    '  <div class="w-12 h-12 rounded-full bg-red-50 text-red-500 flex items-center justify-center mx-auto mb-3 text-lg"><i class="fas fa-times-circle"></i></div>' +
                    '  <h3 class="text-sm font-bold text-slate-800">Error Fetching Report</h3>' +
                    '  <p class="text-xs text-slate-500 mt-1">An unexpected error occurred while communicating with the server.</p>' +
                    '</div>'
                );
            });
        }

        function renderTicketAuditReport(d) {
            var t = d.ticket || {};
            var logs = d.logs || [];
            var comments = d.comments || [];
            var parts = d.parts || [];
            var attachments = d.attachments || [];
            var m = d.metrics || {};

            var isBreached = m.isBreached;
            var slaBadgeClass = isBreached ? 'bg-red-50 text-red-700 border-red-200' : 'bg-emerald-50 text-emerald-700 border-emerald-200';
            var slaIcon = isBreached ? 'fa-exclamation-circle text-red-500' : 'fa-check-circle text-emerald-500';

            var priorityColors = {
                'Critical': 'bg-rose-100 text-rose-800 border-rose-300',
                'Urgent': 'bg-red-100 text-red-800 border-red-300',
                'High': 'bg-orange-100 text-orange-800 border-orange-300',
                'Medium': 'bg-amber-100 text-amber-800 border-amber-300',
                'Low': 'bg-lime-100 text-lime-800 border-lime-300'
            };
            var priorityBadge = priorityColors[t.priority] || 'bg-slate-100 text-slate-700 border-slate-300';

            var statusBadge = 'bg-cyan-100 text-cyan-800 border-cyan-300';
            if ((t.status || '').toUpperCase() === 'CLOSED' || (t.status || '').toUpperCase() === 'RESOLVED') {
                statusBadge = 'bg-emerald-100 text-emerald-800 border-emerald-300';
            } else if ((t.status || '').toUpperCase() === 'REJECTED') {
                statusBadge = 'bg-red-100 text-red-800 border-red-300';
            }

            var createdStr = t.createdOn ? new Date(t.createdOn).toLocaleString() : '-';
            var dueStr = t.dueDate ? new Date(t.dueDate).toLocaleString() : '-';
            var resolvedStr = t.resolvedDate ? new Date(t.resolvedDate).toLocaleString() : 'Not Yet Resolved';

            var safeTicketNo = (t.ticketNo || 'TKT-' + t.id).replace(/"/g, '&quot;');

            var html = '';

            // Actions Bar (PDF Download / Print buttons - hidden during print)
            html += '<div class="flex items-center justify-between bg-white border border-slate-200 rounded-xl px-4 py-2.5 shadow-sm no-print mb-4">';
            html += '  <div class="flex items-center gap-2">';
            html += '    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>';
            html += '    <span class="text-xs font-bold text-slate-700">Official Report Ready: <span class="text-cyan-700 font-extrabold">' + safeTicketNo + '</span></span>';
            html += '  </div>';
            html += '  <div class="flex items-center gap-2">';
            html += '    <button type="button" onclick="downloadReportPdf(\'' + safeTicketNo + '\')" class="h-8 px-3.5 text-xs font-bold text-white rounded-lg shadow-sm flex items-center gap-1.5 transition-all hover:opacity-90" style="background:linear-gradient(135deg,#EF4444,#DC2626);">';
            html += '      <i class="fas fa-file-pdf"></i> Download PDF';
            html += '    </button>';
            html += '    <button type="button" onclick="printReportDocument()" class="h-8 px-3.5 text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg shadow-sm flex items-center gap-1.5 transition-all">';
            html += '      <i class="fas fa-print"></i> Print to PDF';
            html += '    </button>';
            html += '  </div>';
            html += '</div>';

            // Printable & Exportable Report Container
            html += '<div id="ticketReportPrintArea" class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 sm:p-8 space-y-6 text-slate-800">';

            // 1. Official Header
            html += '  <div class="border-b-2 border-cyan-600 pb-4">';
            html += '    <div class="flex items-start justify-between gap-4">';
            html += '      <div>';
            html += '        <div class="flex items-center gap-2">';
            html += '          <div class="w-7 h-7 rounded-lg flex items-center justify-center text-white text-xs font-black" style="background:linear-gradient(135deg,#00BCEB,#0096BE);">T</div>';
            html += '          <span class="text-base font-black tracking-tight text-slate-900">TRINETRA SERVICE DESK</span>';
            html += '        </div>';
            html += '        <h1 class="text-lg font-black text-slate-900 mt-1 uppercase tracking-wide">Incident &amp; Ticket Audit Report</h1>';
            html += '        <p class="text-[11px] text-slate-500">Official Lifecycle, Status Progression &amp; SLA Compliance Audit Document</p>';
            html += '      </div>';
            html += '      <div class="text-right text-xs">';
            html += '        <div class="font-extrabold text-sm text-cyan-700 tracking-tight">' + safeTicketNo + '</div>';
            html += '        <div class="text-slate-500 text-[10px] mt-0.5">Generated: <span class="font-semibold text-slate-700">' + new Date().toLocaleString() + '</span></div>';
            html += '        <div class="text-slate-500 text-[10px]">Audited By: <span class="font-semibold text-slate-700">@currentUser</span></div>';
            html += '      </div>';
            html += '    </div>';
            html += '  </div>';

            // 2. Executive Metrics & Summary Grid
            html += '  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 bg-slate-50 rounded-xl p-3.5 border border-slate-200 text-xs">';
            html += '    <div><span class="text-[10px] font-bold uppercase text-slate-400 block">Current Status</span><span class="font-bold inline-block px-2 py-0.5 rounded border mt-0.5 text-xs ' + statusBadge + '">' + (t.status || 'OPEN') + '</span></div>';
            html += '    <div><span class="text-[10px] font-bold uppercase text-slate-400 block">Priority</span><span class="font-bold inline-block px-2 py-0.5 rounded border mt-0.5 text-xs ' + priorityBadge + '">' + (t.priority || 'Medium') + '</span></div>';
            html += '    <div><span class="text-[10px] font-bold uppercase text-slate-400 block">SLA Compliance</span><span class="font-bold inline-flex items-center gap-1 px-2 py-0.5 rounded border mt-0.5 text-xs ' + slaBadgeClass + '"><i class="fas ' + slaIcon + '"></i> ' + m.slaCompliance + '</span></div>';
            html += '    <div><span class="text-[10px] font-bold uppercase text-slate-400 block">Resolution Duration</span><span class="font-black text-slate-800 text-xs block mt-1">' + m.resolutionDuration + '</span></div>';
            html += '  </div>';

            // 3. Ticket Specification Table
            html += '  <div>';
            html += '    <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider mb-2 flex items-center gap-1.5"><i class="fas fa-info-circle text-cyan-600"></i> Ticket Parameters &amp; Assignment</h3>';
            html += '    <div class="border border-slate-200 rounded-lg overflow-hidden">';
            html += '      <table class="w-full text-xs text-left">';
            html += '        <tbody class="divide-y divide-slate-100">';
            html += '          <tr class="bg-white"><td class="py-2 px-3 font-semibold text-slate-500 w-1/4 bg-slate-50">Subject</td><td class="py-2 px-3 font-bold text-slate-900" colspan="3">' + (t.subject || 'No Subject') + '</td></tr>';
            html += '          <tr class="bg-white"><td class="py-2 px-3 font-semibold text-slate-500 bg-slate-50">Requester</td><td class="py-2 px-3 font-medium text-slate-800">' + (t.requesterName || '-') + (t.requesterEmail ? ' (' + t.requesterEmail + ')' : '') + '</td><td class="py-2 px-3 font-semibold text-slate-500 bg-slate-50 w-1/4">Assigned Engineer</td><td class="py-2 px-3 font-bold text-cyan-700">' + (t.assignedToName || 'Unassigned') + '</td></tr>';
            html += '          <tr class="bg-white"><td class="py-2 px-3 font-semibold text-slate-500 bg-slate-50">Company / Client</td><td class="py-2 px-3 font-medium text-slate-800">' + (t.companyName || '-') + '</td><td class="py-2 px-3 font-semibold text-slate-500 bg-slate-50">Location / Site</td><td class="py-2 px-3 font-medium text-slate-800">' + (t.locationName || '-') + '</td></tr>';
