@{
    ViewData["Title"] = "Reports & Analytics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-gray-50 p-4">
    <div class="max-w-6xl mx-auto">
        <div class="flex justify-between items-center mb-4">
            <div>
                <h1 class="text-xl font-bold text-gray-900">Reports & Analytics</h1>
                <p class="text-gray-500 text-sm">Ticket trends, engineer performance, and SLA compliance</p>
            </div>
            <select id="dayRange" onchange="loadAll()" class="h-9 text-sm border border-gray-300 rounded px-2 bg-white outline-none">
                <option value="7">Last 7 Days</option>
                <option value="30" selected>Last 30 Days</option>
                <option value="90">Last 90 Days</option>
            </select>
        </div>

        <!-- Summary Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4" id="summaryCards">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <!-- Ticket Trend -->
            <div class="bg-white rounded border border-gray-200 p-4">
                <h3 class="text-sm font-medium text-gray-800 mb-3"><i class="fas fa-chart-line text-blue-500 mr-1"></i>Ticket Volume Trend</h3>
                <div id="trendChart" class="h-48 flex items-end gap-1"></div>
                <div id="trendLabels" class="flex gap-1 text-[10px] text-gray-400 mt-1"></div>
            </div>

            <!-- Category Breakdown -->
            <div class="bg-white rounded border border-gray-200 p-4">
                <h3 class="text-sm font-medium text-gray-800 mb-3"><i class="fas fa-chart-pie text-purple-500 mr-1"></i>Tickets by Category</h3>
                <div id="categoryChart"></div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <!-- Priority Breakdown -->
            <div class="bg-white rounded border border-gray-200 p-4">
                <h3 class="text-sm font-medium text-gray-800 mb-3"><i class="fas fa-exclamation-triangle text-amber-500 mr-1"></i>Tickets by Priority</h3>
                <div id="priorityChart"></div>
            </div>

            <!-- Engineer Performance -->
            <div class="bg-white rounded border border-gray-200 p-4">
                <h3 class="text-sm font-medium text-gray-800 mb-3"><i class="fas fa-user-cog text-emerald-500 mr-1"></i>Engineer Performance</h3>
                <div id="engineerTable"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
$(document).ready(function() { loadAll(); });

function loadAll() {
    var days = $('#dayRange').val();
    loadTrend(days);
    loadCategoryBreakdown();
    loadPriorityBreakdown();
    loadEngineerPerf();
}

function loadTrend(days) {
    $.get('@Url.Action("GetTicketTrends","ServiceDesk")', { days: days }, function(data) {
        var chart = $('#trendChart').empty();
        var labels = $('#trendLabels').empty();
        var cards = $('#summaryCards').empty();

        if(!data||!data.length) {
            chart.html('<div class="w-full text-center text-gray-400 text-sm py-8">No ticket data available</div>');
            cards.html(`
                <div class="bg-white rounded border border-gray-200 p-3 text-center"><div class="text-2xl font-bold text-gray-800">0</div><div class="text-xs text-gray-500">Total Tickets</div></div>
                <div class="bg-white rounded border border-gray-200 p-3 text-center"><div class="text-2xl font-bold text-blue-600">0</div><div class="text-xs text-gray-500">Daily Average</div></div>
                <div class="bg-white rounded border border-gray-200 p-3 text-center"><div class="text-2xl font-bold text-emerald-600">0</div><div class="text-xs text-gray-500">Peak Day</div></div>
                <div class="bg-white rounded border border-gray-200 p-3 text-center"><div class="text-2xl font-bold text-amber-600">0</div><div class="text-xs text-gray-500">Days with Tickets</div></div>
            `);
            return;
        }

        var max = Math.max(...data.map(d => d.count));
        var total = data.reduce((s,d) => s + d.count, 0);
        var peak = Math.max(...data.map(d => d.count));
        var avg = (total / Math.max(parseInt(days),1)).toFixed(1);

        cards.html(`
            <div class="bg-white rounded border border-gray-200 p-3 text-center"><div class="text-2xl font-bold text-gray-800">${total}</div><div class="text-xs text-gray-500">Total Tickets</div></div>
            <div class="bg-white rounded border border-gray-200 p-3 text-center"><div class="text-2xl font-bold text-blue-600">${avg}</div><div class="text-xs text-gray-500">Daily Average</div></div>
            <div class="bg-white rounded border border-gray-200 p-3 text-center"><div class="text-2xl font-bold text-emerald-600">${peak}</div><div class="text-xs text-gray-500">Peak Day</div></div>
            <div class="bg-white rounded border border-gray-200 p-3 text-center"><div class="text-2xl font-bold text-amber-600">${data.length}</div><div class="text-xs text-gray-500">Days with Tickets</div></div>
        `);

        data.forEach(d => {
            var h = max > 0 ? Math.max((d.count / max) * 100, 4) : 4;
            var dateStr = new Date(d.date).toLocaleDateString('en',{month:'short',day:'numeric'});
            chart.append(`<div class="flex-1 bg-blue-500 rounded-t hover:bg-blue-600 transition-colors relative group" style="height:${h}%">
                <div class="absolute -top-5 left-1/2 -translate-x-1/2 text-[10px] font-bold text-gray-700 hidden group-hover:block">${d.count}</div>
            </div>`);
            labels.append(`<div class="flex-1 text-center truncate">${dateStr}</div>`);
        });
    });
}

function loadCategoryBreakdown() {
    $.get('@Url.Action("GetCategoryBreakdown","ServiceDesk")', function(data) {
        var el = $('#categoryChart').empty();
        if(!data||!data.length) { el.html('<div class="text-center text-gray-400 text-sm py-4">No data</div>'); return; }
        var total = data.reduce((s,d) => s + d.count, 0);
        var colors = ['bg-blue-500','bg-purple-500','bg-emerald-500','bg-amber-500','bg-rose-500','bg-cyan-500','bg-indigo-500'];
        data.forEach((d,i) => {
            var pct = ((d.count/total)*100).toFixed(1);
            el.append(`<div class="flex items-center gap-2 mb-2">
                <span class="w-20 text-xs text-gray-600 truncate">${d.category}</span>
                <div class="flex-1 bg-gray-100 rounded-full h-4 overflow-hidden"><div class="${colors[i%colors.length]} h-full rounded-full" style="width:${pct}%"></div></div>
                <span class="text-xs font-medium text-gray-700 w-12 text-right">${d.count} (${pct}%)</span>
            </div>`);
        });
    });
}

function loadPriorityBreakdown() {
    $.get('@Url.Action("GetPriorityBreakdown","ServiceDesk")', function(data) {
        var el = $('#priorityChart').empty();
        if(!data||!data.length) { el.html('<div class="text-center text-gray-400 text-sm py-4">No data</div>'); return; }
        var total = data.reduce((s,d) => s + d.count, 0);
        var colors = {'Critical':'bg-red-500','Urgent':'bg-red-400','High':'bg-orange-500','Medium':'bg-amber-500','Low':'bg-emerald-500','Normal':'bg-blue-500'};
        data.forEach(d => {
            var pct = ((d.count/total)*100).toFixed(1);
            var c = colors[d.priority] || 'bg-gray-500';
            el.append(`<div class="flex items-center gap-2 mb-2">
                <span class="w-20 text-xs text-gray-600 truncate">${d.priority}</span>
                <div class="flex-1 bg-gray-100 rounded-full h-4 overflow-hidden"><div class="${c} h-full rounded-full" style="width:${pct}%"></div></div>
                <span class="text-xs font-medium text-gray-700 w-12 text-right">${d.count} (${pct}%)</span>
            </div>`);
        });
    });
}

function loadEngineerPerf() {
    $.get('@Url.Action("GetEngineerPerformance","ServiceDesk")', function(data) {
        var el = $('#engineerTable').empty();
        if(!data||!data.length) { el.html('<div class="text-center text-gray-400 text-sm py-4">No data</div>'); return; }
        el.append(`<table class="w-full text-sm"><thead><tr class="text-xs text-gray-500 border-b"><th class="py-1 text-left">Engineer</th><th class="py-1 text-center">Total</th><th class="py-1 text-center">Resolved</th><th class="py-1 text-center">Open</th><th class="py-1 text-center">Breached</th></tr></thead><tbody id="engBody"></tbody></table>`);
        data.forEach(e => {
            var rate = e.total > 0 ? ((e.resolved/e.total)*100).toFixed(0) : 0;
            $('#engBody').append(`<tr class="border-b border-gray-50 hover:bg-gray-50">
                <td class="py-1.5 font-medium text-gray-800">${e.engineer}</td>
                <td class="py-1.5 text-center">${e.total}</td>
                <td class="py-1.5 text-center text-emerald-600 font-medium">${e.resolved} <span class="text-gray-400 text-xs">(${rate}%)</span></td>
                <td class="py-1.5 text-center text-blue-600">${e.open}</td>
                <td class="py-1.5 text-center ${e.breached>0?'text-red-600 font-medium':'text-gray-400'}">${e.breached}</td>
            </tr>`);
        });
    });
}
</script>
}
