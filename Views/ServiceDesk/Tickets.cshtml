@{
    ViewData["Title"] = "All Service Tickets";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var canCreate = ViewBag.CanCreate ?? false;
    var canAssign = ViewBag.CanAssign ?? false;
    var canApprove = ViewBag.CanApprove ?? false;
    var canDelete = ViewBag.CanDelete ?? false;
}

<div class="min-h-screen bg-gray-50 p-4">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="mb-5">
            <div class="flex justify-between items-start mb-3">
                <div>
                    <h1 class="text-xl font-bold text-gray-900">Support Requests</h1>
                    <p class="text-gray-600 text-sm mt-0.5">Manage all service tickets</p>
                </div>
                <div class="flex items-center gap-2">
                    <a href="@Url.Action("Index", "ServiceDesk")"
                       class="px-3 py-1.5 bg-white border border-gray-300 text-gray-700 text-sm font-medium rounded hover:bg-gray-50">
                        <i class="fas fa-arrow-left mr-1.5 text-xs"></i>
                        Back
                    </a>
                    @if (canCreate)
                    {
                        <a href="@Url.Action("CreateTicket", "ServiceDesk")"
                           class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded flex items-center">
                            <i class="fas fa-plus mr-1.5 text-xs"></i>
                            New Ticket
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded border border-gray-200 p-3 mb-4">
            <div class="flex flex-wrap items-center gap-3">
                <div class="flex-1 min-w-[200px]">
                    <div class="relative">
                        <i class="fas fa-search absolute left-2.5 top-1/2 transform -translate-y-1/2 text-gray-400 text-sm"></i>
                        <input type="text" id="searchInput" placeholder="Search by ID or Subject..."
                               class="w-full h-8 pl-8 pr-3 text-sm border border-gray-300 rounded focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none">
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <select id="statusFilter" class="h-8 text-sm border border-gray-300 rounded px-2 bg-white text-gray-700 min-w-[120px]">
                        <option value="all">All Statuses</option>
                    </select>
                    <div class="text-sm text-gray-500">
                        <span id="ticketCount" class="font-medium text-gray-800">--</span> tickets
                    </div>
                </div>
            </div>
        </div>

        <!-- Tickets Table -->
        <div class="bg-white rounded border border-gray-200">
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="bg-gray-50 text-gray-500 text-xs border-b border-gray-200">
                            <th class="px-3 py-2.5 font-medium">TICKET ID</th>
                            <th class="px-3 py-2.5 font-medium">SUBJECT</th>
                            <th class="px-3 py-2.5 font-medium">REQUESTER</th>
                            <th class="px-3 py-2.5 font-medium">ASSIGNED TO</th>
                            <th class="px-3 py-2.5 font-medium">PRIORITY</th>
                            <th class="px-3 py-2.5 font-medium">STATUS</th>
                            <th class="px-3 py-2.5 font-medium">CREATED</th>
                            <th class="px-3 py-2.5 font-medium text-right">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody id="ticketsTableBody" class="text-sm">
                        <tr>
                            <td colspan="8" class="px-3 py-4 text-center text-gray-500">
                                <i class="fas fa-circle-notch fa-spin text-blue-500 mr-2"></i>
                                Loading tickets...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Approve Modal -->
<div id="approveModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded w-full max-w-xs">
        <div class="p-3 border-b border-gray-200 flex items-center">
            <i class="fas fa-check-circle text-green-500 mr-2 text-sm"></i>
            <h3 class="font-medium text-gray-800 text-sm">Approve Ticket</h3>
            <button onclick="closeModal('approveModal')" class="ml-auto text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-3">
            <input type="hidden" id="approveTicketId">
            <label class="block text-xs text-gray-700 mb-2">Remarks (Optional)</label>
            <textarea id="approveRemarks" class="w-full text-sm border border-gray-300 rounded p-2 mb-3" rows="2" placeholder="Any remarks..."></textarea>
            <div class="flex gap-2">
                <button onclick="closeModal('approveModal')" class="flex-1 py-1.5 text-sm text-gray-600 font-medium">Cancel</button>
                <button onclick="submitApprove()" class="flex-1 py-1.5 bg-green-600 text-white text-sm font-medium rounded">
                    <i class="fas fa-check mr-1 text-xs"></i> Approve
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded w-full max-w-xs">
        <div class="p-3 border-b border-red-100 bg-red-50 flex items-center">
            <i class="fas fa-times-circle text-red-500 mr-2 text-sm"></i>
            <h3 class="font-medium text-red-800 text-sm">Reject Ticket</h3>
            <button onclick="closeModal('rejectModal')" class="ml-auto text-gray-400 hover:text-red-400">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-3">
            <input type="hidden" id="rejectTicketId">
            <label class="block text-xs text-gray-700 mb-2">Reason for Rejection</label>
            <textarea id="rejectReason" class="w-full text-sm border border-gray-300 rounded p-2 mb-3" rows="3" placeholder="Please provide reason..." required></textarea>
            <div class="flex gap-2">
                <button onclick="closeModal('rejectModal')" class="flex-1 py-1.5 text-sm text-gray-600 font-medium">Cancel</button>
                <button onclick="submitReject()" class="flex-1 py-1.5 bg-red-600 text-white text-sm font-medium rounded">
                    <i class="fas fa-times mr-1 text-xs"></i> Reject
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Assign Modal -->
<div id="assignModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded w-full max-w-xs">
        <div class="p-3 border-b border-blue-100 bg-blue-50 flex items-center">
            <i class="fas fa-user-tag text-blue-500 mr-2 text-sm"></i>
            <h3 class="font-medium text-blue-800 text-sm">Assign Engineer</h3>
            <button onclick="closeModal('assignModal')" class="ml-auto text-gray-400 hover:text-blue-400">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-3">
            <input type="hidden" id="assignTicketId">
            <input type="hidden" id="assignTicketNo">
            <label class="block text-xs text-gray-700 mb-2">Select Engineer</label>
            <select id="engineerSelect" class="w-full text-sm border border-gray-300 rounded p-1.5 mb-3">
                <option value="">Loading engineers...</option>
            </select>
            <label class="block text-xs text-gray-700 mb-2">Notes (Optional)</label>
            <textarea id="assignNotes" class="w-full text-sm border border-gray-300 rounded p-2 mb-3" rows="2" placeholder="Any notes..."></textarea>
            <div class="flex gap-2">
                <button onclick="closeModal('assignModal')" class="flex-1 py-1.5 text-sm text-gray-600 font-medium">Cancel</button>
                <button onclick="submitAssign()" class="flex-1 py-1.5 bg-blue-600 text-white text-sm font-medium rounded">
                    <i class="fas fa-user-check mr-1 text-xs"></i> Assign
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Parts Modal -->
<div id="partsModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded w-full max-w-sm max-h-[80vh] overflow-hidden flex flex-col">
        <div class="p-3 border-b border-gray-200 flex items-center">
            <i class="fas fa-cogs text-purple-500 mr-2 text-sm"></i>
            <h3 class="font-medium text-gray-800 text-sm">Manage Parts - <span id="partsTicketNo"></span></h3>
            <button onclick="closeModal('partsModal')" class="ml-auto text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-3 overflow-y-auto flex-1">
            <input type="hidden" id="partsTicketId">

            <div id="partsContainer" class="mb-3">
                <div class="text-center py-3 text-gray-400 text-sm">
                    <i class="fas fa-spinner fa-spin mr-2"></i>Loading parts...
                </div>
            </div>

            <hr class="my-3 border-gray-200">

            <h4 class="font-medium text-gray-700 text-sm mb-2">Add New Part</h4>
            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="block text-xs text-gray-600 mb-1">Part Name</label>
                    <input type="text" id="partName" class="w-full text-sm border border-gray-300 rounded p-1.5">
                </div>
                <div>
                    <label class="block text-xs text-gray-600 mb-1">Part Number</label>
                    <input type="text" id="partNumber" class="w-full text-sm border border-gray-300 rounded p-1.5">
                </div>
                <div>
                    <label class="block text-xs text-gray-600 mb-1">Quantity</label>
                    <input type="number" id="partQty" class="w-full text-sm border border-gray-300 rounded p-1.5" value="1" min="1">
                </div>
                <div>
                    <label class="block text-xs text-gray-600 mb-1">Unit Cost</label>
                    <input type="number" id="partCost" class="w-full text-sm border border-gray-300 rounded p-1.5" value="0" step="0.01">
                </div>
            </div>
        </div>
        <div class="p-3 bg-gray-50 border-t border-gray-200 flex gap-2">
            <button onclick="closeModal('partsModal')" class="flex-1 py-1.5 text-sm text-gray-600 font-medium">Close</button>
            <button onclick="submitAddPart()" class="flex-1 py-1.5 bg-purple-600 text-white text-sm font-medium rounded">
                <i class="fas fa-plus mr-1 text-xs"></i> Add Part
            </button>
        </div>
    </div>
</div>

<!-- Status Modal -->
<div id="statusModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded w-full max-w-xs">
        <div class="p-3 border-b border-gray-200 flex items-center">
            <i class="fas fa-exchange-alt text-amber-500 mr-2 text-sm"></i>
            <h3 class="font-medium text-gray-800 text-sm">Update Status</h3>
            <button onclick="closeModal('statusModal')" class="ml-auto text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-3">
            <input type="hidden" id="statusTicketId">
            <div class="mb-3">
                <label class="block text-xs text-gray-700 mb-1">Current Status</label>
                <span id="currentStatusDisplay" class="inline-block px-2 py-0.5 bg-gray-100 text-gray-600 rounded text-xs"></span>
            </div>
            <div class="mb-3">
                <label class="block text-xs text-gray-700 mb-1">New Status</label>
                <select id="newStatusSelect" class="w-full text-sm border border-gray-300 rounded p-1.5">
                </select>
            </div>
            <div class="mb-3">
                <label class="block text-xs text-gray-700 mb-1">Remarks</label>
                <textarea id="statusRemarks" class="w-full text-sm border border-gray-300 rounded p-2" rows="2" placeholder="Reason for change..."></textarea>
            </div>
            <div class="flex gap-2">
                <button onclick="closeModal('statusModal')" class="flex-1 py-1.5 text-sm text-gray-600 font-medium">Cancel</button>
                <button onclick="submitStatusUpdate()" class="flex-1 py-1.5 bg-amber-500 text-white text-sm font-medium rounded">
                    <i class="fas fa-save mr-1 text-xs"></i> Update
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Resolve Modal -->
<div id="resolveModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded w-full max-w-sm">
        <div class="p-3 border-b border-gray-200 flex items-center">
            <i class="fas fa-check-circle text-emerald-500 mr-2 text-sm"></i>
            <h3 class="font-medium text-gray-800 text-sm">Resolve Ticket</h3>
            <button onclick="closeModal('resolveModal')" class="ml-auto text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-3">
            <div class="mb-3">
                <label class="block text-xs text-gray-700 mb-1">Resolution Notes</label>
                <textarea id="resolveNotes" class="w-full text-sm border border-gray-300 rounded p-2" rows="4" 
                    placeholder="Describe what was done to resolve this ticket..."></textarea>
            </div>
            <div class="flex gap-2">
                <button onclick="closeModal('resolveModal')" class="flex-1 py-1.5 text-sm text-gray-600 font-medium">Cancel</button>
                <button onclick="submitResolve()" class="flex-1 py-1.5 bg-emerald-500 text-white text-sm font-medium rounded">
                    <i class="fas fa-check mr-1 text-xs"></i> Mark Resolved
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div id="loadingOverlay" class="fixed inset-0 bg-black/50 z-[100] hidden flex items-center justify-center p-4">
    <div class="bg-white rounded p-4 text-center">
        <i class="fas fa-circle-notch fa-spin text-blue-500 text-lg mb-2"></i>
        <p class="text-gray-600 text-sm">Processing...</p>
    </div>
</div>

<!-- Toast -->
<div id="toast" class="fixed bottom-3 right-3 z-[110] hidden">
    <div id="toastContent" class="px-3 py-2 rounded shadow flex items-center gap-2 text-sm">
        <i id="toastIcon" class="text-sm"></i>
        <span id="toastMessage" class="font-medium"></span>
    </div>
</div>

@section Scripts {
    <script>
        // ==================== GLOBAL STATE ====================
        let allTickets = [];
        const username = '@Context.Session.GetString("username")' || 'Admin';
        const userId = '@Context.Session.GetString("userId")' || '1';
        
        // Permission flags from server
        const canAssign = @(canAssign ? "true" : "false");
        const canApprove = @(canApprove ? "true" : "false");
        const canDelete = @(canDelete ? "true" : "false");

        // ==================== INITIALIZATION ====================
        $(document).ready(function () {
            loadTickets();
            loadEngineers();
            loadStatuses();

            $('#searchInput').on('keyup', filterTickets);
            $('#statusFilter').on('change', filterTickets);
        });

        // ==================== MODAL HELPERS ====================
        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        function showLoading() {
            document.getElementById('loadingOverlay').classList.remove('hidden');
        }

        function hideLoading() {
            document.getElementById('loadingOverlay').classList.add('hidden');
        }

        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            const content = document.getElementById('toastContent');
            const icon = document.getElementById('toastIcon');
            const msg = document.getElementById('toastMessage');

            content.className = 'px-3 py-2 rounded shadow flex items-center gap-2 text-sm ';
            if (type === 'success') {
                content.className += 'bg-green-500 text-white';
                icon.className = 'fas fa-check-circle text-sm';
            } else if (type === 'error') {
                content.className += 'bg-red-500 text-white';
                icon.className = 'fas fa-exclamation-circle text-sm';
            } else {
                content.className += 'bg-blue-500 text-white';
                icon.className = 'fas fa-info-circle text-sm';
            }

            msg.textContent = message;
            toast.classList.remove('hidden');

            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3000);
        }

        // ==================== LOAD DATA ====================
        function loadTickets() {
            $.ajax({
                url: '@Url.Action("GetTickets", "ServiceDesk")',
                type: 'GET',
                success: function (data) {
                    allTickets = data || [];
                    renderTickets(allTickets);
                },
                error: function (xhr, status, error) {
                    console.error('Failed to load tickets:', error);
                    $('#ticketsTableBody').html('<tr><td colspan="8" class="px-3 py-4 text-center text-red-500 text-sm"><i class="fas fa-exclamation-triangle mr-2"></i>Failed to load tickets</td></tr>');
                }
            });
        }

        function loadEngineers() {
            $.ajax({
                url: '@Url.Action("GetEngineers", "ServiceDesk")',
                type: 'GET',
                success: function (data) {
                    const select = $('#engineerSelect');
                    select.empty();
                    select.append('<option value="">-- Select Engineer --</option>');
                    if (data && data.length > 0) {
                        data.forEach(e => {
                            select.append(`<option value="${e.id}" data-name="${e.name}">${e.name}</option>`);
                        });
                    }
                }
            });
        }

        function loadStatuses() {
            $.ajax({
                url: '@Url.Action("GetStatuses", "ServiceDesk")',
                type: 'GET',
                success: function (data) {
                    const filterSelect = $('#statusFilter');
                    const modalSelect = $('#newStatusSelect');

                    if (data && data.length > 0) {
                        data.forEach(s => {
                            filterSelect.append(`<option value="${s.value}">${s.label}</option>`);
                            modalSelect.append(`<option value="${s.value}">${s.label}</option>`);
                        });
                    }
                }
            });
        }

        // ==================== RENDER TICKETS ====================
        function renderTickets(tickets) {
            const tbody = $('#ticketsTableBody');
            tbody.empty();
            $('#ticketCount').text(tickets.length);

            if (tickets.length === 0) {
                tbody.html('<tr><td colspan="8" class="px-3 py-4 text-center text-gray-500 text-sm">No tickets found</td></tr>');
                return;
            }

            tickets.forEach(t => {
                const isOverdue = t.isSLABreached;
                const createdDate = new Date(t.createdOn);
                const status = t.status || 'Open';

                const row = `
                    <tr class="border-b border-gray-50 hover:bg-gray-50 ${isOverdue ? 'bg-red-50/30' : ''}">
                        <td class="px-3 py-2 font-medium text-gray-700 text-sm">
                            <a href="/ServiceDesk/Details/${t.id}" class="hover:text-blue-600">
                                #${t.ticketNo || t.id}
                            </a>
                        </td>
                        <td class="px-3 py-2">
                            <a href="/ServiceDesk/Details/${t.id}" class="text-gray-800 hover:text-blue-600 font-medium text-sm block">
                                ${escapeHtml(t.subject || 'No Subject')}
                            </a>
                            <div class="text-xs text-gray-400 mt-0.5 truncate max-w-[200px]">${escapeHtml(t.category || 'General')}</div>
                        </td>
                        <td class="px-3 py-2">
                            <div class="flex items-center">
                                <div class="w-6 h-6 rounded-full bg-blue-100 text-blue-600 text-xs flex items-center justify-center font-bold mr-1.5">
                                    ${(t.requesterName || 'U').charAt(0).toUpperCase()}
                                </div>
                                <span class="text-gray-700 text-sm truncate max-w-[120px]" title="${t.requesterName || 'Unknown'}">${t.requesterName || 'Unknown'}</span>
                            </div>
                        </td>
                        <td class="px-3 py-2 text-gray-600 text-sm">
                            ${t.assignedToName ?
                                `<span class="flex items-center text-xs bg-gray-100 px-1.5 py-0.5 rounded border border-gray-200">
                                    <i class="fas fa-user-tag mr-1 text-gray-400 text-[10px]"></i>
                                    ${escapeHtml(t.assignedToName)}
                                </span>`
                                : '<span class="text-gray-400 text-xs italic">Unassigned</span>'}
                        </td>
                        <td class="px-3 py-2">
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${getPriorityClass(t.priority)}">
                                ${t.priority || 'Medium'}
                            </span>
                        </td>
                        <td class="px-3 py-2">
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${getStatusClass(status)}">
                                <span class="w-1.5 h-1.5 rounded-full mr-1 bg-current"></span>
                                ${status}
                            </span>
                        </td>
                        <td class="px-3 py-2 text-gray-500 text-xs">
                            <div>${createdDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</div>
                            <div class="text-gray-400">${createdDate.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</div>
                        </td>
                        <td class="px-3 py-2 text-right">
                            <div class="flex justify-end gap-1">
                                ${getActionButtons(t)}
                            </div>
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function getActionButtons(ticket) {
            const status = ticket.status || 'Open';
            const id = ticket.id;
            const ticketNo = ticket.ticketNo || ticket.id;
            let buttons = `
                <a href="/ServiceDesk/Details/${id}" class="p-1.5 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded" title="View Details">
                    <i class="fas fa-eye text-xs"></i>
                </a>
            `;

            // Approve/Reject buttons - require approval permission
            if (status === 'Open' && canApprove) {
                buttons += `
                    <button onclick="openApproveModal(${id})" class="p-1.5 text-green-600 hover:bg-green-50 rounded" title="Approve">
                        <i class="fas fa-check text-xs"></i>
                    </button>
                    <button onclick="openRejectModal(${id})" class="p-1.5 text-red-600 hover:bg-red-50 rounded" title="Reject">
                        <i class="fas fa-times text-xs"></i>
                    </button>
                `;
            }

            // Assign button - require assign permission
            if ((status === 'Open' || status === 'Approved') && canAssign) {
                buttons += `
                    <button onclick="openAssignModal(${id}, '${escapeHtml(ticketNo)}')" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded" title="Assign to Engineer">
                        <i class="fas fa-user-tag text-xs"></i>
                    </button>
                `;
            }

            // Start Work button for Assigned tickets
            if (status === 'Assigned') {
                buttons += `
                    <button onclick="startWork(${id})" class="p-1.5 text-indigo-600 hover:bg-indigo-50 rounded" title="Start Work">
                        <i class="fas fa-play text-xs"></i>
                    </button>
                `;
            }

            // Status update for active tickets
            if (status === 'Assigned' || status === 'InProgress' || status === 'Approved') {
                buttons += `
                    <button onclick="openStatusModal(${id}, '${status}')" class="p-1.5 text-amber-600 hover:bg-amber-50 rounded" title="Update Status">
                        <i class="fas fa-exchange-alt text-xs"></i>
                    </button>
                `;
            }

            // Resolve button for InProgress tickets
            if (status === 'InProgress') {
                buttons += `
                    <button onclick="openResolveModal(${id})" class="p-1.5 text-emerald-600 hover:bg-emerald-50 rounded" title="Resolve Ticket">
                        <i class="fas fa-check-circle text-xs"></i>
                    </button>
                `;
            }

            if (status === 'Rejected' && canApprove) {
                buttons += `
                    <button onclick="reopenTicket(${id})" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded" title="Re-Open">
                        <i class="fas fa-redo text-xs"></i>
                    </button>
                `;
            }

            // Parts management available for all open/active tickets
            if (status !== 'Closed' && status !== 'Rejected') {
                buttons += `
                    <button onclick="openPartsModal(${id}, '${escapeHtml(ticketNo)}')" class="p-1.5 text-purple-600 hover:bg-purple-50 rounded" title="Manage Parts">
                        <i class="fas fa-cogs text-xs"></i>
                    </button>
                `;
            }

            // Delete button - require delete permission
            if (canDelete) {
                buttons += `
                    <button onclick="deleteTicket(${id}, '${escapeHtml(ticketNo)}')" class="p-1.5 text-red-400 hover:text-red-600 hover:bg-red-50 rounded" title="Delete Ticket">
                        <i class="fas fa-trash text-xs"></i>
                    </button>
                `;
            }

            return buttons;
        }

        // ==================== FILTER ====================
        function filterTickets() {
            const term = $('#searchInput').val().toLowerCase();
            const status = $('#statusFilter').val();

            const filtered = allTickets.filter(t => {
                const matchesTerm = (t.ticketNo && t.ticketNo.toLowerCase().includes(term)) ||
                                    (t.subject && t.subject.toLowerCase().includes(term));
                const matchesStatus = status === 'all' || (t.status === status);
                return matchesTerm && matchesStatus;
            });

            renderTickets(filtered);
        }

        // ==================== STYLE HELPERS ====================
        function getPriorityClass(p) {
            if (!p) return 'bg-gray-100 text-gray-800';
            p = p.toLowerCase();
            if (p === 'high' || p === 'urgent') return 'bg-red-50 text-red-700';
            if (p === 'medium') return 'bg-amber-50 text-amber-700';
            return 'bg-green-50 text-green-700';
        }

        function getStatusClass(s) {
            if (!s) return 'bg-gray-100 text-gray-800';
            s = s.toLowerCase();
            if (s === 'open') return 'bg-red-50 text-red-700';
            if (s === 'approved') return 'bg-green-50 text-green-700';
            if (s === 'assigned' || s === 'inprogress') return 'bg-blue-50 text-blue-700';
            if (s === 'resolved' || s === 'closed') return 'bg-emerald-50 text-emerald-700';
            if (s === 'rejected') return 'bg-gray-100 text-gray-700';
            return 'bg-gray-100 text-gray-600';
        }

        // ==================== APPROVE ACTIONS ====================
        function openApproveModal(ticketId) {
            $('#approveTicketId').val(ticketId);
            $('#approveRemarks').val('');
            openModal('approveModal');
        }

        function submitApprove() {
            const ticketId = parseInt($('#approveTicketId').val());
            const remarks = $('#approveRemarks').val().trim() || 'Approved';

            showLoading();
            closeModal('approveModal');

            $.ajax({
                url: '@Url.Action("ApproveTicket", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ticketId: ticketId,
                    remarks: remarks,
                    username: username
                }),
                success: function (res) {
                    hideLoading();
                    if (res && res.success) {
                        showToast('Ticket approved', 'success');
                        loadTickets();
                    } else {
                        showToast('Failed: ' + (res.message || 'Error'), 'error');
                    }
                },
                error: function () {
                    hideLoading();
                    showToast('Failed to approve', 'error');
                }
            });
        }

        // ==================== REJECT ACTIONS ====================
        function openRejectModal(ticketId) {
            $('#rejectTicketId').val(ticketId);
            $('#rejectReason').val('');
            openModal('rejectModal');
        }

        function submitReject() {
            const ticketId = parseInt($('#rejectTicketId').val());
            const reason = $('#rejectReason').val().trim();

            if (!reason) {
                showToast('Please provide reason', 'error');
                return;
            }

            showLoading();
            closeModal('rejectModal');

            $.ajax({
                url: '@Url.Action("RejectTicket", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ticketId: ticketId,
                    remarks: reason,
                    username: username
                }),
                success: function (res) {
                    hideLoading();
                    if (res && res.success) {
                        showToast('Ticket rejected', 'success');
                        loadTickets();
                    } else {
                        showToast('Failed: ' + (res.message || 'Error'), 'error');
                    }
                },
                error: function () {
                    hideLoading();
                    showToast('Failed to reject', 'error');
                }
            });
        }

        // ==================== ASSIGN ACTIONS ====================
        function openAssignModal(ticketId, ticketNo) {
            $('#assignTicketId').val(ticketId);
            $('#assignTicketNo').val(ticketNo);
            $('#assignNotes').val('');
            openModal('assignModal');
        }

        function submitAssign() {
            const ticketId = parseInt($('#assignTicketId').val());
            const engineerId = $('#engineerSelect').val();
            const engineerName = $('#engineerSelect option:selected').data('name') || $('#engineerSelect option:selected').text();
            const notes = $('#assignNotes').val().trim();

            if (!engineerId) {
                showToast('Select engineer', 'error');
                return;
            }

            showLoading();
            closeModal('assignModal');

            $.ajax({
                url: '@Url.Action("AssignTicket", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ticketId: ticketId,
                    engineerId: engineerId,
                    engineerName: engineerName,
                    assignedBy: username,
                    notes: notes
                }),
                success: function (res) {
                    hideLoading();
                    if (res && res.success) {
                        showToast('Ticket assigned', 'success');
                        loadTickets();
                    } else {
                        showToast('Failed: ' + (res.message || 'Error'), 'error');
                    }
                },
                error: function () {
                    hideLoading();
                    showToast('Failed to assign', 'error');
                }
            });
        }

        // ==================== STATUS ACTIONS ====================
        function openStatusModal(ticketId, currentStatus) {
            $('#statusTicketId').val(ticketId);
            $('#currentStatusDisplay').text(currentStatus);
            $('#newStatusSelect').val(currentStatus);
            $('#statusRemarks').val('');
            openModal('statusModal');
        }

        function submitStatusUpdate() {
            const ticketId = parseInt($('#statusTicketId').val());
            const newStatus = $('#newStatusSelect').val();
            const remarks = $('#statusRemarks').val().trim();

            showLoading();
            closeModal('statusModal');

            $.ajax({
                url: '@Url.Action("UpdateStatus", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ticketId: ticketId,
                    newStatus: newStatus,
                    remarks: remarks,
                    username: username
                }),
                success: function (res) {
                    hideLoading();
                    if (res && res.success) {
                        showToast('Status updated', 'success');
                        loadTickets();
                    } else {
                        showToast('Failed: ' + (res.message || 'Error'), 'error');
                    }
                },
                error: function () {
                    hideLoading();
                    showToast('Failed to update', 'error');
                }
            });
        }

        function reopenTicket(ticketId) {
            sysConfirm('Re-open this ticket?', function() {
                showLoading();
                $.ajax({
                    url: '@Url.Action("UpdateStatus", "ServiceDesk")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        ticketId: ticketId,
                        newStatus: 'Open',
                        remarks: 'Ticket re-opened',
                        username: username
                    }),
                    success: function (res) {
                        hideLoading();
                        if (res && res.success) {
                            showToast('Ticket re-opened', 'success');
                            loadTickets();
                        } else {
                            showToast('Failed: ' + (res.message || 'Error'), 'error');
                        }
                    },
                    error: function () {
                        hideLoading();
                        showToast('Failed to re-open', 'error');
                    }
                });
            });
        }

        // ==================== PARTS ACTIONS ====================
        function openPartsModal(ticketId, ticketNo) {
            $('#partsTicketId').val(ticketId);
            $('#partsTicketNo').text(ticketNo);
            $('#partName').val('');
            $('#partNumber').val('');
            $('#partQty').val('1');
            $('#partCost').val('0');
            openModal('partsModal');
            loadParts(ticketId);
        }

        function loadParts(ticketId) {
            $('#partsContainer').html('<div class="text-center py-3 text-gray-400 text-sm"><i class="fas fa-spinner fa-spin mr-2"></i>Loading...</div>');

            $.ajax({
                url: '@Url.Action("GetParts", "ServiceDesk")',
                type: 'GET',
                data: { ticketId: ticketId },
                success: function (parts) {
                    if (!parts || parts.length === 0) {
                        $('#partsContainer').html('<div class="text-center py-3 text-gray-400 text-sm">No parts added</div>');
                        return;
                    }
                    let html = '<div class="space-y-1.5">';
                    parts.forEach(p => {
                        html += `
                            <div class="flex items-center justify-between p-2 bg-gray-50 rounded border border-gray-100">
                                <div>
                                    <span class="font-medium text-gray-800 text-sm">${escapeHtml(p.partName)}</span>
                                    <span class="text-gray-400 text-xs ml-1">${escapeHtml(p.partNumber || '')}</span>
                                    <div class="text-xs text-gray-500 mt-0.5">Qty: ${p.quantity} | Cost: ₹${(p.totalCost || 0).toFixed(2)}</div>
                                </div>
                                <button onclick="deletePart(${p.id})" class="text-red-400 hover:text-red-600 p-1" title="Delete">
                                    <i class="fas fa-trash text-xs"></i>
                                </button>
                            </div>
                        `;
                    });
                    html += '</div>';
                    $('#partsContainer').html(html);
                },
                error: function () {
                    $('#partsContainer').html('<div class="text-center py-3 text-red-400 text-sm">Failed to load</div>');
                }
            });
        }

        function submitAddPart() {
            const ticketId = parseInt($('#partsTicketId').val());
            const partName = $('#partName').val().trim();
            const partNumber = $('#partNumber').val().trim();
            const quantity = parseInt($('#partQty').val()) || 1;
            const unitCost = parseFloat($('#partCost').val()) || 0;

            if (!partName) {
                showToast('Enter part name', 'error');
                return;
            }

            $.ajax({
                url: '@Url.Action("AddPart", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ticketId: ticketId,
                    partName: partName,
                    partNumber: partNumber,
                    quantity: quantity,
                    unitCost: unitCost,
                    addedById: userId,
                    addedByName: username
                }),
                success: function (res) {
                    if (res && res.success) {
                        showToast('Part added', 'success');
                        loadParts(ticketId);
                        $('#partName').val('');
                        $('#partNumber').val('');
                        $('#partQty').val('1');
                        $('#partCost').val('0');
                    } else {
                        showToast('Failed to add', 'error');
                    }
                },
                error: function () {
                    showToast('Failed to add', 'error');
                }
            });
        }

        function deletePart(partId) {
            sysConfirm('Delete this part?', function() {
                const ticketId = parseInt($('#partsTicketId').val());
                $.ajax({
                    url: '@Url.Action("DeletePart", "ServiceDesk")',
                    type: 'DELETE',
                    data: { id: partId },
                    success: function (res) {
                        if (res && res.success) {
                            showToast('Part deleted', 'success');
                            loadParts(ticketId);
                        } else {
                            showToast('Failed to delete', 'error');
                        }
                    },
                    error: function () {
                        showToast('Failed to delete', 'error');
                    }
                });
            }, {type:'danger'});
        }

        // ==================== START WORK ====================
        function startWork(ticketId) {
            sysConfirm('Start working on this ticket?', function() {
                $.ajax({
                    url: '@Url.Action("StartWork", "ServiceDesk")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        ticketId: ticketId,
                        username: username,
                        remarks: 'Started working on ticket'
                    }),
                    success: function (res) {
                        if (res && res.success) {
                            showToast('Work started', 'success');
                            loadTickets();
                        } else {
                            showToast(res.message || 'Failed to start work', 'error');
                        }
                    },
                    error: function () {
                        showToast('Failed to start work', 'error');
                    }
                });
            });
        }

        // ==================== DELETE TICKET ====================
        function deleteTicket(ticketId, ticketNo) {
            sysConfirm('Are you sure you want to delete ticket ' + ticketNo + '? This action cannot be undone.', function() {
                $.ajax({
                    url: '@Url.Action("DeleteTicket", "ServiceDesk")' + '?id=' + ticketId,
                    type: 'DELETE',
                    success: function (res) {
                        if (res && res.success) {
                            showToast('Ticket deleted', 'success');
                            loadTickets();
                        } else {
                            showToast(res.message || 'Failed to delete ticket', 'error');
                        }
                    },
                    error: function () {
                        showToast('Failed to delete ticket', 'error');
                    }
                });
            }, {type:'danger'});
        }

        // ==================== RESOLVE TICKET ====================
        let resolveTicketId = 0;
        
        function openResolveModal(ticketId) {
            resolveTicketId = ticketId;
            $('#resolveNotes').val('');
            openModal('resolveModal');
        }

        function submitResolve() {
            const notes = $('#resolveNotes').val().trim();
            
            $.ajax({
                url: '@Url.Action("ResolveTicket", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ticketId: resolveTicketId,
                    username: username,
                    resolutionNotes: notes
                }),
                success: function (res) {
                    if (res && res.success) {
                        showToast('Ticket resolved', 'success');
                        closeModal('resolveModal');
                        loadTickets();
                    } else {
                        showToast(res.message || 'Failed to resolve', 'error');
                    }
                },
                error: function () {
                    showToast('Failed to resolve ticket', 'error');
                }
            });
        }
    </script>
}