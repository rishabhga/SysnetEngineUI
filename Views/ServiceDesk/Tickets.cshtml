@{
    ViewData["Title"] = "All Service Tickets";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bg-gray-50 min-h-screen p-8">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Support Requests</h1>
            <nav class="flex text-sm text-slate-500 mt-1" aria-label="Breadcrumb">
                <ol class="flex items-center space-x-2">
                    <li><a href="@Url.Action("Index")" class="hover:text-blue-600">Dashboard</a></li>
                    <li><span class="text-slate-300">/</span></li>
                    <li class="font-medium text-slate-800">Tickets</li>
                </ol>
            </nav>
        </div>
        <div class="flex items-center space-x-3">
            <a href="@Url.Action("Index", "ServiceDesk")" class="px-4 py-2 bg-white border border-slate-300 text-slate-700 font-medium rounded-lg hover:bg-slate-50 transition-colors shadow-sm">
                <i class="fas fa-arrow-left mr-2"></i> Back
            </a>
            <a href="@Url.Action("CreateTicket", "ServiceDesk")" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg shadow-sm transition-colors flex items-center">
                <i class="fas fa-plus mr-2"></i> New Ticket
            </a>
        </div>
    </div>

    <!-- Filters & Search -->
    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 mb-6 flex flex-col md:flex-row gap-4 items-center justify-between">
        <div class="flex items-center gap-4 w-full md:w-auto">
            <div class="relative w-full md:w-64">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                    <i class="fas fa-search"></i>
                </span>
                <input type="text" id="searchInput" placeholder="Search by ID or Subject..." class="pl-10 pr-4 py-2 w-full border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
            </div>
            
            <select id="statusFilter" class="border border-slate-300 rounded-lg py-2 px-3 text-sm focus:ring-2 focus:ring-blue-500 outline-none bg-white text-slate-700">
                <option value="all">All Statuses</option>
            </select>
        </div>
        
        <div class="text-sm text-slate-500">
            Showing <span id="ticketCount" class="font-bold text-slate-800">--</span> tickets
        </div>
    </div>

    <!-- Tickets Grid -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                        <th class="px-6 py-4">Ticket ID</th>
                        <th class="px-6 py-4">Subject</th>
                        <th class="px-6 py-4">Requester</th>
                        <th class="px-6 py-4">Assigned To</th>
                        <th class="px-6 py-4">Priority</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4">Created</th>
                        <th class="px-6 py-4">Due Date</th>
                        <th class="px-6 py-4 text-right">Action</th>
                    </tr>
                </thead>
                <tbody id="ticketsTableBody" class="text-sm divide-y divide-slate-100">
                    <tr>
                        <td colspan="9" class="px-6 py-12 text-center text-slate-500">
                            <i class="fas fa-circle-notch fa-spin text-blue-500 text-2xl mb-3"></i>
                            <p>Loading tickets from database...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Approve Modal -->
<div id="approveModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md mx-4 transform transition-all">
        <div class="px-6 py-4 border-b border-slate-200 flex items-center">
            <i class="fas fa-check-circle text-green-500 text-xl mr-3"></i>
            <h3 class="text-lg font-semibold text-slate-800">Approve Ticket</h3>
            <button onclick="closeModal('approveModal')" class="ml-auto text-slate-400 hover:text-slate-600">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="p-6">
            <input type="hidden" id="approveTicketId">
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-700 mb-2">Remarks (Optional)</label>
                <textarea id="approveRemarks" class="w-full border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none transition" rows="3" placeholder="Any additional remarks..."></textarea>
            </div>
            <p class="text-sm text-slate-500 mb-4"><i class="fas fa-info-circle mr-1"></i>This will approve the ticket and allow it to be assigned to an engineer.</p>
        </div>
        <div class="px-6 py-4 bg-slate-50 rounded-b-xl flex justify-end space-x-3">
            <button onclick="closeModal('approveModal')" class="px-4 py-2 text-slate-600 hover:text-slate-800 font-medium">Cancel</button>
            <button onclick="submitApprove()" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition-colors">
                <i class="fas fa-check mr-1"></i> Approve
            </button>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md mx-4 transform transition-all">
        <div class="px-6 py-4 border-b border-slate-200 flex items-center">
            <i class="fas fa-times-circle text-red-500 text-xl mr-3"></i>
            <h3 class="text-lg font-semibold text-slate-800">Reject Ticket</h3>
            <button onclick="closeModal('rejectModal')" class="ml-auto text-slate-400 hover:text-slate-600">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="p-6">
            <input type="hidden" id="rejectTicketId">
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-700 mb-2">Reason for Rejection <span class="text-red-500">*</span></label>
                <textarea id="rejectReason" class="w-full border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition" rows="4" placeholder="Please provide a detailed reason for rejecting this ticket..." required></textarea>
            </div>
        </div>
        <div class="px-6 py-4 bg-slate-50 rounded-b-xl flex justify-end space-x-3">
            <button onclick="closeModal('rejectModal')" class="px-4 py-2 text-slate-600 hover:text-slate-800 font-medium">Cancel</button>
            <button onclick="submitReject()" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg transition-colors">
                <i class="fas fa-times mr-1"></i> Reject
            </button>
        </div>
    </div>
</div>

<!-- Assign Engineer Modal -->
<div id="assignModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md mx-4 transform transition-all">
        <div class="px-6 py-4 border-b border-slate-200 flex items-center">
            <i class="fas fa-user-tag text-blue-500 text-xl mr-3"></i>
            <h3 class="text-lg font-semibold text-slate-800">Assign Engineer</h3>
            <button onclick="closeModal('assignModal')" class="ml-auto text-slate-400 hover:text-slate-600">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="p-6">
            <input type="hidden" id="assignTicketId">
            <input type="hidden" id="assignTicketNo">
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-700 mb-2">Select Engineer <span class="text-red-500">*</span></label>
                <select id="engineerSelect" class="w-full border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition">
                    <option value="">Loading engineers...</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-700 mb-2">Notes (Optional)</label>
                <textarea id="assignNotes" class="w-full border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" rows="2" placeholder="Any notes for the engineer..."></textarea>
            </div>
        </div>
        <div class="px-6 py-4 bg-slate-50 rounded-b-xl flex justify-end space-x-3">
            <button onclick="closeModal('assignModal')" class="px-4 py-2 text-slate-600 hover:text-slate-800 font-medium">Cancel</button>
            <button onclick="submitAssign()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">
                <i class="fas fa-user-check mr-1"></i> Assign
            </button>
        </div>
    </div>
</div>

<!-- Parts Modal -->
<div id="partsModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-2xl mx-4 transform transition-all max-h-[90vh] overflow-hidden flex flex-col">
        <div class="px-6 py-4 border-b border-slate-200 flex items-center">
            <i class="fas fa-cogs text-purple-500 text-xl mr-3"></i>
            <h3 class="text-lg font-semibold text-slate-800">Manage Parts - <span id="partsTicketNo"></span></h3>
            <button onclick="closeModal('partsModal')" class="ml-auto text-slate-400 hover:text-slate-600">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="p-6 overflow-y-auto flex-1">
            <input type="hidden" id="partsTicketId">
            
            <!-- Existing Parts List -->
            <div id="partsContainer" class="mb-6">
                <div class="text-center py-4 text-slate-400">
                    <i class="fas fa-spinner fa-spin mr-2"></i>Loading parts...
                </div>
            </div>
            
            <hr class="my-4 border-slate-200">
            
            <!-- Add New Part Form -->
            <h5 class="font-semibold text-slate-700 mb-3"><i class="fas fa-plus mr-1"></i>Add New Part</h5>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">Part Name <span class="text-red-500">*</span></label>
                    <input type="text" id="partName" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 outline-none" placeholder="e.g., RAM Module">
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">Part Number</label>
                    <input type="text" id="partNumber" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 outline-none" placeholder="e.g., DDR4-3200">
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">Quantity <span class="text-red-500">*</span></label>
                    <input type="number" id="partQty" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 outline-none" value="1" min="1">
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">Unit Cost</label>
                    <input type="number" id="partCost" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 outline-none" value="0" step="0.01">
                </div>
            </div>
        </div>
        <div class="px-6 py-4 bg-slate-50 rounded-b-xl flex justify-end space-x-3">
            <button onclick="closeModal('partsModal')" class="px-4 py-2 text-slate-600 hover:text-slate-800 font-medium">Close</button>
            <button onclick="submitAddPart()" class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-lg transition-colors">
                <i class="fas fa-plus mr-1"></i> Add Part
            </button>
        </div>
    </div>
</div>

<!-- Update Status Modal -->
<div id="statusModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md mx-4 transform transition-all">
        <div class="px-6 py-4 border-b border-slate-200 flex items-center">
            <i class="fas fa-exchange-alt text-amber-500 text-xl mr-3"></i>
            <h3 class="text-lg font-semibold text-slate-800">Update Status</h3>
            <button onclick="closeModal('statusModal')" class="ml-auto text-slate-400 hover:text-slate-600">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="p-6">
            <input type="hidden" id="statusTicketId">
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-700 mb-2">Current Status</label>
                <span id="currentStatusDisplay" class="inline-block px-3 py-1 bg-slate-100 text-slate-600 rounded-lg text-sm font-medium"></span>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-700 mb-2">New Status <span class="text-red-500">*</span></label>
                <select id="newStatusSelect" class="w-full border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition">
                </select>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-700 mb-2">Remarks</label>
                <textarea id="statusRemarks" class="w-full border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition" rows="2" placeholder="Reason for status change..."></textarea>
            </div>
        </div>
        <div class="px-6 py-4 bg-slate-50 rounded-b-xl flex justify-end space-x-3">
            <button onclick="closeModal('statusModal')" class="px-4 py-2 text-slate-600 hover:text-slate-800 font-medium">Cancel</button>
            <button onclick="submitStatusUpdate()" class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white font-medium rounded-lg transition-colors">
                <i class="fas fa-save mr-1"></i> Update
            </button>
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div id="loadingOverlay" class="fixed inset-0 bg-black bg-opacity-50 z-[100] hidden flex items-center justify-center">
    <div class="bg-white rounded-xl p-8 shadow-2xl text-center">
        <i class="fas fa-circle-notch fa-spin text-blue-500 text-4xl mb-4"></i>
        <p class="text-slate-600 font-medium">Processing...</p>
    </div>
</div>

<!-- Toast Notification -->
<div id="toast" class="fixed bottom-4 right-4 z-[110] hidden transform transition-all duration-300">
    <div id="toastContent" class="px-6 py-4 rounded-lg shadow-lg flex items-center space-x-3">
        <i id="toastIcon" class="text-xl"></i>
        <span id="toastMessage" class="font-medium"></span>
    </div>
</div>

@section Scripts {
    <script>
        // ==================== GLOBAL STATE ====================
        let allTickets = [];
        const username = '@Context.Session.GetString("username")' || 'Admin';
        const userId = '@Context.Session.GetString("userId")' || '1';

        // ==================== INITIALIZATION ====================
        $(document).ready(function () {
            console.log('Service Desk Tickets page loaded');
            loadTickets();
            loadEngineers();
            loadStatuses();

            $('#searchInput').on('keyup', filterTickets);
            $('#statusFilter').on('change', filterTickets);
        });

        // ==================== MODAL HELPERS ====================
        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
            document.body.style.overflow = '';
        }

        function showLoading() {
            document.getElementById('loadingOverlay').classList.remove('hidden');
        }

        function hideLoading() {
            document.getElementById('loadingOverlay').classList.add('hidden');
        }

        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            const content = document.getElementById('toastContent');
            const icon = document.getElementById('toastIcon');
            const msg = document.getElementById('toastMessage');

            content.className = 'px-6 py-4 rounded-lg shadow-lg flex items-center space-x-3 ';
            if (type === 'success') {
                content.className += 'bg-green-500 text-white';
                icon.className = 'fas fa-check-circle text-xl';
            } else if (type === 'error') {
                content.className += 'bg-red-500 text-white';
                icon.className = 'fas fa-exclamation-circle text-xl';
            } else {
                content.className += 'bg-blue-500 text-white';
                icon.className = 'fas fa-info-circle text-xl';
            }

            msg.textContent = message;
            toast.classList.remove('hidden');

            setTimeout(() => {
                toast.classList.add('hidden');
            }, 4000);
        }

        // ==================== LOAD DATA ====================
        function loadTickets() {
            console.log('Loading tickets...');
            $.ajax({
                url: '@Url.Action("GetTickets", "ServiceDesk")',
                type: 'GET',
                success: function (data) {
                    console.log('Tickets loaded:', data);
                    allTickets = data || [];
                    renderTickets(allTickets);
                },
                error: function (xhr, status, error) {
                    console.error('Failed to load tickets:', error);
                    $('#ticketsTableBody').html('<tr><td colspan="9" class="px-6 py-8 text-center text-red-500"><i class="fas fa-exclamation-triangle mr-2"></i>Failed to load tickets. Please refresh the page.</td></tr>');
                }
            });
        }

        function loadEngineers() {
            console.log('Loading engineers...');
            $.ajax({
                url: '@Url.Action("GetEngineers", "ServiceDesk")',
                type: 'GET',
                success: function (data) {
                    console.log('Engineers loaded:', data);
                    const select = $('#engineerSelect');
                    select.empty();
                    select.append('<option value="">-- Select Engineer --</option>');
                    if (data && data.length > 0) {
                        data.forEach(e => {
                            select.append(`<option value="${e.id}" data-name="${e.name}">${e.name} (${e.specialty || 'IT'})</option>`);
                        });
                    } else {
                        select.append('<option value="">No engineers available</option>');
                    }
                },
                error: function () {
                    console.error('Failed to load engineers');
                    $('#engineerSelect').html('<option value="">Failed to load engineers</option>');
                }
            });
        }

        function loadStatuses() {
            console.log('Loading statuses...');
            $.ajax({
                url: '@Url.Action("GetStatuses", "ServiceDesk")',
                type: 'GET',
                success: function (data) {
                    console.log('Statuses loaded:', data);
                    const filterSelect = $('#statusFilter');
                    const modalSelect = $('#newStatusSelect');
                    
                    if (data && data.length > 0) {
                        data.forEach(s => {
                            filterSelect.append(`<option value="${s.value}">${s.label}</option>`);
                            modalSelect.append(`<option value="${s.value}">${s.label}</option>`);
                        });
                    } else {
                        // Fallback if DB empty
                        const fallbacks = ['Open', 'Approved', 'Assigned', 'InProgress', 'Resolved', 'Closed', 'Rejected'];
                        fallbacks.forEach(s => {
                            filterSelect.append(`<option value="${s}">${s}</option>`);
                            modalSelect.append(`<option value="${s}">${s}</option>`);
                        });
                    }
                }
            });
        }

        // ==================== RENDER TICKETS ====================
        function renderTickets(tickets) {
            const tbody = $('#ticketsTableBody');
            tbody.empty();
            $('#ticketCount').text(tickets.length);

            if (tickets.length === 0) {
                tbody.html('<tr><td colspan="9" class="px-6 py-8 text-center text-slate-500">No tickets found matching your criteria.</td></tr>');
                return;
            }

            tickets.forEach(t => {
                const isOverdue = t.isSLABreached;
                const dueDate = t.dueDate ? new Date(t.dueDate) : null;
                const createdDate = new Date(t.createdOn);
                const status = t.status || 'Open';

                const row = `
                    <tr class="hover:bg-slate-50 transition-colors ${isOverdue ? 'bg-red-50/30' : ''}">
                        <td class="px-6 py-4 font-medium text-slate-700">
                            <span class="font-mono text-xs text-slate-400 mr-1">#</span>${t.ticketNo || t.id}
                        </td>
                        <td class="px-6 py-4">
                            <a href="/ServiceDesk/Details/${t.id}" class="font-medium text-slate-800 hover:text-blue-600 transition-colors block cursor-pointer">
                                ${escapeHtml(t.subject || 'No Subject')}
                            </a>
                            <div class="text-xs text-slate-400 mt-0.5 truncate max-w-[200px]">${escapeHtml(t.category || 'General')}</div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex items-center">
                                <div class="h-8 w-8 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-xs font-bold mr-2 border border-indigo-200">
                                    ${(t.requesterName || 'U').charAt(0).toUpperCase()}
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-slate-600">${escapeHtml(t.requesterName || 'Unknown')}</span>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-slate-500">
                            ${t.assignedToName ? 
                                `<span class="flex items-center text-xs bg-slate-100 px-2 py-1 rounded border border-slate-200"><i class="fas fa-user-tag mr-1.5 text-slate-400"></i> ${escapeHtml(t.assignedToName)}</span>` 
                                : '<span class="text-slate-400 italic text-xs">Unassigned</span>'}
                        </td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${getPriorityClass(t.priority)}">
                                ${t.priority || 'Medium'}
                            </span>
                        </td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${getStatusClass(status)}">
                                <span class="w-1.5 h-1.5 rounded-full mr-1.5 bg-current opacity-75"></span>
                                ${status}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-slate-500 text-xs">
                            <div class="text-slate-700">${createdDate.toLocaleDateString()}</div>
                            <div class="text-slate-400 text-[10px]">${createdDate.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</div>
                        </td>
                        <td class="px-6 py-4 text-xs font-medium">
                            ${dueDate ? 
                                `<div class="${isOverdue ? 'text-red-600 font-bold' : 'text-slate-600'}">
                                    ${isOverdue ? '<i class="fas fa-fire mr-1"></i>' : ''}
                                    ${dueDate.toLocaleDateString()}
                                    ${isOverdue ? '<span class="ml-1 text-[10px] uppercase bg-red-100 px-1 rounded text-red-700">Late</span>' : ''}
                                </div>` 
                                : '<span class="text-slate-300">-</span>'}
                        </td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex justify-end space-x-1">
                                ${getActionButtons(t)}
                            </div>
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function getActionButtons(ticket) {
            const status = ticket.status || 'Open';
            const id = ticket.id;
            const ticketNo = ticket.ticketNo || ticket.id;
            let buttons = `
                <a href="/ServiceDesk/Details/${id}" class="p-2 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" title="View Details">
                    <i class="fas fa-eye"></i>
                </a>
            `;

            if (status === 'Open') {
                buttons += `
                    <button onclick="openApproveModal(${id})" class="p-2 text-green-600 hover:bg-green-50 rounded-lg transition-colors" title="Approve">
                        <i class="fas fa-check"></i>
                    </button>
                    <button onclick="openRejectModal(${id})" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Reject">
                        <i class="fas fa-times"></i>
                    </button>
                `;
            }

            if (status === 'Open' || status === 'Approved') {
                buttons += `
                    <button onclick="openAssignModal(${id}, '${escapeHtml(ticketNo)}')" class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" title="Assign Engineer">
                        <i class="fas fa-user-tag"></i>
                    </button>
                `;
            }

            if (status === 'Assigned' || status === 'InProgress' || status === 'Approved') {
                buttons += `
                    <button onclick="openStatusModal(${id}, '${status}')" class="p-2 text-amber-600 hover:bg-amber-50 rounded-lg transition-colors" title="Update Status">
                        <i class="fas fa-exchange-alt"></i>
                    </button>
                `;
            }

            if (status === 'Rejected') {
                buttons += `
                    <button onclick="reopenTicket(${id})" class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" title="Re-Open">
                        <i class="fas fa-redo"></i>
                    </button>
                `;
            }

            buttons += `
                <button onclick="openPartsModal(${id}, '${escapeHtml(ticketNo)}')" class="p-2 text-purple-600 hover:bg-purple-50 rounded-lg transition-colors" title="Add/View Parts">
                    <i class="fas fa-cogs"></i>
                </button>
            `;

            return buttons;
        }

        // ==================== FILTER ====================
        function filterTickets() {
            const term = $('#searchInput').val().toLowerCase();
            const status = $('#statusFilter').val();

            const filtered = allTickets.filter(t => {
                const matchesTerm = (t.ticketNo && t.ticketNo.toLowerCase().includes(term)) || 
                                    (t.subject && t.subject.toLowerCase().includes(term));
                const matchesStatus = status === 'all' || (t.status === status);
                return matchesTerm && matchesStatus;
            });

            renderTickets(filtered);
        }

        // ==================== STYLE HELPERS ====================
        function getPriorityClass(p) {
            if (!p) return 'bg-gray-100 text-gray-800';
            p = p.toLowerCase();
            if (p === 'high' || p === 'urgent') return 'bg-red-50 text-red-700 border border-red-200';
            if (p === 'medium') return 'bg-amber-50 text-amber-700 border border-amber-200';
            return 'bg-green-50 text-green-700 border border-green-200';
        }

        function getStatusClass(s) {
            if (!s) return 'bg-gray-100 text-gray-800';
            s = s.toLowerCase();
            if (s === 'open') return 'bg-red-50 text-red-700 border border-red-200';
            if (s === 'approved') return 'bg-green-100 text-green-800 border border-green-300';
            if (s === 'assigned' || s === 'inprogress') return 'bg-blue-50 text-blue-700 border border-blue-200';
            if (s === 'resolved' || s === 'closed') return 'bg-emerald-50 text-emerald-700 border border-emerald-200';
            if (s === 'rejected') return 'bg-red-100 text-red-800 border border-red-300';
            return 'bg-gray-100 text-gray-600';
        }

        // ==================== APPROVE ACTIONS ====================
        function openApproveModal(ticketId) {
            console.log('Opening approve modal for ticket:', ticketId);
            $('#approveTicketId').val(ticketId);
            $('#approveRemarks').val('');
            openModal('approveModal');
        }

        function submitApprove() {
            const ticketId = parseInt($('#approveTicketId').val());
            const remarks = $('#approveRemarks').val().trim() || 'Approved';

            console.log('Approving ticket:', ticketId, 'with remarks:', remarks);
            showLoading();
            closeModal('approveModal');

            $.ajax({
                url: '@Url.Action("ApproveTicket", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ticketId: ticketId,
                    remarks: remarks,
                    username: username
                }),
                success: function (res) {
                    console.log('Approve response:', res);
                    hideLoading();
                    if (res && res.success) {
                        showToast('Ticket approved successfully!', 'success');
                        loadTickets();
                    } else {
                        showToast('Failed to approve: ' + (res.message || 'Unknown error'), 'error');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Approve error:', error, xhr.responseText);
                    hideLoading();
                    showToast('Failed to approve ticket. Check console for details.', 'error');
                }
            });
        }

        // ==================== REJECT ACTIONS ====================
        function openRejectModal(ticketId) {
            console.log('Opening reject modal for ticket:', ticketId);
            $('#rejectTicketId').val(ticketId);
            $('#rejectReason').val('');
            openModal('rejectModal');
        }

        function submitReject() {
            const ticketId = parseInt($('#rejectTicketId').val());
            const reason = $('#rejectReason').val().trim();

            if (!reason) {
                showToast('Please provide a reason for rejection', 'error');
                return;
            }

            console.log('Rejecting ticket:', ticketId, 'with reason:', reason);
            showLoading();
            closeModal('rejectModal');

            $.ajax({
                url: '@Url.Action("RejectTicket", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ticketId: ticketId,
                    remarks: reason,
                    username: username
                }),
                success: function (res) {
                    console.log('Reject response:', res);
                    hideLoading();
                    if (res && res.success) {
                        showToast('Ticket rejected successfully!', 'success');
                        loadTickets();
                    } else {
                        showToast('Failed to reject: ' + (res.message || 'Unknown error'), 'error');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Reject error:', error, xhr.responseText);
                    hideLoading();
                    showToast('Failed to reject ticket. Check console for details.', 'error');
                }
            });
        }

        // ==================== ASSIGN ACTIONS ====================
        function openAssignModal(ticketId, ticketNo) {
            console.log('Opening assign modal for ticket:', ticketId);
            $('#assignTicketId').val(ticketId);
            $('#assignTicketNo').val(ticketNo);
            $('#assignNotes').val('');
            openModal('assignModal');
        }

        function submitAssign() {
            const ticketId = parseInt($('#assignTicketId').val());
            const engineerId = $('#engineerSelect').val();
            const engineerName = $('#engineerSelect option:selected').data('name') || $('#engineerSelect option:selected').text();
            const notes = $('#assignNotes').val().trim();

            if (!engineerId) {
                showToast('Please select an engineer', 'error');
                return;
            }

            console.log('Assigning ticket:', ticketId, 'to engineer:', engineerId, engineerName);
            showLoading();
            closeModal('assignModal');

            $.ajax({
                url: '@Url.Action("AssignTicket", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ticketId: ticketId,
                    engineerId: engineerId,
                    engineerName: engineerName,
                    assignedBy: username,
                    notes: notes
                }),
                success: function (res) {
                    console.log('Assign response:', res);
                    hideLoading();
                    if (res && res.success) {
                        showToast('Ticket assigned successfully!', 'success');
                        loadTickets();
                    } else {
                        showToast('Failed to assign: ' + (res.message || 'Unknown error'), 'error');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Assign error:', error, xhr.responseText);
                    hideLoading();
                    showToast('Failed to assign ticket. Check console for details.', 'error');
                }
            });
        }

        // ==================== STATUS ACTIONS ====================
        function openStatusModal(ticketId, currentStatus) {
            console.log('Opening status modal for ticket:', ticketId);
            $('#statusTicketId').val(ticketId);
            $('#currentStatusDisplay').text(currentStatus);
            $('#newStatusSelect').val(currentStatus);
            $('#statusRemarks').val('');
            openModal('statusModal');
        }

        function submitStatusUpdate() {
            const ticketId = parseInt($('#statusTicketId').val());
            const newStatus = $('#newStatusSelect').val();
            const remarks = $('#statusRemarks').val().trim();

            console.log('Updating status for ticket:', ticketId, 'to:', newStatus);
            showLoading();
            closeModal('statusModal');

            $.ajax({
                url: '@Url.Action("UpdateStatus", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ticketId: ticketId,
                    newStatus: newStatus,
                    remarks: remarks,
                    username: username
                }),
                success: function (res) {
                    console.log('Status update response:', res);
                    hideLoading();
                    if (res && res.success) {
                        showToast('Status updated successfully!', 'success');
                        loadTickets();
                    } else {
                        showToast('Failed to update: ' + (res.message || 'Unknown error'), 'error');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Status update error:', error, xhr.responseText);
                    hideLoading();
                    showToast('Failed to update status. Check console for details.', 'error');
                }
            });
        }

        function reopenTicket(ticketId) {
            if (!confirm('Are you sure you want to re-open this ticket?')) return;

            console.log('Re-opening ticket:', ticketId);
            showLoading();

            $.ajax({
                url: '@Url.Action("UpdateStatus", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ticketId: ticketId,
                    newStatus: 'Open',
                    remarks: 'Ticket re-opened',
                    username: username
                }),
                success: function (res) {
                    console.log('Re-open response:', res);
                    hideLoading();
                    if (res && res.success) {
                        showToast('Ticket re-opened successfully!', 'success');
                        loadTickets();
                    } else {
                        showToast('Failed to re-open: ' + (res.message || 'Unknown error'), 'error');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Re-open error:', error, xhr.responseText);
                    hideLoading();
                    showToast('Failed to re-open ticket. Check console for details.', 'error');
                }
            });
        }

        // ==================== PARTS ACTIONS ====================
        function openPartsModal(ticketId, ticketNo) {
            console.log('Opening parts modal for ticket:', ticketId);
            $('#partsTicketId').val(ticketId);
            $('#partsTicketNo').text(ticketNo);
            $('#partName').val('');
            $('#partNumber').val('');
            $('#partQty').val('1');
            $('#partCost').val('0');
            openModal('partsModal');
            loadParts(ticketId);
        }

        function loadParts(ticketId) {
            console.log('Loading parts for ticket:', ticketId);
            $('#partsContainer').html('<div class="text-center py-4 text-slate-400"><i class="fas fa-spinner fa-spin mr-2"></i>Loading parts...</div>');

            $.ajax({
                url: '@Url.Action("GetParts", "ServiceDesk")',
                type: 'GET',
                data: { ticketId: ticketId },
                success: function (parts) {
                    console.log('Parts loaded:', parts);
                    if (!parts || parts.length === 0) {
                        $('#partsContainer').html('<div class="text-center py-4 text-slate-400 text-sm"><i class="fas fa-inbox mr-2"></i>No parts added yet</div>');
                        return;
                    }
                    let html = '<div class="space-y-2">';
                    parts.forEach(p => {
                        html += `
                            <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg border border-slate-200">
                                <div>
                                    <span class="font-medium text-slate-800">${escapeHtml(p.partName)}</span>
                                    <span class="text-slate-400 text-xs ml-2">${escapeHtml(p.partNumber || '')}</span>
                                    <div class="text-xs text-slate-500 mt-1">Qty: ${p.quantity} | Cost: $${(p.totalCost || 0).toFixed(2)}</div>
                                </div>
                                <button onclick="deletePart(${p.id})" class="text-red-400 hover:text-red-600 px-2" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        `;
                    });
                    html += '</div>';
                    $('#partsContainer').html(html);
                },
                error: function () {
                    $('#partsContainer').html('<div class="text-center py-4 text-red-400 text-sm"><i class="fas fa-exclamation-triangle mr-2"></i>Failed to load parts</div>');
                }
            });
        }

        function submitAddPart() {
            const ticketId = parseInt($('#partsTicketId').val());
            const partName = $('#partName').val().trim();
            const partNumber = $('#partNumber').val().trim();
            const quantity = parseInt($('#partQty').val()) || 1;
            const unitCost = parseFloat($('#partCost').val()) || 0;

            if (!partName) {
                showToast('Please enter a part name', 'error');
                return;
            }

            console.log('Adding part to ticket:', ticketId);

            $.ajax({
                url: '@Url.Action("AddPart", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ticketId: ticketId,
                    partName: partName,
                    partNumber: partNumber,
                    quantity: quantity,
                    unitCost: unitCost,
                    addedById: userId,
                    addedByName: username
                }),
                success: function (res) {
                    console.log('Add part response:', res);
                    if (res && res.success) {
                        showToast('Part added successfully!', 'success');
                        loadParts(ticketId);
                        $('#partName').val('');
                        $('#partNumber').val('');
                        $('#partQty').val('1');
                        $('#partCost').val('0');
                    } else {
                        showToast('Failed to add part: ' + (res.message || 'Unknown error'), 'error');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Add part error:', error, xhr.responseText);
                    showToast('Failed to add part. Check console for details.', 'error');
                }
            });
        }

        function deletePart(partId) {
            if (!confirm('Delete this part?')) return;

            const ticketId = parseInt($('#partsTicketId').val());
            console.log('Deleting part:', partId);

            $.ajax({
                url: '@Url.Action("DeletePart", "ServiceDesk")',
                type: 'DELETE',
                data: { id: partId },
                success: function (res) {
                    console.log('Delete part response:', res);
                    if (res && res.success) {
                        showToast('Part deleted!', 'success');
                        loadParts(ticketId);
                    } else {
                        showToast('Failed to delete: ' + (res.message || 'Unknown error'), 'error');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Delete part error:', error, xhr.responseText);
                    showToast('Failed to delete part. Check console for details.', 'error');
                }
            });
        }
    </script>
}
