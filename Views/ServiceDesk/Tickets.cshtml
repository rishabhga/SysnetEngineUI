@{
    ViewData["Title"] = "All Service Tickets";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var canCreate = ViewBag.CanCreate ?? false;
    var canAssign = ViewBag.CanAssign ?? false;
    var canApprove = ViewBag.CanApprove ?? false;
    var canDelete = ViewBag.CanDelete ?? false;
}

<div class="min-h-screen bg-gray-50 p-4">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="mb-5">
            <div class="flex justify-between items-start mb-3">
                <div>
                    <h1 class="text-xl font-bold text-gray-900">Support Requests</h1>
                    <p class="text-gray-600 text-sm mt-0.5">Manage all service tickets</p>
                </div>
                <div class="flex items-center gap-2">
                    @if (canCreate)
                    {
                        <a href="@Url.Action("CreateTicket", "ServiceDesk")"
                           class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded flex items-center">
                            <i class="fas fa-plus mr-1.5 text-xs"></i>
                            New Ticket
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded border border-gray-200 p-3 mb-4">
            <div class="flex flex-wrap items-center gap-3">
                <div class="flex-1 min-w-[200px]">
                    <div class="relative">
                        <i class="fas fa-search absolute left-2.5 top-1/2 transform -translate-y-1/2 text-gray-400 text-sm"></i>
                        <input type="text" id="searchInput" placeholder="Search by ID or Subject..."
                               class="w-full h-8 pl-8 pr-3 text-sm border border-gray-300 rounded focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none">
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <select id="statusFilter" class="h-8 text-sm border border-gray-300 rounded px-2 bg-white text-gray-700 min-w-[120px]">
                        <option value="all">All Statuses</option>
                    </select>
                    <div class="text-sm text-gray-500">
                        <span id="ticketCount" class="font-medium text-gray-800">--</span> tickets
                    </div>
                </div>
            </div>
        </div>

        <!-- Tickets Table -->
        <div class="bg-white rounded border border-gray-200">
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="bg-gray-50 text-gray-500 text-xs border-b border-gray-200">
                            <th class="px-3 py-2.5 font-medium">TICKET ID</th>
                            <th class="px-3 py-2.5 font-medium">SUBJECT</th>
                            <th class="px-3 py-2.5 font-medium">REQUESTER</th>
                            <th class="px-3 py-2.5 font-medium">ASSIGNED TO</th>
                            <th class="px-3 py-2.5 font-medium">PRIORITY</th>
                            <th class="px-3 py-2.5 font-medium">STATUS</th>
                            <th class="px-3 py-2.5 font-medium">CREATED</th>
                            <th class="px-3 py-2.5 font-medium text-right">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody id="ticketsTableBody" class="text-sm">
                        <tr>
                            <td colspan="8" class="px-3 py-4 text-center text-gray-500">
                                <i class="fas fa-circle-notch fa-spin text-blue-500 mr-2"></i>
                                Loading tickets...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Approve Modal -->
<div id="approveModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded w-full max-w-xs">
        <div class="p-3 border-b border-gray-200 flex items-center">
            <i class="fas fa-check-circle text-green-500 mr-2 text-sm"></i>
            <h3 class="font-medium text-gray-800 text-sm">Approve Ticket</h3>
            <button onclick="closeModal('approveModal')" class="ml-auto text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-3">
            <input type="hidden" id="approveTicketId">
            <div id="approveTriageFields" class="grid grid-cols-2 gap-2 mb-2">
                <div>
                    <label class="block text-xs text-gray-700 mb-1">Set Priority <span class="text-[10px] text-gray-400 font-normal">(Optional)</span></label>
                    <select id="approvePriority" class="w-full text-sm border border-gray-300 rounded p-1.5 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none">
                        <option value="">-- Keep Current --</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs text-gray-700 mb-1">Set Category <span class="text-[10px] text-gray-400 font-normal">(Optional)</span></label>
                    <select id="approveCategory" class="w-full text-sm border border-gray-300 rounded p-1.5 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none">
                        <option value="">-- Keep Current --</option>
                    </select>
                </div>
            </div>
            <label class="block text-xs text-gray-700 mb-1">Remarks <span class="text-[10px] text-gray-400 font-normal">(Optional)</span></label>
            <textarea id="approveRemarks" class="w-full text-sm border border-gray-300 rounded p-2 mb-3" rows="2" placeholder="Any remarks..."></textarea>
            <div class="flex gap-2">
                <button onclick="closeModal('approveModal')" class="flex-1 py-1.5 text-sm text-gray-600 font-medium">Cancel</button>
                <button onclick="submitApprove()" class="flex-1 py-1.5 bg-green-600 text-white text-sm font-medium rounded">
                    <i class="fas fa-check mr-1 text-xs"></i> Approve
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded w-full max-w-xs">
        <div class="p-3 border-b border-red-100 bg-red-50 flex items-center">
            <i class="fas fa-times-circle text-red-500 mr-2 text-sm"></i>
            <h3 class="font-medium text-red-800 text-sm">Reject Ticket</h3>
            <button onclick="closeModal('rejectModal')" class="ml-auto text-gray-400 hover:text-red-400">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-3">
            <input type="hidden" id="rejectTicketId">
            <label class="block text-xs text-gray-700 mb-2">Reason for Rejection</label>
            <textarea id="rejectReason" class="w-full text-sm border border-gray-300 rounded p-2 mb-3" rows="3" placeholder="Please provide reason..." required></textarea>
            <div class="flex gap-2">
                <button onclick="closeModal('rejectModal')" class="flex-1 py-1.5 text-sm text-gray-600 font-medium">Cancel</button>
                <button onclick="submitReject()" class="flex-1 py-1.5 bg-red-600 text-white text-sm font-medium rounded">
                    <i class="fas fa-times mr-1 text-xs"></i> Reject
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Assign Modal -->
<div id="assignModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded w-full max-w-xs">
        <div class="p-3 border-b border-blue-100 bg-blue-50 flex items-center">
            <i class="fas fa-user-tag text-blue-500 mr-2 text-sm"></i>
            <h3 class="font-medium text-blue-800 text-sm">Assign Engineer</h3>
            <button onclick="closeModal('assignModal')" class="ml-auto text-gray-400 hover:text-blue-400">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-3">
            <input type="hidden" id="assignTicketId">
            <input type="hidden" id="assignTicketNo">
            <label class="block text-xs text-gray-700 mb-2">Select Engineer</label>
            <input type="hidden" id="selectedEngineerId" />
            <input type="hidden" id="selectedEngineerName" />
            <div id="engineerList" class="max-h-64 overflow-y-auto space-y-2 mb-3 bg-white border border-gray-200 rounded p-2">
                <div class="text-center text-xs text-gray-500 py-3">Loading engineers...</div>
            </div>
            <label class="block text-xs text-gray-700 mb-2">Notes (Optional)</label>
            <textarea id="assignNotes" class="w-full text-sm border border-gray-300 rounded p-2 mb-3" rows="2" placeholder="Any notes..."></textarea>
            <div class="flex gap-2">
                <button onclick="closeModal('assignModal')" class="flex-1 py-1.5 text-sm text-gray-600 font-medium">Cancel</button>
                <button onclick="submitAssign()" class="flex-1 py-1.5 bg-blue-600 text-white text-sm font-medium rounded">
                    <i class="fas fa-user-check mr-1 text-xs"></i> Assign
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Parts Modal -->
<div id="partsModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded w-full max-w-sm max-h-[80vh] overflow-hidden flex flex-col">
        <div class="p-3 border-b border-gray-200 flex items-center">
            <i class="fas fa-cogs text-purple-500 mr-2 text-sm"></i>
            <h3 class="font-medium text-gray-800 text-sm">Manage Parts - <span id="partsTicketNo"></span></h3>
            <button onclick="closeModal('partsModal')" class="ml-auto text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-3 overflow-y-auto flex-1">
            <input type="hidden" id="partsTicketId">

            <div id="partsContainer" class="mb-3">
                <div class="text-center py-3 text-gray-400 text-sm">
                    <i class="fas fa-spinner fa-spin mr-2"></i>Loading parts...
                </div>
            </div>

            <hr class="my-3 border-gray-200">

            <h4 class="font-medium text-gray-700 text-sm mb-2">Add New Part</h4>
            <div class="mb-3">
                <label class="block text-xs text-gray-700 mb-1">Select from Master Parts</label>
                <select id="masterPartSelect" class="w-full text-sm border border-gray-200 rounded p-1.5 focus:ring-2 focus:ring-purple-500 outline-none">
                    <option value="">-- Choose a Part --</option>
                </select>
                <p class="text-[10px] text-gray-500 mt-1"><i class="fas fa-info-circle mr-1"></i> Selecting a part will auto-fill the details below.</p>
            </div>
            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="block text-xs text-gray-600 mb-1">Part Name</label>
                    <input type="text" id="partName" class="w-full text-[13px] border border-gray-300 rounded p-1.5 bg-gray-50" readonly>
                </div>
                <div>
                    <label class="block text-xs text-gray-600 mb-1">Part Number</label>
                    <input type="text" id="partNumber" class="w-full text-[13px] border border-gray-300 rounded p-1.5 bg-gray-50" readonly>
                </div>
                <div>
                    <label class="block text-xs text-gray-600 mb-1">Quantity</label>
                    <input type="number" id="partQty" class="w-full text-[13px] border border-gray-300 rounded p-1.5" value="1" min="1">
                    <div id="stockLevelDisplay" class="text-[9px] mt-0.5"></div>
                </div>
                <div>
                    <label class="block text-xs text-gray-600 mb-1">Unit Cost</label>
                    <input type="number" id="partCost" class="w-full text-[13px] border border-gray-300 rounded p-1.5" value="0" step="0.01">
                </div>
            </div>
        </div>
        <div class="p-3 bg-gray-50 border-t border-gray-200 flex gap-2">
            <button onclick="closeModal('partsModal')" class="flex-1 py-1.5 text-sm text-gray-600 font-medium">Close</button>
            <button onclick="submitAddPart()" class="flex-1 py-1.5 bg-purple-600 text-white text-sm font-medium rounded">
                <i class="fas fa-plus mr-1 text-xs"></i> Add Part
            </button>
        </div>
    </div>
</div>

<!-- Status Modal -->
<div id="statusModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded w-full max-w-sm shadow-xl">
        <div class="p-3 border-b border-gray-200 flex items-center">
            <i class="fas fa-exchange-alt text-amber-500 mr-2 text-sm"></i>
            <h3 class="font-medium text-gray-800 text-sm">Update Status & Triage</h3>
            <button onclick="closeModal('statusModal')" class="ml-auto text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-3">
            <input type="hidden" id="statusTicketId">
            <div class="flex justify-between items-center mb-3 p-2 bg-gray-50 rounded border border-gray-100">
                <span class="text-[10px] font-bold text-gray-400 uppercase">Current State</span>
                <span id="currentStatusDisplay" class="px-2 py-0.5 bg-blue-100 text-blue-700 rounded text-[10px] font-bold uppercase"></span>
            </div>
            
            <div class="grid grid-cols-2 gap-3 mb-3">
                <div class="col-span-2">
                    <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">New Status</label>
                    <select id="newStatusSelect" class="w-full text-sm border border-gray-300 rounded p-1.5 focus:border-blue-500 outline-none"></select>
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Priority</label>
                    <select id="statusPriority" class="w-full text-sm border border-gray-300 rounded p-1.5 focus:border-blue-500 outline-none">
                        <option value="">-- Keep Current --</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Category</label>
                    <select id="statusCategory" class="w-full text-sm border border-gray-300 rounded p-1.5 focus:border-blue-500 outline-none">
                        <option value="">-- Keep Current --</option>
                    </select>
                </div>
            </div>

            <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Remarks</label>
            <textarea id="statusRemarks" class="w-full text-sm border border-gray-300 rounded p-2 mb-3" rows="2" placeholder="Any comments..."></textarea>
            
            <div class="flex gap-2">
                <button onclick="closeModal('statusModal')" class="flex-1 py-2 text-sm text-gray-600 font-medium hover:bg-gray-50 rounded transition-colors">Cancel</button>
                <button onclick="submitStatusUpdate()" class="flex-1 py-2 bg-blue-600 text-white text-sm font-medium rounded shadow-md shadow-blue-200 hover:bg-blue-700 transition-all">Update Ticket</button>
            </div>
        </div>
    </div>
</div>

<!-- Resolve Modal -->
<div id="resolveModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded w-full max-w-sm">
        <div class="p-3 border-b border-gray-200 flex items-center">
            <i class="fas fa-check-circle text-emerald-500 mr-2 text-sm"></i>
            <h3 class="font-medium text-gray-800 text-sm">Resolve Ticket</h3>
            <button onclick="closeModal('resolveModal')" class="ml-auto text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-3">
            <div class="mb-3">
                <label class="block text-xs text-gray-700 mb-1">Resolution Notes</label>
                <textarea id="resolveNotes" class="w-full text-sm border border-gray-300 rounded p-2" rows="4" 
                    placeholder="Describe what was done to resolve this ticket..."></textarea>
            </div>
            <div class="flex gap-2">
                <button onclick="closeModal('resolveModal')" class="flex-1 py-1.5 text-sm text-gray-600 font-medium">Cancel</button>
                <button onclick="submitResolve()" class="flex-1 py-1.5 bg-emerald-500 text-white text-sm font-medium rounded">
                    <i class="fas fa-check mr-1 text-xs"></i> Mark Resolved
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div id="loadingOverlay" class="fixed inset-0 bg-black/50 z-[100] hidden flex items-center justify-center p-4">
    <div class="bg-white rounded p-4 text-center">
        <i class="fas fa-circle-notch fa-spin text-blue-500 text-lg mb-2"></i>
        <p class="text-gray-600 text-sm">Processing...</p>
    </div>
</div>


@section Scripts {
    <script>
        // ==================== GLOBAL STATE ====================
        let allTickets = [];
        let statusColorMap = {};   // statusCode -> colorCode from DB
        let priorityColorMap = {}; // priorityName -> colorCode from DB
        const username = '@Context.Session.GetString("username")' || 'Admin';
        const userId = '@Context.Session.GetString("userId")' || '1';
        
        // Permission flags from server
        const canAssign = @(canAssign ? "true" : "false");
        const canApprove = @(canApprove ? "true" : "false");
        const canDelete = @(canDelete ? "true" : "false");

        // ==================== INITIALIZATION ====================
        $(document).ready(function () {
            // Auto-seed ServiceDesk permissions (ensures engineers appear in assign dropdown)
            $.ajax({
                url: '@Url.Action("SeedServiceDeskPermissions", "ServiceDesk")',
                type: 'POST',
                success: function(res) {
                    if (res && res.permissionsCreated > 0) {
                        console.log('ServiceDesk permissions seeded:', res.message);
                    }
                    loadEngineers(); // Load engineers after seeding completes
                },
                error: function() {
                    loadEngineers(); // Still load even if seed fails
                }
            });

            loadTickets();
            loadStatuses();
            loadPrioritiesForColors();
            loadCategoriesForApprove();
            loadMasterPartsForSelect();
 
            $('#searchInput').on('keyup', filterTickets);
            $('#statusFilter').on('change', filterTickets);

            $('#masterPartSelect').on('change', function() {
                const selected = $(this).find(':selected').data('part');
                if (selected) {
                    $('#partName').val(selected.partName);
                    $('#partNumber').val(selected.partNumber || '');
                    $('#partCost').val(selected.unitCost || 0);
                    $('#stockLevelDisplay').html(`In Stock: <span class="font-bold ${selected.stockQuantity > 0 ? 'text-emerald-600' : 'text-red-500'}">${selected.stockQuantity || 0}</span>`);
                } else {
                    $('#partName, #partNumber').val('');
                    $('#partCost').val(0);
                    $('#stockLevelDisplay').empty();
                }
            });
        });

        // ==================== MODAL HELPERS ====================
        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        function showLoading() {
            document.getElementById('loadingOverlay').classList.remove('hidden');
        }

        function hideLoading() {
            document.getElementById('loadingOverlay').classList.add('hidden');
        }


        // ==================== LOAD & RENDER DATA ====================
        function loadTickets(status = null, pageNumber = 1) {
            const tbody = $('#ticketsTableBody');
            tbody.html('<tr><td colspan="8" class="text-center py-8 text-blue-500"><i class="fas fa-circle-notch fa-spin mb-2 text-xl"></i><br/>Loading tickets...</td></tr>');

            let url = `@Url.Action("GetTickets", "ServiceDesk")?pageNumber=${pageNumber}&pageSize=50`;
            
            $.get(url, function (response) {
                const tickets = response.items || response; // support both paginated and legacy arrays
                allTickets = tickets;
                
                tbody.empty();
                $('#ticketCount').text(response.totalItems || tickets.length || 0);

                if (!tickets || tickets.length === 0) {
                    tbody.html('<tr><td colspan="8" class="px-3 py-4 text-center text-gray-500 text-sm">No tickets found</td></tr>');
                    $('#paginationControls').empty();
                    return;
                }

                tickets.forEach(t => {
                    const isOverdue = t.isSLABreached;
                    const createdDate = new Date(t.createdOn);
                    const ticketStatus = t.status || 'Open';

                    const row = `
                        <tr class="border-b border-gray-50 hover:bg-gray-50 ${isOverdue ? 'bg-red-50/30' : ''}">
                            <td class="px-3 py-2 font-medium text-gray-700 text-sm">
                                <a href="/ServiceDesk/Details/${t.id}" class="hover:text-blue-600">
                                    #${t.ticketNo || t.id}
                                </a>
                            </td>
                            <td class="px-3 py-2">
                                <a href="/ServiceDesk/Details/${t.id}" class="text-gray-800 hover:text-blue-600 font-medium text-sm block">
                                    ${escapeHtml(t.subject || 'No Subject')}
                                </a>
                                <div class="text-xs text-gray-400 mt-0.5 truncate max-w-[200px]">${escapeHtml(t.category || 'General')}</div>
                            </td>
                            <td class="px-3 py-2">
                                <div class="flex items-center">
                                    <div class="w-6 h-6 rounded-full bg-blue-100 text-blue-600 text-xs flex items-center justify-center font-bold mr-1.5">
                                        ${(t.requesterName || 'U').charAt(0).toUpperCase()}
                                    </div>
                                    <span class="text-gray-700 text-sm truncate max-w-[120px]" title="${t.requesterName || 'Unknown'}">${t.requesterName || 'Unknown'}</span>
                                </div>
                            </td>
                            <td class="px-3 py-2 text-gray-600 text-sm">
                                ${t.assignedToName ?
                                    `<span class="flex items-center text-xs bg-gray-100 px-1.5 py-0.5 rounded border border-gray-200">
                                        <i class="fas fa-user-tag mr-1 text-gray-400 text-[10px]"></i>
                                        ${escapeHtml(t.assignedToName)}
                                    </span>`
                                    : '<span class="text-gray-400 text-xs italic">Unassigned</span>'}
                            </td>
                            <td class="px-3 py-2">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border" 
                                      style="color: ${priorityColorMap[(t.priority || '').toLowerCase()] || '#6b7280'}; border-color: ${priorityColorMap[(t.priority || '').toLowerCase()] || '#6b7280'}80; background-color: ${priorityColorMap[(t.priority || '').toLowerCase()] || '#6b7280'}10">
                                    ${t.priority || 'Medium'}
                                </span>
                            </td>
                            <td class="px-3 py-2">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border" 
                                      style="color: ${statusColorMap[ticketStatus.toLowerCase()] || '#6b7280'}; border-color: ${statusColorMap[ticketStatus.toLowerCase()] || '#6b7280'}80; background-color: ${statusColorMap[ticketStatus.toLowerCase()] || '#6b7280'}10">
                                    <span class="w-1.5 h-1.5 rounded-full mr-1" style="background-color: ${statusColorMap[ticketStatus.toLowerCase()] || '#6b7280'}"></span>
                                    ${ticketStatus}
                                </span>
                            </td>
                            <td class="px-3 py-2 text-gray-500 text-xs">
                                <div>${createdDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</div>
                                <div class="text-gray-400">${createdDate.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</div>
                            </td>
                            <td class="px-3 py-2 text-right">
                                <div class="flex justify-end gap-1">
                                    ${getActionButtons(t)}
                                </div>
                            </td>
                        </tr>
                    `;
                    tbody.append(row);
                });

                if (response.totalPages) {
                    renderPagination(response.totalPages, response.currentPage);
                } else {
                    $('#paginationControls').empty();
                }
                
                // Keep the UI filtering in sync if a status was supplied
                if(status) {
                    // Local filtering for UX speed, since GetTickets pagination might not filter server-side
                    // Note: Ideally, GetTickets would accept 'status' server-side as well.
                    // But to adhere to your existing setup, we apply filterTickets().
                    setTimeout(filterTickets, 50); 
                }
                
            }).fail(function () {
                tbody.html('<tr><td colspan="8" class="text-center py-8 text-red-500"><i class="fas fa-exclamation-triangle mb-2 text-xl"></i><br/>Failed to load tickets</td></tr>');
                $('#paginationControls').empty();
            });
        }

        function renderPagination(totalPages, currentPage) {
            const container = $('#paginationControls');
            if (totalPages <= 1) {
                container.empty();
                return;
            }

            let html = `<div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 mt-4 rounded-xl shadow-sm">
                <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-gray-700">Page <span class="font-medium">${currentPage}</span> of <span class="font-medium">${totalPages}</span></p>
                    </div>
                    <div>
                        <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">`;

            if (currentPage > 1) {
                html += `<button onclick="loadTickets(currentStatusFilter, ${currentPage - 1})" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                            <span class="sr-only">Previous</span>
                            <i class="fas fa-chevron-left h-5 w-5 text-sm"></i>
                        </button>`;
            }

            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, currentPage + 2);
            
            for (let i = startPage; i <= endPage; i++) {
                if (i === currentPage) {
                    html += `<button aria-current="page" class="relative z-10 inline-flex items-center bg-blue-600 px-4 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">${i}</button>`;
                } else {
                    html += `<button onclick="loadTickets(currentStatusFilter, ${i})" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">${i}</button>`;
                }
            }

            if (currentPage < totalPages) {
                html += `<button onclick="loadTickets(currentStatusFilter, ${currentPage + 1})" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                            <span class="sr-only">Next</span>
                            <i class="fas fa-chevron-right h-5 w-5 text-sm"></i>
                        </button>`;
            }

            html += `       </nav>
                    </div>
                </div>
            </div>`;
            
            container.html(html);
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function loadEngineers() {
            const container = $('#engineerList');
            $.ajax({
                url: '@Url.Action("GetDetailedEngineers", "ServiceDesk")',
                type: 'GET',
                success: function (data) {
                    container.empty();
                    if (!data || data.length === 0) {
                        container.append('<div class="text-center text-xs text-gray-500 py-3">No engineers found with ServiceDesk.HandleTickets permission</div>');
                        return;
                    }
                    data.forEach((e, idx) => {
                        let badgeClass = 'bg-green-100 text-green-700';
                        if(e.currentStatus === 'Busy') badgeClass = 'bg-yellow-100 text-yellow-700';
                        if(e.currentStatus === 'Overloaded') badgeClass = 'bg-red-100 text-red-700';
                        
                        let suggestedBadge = idx === 0 ? '<span class="px-1.5 py-0.5 bg-blue-600 text-white rounded text-[10px] ml-2 font-bold uppercase tracking-wider">Suggested</span>' : '';
                        
                        let card = `
                        <div class="eng-card border border-gray-200 rounded p-2 cursor-pointer hover:border-blue-400 hover:bg-blue-50 transition-colors" 
                             data-id="${e.id}" data-name="${e.name}" onclick="selectEngineer(this, '${e.id}', '${e.name}')">
                            <div class="flex justify-between items-start mb-1">
                                <div class="font-medium text-sm text-gray-800">${e.name} ${suggestedBadge}</div>
                                <div class="px-1.5 py-0.5 rounded text-[10px] uppercase font-bold tracking-wider ${badgeClass}">${e.currentStatus}</div>
                            </div>
                            <div class="flex justify-between text-xs text-gray-500">
                                <div>Role: <span class="text-gray-700">${e.role}</span></div>
                                <div>Active: <span class="font-bold text-gray-800">${e.activeTicketCount}</span></div>
                            </div>
                            <div class="flex gap-2 mt-1 text-[10px]">
                                <span class="text-red-500" title="High/Urgent Priority"><i class="fas fa-exclamation-circle text-[9px]"></i> ${e.highPriorityCount}</span>
                                <span class="text-blue-500" title="Avg Resolution Time"><i class="fas fa-clock text-[9px]"></i> ${e.avgResolutionHours}h</span>
                                <span class="text-emerald-500" title="Total Resolved"><i class="fas fa-check text-[9px]"></i> ${e.totalResolved}</span>
                            </div>
                        </div>`;
                        
                        container.append(card);
                    });
                },
                error: function(xhr) {
                    container.html(`<div class="text-center text-xs text-red-500 py-3"><i class="fas fa-exclamation-triangle mr-1"></i> Error: ${xhr.status} ${xhr.statusText}</div>`);
                    console.error('Detailed Engineer Load Error:', xhr);
                }
            });
        }

