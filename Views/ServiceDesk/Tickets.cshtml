        function openResolveModal(ticketId) {
            resolveTicketId = ticketId;
            $('#resolveNotes').val('');
            openModal('resolveModal');
        }

        function submitResolve() {
            const notes = $('#resolveNotes').val().trim();
            
            $.ajax({
                url: '@Url.Action("ResolveTicket", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ticketId: resolveTicketId,
                    username: username,
                    resolutionNotes: notes
                }),
                success: function (res) {
                    if (res && res.success) {
                        sysAlert('Ticket resolved', 'success');
                        closeModal('resolveModal');
                        loadTickets();
                    } else {
                        sysAlert(res.message || 'Failed to resolve', 'error');
                    }
                },
                error: function () {
                    sysAlert('Failed to resolve ticket', 'error');
                }
            });
        }
    </script>
}