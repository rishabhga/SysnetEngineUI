@{
    ViewData["Title"] = "New Service Ticket";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        /* Only what Tailwind can't do inline */
        .field-icon-wrap {
            position: relative;
        }

            .field-icon-wrap > i {
                position: absolute;
                left: 10px;
                top: 50%;
                transform: translateY(-50%);
                color: #cbd5e1;
                font-size: 11px;
                pointer-events: none;
                transition: color .15s;
            }

            .field-icon-wrap:focus-within > i {
                color: #3b82f6;
            }

            .field-icon-wrap input,
            .field-icon-wrap select {
                padding-left: 30px;
            }

        .t-input {
            width: 100%;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            font-size: 13px;
            color: #1e293b;
            transition: all .15s;
            outline: none;
            appearance: none;
        }

            .t-input:hover:not(:focus) {
                border-color: #cbd5e1;
            }

            .t-input:focus {
                border-color: #3b82f6;
                background: #fff;
                box-shadow: 0 0 0 3px rgba(59,130,246,.1);
            }

            .t-input:disabled {
                opacity: .5;
                cursor: not-allowed;
            }

            .t-input::placeholder {
                color: #cbd5e1;
            }

        select.t-input {
            padding-right: 28px;
        }

        .section-card {
            background: #fff;
            border: 1px solid #f1f5f9;
            border-radius: 12px;
            box-shadow: 0 1px 4px rgba(0,0,0,.04);
            overflow: hidden;
            position: relative;
        }

        .btn-submit {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            transition: all .2s;
        }

            .btn-submit:hover:not(:disabled) {
                background: linear-gradient(135deg, #1d4ed8, #1e40af);
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(37,99,235,.3);
            }

            .btn-submit:disabled {
                opacity: .7;
                cursor: not-allowed;
                transform: none !important;
            }

        ::-webkit-scrollbar {
            width: 5px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
    </style>
}

<div class="min-h-screen bg-slate-50 py-5 px-3 sm:px-5 lg:px-8">
    <div class="max-w-5xl mx-auto">

        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
            <div>
                <nav class="flex items-center gap-1.5 text-xs font-medium text-slate-400 mb-1.5">
                    <a href="@Url.Action("Index")" class="hover:text-blue-600 transition-colors">Dashboard</a>
                    <i class="fas fa-chevron-right text-[9px]"></i>
                    <a href="@Url.Action("Tickets")" class="hover:text-blue-600 transition-colors">Tickets</a>
                    <i class="fas fa-chevron-right text-[9px]"></i>
                    <span class="text-slate-600">New Request</span>
                </nav>
                <h1 class="text-xl font-extrabold text-slate-900 tracking-tight">Create Service Request</h1>
                <p class="text-xs text-slate-400 mt-0.5">Fill out the details below to submit a new support ticket.</p>
            </div>

            <div class="inline-flex items-center gap-2 bg-blue-50 border border-blue-100 text-blue-700 px-3 py-1.5 rounded-lg text-xs font-mono font-bold self-start sm:self-auto shadow-sm animate-pulse">
                <i class="fas fa-ticket-alt text-blue-500"></i>
                <span class="tracking-widest">TKT-NEW</span>
            </div>
        </div>

        <form id="createTicketForm" class="flex flex-col lg:flex-row gap-4 items-start">

            <!-- Left Column -->
            <div class="flex-1 w-full space-y-4">

                <!-- Requester -->
                <div class="section-card">
                    <div class="absolute top-0 left-0 w-1 h-full bg-indigo-500 rounded-l-xl"></div>
                    <div class="p-4 pl-5">
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-7 h-7 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-user text-xs"></i>
                            </div>
                            <h2 class="text-sm font-bold text-slate-900">Requester Information</h2>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div class="space-y-1">
                                <label class="block text-xs font-semibold text-slate-500">Full Name <span class="text-rose-500">*</span></label>
                                <div class="field-icon-wrap">
                                    <i class="fas fa-id-badge"></i>
                                    <input type="text" name="requesterName" value="@Context.Session.GetString("username")" required
                                           class="t-input h-9 px-3 font-medium">
                                </div>
                            </div>
                            <div class="space-y-1">
                                <label class="block text-xs font-semibold text-slate-500">Email Address</label>
                                <div class="field-icon-wrap">
                                    <i class="fas fa-envelope"></i>
                                    <input type="email" name="requesterEmail" placeholder="user@company.com"
                                           class="t-input h-9 px-3">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Assignment Hierarchy -->
                <div class="section-card">
                    <div class="absolute top-0 left-0 w-1 h-full bg-blue-500 rounded-l-xl"></div>
                    <div class="p-4 pl-5">
                        <div class="flex items-center justify-between mb-3">
                            <div class="flex items-center gap-2">
                                <div class="w-7 h-7 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0">
                                    <i class="fas fa-sitemap text-xs"></i>
                                </div>
                                <h2 class="text-sm font-bold text-slate-900">Assignment Hierarchy</h2>
                            </div>
                            <span class="text-[9px] font-bold bg-slate-100 text-slate-400 px-2 py-0.5 rounded uppercase tracking-wider">Routing</span>
                        </div>

                        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
                            <div class="space-y-1">
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wide">Company <span class="text-rose-500">*</span></label>
                                <select name="companyId" id="companySelect" required class="t-input h-9 px-3">
                                    <option value="">Select...</option>
                                </select>
                            </div>
                            <div class="space-y-1">
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wide">Group <span class="text-rose-500">*</span></label>
                                <select name="groupId" id="groupSelect" required disabled class="t-input h-9 px-3">
                                    <option value="">Company first</option>
                                </select>
                            </div>
                            <div class="space-y-1">
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wide">Location <span class="text-rose-500">*</span></label>
                                <select name="locationId" id="locationSelect" required disabled class="t-input h-9 px-3">
                                    <option value="">Group first</option>
                                </select>
                            </div>
                            <div class="space-y-1">
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wide">User <span class="text-rose-500">*</span></label>
                                <select name="userId" id="userSelect" required disabled class="t-input h-9 px-3">
                                    <option value="">Location first</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Issue Details -->
                <div class="section-card">
                    <div class="absolute top-0 left-0 w-1 h-full bg-emerald-500 rounded-l-xl"></div>
                    <div class="p-4 pl-5">
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-align-left text-xs"></i>
                            </div>
                            <h2 class="text-sm font-bold text-slate-900">Issue Description</h2>
                        </div>

                        <div class="space-y-3">
                            <div class="space-y-1">
                                <label class="block text-xs font-semibold text-slate-500">Subject / Title <span class="text-rose-500">*</span></label>
                                <input type="text" name="subject" required maxlength="100" placeholder="What is the issue?"
                                       class="t-input h-9 px-3 font-medium">
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div class="space-y-1">
                                    <label class="block text-xs font-semibold text-slate-500">Category <span class="text-rose-500">*</span></label>
                                    <div class="field-icon-wrap">
                                        <i class="fas fa-tags"></i>
                                        <select name="category" id="ticketCategory" required class="t-input h-9 px-3">
                                            <option value="">Select Category...</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="space-y-1">
                                    <label class="block text-xs font-semibold text-slate-500">Priority Level <span class="text-rose-500">*</span></label>
                                    <div class="field-icon-wrap">
                                        <i class="fas fa-flag"></i>
                                        <select name="priority" id="prioritySelect" required class="t-input h-9 px-3 font-medium">
                                            <option value="">Select Priority...</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="space-y-1">
                                <label class="flex justify-between text-xs font-semibold text-slate-500">
                                    <span>Detailed Description <span class="text-rose-500">*</span></span>
                                    <span class="text-[10px] text-slate-300 font-normal">Be as specific as possible</span>
                                </label>
                                <textarea name="description" rows="4" required maxlength="1000"
                                          placeholder="Steps to reproduce, error messages, environment context..."
                                          class="t-input px-3 py-2 resize-none leading-relaxed"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Right Sidebar -->
            <div class="w-full lg:w-64 flex-shrink-0 space-y-3 lg:sticky lg:top-4">

                <!-- Actions Card -->
                <div class="section-card overflow-hidden">
                    <div class="p-4 bg-gradient-to-br from-slate-50 to-white border-b border-slate-100">
                        <p class="text-xs font-bold text-slate-900 mb-0.5">Ready to Submit?</p>
                        <p class="text-[10px] text-slate-400 mb-3">Review all details before submitting.</p>

                        <button type="submit" id="submitBtn"
                                class="btn-submit w-full h-9 rounded-lg text-white text-xs font-bold flex items-center justify-center gap-2 mb-2">
                            <span id="btnText">Submit Ticket</span>
                            <i id="btnIcon" class="fas fa-paper-plane text-[10px]"></i>
                        </button>

                        <a href="@Url.Action("Tickets", "ServiceDesk")"
                           class="w-full h-8 rounded-lg text-slate-500 bg-white border border-slate-200 hover:bg-slate-50 font-medium flex items-center justify-center text-xs transition-colors">
                            Cancel
                        </a>
                    </div>

                    <!-- SLA Preview -->
                    <div class="p-4">
                        <div class="flex items-center gap-2 mb-2">
                            <div class="w-5 h-5 rounded-md bg-white border border-slate-200 flex items-center justify-center shadow-sm">
                                <i class="fas fa-stopwatch text-indigo-500 text-[9px]"></i>
                            </div>
                            <h4 class="text-xs font-bold text-slate-700">SLA Preview</h4>
                        </div>

                        <div id="slaDynamicContainer" class="bg-slate-50 border border-slate-100 rounded-lg p-3 text-center">
                            <i class="fas fa-hand-pointer text-slate-300 text-lg mb-1.5 block"></i>
                            <p class="text-[10px] text-slate-400 font-medium leading-relaxed">Select a priority to see SLA times.</p>
                        </div>
                    </div>
                </div>

                <!-- Tips -->
                <div class="bg-amber-50 border border-amber-100 rounded-xl p-3.5">
                    <h4 class="text-[10px] font-bold text-amber-700 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                        <i class="fas fa-lightbulb text-amber-500"></i> Best Practices
                    </h4>
                    <ul class="space-y-1.5 text-[11px] text-amber-900/70 leading-relaxed">
                        <li class="flex items-start gap-1.5">
                            <i class="fas fa-check mt-0.5 text-amber-400 text-[9px]"></i>
                            <span>Include specific error messages.</span>
                        </li>
                        <li class="flex items-start gap-1.5">
                            <i class="fas fa-check mt-0.5 text-amber-400 text-[9px]"></i>
                            <span>Describe what you were doing when the issue occurred.</span>
                        </li>
                        <li class="flex items-start gap-1.5">
                            <i class="fas fa-check mt-0.5 text-amber-400 text-[9px]"></i>
                            <span>Choose priority based on business impact.</span>
                        </li>
                    </ul>
                </div>

            </div>
        </form>

    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 opacity-0 transition-opacity duration-300">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-xs transform scale-95 transition-transform duration-300" id="successModalContent">
        <div class="p-6 text-center">
            <div class="w-14 h-14 bg-emerald-50 rounded-full flex items-center justify-center mx-auto mb-4 border-4 border-emerald-100">
                <i class="fas fa-check text-xl text-emerald-500"></i>
            </div>
            <h3 class="font-extrabold text-lg text-slate-900 mb-1">Ticket Created!</h3>
            <p class="text-slate-400 text-xs mb-4">Your request has been submitted and assigned to the queue.</p>

            <div class="bg-slate-50 rounded-xl p-3 mb-4 border border-slate-100">
                <div class="text-[9px] text-slate-400 uppercase font-bold tracking-wider mb-1">Ticket Number</div>
                <div class="font-mono text-lg font-black text-slate-800">#<span id="successTicketNo"></span></div>
            </div>

            <button onclick="window.location.href='@Url.Action("Tickets", "ServiceDesk")'"
                    class="w-full h-9 bg-slate-900 hover:bg-slate-800 text-white font-semibold rounded-lg text-xs transition-colors flex items-center justify-center gap-2">
                <span>Go to Tickets</span>
                <i class="fas fa-arrow-right text-[10px] opacity-70"></i>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(() => {
            loadInitialData();

            // Highlight card on field focus
            $('.t-input').on('focus', function() {
                $(this).closest('.section-card').css('border-color', '#bfdbfe');
            }).on('blur', function() {
                $(this).closest('.section-card').css('border-color', '#f1f5f9');
            });

            // Cascading dropdowns
            $('#companySelect').on('change', function() {
                const companyId = $(this).val();
                resetSelect('#groupSelect', 'Select company first...');
                resetSelect('#locationSelect', 'Select group first...');
                resetSelect('#userSelect', 'Select location first...');
                if (companyId) {
                    $('#groupSelect').prop('disabled', false).html('<option value="">Loading groups...</option>');
                    loadGroups(companyId);
                }
            });

            $('#groupSelect').on('change', function() {
                const companyId = $('#companySelect').val();
                const groupId = $(this).val();
                resetSelect('#locationSelect', 'Select group first...');
                resetSelect('#userSelect', 'Select location first...');
                if (groupId) {
                    $('#locationSelect').prop('disabled', false).html('<option value="">Loading locations...</option>');
                    loadLocations(companyId, groupId);
                }
            });

            $('#locationSelect').on('change', function() {
                const companyId = $('#companySelect').val();
                const groupId = $('#groupSelect').val();
                const locationId = $(this).val();
                resetSelect('#userSelect', 'Select location first...');
                if (locationId) {
                    $('#userSelect').prop('disabled', false).html('<option value="">Loading users...</option>');
                    loadUsers(companyId, groupId, locationId);
                }
            });

            $('#userSelect').on('change', function() {
                const userName = $("#userSelect option:selected").text();
                if (userName && !userName.includes("Select") && !userName.includes("Loading") && !userName.includes("No users")) {
                    $('input[name="requesterName"]').val(userName).addClass('ring-2 ring-blue-100');
                    setTimeout(() => $('input[name="requesterName"]').removeClass('ring-2 ring-blue-100'), 500);
                }
            });

            // SLA Preview on priority change
            $('#prioritySelect').on('change', function() {
                const priority = $(this).val();
                const container = $('#slaDynamicContainer');

                if (!priority) {
                    container.html(`
                        <i class="fas fa-hand-pointer text-slate-300 text-lg mb-1.5 block"></i>
                        <p class="text-[10px] text-slate-400 font-medium leading-relaxed">Select a priority to see SLA times.</p>
                    `);
                    return;
                }

                const $selected = $(this).find(':selected');
                const colorCode = $selected.data('color') || '#6B7280';
                const hours = window.slaStore ? (window.slaStore[priority] || 0) : 0;

                container.animate({ opacity: 0 }, 120, function() {
                    $(this).html(`
                        <div class="flex flex-col items-center">
                            <div class="w-10 h-10 rounded-full flex items-center justify-center mb-2 border-2 shadow-sm"
                                 style="background:${colorCode}15; border-color:${colorCode}40; color:${colorCode}">
                                <i class="fas fa-bolt text-sm"></i>
                            </div>
                            <p class="text-xs font-bold text-slate-800 mb-2">${priority} Priority</p>
                            <div class="bg-white border border-slate-100 rounded-lg w-full p-2.5">
                                <div class="text-[9px] uppercase font-bold text-slate-400 tracking-wider mb-0.5">Resolution Target</div>
                                <div class="text-xl font-black flex justify-center items-end gap-1" style="color:${colorCode}">
                                    ${hours}
                                    <span class="text-xs font-semibold mb-0.5 opacity-70 ${hours === 0 ? 'hidden' : ''}">hrs</span>
                                    <span class="text-xs font-semibold text-slate-400 mb-0.5 ${hours !== 0 ? 'hidden' : ''}">No SLA</span>
                                </div>
                            </div>
                        </div>
                    `).animate({ opacity: 1 }, 120);
                });
            });

            // Submit
            $('#createTicketForm').on('submit', function(e) {
                e.preventDefault();
                submitTicket();
            });
        });

        function resetSelect(selector, text) {
            $(selector).prop('disabled', true).html(`<option value="">${text}</option>`);
        }

        function loadInitialData() {
            $.get('@Url.Action("GetCompanies", "ServiceDesk")', companies => {
                const select = $('#companySelect');
                select.html('<option value="">Select Company...</option>');
                if (companies && companies.length > 0)
                    companies.forEach(c => select.append(`<option value="${c.id}">${c.companyName}</option>`));
            });

            $.get('@Url.Action("GetCategories", "ServiceDesk")', categories => {
                const select = $('#ticketCategory');
                select.html('<option value="">Select Category...</option>');
                if (categories && categories.length > 0)
                    categories.forEach(c => select.append(`<option value="${c.categoryName}">${c.categoryName}</option>`));
            });

            $.when(
                $.get('@Url.Action("GetPriorities", "ServiceDesk")'),
                $.get('@Url.Action("GetSLAConfigs", "ServiceDesk")')
            ).done((prioritiesRes, slaRes) => {
                const priorities = prioritiesRes[0];
                const slas = slaRes[0];

                window.slaStore = {};
                if (slas) slas.forEach(s => window.slaStore[s.priority] = s.hours);

                const select = $('#prioritySelect');
                select.html('<option value="">Select Priority...</option>');
                if (priorities && priorities.length > 0) {
                    priorities.forEach(p => {
                        const priName = p.priorityName || p.label || p.value;
                        const colorCode = p.colorCode || p.color || '#6B7280';
                        select.append(`<option value="${priName}" data-color="${colorCode}">${priName}</option>`);
                    });
                }
            });
        }

        function loadGroups(companyId) {
            $.get(`@Url.Action("GetGroups", "ServiceDesk")?companyId=${companyId}`, groups => {
                const select = $('#groupSelect');
                select.html('<option value="">Select Group...</option>');
                groups && groups.length > 0
                    ? groups.forEach(g => select.append(`<option value="${g.id}">${g.groupName}</option>`))
                    : select.html('<option value="">No groups found</option>');
            }).fail(() => resetSelect('#groupSelect', 'Error loading groups'));
        }

        function loadLocations(companyId, groupId) {
            $.get(`@Url.Action("GetLocations", "ServiceDesk")?companyId=${companyId}&groupId=${groupId}`, locations => {
                const select = $('#locationSelect');
                select.html('<option value="">Select Location...</option>');
                locations && locations.length > 0
                    ? locations.forEach(l => select.append(`<option value="${l.id}">${l.locationName}</option>`))
                    : select.html('<option value="">No locations found</option>');
            }).fail(() => resetSelect('#locationSelect', 'Error loading locations'));
        }

        function loadUsers(companyId, groupId, locationId) {
            $.get(`@Url.Action("GetUsersByLocation", "ServiceDesk")?companyId=${companyId}&groupId=${groupId}&locationId=${locationId}`, users => {
                const select = $('#userSelect');
                select.html('<option value="">Select User...</option>');
                users && users.length > 0
                    ? users.forEach(u => select.append(`<option value="${u.domainName}">${u.userName}</option>`))
                    : select.html('<option value="">No users found</option>');
            }).fail(() => resetSelect('#userSelect', 'Error loading users'));
        }

        function submitTicket() {
            const btn = $('#submitBtn');
            const icon = $('#btnIcon');
            const text = $('#btnText');

            btn.prop('disabled', true);
            text.text('Creating...');
            icon.removeClass('fa-paper-plane').addClass('fa-circle-notch fa-spin');
            $('input, select, textarea').prop('disabled', true);

            const payload = {
                requesterName: $('input[name="requesterName"]').val(),
                requesterEmail: $('input[name="requesterEmail"]').val(),
                subject: $('input[name="subject"]').val(),
                category: $('select[name="category"]').val(),
                priority: $('select[name="priority"]').val(),
                companyId: parseInt($('select[name="companyId"]').val()) || null,
                groupId: parseInt($('select[name="groupId"]').val()) || null,
                locationId: parseInt($('select[name="locationId"]').val()) || null,
                clientId: $('select[name="userId"]').val(),
                remark: $('textarea[name="description"]').val()
            };

            $.ajax({
                url: '@Url.Action("SaveTicket", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: (res) => {
                    if (res && res.success) {
                        $('#successTicketNo').text(res.ticketNo || "Created");
                        const modal = $('#successModal');
                        const content = $('#successModalContent');
                        modal.removeClass('hidden');
                        setTimeout(() => {
                            modal.removeClass('opacity-0').addClass('opacity-100');
                            content.removeClass('scale-95').addClass('scale-100');
                        }, 10);
                    } else {
                        resetFormState();
                        sysAlert(res.message || "Failed to create ticket", "error");
                    }
                },
                error: (xhr) => {
                    resetFormState();
                    let msg = "Connection error. Please try again.";
                    if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                    sysAlert(msg, "error");
                }
            });
        }

        function resetFormState() {
            const btn = $('#submitBtn');
            const icon = $('#btnIcon');
            const text = $('#btnText');
            btn.prop('disabled', false);
            text.text('Submit Ticket');
            icon.removeClass('fa-circle-notch fa-spin').addClass('fa-paper-plane');
            $('input, select, textarea').prop('disabled', false);
        }
    </script>
}
