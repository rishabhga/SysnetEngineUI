@{
    ViewData["Title"] = "New Service Ticket";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-gray-50 p-4">
    <div class="max-w-4xl mx-auto">
        <!-- Compact Header -->
        <div class="mb-6">
            <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
                <a href="@Url.Action("Index")" class="hover:text-blue-600">Dashboard</a>
                <span>/</span>
                <a href="@Url.Action("Tickets")" class="hover:text-blue-600">Tickets</a>
                <span>/</span>
                <span class="text-gray-700 font-medium">New Ticket</span>
            </div>
            <div class="flex justify-between items-center">
                <div>
                    <h1 class="text-xl font-bold text-gray-900">New Service Request</h1>
                    <p class="text-gray-600 text-sm mt-0.5">Create a new support ticket</p>
                </div>
                <div class="text-xs text-gray-500 bg-white px-2 py-1 rounded border">
                    <i class="fas fa-hashtag text-blue-500 mr-1"></i>
                    TKT-NEW
                </div>
            </div>
        </div>

        <!-- Compact Form Card -->
        <div class="bg-white rounded-lg border border-gray-200 shadow-sm">
            <form id="createTicketForm" class="p-4 sm:p-6">
                <!-- Requester Info - Compact -->
                <div class="mb-5">
                    <div class="flex items-center gap-2 mb-3">
                        <i class="fas fa-user text-blue-500 text-sm"></i>
                        <h3 class="font-medium text-gray-800 text-sm">Requester Information</h3>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">
                                Full Name <span class="text-red-500">*</span>
                            </label>
                            <input type="text" name="requesterName" value="@Context.Session.GetString("username")" required
                                   class="w-full h-9 text-sm border border-gray-300 rounded px-3 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Email Address</label>
                            <input type="email" name="requesterEmail"
                                   class="w-full h-9 text-sm border border-gray-300 rounded px-3 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none"
                                   placeholder="optional">
                        </div>
                    </div>
                </div>

                <!-- Assignment Hierarchy - Clean Grid -->
                <div class="mb-5">
                    <div class="flex items-center gap-2 mb-3">
                        <i class="fas fa-sitemap text-blue-500 text-sm"></i>
                        <h3 class="font-medium text-gray-800 text-sm">Assignment Hierarchy</h3>
                    </div>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">
                                Company <span class="text-red-500">*</span>
                            </label>
                            <select name="companyId" id="companySelect" required
                                    class="w-full h-9 text-sm border border-gray-300 rounded px-2 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none">
                                <option value="">Select...</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">
                                Group <span class="text-red-500">*</span>
                            </label>
                            <select name="groupId" id="groupSelect" required
                                    class="w-full h-9 text-sm border border-gray-300 rounded px-2 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none">
                                <option value="">Select...</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">
                                Location <span class="text-red-500">*</span>
                            </label>
                            <select name="locationId" id="locationSelect" required
                                    class="w-full h-9 text-sm border border-gray-300 rounded px-2 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none">
                                <option value="">Select...</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">
                                User <span class="text-red-500">*</span>
                            </label>
                            <select name="userId" id="userSelect" required
                                    class="w-full h-9 text-sm border border-gray-300 rounded px-2 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none">
                                <option value="">Select...</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Issue Details - Clean Layout -->
                <div class="mb-5">
                    <div class="flex items-center gap-2 mb-3">
                        <i class="fas fa-info-circle text-blue-500 text-sm"></i>
                        <h3 class="font-medium text-gray-800 text-sm">Issue Details</h3>
                    </div>

                    <div class="mb-3">
                        <label class="block text-xs font-medium text-gray-700 mb-1">
                            Subject <span class="text-red-500">*</span>
                        </label>
                        <input type="text" name="subject" required
                               class="w-full h-9 text-sm border border-gray-300 rounded px-3 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none font-medium"
                               placeholder="Brief description of issue">
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">
                                Category <span class="text-red-500">*</span>
                            </label>
                            <select name="category" id="ticketCategory" required
                                    class="w-full h-9 text-sm border border-gray-300 rounded px-2 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none">
                                <option value="">Select...</option>
                            </select>
                        </div>
                        <div class="relative">
                            <label class="block text-xs font-medium text-gray-700 mb-1">
                                Priority <span class="text-red-500">*</span>
                            </label>
                            <select name="priority" id="prioritySelect" required
                                    class="w-full h-9 text-sm border border-gray-300 rounded px-2 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none">
                                <option value="">Select...</option>
                            </select>
                            <div id="slaPreview" class="absolute right-2 top-7 hidden px-2 py-0.5 rounded text-[10px] font-bold uppercase pointer-events-none">
                                --
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1">
                            Description <span class="text-red-500">*</span>
                        </label>
                        <textarea name="description" rows="3" required
                                  class="w-full text-sm border border-gray-300 rounded px-3 py-2 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none"
                                  placeholder="Describe the issue in detail..."></textarea>
                    </div>
                    
                    <!-- Dynamic SLA/Due Date -->
                    <div class="mt-3 grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">
                                Expected Duration <span class="text-red-500">*</span>
                            </label>
                            <input type="number" name="slaDuration" value="24" min="1" required
                                   class="w-full text-sm border border-gray-300 rounded px-3 py-2 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">
                                Duration Unit
                            </label>
                            <select name="slaUnit" class="w-full text-sm border border-gray-300 rounded px-3 py-2 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none bg-white">
                                <option value="Hours">Hours</option>
                                <option value="Days">Days</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Compact Actions -->
                <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                    <a href="@Url.Action("Index", "ServiceDesk")"
                       class="px-3 py-1.5 text-sm text-gray-600 hover:text-gray-800 font-medium hover:bg-gray-50 rounded border border-gray-200">
                        Cancel
                    </a>
                    <button type="submit" id="submitBtn"
                            class="px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded text-sm flex items-center shadow-sm">
                        <span id="btnText">Submit Request</span>
                        <i id="btnIcon" class="fas fa-paper-plane ml-2 text-xs"></i>
                    </button>
                </div>
            </form>
        </div>

        <!-- Compact SLA Info -->
        <div class="mt-4 p-3 bg-blue-50 border border-blue-100 rounded text-xs text-gray-600">
            <div class="flex items-center gap-2 mb-1">
                <i class="fas fa-clock text-blue-500"></i>
                <span class="font-medium">SLA Response Times:</span>
            </div>
            <div class="grid grid-cols-4 gap-2 text-center">
                <div class="px-2 py-1 bg-white rounded border border-red-200">
                    <div class="text-red-600 font-bold">Urgent</div>
                    <div class="text-[10px] text-gray-500">4 hours</div>
                </div>
                <div class="px-2 py-1 bg-white rounded border border-orange-200">
                    <div class="text-orange-600 font-bold">High</div>
                    <div class="text-[10px] text-gray-500">8 hours</div>
                </div>
                <div class="px-2 py-1 bg-white rounded border border-blue-200">
                    <div class="text-blue-600 font-bold">Medium</div>
                    <div class="text-[10px] text-gray-500">24 hours</div>
                </div>
                <div class="px-2 py-1 bg-white rounded border border-gray-200">
                    <div class="text-gray-600 font-bold">Low</div>
                    <div class="text-[10px] text-gray-500">48 hours</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Compact Success Modal -->
<div id="successModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-lg w-full max-w-xs">
        <div class="p-4 text-center">
            <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-3">
                <i class="fas fa-check text-green-600"></i>
            </div>
            <h3 class="font-bold text-gray-900 mb-1">Request Submitted</h3>
            <p class="text-gray-500 text-sm mb-3">Ticket created successfully</p>
            <div class="bg-gray-50 rounded px-3 py-2 mb-3">
                <span class="font-mono font-bold text-gray-800 text-sm">#<span id="successTicketNo"></span></span>
            </div>
            <button onclick="window.location.href='@Url.Action("Tickets", "ServiceDesk")'"
                    class="w-full py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded text-sm">
                View Tickets
            </button>
        </div>
    </div>
</div>

<!-- Compact Toast -->
<div id="toast-container" class="fixed bottom-3 right-3 z-50 flex flex-col gap-1 max-w-xs"></div>

@section Scripts {
    <script>
        $(document).ready(() => {
            loadInitialData();

            $('#companySelect').on('change', function() {
                const companyId = $(this).val();
                $('#groupSelect').html('<option value="">Select...</option>');
                $('#locationSelect').html('<option value="">Select...</option>');
                $('#userSelect').html('<option value="">Select...</option>');
                loadGroups(companyId);
            });

            $('#groupSelect').on('change', function() {
                const companyId = $('#companySelect').val();
                const groupId = $(this).val();
                $('#locationSelect').html('<option value="">Select...</option>');
                $('#userSelect').html('<option value="">Select...</option>');
                loadLocations(companyId, groupId);
            });

            $('#locationSelect').on('change', function() {
                const companyId = $('#companySelect').val();
                const groupId = $('#groupSelect').val();
                const locationId = $(this).val();
                $('#userSelect').html('<option value="">Select...</option>');
                loadUsers(companyId, groupId, locationId);
            });

            $('#userSelect').on('change', function() {
                const userName = $("#userSelect option:selected").text();
                if (userName && !userName.includes("Select") && !userName.includes("No users")) {
                    $('input[name="requesterName"]').val(userName);
                }
            });

            $('#prioritySelect').on('change', function() {
                const priority = $(this).val();
                const preview = $('#slaPreview');
                const slaMap = {
                    'Urgent': { text: '4h SLA', class: 'bg-red-100 text-red-600 border border-red-200' },
                    'High': { text: '8h SLA', class: 'bg-orange-100 text-orange-600 border border-orange-200' },
                    'Medium': { text: '24h SLA', class: 'bg-blue-100 text-blue-600 border border-blue-200' },
                    'Low': { text: '48h SLA', class: 'bg-gray-100 text-gray-600 border border-gray-200' }
                };

                if (priority) {
                    const meta = slaMap[priority] || slaMap['Medium'];
                    preview.text(meta.text)
                           .attr('class', 'absolute right-2 top-7 px-2 py-0.5 rounded text-[10px] font-bold uppercase pointer-events-none ' + meta.class)
                           .removeClass('hidden');
                } else {
                    preview.addClass('hidden');
                }
            });

            $('#createTicketForm').on('submit', function(e) {
                e.preventDefault();
                submitTicket();
            });
        });

        function loadInitialData() {
            // Load Companies
            $.get('@Url.Action("GetCompanies", "ServiceDesk")', companies => {
                const select = $('#companySelect');
                select.html('<option value="">Select...</option>');
                if (companies && companies.length > 0) {
                   companies.forEach(c => select.append(`<option value="${c.id}">${c.companyName}</option>`));
                }
            });

            // Load Categories
            $.get('@Url.Action("GetCategories", "ServiceDesk")', categories => {
                const select = $('#ticketCategory');
                select.html('<option value="">Select...</option>');
                if (categories && categories.length > 0) {
                    categories.forEach(c => select.append(`<option value="${c.value}">${c.label}</option>`));
                }
            });

            // Load Priorities
            $.get('@Url.Action("GetPriorities", "ServiceDesk")', priorities => {
                const select = $('#prioritySelect');
                select.html('<option value="">Select...</option>');
                if (priorities && priorities.length > 0) {
                    priorities.forEach(p => select.append(`<option value="${p.value}">${p.label}</option>`));
                }
            });
        }

        function loadGroups(companyId) {
            const select = $('#groupSelect');
            select.html('<option value="">Loading...</option>');
            if (!companyId) {
                select.html('<option value="">Select company...</option>');
                return;
            }
            $.get(`@Url.Action("GetGroups", "ServiceDesk")?companyId=${companyId}`, groups => {
                select.html('<option value="">Select...</option>');
                if (groups && groups.length > 0) {
                    groups.forEach(g => select.append(`<option value="${g.id}">${g.groupName}</option>`));
                }
            }).fail(() => select.html('<option value="">Error loading</option>'));
        }

        function loadLocations(companyId, groupId) {
            const select = $('#locationSelect');
            select.html('<option value="">Loading...</option>');
            if (!companyId || !groupId) {
                select.html('<option value="">Select company & group...</option>');
                return;
            }

            let url = `@Url.Action("GetLocations", "ServiceDesk")?companyId=${companyId}`;
            if(groupId) url += `&groupId=${groupId}`;

            $.get(url, locations => {
                select.html('<option value="">Select...</option>');
                if (locations && locations.length > 0) {
                    locations.forEach(l => select.append(`<option value="${l.id}">${l.locationName}</option>`));
                }
            }).fail(() => select.html('<option value="">Error loading</option>'));
        }

        function loadUsers(companyId, groupId, locationId) {
            const select = $('#userSelect');
            select.html('<option value="">Loading...</option>');
            if (!companyId || !groupId || !locationId) {
                select.html('<option value="">Select hierarchy...</option>');
                return;
            }
            $.get(`@Url.Action("GetUsersByLocation", "ServiceDesk")?companyId=${companyId}&groupId=${groupId}&locationId=${locationId}`, users => {
                select.html('<option value="">Select...</option>');
                if (users && users.length > 0) {
                    users.forEach(u => select.append(`<option value="${u.domainName}">${u.userName}</option>`));
                } else {
                    select.html('<option value="">No users found</option>');
                }
            }).fail(() => select.html('<option value="">Error loading</option>'));
        }

        function submitTicket() {
            const btn = $('#submitBtn');
            const icon = $('#btnIcon');
            const text = $('#btnText');

            // Disable button
            btn.prop('disabled', true).addClass('opacity-75 cursor-wait');
            text.text('Processing...');
            icon.removeClass('fa-paper-plane').addClass('fa-circle-notch fa-spin');

            const payload = {
                requesterName: $('input[name="requesterName"]').val(),
                requesterEmail: $('input[name="requesterEmail"]').val(),
                subject: $('input[name="subject"]').val(),
                category: $('select[name="category"]').val(),
                priority: $('select[name="priority"]').val(),
                companyId: parseInt($('select[name="companyId"]').val()) || null,
                groupId: parseInt($('select[name="groupId"]').val()) || null,
                locationId: parseInt($('select[name="locationId"]').val()) || null,
                clientId: $('select[name="userId"]').val(),
                remark: $('textarea[name="description"]').val(),
                slaDuration: parseInt($('input[name="slaDuration"]').val()) || 24,
                slaUnit: $('select[name="slaUnit"]').val()
            };

            $.ajax({
                url: '@Url.Action("SaveTicket", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: (res) => {
                    resetBtn();
                    if (res && res.success) {
                        $('#successTicketNo').text(res.ticketNo || "Created");
                        $('#successModal').removeClass('hidden');
                        setTimeout(() => {
                             window.location.href = '@Url.Action("Tickets", "ServiceDesk")';
                        }, 2000);
                    } else {
                        showToast(res.message || "Failed to create ticket", "error");
                    }
                },
                error: (xhr) => {
                    resetBtn();
                    console.error("Create Ticket Error:", xhr);
                    let msg = "Connection error. Please try again.";
                    if(xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                    showToast(msg, "error");
                }
            });
        }

        function resetBtn() {
            const btn = $('#submitBtn');
            const icon = $('#btnIcon');
            const text = $('#btnText');
            btn.prop('disabled', false).removeClass('opacity-75 cursor-wait');
            text.text('Submit Request');
            icon.removeClass('fa-circle-notch fa-spin').addClass('fa-paper-plane');
        }

        function showToast(message, type = 'info') {
            const colors = {
                success: 'bg-green-500',
                error: 'bg-red-500',
                info: 'bg-blue-500'
            };
            const icon = type === 'success' ? 'fa-check-circle' : (type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle');

            const toastHtml = `
                <div class="${colors[type]} text-white px-3 py-2 rounded shadow flex items-center transform transition-all duration-300 translate-y-10 opacity-0 text-sm" role="alert">
                    <i class="fas ${icon} mr-2 text-xs"></i>
                    <span class="font-medium">${message}</span>
                </div>
            `;

            const $toast = $(toastHtml);
            $('#toast-container').append($toast);

            requestAnimationFrame(() => {
                $toast.removeClass('translate-y-10 opacity-0');
            });

            setTimeout(() => {
                $toast.addClass('translate-y-10 opacity-0');
                setTimeout(() => $toast.remove(), 300);
            }, 3000);
        }
    </script>
}