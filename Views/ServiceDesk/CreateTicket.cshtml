@{
    ViewData["Title"] = "New Service Ticket";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bg-gray-50 min-h-screen p-8">
    <div class="max-w-4xl mx-auto">
        <!-- Breadcrumb & Header -->
        <div class="mb-8">
            <nav class="flex text-sm text-slate-500 mb-2" aria-label="Breadcrumb">
                <ol class="flex items-center space-x-2">
                    <li><a href="@Url.Action("Index")" class="hover:text-blue-600 transition-colors">Service Desk</a></li>
                    <li><span class="text-slate-300">/</span></li>
                    <li><a href="@Url.Action("Tickets")" class="hover:text-blue-600 transition-colors">Tickets</a></li>
                    <li><span class="text-slate-300">/</span></li>
                    <li class="font-medium text-slate-800">New Request</li>
                </ol>
            </nav>
            <h1 class="text-2xl font-bold text-slate-800">Submit a Request</h1>
            <p class="text-slate-500 mt-1">Please provide the details of your issue below.</p>
        </div>

        <!-- Form Card -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="bg-slate-50/50 px-8 py-4 border-b border-slate-100 flex items-center justify-between">
                <span class="font-semibold text-slate-700">Ticket Information</span>
                <span class="text-xs text-slate-400 font-medium uppercase tracking-wider">Form ID: TKT-NEW</span>
            </div>

            <form id="createTicketForm" class="p-8">
                <!-- Section: Requester Info -->
                <div class="mb-8">
                    <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wide mb-4 flex items-center">
                        <i class="fas fa-user-circle text-blue-500 mr-2"></i> Requester Details
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="form-group">
                            <label class="block text-sm font-medium text-slate-700 mb-1">Full Name <span class="text-red-500">*</span></label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                                    <i class="far fa-user"></i>
                                </span>
                                <input type="text" name="requesterName" value="@Context.Session.GetString("username")" required 
                                    class="pl-10 w-full rounded-lg border border-slate-300 bg-slate-50 focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all py-2.5 text-sm shadow-sm" placeholder="John Doe">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="block text-sm font-medium text-slate-700 mb-1">Email (Optional)</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                                    <i class="far fa-envelope"></i>
                                </span>
                                <input type="email" name="requesterEmail" 
                                    class="pl-10 w-full rounded-lg border-slate-300 bg-slate-50 focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all py-2.5 text-sm shadow-sm" placeholder="john@example.com">
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="border-slate-100 mb-8">

                <!-- Section: Hierarchy Details -->
                <div class="mb-8 p-4 bg-slate-50/50 rounded-xl border border-slate-100">
                    <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wide mb-4 flex items-center">
                        <i class="fas fa-sitemap text-blue-500 mr-2"></i> Assignment Hierarchy
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                        <div class="form-group">
                            <label class="block text-sm font-medium text-slate-700 mb-1">Company <span class="text-red-500">*</span></label>
                            <select name="companyId" id="companySelect" required class="w-full rounded-lg border border-slate-300 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all py-2.5 px-3 text-sm shadow-sm">
                                <option value="">Select Company...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="block text-sm font-medium text-slate-700 mb-1">Group <span class="text-red-500">*</span></label>
                            <select name="groupId" id="groupSelect" required class="w-full rounded-lg border border-slate-300 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all py-2.5 px-3 text-sm shadow-sm">
                                <option value="">Select Group...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="block text-sm font-medium text-slate-700 mb-1">Location <span class="text-red-500">*</span></label>
                            <select name="locationId" id="locationSelect" required class="w-full rounded-lg border border-slate-300 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all py-2.5 px-3 text-sm shadow-sm">
                                <option value="">Select Location...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="block text-sm font-medium text-slate-700 mb-1">User <span class="text-red-500">*</span></label>
                            <select name="userId" id="userSelect" required class="w-full rounded-lg border border-slate-300 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all py-2.5 px-3 text-sm shadow-sm">
                                <option value="">Select User...</option>
                            </select>
                        </div>
                    </div>
                </div>

                <hr class="border-slate-100 mb-8">

                <!-- Section: Ticket Details -->
                <div class="mb-6">
                    <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wide mb-4 flex items-center">
                        <i class="fas fa-info-circle text-blue-500 mr-2"></i> Issue Details
                    </h3>
                    
                    <div class="mb-6">
                        <label class="block text-sm font-medium text-slate-700 mb-1">Subject <span class="text-red-500">*</span></label>
                        <input type="text" name="subject" required 
                             class="w-full rounded-lg border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all py-2.5 px-4 text-sm font-medium shadow-sm" placeholder="e.g., Cannot access VPN">
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Category <span class="text-red-500">*</span></label>
                            <select name="category" id="ticketCategory" required class="w-full rounded-lg border border-slate-300 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all py-2.5 px-3 text-sm shadow-sm">
                                <option value="">Select Category...</option>
                            </select>
                        </div>
                        <div class="relative">
                            <label class="block text-sm font-medium text-slate-700 mb-1">Priority <span class="text-red-500">*</span></label>
                            <select name="priority" id="prioritySelect" required class="w-full rounded-lg border border-slate-300 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all py-2.5 px-3 text-sm shadow-sm pr-24">
                                <option value="">Select Priority...</option>
                            </select>
                            <div id="slaPreview" class="absolute right-2 top-[30px] hidden px-2 py-1 rounded text-[10px] font-bold uppercase tracking-wider bg-slate-100 text-slate-500 border border-slate-200 pointer-events-none">
                                SLA: --
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Description <span class="text-red-500">*</span></label>
                        <textarea name="description" rows="6" required 
                            class="w-full rounded-lg border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all py-3 px-4 text-sm shadow-sm" placeholder="Please describe the issue in detail..."></textarea>
                    </div>
                </div>

                <!-- Footer Actions -->
                <div class="flex items-center justify-end pt-6 border-t border-slate-100 gap-4">
                    <a href="@Url.Action("Index", "ServiceDesk")" class="px-5 py-2.5 rounded-lg text-slate-600 font-medium hover:bg-slate-50 border border-transparent hover:border-slate-200 transition-all">Cancel</a>
                    <button type="submit" id="submitBtn" class="px-8 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg shadow-md hover:shadow-lg transform active:scale-95 transition-all flex items-center">
                        <span id="btnText">Submit Request</span>
                        <i id="btnIcon" class="fas fa-paper-plane ml-2"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center backdrop-blur-sm">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm mx-4 transform transition-all scale-100 p-6 text-center">
        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-check text-2xl text-green-600"></i>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">Request Submitted!</h3>
        <p class="text-gray-500 mb-6">Your ticket <span id="successTicketNo" class="font-mono font-bold text-gray-800"></span> has been created successfully.</p>
        <button onclick="window.location.href='@Url.Action("Tickets", "ServiceDesk")'" class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">
            View Tickets
        </button>
    </div>
</div>

<!-- Toast Container -->
<div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2"></div>

@section Scripts {
    <script>
        $(document).ready(() => {
            loadInitialData();

            $('#companySelect').on('change', function() {
                const companyId = $(this).val();
                $('#groupSelect').html('<option value="">Select Group...</option>');
                $('#locationSelect').html('<option value="">Select Location...</option>');
                $('#userSelect').html('<option value="">Select User...</option>');
                loadGroups(companyId);
            });

            $('#groupSelect').on('change', function() {
                const companyId = $('#companySelect').val();
                const groupId = $(this).val();
                $('#locationSelect').html('<option value="">Select Location...</option>');
                $('#userSelect').html('<option value="">Select User...</option>');
                loadLocations(companyId, groupId);
            });

            $('#locationSelect').on('change', function() {
                const companyId = $('#companySelect').val();
                const groupId = $('#groupSelect').val();
                const locationId = $(this).val();
                $('#userSelect').html('<option value="">Select User...</option>');
                loadUsers(companyId, groupId, locationId);
            });

            $('#userSelect').on('change', function() {
                const userName = $("#userSelect option:selected").text();
                // If it's the "Select User..." option or similar, don't update
                if (userName && !userName.includes("Select") && !userName.includes("No users")) {
                    $('input[name="requesterName"]').val(userName);
                }
            });

            $('#prioritySelect').on('change', function() {
                const priority = $(this).val();
                const preview = $('#slaPreview');
                const slaMap = {
                    'Urgent': { text: 'SLA: 4h', class: 'bg-red-100 text-red-600 border-red-200' },
                    'High': { text: 'SLA: 8h', class: 'bg-orange-100 text-orange-600 border-orange-200' },
                    'Medium': { text: 'SLA: 24h', class: 'bg-blue-100 text-blue-600 border-blue-200' },
                    'Low': { text: 'SLA: 48h', class: 'bg-slate-100 text-slate-500 border-slate-200' }
                };
                
                if (priority) {
                    const meta = slaMap[priority] || slaMap['Medium'];
                    preview.text(meta.text)
                           .attr('class', 'absolute right-2 top-[30px] px-2 py-1 rounded text-[10px] font-bold uppercase tracking-wider pointer-events-none ' + meta.class)
                           .removeClass('hidden');
                } else {
                    preview.addClass('hidden');
                }
            });

            $('#createTicketForm').on('submit', function(e) {
                e.preventDefault();
                submitTicket();
            });
        });

        function loadInitialData() {
            // Load Companies
            $.get('@Url.Action("GetCompanies", "ServiceDesk")', companies => {
                const select = $('#companySelect');
                select.html('<option value="">Select Company...</option>');
                if (companies && companies.length > 0) {
                   companies.forEach(c => select.append(`<option value="${c.id}">${c.companyName}</option>`));
                }
            });

            // Load Categories
            $.get('@Url.Action("GetCategories", "ServiceDesk")', categories => {
                const select = $('#ticketCategory');
                select.html('<option value="">Select Category...</option>');
                if (categories && categories.length > 0) {
                    categories.forEach(c => select.append(`<option value="${c.value}">${c.label}</option>`));
                }
            });

            // Load Priorities
            $.get('@Url.Action("GetPriorities", "ServiceDesk")', priorities => {
                const select = $('#prioritySelect');
                select.html('<option value="">Select Priority...</option>');
                if (priorities && priorities.length > 0) {
                    priorities.forEach(p => select.append(`<option value="${p.value}">${p.label}</option>`));
                }
            });
        }

        function loadGroups(companyId) {
            const select = $('#groupSelect');
            select.html('<option value="">Loading...</option>');
            if (!companyId) {
                select.html('<option value="">Select Company first...</option>');
                return;
            }
            $.get(`@Url.Action("GetGroups", "ServiceDesk")?companyId=${companyId}`, groups => {
                select.html('<option value="">Select Group...</option>');
                if (groups && groups.length > 0) {
                    groups.forEach(g => select.append(`<option value="${g.id}">${g.groupName}</option>`));
                }
            }).fail(() => select.html('<option value="">Error loading groups</option>'));
        }

        function loadLocations(companyId, groupId) {
            const select = $('#locationSelect');
            select.html('<option value="">Loading...</option>');
            if (!companyId || !groupId) {
                select.html('<option value="">Select Company & Group first...</option>');
                return;
            }
            
            $.get(`@Url.Action("GetLocations", "ServiceDesk")?companyId=${companyId}&groupId=${groupId}`, locations => {
                select.html('<option value="">Select Location...</option>');
                if (locations && locations.length > 0) {
                    locations.forEach(l => select.append(`<option value="${l.id}">${l.locationName}</option>`));
                }
            }).fail(() => select.html('<option value="">Error loading locations</option>'));
        }

        function loadUsers(companyId, groupId, locationId) {
            const select = $('#userSelect');
            select.html('<option value="">Loading...</option>');
            if (!companyId || !groupId || !locationId) {
                select.html('<option value="">Select Hierarchy first...</option>');
                return;
            }
            $.get(`@Url.Action("GetUsersByLocation", "ServiceDesk")?companyId=${companyId}&groupId=${groupId}&locationId=${locationId}`, users => {
                const select = $('#userSelect');
                select.html('<option value="">Select User...</option>');
                if (users && users.length > 0) {
                    users.forEach(u => select.append(`<option value="${u.domainName}">${u.userName}</option>`));
                } else {
                    select.html('<option value="">No users found</option>');
                }
            }).fail(() => select.html('<option value="">Error loading users</option>'));
        }

        function submitTicket() {
            const btn = $('#submitBtn');
            const icon = $('#btnIcon');
            const text = $('#btnText');

            // Disable button
            btn.prop('disabled', true).addClass('opacity-75 cursor-wait');
            text.text('Processing...');
            icon.removeClass('fa-paper-plane').addClass('fa-circle-notch fa-spin');

            const payload = {
                requesterName: $('input[name="requesterName"]').val(),
                requesterEmail: $('input[name="requesterEmail"]').val(),
                subject: $('input[name="subject"]').val(),
                category: $('select[name="category"]').val(),
                priority: $('select[name="priority"]').val(),
                companyId: parseInt($('select[name="companyId"]').val()) || null,
                groupId: parseInt($('select[name="groupId"]').val()) || null,
                locationId: parseInt($('select[name="locationId"]').val()) || null,
                clientId: $('select[name="userId"]').val(), // Store selected user ID in ClientId
                remark: $('textarea[name="description"]').val()
            };

            $.ajax({
                url: '@Url.Action("SaveTicket", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: (res) => {
                    // Reset Button
                    resetBtn();

                    if (res && res.success) {
                        // Show Success Modal
                        $('#successTicketNo').text(res.ticketNo || "Created");
                        $('#successModal').removeClass('hidden');
                        
                        // Auto redirect after 2s
                        setTimeout(() => {
                             window.location.href = '@Url.Action("Tickets", "ServiceDesk")';
                        }, 2000);
                    } else {
                        showToast(res.message || "Failed to create ticket", "error");
                    }
                },
                error: (xhr) => {
                    resetBtn();
                    console.error("Create Ticket Error:", xhr);
                    let msg = "Connection error. Please try again.";
                    if(xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                    showToast(msg, "error");
                }
            });
        }

        function resetBtn() {
            const btn = $('#submitBtn');
            const icon = $('#btnIcon');
            const text = $('#btnText');
            btn.prop('disabled', false).removeClass('opacity-75 cursor-wait');
            text.text('Submit Request');
            icon.removeClass('fa-circle-notch fa-spin').addClass('fa-paper-plane');
        }

        function showToast(message, type = 'info') {
            const colors = {
                success: 'bg-green-500',
                error: 'bg-red-500',
                info: 'bg-blue-500'
            };
            const icon = type === 'success' ? 'fa-check-circle' : (type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle');
            
            const toastHtml = `
                <div class="${colors[type]} text-white px-6 py-3 rounded-lg shadow-lg flex items-center transform transition-all duration-300 translate-y-10 opacity-0" role="alert">
                    <i class="fas ${icon} mr-3"></i>
                    <span class="font-medium">${message}</span>
                </div>
            `;
            
            const $toast = $(toastHtml);
            $('#toast-container').append($toast);

            // Animate in
            requestAnimationFrame(() => {
                $toast.removeClass('translate-y-10 opacity-0');
            });

            // Remove after 3s
            setTimeout(() => {
                $toast.addClass('translate-y-10 opacity-0');
                setTimeout(() => $toast.remove(), 300);
            }, 3000);
        }
    </script>
}
