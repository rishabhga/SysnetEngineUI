        }
    </script>
    <!-- Include the Parts logic reuse here or in script block above -->
    <script>
        // ... (Include loadParts, submitPart logic) ...
        // Re-implementing simplified version for completeness
         async function loadParts() {
            try {
                const res = await fetch(`/ServiceDesk/GetParts?ticketId=${ticketId}`);
                const parts = await res.json();
                const tbody = document.getElementById('partsTableBody');
                if(!parts || parts.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-slate-400 text-xs italic">No parts added.</td></tr>`;
                    document.getElementById('grandTotal').innerText = "$0.00";
                    return;
                }
                let html = ''; let total = 0;
                parts.forEach(p => {
                    const t = p.quantity * p.unitCost; total += t;
                    html += `<tr>
                        <td class="px-6 py-3 font-medium text-slate-700">${p.partName}</td>
                        <td class="px-6 py-3 text-center">${p.quantity}</td>
                        <td class="px-6 py-3 text-right">$${p.unitCost.toFixed(2)}</td>
                        <td class="px-6 py-3 text-right font-bold">$${t.toFixed(2)}</td>
                        <td class="px-6 py-3 text-center"><button onclick="deletePart(${p.id})" class="text-red-400 hover:text-red-600"><i class="fas fa-trash"></i></button></td>
                    </tr>`;
                });
                tbody.innerHTML = html;
                document.getElementById('grandTotal').innerText = "$" + total.toFixed(2);
            } catch(e) { console.error(e); }
        }
         function openPartModal() {
            const m = document.getElementById('partModal');
            m.classList.remove('hidden');
            setTimeout(() => { m.classList.remove('opacity-0'); document.getElementById('partModalContent').classList.remove('scale-95'); }, 10);
        }
        function closePartModal() {
             const m = document.getElementById('partModal');
             m.classList.add('opacity-0');
             setTimeout(() => m.classList.add('hidden'), 300);
        }
        async function submitPart() {
             const data = {
                ticketId: parseInt(ticketId),
                partName: $('#partName').val(),
                quantity: parseInt($('#partQty').val()),
                unitCost: parseFloat($('#partCost').val())
            };
            if(!data.partName) return;
            await fetch('/ServiceDesk/AddPart', {
                method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(data)
            });
            closePartModal(); loadParts();
        }
         async function deletePart(id) {
             if(confirm("Delete part?")) {
                 await fetch(`/ServiceDesk/DeletePart?id=${id}`, {method: 'DELETE'});
                 loadParts();
             }
        }
    </script>
