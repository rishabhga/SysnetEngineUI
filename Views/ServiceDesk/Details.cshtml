<div id="partModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center transition-all duration-300 opacity-0">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm transform scale-95 transition-all duration-300">
        <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-purple-50 rounded-t-2xl">
            <h3 class="text-lg font-bold text-purple-800">Add Spare Part</h3>
            <button onclick="closeModal('partModal')" class="text-slate-400 hover:text-slate-600"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-6 space-y-4">
            <div class="form-group">
                <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Hardware / Part Name</label>
                <input type="text" id="partName" class="w-full border border-slate-200 p-2.5 rounded-lg focus:ring-2 focus:ring-purple-100 outline-none" placeholder="e.g. SSD 256GB">
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div class="form-group">
                    <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Quantity</label>
                    <input type="number" id="partQty" class="w-full border border-slate-200 p-2.5 rounded-lg focus:ring-2 focus:ring-purple-100 outline-none" value="1">
                </div>
                <div class="form-group">
                    <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Unit Cost</label>
                    <input type="number" id="partCost" class="w-full border border-slate-200 p-2.5 rounded-lg focus:ring-2 focus:ring-purple-100 outline-none" placeholder="0.00" step="0.01">
                </div>
            </div>
            <button onclick="submitPart()" class="w-full py-3 bg-purple-600 hover:bg-purple-700 text-white rounded-xl font-bold transition-all shadow-lg shadow-purple-200">Add to Part Log</button>
        </div>
    </div>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 5px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    .active-tab { border-bottom-color: #3b82f6; color: #2563eb; background-color: white; }
    
    /* Animation for chat bubbles */
    .chat-bubble { animation: fadeIn 0.3s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

@section Scripts {
    <script>
        const ticketId = @Model.Id;
        const currentStatus = "@Model.Status";
        const currentPriority = "@Model.Priority";
        const currentUser = "@username";
        
        $(document).ready(function() {
            initUI();
            loadParts();
            loadComments();
            loadLogs();
            loadAttachments();
            renderActionButtons();
            
            updateSLAProgress();
            setInterval(updateSLAProgress, 60000); // Update every minute

            // Refresh periodic
            setInterval(() => {
                if($('#tab-comments').is(':visible')) loadComments(true);
            }, 10000);
        });

        function updateSLAProgress() {
            const created = new Date("@Model.CreatedOn?.ToString("yyyy-MM-ddTHH:mm:ss")");
            const due = new Date("@Model.DueDate?.ToString("yyyy-MM-ddTHH:mm:ss")");
            const now = new Date();
            
            if (!created || !due) return;
            
            const total = due - created;
            const elapsed = now - created;
            let percent = Math.min(Math.max((elapsed / total) * 100, 0), 100);
            
            const bar = $('#slaProgressBar');
            const txt = $('#slaPercentText');
            
            bar.css('width', percent + '%');
            
            if (now > due) {
                txt.text('BREACHED').addClass('text-red-600').removeClass('text-blue-600');
                bar.addClass('bg-red-500').removeClass('bg-blue-500');
            } else {
                txt.text(Math.round(percent) + '% Elapsed');
                if (percent > 80) bar.addClass('bg-orange-500').removeClass('bg-blue-500');
            }
        }

        function initUI() {
            // Priority Color
            const p = currentPriority.toLowerCase();
            let colorClass = 'bg-sky-500';
            if (p.includes('urgent') || p.includes('high')) colorClass = 'bg-red-500';
            else if (p.includes('med')) colorClass = 'bg-orange-500';
            
            $('#priorityStripe').addClass(colorClass);
            $('#priorityIcon').addClass(colorClass.replace('bg-', 'text-'));
            
            // Status Badge Color
            const s = currentStatus.toLowerCase();
            const badge = $('#headerStatusBadge');
            if(s === 'open') badge.addClass('bg-red-100 text-red-600');
            else if(s === 'resolved' || s === 'closed') badge.addClass('bg-emerald-100 text-emerald-600');
            else if(s === 'rejected') badge.addClass('bg-slate-200 text-slate-700');
            else badge.addClass('bg-blue-100 text-blue-600');
        }

        // ================= TABS =================
        function switchTab(tabName) {
            $('.tab-content').addClass('hidden');
            $(`#tab-${tabName}`).removeClass('hidden');
            
            $('.tab-btn').removeClass('active-tab');
            $(`button[data-target="${tabName}"]`).addClass('active-tab');
        }

        // ================= ACTIONS = [MODAL LOGIC] =================
        function openModal(id) {
            const m = $(`#${id}`);
            m.removeClass('hidden');
            setTimeout(() => m.removeClass('opacity-0').find('>div').removeClass('scale-95'), 10);
            if(id === 'assignModal') loadEngineers();
        }

        function closeModal(id) {
            const m = $(`#${id}`);
            m.addClass('opacity-0').find('>div').addClass('scale-95');
            setTimeout(() => m.addClass('hidden'), 300);
        }

        function renderActionButtons() {
            const container = $('#actionButtons');
            container.empty();
            
            if(currentStatus === 'Open') {
                container.append(`<button onclick="openModal('approveModal')" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-bold rounded-xl shadow-lg shadow-green-200 transition-all flex items-center gap-2"><i class="fas fa-check"></i> Approve</button>`);
                container.append(`<button onclick="openModal('rejectModal')" class="px-4 py-2 bg-white border border-red-200 text-red-600 hover:bg-red-50 font-bold rounded-xl transition-all"><i class="fas fa-times"></i> Reject</button>`);
            }
            
            if(currentStatus === 'Approved' || currentStatus === 'Open') {
                 container.append(`<button onclick="openModal('assignModal')" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg shadow-blue-200 transition-all flex items-center gap-2"><i class="fas fa-user-tag"></i> Assign</button>`);
            }
            
            if(['Assigned', 'InProgress', 'Approved'].includes(currentStatus)) {
                container.append(`<button onclick="submitStatusAction('Resolved')" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl shadow-lg shadow-emerald-200 transition-all flex items-center gap-2"><i class="fas fa-check-circle"></i> Resolve</button>`);
            }
        }
        
        function submitStatusAction(newStatus) {
            let remarks = "";
            if(newStatus === 'Approved') remarks = $('#approveRemarks').val() || "Approved via portal";
            else if(newStatus === 'Rejected') {
                remarks = $('#rejectRemarks').val();
                if(!remarks) { alert("Please provide rejection reason"); return; }
            } else {
                if(!confirm(`Update status to ${newStatus}?`)) return;
                remarks = `Status updated to ${newStatus}`;
            }

            $.ajax({
                url: '@Url.Action("UpdateStatus", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ ticketId: ticketId, newStatus: newStatus, remarks: remarks, username: currentUser }),
                success: function(res) {
                    if(res.success) location.reload();
                    else alert(res.message);
                }
            });
        }

        function loadEngineers() {
            $.get('@Url.Action("GetEngineers", "ServiceDesk")', function(data) {
                const select = $('#engineerSelect');
                select.empty().append('<option value="">Select an Engineer</option>');
                data.forEach(e => {
                    select.append(`<option value="${e.id}" data-name="${e.name}">${e.name} (${e.specialty}) - ${e.currentStatus}</option>`);
                });
            });
        }

        function submitAssignAction() {
            const engId = $('#engineerSelect').val();
            const engName = $('#engineerSelect option:selected').data('name');
            const notes = $('#assignNotes').val();
            
            if(!engId) { alert("Please select an engineer"); return; }
            
            $.ajax({
                url: '@Url.Action("AssignTicket", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ 
                    ticketId: ticketId, 
                    engineerId: engId, 
                    engineerName: engName, 
                    assignedBy: currentUser,
                    notes: notes 
                }),
                success: function(res) {
                    if(res.success) location.reload();
                    else alert(res.message);
                }
            });
        }

        // ================= COMMENTS =================
        function loadComments(silent = false) {
            $.get(`@Url.Action("GetComments", "ServiceDesk")?ticketId=${ticketId}`, function(data) {
                const list = $('#commentsList');
                if(!silent) list.empty();
                
                // If silent update, sophisticated logic needed to append only new. 
                // For MVP, just replace innerHTML or check count. 
                // Let's replace for now to ensure consistency.
                let html = '';
                if(!data || data.length === 0) {
                    html = '<div class="text-center text-slate-400 py-10 italic">No comments yet. Start the conversation!</div>';
                } else {
                    data.sort((a,b) => new Date(a.createdOn) - new Date(b.createdOn)); // Ascending
                    data.forEach(c => {
                        const isMe = c.userName === currentUser;
                        const initial = c.userName ? c.userName.charAt(0).toUpperCase() : '?';
                        const time = new Date(c.createdOn).toLocaleString([], {month:'short', day:'numeric', hour:'2-digit', minute:'2-digit'});
                        
                        html += `
                            <div class="flex gap-3 mb-4 chat-bubble ${isMe ? 'flex-row-reverse' : ''}">
                                <div class="w-8 h-8 rounded-full flex-shrink-0 flex items-center justify-center text-xs font-bold ${isMe ? 'bg-blue-100 text-blue-600' : 'bg-slate-200 text-slate-600'}">
                                    ${initial}
                                </div>
                                <div class="flex flex-col max-w-[80%] ${isMe ? 'items-end' : 'items-start'}">
                                    <div class="px-4 py-2 rounded-2xl shadow-sm text-sm ${isMe ? 'bg-blue-600 text-white rounded-tr-none' : 'bg-white border border-slate-200 text-slate-700 rounded-tl-none'}">
                                        ${c.comment}
                                    </div>
                                    <span class="text-[10px] text-slate-400 mt-1 px-1">${time}</span>
                                </div>
                            </div>
                        `;
                    });
                }
                
                // Only update if changed (simple check usually by length or ID, skipping for complexity)
                if(list.html() !== html) {
                    list.html(html);
                    list.scrollTop(list[0].scrollHeight);
                }
            });
        }

        function submitComment() {
            const txt = $('#commentInput').val().trim();
            if(!txt) return;
            
            $.ajax({
                url: '@Url.Action("AddComment", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ ticketId: ticketId, comment: txt, userName: currentUser, userId: "@userId" }),
                success: function(res) {
                    if(res.success) {
                        $('#commentInput').val('');
                        loadComments();
                    } else alert("Failed to post comment");
                },
                error: function(e) { console.error(e); alert("Error posting comment"); }
            });
        }

        // ================= LOGS =================
        function loadLogs() {
             $.get(`@Url.Action("GetLogs", "ServiceDesk")?ticketId=${ticketId}`, function(data) {
                 const list = $('#activityList');
                 list.empty();
                 if(!data || data.length === 0) list.html('<div class="text-slate-400 italic">No activity yet.</div>');
                 else {
                     data.forEach(l => {
                         const time = new Date(l.createdOn).toLocaleString();
                         list.append(`
                            <div class="relative pb-2 pl-4">
                                <span class="absolute -left-[23px] top-1 w-3 h-3 rounded-full bg-slate-300 border-2 border-white ring-1 ring-slate-100"></span>
                                <p class="text-xs text-slate-400 font-bold uppercase mb-1">${time}</p>
                                <p class="text-sm font-medium text-slate-800">${l.remarks || 'Status Changed'}</p>
                                <div class="flex items-center gap-2 text-xs text-slate-500 mt-1">
                                    <span class="px-2 py-0.5 bg-slate-100 rounded text-[10px] font-mono">${l.oldStatus}</span>
                                    <i class="fas fa-arrow-right text-[10px]"></i>
                                    <span class="px-2 py-0.5 bg-slate-100 rounded text-[10px] font-mono font-bold">${l.newStatus}</span>
                                    <span class="ml-2">by ${l.from}</span>
                                </div>
                            </div>
                         `);
                     });
                 }
             });
        }

        // ================= FILES =================
        function loadAttachments() {
            $.get(`@Url.Action("GetAttachments", "ServiceDesk")?ticketId=${ticketId}`, function(data) {
                 const list = $('#attachmentsList');
                 list.empty();
                 if(!data || data.length === 0) return; // Empty state handled by default
                 
                 data.forEach(f => {
                     const date = new Date(f.uploadedOn).toLocaleDateString();
                     const icon = f.fileType.includes('image') ? 'fa-file-image text-purple-500' : 'fa-file-alt text-blue-500';
                     list.append(`
                        <div class="flex items-center justify-between p-3 bg-white border border-slate-200 rounded-xl hover:shadow-md transition-shadow group">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-lg bg-slate-50 flex items-center justify-center text-lg">
                                    <i class="far ${icon}"></i>
                                </div>
                                <div class="overflow-hidden">
                                    <p class="text-sm font-medium text-slate-800 truncate w-32 md:w-48" title="${f.fileName}">${f.fileName}</p>
                                    <p class="text-xs text-slate-500">${(f.fileSize/1024).toFixed(1)} KB • ${date} • ${f.uploadedBy}</p>
                                </div>
                            </div>
                            <a href="${f.filePath}" target="_blank" class="p-2 text-slate-400 hover:text-blue-600 transition-colors" title="Download">
                                <i class="fas fa-download"></i>
                            </a>
                        </div>
                     `);
                 });
            });
        }

        function uploadFile(input) {
            if(input.files && input.files[0]) {
                const file = input.files[0];
                const formData = new FormData();
                formData.append('file', file);
                
                // Show loading placeholder
                $('#attachmentsList').prepend(`<div id="uploading" class="p-3 text-center text-sm text-blue-500"><i class="fas fa-spinner fa-spin mr-2"></i>Uploading...</div>`);

                $.ajax({
                    url: `@Url.Action("AddAttachment", "ServiceDesk")?ticketId=${ticketId}`,
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(res) {
                        $('#uploading').remove();
                        if(res.success) {
                            loadAttachments();
                        } else alert("Upload failed: " + res.message);
                    },
                    error: function() { $('#uploading').remove(); alert("Error uploading file"); }
                });
            }
        }

