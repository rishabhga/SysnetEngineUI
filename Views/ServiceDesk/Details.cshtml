            <div class="flex gap-3 pt-2">
                <button onclick="closeModal('rejectModal')" class="flex-1 py-2.5 bg-slate-100 text-slate-600 rounded-lg font-bold">Cancel</button>
                <button onclick="submitStatusAction('Rejected')" class="flex-1 py-2.5 bg-red-600 text-white rounded-lg font-bold shadow-lg shadow-red-200">Confirm Reject</button>
            </div>
        </div>
    </div>
</div>

