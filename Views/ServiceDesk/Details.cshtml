            <button onclick="closeModal('assignModal')" class="text-slate-400 hover:text-blue-400"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-6 space-y-4">
            <div class="p-3 bg-blue-50 border border-blue-100 rounded-xl mb-2 flex items-center gap-3">
                <i class="fas fa-info-circle text-blue-500 text-xl"></i>
                <p class="text-xs text-blue-800 font-medium">Selecting an engineer will notify them and change the ticket status to <span class="font-bold">Assigned</span>.</p>
