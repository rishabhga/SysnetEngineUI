@model ManageEngineWebApp.Models.HelpdeskTicket
@{
    ViewData["Title"] = "Ticket Details - " + Model.TicketNo;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var username = Context.Session.GetString("username") ?? "User";
    var userId = Context.Session.GetString("userId") ?? "0";
    var canApprove = ViewBag.CanApprove ?? false;
    var canAssign = ViewBag.CanAssign ?? false;
    var canDelete = ViewBag.CanDelete ?? false;
}

<div class="min-h-screen bg-gray-50 p-4">
    <!-- Sticky Header -->
    <div class="sticky top-[108px] z-30 bg-white border-b border-gray-200 px-4 py-2.5 flex justify-between items-center mb-4">
        <div class="flex items-center gap-3">
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-lg font-bold text-gray-900">@Model.TicketNo</h1>
                    <span id="headerStatusBadge" class="px-2 py-0.5 text-xs rounded font-medium uppercase">@Model.Status</span>
                </div>
                <p class="text-sm text-gray-600 truncate max-w-md">@Model.Subject</p>
            </div>
        </div>
        <div class="flex items-center gap-2" id="actionButtons">
            <!-- Populated by JS -->
        </div>
    </div>

    <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <!-- Left Column: Main Info -->
            <div class="lg:col-span-2 space-y-4">
                <!-- Main Ticket Card -->
                <div class="bg-white rounded border border-gray-200">
                    <!-- Priority Stripe -->
                    <div class="h-1 w-full" id="priorityStripe"></div>

                    <div class="p-4">
                        <!-- Requester Info -->
                        <div class="flex items-center gap-3 mb-4">
                            <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold">
                                @(Model.RequesterName?.Substring(0, 1) ?? "U")
                            </div>
                            <div>
                                <h2 class="font-bold text-gray-900">@Model.RequesterName</h2>
                                <p class="text-sm text-gray-600">@Model.RequesterEmail</p>
                                <div class="flex gap-1 mt-1">
                                    <span class="px-1.5 py-0.5 bg-gray-100 text-gray-600 text-[10px] font-medium rounded uppercase">Requester</span>
                                    @if (Model.ClientId != null)
                                    {
                                        <span class="px-1.5 py-0.5 bg-blue-50 text-blue-600 text-[10px] font-medium rounded uppercase">Portal User</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Quick Stats -->
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
                            <div class="p-2.5 bg-gray-50 rounded border border-gray-100">
                                <div class="text-xs text-gray-500 mb-1">Priority</div>
                                <div class="font-bold text-gray-800 flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full" id="priorityDot"></span>
                                    @Model.Priority
                                </div>
                            </div>
                            <div class="p-2.5 bg-gray-50 rounded border border-gray-100">
                                <div class="text-xs text-gray-500 mb-1">Category</div>
                                <div class="font-bold text-gray-800">@Model.Category</div>
                            </div>
                            <div class="p-2.5 bg-gray-50 rounded border border-gray-100">
                                <div class="text-xs text-gray-500 mb-1">Engineer</div>
                                <div class="font-bold text-gray-800">
                                    @if (!string.IsNullOrEmpty(Model.AssignedToName))
                                    {
                                        <span>@Model.AssignedToName</span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400 text-sm">Unassigned</span>
                                    }
                                </div>
                            </div>
                            <div class="p-2.5 bg-gray-50 rounded border border-gray-100">
                                <div class="text-xs text-gray-500 mb-1">Status</div>
                                <div class="font-bold text-gray-800 flex items-center gap-1.5">
                                    <i class="fas fa-circle text-xs" id="statusDot"></i>
                                    @Model.Status
                                </div>
                            </div>
                        </div>

                        <!-- Hierarchy Info -->
                        <div class="p-3 bg-gray-50 rounded border border-gray-100 mb-4">
                            <div class="text-xs text-gray-500 mb-2 font-medium">ASSIGNMENT HIERARCHY</div>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                                <div>
                                    <div class="text-xs text-gray-500">Company</div>
                                    <div class="text-sm font-medium text-gray-800">@(Model.CompanyName ?? "N/A")</div>
                                </div>
                                <div>
                                    <div class="text-xs text-gray-500">Location</div>
                                    <div class="text-sm font-medium text-gray-800">@(Model.LocationName ?? "N/A")</div>
                                </div>
                                <div>
                                    <div class="text-xs text-gray-500">Group</div>
                                    <div class="text-sm font-medium text-gray-800">@(Model.GroupName ?? "N/A")</div>
                                </div>
                            </div>
                        </div>

                        <!-- Issue Description -->
                        <div>
                            <div class="text-xs text-gray-500 mb-2 font-medium">ISSUE DESCRIPTION</div>
                            <div class="p-3 bg-gray-50 rounded border border-gray-100">
                                <p class="text-gray-700 text-sm whitespace-pre-wrap">@Model.Remark</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Parts Section -->
                <div class="bg-white rounded border border-gray-200">
                    <div class="px-4 py-2.5 border-b border-gray-100 flex justify-between items-center">
                        <h3 class="font-medium text-gray-800 text-sm">Spare Parts / Hardware</h3>
                        <button onclick="openPartModal()" class="text-xs px-2 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded transition-colors">
                            <i class="fas fa-plus mr-1"></i> Add Part
                        </button>
                    </div>
                    <div class="p-3">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="text-xs text-gray-500 border-b border-gray-100">
                                    <th class="pb-2 font-medium text-left">Part Name</th>
                                    <th class="pb-2 font-medium text-center">Qty</th>
                                    <th class="pb-2 font-medium text-right">Cost</th>
                                    <th class="pb-2 font-medium text-right">Total</th>
                                    <th class="pb-2 font-medium text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody id="partsTableBody">
                                <!-- Populated by JS -->
                            </tbody>
                            <tfoot>
                                <tr class="border-t border-gray-100">
                                    <td colspan="3" class="pt-2 text-right text-xs text-gray-500">Grand Total:</td>
                                    <td id="grandTotal" class="pt-2 text-right font-bold text-gray-800">₹0.00</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right Column: Activity & Comments -->
            <div class="space-y-4">
                <!-- Activity Tabs -->
                <div class="bg-white rounded border border-gray-200">
                    <div class="flex border-b border-gray-200">
                        <button onclick="switchTab('comments')" class="flex-1 py-2 text-xs font-medium text-gray-600 hover:text-blue-600 border-b-2 border-transparent hover:border-blue-300 transition-colors tab-btn active-tab" data-target="comments">
                            <i class="far fa-comments mr-1"></i> Chat
                        </button>
                        <button onclick="switchTab('activity')" class="flex-1 py-2 text-xs font-medium text-gray-600 hover:text-blue-600 border-b-2 border-transparent hover:border-blue-300 transition-colors tab-btn" data-target="activity">
                            <i class="fas fa-history mr-1"></i> Log
                        </button>
                        <button onclick="switchTab('files')" class="flex-1 py-2 text-xs font-medium text-gray-600 hover:text-blue-600 border-b-2 border-transparent hover:border-blue-300 transition-colors tab-btn" data-target="files">
                            <i class="fas fa-paperclip mr-1"></i> Files
                        </button>

                    </div>

                    <!-- Comments Tab -->
                    <div id="tab-comments" class="tab-content p-3">
                        <div id="commentsList" class="space-y-3 max-h-80 overflow-y-auto pr-2 mb-3">
                            <!-- Loaded via JS -->
                        </div>
                        <div class="border-t border-gray-100 pt-3">
                            <div class="relative">
                                <textarea id="commentInput" rows="2" class="w-full text-sm border border-gray-300 rounded px-3 py-2 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" placeholder="Type a message..."></textarea>
                                <button onclick="submitComment()" class="absolute right-1.5 bottom-1.5 p-1.5 bg-blue-600 text-white rounded hover:bg-blue-700">
                                    <i class="fas fa-paper-plane text-xs"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Activity Tab -->
                    <div id="tab-activity" class="tab-content hidden p-3">
                        <div class="space-y-3 max-h-96 overflow-y-auto pr-2" id="activityList">
                            <!-- Loaded via JS -->
                        </div>
                    </div>

                    <!-- Files Tab -->
                    <div id="tab-files" class="tab-content hidden p-3">
                        <div class="mb-3 p-3 border-2 border-dashed border-gray-300 rounded text-center hover:bg-gray-50 cursor-pointer" onclick="document.getElementById('fileUpload').click()">
                            <i class="fas fa-cloud-upload-alt text-gray-400 mb-1"></i>
                            <p class="text-xs text-gray-600">Click to upload file</p>
                            <p class="text-[10px] text-gray-400 mt-0.5">Max 10MB • Supported: images, documents, archives</p>
                            <input type="file" id="fileUpload" class="hidden" onchange="uploadFile(this)" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.zip,.rar,.7z,.png,.jpg,.jpeg,.gif,.bmp,.svg,.webp">
                        </div>
                        <div class="space-y-2 max-h-80 overflow-y-auto pr-2" id="attachmentsList">
                            <!-- Loaded via JS -->
                        </div>
                    </div>


                </div>

                <!-- SLA Progress -->
                <div class="bg-white rounded border border-gray-200 p-3">
                    <div class="flex justify-between items-center mb-2">
                        <div class="text-xs font-medium text-gray-700">SLA Resolution</div>
                        <span id="slaPercentText" class="text-xs font-medium">Calculating...</span>
                    </div>
                    <div class="w-full h-1.5 bg-gray-200 rounded-full overflow-hidden mb-1">
                        <div id="slaProgressBar" class="h-full transition-all duration-1000" style="width: 0%"></div>
                    </div>
                    <div class="flex justify-between text-[10px] text-gray-500">
                        <span>Created: @Model.CreatedOn?.ToString("dd MMM HH:mm")</span>
                        <span>Deadline: @(Model.DueDate?.ToString("dd MMM HH:mm") ?? "No SLA")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Compact Modals -->
<div id="approveModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded w-full max-w-xs">
        <div class="p-3 border-b border-gray-200 flex justify-between items-center">
            <h3 class="font-bold text-gray-800 text-sm">Approve Ticket</h3>
            <button onclick="closeModal('approveModal')" class="text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-3">
            <label class="block text-xs text-gray-700 mb-2">Approval Remarks</label>
            <textarea id="approveRemarks" class="w-full text-sm border border-gray-300 rounded p-2 mb-3" rows="2" placeholder="Enter comments..."></textarea>
            <div class="flex gap-2">
                <button onclick="closeModal('approveModal')" class="flex-1 py-1.5 text-sm text-gray-600 font-medium">Cancel</button>
                <button onclick="submitStatusAction('Approved')" class="flex-1 py-1.5 bg-green-600 text-white text-sm font-medium rounded">Confirm</button>
            </div>
        </div>
    </div>
</div>

<div id="rejectModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded w-full max-w-xs">
        <div class="p-3 border-b border-red-100 bg-red-50 flex justify-between items-center">
            <h3 class="font-bold text-red-800 text-sm">Reject Ticket</h3>
            <button onclick="closeModal('rejectModal')" class="text-gray-400 hover:text-red-400">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-3">
            <label class="block text-xs text-gray-700 mb-2">Reason for Rejection</label>
            <textarea id="rejectRemarks" class="w-full text-sm border border-gray-300 rounded p-2 mb-3" rows="2" placeholder="Explain why..."></textarea>
            <div class="flex gap-2">
                <button onclick="closeModal('rejectModal')" class="flex-1 py-1.5 text-sm text-gray-600 font-medium">Cancel</button>
                <button onclick="submitStatusAction('Rejected')" class="flex-1 py-1.5 bg-red-600 text-white text-sm font-medium rounded">Reject</button>
            </div>
        </div>
    </div>
</div>

<div id="assignModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded w-full max-w-xs">
        <div class="p-3 border-b border-blue-100 bg-blue-50 flex justify-between items-center">
            <h3 class="font-bold text-blue-800 text-sm">Assign Engineer</h3>
            <button onclick="closeModal('assignModal')" class="text-gray-400 hover:text-blue-400">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-3">
            <label class="block text-xs text-gray-700 mb-2">Select Engineer</label>
            <input type="hidden" id="selectedEngineerId" />
            <input type="hidden" id="selectedEngineerName" />
            <div id="engineerList" class="max-h-64 overflow-y-auto space-y-2 mb-3 bg-white border border-gray-200 rounded p-2">
                <div class="text-center text-xs text-gray-500 py-3">Loading engineers...</div>
            </div>
            <label class="block text-xs text-gray-700 mb-2">Assignment Notes</label>
            <textarea id="assignNotes" class="w-full text-sm border border-gray-300 rounded p-2 mb-3" rows="2" placeholder="Tasks for engineer..."></textarea>
            <div class="flex gap-2">
                <button onclick="closeModal('assignModal')" class="flex-1 py-1.5 text-sm text-gray-600 font-medium">Cancel</button>
                <button onclick="submitAssignAction()" class="flex-1 py-1.5 bg-blue-600 text-white text-sm font-medium rounded">Assign</button>
            </div>
        </div>
    </div>
</div>

<div id="partModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded w-full max-w-xs">
        <div class="p-3 border-b border-purple-100 bg-purple-50 flex justify-between items-center">
            <h3 class="font-bold text-purple-800 text-sm">Add Spare Part</h3>
            <button onclick="closeModal('partModal')" class="text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-3">
            <div class="mb-2">
                <label class="block text-xs text-gray-700 mb-1">Part Name</label>
                <input type="text" id="partName" list="masterPartsList" class="w-full text-sm border border-gray-300 rounded p-1.5" autocomplete="off" onchange="onPartSelect(this)">
                <datalist id="masterPartsList"></datalist>
            </div>
            <div class="grid grid-cols-2 gap-2 mb-3">
                <div>
                    <label class="block text-xs text-gray-700 mb-1">Quantity</label>
                    <input type="number" id="partQty" class="w-full text-sm border border-gray-300 rounded p-1.5" value="1">
                </div>
                <div>
                    <label class="block text-xs text-gray-700 mb-1">Unit Cost</label>
                    <input type="number" id="partCost" class="w-full text-sm border border-gray-300 rounded p-1.5" placeholder="0.00" step="0.01">
                </div>
            </div>
            <button onclick="submitPart()" class="w-full py-1.5 bg-purple-600 text-white text-sm font-medium rounded">Add to Parts</button>
        </div>
    </div>
</div>

<!-- Resolve Modal -->
<div id="resolveModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded w-full max-w-sm">
        <div class="p-3 border-b border-emerald-100 bg-emerald-50 flex justify-between items-center">
            <h3 class="font-bold text-emerald-800 text-sm"><i class="fas fa-check-circle mr-2"></i>Resolve Ticket</h3>
            <button onclick="closeModal('resolveModal')" class="text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-3">
            <div class="mb-3">
                <label class="block text-xs text-gray-700 mb-1">Resolution Notes</label>
                <textarea id="resolveNotes" class="w-full text-sm border border-gray-300 rounded p-2" rows="4" 
                    placeholder="Describe what was done to resolve this ticket..."></textarea>
            </div>
            <div class="flex gap-2">
                <button onclick="closeModal('resolveModal')" class="flex-1 py-1.5 text-sm text-gray-600 font-medium">Cancel</button>
                <button onclick="submitResolve()" class="flex-1 py-1.5 bg-emerald-600 text-white text-sm font-medium rounded">
                    <i class="fas fa-check mr-1"></i> Mark Resolved
                </button>
            </div>
        </div>
    </div>
</div>



<style>
    .active-tab {
        border-bottom-color: #3b82f6;
        color: #2563eb;
    }
</style>

@section Scripts {
    <script>
        const ticketId = @Model.Id;
        const currentStatus = "@Model.Status";
        const currentPriority = "@Model.Priority";
        const currentUser = "@username";
        const apiBaseUrl = '@(ViewBag.ApiBaseUrl ?? "")';

        // RBAC permission flags from server
        const canApprove = @(canApprove ? "true" : "false");
        const canAssign = @(canAssign ? "true" : "false");
        const canDelete = @(canDelete ? "true" : "false");

        let connection = null;

        // HTML escape to prevent XSS
        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // File type icon helper
        function getFileIcon(fileName) {
            if (!fileName) return 'fa-file';
            const ext = fileName.split('.').pop().toLowerCase();
            const icons = {
                'pdf': 'fa-file-pdf text-red-500',
                'doc': 'fa-file-word text-blue-600', 'docx': 'fa-file-word text-blue-600',
                'xls': 'fa-file-excel text-green-600', 'xlsx': 'fa-file-excel text-green-600', 'csv': 'fa-file-excel text-green-600',
                'ppt': 'fa-file-powerpoint text-orange-500', 'pptx': 'fa-file-powerpoint text-orange-500',
                'zip': 'fa-file-archive text-yellow-600', 'rar': 'fa-file-archive text-yellow-600', '7z': 'fa-file-archive text-yellow-600',
                'png': 'fa-file-image text-purple-500', 'jpg': 'fa-file-image text-purple-500', 'jpeg': 'fa-file-image text-purple-500',
                'gif': 'fa-file-image text-purple-500', 'svg': 'fa-file-image text-purple-500', 'webp': 'fa-file-image text-purple-500',
                'txt': 'fa-file-alt text-gray-500'
            };
            return icons[ext] || 'fa-file text-gray-400';
        }

        $(document).ready(function() {
            initUI();
            loadParts();
            loadMasterParts();
            loadComments();
            loadLogs();
            loadAttachments();

            renderActionButtons();

            updateSLAProgress();
            setInterval(updateSLAProgress, 60000);

            // Enter key to send comment (Shift+Enter for new line)
            $('#commentInput').on('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    submitComment();
                }
            });

            // SignalR Connection
            setupSignalR();
        });

        async function setupSignalR() {
            try {
                // Ensure SignalR library is available (it's often globally included or can be fetched via CDN)
                if (typeof signalR === "undefined") {
                    console.warn("SignalR not found, loading from CDN...");
                    await loadScript("https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js");
                }

                connection = new signalR.HubConnectionBuilder()
                    .withUrl('@ViewBag.ApiBaseUrl/ticketHub')
                    .withAutomaticReconnect([0, 2000, 5000, 10000, 30000]) // Retry immediately, 2s, 5s, 10s, 30s
                    .build();

                connection.onreconnecting(error => {
                    sysToast('SignalR UI Indicator', 'Connection lost. Trying to reconnect...', 'warning');
                    $('#signalrBadge').remove();
                    $('body').append('<div id="signalrBadge" class="fixed bottom-4 right-4 bg-yellow-500 text-white px-3 py-1.5 rounded shadow-lg text-sm z-50 flex items-center gap-2"><i class="fas fa-sync fa-spin"></i> Reconnecting to live updates...</div>');
                });

                connection.onreconnected(connectionId => {
                    $('#signalrBadge').remove();
                    sysToast('SignalR UI Indicator', 'Reconnected to live updates.', 'success');
                });

                connection.onclose(error => {
                    $('#signalrBadge').remove();
                    $('body').append('<div id="signalrBadge" class="fixed bottom-4 right-4 bg-red-600 text-white px-3 py-1.5 rounded shadow-lg text-sm z-50 flex items-center gap-2"><i class="fas fa-exclamation-triangle"></i> Live updates disconnected. Refresh page.</div>');
                });

                connection.on("ReceiveComment", function (tId, comment, user, timestamp, uId) {
                    if (parseInt(tId) === ticketId) {
                        loadComments(true); // Reload comments for the current ticket
                    }
                });

                connection.on("ReceiveMessagechat", (message, isClient, time, clientId) => {
                    // Refresh comments if the incoming message belongs to this ticket's client
                    if (clientId === "@Model.ClientId") {
                        loadComments(true);
                    }
                });

                await connection.start();
                console.log("SignalR Connected.");
            } catch (err) {
                console.error("SignalR Connection Error: ", err);
                // Fallback to polling if SignalR fails
                setInterval(() => {
                    if($('#tab-comments').is(':visible')) loadComments(true);
                }, 10000);
            }
        }

        function loadScript(url) {
            return new Promise((resolve, reject) => {
                const script = document.createElement("script");
                script.src = url;
                script.onload = resolve;
                script.onerror = reject;
                document.head.appendChild(script);
            });
        }

        function updateSLAProgress() {
            const createdStr = "@Model.CreatedOn?.ToString("yyyy-MM-ddTHH:mm:ss")";
            const dueStr = "@Model.DueDate?.ToString("yyyy-MM-ddTHH:mm:ss")";
            
            const bar = $('#slaProgressBar');
            const txt = $('#slaPercentText');

            if (!createdStr || !dueStr || createdStr === '' || dueStr === '') {
                bar.css('width', '0%').css('background-color', '#9ca3af');
                txt.text('No SLA').css('color', '#9ca3af');
                return;
            }

            const created = new Date(createdStr);
            const due = new Date(dueStr);
            const now = new Date();

            if (isNaN(created.getTime()) || isNaN(due.getTime())) {
                bar.css('width', '0%').css('background-color', '#9ca3af');
                txt.text('No SLA').css('color', '#9ca3af');
                return;
            }

            const total = due - created;
            const elapsed = now - created;
            let percent = Math.min(Math.max((elapsed / total) * 100, 0), 100);

            bar.css('width', percent + '%');

            if (currentStatus === 'Resolved' || currentStatus === 'Closed') {
                bar.css('background-color', '#10b981');
                txt.text('Completed').css('color', '#10b981');
            } else if (now > due) {
                bar.css('background-color', '#ef4444');
                txt.text('BREACHED').css('color', '#ef4444');
            } else {
                bar.css('background-color', percent > 80 ? '#f97316' : '#3b82f6');
                txt.text(Math.round(percent) + '% elapsed').css('color', percent > 80 ? '#f97316' : '#6b7280');
            }
        }

        function initUI() {
            // Status Badge Color
            const s = currentStatus.toLowerCase();
            const badge = $('#headerStatusBadge');
            if(s === 'open') badge.addClass('bg-red-100 text-red-600');
            else if(s === 'resolved' || s === 'closed') badge.addClass('bg-emerald-100 text-emerald-600');
            else if(s === 'rejected') badge.addClass('bg-gray-200 text-gray-700');
            else badge.addClass('bg-blue-100 text-blue-600');

            // Dynamic priority colors (BUG-3 & BUG-7 fix)
            const p = currentPriority ? currentPriority.toLowerCase() : '';
            let priorityColor = 'bg-blue-500';
            if (p === 'urgent' || p === 'critical') priorityColor = 'bg-red-500';
            else if (p === 'high') priorityColor = 'bg-orange-500';
            else if (p === 'medium') priorityColor = 'bg-amber-500';
            else if (p === 'low') priorityColor = 'bg-green-500';
            $('#priorityStripe').addClass(priorityColor);
            $('#priorityDot').addClass(priorityColor);

            // Dynamic status dot color
            let statusDotColor = 'text-gray-400';
            if (s === 'inprogress' || s === 'assigned') statusDotColor = 'text-blue-500';
            else if (s === 'resolved' || s === 'closed') statusDotColor = 'text-green-500';
            else if (s === 'open') statusDotColor = 'text-red-500';
            else if (s === 'approved') statusDotColor = 'text-emerald-500';
            else if (s === 'rejected') statusDotColor = 'text-gray-500';
            $('#statusDot').addClass(statusDotColor);
        }

        // ================= TABS =================
        function switchTab(tabName) {
            $('.tab-content').addClass('hidden');
            $(`#tab-${tabName}`).removeClass('hidden');

            $('.tab-btn').removeClass('active-tab');
            $(`button[data-target="${tabName}"]`).addClass('active-tab');
        }

        // ================= MODALS =================
        function openModal(id) {
            $(`#${id}`).removeClass('hidden');
            if(id === 'assignModal') loadEngineers();
        }

        function closeModal(id) {
            $(`#${id}`).addClass('hidden');
        }

        function renderActionButtons() {
            const container = $('#actionButtons');
            container.empty();

            if(currentStatus === 'Open' && canApprove) {
                container.append(`<button onclick="openModal('approveModal')" class="px-2.5 py-1 bg-green-600 hover:bg-green-700 text-white text-xs font-medium rounded flex items-center gap-1"><i class="fas fa-check"></i> Approve</button>`);
                container.append(`<button onclick="openModal('rejectModal')" class="px-2.5 py-1 bg-white border border-red-200 text-red-600 hover:bg-red-50 text-xs font-medium rounded"><i class="fas fa-times"></i> Reject</button>`);
            }

            if((currentStatus === 'Approved' || currentStatus === 'Open') && canAssign) {
                 container.append(`<button onclick="openModal('assignModal')" class="px-2.5 py-1 bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium rounded flex items-center gap-1"><i class="fas fa-user-tag"></i> Assign</button>`);
            }

            // Start Work button for Assigned tickets
            if(currentStatus === 'Assigned') {
                container.append(`<button onclick="startWork()" class="px-2.5 py-1 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium rounded flex items-center gap-1"><i class="fas fa-play"></i> Start Work</button>`);
            }

            // Resolve button opens modal for InProgress tickets
            if(currentStatus === 'InProgress' || currentStatus === 'Assigned') {
                container.append(`<button onclick="openModal('resolveModal')" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-medium rounded flex items-center gap-1"><i class="fas fa-check-circle"></i> Resolve</button>`);
            }

            // Delete button - require delete permission
            if(currentStatus !== 'Closed' && canDelete) {
                container.append(`<button onclick="deleteTicket()" class="px-2.5 py-1 bg-white border border-red-200 text-red-400 hover:text-red-600 hover:bg-red-50 text-xs font-medium rounded flex items-center gap-1"><i class="fas fa-trash"></i></button>`);
            }
        }

        function submitStatusAction(newStatus) {
            let remarks = "";
            if(newStatus === 'Approved') remarks = $('#approveRemarks').val() || "Approved via portal";
            else if(newStatus === 'Rejected') {
                remarks = $('#rejectRemarks').val();
                if(!remarks) { sysAlert('Please provide rejection reason', 'warning'); return; }
            } else {
                sysConfirm('Update status to ' + newStatus + '?', function() {
                    var r = 'Status updated to ' + newStatus;
                    doStatusUpdate(newStatus, r);
                });
                return;
            }
            doStatusUpdate(newStatus, remarks);
        }

        function doStatusUpdate(newStatus, remarks) {
            $.ajax({
                url: '@Url.Action("UpdateStatus", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ ticketId: ticketId, newStatus: newStatus, remarks: remarks, username: currentUser }),
                success: function(res) {
                    if(res.success) location.reload();
                    else sysAlert(res.message, 'error');
                }
            });
        }

        function loadEngineers() {
            $.get('@Url.Action("GetDetailedEngineers", "ServiceDesk")', function(data) {
                const container = $('#engineerList');
                container.empty();
                
                if(!data || data.length === 0) {
                    container.append('<div class="text-center text-xs text-gray-500 py-3">No engineers found</div>');
                    return;
                }
                
                data.forEach((e, idx) => {
                    let badgeClass = 'bg-green-100 text-green-700'; // Available
                    if(e.currentStatus === 'Busy') badgeClass = 'bg-yellow-100 text-yellow-700';
                    if(e.currentStatus === 'Overloaded') badgeClass = 'bg-red-100 text-red-700';
                    
                    let suggestedBadge = idx === 0 ? '<span class="px-1.5 py-0.5 bg-blue-600 text-white rounded text-[10px] ml-2 font-bold uppercase tracking-wider">Suggested</span>' : '';
                    
                    let card = `
                    <div class="eng-card border border-gray-200 rounded p-2 cursor-pointer hover:border-blue-400 hover:bg-blue-50 transition-colors" 
                         data-id="${e.id}" data-name="${e.name}" onclick="selectEngineer(this, '${e.id}', '${e.name}')">
                        <div class="flex justify-between items-start mb-1">
                            <div class="font-medium text-sm text-gray-800">${e.name} ${suggestedBadge}</div>
                            <div class="px-1.5 py-0.5 rounded text-[10px] uppercase font-bold tracking-wider ${badgeClass}">${e.currentStatus}</div>
                        </div>
                        <div class="flex justify-between text-xs text-gray-500">
                            <div>Role: <span class="text-gray-700">${e.role}</span></div>
                            <div>Active: <span class="font-bold text-gray-800">${e.activeTicketCount}</span></div>
                        </div>
                        <div class="flex gap-2 mt-1 text-[10px]">
                            <span class="text-red-500" title="High/Urgent Priority"><i class="fas fa-exclamation-circle text-[9px]"></i> ${e.highPriorityCount}</span>
                            <span class="text-blue-500" title="Avg Resolution Time"><i class="fas fa-clock text-[9px]"></i> ${e.avgResolutionHours}h</span>
                            <span class="text-emerald-500" title="Total Resolved"><i class="fas fa-check text-[9px]"></i> ${e.totalResolved}</span>
                        </div>
                    </div>`;
                    
                    container.append(card);
                });
            });
        }
        
        function selectEngineer(el, id, name) {
            $('.eng-card').removeClass('border-blue-500 bg-blue-50').addClass('border-gray-200');
            $(el).removeClass('border-gray-200').addClass('border-blue-500 bg-blue-50');
            $('#selectedEngineerId').val(id);
            $('#selectedEngineerName').val(name);
        }

        function submitAssignAction() {
            const engId = $('#selectedEngineerId').val();
            const engName = $('#selectedEngineerName').val();
            const notes = $('#assignNotes').val();

            if(!engId) { sysAlert('Please select an engineer', 'warning'); return; }

            $.ajax({
                url: '@Url.Action("AssignTicket", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ticketId: ticketId,
                    engineerId: engId,
                    engineerName: engName,
                    assignedBy: currentUser,
                    notes: notes
                }),
                success: function(res) {
                    if(res.success) location.reload();
                    else sysAlert(res.message, 'error');
                }
            });
        }

        // ================= COMMENTS =================
        function loadComments(silent = false) {
            $.get(`@Url.Action("GetComments", "ServiceDesk")?ticketId=${ticketId}`, function(data) {
                const list = $('#commentsList');
                let html = '';

                if(!data || data.length === 0) {
                    html = '<div class="text-center text-gray-400 py-4 text-sm"><i class="far fa-comment-dots text-2xl mb-2 block"></i>No messages yet. Start the conversation!</div>';
                } else {
                    data.sort((a,b) => new Date(a.createdOn) - new Date(b.createdOn));
                    data.forEach(c => {
                        const isMe = c.userName === currentUser;
                        const time = new Date(c.createdOn).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                        const safeComment = escapeHtml(c.comment);
                        const safeName = escapeHtml(c.userName);

                        html += `
                            <div class="${isMe ? 'text-right' : 'text-left'}">
                                <div class="inline-block max-w-[80%] ${isMe ? 'bg-blue-600 text-white rounded-tr-none' : 'bg-gray-100 text-gray-700'} rounded-lg px-3 py-2 text-sm" style="word-break: break-word;">
                                    ${safeComment}
                                </div>
                                <div class="text-[10px] text-gray-500 mt-0.5">
                                    ${safeName} • ${time}
                                </div>
                            </div>
                        `;
                    });
                }

                list.html(html);
                if (list[0]) list.scrollTop(list[0].scrollHeight);
            });
        }

        function submitComment() {
            const txt = $('#commentInput').val().trim();
            if(!txt) return;

            $.ajax({
                url: '@Url.Action("AddComment", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ ticketId: ticketId, comment: txt, userName: currentUser, userId: "@userId" }),
                success: function(res) {
                    if(res.success) {
                        $('#commentInput').val('');
                        loadComments();
                    } else sysAlert(res.message || 'Failed to post comment', 'error');
                },
                error: function(e) { 
                    console.error(e); 
                    var msg = e.responseJSON?.message || 'Error communicating with server while posting comment';
                    sysAlert(msg, 'error'); 
                }
            });
        }

        // ================= LOGS =================
        function loadLogs() {
             $.get(`@Url.Action("GetLogs", "ServiceDesk")?ticketId=${ticketId}`, function(data) {
                 const list = $('#activityList');
                 list.empty();
                 if(!data || data.length === 0) list.html('<div class="text-gray-400 text-sm text-center py-4">No activity yet</div>');
                 else {
                     data.forEach(l => {
                         const time = new Date(l.createdOn).toLocaleString([], {month:'short', day:'numeric', hour:'2-digit', minute:'2-digit'});
                         list.append(`
                            <div class="text-sm">
                                <div class="text-xs text-gray-500 mb-0.5">${time}</div>
                                <div class="font-medium text-gray-800">${l.remarks || 'Status Changed'}</div>
                                <div class="flex items-center gap-1 text-xs text-gray-500 mt-0.5">
                                    <span class="px-1.5 py-0.5 bg-gray-100 rounded">${l.oldStatus}</span>
                                    <i class="fas fa-arrow-right text-[8px]"></i>
                                    <span class="px-1.5 py-0.5 bg-gray-100 rounded font-medium">${l.newStatus}</span>
                                    <span class="ml-1">by ${l.from}</span>
                                </div>
                            </div>
                         `);
                     });
                 }
             });
        }

        // ================= CALL LOGS =================
        function openLogCallModal() {
            var now = new Date();
            var offset = now.getTimezoneOffset() * 60000;
            var localISOTime = (new Date(now - offset)).toISOString().slice(0, 16);
            
            $('#callCallerName').val('');
            $('#callType').val('Incoming');
            $('#callChannel').val('Phone');
            $('#callSubject').val('');
            $('#callDescription').val('');
            $('#callDuration').val('');
            $('#callOutcome').val('InformationProvided');
            openModal('logCallModal');
        }

        function loadTicketCallLogs() {
            $.get(`@Url.Action("GetTicketCallLogs", "ServiceDesk")?ticketId=${ticketId}`, function(data) {
                const list = $('#callsList');
                list.empty();
                if(!data || data.length === 0) {
                    list.append('<div class="text-center text-gray-400 py-4 text-sm">No calls logged yet</div>');
                    return;
                }

                data.forEach(c => {
                    const date = new Date(c.createdOn).toLocaleString();
                    let badgeClass = 'bg-gray-100 text-gray-700';
                    if(c.callType === 'Incoming') badgeClass = 'bg-green-100 text-green-700';
                    if(c.callType === 'Outgoing') badgeClass = 'bg-blue-100 text-blue-700';
                    if(c.callType === 'Internal') badgeClass = 'bg-yellow-100 text-yellow-700';

                    list.append(`
                        <div class="p-3 bg-gray-50 rounded border border-gray-100 mb-2">
                            <div class="flex justify-between items-start mb-1">
                                <div class="font-medium text-sm text-gray-800">${escapeHtml(c.subject) || 'Call Record'}</div>
                                <span class="px-1.5 py-0.5 rounded text-[10px] font-medium ${badgeClass}">${escapeHtml(c.callType)} - ${escapeHtml(c.channel)}</span>
                            </div>
                            <div class="text-xs text-gray-500 mb-2">
                                <i class="far fa-clock mr-1"></i> ${date} • <i class="fas fa-user-circle mx-1"></i> ${escapeHtml(c.loggedByName)}
                            </div>
                            <div class="text-xs text-gray-700 whitespace-pre-wrap bg-white p-2 rounded border border-gray-100">${escapeHtml(c.description)}</div>
                            <div class="flex justify-between items-center mt-2 text-[10px] text-gray-500">
                                <div>Caller: <span class="font-medium text-gray-700">${escapeHtml(c.callerName) || '-'}</span></div>
                                <div>Duration: <span class="font-medium text-gray-700">${c.durationMinutes || 0} min</span></div>
                                <div>Outcome: <span class="font-medium text-gray-700">${escapeHtml(c.outcome) || '-'}</span></div>
                            </div>
                        </div>
                    `);
                });
            });
        }

        function submitCallLog() {
            const data = {
                TicketId: ticketId,
                CallerName: $('#callCallerName').val(),
                CallType: $('#callType').val(),
                Channel: $('#callChannel').val(),
                Subject: $('#callSubject').val(),
                Description: $('#callDescription').val(),
                DurationMinutes: parseInt($('#callDuration').val()) || null,
                Outcome: $('#callOutcome').val(),
                CreatedOn: new Date().toISOString(),
                LoggedByName: currentUser
            };

            if(!data.CallerName || !data.Subject || !data.Description) {
                sysAlert('Please fill in all required fields', 'warning');
                return;
            }

            $.ajax({
                url: '@Url.Action("AddCallLog", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(res) {
                    if(res.success) {
                        closeModal('logCallModal');
                        sysAlert('Call logged successfully', 'success');
                        loadTicketCallLogs();
                    } else {
                        sysAlert(res.message, 'error');
                    }
                }
            });
        }

        // ================= FILES =================
        function loadAttachments() {
            $.get(`@Url.Action("GetAttachments", "ServiceDesk")?ticketId=${ticketId}`, function(data) {
                 const list = $('#attachmentsList');
                 list.empty();
                 if(!data || data.length === 0) {
                     list.html('<div class="text-center text-gray-400 py-4 text-sm"><i class="fas fa-paperclip text-2xl mb-2 block"></i>No files attached</div>');
                     return;
                 }

                 data.forEach(f => {
                     const date = new Date(f.uploadedOn).toLocaleDateString();
                     const safeName = escapeHtml(f.fileName);
                     const fileIcon = getFileIcon(f.fileName);
                     const sizeStr = f.fileSize > 1048576 ? (f.fileSize/1048576).toFixed(1) + ' MB' : (f.fileSize/1024).toFixed(1) + ' KB';
                     // File path comes from API server, proxy through WebApp
                     const downloadUrl = `@Url.Action("DownloadAttachment", "ServiceDesk")?path=${encodeURIComponent(f.filePath)}&name=${encodeURIComponent(f.fileName)}`;
                     list.append(`
                        <div class="flex items-center justify-between p-2 bg-gray-50 rounded border border-gray-100 hover:bg-gray-100 transition-colors">
                            <div class="flex items-center gap-2">
                                <div class="w-8 h-8 rounded bg-gray-100 flex items-center justify-center">
                                    <i class="fas ${fileIcon} text-sm"></i>
                                </div>
                                <div class="max-w-[150px]">
                                    <p class="text-xs font-medium text-gray-800 truncate" title="${safeName}">${safeName}</p>
                                    <p class="text-[10px] text-gray-500">${sizeStr} • ${date}</p>
                                </div>
                            </div>
                            <a href="${downloadUrl}" target="_blank" class="text-gray-400 hover:text-blue-600 p-1.5 hover:bg-blue-50 rounded transition-colors" title="Download">
                                <i class="fas fa-download text-xs"></i>
                            </a>
                        </div>
                     `);
                 });
            });
        }

        function uploadFile(input) {
            if(input.files && input.files[0]) {
                const file = input.files[0];
                
                // Client-side file size validation (10MB)
                const maxSize = 10 * 1024 * 1024;
                if (file.size > maxSize) {
                    sysAlert('File size exceeds 10MB limit. Please choose a smaller file.', 'warning');
                    input.value = '';
                    return;
                }

                const formData = new FormData();
                formData.append('file', file);

                $('#attachmentsList').prepend(`<div id="uploading" class="p-2 text-center text-xs text-blue-500"><i class="fas fa-spinner fa-spin mr-1"></i>Uploading ${escapeHtml(file.name)}...</div>`);

                $.ajax({
                    url: `@Url.Action("AddAttachment", "ServiceDesk")?ticketId=${ticketId}`,
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(res) {
                        $('#uploading').remove();
                        if(res.success) {
                            sysAlert('File uploaded successfully', 'success');
                            loadAttachments();
                        } else sysAlert(res.message || 'Upload failed', 'error');
                    },
                    error: function(e) { 
                        $('#uploading').remove(); 
                        var msg = e.responseJSON?.message || 'Error uploading file';
                        sysAlert(msg, 'error'); 
                    }
                });
                // Reset input so same file can be re-uploaded
                input.value = '';
            }
        }

        // ================= PARTS =================
        async function loadParts() {
            try {
                const res = await fetch(`/ServiceDesk/GetParts?ticketId=${ticketId}`);
                const parts = await res.json();
                const tbody = document.getElementById('partsTableBody');
                if(!parts || parts.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="5" class="py-3 text-center text-gray-400 text-sm">No parts added</td></tr>`;
                    document.getElementById('grandTotal').innerText = "₹0.00";
                    return;
                }
                let html = ''; let total = 0;
                parts.forEach(p => {
                    const t = p.quantity * p.unitCost; total += t;
                    html += `<tr class="border-b border-gray-50">
                        <td class="py-2 text-gray-700 text-sm">${escapeHtml(p.partName)}</td>
                        <td class="py-2 text-center text-gray-700 text-sm">${p.quantity}</td>
                        <td class="py-2 text-right text-gray-700 text-sm">₹${p.unitCost.toFixed(2)}</td>
                        <td class="py-2 text-right font-medium text-gray-800 text-sm">₹${t.toFixed(2)}</td>
                        <td class="py-2 text-center"><button onclick="deletePart(${p.id})" class="text-red-400 hover:text-red-600 text-xs"><i class="fas fa-trash"></i></button></td>
                    </tr>`;
                });
                tbody.innerHTML = html;
                document.getElementById('grandTotal').innerText = "₹" + total.toFixed(2);
            } catch(e) { console.error(e); }
        }

        function openPartModal() {
            openModal('partModal');
        }

        async function submitPart() {
            const data = {
                ticketId: parseInt(ticketId),
                partName: $('#partName').val(),
                quantity: parseInt($('#partQty').val()),
                unitCost: parseFloat($('#partCost').val())
            };
            if(!data.partName) return;

            await fetch('/ServiceDesk/AddPart', {
                method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(data)
            });
            closeModal('partModal');
            loadParts();
        }

        function deletePart(id) {
            sysConfirm('Delete this part?', function() {
                fetch('/ServiceDesk/DeletePart?id=' + id, {method: 'POST'}).then(function(){ loadParts(); });
            }, {type:'danger'});
        }

        // ================= MASTER PARTS =================
        let masterParts = [];
        async function loadMasterParts() {
            try {
                const res = await fetch('/ServiceDesk/GetMasterParts');
                masterParts = await res.json();
                const dl = document.getElementById('masterPartsList');
                dl.innerHTML = '';
                masterParts.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.partName;
                    opt.dataset.price = p.unitCost;
                    opt.innerText = `₹${p.unitCost} - Stock: ${p.stockQuantity}`;
                    dl.appendChild(opt);
                });
            } catch(e) { console.error("Failed to load master parts", e); }
        }

        function onPartSelect(input) {
            const val = input.value;
            const part = masterParts.find(p => p.partName === val);
            if(part) {
                document.getElementById('partCost').value = part.unitCost;
            }
        }

        // ================= START WORK =================
        function startWork() {
            sysConfirm('Start working on this ticket?', function() {
                $.ajax({
                    url: '@Url.Action("StartWork", "ServiceDesk")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        ticketId: ticketId,
                        username: currentUser,
                        remarks: 'Started working on ticket'
                    }),
                    success: function(res) {
                        if(res.success) location.reload();
                        else sysAlert(res.message || 'Failed to start work', 'error');
                    },
                    error: function() {
                        sysAlert('Failed to start work', 'error');
                    }
                });
            });
        }

        // ================= DELETE TICKET =================
        function deleteTicket() {
            sysConfirm('Are you sure you want to delete this ticket? This action cannot be undone.', function() {
                $.ajax({
                    url: '@Url.Action("DeleteTicket", "ServiceDesk")' + '?id=' + ticketId,
                    type: 'POST',
                    success: function(res) {
                        if(res.success) {
                            sysAlert('Ticket deleted successfully', 'success');
                            setTimeout(function(){ window.location.href = '@Url.Action("Tickets", "ServiceDesk")'; }, 1500);
                        } else {
                            sysAlert(res.message || 'Failed to delete ticket', 'error');
                        }
                    },
                    error: function() {
                        sysAlert('Failed to delete ticket', 'error');
                    }
                });
            }, {type:'danger'});
        }

        // ================= RESOLVE TICKET =================
        function submitResolve() {
            const notes = $('#resolveNotes').val().trim();
            
            $.ajax({
                url: '@Url.Action("ResolveTicket", "ServiceDesk")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ticketId: ticketId,
                    username: currentUser,
                    resolutionNotes: notes
                }),
                success: function(res) {
                    if(res.success) location.reload();
                    else sysAlert(res.message || 'Failed to resolve', 'error');
                },
                error: function() {
                    sysAlert('Failed to resolve ticket', 'error');
                }
            });
        }
    </script>
}