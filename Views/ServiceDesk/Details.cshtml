@model ManageEngineWebApp.Models.HelpdeskTicket
@{
    ViewData["Title"] = "Ticket Details - " + Model.TicketNo;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var username = Context.Session.GetString("username") ?? "User";
    var userId = Context.Session.GetString("userId") ?? "0";
}

<div class="bg-gray-50 min-h-screen pb-12 font-sans">
    <!-- Sticky Header for Actions -->
    <div class="sticky top-0 z-30 bg-white/80 backdrop-blur-md border-b border-gray-200 shadow-sm px-6 py-4 flex flex-col md:flex-row items-center justify-between gap-4 transition-all" id="stickyHeader">
        <div class="flex items-center gap-4">
            <a href="@Url.Action("Tickets", "ServiceDesk")" class="text-slate-400 hover:text-slate-600 transition-colors">
                <i class="fas fa-arrow-left text-lg"></i>
            </a>
            <div>
                <div class="flex items-center gap-3">
                    <h1 class="text-xl font-bold text-slate-800">@Model.TicketNo</h1>
                    <span id="headerStatusBadge" class="px-3 py-1 text-xs rounded-full font-bold uppercase tracking-wide bg-gray-100 text-gray-600">@Model.Status</span>
                </div>
                <p class="text-sm text-slate-500 truncate max-w-md">@Model.Subject</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <!-- Action Buttons based on Status -->
            <div id="actionButtons" class="flex gap-2">
                <!-- Populated via JS -->
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 py-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- LEFT COLUMN: Ticket Info (7 cols) -->
        <div class="lg:col-span-8 space-y-6">
            <!-- Main Info Card -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden relative group hover:shadow-md transition-shadow">
                <!-- Priority Stripe -->
                <div class="absolute left-0 top-0 bottom-0 w-1 bg-slate-200" id="priorityStripe"></div>
                
                <div class="p-6 pl-8">
                    <div class="flex flex-col md:flex-row justify-between md:items-start mb-8 gap-6">
                        <div class="flex items-center gap-5">
                            <div class="relative">
                                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white font-bold text-2xl shadow-xl shadow-blue-500/20">
                                    @(Model.RequesterName?.Substring(0,1) ?? "U")
                                </div>
                                <div class="absolute -bottom-1 -right-1 w-6 h-6 rounded-lg bg-green-500 border-4 border-white" title="Requester Active"></div>
                            </div>
                            <div>
                                <h2 class="text-xl font-bold text-slate-800">@Model.RequesterName</h2>
                                <p class="text-sm text-slate-500 flex items-center gap-2">
                                    <i class="far fa-envelope text-blue-400"></i> @Model.RequesterEmail
                                </p>
                                <div class="mt-2 flex gap-2">
                                    <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-[10px] font-bold rounded uppercase tracking-wider">Requester</span>
                                    @if(Model.ClientId != null) { <span class="px-2 py-0.5 bg-blue-50 text-blue-600 text-[10px] font-bold rounded uppercase tracking-wider">Portal User</span> }
                                </div>
                            </div>
                        </div>
                        
                        <!-- SLA Visual Meter -->
                        <div class="bg-slate-50 rounded-2xl p-4 border border-slate-100 flex-grow max-w-sm">
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">SLA Resolution</span>
                                <span class="text-xs font-bold @(Model.IsSLABreached == true ? "text-red-500" : "text-blue-600")" id="slaPercentText">Calculating...</span>
                            </div>
                            <div class="w-full h-2 bg-slate-200 rounded-full overflow-hidden">
                                <div id="slaProgressBar" class="h-full transition-all duration-1000 @(Model.IsSLABreached == true ? "bg-red-500" : "bg-blue-500")" style="width: 0%"></div>
                            </div>
                            <div class="flex justify-between mt-2 text-[10px] font-medium text-slate-400">
                                <span>Created: @Model.CreatedOn?.ToString("HH:mm")</span>
                                <span>Deadline: @Model.DueDate?.ToString("HH:mm")</span>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                         <div class="bg-white border border-slate-100 p-4 rounded-xl shadow-sm hover:border-blue-200 transition-colors">
                            <p class="text-[10px] text-slate-400 uppercase font-bold mb-2 tracking-tighter">Priority Level</p>
                            <div class="font-bold text-slate-800 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full @(Model.Priority == "Urgent" ? "bg-red-500" : (Model.Priority == "High" ? "bg-orange-500" : "bg-sky-500")) animate-pulse"></span>
                                <span id="priorityText">@Model.Priority</span>
                            </div>
                        </div>
                        <div class="bg-white border border-slate-100 p-4 rounded-xl shadow-sm hover:border-blue-200 transition-colors">
                            <p class="text-[10px] text-slate-400 uppercase font-bold mb-2 tracking-tighter">Expert Category</p>
                            <div class="font-bold text-slate-800 flex items-center gap-2">
                                <i class="fas fa-tag text-slate-300 text-xs"></i>
                                <span>@Model.Category</span>
                            </div>
                        </div>
                        <div class="bg-white border border-slate-100 p-4 rounded-xl shadow-sm hover:border-blue-200 transition-colors">
                            <p class="text-[10px] text-slate-400 uppercase font-bold mb-2 tracking-tighter">Engineer Assigned</p>
                            <div class="font-bold text-slate-800 flex items-center gap-2 overflow-hidden">
                                @if(!string.IsNullOrEmpty(Model.AssignedToName)) {
                                    <div class="w-5 h-5 rounded bg-green-500 text-white flex items-center justify-center text-[10px] font-bold">@Model.AssignedToName[0]</div>
                                    <span class="truncate">@Model.AssignedToName</span>
                                } else {
                                    <span class="text-slate-300 italic font-medium">Unassigned</span>
                                }
                            </div>
                        </div>
                        <div class="bg-white border border-slate-100 p-4 rounded-xl shadow-sm hover:border-blue-200 transition-colors">
                            <p class="text-[10px] text-slate-400 uppercase font-bold mb-2 tracking-tighter">Current Status</p>
                            <div class="font-bold text-slate-800 flex items-center gap-2">
                                <i class="fas fa-circle-notch @(Model.Status == "InProgress" || Model.Status == "In Progress" ? "fa-spin text-blue-500" : (Model.Status == "Resolved" ? "text-green-500" : "text-slate-400")) text-[10px]"></i>
                                @Model.Status
                            </div>
                        </div>
                    </div>

                    <!-- Hierarchy Info -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8 bg-slate-50/50 p-4 rounded-xl border border-dashed border-slate-200">
                        <div>
                            <p class="text-[10px] text-slate-400 uppercase font-bold mb-1">Company</p>
                            <p class="text-sm font-semibold text-slate-700">@(Model.CompanyName ?? "N/A")</p>
                        </div>
                        <div>
                            <p class="text-[10px] text-slate-400 uppercase font-bold mb-1">Location</p>
                            <p class="text-sm font-semibold text-slate-700">@(Model.LocationName ?? "N/A")</p>
                        </div>
                        <div>
                            <p class="text-[10px] text-slate-400 uppercase font-bold mb-1">Group / Department</p>
                            <p class="text-sm font-semibold text-slate-700">@(Model.GroupName ?? "N/A")</p>
                        </div>
                    </div>

                    <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100 relative group">
                        <div class="absolute -top-3 left-6 px-3 py-1 bg-white border border-slate-100 rounded-lg text-[10px] font-bold text-slate-400 uppercase tracking-widest shadow-sm">Issue Details</div>
                        <p class="text-slate-700 leading-relaxed text-sm whitespace-pre-wrap">@Model.Remark</p>
                    </div>
                </div>
            </div>

            <!-- Parts Section -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                    <h3 class="font-bold text-slate-800 flex items-center gap-2">
                        <i class="fas fa-microchip text-purple-500"></i> Spare Parts / Hardware
                    </h3>
                    <button onclick="openPartModal()" class="text-sm px-3 py-1.5 bg-white border border-slate-300 rounded-lg shadow-sm hover:bg-slate-50 text-slate-700 font-medium transition-colors">
                        <i class="fas fa-plus mr-1 text-purple-500"></i> Add Part
                    </button>
                </div>
                <div class="p-0 overflow-x-auto">
                    <table class="w-full text-sm text-left">
                        <thead class="text-xs text-slate-500 uppercase bg-slate-50 font-semibold">
                            <tr>
                                <th class="px-6 py-3">Part Name</th>
                                <th class="px-6 py-3 text-center">Qty</th>
                                <th class="px-6 py-3 text-right">Cost</th>
                                <th class="px-6 py-3 text-right">Total</th>
                                <th class="px-6 py-3 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="partsTableBody" class="divide-y divide-slate-100">
                            <!-- Populated by JS -->
                        </tbody>
                        <tfoot class="bg-slate-50 font-bold text-slate-800">
                            <tr>
                                <td colspan="3" class="px-6 py-3 text-right text-slate-500">Grand Total:</td>
                                <td id="grandTotal" class="px-6 py-3 text-right text-purple-600">$0.00</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Tabs (Activity, Comments, Files) (4 cols) -->
        <div class="lg:col-span-4 space-y-6">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col h-[600px] sticky top-24">
                <!-- Custom Tabs Header -->
                <div class="flex border-b border-slate-200 bg-slate-50">
                    <button onclick="switchTab('comments')" class="flex-1 py-3 text-sm font-bold text-slate-600 hover:text-blue-600 border-b-2 border-transparent hover:border-blue-300 transition-all tab-btn active-tab" data-target="comments">
                        <i class="far fa-comments mr-2"></i> Chat
                    </button>
                    <button onclick="switchTab('activity')" class="flex-1 py-3 text-sm font-bold text-slate-600 hover:text-blue-600 border-b-2 border-transparent hover:border-blue-300 transition-all tab-btn" data-target="activity">
                        <i class="fas fa-history mr-2"></i> Log
                    </button>
                    <button onclick="switchTab('files')" class="flex-1 py-3 text-sm font-bold text-slate-600 hover:text-blue-600 border-b-2 border-transparent hover:border-blue-300 transition-all tab-btn" data-target="files">
                        <i class="fas fa-paperclip mr-2"></i> Files
                    </button>
                </div>

                <!-- Tab Content: Comments -->
                <div id="tab-comments" class="tab-content flex-grow flex flex-col h-full bg-slate-50/30">
                    <div id="commentsList" class="flex-grow overflow-y-auto p-4 space-y-4 custom-scrollbar">
                        <!-- Loaded via JS -->
                    </div>
                    <!-- Input Area -->
                    <div class="p-4 bg-white border-t border-slate-200">
                        <div class="relative">
                            <textarea id="commentInput" rows="2" class="w-full rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none p-3 text-sm pr-12 shadow-inner resize-none transition-all" placeholder="Type a message..."></textarea>
                            <button onclick="submitComment()" class="absolute right-2 bottom-2 p-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors shadow-sm hover:shadow-md">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Tab Content: Activity -->
                <div id="tab-activity" class="tab-content hidden flex-grow overflow-y-auto p-6 custom-scrollbar">
                    <div class="relative pl-4 border-l-2 border-slate-200 space-y-8" id="activityList">
                        <!-- Loaded via JS -->
                    </div>
                </div>

                <!-- Tab Content: Files -->
                <div id="tab-files" class="tab-content hidden flex-grow p-4 flex flex-col h-full">
                    <div class="border-2 border-dashed border-slate-300 rounded-xl p-6 text-center hover:bg-slate-50 transition-colors cursor-pointer mb-4" onclick="document.getElementById('fileUpload').click()">
                        <i class="fas fa-cloud-upload-alt text-3xl text-slate-400 mb-2"></i>
                        <p class="text-sm text-slate-600 font-medium">Click to upload file</p>
                        <p class="text-xs text-slate-400 mt-1">Images, PDF, Docx (Max 10MB)</p>
                        <input type="file" id="fileUpload" class="hidden" onchange="uploadFile(this)">
                    </div>
                    <div class="flex-grow overflow-y-auto space-y-2 custom-scrollbar" id="attachmentsList">
                        <!-- Loaded via JS -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

