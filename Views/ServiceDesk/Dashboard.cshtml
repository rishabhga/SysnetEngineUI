@{
    ViewData["Title"] = "Service Desk Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bg-slate-50 min-h-screen p-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
        <div>
            <h1 class="text-3xl font-bold text-slate-800">Service Desk Overview</h1>
            <p class="text-slate-500 mt-1">Real-time insights and performance metrics</p>
        </div>
        <div class="flex items-center space-x-3">
            <div class="bg-white border border-slate-200 rounded-lg px-4 py-2 flex items-center text-sm text-slate-600 shadow-sm">
                <i class="far fa-calendar-alt mr-2 text-blue-500"></i>
                <span id="currentDate">Mock Date</span>
            </div>
            <a href="@Url.Action("CreateTicket", "ServiceDesk")" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg shadow-lg hover:shadow-blue-500/30 transition-all flex items-center">
                <i class="fas fa-plus mr-2"></i> New Ticket
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <!-- Total Tickets -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-slate-100 relative overflow-hidden group hover:shadow-md transition-shadow">
            <div class="absolute right-0 top-0 h-24 w-24 bg-blue-50 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
            <div class="relative z-10">
                <div class="flex items-center justify-between mb-4">
                    <div class="text-slate-500 text-sm font-medium uppercase tracking-wider">Total Tickets</div>
                    <div class="bg-blue-100 text-blue-600 p-2 rounded-lg">
                        <i class="fas fa-ticket-alt text-xl"></i>
                    </div>
                </div>
                <div class="flex items-end items-baseline gap-2">
                    <h2 class="text-3xl font-bold text-slate-800" id="statTotal">--</h2>
                    <span class="text-sm text-green-500 font-medium flex items-center mb-1">
                        <i class="fas fa-arrow-up mr-1"></i> <span id="statNewToday">--</span> New
                    </span>
                </div>
            </div>
        </div>

        <!-- Open Tickets -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-slate-100 relative overflow-hidden group hover:shadow-md transition-shadow">
            <div class="absolute right-0 top-0 h-24 w-24 bg-amber-50 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
            <div class="relative z-10">
                <div class="flex items-center justify-between mb-4">
                    <div class="text-slate-500 text-sm font-medium uppercase tracking-wider">Open / Pending</div>
                    <div class="bg-amber-100 text-amber-600 p-2 rounded-lg">
                        <i class="fas fa-hourglass-half text-xl"></i>
                    </div>
                </div>
                <div class="flex items-end items-baseline gap-2">
                    <h2 class="text-3xl font-bold text-slate-800" id="statOpen">--</h2>
                    <span class="text-sm text-slate-400 font-medium mb-1">Requires Attention</span>
                </div>
            </div>
        </div>

        <!-- Resolved Today -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-slate-100 relative overflow-hidden group hover:shadow-md transition-shadow">
            <div class="absolute right-0 top-0 h-24 w-24 bg-emerald-50 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
            <div class="relative z-10">
                <div class="flex items-center justify-between mb-4">
                    <div class="text-slate-500 text-sm font-medium uppercase tracking-wider">Resolved Today</div>
                    <div class="bg-emerald-100 text-emerald-600 p-2 rounded-lg">
                        <i class="fas fa-check-circle text-xl"></i>
                    </div>
                </div>
                <div class="flex items-end items-baseline gap-2">
                    <h2 class="text-3xl font-bold text-slate-800" id="statResolved">--</h2>
                    <span class="text-sm text-emerald-600 font-medium mb-1">Great Job!</span>
                </div>
            </div>
        </div>

        <!-- SLA Breached -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-slate-100 relative overflow-hidden group hover:shadow-md transition-shadow">
            <div class="absolute right-0 top-0 h-24 w-24 bg-red-50 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
            <div class="relative z-10">
                <div class="flex items-center justify-between mb-4">
                    <div class="text-slate-500 text-sm font-medium uppercase tracking-wider">Overdue (SLA)</div>
                    <div class="bg-red-100 text-red-600 p-2 rounded-lg">
                        <i class="fas fa-exclamation-triangle text-xl"></i>
                    </div>
                </div>
                <div class="flex items-end items-baseline gap-2">
                    <h2 class="text-3xl font-bold text-slate-800" id="statSla">--</h2>
                    <span class="text-sm text-red-500 font-medium mb-1">Critical</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts & Quick Access -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
        <!-- Status Chart -->
        <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
            <h3 class="text-lg font-bold text-slate-700 mb-4">Ticket Status Distribution</h3>
            <div class="relative h-64">
                <canvas id="statusChart"></canvas>
            </div>
        </div>

        <!-- Priority Chart -->
        <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
            <h3 class="text-lg font-bold text-slate-700 mb-4">Tickets by Priority</h3>
            <div class="relative h-64">
                <canvas id="priorityChart"></canvas>
            </div>
        </div>

        <!-- Quick Actions & Engineer Status -->
        <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 flex flex-col">
            <h3 class="text-lg font-bold text-slate-700 mb-4">Engineer Status</h3>
            <div class="flex-1 overflow-y-auto pr-2" id="engineerList">
                <div class="flex flex-col gap-3">
                    <!-- Loaded dynamically -->
                    <div class="animate-pulse flex space-x-4">
                        <div class="rounded-full bg-slate-200 h-10 w-10"></div>
                        <div class="flex-1 space-y-2 py-1">
                            <div class="h-2 bg-slate-200 rounded text-slate-200 text-sm">Loading...</div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="mt-6 pt-6 border-t border-slate-100">
                <a href="@Url.Action("Tickets", "ServiceDesk")" class="block w-full text-center py-3 bg-slate-50 hover:bg-slate-100 text-slate-600 font-medium rounded-lg transition-colors border border-slate-200">
                    View All Tickets
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            // Set date
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            $('#currentDate').text(new Date().toLocaleDateString('en-US', options));

            loadStats();
            loadEngineers();
        });

        function loadStats() {
            $.ajax({
                url: '@Url.Action("GetStats", "ServiceDesk")',
                type: 'GET',
                success: function(data) {
                    // Update Cards
                    $('#statTotal').text(data.totalCount || 0);
                    $('#statNewToday').text(data.todayCreated || 0);
                    $('#statOpen').text(data.openCount || 0);
                    $('#statResolved').text(data.todayResolved || 0);
                    $('#statSla').text(data.slaBreachedCount || 0);

                    // Render Charts
                    renderCharts(data);
                },
                error: function(err) {
                    console.error("Failed to load stats", err);
                }
            });
        }

        function renderCharts(data) {
            // Status Chart (Doughnut)
            const ctxStatus = document.getElementById('statusChart').getContext('2d');
            new Chart(ctxStatus, {
                type: 'doughnut',
                data: {
                    labels: ['Open', 'Assigned', 'In Progress', 'Resolved', 'Closed'],
                    datasets: [{
                        data: [
                            data.openCount, 
                            data.assignedCount, 
                            data.inProgressCount, 
                            data.resolvedCount, 
                            data.closedCount
                        ],
                        backgroundColor: [
                            '#EF4444', // Red (Open)
                            '#3B82F6', // Blue (Assigned)
                            '#F59E0B', // Amber (In Progress)
                            '#10B981', // Emerald (Resolved)
                            '#6B7280'  // Gray (Closed)
                        ],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { usePointStyle: true, font: { size: 11 } } }
                    },
                    cutout: '70%'
                }
            });

            // Priority Chart (Bar) - Mock distribution for now as API might not return priority breakdown in Stats object
            // Ideally backend GetStats should return priority counts. 
            // For now, let's just show a placeholder or basic if data available.
            // Assuming data doesn't have priority breakdown yet, we'll hide this or use dummy data for visual check
             const ctxPriority = document.getElementById('priorityChart').getContext('2d');
            new Chart(ctxPriority, {
                type: 'bar',
                data: {
                    labels: ['High', 'Medium', 'Low'],
                    datasets: [{
                        label: 'Tickets',
                        data: [5, 12, 8], // MOCK DATA - Backend enhancement needed for real data
                        backgroundColor: ['#EF4444', '#F59E0B', '#10B981'],
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true, grid: { display: true, drawBorder: false } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        function loadEngineers() {
            $.ajax({
                url: '@Url.Action("GetEngineers", "ServiceDesk")',
                type: 'GET',
                success: function(data) {
                    const list = $('#engineerList');
                    list.empty();
                    
                    if(data && data.length > 0) {
                        data.forEach(eng => {
                            const statusColor = eng.activeTickets >= 3 ? 'bg-red-500' : 'bg-green-500';
                            const statusText = eng.activeTickets >= 3 ? 'Busy' : 'Available';
                            const html = `
                                <div class="flex items-center justify-between p-3 rounded-lg bg-slate-50 border border-slate-100 hover:bg-slate-100 transition-colors">
                                    <div class="flex items-center gap-3">
                                        <div class="h-10 w-10 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 font-bold">
                                            ${eng.name.charAt(0).toUpperCase()}
                                        </div>
                                        <div>
                                            <div class="font-medium text-slate-800 text-sm">${eng.name}</div>
                                            <div class="text-xs text-slate-500">${eng.activeTickets} Active Tickets</div>
                                        </div>
                                    </div>
                                    <div class="flex flex-col items-end">
                                        <span class="h-2.5 w-2.5 rounded-full ${statusColor} mb-1" title="${statusText}"></span>
                                    </div>
                                </div>
                            `;
                            list.append(html);
                        });
                    } else {
                        list.html('<div class="text-center text-slate-500 py-4">No engineers found</div>');
                    }
                }
            });
        }
    </script>
}
