@{
    ViewData["Title"] = "Service Desk Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var canCreate = ViewBag.CanCreate ?? false;
    var canAssign = ViewBag.CanAssign ?? false;
    var canApprove = ViewBag.CanApprove ?? false;
    var canDelete = ViewBag.CanDelete ?? false;
}

<div class="min-h-screen bg-gray-50 p-4">
    <div class="max-w-7xl mx-auto">
        <!-- Compact Header -->
        <div class="mb-5">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-3">
                <div>
                    <h1 class="text-xl font-bold text-gray-900">Service Desk Dashboard</h1>
                    <p class="text-gray-600 text-sm mt-0.5">Real-time ticket overview</p>
                </div>
                <div class="flex items-center gap-2">
                    @if (canCreate)
                    {
                        <a href="@Url.Action("CreateTicket", "ServiceDesk")"
                           class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded flex items-center">
                            <i class="fas fa-plus mr-1.5 text-xs"></i>
                            New Ticket
                        </a>
                    }
                </div>
            </div>

            <!-- Date & Filters -->
            <div class="flex flex-wrap items-center gap-3">
                <div class="flex items-center gap-2 text-sm text-gray-600 bg-white px-3 py-1.5 rounded border">
                    <i class="fas fa-calendar-alt text-blue-500"></i>
                    <span id="currentDate"></span>
                </div>
                <select id="companyFilter" class="h-8 text-sm border border-gray-300 rounded px-2 bg-white text-gray-700 min-w-[150px]">
                    <option value="">All Companies</option>
                </select>
                <select id="locationFilter" class="h-8 text-sm border border-gray-300 rounded px-2 bg-white text-gray-700 min-w-[150px]">
                    <option value="">All Locations</option>
                </select>
            </div>
        </div>

        <!-- Main Stats Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
            <!-- Total Tickets -->
            <div class="bg-white rounded border border-gray-200 p-3 hover:border-blue-300 transition-colors">
                <div class="flex justify-between items-start mb-2">
                    <div>
                        <div class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total Tickets</div>
                        <div class="text-lg font-bold text-gray-800 mt-1" id="statTotal">--</div>
                    </div>
                    <div class="w-8 h-8 rounded bg-blue-50 flex items-center justify-center">
                        <i class="fas fa-ticket-alt text-blue-500 text-sm"></i>
                    </div>
                </div>
                <div class="text-xs text-green-500 font-medium">
                    <i class="fas fa-arrow-up mr-1 text-[10px]"></i>
                    <span id="statNewToday">--</span> new today
                </div>
            </div>

            <!-- Open Tickets -->
            <div class="bg-white rounded border border-gray-200 p-3 hover:border-red-300 transition-colors">
                <div class="flex justify-between items-start mb-2">
                    <div>
                        <div class="text-xs font-medium text-gray-500 uppercase tracking-wider">Open / Pending</div>
                        <div class="text-lg font-bold text-gray-800 mt-1" id="statOpen">--</div>
                    </div>
                    <div class="w-8 h-8 rounded bg-red-50 flex items-center justify-center">
                        <i class="fas fa-hourglass-half text-red-500 text-sm"></i>
                    </div>
                </div>
                <div class="text-xs text-gray-500">Requires attention</div>
            </div>

            <!-- Resolved Today -->
            <div class="bg-white rounded border border-gray-200 p-3 hover:border-emerald-300 transition-colors">
                <div class="flex justify-between items-start mb-2">
                    <div>
                        <div class="text-xs font-medium text-gray-500 uppercase tracking-wider">Resolved Today</div>
                        <div class="text-lg font-bold text-gray-800 mt-1" id="statResolved">--</div>
                    </div>
                    <div class="w-8 h-8 rounded bg-emerald-50 flex items-center justify-center">
                        <i class="fas fa-check-circle text-emerald-500 text-sm"></i>
                    </div>
                </div>
                <div class="text-xs text-emerald-500 font-medium">Great job!</div>
            </div>

            <!-- SLA Breached -->
            <div class="bg-white rounded border border-gray-200 p-3 hover:border-orange-300 transition-colors">
                <div class="flex justify-between items-start mb-2">
                    <div>
                        <div class="text-xs font-medium text-gray-500 uppercase tracking-wider">Overdue (SLA)</div>
                        <div class="text-lg font-bold text-gray-800 mt-1" id="statSla">--</div>
                    </div>
                    <div class="w-8 h-8 rounded bg-orange-50 flex items-center justify-center">
                        <i class="fas fa-exclamation-triangle text-orange-500 text-sm"></i>
                    </div>
                </div>
                <div class="text-xs text-red-500 font-medium">Critical</div>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-5">
            <!-- Status Chart -->
            <div class="bg-white rounded border border-gray-200 p-3">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="font-medium text-gray-800">Ticket Status Distribution</h3>
                    <span class="text-xs text-gray-500">Today</span>
                </div>
                <div class="h-48">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>

            <!-- Priority Chart -->
            <div class="bg-white rounded border border-gray-200 p-3">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="font-medium text-gray-800">Tickets by Priority</h3>
                    <span class="text-xs text-gray-500">Today</span>
                </div>
                <div class="h-48">
                    <canvas id="priorityChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Engineer Status & Recent Activity -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <!-- Engineer Status -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded border border-gray-200 p-3">
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="font-medium text-gray-800">Engineer Status</h3>
                        <span class="text-xs text-gray-500" id="engineerCount">-- online</span>
                    </div>
                    <div class="space-y-2 max-h-64 overflow-y-auto pr-2" id="engineerList">
                        <div class="animate-pulse flex items-center space-x-3">
                            <div class="rounded-full bg-gray-200 h-7 w-7"></div>
                            <div class="flex-1">
                                <div class="h-2 bg-gray-200 rounded w-24"></div>
                                <div class="h-2 bg-gray-200 rounded w-16 mt-1.5"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="bg-white rounded border border-gray-200 p-3">
                <h3 class="font-medium text-gray-800 mb-3">Quick Actions</h3>
                <div class="space-y-2">
                    <a href="@Url.Action("Tickets", "ServiceDesk")"
                       class="flex items-center gap-2 p-2 text-sm text-gray-700 hover:bg-blue-50 rounded border border-gray-100 hover:border-blue-200 transition-colors">
                        <div class="w-7 h-7 rounded bg-blue-100 flex items-center justify-center">
                            <i class="fas fa-list text-blue-600 text-xs"></i>
                        </div>
                        <span>View All Tickets</span>
                        <i class="fas fa-arrow-right ml-auto text-gray-400 text-xs"></i>
                    </a>
                    @if (canCreate)
                    {
                        <a href="@Url.Action("CreateTicket", "ServiceDesk")"
                           class="flex items-center gap-2 p-2 text-sm text-gray-700 hover:bg-emerald-50 rounded border border-gray-100 hover:border-emerald-200 transition-colors">
                            <div class="w-7 h-7 rounded bg-emerald-100 flex items-center justify-center">
                                <i class="fas fa-plus text-emerald-600 text-xs"></i>
                            </div>
                            <span>New Ticket</span>
                            <i class="fas fa-arrow-right ml-auto text-gray-400 text-xs"></i>
                        </a>
                    }
                    <a href="#" onclick="loadStats()"
                       class="flex items-center gap-2 p-2 text-sm text-gray-700 hover:bg-amber-50 rounded border border-gray-100 hover:border-amber-200 transition-colors">
                        <div class="w-7 h-7 rounded bg-amber-100 flex items-center justify-center">
                            <i class="fas fa-sync-alt text-amber-600 text-xs"></i>
                        </div>
                        <span>Refresh Data</span>
                        <i class="fas fa-arrow-right ml-auto text-gray-400 text-xs"></i>
                    </a>
                    <a href="#"
                       class="flex items-center gap-2 p-2 text-sm text-gray-700 hover:bg-purple-50 rounded border border-gray-100 hover:border-purple-200 transition-colors">
                        <div class="w-7 h-7 rounded bg-purple-100 flex items-center justify-center">
                            <i class="fas fa-chart-bar text-purple-600 text-xs"></i>
                        </div>
                        <span>Reports</span>
                        <i class="fas fa-arrow-right ml-auto text-gray-400 text-xs"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            // Set date
            const options = { weekday: 'short', month: 'short', day: 'numeric' };
            $('#currentDate').text(new Date().toLocaleDateString('en-US', options));

            loadInitialData();
            loadStats();
            loadEngineers();

            $('#companyFilter').on('change', function() {
                const cid = $(this).val();
                loadLocations(cid);
                loadStats();
                loadEngineers();
            });

            $('#locationFilter').on('change', function() {
                loadStats();
                loadEngineers();
            });
        });

        function loadInitialData() {
            $.get('@Url.Action("GetCompanies", "ServiceDesk")', function(companies) {
                const select = $('#companyFilter');
                select.empty().append('<option value="">All Companies</option>');
                if (companies && companies.length > 0) {
                    // Handle both response formats
                    companies.forEach(function(c) {
                        // Try multiple property names
                        const companyId = c.id || c.companyId || c.Id;
                        const companyName = c.name || c.companyName || c.Name || 'Unknown Company';
                        select.append(`<option value="${companyId}">${companyName}</option>`);
                    });
                }
            }).fail(function(xhr, status, error) {
                console.error('Failed to load companies:', error);
            });
        }

        function loadLocations(companyId) {
            const select = $('#locationFilter');
            select.html('<option value="">All Locations</option>');
            if (!companyId) return;

            $.get(`@Url.Action("GetLocations", "ServiceDesk")?companyId=${companyId}`, function(locations) {
                if (locations && locations.length > 0) {
                    // Handle both response formats
                    locations.forEach(function(l) {
                        const locationId = l.id || l.locationId || l.Id;
                        const locationName = l.name || l.locationName || l.Name || 'Unknown Location';
                        select.append(`<option value="${locationId}">${locationName}</option>`);
                    });
                }
            }).fail(function(xhr, status, error) {
                console.error('Failed to load locations:', error);
            });
        }

        let statusChart = null;
        let priorityChart = null;

        function loadStats() {
            const companyId = $('#companyFilter').val();
            const locationId = $('#locationFilter').val();
            const query = `?companyId=${companyId || ''}&locationId=${locationId || ''}`;

            $.ajax({
                url: '@Url.Action("GetStats", "ServiceDesk")' + query,
                type: 'GET',
                success: function(data) {
                    // Update Cards
                    $('#statTotal').text(data.totalCount || 0);
                    $('#statNewToday').text(data.todayCreated || 0);
                    $('#statOpen').text(data.openCount || 0);
                    $('#statResolved').text(data.todayResolved || 0);
                    $('#statSla').text(data.slaBreachedCount || 0);

                    // Render Charts
                    renderCharts(data);
                },
                error: function(err) {
                    console.error("Failed to load stats", err);
                }
            });
        }

        function renderCharts(data) {
            if (statusChart) statusChart.destroy();
            if (priorityChart) priorityChart.destroy();

            // Status Chart (Doughnut)
            const ctxStatus = document.getElementById('statusChart').getContext('2d');
            const statusLabels = data.statusBreakdown ? data.statusBreakdown.map(s => s.status) : [];
            const statusValues = data.statusBreakdown ? data.statusBreakdown.map(s => s.count) : [];

            statusChart = new Chart(ctxStatus, {
                type: 'doughnut',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusValues,
                        backgroundColor: ['#EF4444', '#3B82F6', '#F59E0B', '#10B981', '#6B7280'],
                        borderWidth: 1,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                font: { size: 9 },
                                padding: 10
                            }
                        }
                    },
                    cutout: '70%'
                }
            });

            // Priority Chart (Bar)
            const ctxPriority = document.getElementById('priorityChart').getContext('2d');
            const priorityLabels = data.priorityBreakdown ? data.priorityBreakdown.map(p => p.priority) : [];
            const priorityValues = data.priorityBreakdown ? data.priorityBreakdown.map(p => p.count) : [];

            priorityChart = new Chart(ctxPriority, {
                type: 'bar',
                data: {
                    labels: priorityLabels,
                    datasets: [{
                        data: priorityValues,
                        backgroundColor: function(context) {
                            const val = context.chart.data.labels[context.dataIndex];
                            if (val === 'Urgent') return '#DC2626';
                            if (val === 'High') return '#F97316';
                            if (val === 'Medium') return '#3B82F6';
                            return '#10B981';
                        }
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { display: true },
                            ticks: { stepSize: 1, font: { size: 9 } }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 9 } }
                        }
                    }
                }
            });
        }

        function loadEngineers() {
            const cid = $('#companyFilter').val() || '';
            const lid = $('#locationFilter').val() || '';
            $.ajax({
                url: `@Url.Action("GetEngineers", "ServiceDesk")?companyId=${cid}&locationId=${lid}`,
                type: 'GET',
                success: function(data) {
                    const list = $('#engineerList');
                    list.empty();

                    $('#engineerCount').text(data ? `${data.length} online` : '0 online');

                    if(data && data.length > 0) {
                        data.forEach(eng => {
                            const statusColor = eng.activeTickets >= 3 ? 'bg-red-500' : 'bg-green-500';
                            const html = `
                                <div class="flex items-center justify-between p-2 hover:bg-gray-50 rounded transition-colors">
                                    <div class="flex items-center gap-2">
                                        <div class="relative">
                                            <div class="w-7 h-7 rounded-full bg-gray-200 flex items-center justify-center text-gray-600 text-xs font-bold">
                                                ${eng.name ? eng.name.charAt(0).toUpperCase() : '?'}
                                            </div>
                                            <span class="absolute -bottom-0.5 -right-0.5 w-2 h-2 ${statusColor} rounded-full border border-white"></span>
                                        </div>
                                        <div>
                                            <div class="text-sm font-medium text-gray-800">${eng.name || 'Unknown Engineer'}</div>
                                            <div class="text-xs text-gray-500">${eng.activeTickets || 0} active tickets</div>
                                        </div>
                                    </div>
                                    <span class="text-xs ${eng.activeTickets >= 3 ? 'text-red-600' : 'text-green-600'}">
                                        ${eng.activeTickets >= 3 ? 'Busy' : 'Available'}
                                    </span>
                                </div>
                            `;
                            list.append(html);
                        });
                    } else {
                        list.html('<div class="text-center text-gray-400 py-4 text-sm">No engineers found</div>');
                    }
                },
                error: function() {
                    $('#engineerList').html('<div class="text-center text-red-400 py-4 text-sm">Failed to load engineers</div>');
                }
            });
        }
    </script>
}