@{
    ViewData["Title"] = "Service Desk Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bg-gray-50 min-h-screen p-8">
    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-slate-800">Help Desk Overview</h1>
            <p class="text-slate-500 mt-1">Real-time insights and ticket management.</p>
        </div>
        <div>
            <a href="@Url.Action("CreateTicket", "ServiceDesk")" class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg shadow-sm transition-colors duration-200">
                <i class="fas fa-plus mr-2"></i> New Request
            </a>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <!-- Total Tickets -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 flex items-start justify-between hover:shadow-md transition-shadow">
            <div>
                <p class="text-sm font-medium text-slate-500 uppercase tracking-wide">Total Tickets</p>
                <h3 class="text-3xl font-bold text-slate-800 mt-2" id="totalTickets">--</h3>
            </div>
            <div class="p-3 bg-blue-50 rounded-lg">
                <i class="fas fa-ticket-alt text-blue-600 text-xl"></i>
            </div>
        </div>

        <!-- Open Tickets -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 flex items-start justify-between hover:shadow-md transition-shadow">
            <div>
                <p class="text-sm font-medium text-slate-500 uppercase tracking-wide">Open</p>
                <h3 class="text-3xl font-bold text-red-600 mt-2" id="openTickets">--</h3>
            </div>
            <div class="p-3 bg-red-50 rounded-lg">
                <i class="fas fa-exclamation-circle text-red-600 text-xl"></i>
            </div>
        </div>

        <!-- In Progress - (Assigned) -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 flex items-start justify-between hover:shadow-md transition-shadow">
            <div>
                <p class="text-sm font-medium text-slate-500 uppercase tracking-wide">In Progress</p>
                <h3 class="text-3xl font-bold text-amber-600 mt-2" id="assignedTickets">--</h3>
                <span class="text-xs text-slate-400">Assigned / InProgress</span>
            </div>
            <div class="p-3 bg-amber-50 rounded-lg">
                <i class="fas fa-spinner text-amber-600 text-xl"></i>
            </div>
        </div>

        <!-- Resolved -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 flex items-start justify-between hover:shadow-md transition-shadow">
            <div>
                <p class="text-sm font-medium text-slate-500 uppercase tracking-wide">Resolved</p>
                <h3 class="text-3xl font-bold text-emerald-600 mt-2" id="resolvedTickets">--</h3>
            </div>
            <div class="p-3 bg-emerald-50 rounded-lg">
                <i class="fas fa-check-circle text-emerald-600 text-xl"></i>
            </div>
        </div>
    </div>
    
    <!-- Secondary Stats -->
     <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex items-center justify-between">
              <span class="text-slate-600 font-medium">SLA Breached</span>
              <span class="text-red-600 font-bold bg-red-50 px-3 py-1 rounded-full" id="slaBreaches">--</span>
          </div>
          <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex items-center justify-between">
              <span class="text-slate-600 font-medium">Created Today</span>
              <span class="text-blue-600 font-bold bg-blue-50 px-3 py-1 rounded-full" id="todayCreated">--</span>
          </div>
          <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex items-center justify-between">
               <span class="text-slate-600 font-medium">Resolved Today</span>
               <span class="text-emerald-600 font-bold bg-emerald-50 px-3 py-1 rounded-full" id="todayResolved">--</span>
           </div>
     </div>

    <!-- Recent Tickets Table -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-gray-50/50">
            <h2 class="text-lg font-bold text-slate-800">Recent Requests</h2>
            <a href="@Url.Action("Tickets", "ServiceDesk")" class="text-sm font-medium text-blue-600 hover:text-blue-800">View All Requests <i class="fas fa-arrow-right ml-1"></i></a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 text-slate-500 text-sm border-b border-slate-200">
                        <th class="px-6 py-4 font-semibold">TICKET ID</th>
                        <th class="px-6 py-4 font-semibold">SUBJECT</th>
                        <th class="px-6 py-4 font-semibold">REQUESTER</th>
                        <th class="px-6 py-4 font-semibold">PRIORITY</th>
                        <th class="px-6 py-4 font-semibold">STATUS</th>
                        <th class="px-6 py-4 font-semibold">CREATED</th>
                    </tr>
                </thead>
                <tbody id="recentTicketsTable">
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-slate-400">
                            <i class="fas fa-circle-notch fa-spin mr-2"></i> Loading tickets...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadStats();
            loadRecentTickets();
            // Refresh every 60 seconds
            setInterval(() => {
                loadStats();
                loadRecentTickets();
            }, 60000);
        });

        function loadStats() {
            $.get('@Url.Action("GetStats", "ServiceDesk")', function (data) {
                $('#totalTickets').text(data.totalCount || 0);
                $('#openTickets').text(data.openCount || 0);
                $('#assignedTickets').text((data.assignedCount + data.inProgressCount) || 0);
                $('#resolvedTickets').text(data.resolvedCount || 0);
                
                $('#slaBreaches').text(data.slaBreachedCount || 0);
                $('#todayCreated').text(data.todayCreated || 0);
                $('#todayResolved').text(data.todayResolved || 0);
            });
        }

        function loadRecentTickets() {
            $.get('@Url.Action("GetTickets", "ServiceDesk")', function (data) {
                var rows = '';
                // Show max 5
                var recent = data.slice(0, 5); 
                
                if (recent.length === 0) {
                    rows = '<tr><td colspan="6" class="px-6 py-8 text-center text-slate-500">No recent tickets found.</td></tr>';
                } else {
                    $.each(recent, function (i, item) {
                        rows += `
                            <tr class="border-b border-slate-50 hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4 font-medium text-slate-800">#${item.ticketNo || item.id}</td>
                                <td class="px-6 py-4 text-slate-600 font-medium">${item.subject || 'No Subject'}</td>
                                <td class="px-6 py-4 text-slate-500">
                                    <div class="flex items-center">
                                        <div class="h-6 w-6 rounded-full bg-slate-200 text-xs flex items-center justify-center mr-2 text-slate-600 font-bold">${(item.requesterName || 'U').charAt(0)}</div>
                                        ${item.requesterName || 'Unknown'}
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${getPriorityClass(item.priority)}">
                                        ${item.priority || 'Medium'}
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${getStatusClass(item.status)}">
                                        ${item.status || 'Open'}
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-slate-400 text-sm">${new Date(item.createdOn).toLocaleDateString()}</td>
                            </tr>`;
                    });
                }
                $('#recentTicketsTable').html(rows);
            });
        }

        function getPriorityClass(p) {
            if (!p) return 'bg-gray-100 text-gray-800';
            p = p.toLowerCase();
            if (p === 'high' || p === 'urgent') return 'bg-red-100 text-red-800';
            if (p === 'medium') return 'bg-amber-100 text-amber-800';
            return 'bg-green-100 text-green-800'; // Low
        }

        function getStatusClass(s) {
            if (!s) return 'bg-gray-100 text-gray-800';
            s = s.toLowerCase();
            if (s === 'open') return 'bg-red-50 text-red-700 border border-red-200';
            if (s === 'assigned' || s.includes('progress')) return 'bg-amber-50 text-amber-700 border border-amber-200';
            if (s === 'resolved' || s === 'closed') return 'bg-emerald-50 text-emerald-700 border border-emerald-200';
            return 'bg-gray-100 text-gray-800';
        }
    </script>
}
