@model ManageEngineWebApp.Controllers.ServiceDeskViewModel
@{
    ViewData["Title"] = "Service Desk";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var username = Context.Session.GetString("username");
    var userRole = Context.Session.GetString("role");
    var isSuperAdmin = userRole == "SuperAdmin";
    var isAdmin = isSuperAdmin || userRole == "CompanyAdmin" || userRole == "LocationAdmin";
    var isEngineer = userRole == "Engineer" || userRole == "Technician";
}

<style>
    .ticket-card {
        transition: all 0.2s ease;
    }
    .ticket-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }
    .status-badge { font-size: 10px; padding: 3px 8px; border-radius: 4px; font-weight: 600; text-transform: uppercase; }
    .priority-indicator { width: 4px; border-radius: 4px 0 0 4px; }
    .priority-critical { background: linear-gradient(180deg, #dc2626, #b91c1c); }
    .priority-high { background: linear-gradient(180deg, #ea580c, #c2410c); }
    .priority-medium { background: linear-gradient(180deg, #d97706, #b45309); }
    .priority-low { background: linear-gradient(180deg, #16a34a, #15803d); }
    .tab-active { border-bottom: 2px solid #0891b2; color: #0891b2; }
    .tab-inactive { color: #6b7280; }
    .filter-chip { font-size: 11px; padding: 4px 10px; border-radius: 20px; cursor: pointer; transition: all 0.15s; }
    .filter-chip:hover { opacity: 0.9; }
    .filter-chip.active { box-shadow: 0 0 0 2px rgba(255,255,255,0.8) inset; }
    .sla-warning { animation: pulse 2s infinite; }
    @@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.6; } }
</style>

<div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <div class="bg-white border-b sticky top-0 z-40">
        <div class="max-w-full mx-auto px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-lg flex items-center justify-center shadow-md bg-gradient-to-br from-cyan-500 to-blue-600">
                        <i class="fas fa-headset text-white text-base"></i>
                    </div>
                    <div>
                        <h1 class="text-lg font-bold text-gray-900">Service Desk</h1>
                        <p class="text-[10px] text-gray-500 hidden sm:block">Incident & Request Management</p>
                    </div>
                </div>
                <div class="flex items-center space-x-2">
                    <div class="relative hidden md:block">
                        <input type="text" id="globalSearch" placeholder="Search tickets..." 
                               class="w-56 pl-8 pr-3 py-1.5 text-xs border border-gray-200 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent">
                        <i class="fas fa-search absolute left-2.5 top-2 text-gray-400 text-xs"></i>
                    </div>
                    <button onclick="refreshTickets()" class="p-2 text-gray-600 hover:bg-gray-100 rounded-lg" title="Refresh">
                        <i class="fas fa-sync-alt text-sm"></i>
                    </button>
                    <button onclick="openCreateTicketModal()" class="px-3 py-1.5 text-white rounded-lg text-xs font-semibold flex items-center space-x-1 shadow-sm bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-600 hover:to-blue-700">
                        <i class="fas fa-plus"></i>
                        <span>New Ticket</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-full mx-auto px-4 py-4">
        <!-- Stats Row -->
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3 mb-4">
            <div class="bg-white rounded-lg border p-3 cursor-pointer hover:shadow-md transition filter-stat" data-status="all">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-[10px] font-bold text-gray-400 uppercase">All Tickets</p>
                        <p class="text-xl font-bold text-gray-900" id="statAll">@Model.TotalCount</p>
                    </div>
                    <div class="w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center">
                        <i class="fas fa-ticket-alt text-gray-600 text-sm"></i>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-lg border p-3 cursor-pointer hover:shadow-md transition filter-stat" data-status="Open">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-[10px] font-bold text-green-500 uppercase">Open</p>
                        <p class="text-xl font-bold text-gray-900" id="statOpen">@Model.OpenCount</p>
                    </div>
                    <div class="w-8 h-8 rounded-lg bg-green-100 flex items-center justify-center">
                        <i class="fas fa-folder-open text-green-600 text-sm"></i>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-lg border p-3 cursor-pointer hover:shadow-md transition filter-stat" data-status="Assigned">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-[10px] font-bold text-blue-500 uppercase">Assigned</p>
                        <p class="text-xl font-bold text-gray-900" id="statAssigned">@Model.AssignedCount</p>
                    </div>
                    <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center">
                        <i class="fas fa-user-check text-blue-600 text-sm"></i>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-lg border p-3 cursor-pointer hover:shadow-md transition filter-stat" data-status="InProgress">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-[10px] font-bold text-yellow-500 uppercase">In Progress</p>
                        <p class="text-xl font-bold text-gray-900" id="statInProgress">@Model.InProgressCount</p>
                    </div>
                    <div class="w-8 h-8 rounded-lg bg-yellow-100 flex items-center justify-center">
                        <i class="fas fa-spinner text-yellow-600 text-sm"></i>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-lg border p-3 cursor-pointer hover:shadow-md transition filter-stat" data-status="OnHold">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-[10px] font-bold text-orange-500 uppercase">On Hold</p>
                        <p class="text-xl font-bold text-gray-900" id="statOnHold">@Model.OnHoldCount</p>
                    </div>
                    <div class="w-8 h-8 rounded-lg bg-orange-100 flex items-center justify-center">
                        <i class="fas fa-pause-circle text-orange-600 text-sm"></i>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-lg border p-3 cursor-pointer hover:shadow-md transition filter-stat" data-status="Resolved">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-[10px] font-bold text-purple-500 uppercase">Resolved</p>
                        <p class="text-xl font-bold text-gray-900" id="statResolved">@Model.ResolvedCount</p>
                    </div>
                    <div class="w-8 h-8 rounded-lg bg-purple-100 flex items-center justify-center">
                        <i class="fas fa-check-circle text-purple-600 text-sm"></i>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-lg border p-3 cursor-pointer hover:shadow-md transition filter-stat" data-status="Closed">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-[10px] font-bold text-gray-500 uppercase">Closed</p>
                        <p class="text-xl font-bold text-gray-900" id="statClosed">@Model.ClosedCount</p>
                    </div>
                    <div class="w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center">
                        <i class="fas fa-archive text-gray-600 text-sm"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Filters Row -->
        <div class="flex flex-wrap items-center gap-2 mb-4">
            <span class="text-xs text-gray-500 font-medium mr-2">Filter:</span>
            <button class="filter-chip bg-red-500 text-white active" data-priority="Critical"><i class="fas fa-fire mr-1"></i>Critical</button>
            <button class="filter-chip bg-orange-500 text-white" data-priority="High"><i class="fas fa-arrow-up mr-1"></i>High</button>
            <button class="filter-chip bg-yellow-500 text-white" data-priority="Medium"><i class="fas fa-minus mr-1"></i>Medium</button>
            <button class="filter-chip bg-green-500 text-white" data-priority="Low"><i class="fas fa-arrow-down mr-1"></i>Low</button>
            <span class="text-gray-300 mx-2">|</span>
            <button class="filter-chip bg-red-100 text-red-700" data-sla="breached"><i class="fas fa-exclamation-triangle mr-1"></i>SLA Breached</button>
            <button class="filter-chip bg-cyan-100 text-cyan-700" data-assigned="me"><i class="fas fa-user mr-1"></i>Assigned to Me</button>
            <button class="filter-chip bg-purple-100 text-purple-700" data-created="me"><i class="fas fa-edit mr-1"></i>Created by Me</button>
        </div>

        <div class="flex gap-4">
            <!-- Main Ticket List -->
            <div class="flex-1">
                <div class="bg-white rounded-lg border shadow-sm overflow-hidden">
                    <!-- Table Header -->
                    <div class="grid grid-cols-12 gap-2 px-4 py-2 bg-gray-50 border-b text-[10px] font-bold text-gray-500 uppercase">
                        <div class="col-span-1">ID</div>
                        <div class="col-span-3">Subject</div>
                        <div class="col-span-2">Requester</div>
                        <div class="col-span-1">Priority</div>
                        <div class="col-span-1">Status</div>
                        <div class="col-span-2">Assigned To</div>
                        <div class="col-span-1">Created</div>
                        <div class="col-span-1 text-right">Actions</div>
                    </div>
                    
                    <!-- Ticket Rows -->
                    <div id="ticketListContainer">
                        @foreach (var ticket in Model.Tickets)
                        {
                            var priorityClass = ticket.Priority switch {
                                "Critical" => "priority-critical",
                                "High" => "priority-high",
                                "Medium" => "priority-medium",
                                _ => "priority-low"
                            };
                            var statusClass = ticket.Status switch {
                                "Open" => "bg-green-100 text-green-700",
                                "Assigned" => "bg-blue-100 text-blue-700",
                                "InProgress" => "bg-yellow-100 text-yellow-700",
                                "OnHold" => "bg-orange-100 text-orange-700",
                                "Resolved" => "bg-purple-100 text-purple-700",
                                "Closed" => "bg-gray-100 text-gray-600",
                                "Rejected" => "bg-red-100 text-red-700",
                                _ => "bg-gray-100 text-gray-600"
                            };
                            <div class="ticket-card grid grid-cols-12 gap-2 px-4 py-3 border-b hover:bg-cyan-50/30 cursor-pointer items-center" 
                                 onclick="openTicketDetails(@ticket.Id)">
                                <div class="col-span-1 flex items-center">
                                    <div class="@priorityClass priority-indicator h-10 mr-2"></div>
                                    <span class="text-xs font-bold text-cyan-600">#@ticket.TicketNo</span>
                                </div>
                                <div class="col-span-3">
                                    <p class="text-xs font-semibold text-gray-800 truncate">@ticket.Subject</p>
                                    <p class="text-[10px] text-gray-400 truncate">@ticket.Category • @ticket.DomainName</p>
                                </div>
                                <div class="col-span-2">
                                    <div class="flex items-center">
                                        <div class="w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center text-[10px] font-bold text-gray-600 mr-2">
                                            @(string.IsNullOrEmpty(ticket.RequesterName) ? "?" : ticket.RequesterName.Substring(0,1).ToUpper())
                                        </div>
                                        <div>
                                            <p class="text-xs font-medium text-gray-700">@ticket.RequesterName</p>
                                            <p class="text-[9px] text-gray-400">@ticket.LocationName</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-span-1">
                                    <span class="text-[10px] font-bold uppercase @(ticket.Priority == "Critical" ? "text-red-600" : ticket.Priority == "High" ? "text-orange-600" : ticket.Priority == "Medium" ? "text-yellow-600" : "text-green-600")">
                                        @ticket.Priority
                                    </span>
                                </div>
                                <div class="col-span-1">
                                    <span class="status-badge @statusClass">@ticket.Status</span>
                                </div>
                                <div class="col-span-2">
                                    @if (!string.IsNullOrEmpty(ticket.AssignedToName))
                                    {
                                        <div class="flex items-center">
                                            <div class="w-6 h-6 rounded-full bg-cyan-100 border border-cyan-200 flex items-center justify-center text-[10px] font-bold text-cyan-600 mr-2">
                                                @ticket.AssignedToName.Substring(0,1).ToUpper()
                                            </div>
                                            <span class="text-xs text-gray-700">@ticket.AssignedToName</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-[10px] text-gray-400 italic">Unassigned</span>
                                    }
                                </div>
                                <div class="col-span-1">
                                    <p class="text-[10px] text-gray-500">@ticket.CreatedDate.ToString("MMM dd")</p>
                                    <p class="text-[9px] text-gray-400">@ticket.CreatedDate.ToString("HH:mm")</p>
                                </div>
                                <div class="col-span-1 text-right">
                                    <div class="flex items-center justify-end space-x-1">
                                        @if (isAdmin || isEngineer)
                                        {
                                            <button onclick="event.stopPropagation(); openAssignModal(@ticket.Id, '@ticket.Subject.Replace("'", "\\'")')" 
                                                    class="p-1.5 text-blue-600 hover:bg-blue-100 rounded" title="Assign">
                                                <i class="fas fa-user-plus text-xs"></i>
                                            </button>
                                        }
                                        <button onclick="event.stopPropagation(); openTicketDetails(@ticket.Id)" 
                                                class="p-1.5 text-gray-600 hover:bg-gray-100 rounded" title="View Details">
                                            <i class="fas fa-eye text-xs"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (!Model.Tickets.Any())
                        {
                            <div class="p-10 text-center text-gray-400">
                                <i class="fas fa-ticket-alt text-4xl mb-3"></i>
                                <p class="text-sm">No tickets found</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Ticket Modal -->
<div id="createTicketModal" class="fixed inset-0 bg-black bg-opacity-50 backdrop-blur-sm z-50 hidden items-center justify-center">
    <div class="bg-white rounded-lg shadow-2xl max-w-lg w-full mx-3 max-h-[90vh] overflow-y-auto">
        <div class="px-4 py-3 rounded-t-lg flex items-center justify-between bg-gradient-to-r from-cyan-500 to-blue-600 sticky top-0">
            <h3 class="text-sm font-bold text-white"><i class="fas fa-plus-circle mr-2"></i>Create New Ticket</h3>
            <button onclick="closeCreateTicketModal()" class="text-white hover:text-gray-200 text-sm">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="p-4">
            <div class="grid grid-cols-2 gap-3 mb-3">
                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Category *</label>
                    <select id="ticketCategory" class="w-full px-3 py-2 text-xs border border-gray-300 rounded focus:ring-2 focus:ring-cyan-500">
                        <option value="">Select Category</option>
                        <option value="Hardware">Hardware</option>
                        <option value="Software">Software</option>
                        <option value="Network">Network</option>
                        <option value="Email">Email</option>
                        <option value="Account">Account/Access</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Priority *</label>
                    <select id="ticketPriority" class="w-full px-3 py-2 text-xs border border-gray-300 rounded focus:ring-2 focus:ring-cyan-500">
                        <option value="Low">Low</option>
                        <option value="Medium" selected>Medium</option>
                        <option value="High">High</option>
                        <option value="Critical">Critical</option>
                    </select>
                </div>
            </div>
            <div class="mb-3">
                <label class="block text-xs font-semibold text-gray-700 mb-1">Subject *</label>
                <input type="text" id="ticketSubject" maxlength="200"
                       class="w-full px-3 py-2 text-xs border border-gray-300 rounded focus:ring-2 focus:ring-cyan-500"
                       placeholder="Brief description of the issue">
            </div>
            <div class="mb-3">
                <label class="block text-xs font-semibold text-gray-700 mb-1">Description *</label>
                <textarea id="ticketDescription" rows="4"
                       class="w-full px-3 py-2 text-xs border border-gray-300 rounded focus:ring-2 focus:ring-cyan-500"
                       placeholder="Detailed description of the issue, steps to reproduce, etc."></textarea>
            </div>
            <div class="grid grid-cols-2 gap-3 mb-3">
                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Location</label>
                    <select id="ticketLocation" class="w-full px-3 py-2 text-xs border border-gray-300 rounded focus:ring-2 focus:ring-cyan-500">
                        <option value="">Select Location</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Device/Computer</label>
                    <input type="text" id="ticketDevice" 
                           class="w-full px-3 py-2 text-xs border border-gray-300 rounded focus:ring-2 focus:ring-cyan-500"
                           placeholder="e.g., DESKTOP-ABC123">
                </div>
            </div>
            <div class="mb-3">
                <label class="block text-xs font-semibold text-gray-700 mb-1">Attachments</label>
                <input type="file" id="ticketAttachments" multiple
                       class="w-full text-xs border border-gray-300 rounded p-1.5 file:mr-3 file:py-1 file:px-3 file:rounded file:border-0 file:text-xs file:font-medium file:bg-cyan-50 file:text-cyan-700">
            </div>
            <div id="createTicketMessage" class="mt-3 p-2 rounded text-xs font-medium hidden"></div>
            <div class="flex justify-end space-x-2 mt-4">
                <button onclick="closeCreateTicketModal()" class="px-3 py-1.5 text-xs bg-gray-100 text-gray-700 rounded hover:bg-gray-200 font-medium">
                    Cancel
                </button>
                <button onclick="submitCreateTicket()" id="createTicketBtn"
                        class="px-3 py-1.5 text-xs text-white rounded font-medium shadow-sm bg-gradient-to-r from-cyan-500 to-blue-600">
                    <i class="fas fa-paper-plane mr-1"></i>Submit Ticket
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Assign Engineer Modal -->
<div id="assignModal" class="fixed inset-0 bg-black bg-opacity-50 backdrop-blur-sm z-50 hidden items-center justify-center">
    <div class="bg-white rounded-lg shadow-2xl max-w-sm w-full mx-3">
        <div class="px-4 py-3 rounded-t-lg flex items-center justify-between bg-gradient-to-r from-blue-500 to-indigo-600">
            <h3 class="text-sm font-bold text-white"><i class="fas fa-user-plus mr-2"></i>Assign Engineer</h3>
            <button onclick="closeAssignModal()" class="text-white hover:text-gray-200 text-sm">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="p-4">
            <input type="hidden" id="assignTicketId">
            <p class="text-xs text-gray-600 mb-3" id="assignTicketSubject">Ticket: Loading...</p>
            
            <div class="mb-3">
                <label class="block text-xs font-semibold text-gray-700 mb-1">Location Filter</label>
                <select id="engineerLocationFilter" class="w-full px-3 py-2 text-xs border border-gray-300 rounded">
                    <option value="">All Locations</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="block text-xs font-semibold text-gray-700 mb-1">Select Engineer *</label>
                <select id="engineerSelect" class="w-full px-3 py-2 text-xs border border-gray-300 rounded">
                    <option value="">Loading engineers...</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="block text-xs font-semibold text-gray-700 mb-1">Assignment Notes</label>
                <textarea id="assignmentNotes" rows="2"
                       class="w-full px-3 py-2 text-xs border border-gray-300 rounded"
                       placeholder="Optional notes for the engineer..."></textarea>
            </div>
            <div id="assignMessage" class="mt-3 p-2 rounded text-xs font-medium hidden"></div>
            <div class="flex justify-end space-x-2 mt-4">
                <button onclick="closeAssignModal()" class="px-3 py-1.5 text-xs bg-gray-100 text-gray-700 rounded hover:bg-gray-200 font-medium">
                    Cancel
                </button>
                <button onclick="submitAssignment()" id="assignBtn"
                        class="px-3 py-1.5 text-xs text-white rounded font-medium shadow-sm bg-gradient-to-r from-blue-500 to-indigo-600">
                    <i class="fas fa-check mr-1"></i>Assign
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Ticket Details Slide Panel -->
<div id="ticketDetailsPanel" class="fixed inset-y-0 right-0 w-full md:w-2/3 lg:w-1/2 bg-white shadow-2xl z-50 hidden transform translate-x-full transition-transform duration-300">
    <div class="h-full flex flex-col">
        <div class="px-4 py-3 bg-gradient-to-r from-cyan-500 to-blue-600 flex items-center justify-between">
            <h3 class="text-sm font-bold text-white" id="detailsTicketNo">#INC000001</h3>
            <button onclick="closeTicketDetails()" class="text-white hover:text-gray-200">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="flex-1 overflow-y-auto" id="ticketDetailsContent">
            <p class="p-4 text-gray-500 text-sm">Loading ticket details...</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ============ MODAL HANDLERS ============
        function openCreateTicketModal() {
            document.getElementById('createTicketModal').classList.remove('hidden');
            document.getElementById('createTicketModal').classList.add('flex');
            loadLocationsForTicket();
        }
        
        function closeCreateTicketModal() {
            document.getElementById('createTicketModal').classList.add('hidden');
            document.getElementById('createTicketModal').classList.remove('flex');
        }
        
        function openAssignModal(ticketId, subject) {
            document.getElementById('assignTicketId').value = ticketId;
            document.getElementById('assignTicketSubject').innerText = 'Ticket: ' + subject;
            document.getElementById('assignModal').classList.remove('hidden');
            document.getElementById('assignModal').classList.add('flex');
            loadEngineersForAssignment();
        }
        
        function closeAssignModal() {
            document.getElementById('assignModal').classList.add('hidden');
            document.getElementById('assignModal').classList.remove('flex');
        }
        
        function openTicketDetails(ticketId) {
            const panel = document.getElementById('ticketDetailsPanel');
            panel.classList.remove('hidden');
            setTimeout(() => {
                panel.classList.remove('translate-x-full');
            }, 10);
            loadTicketDetails(ticketId);
        }
        
        function closeTicketDetails() {
            const panel = document.getElementById('ticketDetailsPanel');
            panel.classList.add('translate-x-full');
            setTimeout(() => {
                panel.classList.add('hidden');
            }, 300);
        }
        
        // ============ API FUNCTIONS ============
        function loadLocationsForTicket() {
            fetch('/Companies/GetLocations')
                .then(res => res.json())
                .then(data => {
                    const select = document.getElementById('ticketLocation');
                    select.innerHTML = '<option value="">Select Location</option>';
                    data.forEach(loc => {
                        select.innerHTML += `<option value="${loc.id}">${loc.locationName}</option>`;
                    });
                });
        }
        
        function loadEngineersForAssignment() {
            fetch('/ServiceDesk/GetEngineers')
                .then(res => res.json())
                .then(data => {
                    const select = document.getElementById('engineerSelect');
                    select.innerHTML = '<option value="">-- Select Engineer --</option>';
                    data.forEach(eng => {
                        select.innerHTML += `<option value="${eng.id || eng}">${eng.name || eng}</option>`;
                    });
                })
                .catch(() => {
                    // Fallback to old endpoint
                    fetch('/Tickets/GetEngineers')
                        .then(res => res.json())
                        .then(data => {
                            const select = document.getElementById('engineerSelect');
                            select.innerHTML = '<option value="">-- Select Engineer --</option>';
                            data.forEach(eng => {
                                select.innerHTML += `<option value="${eng}">${eng}</option>`;
                            });
                        });
                });
        }
        
        function loadTicketDetails(ticketId) {
            currentTicketId = ticketId;
            document.getElementById('ticketDetailsContent').innerHTML = '<p class="p-4 text-gray-500 text-sm">Loading ticket details...</p>';
            
            fetch(`/ServiceDesk/GetTicketDetails?id=${ticketId}`)
                .then(res => res.json())
                .then(ticket => {
                    document.getElementById('detailsTicketNo').innerText = '#' + ticket.ticketNo;
                    document.getElementById('ticketDetailsContent').innerHTML = buildTicketDetailsHtml(ticket);
                })
                .catch(() => {
                    document.getElementById('ticketDetailsContent').innerHTML = '<p class="p-4 text-red-500 text-sm">Error loading ticket details</p>';
                });
        }
        
        function buildTicketDetailsHtml(ticket) {
            return `
                <div class="p-4">
                    <div class="flex items-start justify-between mb-4">
                        <h2 class="text-xl font-bold text-gray-900">${ticket.subject}</h2>
                        <div class="flex flex-col items-end">
                            <span class="status-badge ${getStatusClass(ticket.status)} mb-1">${ticket.status}</span>
                            <span class="text-[10px] font-bold ${getPriorityTextClass(ticket.priority)}">${ticket.priority} Priority</span>
                        </div>
                    </div>
                    
                    <!-- Tabs -->
                    <div class="flex border-b mb-4">
                        <button onclick="switchDetailsTab('details-overview')" class="px-4 py-2 text-xs font-bold border-b-2 border-cyan-500 text-cyan-600 details-tab-btn" id="btn-details-overview">Overview</button>
                        <button onclick="switchDetailsTab('details-history')" class="px-4 py-2 text-xs font-bold text-gray-400 hover:text-gray-600 details-tab-btn" id="btn-details-history">Call History</button>
                        <button onclick="switchDetailsTab('details-logs')" class="px-4 py-2 text-xs font-bold text-gray-400 hover:text-gray-600 details-tab-btn" id="btn-details-logs">Work Logs</button>
                    </div>

                    <!-- Overview Content -->
                    <div id="details-overview" class="details-tab-content">
                        <div class="grid grid-cols-2 gap-4 mb-6 text-xs">
                            <div class="bg-gray-50 p-2 rounded"><span class="text-gray-400 block mb-1">Requester</span><span class="font-bold text-gray-700">${ticket.requesterName || 'N/A'}</span></div>
                            <div class="bg-gray-50 p-2 rounded"><span class="text-gray-400 block mb-1">Computer</span><span class="font-bold text-gray-700">${ticket.domainName || 'N/A'}</span></div>
                            <div class="bg-gray-50 p-2 rounded"><span class="text-gray-400 block mb-1">Category</span><span class="font-bold text-gray-700">${ticket.category || 'N/A'}</span></div>
                            <div class="bg-gray-50 p-2 rounded"><span class="text-gray-400 block mb-1">Assigned To</span><span class="font-bold text-cyan-600">${ticket.assignedToName || 'Unassigned'}</span></div>
                        </div>
                        
                        <div class="mb-6">
                            <h3 class="text-xs font-bold text-gray-800 mb-2 flex items-center"><i class="fas fa-align-left mr-2 text-cyan-500"></i>Description</h3>
                            <div class="text-xs text-gray-600 bg-cyan-50/30 p-4 rounded-lg border border-cyan-100 whitespace-pre-wrap leading-relaxed">${ticket.description || 'No description provided.'}</div>
                        </div>

                        ${ticket.resolution ? `
                        <div class="mb-6">
                            <h3 class="text-xs font-bold text-green-700 mb-2 flex items-center"><i class="fas fa-check-double mr-2"></i>Resolution</h3>
                            <div class="text-xs text-green-800 bg-green-50 p-4 rounded-lg border border-green-100 whitespace-pre-wrap">${ticket.resolution}</div>
                        </div>
                        ` : ''}

                        <div class="border-t pt-6">
                            <h3 class="text-xs font-bold text-gray-800 mb-3 uppercase tracking-wider">Ticket Actions</h3>
                            <div class="flex flex-wrap gap-2">
                                ${ticket.status === 'Resolved' ? `
                                    <button onclick="approveTicket(${ticket.id})" class="flex-1 px-4 py-2 text-xs bg-green-600 text-white rounded-lg font-bold shadow-sm hover:bg-green-700 transition">
                                        <i class="fas fa-check mr-2"></i>Approve & Close
                                    </button>
                                    <button onclick="rejectTicket(${ticket.id})" class="flex-1 px-4 py-2 text-xs bg-red-600 text-white rounded-lg font-bold shadow-sm hover:bg-red-700 transition">
                                        <i class="fas fa-times mr-2"></i>Reject & Reopen
                                    </button>
                                ` : `
                                    <button onclick="updateTicketStatus(${ticket.id}, 'InProgress')" class="px-4 py-2 text-xs bg-amber-100 text-amber-700 rounded-lg font-bold hover:bg-amber-200 transition">
                                        <i class="fas fa-play mr-2"></i>Start Work
                                    </button>
                                    <button onclick="openAssignModal(${ticket.id}, \`${ticket.subject.replace(/'/g, "\\'")}\`)" class="px-4 py-2 text-xs bg-blue-100 text-blue-700 rounded-lg font-bold hover:bg-blue-200 transition">
                                        <i class="fas fa-user-plus mr-2"></i>Assign
                                    </button>
                                    <button onclick="updateTicketStatus(${ticket.id}, 'Resolved')" class="px-4 py-2 text-xs bg-purple-100 text-purple-700 rounded-lg font-bold hover:bg-purple-200 transition">
                                        <i class="fas fa-check mr-2"></i>Resolve
                                    </button>
                                `}
                            </div>
                        </div>
                    </div>

                    <!-- History Content -->
                    <div id="details-history" class="details-tab-content hidden">
                        <div id="history-list" class="space-y-4 pt-2">
                             <p class="text-gray-400 text-xs text-center py-8">Loading history...</p>
                        </div>
                    </div>

                    <!-- Logs Content -->
                    <div id="details-logs" class="details-tab-content hidden">
                        <div id="logs-list" class="space-y-4 pt-2">
                             <p class="text-gray-400 text-xs text-center py-8">Loading work logs...</p>
                        </div>
                    </div>
                </div>
            `;
        }

        function switchDetailsTab(tabId) {
            $('.details-tab-content').addClass('hidden');
            $(`#${tabId}`).removeClass('hidden');
            $('.details-tab-btn').removeClass('border-b-2 border-cyan-500 text-cyan-600').addClass('text-gray-400');
            $(`#btn-${tabId}`).addClass('border-b-2 border-cyan-500 text-cyan-600').removeClass('text-gray-400');
            
            if (tabId === 'details-history') loadTicketHistory();
            if (tabId === 'details-logs') loadTicketWorkLogs();
        }

        var currentTicketId = null;

        function loadTicketHistory() {
            const container = document.getElementById('history-list');
            container.innerHTML = '<p class="text-gray-400 text-xs text-center py-8">Loading history...</p>';
            
            fetch(`/ServiceDesk/GetStatusHistory?ticketId=${currentTicketId}`)
                .then(res => res.json())
                .then(logs => {
                    if (logs.length === 0) {
                        container.innerHTML = '<p class="text-gray-400 text-xs text-center py-8">No history found</p>';
                        return;
                    }
                    let html = '';
                    logs.forEach(log => {
                        html += `
                            <div class="flex items-start space-x-3 p-3 bg-gray-50 rounded-lg border border-gray-100">
                                <div class="w-2 h-2 rounded-full bg-cyan-500 mt-1.5 shadow-sm shadow-cyan-200"></div>
                                <div class="flex-1">
                                    <div class="flex justify-between items-start mb-1">
                                        <p class="text-[11px] font-bold text-gray-700">${log.changedByName}</p>
                                        <p class="text-[9px] text-gray-400">${new Date(log.changedDate).toLocaleString()}</p>
                                    </div>
                                    <p class="text-[10px] text-gray-600">Changed status from <span class="font-semibold text-gray-500">${log.oldStatus}</span> to <span class="font-bold text-cyan-600">${log.newStatus}</span></p>
                                    ${log.remarks ? `<p class="text-[10px] text-gray-400 italic mt-1 border-l-2 border-gray-200 pl-2">"${log.remarks}"</p>` : ''}
                                </div>
                            </div>
                        `;
                    });
                    container.innerHTML = html;
                });
        }

        function loadTicketWorkLogs() {
            const container = document.getElementById('logs-list');
            container.innerHTML = '<p class="text-gray-400 text-xs text-center py-8">Loading work logs...</p>';
            
            fetch(`/ServiceDesk/GetWorkLogs?ticketId=${currentTicketId}`)
                .then(res => res.json())
                .then(logs => {
                    if (logs.length === 0) {
                        container.innerHTML = '<p class="text-gray-400 text-xs text-center py-8">No work logs found</p>';
                        return;
                    }
                    let html = '';
                    logs.forEach(log => {
                        html += `
                            <div class="p-3 bg-cyan-50/20 rounded-lg border border-cyan-100 mb-2">
                                <div class="flex justify-between items-start mb-2">
                                    <div>
                                        <p class="text-[11px] font-bold text-gray-800">${log.technicianName}</p>
                                        <p class="text-[9px] text-gray-400">${new Date(log.workDate).toLocaleDateString()} • ${log.callType}</p>
                                    </div>
                                    <span class="text-[10px] font-bold text-cyan-700 bg-cyan-100 px-2 py-0.5 rounded">${log.timeSpentMinutes} mins</span>
                                </div>
                                <p class="text-[10px] text-gray-600">${log.workDescription}</p>
                            </div>
                        `;
                    });
                    container.innerHTML = html;
                });
        }

        function approveTicket(id) {
            if (!confirm('Approve the resolution and close this ticket?')) return;
            fetch('/ServiceDesk/ApproveTicket', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(id)
            }).then(res => res.json()).then(res => {
                if (res.success) { alert('Ticket Approved'); location.reload(); }
            });
        }

        function rejectTicket(id) {
            const reason = prompt('Please provide reason for rejection:');
            if (reason === null) return;
            fetch('/ServiceDesk/RejectTicket', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(id)
            }).then(res => res.json()).then(res => {
                if (res.success) { alert('Ticket Rejected'); location.reload(); }
            });
        }
        
        function getStatusClass(status) {
            const classes = {
                'Open': 'bg-green-100 text-green-700',
                'Assigned': 'bg-blue-100 text-blue-700',
                'InProgress': 'bg-yellow-100 text-yellow-700',
                'OnHold': 'bg-orange-100 text-orange-700',
                'Resolved': 'bg-purple-100 text-purple-700',
                'Closed': 'bg-gray-100 text-gray-600',
                'Rejected': 'bg-red-100 text-red-700'
            };
            return classes[status] || 'bg-gray-100 text-gray-600';
        }
        
        function getPriorityTextClass(priority) {
            const classes = {
                'Critical': 'text-red-600',
                'High': 'text-orange-600',
                'Medium': 'text-yellow-600',
                'Low': 'text-green-600'
            };
            return classes[priority] || 'text-gray-600';
        }
        
        // ============ SUBMIT FUNCTIONS ============
        function submitCreateTicket() {
            const data = {
                Category: document.getElementById('ticketCategory').value,
                Priority: document.getElementById('ticketPriority').value,
                Subject: document.getElementById('ticketSubject').value,
                Description: document.getElementById('ticketDescription').value,
                LocationId: document.getElementById('ticketLocation').value,
                DomainName: document.getElementById('ticketDevice').value
            };
            
            if (!data.Category || !data.Subject || !data.Description) {
                showMessage('createTicketMessage', 'Please fill all required fields', 'error');
                return;
            }
            
            fetch('/ServiceDesk/CreateTicket', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(result => {
                if (result.success) {
                    showMessage('createTicketMessage', 'Ticket created successfully!', 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showMessage('createTicketMessage', result.message || 'Error creating ticket', 'error');
                }
            });
        }
        
        function submitAssignment() {
            const ticketId = document.getElementById('assignTicketId').value;
            const engineerId = document.getElementById('engineerSelect').value;
            const notes = document.getElementById('assignmentNotes').value;
            
            if (!engineerId) {
                showMessage('assignMessage', 'Please select an engineer', 'error');
                return;
            }
            
            fetch('/ServiceDesk/AssignTicket', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ TicketId: ticketId, EngineerId: engineerId, Notes: notes })
            })
            .then(res => res.json())
            .then(result => {
                if (result.success) {
                    showMessage('assignMessage', 'Ticket assigned successfully!', 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showMessage('assignMessage', result.message || 'Error assigning ticket', 'error');
                }
            });
        }
        
        function updateTicketStatus(ticketId, newStatus) {
            fetch('/ServiceDesk/UpdateStatus', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ TicketId: ticketId, Status: newStatus })
            })
            .then(res => res.json())
            .then(result => {
                if (result.success) {
                    alert('Status updated!');
                    location.reload();
                } else {
                    alert(result.message || 'Error updating status');
                }
            });
        }
        
        function refreshTickets() {
            location.reload();
        }
        
        function showMessage(elementId, message, type) {
            const el = document.getElementById(elementId);
            el.className = 'mt-3 p-2 rounded text-xs font-medium';
            el.classList.add(type === 'success' ? 'bg-green-50' : 'bg-red-50');
            el.classList.add(type === 'success' ? 'text-green-700' : 'text-red-700');
            el.innerText = message;
            el.classList.remove('hidden');
        }
        
        // ============ FILTER HANDLERS ============
        document.querySelectorAll('.filter-stat').forEach(stat => {
            stat.addEventListener('click', function() {
                const status = this.dataset.status;
                window.location.href = status === 'all' ? '/ServiceDesk' : `/ServiceDesk?status=${status}`;
            });
        });
    </script>
}
