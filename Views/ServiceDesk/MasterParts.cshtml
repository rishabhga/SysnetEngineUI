@{
    ViewData["Title"] = "Master Parts Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var canManage = ViewBag.CanManageMasterParts ?? false;
}

<div class="min-h-screen bg-gray-50 p-4">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
            <div>
                <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
                    <a href="@Url.Action("Index")" class="hover:text-blue-600">Dashboard</a>
                    <span>/</span>
                    <span class="text-gray-700 font-medium">Master Parts</span>
                </div>
                <h1 class="text-xl font-bold text-gray-900">Master Parts Management</h1>
                <p class="text-gray-600 text-sm">Manage inventory parts and unit costs</p>
            </div>
            @if (canManage)
            {
                <button onclick="openAddModal()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium rounded-lg flex items-center shadow-sm transition-all">
                    <i class="fas fa-plus mr-2"></i>
                    Add New Part
                </button>
            }
        </div>

        <!-- Inventory List -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="p-4 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
                <h3 class="font-bold text-gray-800">Parts Inventory</h3>
                <div class="relative">
                    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                    <input type="text" id="partsSearch" placeholder="Search parts..." 
                           class="pl-9 pr-3 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none w-64">
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse" id="partsTable">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-200">
                            <th class="px-4 py-3 text-xs font-bold text-gray-500 uppercase tracking-wider">Part Name</th>
                            <th class="px-4 py-3 text-xs font-bold text-gray-500 uppercase tracking-wider">Part Number</th>
                            <th class="px-4 py-3 text-xs font-bold text-gray-500 uppercase tracking-wider text-right">Unit Cost</th>
                            <th class="px-4 py-3 text-xs font-bold text-gray-500 uppercase tracking-wider text-center">In Stock</th>
                            <th class="px-4 py-3 text-xs font-bold text-gray-500 uppercase tracking-wider">Description</th>
                            <th class="px-4 py-3 text-xs font-bold text-gray-500 uppercase tracking-wider text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        <tr>
                            <td colspan="6" class="px-4 py-8 text-center text-gray-400 italic">Loading inventory...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div id="partModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md overflow-hidden transform transition-all">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
            <h3 class="font-bold text-gray-900" id="modalTitle">Add New Part</h3>
            <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <form id="partForm" class="p-6">
            <input type="hidden" name="Id" id="partId" value="0">
            <div class="grid grid-cols-1 gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Part Name <span class="text-red-500">*</span></label>
                    <input type="text" name="PartName" required 
                           class="w-full h-10 text-sm border border-gray-300 rounded-lg px-3 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Part Number</label>
                    <input type="text" name="PartNumber" 
                           class="w-full h-10 text-sm border border-gray-300 rounded-lg px-3 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Unit Cost ($) <span class="text-red-500">*</span></label>
                        <input type="number" step="0.01" name="UnitCost" required value="0.00"
                               class="w-full h-10 text-sm border border-gray-300 rounded-lg px-3 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Quantity <span class="text-red-500">*</span></label>
                        <input type="number" name="StockQuantity" required value="0"
                               class="w-full h-10 text-sm border border-gray-300 rounded-lg px-3 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Description</label>
                    <textarea name="Description" rows="3"
                              class="w-full text-sm border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none"></textarea>
                </div>
            </div>
            <div class="flex gap-3 mt-6">
                <button type="button" onclick="closeModal()" 
                        class="flex-1 py-2 text-sm text-gray-600 font-bold hover:bg-gray-100 rounded-lg border border-gray-200 transition-colors">Cancel</button>
                <button type="submit" 
                        class="flex-1 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold rounded-lg shadow-md transition-all">Save Part</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            loadParts();

            $('#partForm').submit(function(e) {
                e.preventDefault();
                savePart();
            });

            $('#partsSearch').on('input', function() {
                const search = $(this).val().toLowerCase();
                $('#partsTable tbody tr').each(function() {
                    const text = $(this).text().toLowerCase();
                    $(this).toggle(text.includes(search));
                });
            });
        });

        function loadParts() {
            $.get('@Url.Action("GetMasterParts", "ServiceDesk")', function(data) {
                const tbody = $('#partsTable tbody');
                tbody.empty();
                
                if (data && data.length > 0) {
                    data.forEach(p => {
                        const row = `
                            <tr class="hover:bg-gray-50/80 transition-colors">
                                <td class="px-4 py-3 font-medium text-gray-800">${p.partName}</td>
                                <td class="px-4 py-3 text-sm text-gray-500 font-mono">${p.partNumber || '-'}</td>
                                <td class="px-4 py-3 text-sm text-gray-700 text-right font-bold">$${(p.unitCost || 0).toFixed(2)}</td>
                                <td class="px-4 py-3 text-center">
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${p.stockQuantity > 0 ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700'}">
                                        ${p.stockQuantity || 0}
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-xs text-gray-500 max-w-xs truncate">${p.description || '-'}</td>
                                <td class="px-4 py-3 text-right">
                                    <div class="flex justify-end gap-1">
                                        <button onclick='editPart(${JSON.stringify(p)})' class="p-1.5 text-blue-600 hover:bg-blue-50 rounded transition-colors" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button onclick="deletePart(${p.id})" class="p-1.5 text-red-600 hover:bg-red-50 rounded transition-colors" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        `;
                        tbody.append(row);
                    });
                } else {
                    tbody.append('<tr><td colspan="6" class="px-4 py-8 text-center text-gray-400 italic">No parts found in inventory</td></tr>');
                }
            });
        }

        function openAddModal() {
            $('#modalTitle').text('Add New Part');
            $('#partId').val(0);
            $('#partForm')[0].reset();
            $('#partModal').removeClass('hidden');
        }

        function editPart(p) {
            $('#modalTitle').text('Edit Part');
            $('#partId').val(p.id);
            $('input[name="PartName"]').val(p.partName);
            $('input[name="PartNumber"]').val(p.partNumber);
            $('input[name="UnitCost"]').val(p.unitCost);
            $('input[name="StockQuantity"]').val(p.stockQuantity);
            $('textarea[name="Description"]').val(p.description);
            $('#partModal').removeClass('hidden');
        }

        function closeModal() {
            $('#partModal').addClass('hidden');
        }

        function savePart() {
            const data = $('#partForm').serializeArray().reduce((obj, item) => {
                obj[item.name] = item.value;
                return obj;
            }, {});

            data.Id = parseInt(data.Id);
            data.UnitCost = parseFloat(data.UnitCost);
            data.StockQuantity = parseInt(data.StockQuantity);

            const isEdit = data.Id > 0;
            const url = isEdit ? '@Url.Action("UpdateMasterPart", "ServiceDesk")' : '@Url.Action("AddMasterPart", "ServiceDesk")';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(res) {
                    if (res.success || res.id) {
                        sysAlert(isEdit ? "Part updated successfully" : "Part added to inventory", "success");
                        closeModal();
                        loadParts();
                    } else {
                        sysAlert(res.message || "Failed to save part", "error");
                    }
                },
                error: function() {
                    sysAlert("Error connecting to server", "error");
                }
            });
        }

        function deletePart(id) {
            sysConfirm("Are you sure you want to remove this part from inventory?", function() {
                $.post('@Url.Action("DeleteMasterPart", "ServiceDesk")?id=' + id, function(res) {
                    if (res.success) {
                        sysAlert("Part deleted from inventory", "success");
                        loadParts();
                    } else {
                        sysAlert(res.message || "Failed to delete part", "error");
                    }
                });
            });
        }

    </script>
}
