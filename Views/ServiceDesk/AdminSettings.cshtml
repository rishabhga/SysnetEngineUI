@{
    ViewData["Title"] = "Admin Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .brand-tab-active {
        border-bottom: 2px solid #00BCEB;
        color: #00BCEB;
    }

    .brand-tab-inactive {
        border-bottom: 2px solid transparent;
        color: #64748B;
    }

        .brand-tab-inactive:hover {
            color: #0F172A;
        }

    .brand-btn {
        background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);
        color: #fff;
        transition: opacity .15s;
    }

        .brand-btn:hover {
            opacity: .88;
        }

    .modal-header {
        background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);
    }
</style>

<div class="min-h-screen px-3 pt-4 pb-12 sm:px-4 lg:px-6" style="background:#F0F4F8;">
    <div class="max-w-5xl mx-auto">

        <!-- Page Header -->
        <div class="bg-white border border-slate-200 rounded-2xl px-4 py-3.5 shadow-sm mb-4 flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center text-white text-sm flex-shrink-0"
                 style="background: linear-gradient(135deg,#00BCEB,#0096BE);">
                <i class="fas fa-cog"></i>
            </div>
            <div>
                <h1 class="text-[15px] font-bold text-slate-900 leading-tight">Service Desk Settings</h1>
                <p class="text-[11px] text-slate-500">Manage Categories, Priorities, and Statuses used across the system</p>
            </div>
        </div>

        <!-- Tabs -->
        <div class="flex border-b border-slate-200 mb-4 bg-white rounded-t-xl px-2 gap-1">
            <button onclick="switchTab('categories')" id="tab-categories"
                    class="px-4 py-2.5 text-sm font-semibold transition-colors brand-tab-active">
                <i class="fas fa-tags mr-1.5 text-xs"></i>Categories
            </button>
            <button onclick="switchTab('priorities')" id="tab-priorities"
                    class="px-4 py-2.5 text-sm font-semibold transition-colors brand-tab-inactive">
                <i class="fas fa-exclamation-circle mr-1.5 text-xs"></i>Priorities
            </button>
            <button onclick="switchTab('statuses')" id="tab-statuses"
                    class="px-4 py-2.5 text-sm font-semibold transition-colors brand-tab-inactive">
                <i class="fas fa-check-circle mr-1.5 text-xs"></i>Statuses
            </button>
        </div>

        <!-- CATEGORIES TAB -->
        <div id="panel-categories">
            <div class="flex justify-between items-center mb-3">
                <h2 class="text-sm font-semibold text-slate-800">Ticket Categories</h2>
                <button onclick="showAddModal('category')" class="brand-btn px-3 py-1.5 text-sm font-medium rounded-lg flex items-center gap-1.5">
                    <i class="fas fa-plus text-xs"></i>Add Category
                </button>
            </div>
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm min-w-[480px]" id="categoriesTable">
                        <thead>
                            <tr class="bg-slate-50 text-[11px] font-bold text-slate-500 uppercase tracking-wider border-b border-slate-200">
                                <th class="px-4 py-2.5">Name</th>
                                <th class="px-4 py-2.5">Parent</th>
                                <th class="px-4 py-2.5">Order</th>
                                <th class="px-4 py-2.5">Status</th>
                                <th class="px-4 py-2.5 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- PRIORITIES TAB -->
        <div id="panel-priorities" class="hidden">
            <div class="flex justify-between items-center mb-3">
                <h2 class="text-sm font-semibold text-slate-800">Ticket Priorities</h2>
                <button onclick="showAddModal('priority')" class="brand-btn px-3 py-1.5 text-sm font-medium rounded-lg flex items-center gap-1.5">
                    <i class="fas fa-plus text-xs"></i>Add Priority
                </button>
            </div>
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm min-w-[440px]" id="prioritiesTable">
                        <thead>
                            <tr class="bg-slate-50 text-[11px] font-bold text-slate-500 uppercase tracking-wider border-b border-slate-200">
                                <th class="px-4 py-2.5">Name</th>
                                <th class="px-4 py-2.5">Color</th>
                                <th class="px-4 py-2.5">Order</th>
                                <th class="px-4 py-2.5">Status</th>
                                <th class="px-4 py-2.5 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- STATUSES TAB -->
        <div id="panel-statuses" class="hidden">
            <div class="flex justify-between items-center mb-3">
                <h2 class="text-sm font-semibold text-slate-800">Ticket Statuses</h2>
                <button onclick="showAddModal('status')" class="brand-btn px-3 py-1.5 text-sm font-medium rounded-lg flex items-center gap-1.5">
                    <i class="fas fa-plus text-xs"></i>Add Status
                </button>
            </div>
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm min-w-[640px]" id="statusesTable">
                        <thead>
                            <tr class="bg-slate-50 text-[11px] font-bold text-slate-500 uppercase tracking-wider border-b border-slate-200">
                                <th class="px-4 py-2.5">Code</th>
                                <th class="px-4 py-2.5">Name</th>
                                <th class="px-4 py-2.5">System Action</th>
                                <th class="px-4 py-2.5">Color</th>
                                <th class="px-4 py-2.5">Closed?</th>
                                <th class="px-4 py-2.5">Order</th>
                                <th class="px-4 py-2.5">Status</th>
                                <th class="px-4 py-2.5 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Generic Modal -->
<div id="adminModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl w-full max-w-md shadow-2xl overflow-hidden">
        <div class="modal-header px-5 py-3.5 flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-lg bg-white/20 flex items-center justify-center">
                <i class="fas fa-cog text-white text-xs"></i>
            </div>
            <h3 id="modalTitle" class="font-semibold text-white text-sm">Add Item</h3>
            <button onclick="$('#adminModal').addClass('hidden')" class="ml-auto w-7 h-7 rounded-full bg-white/15 hover:bg-white/25 flex items-center justify-center transition-colors">
                <i class="fas fa-times text-white text-xs"></i>
            </button>
        </div>
        <form id="adminForm" class="p-5">
            <input type="hidden" id="editId" value="0">
            <input type="hidden" id="editType" value="">
            <div id="formFields" class="space-y-3"></div>
            <div class="flex gap-2.5 pt-4 border-t border-slate-100 mt-4">
                <button type="button" onclick="$('#adminModal').addClass('hidden')"
                        class="flex-1 py-2 text-sm text-slate-600 font-medium hover:bg-slate-50 rounded-lg border border-slate-200 transition-colors">
                    Cancel
                </button>
                <button type="submit"
                        class="flex-1 py-2 text-white text-sm font-semibold rounded-lg transition-opacity brand-btn">
                    Save
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() { loadCategories(); loadPriorities(); loadStatuses(); });

        /* Shared input / select classes injected into form fields */
        const inp  = 'w-full h-9 text-sm border border-slate-300 rounded-lg px-3 focus:border-[#00BCEB] focus:ring-2 focus:ring-[#00BCEB]/20 outline-none transition';
        const sInp = 'w-full h-9 text-sm border border-slate-300 rounded-lg px-3 bg-white focus:border-[#00BCEB] focus:ring-2 focus:ring-[#00BCEB]/20 outline-none transition';
        const lbl  = 'block text-xs font-semibold text-slate-600 mb-1';

        function switchTab(tab) {
            ['categories','priorities','statuses'].forEach(t => {
                $(`#panel-${t}`).toggleClass('hidden', t !== tab);
                $(`#tab-${t}`).removeClass('brand-tab-active brand-tab-inactive')
                              .addClass(t === tab ? 'brand-tab-active' : 'brand-tab-inactive');
            });
        }

        function loadCategories() {
            $.get('@Url.Action("GetAllCategories", "ServiceDesk")', data => {
                window.allCategories = data || [];
                var tb = $('#categoriesTable tbody').empty();
                if (!window.allCategories.length) {
                    tb.append('<tr><td colspan="5" class="px-4 py-6 text-center text-slate-400 text-sm">No categories. Click "Add Category" to create one.</td></tr>');
                    return;
                }

                // Build a map for easy lookup
                const catMap = {};
                window.allCategories.forEach(c => { catMap[c.categoryName] = c; c.children = []; });

                // Build hierarchy
                const roots = [];
                window.allCategories.forEach(c => {
                    if (c.parentCategory && catMap[c.parentCategory]) {
                        catMap[c.parentCategory].children.push(c);
                    } else {
                        roots.push(c);
                    }
                });

                // Function to render rows recursively
                function renderRow(c, level, parentId) {
                    const indent = level * 36; // Much larger indent for clear visual hierarchy
                    const hasChildren = c.children && c.children.length > 0;
                    
                    // Chevron icon container (fixed width to align perfectly)
                    const chevron = hasChildren 
                        ? `<i class="fas fa-chevron-down text-slate-400 hover:text-slate-700 cursor-pointer transition-transform toggle-cat" data-id="${c.id}" title="Expand/Collapse"></i>` 
                        : ``;
                        
                    // Type icon (Folder for parents, File for leaf nodes)
                    const typeIcon = (hasChildren || level === 0)
                        ? `<i class="far fa-folder-open text-[#0096BE]/80"></i>`
                        : `<i class="far fa-file-alt text-slate-300"></i>`;
                        
                    // Text styling based on depth
                    let textStyle = "text-slate-600";
                    if (level === 0) textStyle = "font-bold text-slate-800";
                    else if (level === 1) textStyle = "font-semibold text-slate-700";
                    
                    // Clean object for edit button
                    const cleanC = { id: c.id, categoryName: c.categoryName, parentCategory: c.parentCategory, sortOrder: c.sortOrder, isActive: c.isActive };
                    
                    const parentClass = parentId ? `child-of-${parentId}` : 'root-cat';
                    
                    // Root rows get a slightly different background to group families together
                    const rowBg = level === 0 ? 'bg-slate-50/50 border-t border-slate-200' : 'bg-white border-t border-slate-50';
                    
                    tb.append(`
                        <tr id="cat-row-${c.id}" class="hover:bg-slate-50 transition-colors ${rowBg} ${parentClass}" data-level="${level}" data-id="${c.id}">
                            <td class="px-4 py-3">
                                <div class="flex items-center" style="padding-left: ${indent}px">
                                    <div class="w-6 flex-shrink-0 text-center">${chevron}</div>
                                    <div class="w-6 flex-shrink-0 text-center mr-2">${typeIcon}</div>
                                    <span class="${textStyle}">${c.categoryName}</span>
                                </div>
                            </td>
                            <td class="px-4 py-3 text-slate-500 text-sm">${c.parentCategory || '-'}</td>
                            <td class="px-4 py-3 text-slate-500 text-sm">${c.sortOrder}</td>
                            <td class="px-4 py-3">
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${c.isActive ? 'bg-[#B4D334]/20 text-[#5a7a00]' : 'bg-slate-100 text-slate-500'}">
                                    ${c.isActive ? 'Active' : 'Inactive'}
                                </span>
                            </td>
                            <td class="px-4 py-3 text-right">
                                <button class="p-1.5 text-[#0096BE] hover:bg-[#00BCEB]/10 rounded-lg transition-colors" onclick='editCategory(${JSON.stringify(cleanC)})'><i class="fas fa-edit text-xs"></i></button>
                                <button class="p-1.5 text-red-500 hover:bg-red-50 rounded-lg transition-colors" onclick="deleteItem('category',${c.id})"><i class="fas fa-trash text-xs"></i></button>
                            </td>
                        </tr>`);
                    
                    if (hasChildren) {
                        c.children.sort((a,b) => a.sortOrder - b.sortOrder).forEach(child => renderRow(child, level + 1, c.id));
                    }
                }

                // Render all roots
                roots.sort((a,b) => a.sortOrder - b.sortOrder).forEach(root => renderRow(root, 0, null));
                
                // Add event listener for expand/collapse (using off() to prevent multiple bindings if loaded twice)
                $('#categoriesTable').off('click', '.toggle-cat').on('click', '.toggle-cat', function() {
                    const id = $(this).data('id');
                    const isExpanded = !$(this).hasClass('-rotate-90'); // If not rotated, it is expanded (pointing down)
                    
                    if (isExpanded) {
                        // Collapse
                        $(this).addClass('-rotate-90');
                        collapseChildren(id);
                    } else {
                        // Expand
                        $(this).removeClass('-rotate-90');
                        expandChildren(id);
                    }
                });
                
                function collapseChildren(parentId) {
                    $(`.child-of-${parentId}`).each(function() {
                        $(this).hide();
                        const childId = $(this).data('id');
                        collapseChildren(childId); // recursively hide descendants
                    });
                }
                
                function expandChildren(parentId) {
                    $(`.child-of-${parentId}`).each(function() {
                        $(this).show();
                        // Only expand children if their own toggle is not closed
                        const childId = $(this).data('id');
                        const chevron = $(this).find('.toggle-cat');
                        if (chevron.length && !chevron.hasClass('-rotate-90')) {
                            expandChildren(childId);
                        }
                    });
                }
            });
        }

        function loadPriorities() {
            $.get('@Url.Action("GetAllPriorities", "ServiceDesk")', data => {
                var tb = $('#prioritiesTable tbody').empty();
                if (!data || !data.length) {
                    tb.append('<tr><td colspan="5" class="px-4 py-6 text-center text-slate-400 text-sm">No priorities. Click "Add Priority" to create one.</td></tr>');
                    return;
                }
                data.forEach(p => tb.append(`
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-4 py-2.5 font-medium text-slate-800">${p.priorityName}</td>
                        <td class="px-4 py-2.5">
                            <div class="flex items-center gap-2">
                                <span class="w-5 h-5 rounded-md border border-slate-200 flex-shrink-0" style="background:${p.colorCode||'#ccc'}"></span>
                                <span class="text-slate-400 text-xs font-mono">${p.colorCode||'Ã¢â‚¬â€'}</span>
                            </div>
                        </td>
                        <td class="px-4 py-2.5 text-slate-500">${p.sortOrder}</td>
                        <td class="px-4 py-2.5">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${p.isActive ? 'bg-[#B4D334]/20 text-[#5a7a00]' : 'bg-slate-100 text-slate-500'}">
                                ${p.isActive ? 'Active' : 'Inactive'}
                            </span>
                        </td>
                        <td class="px-4 py-2.5 text-right">
                            <button class="p-1.5 text-[#0096BE] hover:bg-[#00BCEB]/10 rounded-lg transition-colors" onclick='editPriority(${JSON.stringify(p)})'><i class="fas fa-edit text-xs"></i></button>
                            <button class="p-1.5 text-red-500 hover:bg-red-50 rounded-lg transition-colors" onclick="deleteItem('priority',${p.id})"><i class="fas fa-trash text-xs"></i></button>
                        </td>
                    </tr>`));
            });
        }

        function loadStatuses() {
            $.get('@Url.Action("GetAllStatuses", "ServiceDesk")', data => {
                var tb = $('#statusesTable tbody').empty();
                if (!data || !data.length) {
                    tb.append('<tr><td colspan="8" class="px-4 py-6 text-center text-slate-400 text-sm">No statuses. Click "Add Status" to create one.</td></tr>');
                    return;
                }
                data.forEach(s => {
                    const actionBadge = s.systemAction && s.systemAction !== 'None'
                        ? `<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-sky-50 text-sky-700 border border-sky-200"><i class="fas fa-bolt text-[8px] mr-1"></i>${s.systemAction}</span>`
                        : `<span class="text-slate-400 text-xs italic">None</span>`;

                    tb.append(`
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-4 py-2.5 font-mono text-slate-600 text-xs">${s.statusCode}</td>
                        <td class="px-4 py-2.5 font-medium text-slate-800">${s.statusName}</td>
                        <td class="px-4 py-2.5">${actionBadge}</td>
                        <td class="px-4 py-2.5">
                            <div class="flex items-center gap-2">
                                <span class="w-5 h-5 rounded-md border border-slate-200 flex-shrink-0" style="background:${s.colorCode||'#ccc'}"></span>
                                <span class="text-slate-400 text-xs font-mono">${s.colorCode||'—'}</span>
                            </div>
                        </td>
                        <td class="px-4 py-2.5">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${s.isClosedState ? 'bg-red-100 text-red-700' : 'bg-[#00BCEB]/10 text-[#0096BE]'}">
                                ${s.isClosedState ? 'Yes' : 'No'}
                            </span>
                        </td>
                        <td class="px-4 py-2.5 text-slate-500">${s.sortOrder}</td>
                        <td class="px-4 py-2.5">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${s.isActive ? 'bg-[#B4D334]/20 text-[#5a7a00]' : 'bg-slate-100 text-slate-500'}">
                                ${s.isActive ? 'Active' : 'Inactive'}
                            </span>
                        </td>
                        <td class="px-4 py-2.5 text-right">
                            <button class="p-1.5 text-[#0096BE] hover:bg-[#00BCEB]/10 rounded-lg transition-colors" onclick='editStatus(${JSON.stringify(s)})'><i class="fas fa-edit text-xs"></i></button>
                            <button class="p-1.5 text-red-500 hover:bg-red-50 rounded-lg transition-colors" onclick="deleteItem('status',${s.id})"><i class="fas fa-trash text-xs"></i></button>
                        </td>
                    </tr>`);
                });
            });
        }

        function showAddModal(type) {
            $('#editId').val(0); $('#editType').val(type);
            var f = $('#formFields').empty();
            if (type === 'category') {
                $('#modalTitle').text('Add Category');
                let parentOpts = '<option value="">None (Top Level)</option>';
                if (window.allCategories) {
                    window.allCategories.forEach(c => {
                        parentOpts += `<option value="${c.categoryName}">${c.parentCategory ? c.parentCategory + " > " : ""}${c.categoryName}</option>`;
                    });
                }
                f.html(`
                    <div><label class="${lbl}">Category Name <span class="text-red-500">*</span></label><input id="f_name" required class="${inp}"></div>
                    <div><label class="${lbl}">Parent Category</label><select id="f_parent" class="${sInp}">${parentOpts}</select></div>
                    <div class="grid grid-cols-2 gap-3">
                        <div><label class="${lbl}">Sort Order</label><input id="f_order" type="number" value="0" class="${inp}"></div>
                        <div><label class="${lbl}">Active</label><select id="f_active" class="${sInp}"><option value="true">Yes</option><option value="false">No</option></select></div>
                    </div>`);
            } else if (type === 'priority') {
                $('#modalTitle').text('Add Priority');
                f.html(`
                    <div><label class="${lbl}">Priority Name <span class="text-red-500">*</span></label><input id="f_name" required class="${inp}"></div>
                    <div class="grid grid-cols-2 gap-3">
                        <div><label class="${lbl}">Color Code</label><input id="f_color" type="color" value="#00BCEB" class="w-full h-9 border border-slate-300 rounded-lg px-1 cursor-pointer"></div>
                        <div><label class="${lbl}">Sort Order</label><input id="f_order" type="number" value="0" class="${inp}"></div>
                    </div>
                    <div><label class="${lbl}">Active</label><select id="f_active" class="${sInp}"><option value="true">Yes</option><option value="false">No</option></select></div>`);
            } else {
                $('#modalTitle').text('Add Status');
                f.html(`
                    <div class="grid grid-cols-2 gap-3">
                        <div><label class="${lbl}">Status Code <span class="text-red-500">*</span></label><input id="f_code" required class="${inp}" placeholder="e.g. APPROVED"></div>
                        <div><label class="${lbl}">Status Name <span class="text-red-500">*</span></label><input id="f_name" required class="${inp}" placeholder="e.g. Approved"></div>
                    </div>
                    <div>
                        <label class="${lbl}">System Action (Workflow Role)</label>
                        <select id="f_action" class="${sInp}">
                            <option value="">None (Custom / Intermediate Status)</option>
                            <option value="Open">Open (Initial Creation)</option>
                            <option value="Approve">Approve (Ticket Approved)</option>
                            <option value="Reject">Reject (Ticket Rejected)</option>
                            <option value="Assign">Assign (Ticket Assigned to Engineer)</option>
                            <option value="StartWork">StartWork (Work in Progress)</option>
                            <option value="Resolve">Resolve (Ticket Resolved)</option>
                            <option value="Close">Close (Ticket Closed)</option>
                        </select>
                        <p class="text-[10px] text-slate-400 mt-0.5">Dynamically maps this status to system buttons like Approve, Assign, Resolve, etc.</p>
                    </div>
                    <div class="grid grid-cols-3 gap-3">
                        <div><label class="${lbl}">Color</label><input id="f_color" type="color" value="#00BCEB" class="w-full h-9 border border-slate-300 rounded-lg px-1 cursor-pointer"></div>
                        <div><label class="${lbl}">Closed State?</label><select id="f_closed" class="${sInp}"><option value="false">No</option><option value="true">Yes</option></select></div>
                        <div><label class="${lbl}">Sort Order</label><input id="f_order" type="number" value="0" class="${inp}"></div>
                    </div>
                    <div><label class="${lbl}">Active</label><select id="f_active" class="${sInp}"><option value="true">Yes</option><option value="false">No</option></select></div>`);
            }
            $('#adminModal').removeClass('hidden');
        }

        function editCategory(c) { showAddModal('category'); $('#editId').val(c.id); $('#modalTitle').text('Edit Category'); $('#f_name').val(c.categoryName); $('#f_parent').val(c.parentCategory); $('#f_order').val(c.sortOrder); $('#f_active').val(String(c.isActive)); }
        function editPriority(p) { showAddModal('priority'); $('#editId').val(p.id); $('#modalTitle').text('Edit Priority'); $('#f_name').val(p.priorityName); $('#f_color').val(p.colorCode||'#00BCEB'); $('#f_order').val(p.sortOrder); $('#f_active').val(String(p.isActive)); }
        function editStatus(s)   { showAddModal('status');   $('#editId').val(s.id); $('#modalTitle').text('Edit Status');   $('#f_code').val(s.statusCode); $('#f_name').val(s.statusName); $('#f_action').val(s.systemAction || ''); $('#f_color').val(s.colorCode||'#00BCEB'); $('#f_closed').val(String(s.isClosedState)); $('#f_order').val(s.sortOrder); $('#f_active').val(String(s.isActive)); }

        $('#adminForm').submit(function(e) {
            e.preventDefault();
            var type = $('#editType').val(), id = parseInt($('#editId').val()), isEdit = id > 0;
            var payload = {}, url = '';
            if (type === 'category') {
                payload = { id, categoryName: $('#f_name').val(), parentCategory: $('#f_parent').val(), sortOrder: parseInt($('#f_order').val())||0, isActive: $('#f_active').val()==='true' };
                url = isEdit ? '@Url.Action("UpdateCategory", "ServiceDesk")' : '@Url.Action("CreateCategory", "ServiceDesk")';
            } else if (type === 'priority') {
                payload = { id, priorityName: $('#f_name').val(), colorCode: $('#f_color').val(), sortOrder: parseInt($('#f_order').val())||0, isActive: $('#f_active').val()==='true' };
                url = isEdit ? '@Url.Action("UpdatePriority", "ServiceDesk")' : '@Url.Action("CreatePriority", "ServiceDesk")';
            } else {
                payload = { 
                    id, 
                    statusCode: $('#f_code').val(), 
                    statusName: $('#f_name').val(), 
                    systemAction: $('#f_action').val() || null, 
                    colorCode: $('#f_color').val(), 
                    isClosedState: $('#f_closed').val()==='true', 
                    sortOrder: parseInt($('#f_order').val())||0, 
                    isActive: $('#f_active').val()==='true' 
                };
                url = isEdit ? '@Url.Action("UpdateTicketStatus", "ServiceDesk")' : '@Url.Action("CreateTicketStatus", "ServiceDesk")';
            }
            $.ajax({ url, type: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
                success: function(r) { if (r.success) { $('#adminModal').addClass('hidden'); sysAlert(r.message||'Saved','success'); loadCategories(); loadPriorities(); loadStatuses(); } else sysAlert(r.message||'Error','error'); },
                error: function() { sysAlert('Connection error','error'); }
            });
        });

        function deleteItem(type, id) {
            sysConfirm('Delete this item?', function() {
                var urls = { category: '@Url.Action("DeleteCategory", "ServiceDesk")', priority: '@Url.Action("DeletePriority", "ServiceDesk")', status: '@Url.Action("DeleteTicketStatus", "ServiceDesk")' };
                $.post(urls[type]+'?id='+id, function(r) {
                    if (r.success) { sysAlert('Deleted','success'); loadCategories(); loadPriorities(); loadStatuses(); }
                    else sysAlert(r.message||'Error','error');
                });
            });
        }
    </script>
}
