@{
    ViewData["Title"] = "Admin Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-gray-50 p-4">
    <div class="max-w-5xl mx-auto">
        <div class="mb-4">
            <h1 class="text-xl font-bold text-gray-900">Service Desk Settings</h1>
            <p class="text-gray-500 text-sm">Manage Categories, Priorities, and Statuses used across the system</p>
        </div>

        <!-- Tabs -->
        <div class="flex border-b border-gray-200 mb-4">
            <button onclick="switchTab('categories')" id="tab-categories" class="px-4 py-2 text-sm font-medium border-b-2 border-blue-600 text-blue-600">Categories</button>
            <button onclick="switchTab('priorities')" id="tab-priorities" class="px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700">Priorities</button>
            <button onclick="switchTab('statuses')" id="tab-statuses" class="px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700">Statuses</button>
        </div>

        <!-- CATEGORIES TAB -->
        <div id="panel-categories">
            <div class="flex justify-between items-center mb-3">
                <h2 class="text-sm font-medium text-gray-800"><i class="fas fa-tags text-blue-500 mr-1"></i> Ticket Categories</h2>
                <button onclick="showAddModal('category')" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded"><i class="fas fa-plus mr-1"></i>Add Category</button>
            </div>
            <div class="bg-white rounded border border-gray-200">
                <table class="w-full text-left text-sm" id="categoriesTable">
                    <thead><tr class="bg-gray-50 text-xs text-gray-500 border-b"><th class="px-3 py-2">NAME</th><th class="px-3 py-2">PARENT</th><th class="px-3 py-2">ORDER</th><th class="px-3 py-2">STATUS</th><th class="px-3 py-2">ACTIONS</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <!-- PRIORITIES TAB -->
        <div id="panel-priorities" class="hidden">
            <div class="flex justify-between items-center mb-3">
                <h2 class="text-sm font-medium text-gray-800"><i class="fas fa-exclamation-circle text-amber-500 mr-1"></i> Ticket Priorities</h2>
                <button onclick="showAddModal('priority')" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded"><i class="fas fa-plus mr-1"></i>Add Priority</button>
            </div>
            <div class="bg-white rounded border border-gray-200">
                <table class="w-full text-left text-sm" id="prioritiesTable">
                    <thead><tr class="bg-gray-50 text-xs text-gray-500 border-b"><th class="px-3 py-2">NAME</th><th class="px-3 py-2">COLOR</th><th class="px-3 py-2">ORDER</th><th class="px-3 py-2">STATUS</th><th class="px-3 py-2">ACTIONS</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <!-- STATUSES TAB -->
        <div id="panel-statuses" class="hidden">
            <div class="flex justify-between items-center mb-3">
                <h2 class="text-sm font-medium text-gray-800"><i class="fas fa-check-circle text-emerald-500 mr-1"></i> Ticket Statuses</h2>
                <button onclick="showAddModal('status')" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded"><i class="fas fa-plus mr-1"></i>Add Status</button>
            </div>
            <div class="bg-white rounded border border-gray-200">
                <table class="w-full text-left text-sm" id="statusesTable">
                    <thead><tr class="bg-gray-50 text-xs text-gray-500 border-b"><th class="px-3 py-2">CODE</th><th class="px-3 py-2">NAME</th><th class="px-3 py-2">COLOR</th><th class="px-3 py-2">CLOSED?</th><th class="px-3 py-2">ORDER</th><th class="px-3 py-2">STATUS</th><th class="px-3 py-2">ACTIONS</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Generic Modal -->
<div id="adminModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg w-full max-w-md shadow-xl">
        <div class="px-4 py-3 border-b border-blue-100 bg-blue-50 flex items-center rounded-t-lg">
            <i class="fas fa-cog text-blue-600 mr-2"></i>
            <h3 id="modalTitle" class="font-medium text-blue-800 text-sm">Add Item</h3>
            <button onclick="$('#adminModal').addClass('hidden')" class="ml-auto text-gray-400 hover:text-gray-600"><i class="fas fa-times"></i></button>
        </div>
        <form id="adminForm" class="p-4">
            <input type="hidden" id="editId" value="0">
            <input type="hidden" id="editType" value="">
            <div id="formFields"></div>
            <div class="flex gap-2 pt-3 border-t border-gray-100 mt-3">
                <button type="button" onclick="$('#adminModal').addClass('hidden')" class="flex-1 py-1.5 text-sm text-gray-600 font-medium hover:bg-gray-50 rounded border border-gray-200">Cancel</button>
                <button type="submit" class="flex-1 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
$(document).ready(function() { loadCategories(); loadPriorities(); loadStatuses(); });

function switchTab(tab) {
    ['categories','priorities','statuses'].forEach(t => {
        $(`#panel-${t}`).toggleClass('hidden', t !== tab);
        $(`#tab-${t}`).toggleClass('border-blue-600 text-blue-600', t === tab).toggleClass('border-transparent text-gray-500', t !== tab);
    });
}

function loadCategories() {
    $.get('@Url.Action("GetAllCategories","ServiceDesk")', data => {
        var tb = $('#categoriesTable tbody').empty();
        if(!data||!data.length) { tb.append('<tr><td colspan="5" class="px-3 py-4 text-center text-gray-400 text-sm">No categories. Click "Add Category" to create one.</td></tr>'); return; }
        data.forEach(c => tb.append(`<tr class="border-b border-gray-50 hover:bg-gray-50">
            <td class="px-3 py-2 font-medium text-gray-800">${c.categoryName}</td>
            <td class="px-3 py-2 text-gray-500">${c.parentCategory||'-'}</td>
            <td class="px-3 py-2 text-gray-500">${c.sortOrder}</td>
            <td class="px-3 py-2"><span class="px-1.5 py-0.5 rounded text-xs font-medium ${c.isActive?'bg-emerald-100 text-emerald-700':'bg-gray-100 text-gray-500'}">${c.isActive?'Active':'Inactive'}</span></td>
            <td class="px-3 py-2 flex gap-1"><button class="px-2 py-1 text-xs text-blue-600 hover:bg-blue-50 rounded" onclick='editCategory(${JSON.stringify(c)})'><i class="fas fa-edit"></i></button><button class="px-2 py-1 text-xs text-red-600 hover:bg-red-50 rounded" onclick="deleteItem('category',${c.id})"><i class="fas fa-trash"></i></button></td>
        </tr>`));
    });
}

function loadPriorities() {
    $.get('@Url.Action("GetAllPriorities","ServiceDesk")', data => {
        var tb = $('#prioritiesTable tbody').empty();
        if(!data||!data.length) { tb.append('<tr><td colspan="5" class="px-3 py-4 text-center text-gray-400 text-sm">No priorities. Click "Add Priority" to create one.</td></tr>'); return; }
        data.forEach(p => tb.append(`<tr class="border-b border-gray-50 hover:bg-gray-50">
            <td class="px-3 py-2 font-medium text-gray-800">${p.priorityName}</td>
            <td class="px-3 py-2"><span class="inline-block w-5 h-5 rounded" style="background:${p.colorCode||'#ccc'}"></span> <span class="text-gray-500 text-xs">${p.colorCode||'-'}</span></td>
            <td class="px-3 py-2 text-gray-500">${p.sortOrder}</td>
            <td class="px-3 py-2"><span class="px-1.5 py-0.5 rounded text-xs font-medium ${p.isActive?'bg-emerald-100 text-emerald-700':'bg-gray-100 text-gray-500'}">${p.isActive?'Active':'Inactive'}</span></td>
            <td class="px-3 py-2 flex gap-1"><button class="px-2 py-1 text-xs text-blue-600 hover:bg-blue-50 rounded" onclick='editPriority(${JSON.stringify(p)})'><i class="fas fa-edit"></i></button><button class="px-2 py-1 text-xs text-red-600 hover:bg-red-50 rounded" onclick="deleteItem('priority',${p.id})"><i class="fas fa-trash"></i></button></td>
        </tr>`));
    });
}

function loadStatuses() {
    $.get('@Url.Action("GetAllStatuses","ServiceDesk")', data => {
        var tb = $('#statusesTable tbody').empty();
        if(!data||!data.length) { tb.append('<tr><td colspan="7" class="px-3 py-4 text-center text-gray-400 text-sm">No statuses. Click "Add Status" to create one.</td></tr>'); return; }
        data.forEach(s => tb.append(`<tr class="border-b border-gray-50 hover:bg-gray-50">
            <td class="px-3 py-2 font-mono text-gray-700">${s.statusCode}</td>
            <td class="px-3 py-2 font-medium text-gray-800">${s.statusName}</td>
            <td class="px-3 py-2"><span class="inline-block w-5 h-5 rounded" style="background:${s.colorCode||'#ccc'}"></span> <span class="text-gray-500 text-xs">${s.colorCode||'-'}</span></td>
            <td class="px-3 py-2"><span class="px-1.5 py-0.5 rounded text-xs font-medium ${s.isClosedState?'bg-red-100 text-red-700':'bg-blue-100 text-blue-700'}">${s.isClosedState?'Yes':'No'}</span></td>
            <td class="px-3 py-2 text-gray-500">${s.sortOrder}</td>
            <td class="px-3 py-2"><span class="px-1.5 py-0.5 rounded text-xs font-medium ${s.isActive?'bg-emerald-100 text-emerald-700':'bg-gray-100 text-gray-500'}">${s.isActive?'Active':'Inactive'}</span></td>
            <td class="px-3 py-2 flex gap-1"><button class="px-2 py-1 text-xs text-blue-600 hover:bg-blue-50 rounded" onclick='editStatus(${JSON.stringify(s)})'><i class="fas fa-edit"></i></button><button class="px-2 py-1 text-xs text-red-600 hover:bg-red-50 rounded" onclick="deleteItem('status',${s.id})"><i class="fas fa-trash"></i></button></td>
        </tr>`));
    });
}

function showAddModal(type) {
    $('#editId').val(0); $('#editType').val(type);
    var f = $('#formFields').empty();
    if(type==='category') {
        $('#modalTitle').text('Add Category');
        f.html(`<div class="mb-3"><label class="block text-xs font-medium text-gray-700 mb-1">Category Name *</label><input id="f_name" required class="w-full h-9 text-sm border border-gray-300 rounded px-2 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none"></div>
        <div class="mb-3"><label class="block text-xs font-medium text-gray-700 mb-1">Parent Category</label><input id="f_parent" class="w-full h-9 text-sm border border-gray-300 rounded px-2 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none"></div>
        <div class="grid grid-cols-2 gap-3"><div><label class="block text-xs font-medium text-gray-700 mb-1">Sort Order</label><input id="f_order" type="number" value="0" class="w-full h-9 text-sm border border-gray-300 rounded px-2 outline-none"></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Active</label><select id="f_active" class="w-full h-9 text-sm border border-gray-300 rounded px-2 bg-white outline-none"><option value="true">Yes</option><option value="false">No</option></select></div></div>`);
    } else if(type==='priority') {
        $('#modalTitle').text('Add Priority');
        f.html(`<div class="mb-3"><label class="block text-xs font-medium text-gray-700 mb-1">Priority Name *</label><input id="f_name" required class="w-full h-9 text-sm border border-gray-300 rounded px-2 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none"></div>
        <div class="grid grid-cols-2 gap-3 mb-3"><div><label class="block text-xs font-medium text-gray-700 mb-1">Color Code</label><input id="f_color" type="color" value="#3B82F6" class="w-full h-9 border border-gray-300 rounded px-1"></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Sort Order</label><input id="f_order" type="number" value="0" class="w-full h-9 text-sm border border-gray-300 rounded px-2 outline-none"></div></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Active</label><select id="f_active" class="w-full h-9 text-sm border border-gray-300 rounded px-2 bg-white outline-none"><option value="true">Yes</option><option value="false">No</option></select></div>`);
    } else {
        $('#modalTitle').text('Add Status');
        f.html(`<div class="grid grid-cols-2 gap-3 mb-3"><div><label class="block text-xs font-medium text-gray-700 mb-1">Status Code *</label><input id="f_code" required class="w-full h-9 text-sm border border-gray-300 rounded px-2 outline-none"></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Status Name *</label><input id="f_name" required class="w-full h-9 text-sm border border-gray-300 rounded px-2 outline-none"></div></div>
        <div class="grid grid-cols-3 gap-3 mb-3"><div><label class="block text-xs font-medium text-gray-700 mb-1">Color</label><input id="f_color" type="color" value="#3B82F6" class="w-full h-9 border border-gray-300 rounded px-1"></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Closed State?</label><select id="f_closed" class="w-full h-9 text-sm border border-gray-300 rounded px-2 bg-white outline-none"><option value="false">No</option><option value="true">Yes</option></select></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Sort Order</label><input id="f_order" type="number" value="0" class="w-full h-9 text-sm border border-gray-300 rounded px-2 outline-none"></div></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Active</label><select id="f_active" class="w-full h-9 text-sm border border-gray-300 rounded px-2 bg-white outline-none"><option value="true">Yes</option><option value="false">No</option></select></div>`);
    }
    $('#adminModal').removeClass('hidden');
}

function editCategory(c) { showAddModal('category'); $('#editId').val(c.id); $('#modalTitle').text('Edit Category'); $('#f_name').val(c.categoryName); $('#f_parent').val(c.parentCategory); $('#f_order').val(c.sortOrder); $('#f_active').val(String(c.isActive)); }
function editPriority(p) { showAddModal('priority'); $('#editId').val(p.id); $('#modalTitle').text('Edit Priority'); $('#f_name').val(p.priorityName); $('#f_color').val(p.colorCode||'#3B82F6'); $('#f_order').val(p.sortOrder); $('#f_active').val(String(p.isActive)); }
function editStatus(s) { showAddModal('status'); $('#editId').val(s.id); $('#modalTitle').text('Edit Status'); $('#f_code').val(s.statusCode); $('#f_name').val(s.statusName); $('#f_color').val(s.colorCode||'#3B82F6'); $('#f_closed').val(String(s.isClosedState)); $('#f_order').val(s.sortOrder); $('#f_active').val(String(s.isActive)); }

$('#adminForm').submit(function(e) {
    e.preventDefault();
    var type = $('#editType').val(), id = parseInt($('#editId').val()), isEdit = id > 0;
    var payload = {}, url = '';
    if(type==='category') {
        payload = { id: id, categoryName: $('#f_name').val(), parentCategory: $('#f_parent').val(), sortOrder: parseInt($('#f_order').val())||0, isActive: $('#f_active').val()==='true' };
        url = isEdit ? '@Url.Action("UpdateCategory","ServiceDesk")' : '@Url.Action("CreateCategory","ServiceDesk")';
    } else if(type==='priority') {
        payload = { id: id, priorityName: $('#f_name').val(), colorCode: $('#f_color').val(), sortOrder: parseInt($('#f_order').val())||0, isActive: $('#f_active').val()==='true' };
        url = isEdit ? '@Url.Action("UpdatePriority","ServiceDesk")' : '@Url.Action("CreatePriority","ServiceDesk")';
    } else {
        payload = { id: id, statusCode: $('#f_code').val(), statusName: $('#f_name').val(), colorCode: $('#f_color').val(), isClosedState: $('#f_closed').val()==='true', sortOrder: parseInt($('#f_order').val())||0, isActive: $('#f_active').val()==='true' };
        url = isEdit ? '@Url.Action("UpdateTicketStatus","ServiceDesk")' : '@Url.Action("CreateTicketStatus","ServiceDesk")';
    }
    $.ajax({ url: url, type: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
        success: function(r) { if(r.success) { $('#adminModal').addClass('hidden'); sysAlert(r.message || 'Saved','success'); loadCategories(); loadPriorities(); loadStatuses(); } else sysAlert(r.message||'Error','error'); },
        error: function() { sysAlert('Connection error','error'); }
    });
});

function deleteItem(type, id) {
    sysConfirm('Delete this item?', function() {
        var urls = { category: '@Url.Action("DeleteCategory","ServiceDesk")', priority: '@Url.Action("DeletePriority","ServiceDesk")', status: '@Url.Action("DeleteTicketStatus","ServiceDesk")' };
        $.post(urls[type]+'?id='+id, function(r) { 
            if(r.success) { 
                sysAlert('Deleted','success'); 
                loadCategories(); loadPriorities(); loadStatuses(); 
            } else sysAlert(r.message||'Error','error'); 
        });
    });
}
</script>
}
