@model List<USBHubDetails>

<h2>USB Hub Details</h2>

<table class="table table-bordered font-monospace">
    <thead>
        <tr>
            <th>Id</th>
            <th>DeviceID</th>
            <th>PNPDeviceID</th>
            <th>Description</th>
            <th>Status</th>
            <th>Manufacturer</th>
            <th>Name</th>          
            <th>DateTime</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
            <td>@item.Id</td>
            <td>@item.DeviceID</td>
            <td>@item.PNPDeviceID</td>
            <td>@item.Description</td>
            <td>@item.Status</td>
            <td>@item.Manufacturer</td>
            <td>@item.Name</td>             
            <td>@item.DateTime</td>
            </tr>
        }
    </tbody>
</table>

