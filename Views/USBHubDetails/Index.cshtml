@model List<USBHubDetails>
@{
    ViewData["Title"] = "USB Hub Details";
}

<div class="max-w-7xl mx-auto px-4 pt-3">
    <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-3">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center shadow-sm" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);">
                <i class="fas fa-usb text-white text-sm"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold text-gray-900">USB Hub Details</h1>
                <p class="text-[10px] text-gray-400 font-medium uppercase tracking-wider">Connected USB Device Information</p>
            </div>
        </div>
        <span class="px-3 py-1 bg-amber-50 text-amber-700 text-xs font-bold rounded-lg border border-amber-200">
            @(Model?.Count ?? 0) Devices
        </span>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-xs">
                <thead>
                    <tr class="border-b border-gray-100" style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">#</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Device ID</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">PNP Device ID</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Description</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Status</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Manufacturer</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Name</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Date</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @if (Model != null && Model.Any())
                    {
                        var idx = 0;
                        @foreach (var item in Model)
                        {
                            idx++;
                            <tr class="hover:bg-amber-50/40 transition-colors">
                                <td class="px-4 py-2.5 text-gray-400 font-mono">@idx</td>
                                <td class="px-4 py-2.5 font-mono text-gray-700 text-[10px]">@item.DeviceID</td>
                                <td class="px-4 py-2.5 font-mono text-gray-500 text-[10px] max-w-[200px] truncate" title="@item.PNPDeviceID">@item.PNPDeviceID</td>
                                <td class="px-4 py-2.5 text-gray-700">@item.Description</td>
                                <td class="px-4 py-2.5">
                                    @if (item.Status == "OK")
                                    {
                                        <span class="px-2 py-0.5 bg-green-50 text-green-700 text-[10px] font-bold rounded-md border border-green-200">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 bg-red-50 text-red-600 text-[10px] font-bold rounded-md border border-red-200">@item.Status</span>
                                    }
                                </td>
                                <td class="px-4 py-2.5 text-gray-600">@item.Manufacturer</td>
                                <td class="px-4 py-2.5 font-semibold text-gray-800">@item.Name</td>
                                <td class="px-4 py-2.5 text-gray-400">@item.DateTime</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="px-4 py-12 text-center">
                                <div class="flex flex-col items-center">
                                    <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center mb-3">
                                        <i class="fas fa-usb text-gray-300 text-lg"></i>
                                    </div>
                                    <p class="text-gray-400 font-semibold text-sm">No USB hub data available</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
