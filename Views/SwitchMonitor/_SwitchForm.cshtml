@* Compact switch form for smaller modal *@
@model ManageEngineWebApp.Models.SwitchMaster
@{
    var formLocations = ViewBag.Locations as List<ManageEngineWebApp.Models.Locations>;
    bool locationLocked = Model.LocationId.HasValue && formLocations != null && formLocations.Count <= 1 && formLocations.Any(l => l.Id == Model.LocationId.Value);
    var lockedLocationName = locationLocked ? formLocations.First(l => l.Id == Model.LocationId.Value).LocationName : "";
}

<div class="space-y-2">
    <input type="hidden" asp-for="Id" />

    <div>
        <label class="block text-xs font-medium text-gray-700 mb-0.5">
            Machine / Device <span class="text-red-500">*</span>
        </label>
        <select id="DeviceNameSelect"
                class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs
                       focus:ring-2 focus:ring-[#00BCEB] focus:border-transparent outline-none transition bg-white"
                required>
            <option value="">-- Select Machine --</option>
            @if (ViewBag.Devices != null)
            {
                var userIps = ViewBag.UserIps as Dictionary<string, string> ?? new Dictionary<string, string>();
                <!-- DEBUG KEYS: @string.Join(", ", userIps.Keys) -->
                foreach (var dev in ViewBag.Devices as List<ManageEngineWebApp.Models.WindowsUserDetails>)
                {
                    var checkDomain = dev.DomainName?.Trim() ?? "";
                    var checkUserCode = dev.UserCode?.Trim() ?? "";
                    var checkSID = dev.SID?.Trim() ?? "";

                    var devIp = "";
                    if (checkDomain != "" && userIps.ContainsKey(checkDomain)) devIp = userIps[checkDomain];
                    else if (checkUserCode != "" && userIps.ContainsKey(checkUserCode)) devIp = userIps[checkUserCode];
                    else if (checkSID != "" && userIps.ContainsKey(checkSID)) devIp = userIps[checkSID];
                    
                    <option value="@dev.DomainName" data-location-id="@dev.LocationId" data-ip-address="@devIp" selected="@(dev.DomainName == Model.DeviceName)">
                        @dev.DomainName (@(string.IsNullOrEmpty(dev.UserName) ? "System" : dev.UserName))
                    </option>
                }
            }
        </select>
        <input type="hidden" asp-for="PollingMode" value="SNMP" />
    </div>

    <div>
        <label class="block text-xs font-medium text-gray-700 mb-0.5">Device Name</label>
        <input asp-for="DeviceName"
               id="DeviceNameInput"
               placeholder="Auto-populated from selection"
               class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs bg-gray-50
                      focus:ring-2 focus:ring-[#00BCEB] focus:border-transparent outline-none transition font-mono"
               readonly required />
    </div>

    <div class="grid grid-cols-2 gap-2">
        <div>
            <label class="block text-xs font-medium text-gray-700 mb-0.5">
                IP Address <span class="text-red-500">*</span>
            </label>
            <input asp-for="IpAddress"
                   placeholder="192.168.1.1"
                   class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs
                          focus:ring-2 focus:ring-[#00BCEB] focus:border-transparent outline-none transition font-mono"
                   required />
        </div>
        <div>
            <label class="block text-xs font-medium text-gray-700 mb-0.5">SNMP Community</label>
            <input asp-for="Community"
                   placeholder="public"
                   class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs
                          focus:ring-2 focus:ring-[#00BCEB] focus:border-transparent outline-none transition font-mono" />
        </div>
    </div>

    <div class="grid grid-cols-2 gap-2">
        <div>
            <label class="block text-xs font-medium text-gray-700 mb-0.5">Location</label>
            @if (locationLocked)
            {
                <input type="hidden" name="LocationId" id="LocationId" value="@Model.LocationId" />
                <div class="w-full px-2.5 py-1.5 border border-gray-200 rounded-lg text-xs bg-gray-100 text-gray-600 flex items-center gap-1">
                    <i class="fas fa-map-marker-alt text-[#00BCEB]"></i> @lockedLocationName
                </div>
            }
            else
            {
                <select asp-for="LocationId"
                        id="LocationId"
                        class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs
                               focus:ring-2 focus:ring-[#00BCEB] focus:border-transparent outline-none transition bg-white"
                        required>
                    <option value="">-- Location --</option>
                    @if (ViewBag.Locations != null)
                    {
                        foreach (var loc in ViewBag.Locations as List<ManageEngineWebApp.Models.Locations>)
                        {
                            <option value="@loc.Id">@loc.LocationName</option>
                        }
                    }
                </select>
            }
        </div>
        <div>
            <label class="block text-xs font-medium text-gray-700 mb-0.5">Device Type</label>
            <select asp-for="DeviceType"
                    class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs
                           focus:ring-2 focus:ring-[#00BCEB] focus:border-transparent outline-none transition bg-white">
                <option value="Switch">Switch</option>
                <option value="Router">Router</option>
                <option value="Firewall">Firewall</option>
            </select>
        </div>
    </div>

    <div class="flex items-center gap-3 p-2 bg-gray-50 rounded-lg border border-gray-200">
        <div class="relative">
            <input asp-for="IsActive" type="checkbox"
                   id="IsActiveToggle"
                   class="sr-only peer" />
            <div class="w-9 h-4.5 bg-gray-300 peer-focus:ring-2 peer-focus:ring-[#00BCEB] rounded-full peer
                        peer-checked:bg-[#00BCEB] transition cursor-pointer"
                 onclick="document.getElementById('IsActiveToggle').click()"></div>
            <div class="absolute top-0.5 left-0.5 w-3.5 h-3.5 bg-white rounded-full shadow transition
                        peer-checked:translate-x-4 pointer-events-none"></div>
        </div>
        <div>
            <label for="IsActiveToggle" class="text-xs font-medium text-gray-700 cursor-pointer">Active Polling</label>
            <p class="text-[9px] text-gray-400">Enable SNMP polling for this device</p>
        </div>
    </div>

    <script>
        (function() {
            const selectEl = document.getElementById('DeviceNameSelect');
            const inputEl = document.getElementById('DeviceNameInput');
            const locEl = document.getElementById('LocationId');
            const ipEl = document.getElementById('IpAddress');
            
            // Store original options for filtering
            let originalOptions = [];
            if (selectEl) {
                originalOptions = Array.from(selectEl.options).map(opt => ({
                    value: opt.value,
                    text: opt.text,
                    locId: opt.getAttribute('data-location-id') || '',
                    ipAddr: opt.getAttribute('data-ip-address') || '',
                    selected: opt.selected
                }));
            }

            const filterDevicesByLocation = () => {
                if (!selectEl || !locEl) return;
                const selectedLocId = locEl.value;
                const currentSelection = selectEl.value;
                
                // Clear existing
                selectEl.innerHTML = '';
                
                // Always add the default option
                const defaultOpt = document.createElement('option');
                defaultOpt.value = '';
                defaultOpt.text = '-- Select Machine --';
                selectEl.appendChild(defaultOpt);
                
                // Add matching options
                originalOptions.forEach(opt => {
                    if (opt.value === '') return; // Skip default
                    // If no location selected, or location matches
                    if (!selectedLocId || opt.locId === selectedLocId || opt.locId === '0') {
                        const newOpt = document.createElement('option');
                        newOpt.value = opt.value;
                        newOpt.text = opt.text;
                        newOpt.setAttribute('data-location-id', opt.locId);
                        newOpt.setAttribute('data-ip-address', opt.ipAddr);
                        if (opt.value === currentSelection || opt.selected) {
                            newOpt.selected = true;
                        }
                        selectEl.appendChild(newOpt);
                    }
                });
            };

            if (selectEl && inputEl) {
                const updateSelection = () => {
                    const selected = selectEl.options[selectEl.selectedIndex];
                    if (selected && selected.value) {
                        inputEl.value = selected.value;
                        const locId = selected.getAttribute('data-location-id');
                        if (locEl && locId && locId !== '0') {
                            locEl.value = locId;
                        }
                        const ipAddr = selected.getAttribute('data-ip-address');
                        if (ipEl && ipAddr) {
                            ipEl.value = ipAddr;
                        }
                    } else {
                        inputEl.value = '';
                    }
                };

                selectEl.addEventListener('change', updateSelection);
                
                // If LocationId is a dropdown, listen for changes to filter devices
                if (locEl && locEl.tagName.toLowerCase() === 'select') {
                    locEl.addEventListener('change', () => {
                        filterDevicesByLocation();
                        updateSelection();
                    });
                }

                // Initial filter on load
                filterDevicesByLocation();
                
                // Initialize if editing
                if (inputEl.value) {
                    const exists = Array.from(selectEl.options).some(o => o.value === inputEl.value);
                    if (exists) {
                        selectEl.value = inputEl.value;
                    }
                }
            }
        })();
    </script>
</div>
