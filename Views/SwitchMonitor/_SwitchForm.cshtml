@* FIX: Removed hardcoded value="public" which overrode edit values.
         Now uses placeholder and model binding only. *@
@model ManageEngineWebApp.Models.SwitchMaster

<div class="space-y-2">
    <input type="hidden" asp-for="Id" />

    <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
            Dashboard Machine / Device <span class="text-red-500">*</span>
        </label>
        <select id="DeviceNameSelect"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm
                       focus:ring-2 focus:ring-[#00BCEB] focus:border-transparent outline-none transition bg-white"
                required>
            <option value="">-- Select Machine --</option>
            @if (ViewBag.Devices != null)
            {
                foreach (var dev in ViewBag.Devices as List<ManageEngineWebApp.Models.WindowsUserDetails>)
                {
                    <option value="@dev.DomainName" data-location-id="@dev.LocationId" selected="@(dev.DomainName == Model.DeviceName)">
                        @dev.DomainName (@(string.IsNullOrEmpty(dev.UserName) ? "System" : dev.UserName))
                    </option>
                }
            }
        </select>
        <p class="text-xs text-gray-400 mt-1">Select a monitored machine from this location to link this switch</p>
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Device Name</label>
        <input asp-for="DeviceName"
               id="DeviceNameInput"
               placeholder="Auto-populated from machine selection"
               class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-gray-50
                      focus:ring-2 focus:ring-[#00BCEB] focus:border-transparent outline-none transition font-mono"
               readonly required />
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
            IP Address <span class="text-red-500">*</span>
        </label>
        <input asp-for="IpAddress"
               placeholder="e.g. 192.168.1.1"
               class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm
                      focus:ring-2 focus:ring-[#00BCEB] focus:border-transparent outline-none transition font-mono"
               required />
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">SNMP Community</label>
        <input asp-for="Community"
               placeholder="public"
               class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm
                      focus:ring-2 focus:ring-[#00BCEB] focus:border-transparent outline-none transition font-mono" />
        <p class="text-xs text-gray-400 mt-1">Leave blank to use "public"</p>
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Location</label>
        <select asp-for="LocationId"
                id="LocationId"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm
                       focus:ring-2 focus:ring-[#00BCEB] focus:border-transparent outline-none transition bg-white"
                required>
            <option value="">-- Select Location --</option>
            @if (ViewBag.Locations != null)
            {
                foreach (var loc in ViewBag.Locations as List<ManageEngineWebApp.Models.Locations>)
                {
                    <option value="@loc.Id">@loc.LocationName</option>
                }
            }
        </select>
        <p class="text-xs text-gray-400 mt-1">Group this switch by location (auto-mapped from selected machine)</p>
    </div>

    <script>
        (function() {
            const selectEl = document.getElementById('DeviceNameSelect');
            const inputEl = document.getElementById('DeviceNameInput');
            const locEl = document.getElementById('LocationId');

            if (selectEl && inputEl) {
                const updateSelection = () => {
                    const selected = selectEl.options[selectEl.selectedIndex];
                    if (selected && selected.value) {
                        inputEl.value = selected.value;
                        const locId = selected.getAttribute('data-location-id');
                        if (locEl && locId) {
                            locEl.value = locId;
                        }
                    } else {
                        inputEl.value = '';
                    }
                };

                selectEl.addEventListener('change', updateSelection);
                
                // Initialize if editing
                if (selectEl.value) {
                    updateSelection();
                }
            }
        })();
    </script>

    <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Device Type</label>
        <select asp-for="DeviceType"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm
                       focus:ring-2 focus:ring-[#00BCEB] focus:border-transparent outline-none transition bg-white">
            <option value="Switch">Switch</option>
            <option value="Router">Router</option>
            <option value="Firewall">Firewall</option>
        </select>
    </div>

    <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
        <div class="relative">
            <input asp-for="IsActive" type="checkbox"
                   id="IsActiveToggle"
                   class="sr-only peer" />
            <div class="w-10 h-5 bg-gray-300 peer-focus:ring-2 peer-focus:ring-[#00BCEB] rounded-full peer
                        peer-checked:bg-[#00BCEB] transition cursor-pointer"
                 onclick="document.getElementById('IsActiveToggle').click()"></div>
            <div class="absolute top-0.5 left-0.5 w-4 h-4 bg-white rounded-full shadow transition
                        peer-checked:translate-x-5 pointer-events-none"></div>
        </div>
        <div>
            <label for="IsActiveToggle" class="text-sm font-medium text-gray-700 cursor-pointer">Active</label>
            <p class="text-xs text-gray-400">Enable SNMP polling for this device</p>
        </div>
    </div>
</div>
