@{
    ViewData["Title"] = "Switch Templates";
    var templates = ViewBag.Templates as List<ManageEngineWebApp.Models.SwitchMoniterModels.SwitchTemplate>
                    ?? new List<ManageEngineWebApp.Models.SwitchMoniterModels.SwitchTemplate>();
}

<style>
    :root {
        --brand: #00BCEB;
        --brand-dark: #0086BE;
    }

    .form-input, .form-select {
        width: 100%;
        height: 32px;
        padding: 0 10px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        font-size: 11px;
        outline: none;
        background: #fff;
        color: #1f2937;
    }

        .form-input:focus, .form-select:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 3px rgba(0,188,235,.12);
        }

    .form-label {
        display: block;
        font-size: 10px;
        font-weight: 700;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 4px;
    }

    .form-hint {
        font-size: 9px;
        color: #9ca3af;
        margin-top: 3px;
        line-height: 1.3;
    }

    .oid-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 8px;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        background: #fff;
        font-size: 10px;
    }

        .oid-row + .oid-row {
            margin-top: 4px;
        }

    .oid-badge {
        font-size: 8px;
        font-weight: 700;
        padding: 1px 5px;
        border-radius: 4px;
        background: #eef2ff;
        color: #4338ca;
        white-space: nowrap;
    }

    .tpl-card {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 12px;
        background: #fff;
    }

        .tpl-card:hover {
            border-color: #cbd5e1;
        }

    .upload-zone {
        border: 1.5px dashed #cbd5e1;
        border-radius: 8px;
        padding: 16px;
        text-align: center;
        background: #f8fafc;
        transition: border-color .15s, background .15s;
    }

        .upload-zone:hover {
            border-color: var(--brand);
            background: #f0fbfe;
        }

        .upload-zone.dragover {
            border-color: var(--brand);
            background: #e0f7fc;
        }
</style>

<div class="max-w-4xl mx-auto p-4 space-y-4">

    <a href="/SwitchMonitor/Index" class="text-[11px] text-gray-500 hover:text-[var(--brand)] inline-flex items-center gap-1.5">
        <i class="fas fa-arrow-left text-[10px]"></i> Back to Switches
    </a>

    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-base font-bold text-gray-800">Switch Templates</h1>
            <p class="text-[11px] text-gray-500 mt-0.5">
                A template is built once — from a sample device, or typed in by hand — then reused across any
                number of switches of that same model. Nothing here is ever tied to a specific IP. Assign a
                template from the dropdown when you add or edit a switch.
            </p>
        </div>
        <button type="button" onclick="toggleBuilder()" class="h-8 px-3 text-[11px] font-semibold text-white rounded-lg flex items-center gap-1.5 flex-shrink-0" style="background:var(--brand)">
            <i class="fas fa-plus"></i> <span id="builderToggleText">New Template</span>
        </button>
    </div>

    <!-- ============================================================ -->
    <!-- Builder — two ways to define a template's OIDs:               -->
    <!--  1) Discover: probe ANY reference device once (IP used only   -->
    <!--     for that one probe, never saved)                          -->
    <!--  2) Manual: type OIDs in yourself, no device needed at all    -->
    <!-- ============================================================ -->
    <div id="templateBuilder" class="hidden p-4 bg-slate-50 border border-slate-200 rounded-xl space-y-3">
        <div class="flex items-center justify-between">
            <span class="text-[12px] font-bold text-gray-700 flex items-center gap-1.5">
                <i class="fas fa-layer-group text-[var(--brand)]"></i> New Template
            </span>
            <button type="button" onclick="toggleBuilder()" class="text-gray-400 hover:text-gray-600 text-xs">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- Mode tabs -->
        <div class="flex gap-1 p-1 bg-white border border-gray-200 rounded-lg w-fit">
            <button type="button" id="tabUpload" onclick="setMode('upload')"
                    class="h-6 px-3 text-[10px] font-semibold rounded-md transition">
                <i class="fas fa-file-upload"></i> Upload JSON
            </button>
            <button type="button" id="tabManual" onclick="setMode('manual')"
                    class="h-6 px-3 text-[10px] font-semibold rounded-md transition">
                <i class="fas fa-keyboard"></i> Enter OIDs manually
            </button>
            <button type="button" id="tabDiscover" onclick="setMode('discover')"
                    class="h-6 px-3 text-[10px] font-semibold rounded-md transition">
                <i class="fas fa-satellite-dish"></i> Discover from device
            </button>
        </div>


        <!-- ── Upload mode — matches the printer template upload exactly:      -->
        <!-- pick a file, everything is read from it, one button, done.        -->
        <div id="uploadMode" class="hidden space-y-2">
            <p class="form-hint">
                Same as the printer template upload — the file's <code>name</code>, <code>matchKey</code> and
                <code>items</code> are used as-is. Nothing here touches a live device or needs any typing.
            </p>

            <input type="file" id="templateFileInput" accept=".json,application/json" onchange="handleTemplateFileSelect(event)" class="hidden" />

            <div class="upload-zone" onclick="document.getElementById('templateFileInput').click()"
                 ondragover="event.preventDefault(); this.classList.add('dragover');"
                 ondragleave="this.classList.remove('dragover');"
                 ondrop="handleTemplateFileDrop(event)">
                <i class="fas fa-file-code text-[var(--brand)] text-base mb-1 block"></i>
                <p class="text-[10px] font-semibold text-gray-700 m-0">Click or Drag &amp; Drop Template JSON</p>
                <p class="text-[9px] text-gray-400 m-0">Accepts the standard switch template JSON format</p>
            </div>

            <!-- Preview card after file parsed — read-only, straight from the file -->
            <div id="templatePreviewCard" class="hidden p-2 bg-white border border-gray-200 rounded-md text-[10px] text-gray-600 space-y-1">
                <div class="flex justify-between items-center font-bold text-gray-800">
                    <span id="previewTemplateName">Template Name</span>
                    <span id="previewItemCount" class="px-1.5 py-0.5 bg-blue-50 text-blue-600 rounded text-[9px]">0 items</span>
                </div>
                <div class="text-[9px] text-gray-500 truncate" id="previewMatchKey">Match key: -</div>
                <div id="uploadPreviewItems" class="pt-1 space-y-1 max-h-40 overflow-y-auto pr-1"></div>
            </div>

            <div id="uploadErrorMsg" class="hidden text-[10px] text-red-600 bg-red-50 p-1.5 rounded"></div>

            <div class="flex justify-end gap-2 pt-1">
                <button type="button" onclick="resetUpload()" class="h-6 px-2.5 text-[10px] border border-gray-200 rounded text-gray-600 hover:bg-gray-100">Clear</button>
                <button type="button" id="btnConfirmUpload" onclick="submitTemplateUpload()" disabled class="h-6 px-3 text-[10px] font-semibold text-white rounded opacity-50 cursor-not-allowed flex items-center gap-1" style="background:var(--brand)">
                    <i class="fas fa-check"></i> Upload &amp; Apply
                </button>
            </div>
        </div>
        <!-- ── Discover mode ── -->
        <div id="discoverMode" class="space-y-3">
            <p class="form-hint">
                Point this at any one switch that runs the model you're templating (a spare unit, or the first one
                you're onboarding). Its IP is only used to run the SNMP probe below — it is <strong>not</strong>
                stored on the template, and the template you save here works for every other switch of that model too.
            </p>

        <div class="grid grid-cols-3 gap-2">
            <div class="col-span-2">
                <label class="form-label">Reference device IP</label>
                <input id="discoverIp" class="form-input font-mono" placeholder="192.168.1.1" />
            </div>
            <div>
                <label class="form-label">Community</label>
                <input id="discoverCommunity" class="form-input font-mono" placeholder="public" value="public" />
            </div>
        </div>

        <button type="button" id="btnDiscover" onclick="runDiscovery()" class="h-7 px-3 text-[10px] font-semibold text-white rounded flex items-center gap-1.5" style="background:var(--brand)">
            <i class="fas fa-broadcast-tower"></i> Discover
        </button>

        <div id="discoverErrorMsg" class="hidden text-[10px] text-red-600 bg-red-50 p-1.5 rounded"></div>
        <div id="discoverSysDescr" class="hidden text-[9px] text-gray-500 truncate"></div>
        <div id="discoveredList" class="hidden space-y-1 max-h-48 overflow-y-auto pr-1"></div>
        </div>

        <!-- ── Manual mode — no device, no IP, just type the OIDs in ── -->
        <div id="manualMode" class="hidden space-y-2">
            <p class="form-hint">
                Type each OID from the vendor's MIB/datasheet — no live device involved at all.
                <strong>SysInfo</strong> = a single value fetched once (hostname, uptime).
                <strong>PortTable</strong> = one row per port (name, status, RX, TX), fetched via SNMP walk.
            </p>
            <div id="manualRows" class="space-y-1 max-h-56 overflow-y-auto pr-1"></div>
            <button type="button" onclick="addManualRow()" class="h-6 px-2.5 text-[10px] font-semibold text-[var(--brand)] border border-dashed border-[var(--brand)] rounded flex items-center gap-1">
                <i class="fas fa-plus"></i> Add OID
            </button>
        </div>

        <div id="templateNameBox" class="hidden pt-1 space-y-2 border-t border-slate-200">
            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="form-label">Template Name <span class="text-red-500 normal-case">*</span></label>
                    <input id="newTemplateName" class="form-input" placeholder="e.g. D-Link DGS-1210 Series" />
                </div>
                <div>
                    <label class="form-label">Match Key</label>
                    <input id="newTemplateMatchKey" class="form-input" placeholder="keyword from sysDescr (optional)" />
                </div>
            </div>
            <div class="flex justify-end gap-2 pt-1">
                <button type="button" onclick="toggleBuilder()" class="h-6 px-2.5 text-[10px] border border-gray-200 rounded text-gray-600 hover:bg-gray-100">Cancel</button>
                <button type="button" id="btnSaveTemplate" onclick="saveNewTemplate()" disabled class="h-6 px-3 text-[10px] font-semibold text-white rounded opacity-50 cursor-not-allowed flex items-center gap-1" style="background:var(--brand)">
                    <i class="fas fa-check"></i> Save Template
                </button>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- Existing templates                                            -->
    <!-- ============================================================ -->
    <div id="templateListEmpty" class="text-[11px] text-gray-400 text-center py-10 @(templates.Any() ? "hidden" : "")">
        No templates yet. Click <strong>New Template</strong> to build one — from a sample device, or by hand.
    </div>

    <div id="templateList" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        @foreach (var t in templates)
        {
            <div class="tpl-card" data-template-id="@t.Id">
                <div class="flex items-start justify-between gap-2">
                    <div class="min-w-0">
                        <div class="text-[12px] font-bold text-gray-800 truncate">@t.Name</div>
                        @if (!string.IsNullOrWhiteSpace(t.MatchKey))
                        {
                            <div class="text-[9px] text-gray-400 truncate">match: @t.MatchKey</div>
                        }
                    </div>
                    <button type="button" onclick="deleteTemplate(@t.Id, this)" title="Delete template" class="text-gray-300 hover:text-red-500 flex-shrink-0">
                        <i class="fas fa-trash-alt text-[11px]"></i>
                    </button>
                </div>
                <div class="mt-2 text-[10px] text-gray-500 flex items-center gap-1.5">
                    <i class="fas fa-list-ul text-[9px]"></i> @t.ItemCount OIDs
                </div>
            </div>
        }
    </div>
</div>

<script>
    let currentMode = 'upload';

    function toggleBuilder() {
        const box = document.getElementById('templateBuilder');
        const label = document.getElementById('builderToggleText');
        box.classList.toggle('hidden');
        label.innerText = box.classList.contains('hidden') ? 'New Template' : 'Close';
        if (!box.classList.contains('hidden')) setMode('upload');
    }

    function setMode(mode) {
        currentMode = mode;

        document.getElementById('uploadMode').classList.toggle('hidden', mode !== 'upload');
        document.getElementById('manualMode').classList.toggle('hidden', mode !== 'manual');
        document.getElementById('discoverMode').classList.toggle('hidden', mode !== 'discover');

        [['tabUpload', 'upload'], ['tabManual', 'manual'], ['tabDiscover', 'discover']].forEach(([id, m]) => {
            const tab = document.getElementById(id);
            const active = m === mode;
            tab.style.background = active ? 'var(--brand)' : 'transparent';
            tab.style.color = active ? '#fff' : '#6b7280';
        });

        if (mode === 'manual' && document.getElementById('manualRows').children.length === 0) {
            addManualRow(); // start with one empty row so the form isn't blank
        }

        // Upload mode has its own preview + "Upload & Apply" button and never
        // touches the shared name/matchKey box — everything comes from the file.
        const nameBoxHidden = mode !== 'discover' || !lastDiscoveredOids.length;
        document.getElementById('templateNameBox').classList.toggle('hidden', mode === 'upload' ? true : nameBoxHidden);
        refreshSaveBtn();
    }

    /* ───────── Upload mode — mirrors the printer template upload exactly:
       pick/drop a file, everything (name, matchKey, items) is read straight
       from it, preview it read-only, one button submits it as-is. No typing. ───────── */
    let uploadedTemplateData = null;

    function resetUpload() {
        uploadedTemplateData = null;
        document.getElementById('templateFileInput').value = '';
        document.getElementById('templatePreviewCard').classList.add('hidden');
        document.getElementById('uploadErrorMsg').classList.add('hidden');
        const btn = document.getElementById('btnConfirmUpload');
        btn.disabled = true;
        btn.classList.add('opacity-50', 'cursor-not-allowed');
    }

    function showUploadError(msg) {
        resetUpload();
        const el = document.getElementById('uploadErrorMsg');
        el.innerText = msg;
        el.classList.remove('hidden');
    }

    function handleTemplateFileSelect(e) {
        const file = e.target.files[0];
        if (file) parseTemplateFile(file);
    }

    function handleTemplateFileDrop(e) {
        e.preventDefault();
        e.currentTarget.classList.remove('dragover');
        const file = e.dataTransfer.files[0];
        if (file) parseTemplateFile(file);
    }

    function parseTemplateFile(file) {
        document.getElementById('uploadErrorMsg').classList.add('hidden');

        const reader = new FileReader();
        reader.onload = () => {
            let data;
            try {
                data = JSON.parse(reader.result);
            } catch {
                showUploadError('That file is not valid JSON.');
                return;
            }

            if (!data.name || !Array.isArray(data.items) || !data.items.length) {
                showUploadError('File must have a "name" and a non-empty "items" array.');
                return;
            }
            const bad = data.items.find(i => !i.itemKey || !i.oid);
            if (bad) {
                showUploadError('Every item needs at least an "itemKey" and an "oid".');
                return;
            }

            uploadedTemplateData = {
                name: data.name,
                matchKey: data.matchKey || '',
                items: data.items.map(i => ({
                    itemKey: i.itemKey,
                    oid: i.oid,
                    category: i.category || (i.isTable ? 'PortTable' : 'SysInfo'),
                    isTable: i.isTable !== undefined ? !!i.isTable : (i.category !== 'SysInfo'),
                    snmpVersion: i.snmpVersion || 'Ver2'
                }))
            };

            document.getElementById('previewTemplateName').innerText = uploadedTemplateData.name;
            document.getElementById('previewItemCount').innerText = `${uploadedTemplateData.items.length} items`;
            document.getElementById('previewMatchKey').innerText = 'Match key: ' + (uploadedTemplateData.matchKey || '—');
            document.getElementById('uploadPreviewItems').innerHTML = uploadedTemplateData.items.map(item => `
                <div class="oid-row">
                    <span class="oid-badge">${item.itemKey}</span>
                    <span class="text-gray-500 font-mono flex-1 truncate">${item.oid}</span>
                    <span class="text-gray-400">${item.category} · ${item.snmpVersion}</span>
                </div>
            `).join('');
            document.getElementById('templatePreviewCard').classList.remove('hidden');

            const btn = document.getElementById('btnConfirmUpload');
            btn.disabled = false;
            btn.classList.remove('opacity-50', 'cursor-not-allowed');
        };
        reader.onerror = () => showUploadError('Could not read that file.');
        reader.readAsText(file);
    }

    function submitTemplateUpload() {
        if (!uploadedTemplateData) return;

        const btn = document.getElementById('btnConfirmUpload');
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Uploading...';

        fetch('/SwitchMonitor/SaveSwitchTemplate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(uploadedTemplateData)
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                location.reload();
            } else {
                alert(res.message || 'Failed to save template.');
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        })
        .catch(err => {
            alert('Network error: ' + err.message);
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        });
    }

    function showDiscoverError(msg) {
        const el = document.getElementById('discoverErrorMsg');
        el.innerText = msg;
        el.classList.remove('hidden');
        document.getElementById('discoveredList').classList.add('hidden');
    }

    let lastDiscoveredOids = [];

    function runDiscovery() {
        const ip = document.getElementById('discoverIp').value.trim();
        const community = document.getElementById('discoverCommunity').value.trim() || 'public';
        if (!ip) { showDiscoverError('Enter the reference device\'s IP address first.'); return; }

        document.getElementById('discoverErrorMsg').classList.add('hidden');
        const btn = document.getElementById('btnDiscover');
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Discovering...';

        fetch(`/SwitchMonitor/DiscoverSwitch?ip=${encodeURIComponent(ip)}&community=${encodeURIComponent(community)}`)
            .then(r => r.json())
            .then(res => {
                if (!res || res.success === false || !res.workingOids) {
                    showDiscoverError((res && res.message) || 'No response from device.');
                    return;
                }
                lastDiscoveredOids = res.workingOids || [];
                renderDiscoveredOids(res.sysDescr, lastDiscoveredOids);
            })
            .catch(err => showDiscoverError('Network error: ' + err.message))
            .finally(() => { btn.disabled = false; btn.innerHTML = originalHtml; });
    }

    function defaultChecked(itemKey) {
        return ['PortName_ifXName', 'PortStatus', 'RX_64bit', 'TX_64bit', 'Hostname', 'Uptime'].includes(itemKey);
    }

    function renderDiscoveredOids(sysDescr, items) {
        const sysEl = document.getElementById('discoverSysDescr');
        if (sysDescr) { sysEl.innerText = 'sysDescr: ' + sysDescr; sysEl.classList.remove('hidden'); }
        else { sysEl.classList.add('hidden'); }

        const list = document.getElementById('discoveredList');
        list.innerHTML = '';

        if (!items.length) { showDiscoverError('Device responded but none of the known OIDs returned data.'); return; }

        items.forEach((item, idx) => {
            const row = document.createElement('label');
            row.className = 'oid-row cursor-pointer';
            row.innerHTML = `
                    <input type="checkbox" class="oid-check" data-idx="${idx}" onchange="refreshSaveBtn()" ${defaultChecked(item.itemKey) ? 'checked' : ''} />
                    <span class="oid-badge">${item.itemKey}</span>
                    <span class="text-gray-500 font-mono flex-1 truncate">${item.oid}</span>
                    <span class="text-gray-400">${item.snmpVersion}</span>
                `;
            list.appendChild(row);
        });

        list.classList.remove('hidden');
        document.getElementById('templateNameBox').classList.remove('hidden');
        refreshSaveBtn();
    }

    function refreshSaveBtn() {
        if (currentMode === 'upload') return; // upload's button is managed in parseTemplateFile/resetUpload

        const nameOk = document.getElementById('newTemplateName').value.trim().length > 0;
        const hasItems = currentMode === 'discover'
            ? document.querySelectorAll('.oid-check:checked').length > 0
            : Array.from(document.querySelectorAll('.manual-row')).some(r =>
                r.querySelector('.m-key').value.trim() && r.querySelector('.m-oid').value.trim());

        const enabled = hasItems && nameOk;
        const btn = document.getElementById('btnSaveTemplate');
        btn.disabled = !enabled;
        btn.classList.toggle('opacity-50', !enabled);
        btn.classList.toggle('cursor-not-allowed', !enabled);
    }
    document.addEventListener('input', e => {
        if (e.target?.id === 'newTemplateName' || e.target?.classList?.contains('m-key') || e.target?.classList?.contains('m-oid')) refreshSaveBtn();
    });

    let manualRowSeq = 0;
    function addManualRow() {
        const id = ++manualRowSeq;
        const row = document.createElement('div');
        row.className = 'oid-row manual-row';
        row.dataset.rowId = id;
        row.innerHTML = `
            <input class="m-key form-input font-mono" style="height:26px" placeholder="ItemKey e.g. PortStatus" />
            <input class="m-oid form-input font-mono" style="height:26px" placeholder="1.3.6.1.2.1.2.2.1.8" />
            <select class="m-cat form-select" style="height:26px;width:100px">
                <option value="PortTable">PortTable</option>
                <option value="SysInfo">SysInfo</option>
            </select>
            <select class="m-ver form-select" style="height:26px;width:70px">
                <option value="Ver2">Ver2</option>
                <option value="Ver1">Ver1</option>
            </select>
            <button type="button" onclick="removeManualRow(${id})" class="text-gray-300 hover:text-red-500 flex-shrink-0">
                <i class="fas fa-trash-alt text-[10px]"></i>
            </button>
        `;
        document.getElementById('manualRows').appendChild(row);
        refreshSaveBtn();
    }

    function removeManualRow(id) {
        document.querySelector(`.manual-row[data-row-id="${id}"]`)?.remove();
        refreshSaveBtn();
    }

    function classifyItemKey(itemKey) {
        if (itemKey === 'Hostname' || itemKey === 'Uptime') return { category: 'SysInfo', isTable: false };
        return { category: 'PortTable', isTable: true };
    }

    function saveNewTemplate() {
        const name = document.getElementById('newTemplateName').value.trim();
        if (!name) { alert('Template name is required.'); return; }

        let items;
        if (currentMode === 'discover') {
            const checked = Array.from(document.querySelectorAll('.oid-check:checked'))
                .map(cb => lastDiscoveredOids[parseInt(cb.getAttribute('data-idx'), 10)]);
            if (!checked.length) { alert('Select at least one OID.'); return; }
            items = checked.map(item => {
                const cls = classifyItemKey(item.itemKey);
                return { itemKey: item.itemKey, oid: item.oid, category: cls.category, isTable: cls.isTable, snmpVersion: item.snmpVersion };
            });
        } else {
            items = Array.from(document.querySelectorAll('.manual-row')).map(r => {
                const category = r.querySelector('.m-cat').value;
                return {
                    itemKey: r.querySelector('.m-key').value.trim(),
                    oid: r.querySelector('.m-oid').value.trim(),
                    category,
                    isTable: category === 'PortTable',
                    snmpVersion: r.querySelector('.m-ver').value
                };
            }).filter(i => i.itemKey && i.oid);
            if (!items.length) { alert('Add at least one OID with both an item name and an OID.'); return; }
        }

        const payload = { name, matchKey: document.getElementById('newTemplateMatchKey').value.trim(), items };

        const btn = document.getElementById('btnSaveTemplate');
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

        fetch('/SwitchMonitor/SaveSwitchTemplate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    location.reload(); // simplest way to show the new card + refresh dropdowns elsewhere
                } else {
                    alert(res.message || 'Failed to save template.');
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            })
            .catch(err => { alert('Network error: ' + err.message); btn.disabled = false; btn.innerHTML = originalHtml; });
    }

    function deleteTemplate(id, btnEl) {
        if (!confirm('Delete this template? Switches currently assigned to it must be reassigned first.')) return;

        fetch('/SwitchMonitor/DeleteSwitchTemplate?id=' + id, { method: 'POST' })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    btnEl.closest('.tpl-card').remove();
                    if (!document.querySelector('.tpl-card')) document.getElementById('templateListEmpty').classList.remove('hidden');
                } else {
                    alert(res.message || 'Could not delete template.');
                }
            })
            .catch(err => alert('Network error: ' + err.message));
    }
</script>
