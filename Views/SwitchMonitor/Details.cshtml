@model ManageEngineWebApp.Models.DeviceStatus
@{
    ViewData["Title"] = "Switch Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var sw = ViewBag.Switch as ManageEngineWebApp.Models.SwitchMaster;
    var agentHistory = ViewBag.AgentHistory as List<ManageEngineWebApp.Models.AgentPollHistory>;

    bool isUp = Model?.Status == "Up";
    bool isDown = Model?.Status != "Up" && Model?.Status != "Not Polled Yet" && Model?.Status != null;
    bool hasPolled = Model?.Status != "Not Polled Yet" && Model?.CreatedOn > DateTime.MinValue;

    var portsUp = Model?.Ports?.Count(p => p.PortState == "Up") ?? 0;
    var portsDown = Model?.Ports?.Count(p => p.PortState != "Up") ?? 0;
    var totalPorts = portsUp + portsDown;

    var _q = Context.Request.Query;
    int? scopeComId = ViewBag.ComId as int? ?? (_q.ContainsKey("comId") && int.TryParse(_q["comId"], out var _c) ? (int?)_c : null);
    int? scopeGroupId = ViewBag.GroupId as int? ?? (_q.ContainsKey("groupId") && int.TryParse(_q["groupId"], out var _g) ? (int?)_g : null);
    int? scopeLocationId = ViewBag.LocationId as int? ?? (_q.ContainsKey("locationId") && int.TryParse(_q["locationId"], out var _l) ? (int?)_l : null);
    string scopeComName = ViewBag.CompanyName as string ?? _q["companyName"].ToString();
    string scopeGroupName = ViewBag.GroupName as string ?? _q["groupName"].ToString();
    string scopeLocName = ViewBag.LocationName as string ?? _q["locationName"].ToString();
}

<style>
    :root {
        --brand: #00BCEB;
        --brand-dark: #0086BE;
        --brand-mid: #0096BE;
        --brand-bg: rgba(0,188,235,.07);
        --brand-border: rgba(0,188,235,.18);
    }

    .pulse {
        animation: dp 2s ease-in-out infinite;
    }

    @@keyframes dp {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .4;
        }
    }

    /* ── Thin scrollbar ── */
    .thin-scroll::-webkit-scrollbar {
        width: 4px;
        height: 4px;
    }

    .thin-scroll::-webkit-scrollbar-track {
        background: transparent;
    }

    .thin-scroll::-webkit-scrollbar-thumb {
        background: #d1d5db;
        border-radius: 4px;
    }

    /* ── Port row hover ── */
    .port-row {
        transition: background .1s;
    }

        .port-row:hover {
            background: #f8fcfe;
        }
</style>

<div class="px-4 py-3 max-w-7xl mx-auto">

    <!-- ═══════════ PAGE HEADER ═══════════ -->
    <div class="flex items-center gap-3 mb-4 flex-wrap">
        @{
            var backParams = new Dictionary<string, object>();
            if (scopeComId != null) backParams["comId"] = scopeComId;
            if (scopeGroupId != null) backParams["groupId"] = scopeGroupId;
            if (scopeLocationId != null) backParams["locationId"] = scopeLocationId;
            if (!string.IsNullOrEmpty(scopeComName)) backParams["companyName"] = scopeComName;
            if (!string.IsNullOrEmpty(scopeGroupName)) backParams["groupName"] = scopeGroupName;
            if (!string.IsNullOrEmpty(scopeLocName)) backParams["locationName"] = scopeLocName;
        }
        <a href="@Url.Action("Index", backParams)"
           title="Back to Switch Monitor"
           class="w-7 h-7 flex-shrink-0 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 flex items-center justify-center shadow-sm transition">
            <i class="fas fa-arrow-left text-gray-500 text-[11px]"></i>
        </a>

        <div class="flex items-center gap-2.5 flex-1 min-w-0">
            <div class="w-8 h-8 rounded-lg flex-shrink-0 flex items-center justify-center"
                 style="background:linear-gradient(135deg,var(--brand),var(--brand-dark))">
                <i class="fas fa-server text-white text-xs"></i>
            </div>
            <div class="min-w-0">
                <h1 class="text-sm font-bold text-gray-900 leading-tight truncate">@(sw?.DeviceName ?? "Switch")</h1>
                <p class="text-[10px] font-mono text-gray-400 leading-none mt-0.5">@sw?.IpAddress</p>
            </div>
        </div>

        <!-- Status badge -->
        <span class="flex-shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold border
            @(isUp ? "bg-emerald-50 text-emerald-700 border-emerald-200"
                                 : (Model?.Status == "Not Polled Yet" ? "bg-gray-100 text-gray-500 border-gray-200"
                                                                       : "bg-red-50 text-red-600 border-red-200"))">
            @if (isUp)
            {
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 pulse flex-shrink-0"></span>
            }
            else if (isDown)
            {

                <span class="w-1.5 h-1.5 rounded-full bg-red-500 flex-shrink-0"></span>
            }
            @(Model?.Status ?? "Unknown")
        </span>

        @if (!hasPolled)
        {
            <form asp-action="TriggerPoll" method="post" class="ml-auto">
                @Html.AntiForgeryToken()
                <input type="hidden" name="comId" value="@scopeComId" />
                <input type="hidden" name="groupId" value="@scopeGroupId" />
                <input type="hidden" name="locationId" value="@scopeLocationId" />
                <input type="hidden" name="companyName" value="@scopeComName" />
                <input type="hidden" name="groupName" value="@scopeGroupName" />
                <input type="hidden" name="locationName" value="@scopeLocName" />
                <button type="submit"
                        class="h-7 px-3.5 text-white rounded-lg text-xs font-semibold flex items-center gap-1.5 transition shadow-sm hover:shadow"
                        style="background:linear-gradient(135deg,var(--brand),var(--brand-mid))">
                    <i class="fas fa-sync-alt text-[10px]"></i> Poll Now
                </button>
            </form>
        }
    </div>

    <!-- ═══════════ TOP ROW: INFO + PORT STATS ═══════════ -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-4">

        <!-- ── Device Info ── -->
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-4 py-2.5 border-b border-gray-100 flex items-center gap-2"
                 style="background:linear-gradient(135deg,var(--brand),var(--brand-dark))">
                <i class="fas fa-server text-[10px]" style="color:rgba(255,255,255,0.7)"></i>
                <span class="text-[10px] font-bold text-white/90 uppercase tracking-widest">Device Info</span>
            </div>
            <dl class="divide-y divide-gray-50 text-xs">
                <div class="flex justify-between items-center px-4 py-2">
                    <dt class="text-gray-400 font-medium">IP Address</dt>
                    <dd><span class="font-mono bg-gray-50 border border-gray-100 px-1.5 py-0.5 rounded text-[10px] text-gray-700">@sw?.IpAddress</span></dd>
                </div>
                <div class="flex justify-between items-center px-4 py-2">
                    <dt class="text-gray-400 font-medium">Community</dt>
                    <dd><span class="font-mono bg-gray-50 border border-gray-100 px-1.5 py-0.5 rounded text-[10px] text-gray-700">@(sw?.Community ?? "public")</span></dd>
                </div>
                <div class="flex justify-between items-center px-4 py-2">
                    <dt class="text-gray-400 font-medium">Device Type</dt>
                    <dd class="text-gray-700">@sw?.DeviceType</dd>
                </div>
                <div class="flex justify-between items-center px-4 py-2">
                    <dt class="text-gray-400 font-medium">Location</dt>
                    <dd class="text-gray-700 text-[10px]">
                        @if (!string.IsNullOrEmpty(scopeLocName))
                        {
                            <span class="inline-flex items-center gap-1">
                                <i class="fas fa-map-marker-alt text-[9px]" style="color:var(--brand)"></i>
                                @scopeLocName
                            </span>
                        }
                        else
                        {

                            <span class="text-gray-300">—</span>
                        }
                    </dd>
                </div>
                <div class="flex justify-between items-center px-4 py-2">
                    <dt class="text-gray-400 font-medium">Polling</dt>
                    <dd>
                        @if (sw?.IsActive == true)
                        {
                            <span class="inline-flex items-center gap-1 text-emerald-600 text-[10px] font-semibold">
                                <i class="fas fa-check-circle"></i> Active
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1 text-amber-500 text-[10px] font-semibold">
                                <i class="fas fa-pause-circle"></i> Disabled
                            </span>
                        }
                    </dd>
                </div>
                <div class="flex justify-between items-center px-4 py-2">
                    <dt class="text-gray-400 font-medium">Last Poll</dt>
                    <dd class="text-gray-600 text-[10px] font-mono">@(hasPolled? Model!.CreatedOn.ToString("yyyy-MM-dd HH:mm:ss") : "Never")</dd>
                </div>
                <div class="flex justify-between items-center px-4 py-2">
                    <dt class="text-gray-400 font-medium">Uptime</dt>
                    <dd class="font-mono text-gray-600 text-[10px] truncate max-w-[140px]" title="@Model?.UpTime">
                        @(string.IsNullOrEmpty(Model?.UpTime) ? "—" : Model!.UpTime)
                    </dd>
                </div>
            </dl>
        </div>

        <!-- ── Port Summary ── -->
        <div class="lg:col-span-2 flex flex-col gap-3">
            <!-- 3 stat tiles -->
            <div class="grid grid-cols-3 gap-3">
                <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4 text-center">
                    <p class="text-2xl font-bold text-gray-800 leading-none">@totalPorts</p>
                    <p class="text-[9px] text-gray-400 font-bold uppercase tracking-wider mt-1">Total</p>
                </div>
                <div class="bg-emerald-50 rounded-xl border border-emerald-200 shadow-sm p-4 text-center">
                    <p class="text-2xl font-bold text-emerald-600 leading-none">@portsUp</p>
                    <p class="text-[9px] text-emerald-500 font-bold uppercase tracking-wider mt-1">Up</p>
                </div>
                <div class="bg-red-50 rounded-xl border border-red-200 shadow-sm p-4 text-center">
                    <p class="text-2xl font-bold text-red-500 leading-none">@portsDown</p>
                    <p class="text-[9px] text-red-400 font-bold uppercase tracking-wider mt-1">Down</p>
                </div>
            </div>

            @if (totalPorts > 0)
            {
                var pct = portsUp * 100 / totalPorts;
                <!-- Port utilisation bar -->
                <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4">
                    <div class="flex justify-between text-[10px] text-gray-500 mb-2">
                        <span class="font-semibold text-gray-600">Port Utilisation</span>
                        <span class="font-mono font-semibold">@portsUp / @totalPorts up — @pct%</span>
                    </div>
                    <div class="w-full bg-gray-100 rounded-full h-2.5">
                        <div class="h-2.5 rounded-full transition-all"
                             style="width:@pct%;background:linear-gradient(90deg,#34d399,#10b981)"></div>
                    </div>

                    <!-- Quick port state breakdown sparkline-ish -->
                    <div class="mt-3 flex gap-1 flex-wrap">
                        @if (Model?.Ports != null)
                        {
                            @foreach (var port in Model.Ports.OrderBy(p => p.PortName).Take(48))
                            {
                                bool pu = port.PortState == "Up";
                                <div class="w-2.5 h-5 rounded-sm @(pu ? "bg-emerald-400" : "bg-red-300")"
                                     title="@port.PortName — @port.PortState"></div>
                            }
                        }
                    </div>
                    @if (Model?.Ports?.Count > 48)
                    {
                        <p class="text-[9px] text-gray-400 mt-1.5">Showing first 48 of @Model.Ports.Count ports</p>
                    }
                </div>
            }
        </div>
    </div>

    <!-- ═══════════ PORT TABLE ═══════════ -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-4">
        <div class="px-4 py-2.5 flex items-center gap-3 border-b border-gray-100"
             style="background:linear-gradient(135deg,var(--brand),var(--brand-dark))">
            <i class="fas fa-ethernet text-[10px]" style="color:rgba(255,255,255,0.7)"></i>
            <span class="text-[10px] font-bold text-white/90 uppercase tracking-widest flex-1">Port Status</span>
            @if (totalPorts > 0)
            {
                <div class="relative">
                    <i class="fas fa-search absolute left-2 top-1/2 -translate-y-1/2 text-gray-400 text-[9px]"></i>
                    <input type="text" id="portSearch" placeholder="Filter…"
                           oninput="filterPorts(this.value)"
                           class="h-6 pl-6 pr-2 border border-white/10 rounded-md text-[10px] bg-white/10 text-white placeholder-gray-400 outline-none focus:bg-white/20 w-28 transition" />
                </div>
            }
        </div>

        @if (Model?.Ports != null && Model.Ports.Any())
        {
            <div class="overflow-x-auto thin-scroll">
                <table class="min-w-full text-xs" id="portsTable">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-100">
                            <th class="px-3 py-2 text-left text-[10px] font-semibold text-gray-500 uppercase tracking-wide whitespace-nowrap">Port</th>
                            <th class="px-3 py-2 text-left text-[10px] font-semibold text-gray-500 uppercase tracking-wide whitespace-nowrap">State</th>
                            <th class="px-3 py-2 text-right text-[10px] font-semibold text-gray-500 uppercase tracking-wide whitespace-nowrap">RX</th>
                            <th class="px-3 py-2 text-right text-[10px] font-semibold text-gray-500 uppercase tracking-wide whitespace-nowrap">TX</th>
                            <th class="px-3 py-2 text-right text-[10px] font-semibold text-gray-500 uppercase tracking-wide whitespace-nowrap">Total</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @foreach (var port in Model.Ports.OrderBy(p => p.PortName))
                        {
                            bool portUp = port.PortState == "Up";
                            <tr class="port-row" data-portname="@port.PortName.ToLower()">
                                <td class="px-3 py-2 font-mono text-[10px] text-gray-700">@port.PortName</td>
                                <td class="px-3 py-2">
                                    <span class="inline-flex items-center gap-1.5 text-[10px] font-semibold @(portUp ? "text-emerald-600" : "text-red-500")">
                                        <span class="w-1.5 h-1.5 rounded-full @(portUp ? "bg-emerald-500" : "bg-red-400")"></span>
                                        @port.PortState
                                    </span>
                                </td>
                                <td class="px-3 py-2 text-right font-mono text-[10px] text-gray-600">@FormatBytes(port.RX)</td>
                                <td class="px-3 py-2 text-right font-mono text-[10px] text-gray-600">@FormatBytes(port.TX)</td>
                                <td class="px-3 py-2 text-right font-mono text-[10px] text-gray-400">@FormatBytes(port.RX + port.TX)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-10">
                <i class="fas fa-plug text-2xl text-gray-200 mb-2"></i>
                <p class="text-gray-400 text-xs">No port data — run a poll to collect port information.</p>
            </div>
        }
    </div>

    <!-- ═══════════ AGENT POLL HISTORY ═══════════ -->
    @if (agentHistory != null && agentHistory.Any())
    {
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-4 py-2.5 border-b border-gray-100 flex items-center gap-2"
                 style="background:linear-gradient(135deg,var(--brand),var(--brand-dark))">
                <i class="fas fa-history text-[10px]" style="color:rgba(255,255,255,0.7)"></i>
                <span class="text-[10px] font-bold text-white/90 uppercase tracking-widest flex-1">Agent Poll History</span>
                <span class="text-[9px] text-gray-500">last @agentHistory.Count polls</span>
            </div>
            <div class="overflow-x-auto thin-scroll">
                <table class="min-w-full text-xs">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-100">
                            <th class="px-3 py-2 text-left text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Time</th>
                            <th class="px-3 py-2 text-left text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Status</th>
                            <th class="px-3 py-2 text-left text-[10px] font-semibold text-gray-500 uppercase tracking-wide">CPU</th>
                            <th class="px-3 py-2 text-left text-[10px] font-semibold text-gray-500 uppercase tracking-wide">RAM</th>
                            <th class="px-3 py-2 text-left text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Disk</th>
                            <th class="px-3 py-2 text-left text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Uptime</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @foreach (var h in agentHistory)
                        {
                            bool hUp = h.Status == "Up";
                            <tr class="port-row">
                                <td class="px-3 py-2 font-mono text-[10px] text-gray-500">@h.PollTime.ToString("MM-dd HH:mm:ss")</td>
                                <td class="px-3 py-2">
                                    <span class="inline-flex items-center gap-1 text-[10px] font-semibold @(hUp ? "text-emerald-600" : "text-red-500")">
                                        <span class="w-1.5 h-1.5 rounded-full @(hUp ? "bg-emerald-500" : "bg-red-400")"></span>
                                        @h.Status
                                    </span>
                                </td>
                                <td class="px-3 py-2 text-gray-600">@(h.Cpu ?? "—")</td>
                                <td class="px-3 py-2 text-gray-600">@(h.Ram ?? "—")</td>
                                <td class="px-3 py-2 text-gray-600">@(h.Disk ?? "—")</td>
                                <td class="px-3 py-2 font-mono text-[10px] text-gray-500 truncate max-w-[100px]">@(h.UpTime ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@functions {
    string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] u = { "B", "KB", "MB", "GB", "TB" };
        int i = 0; double v = bytes;
        while (v >= 1024 && i < u.Length - 1) { v /= 1024; i++; }
        return $"{v:0.##} {u[i]}";
    }
}

<script>
    function filterPorts(q) {
        q = q.toLowerCase();
        document.querySelectorAll('#portsTable .port-row').forEach(row => {
            const name = row.dataset.portname ?? '';
            row.style.display = name.includes(q) ? '' : 'none';
        });
    }
</script>
