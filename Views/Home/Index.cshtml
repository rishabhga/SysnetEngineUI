@{
    ViewData["Title"] = "Organization Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        #mainContent { padding: 0.5rem !important; background: #f8fafc !important; }
        #breadcrumbs { display: none !important; }
        .app-content-inner { max-width: 100% !important; padding: 0 !important; }

        :root {
            --glass: rgba(255, 255, 255, 0.7);
            --glass-border: rgba(255, 255, 255, 0.3);
            --accent: #2563eb;
        }

        .premium-card {
            background: var(--glass);
            backdrop-filter: blur(8px);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .premium-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 10px 10px -5px rgba(0, 0, 0, 0.02);
            border-borderColor: rgba(37, 99, 235, 0.2);
        }

        .company-strip-wrap {
            overflow-x: auto;
            scrollbar-width: none; /* Firefox */
            -ms-overflow-style: none;  /* IE and Edge */
        }
        .company-strip-wrap::-webkit-scrollbar { display: none; }

        .lbl-tech {
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #64748b;
        }

        .table-compact th {
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            color: #64748b;
            padding: 12px 16px;
            background: #f8fafc;
            border-bottom: 1px solid #edf2f7;
        }

        .table-compact td {
            font-size: 12px;
            padding: 10px 16px;
            border-bottom: 1px solid #f8fafc;
        }

        .nav-trail {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            font-weight: 600;
            color: #94a3b8;
            margin-bottom: 16px;
        }

        .animate-slide-up {
            animation: slideUp 0.4s ease-out forwards;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
}

<div class="px-6 py-4">
    
    @* --- TOP NAVIGATION TRAIL --- *@
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
        <div>
            <ul id="hierarchyBreadcrumbs" class="nav-trail">
                <!-- Populated by JS -->
                <li class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-slate-300 animate-pulse"></span>
                    <span>INITIALIZING...</span>
                </li>
            </ul>
            <h1 class="text-2xl font-black text-slate-800 tracking-tight">Explorer</h1>
        </div>
        
        <div class="flex items-center gap-2 bg-white/50 p-1.5 rounded-xl border border-slate-200">
            <div class="flex items-center gap-3 px-3 py-1.5 rounded-lg bg-blue-500 text-white shadow-lg shadow-blue-200">
                <i class="fas fa-network-wired text-sm"></i>
                <div class="flex flex-col">
                    <span class="text-[9px] font-black opacity-75 uppercase">Hub Status</span>
                    <span class="text-xs font-bold leading-none">ACTIVE</span>
                </div>
            </div>
            <button onclick="DashboardHierarchy.init()" class="p-2 hover:bg-slate-100 rounded-lg text-slate-400 transition">
                <i class="fas fa-sync-alt"></i>
            </button>
        </div>
    </div>

    @* --- COMPANY STRIP --- *@
    <div class="company-strip-wrap mb-8">
        <div id="companyStrip" class="flex items-center gap-4 py-2">
            <!-- Populated by JS -->
        </div>
    </div>

    @* --- MAIN HIERARCHY CONTENT --- *@
    <div id="hierarchyContainer" class="animate-slide-up">
        <!-- Dynamic content grid/table populated by dashboard-hierarchy.js -->
        <div class="flex flex-col items-center justify-center py-32 opacity-20">
            <i class="fas fa-circle-notch fa-spin text-4xl mb-4"></i>
            <p class="font-bold tracking-widest text-sm">CORE LOAD</p>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/dashboard-hierarchy.js" asp-append-version="true"></script>
}