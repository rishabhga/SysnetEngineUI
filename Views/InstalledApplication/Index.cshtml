@model List<InstalledApplication>

<h2>Windows User Details</h2>
<style>
    /* Main Layout */
    .main-container {
        font-family: Arial, sans-serif;
    }

    /* Horizontal Menu Bar */
    .horizontal-menu {
        background-color: #333;
        color: white;
        padding: 10px 0;
        display: flex;
        justify-content: center;
    }

        .horizontal-menu ul {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
        }

            .horizontal-menu ul li {
                margin: 0 15px;
                padding: 10px 20px;
                cursor: pointer;
                color: white;
                font-weight: bold;
                transition: background-color 0.3s;
            }

                .horizontal-menu ul li:hover {
                    background-color: #575757;
                }

    /* Content Container */
    .content-container {
        display: flex;
        margin-top: 20px;
    }

    /* Vertical Menu Bar */
    .vertical-menu {
        width: 200px;
        background-color: #f4f4f4;
        border-right: 1px solid #ddd;
        padding: 10px;
    }

        .vertical-menu ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .vertical-menu ul li {
                margin: 10px 0;
                padding: 10px;
                background-color: #e9e9e9;
                border-radius: 5px;
                cursor: pointer;
                transition: background-color 0.3s;
            }

                .vertical-menu ul li:hover {
                    background-color: #ddd;
                }

    /* Content Area */
    .content-area {
        flex-grow: 1;
        padding: 20px;
    }
  

</style>


<div class="main-container">
    <!-- Horizontal Menu Bar -->
    <div class="horizontal-menu">
        <ul>
            <li onclick="updateVerticalMenu('summary')">Summary</li>
            <li onclick="updateVerticalMenu('system')">System</li>
            <li onclick="updateVerticalMenu('hardware')">Hardware</li>
            <li onclick="updateVerticalMenu('software')">Software</li>
            <li onclick="updateVerticalMenu('security')">Security</li>
        </ul>
    </div>

    <div class="content-container">
        <!-- Vertical Menu Bar -->
        @* <div class="vertical-menu" id="vertical-menu"> *@
            <table class="table table-bordered font-monospace">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Software Name</th>
                        <th>Version</th>
                        <th>OS Compatibility</th>
                        <th>Manufacturer</th>
                        <th>Installed Date</th>
                        <th>Usages</th>
                        <th>DateTime</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {

                        <tr>
                            <td>@item.Id</td>
                            <td>@item.SoftwareName</td>
                            <td>@item.Version</td>
                            <td>@item.OSCompatibility</td>
                            <td>@item.Manufacturer</td>
                            <td>@item.InstalledDate</td>
                            <td>@item.Usages</td>
                            <td>@item.DateTime</td>
                        </tr>
                    }
                </tbody>
            </table>
            <!-- Vertical menu items will be dynamically updated -->
        </div>

        <!-- Content Area -->
        <div class="content-area" id="content-area">
            <h2>Welcome</h2>
            <p>Select a category from the horizontal menu to see details here.</p>
        </div>
    </div>
</div>



<script>


    // Define vertical menu items for each category
    const menuData = {
        summary: ["Overview", "Details", "Reports"],
        system: ["Services", "Users", "Groups", "Drivers"],
        hardware: ["Components", "Specifications", "Monitors"],
        software: ["Installed Apps", "Updates", "Licenses"],
        security: ["Antivirus", "Firewall", "Encryption"]
    };

    // Update the vertical menu dynamically
    function updateVerticalMenu(category) {
        const verticalMenu = document.getElementById("vertical-menu");
        const contentArea = document.getElementById("content-area");

        // Clear the current vertical menu
        verticalMenu.innerHTML = "";

        // Populate vertical menu items
        const ul = document.createElement("ul");
        menuData[category].forEach(item => {
            const li = document.createElement("li");
            li.innerText = item;
            li.onclick = () => updateContentArea(category, item);
            ul.appendChild(li);
        });
        verticalMenu.appendChild(ul);

        // Reset content area
        contentArea.innerHTML = `<h2>${category.charAt(0).toUpperCase() + category.slice(1)}</h2>
                                 <p>Select an option from the vertical menu.</p>`;
    }

    // Update content area dynamically
    function updateContentArea(category, item) {
        const contentArea = document.getElementById("content-area");
        contentArea.innerHTML = `<h2>${item}</h2>
                                 <p>Showing details for ${item} in ${category}.</p>`;
    }
    function updateContentArea(category, item) {
        fetch(`/api/${category}/${item}`)
            .then(response => response.json())
            .then(data => {
                const contentArea = document.getElementById("content-area");
                contentArea.innerHTML = `<h2>${item}</h2>
                                         <pre>${JSON.stringify(data, null, 2)}</pre>`;
            })
            .catch(error => console.error("Error fetching data:", error));
    }

</script>
