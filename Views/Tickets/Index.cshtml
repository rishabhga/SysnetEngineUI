@model IEnumerable<ManageEngineWebApp.Controllers.Ticket>

@{
    ViewData["Title"] = "Service Desk";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var username = Context.Session.GetString("username");
    var userRole = Context.Session.GetString("role");
    var isSuperAdmin = userRole == "SuperAdmin";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Service Desk</h1>
            <p class="text-sm text-gray-600">Manage support tickets and assignments</p>
        </div>
        <button onclick="openCreateModal()" class="bg-gradient-to-r from-blue-600 to-cyan-500 text-white px-4 py-2 rounded-lg shadow-md hover:opacity-90 transition">
            <i class="fas fa-plus mr-2"></i>New Ticket
        </button>
    </div>

    <!-- Ticket Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200">
            <div class="flex justify-between items-center">
                <div>
                    <p class="text-xs text-gray-500 font-bold uppercase">Total Tickets</p>
                    <p class="text-2xl font-bold text-gray-900">@Model.Count()</p>
                </div>
                <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600">
                    <i class="fas fa-ticket-alt"></i>
                </div>
            </div>
        </div>
         <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200">
            <div class="flex justify-between items-center">
                <div>
                    <p class="text-xs text-gray-500 font-bold uppercase">Open</p>
                    <p class="text-2xl font-bold text-gray-900">@Model.Count(t => t.Status == "Open")</p>
                </div>
                <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center text-green-600">
                    <i class="fas fa-folder-open"></i>
                </div>
            </div>
        </div>
         <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200">
            <div class="flex justify-between items-center">
                <div>
                    <p class="text-xs text-gray-500 font-bold uppercase">Assigned</p>
                    <p class="text-2xl font-bold text-gray-900">@Model.Count(t => t.Status == "Assigned")</p>
                </div>
                <div class="w-10 h-10 bg-yellow-100 rounded-lg flex items-center justify-center text-yellow-600">
                    <i class="fas fa-user-clock"></i>
                </div>
            </div>
        </div>
         <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200">
            <div class="flex justify-between items-center">
                <div>
                    <p class="text-xs text-gray-500 font-bold uppercase">Closed</p>
                    <p class="text-2xl font-bold text-gray-900">@Model.Count(t => t.Status == "Closed")</p>
                </div>
                <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center text-gray-600">
                    <i class="fas fa-check-circle"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Ticket List -->
    <div class="bg-white shadow-sm rounded-xl border border-gray-200 overflow-hidden">
        <table class="w-full text-sm text-left text-gray-500">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b">
                <tr>
                    <th class="px-6 py-3">ID</th>
                    <th class="px-6 py-3">Subject</th>
                    <th class="px-6 py-3">Computer/Domain</th>
                    <th class="px-6 py-3">Priority</th>
                    <th class="px-6 py-3">Status</th>
                    <th class="px-6 py-3">Assigned To</th>
                    <th class="px-6 py-3">Created</th>
                    <th class="px-6 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="bg-white border-b hover:bg-gray-50">
                        <td class="px-6 py-4 font-medium text-gray-900">#@item.Id</td>
                        <td class="px-6 py-4">
                            <span class="font-semibold text-gray-800">@item.Subject</span>
                            <div class="text-xs text-gray-400 mt-0.5 truncate max-w-xs">@item.Description</div>
                        </td>
                        <td class="px-6 py-4">@item.Domain</td>
                        <td class="px-6 py-4">
                            @if(item.Priority == "High")
                            {
                                <span class="bg-red-100 text-red-800 text-xs font-semibold px-2.5 py-0.5 rounded">High</span>
                            }
                            else if(item.Priority == "Medium")
                            {
                                <span class="bg-yellow-100 text-yellow-800 text-xs font-semibold px-2.5 py-0.5 rounded">Medium</span>
                            }
                            else
                            {
                                <span class="bg-green-100 text-green-800 text-xs font-semibold px-2.5 py-0.5 rounded">Low</span>
                            }
                        </td>
                        <td class="px-6 py-4">
                            <span class="px-2 py-1 rounded text-xs font-semibold 
                                  @(item.Status == "Open" ? "bg-green-100 text-green-800" : 
                                    item.Status == "Closed" ? "bg-gray-100 text-gray-600" : 
                                    "bg-blue-100 text-blue-800")">
                                @item.Status
                            </span>
                        </td>
                        <td class="px-6 py-4">
                            @if(!string.IsNullOrEmpty(item.AssignedTo))
                            {
                                <div class="flex items-center">
                                    <div class="w-6 h-6 rounded-full bg-cyan-100 text-cyan-600 flex items-center justify-center text-xs mr-2 border border-cyan-200">
                                        @item.AssignedTo.Substring(0,1)
                                    </div>
                                    @item.AssignedTo
                                </div>
                            }
                            else
                            {
                                <span class="text-gray-400 italic">Unassigned</span>
                            }
                        </td>
                        <td class="px-6 py-4">@item.CreatedDate.ToString("MMM dd, yyyy")</td>
                        <td class="px-6 py-4 text-right">
                             @if(isSuperAdmin || userRole == "CompanyAdmin" || userRole == "Engineer") // Only admins/engineers can assign
                            {
                                <button onclick="openAssignModal(@item.Id, '@item.Subject')" class="text-blue-600 hover:text-blue-900 border border-blue-200 bg-blue-50 hover:bg-blue-100 px-3 py-1 rounded text-xs font-medium transition">
                                    Assign
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div id="assignModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50 flex items-center justify-center">
    <div class="relative p-5 border w-96 shadow-lg rounded-md bg-white">
        <div class="mt-3 text-center">
            <h3 class="text-lg leading-6 font-medium text-gray-900" id="assignModalTitle">Assign Engineer</h3>
            <div class="mt-2 px-7 py-3">
                <input type="hidden" id="assignTicketId" />
                <label class="block text-left text-sm font-medium text-gray-700 mb-1">Select Engineer</label>
                <select id="engineerSelect" class="block w-full px-3 py-2 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                    <!-- Populated by JS -->
                </select>
            </div>
            <div class="items-center px-4 py-3">
                <button id="closeAssignModal" class="px-4 py-2 bg-gray-200 text-gray-800 text-base font-medium rounded-md w-full shadow-sm hover:bg-gray-300 mb-2">
                    Cancel
                </button>
                <button onclick="submitAssignment()" class="px-4 py-2 bg-blue-600 text-white text-base font-medium rounded-md w-full shadow-sm hover:bg-blue-700">
                    Assign
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function openAssignModal(id, title) {
        document.getElementById('assignTicketId').value = id;
        document.getElementById('assignModalTitle').innerText = 'Assign: ' + title;
        document.getElementById('assignModal').classList.remove('hidden');
        
        // Fetch engineers with context
        const companyId = '@ViewBag.FilterCompanyId';
        const url = companyId ? `/Tickets/GetEngineers?companyId=${companyId}` : '/Tickets/GetEngineers';

        fetch(url)
            .then(response => response.json())
            .then(data => {
                const select = document.getElementById('engineerSelect');
                select.innerHTML = '';
                data.forEach(eng => {
                    const option = document.createElement('option');
                    option.value = eng;
                    option.innerText = eng;
                    select.appendChild(option);
                });
            });
    }
    
    document.getElementById('closeAssignModal').addEventListener('click', () => {
        document.getElementById('assignModal').classList.add('hidden');
    });

    function submitAssignment() {
        const id = document.getElementById('assignTicketId').value;
        const engineer = document.getElementById('engineerSelect').value;

        const formData = new FormData();
        formData.append('ticketId', id);
        formData.append('engineerName', engineer);

        fetch('/Tickets/AssignEngineer', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if(data.success) {
                alert(data.message);
                location.reload();
            } else {
                alert('Error: ' + data.message);
            }
        });
    }

    function openCreateModal() {
        if ('@isSuperAdmin' === 'True') {
            window.location.href = '/ServiceDesk';
        } else {
            alert("To create a ticket, please go to a Computer's Details page and click 'Service Desk'.");
        }
    }
</script>
