<div id="Summary" class="tab-pane active">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">

        <div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden">
            <div class="flex items-center justify-between px-4 py-2.5 bg-gray-50 border-b border-gray-200">
                <h3 class="flex items-center gap-2 text-[11px] font-bold text-gray-600 uppercase tracking-wide">
                    <i class="fas fa-layer-group" style="color:#00BCEB;"></i> Asset Summary
                </h3>
            </div>
            <div class="grid grid-cols-3 border-b border-gray-100">
                <div class="p-3 text-center border-r border-gray-100">
                    <div class="text-xl font-extrabold text-gray-800" id="tdTotalHardware">--</div>
                    <div class="text-[9px] text-gray-400 font-semibold mt-0.5 uppercase tracking-wide">Hardware</div>
                </div>
                <div class="p-3 text-center border-r border-gray-100">
                    <div class="text-xl font-extrabold text-gray-800" id="tdTotalSoftware">--</div>
                    <div class="text-[9px] text-gray-400 font-semibold mt-0.5 uppercase tracking-wide">Software</div>
                </div>
                <div class="p-3 text-center">
                    <div class="text-xl font-extrabold text-gray-800" id="tdCommercialSoftware">--</div>
                    <div class="text-[9px] text-gray-400 font-semibold mt-0.5 uppercase tracking-wide">Commercial</div>
                </div>
            </div>
            <div class="divide-y divide-gray-100">
                <div class="flex justify-between items-center px-4 py-2.5 hover:bg-gray-50 transition-colors">
                    <span class="text-[11px] text-gray-500 font-medium">Non-Commercial Software</span>
                    <span class="text-[11px] text-gray-700 font-semibold" id="tdNonCommercialSoftware">--</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2.5 hover:bg-gray-50 transition-colors">
                    <span class="text-[11px] text-gray-500 font-medium">Prohibited Software</span>
                    <span class="text-[11px] text-red-500 font-bold" id="tdProhibitedSoftware">--</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2.5 hover:bg-gray-50 transition-colors">
                    <span class="text-[11px] text-gray-500 font-medium">Missing Patches</span>
                    <span class="text-[11px] text-red-500 font-bold" id="tdMissingPatches">--</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden flex flex-col">
            <div class="flex items-center justify-between px-4 py-2.5 bg-gray-50 border-b border-gray-200">
                <h3 class="flex items-center gap-2 text-[11px] font-bold text-gray-600 uppercase tracking-wide">
                    <i class="fas fa-hdd" style="color:#B4D334;"></i> Disk Usage
                </h3>
                <span id="diskSummaryText" class="text-[10px] text-gray-400 font-semibold"></span>
            </div>
            <div class="flex-1 flex items-center justify-center p-4">
                <div class="w-full max-w-[220px]">
                    <canvas id="assetChart" height="200"></canvas>
                </div>
            </div>
            <div id="diskBarsWrap" class="px-4 pb-3"></div>
        </div>

    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">

        <div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden">
            <div class="flex items-center justify-between px-4 py-2.5 bg-gray-50 border-b border-gray-200">
                <h3 class="flex items-center gap-2 text-[11px] font-bold text-gray-600 uppercase tracking-wide">
                    <i class="fab fa-microsoft" style="color:#00BCEB;"></i> Operating System
                </h3>
            </div>
            <div class="divide-y divide-gray-100">
                <div class="flex justify-between items-center px-4 py-2 hover:bg-gray-50 transition-colors gap-3">
                    <span class="text-[11px] text-gray-500 font-medium flex-shrink-0">Operating System</span>
                    <span class="text-[11px] text-gray-700 font-semibold text-right truncate" id="tdOperatingSystem">--</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2 hover:bg-gray-50 transition-colors gap-3">
                    <span class="text-[11px] text-gray-500 font-medium flex-shrink-0">OS Version</span>
                    <span class="text-[11px] text-gray-700 font-semibold text-right" id="tdOSVersion">--</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2 hover:bg-gray-50 transition-colors gap-3">
                    <span class="text-[11px] text-gray-500 font-medium flex-shrink-0">Registered To</span>
                    <span class="text-[11px] text-gray-700 font-semibold text-right truncate" id="tdRegisteredTo">--</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2 hover:bg-gray-50 transition-colors gap-3">
                    <span class="text-[11px] text-gray-500 font-medium flex-shrink-0">Product ID</span>
                    <span class="text-[11px] text-gray-600 font-mono text-right truncate" id="tdProductID">--</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2 hover:bg-gray-50 transition-colors gap-3">
                    <span class="text-[11px] text-gray-500 font-medium flex-shrink-0">License Type</span>
                    <span class="text-[11px] text-gray-700 font-semibold text-right" id="tdLicenseType">--</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2 hover:bg-gray-50 transition-colors gap-3">
                    <span class="text-[11px] text-gray-500 font-medium flex-shrink-0">System Drive</span>
                    <span class="text-[11px] text-gray-600 font-mono text-right" id="tdSystemDrive">--</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2 hover:bg-gray-50 transition-colors gap-3">
                    <span class="text-[11px] text-gray-500 font-medium flex-shrink-0">OS CD Key</span>
                    <span class="text-[11px] text-gray-600 font-mono text-right truncate" id="tdOSCDKey">--</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2 hover:bg-gray-50 transition-colors gap-3">
                    <span class="text-[11px] text-gray-500 font-medium flex-shrink-0">Build Number</span>
                    <span class="text-[11px] text-gray-700 font-semibold text-right" id="tdOSBuildNumber">--</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden">
            <div class="flex items-center justify-between px-4 py-2.5 bg-gray-50 border-b border-gray-200">
                <h3 class="flex items-center gap-2 text-[11px] font-bold text-gray-600 uppercase tracking-wide">
                    <i class="fas fa-laptop" style="color:#F59E0B;"></i> Device Information
                </h3>
            </div>
            <div class="divide-y divide-gray-100">
                <div class="flex justify-between items-center px-4 py-2 hover:bg-gray-50 transition-colors gap-3">
                    <span class="text-[11px] text-gray-500 font-medium flex-shrink-0">Manufacturer</span>
                    <span class="text-[11px] text-gray-700 font-semibold text-right truncate" id="tdDeviceManufacturer">--</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2 hover:bg-gray-50 transition-colors gap-3">
                    <span class="text-[11px] text-gray-500 font-medium flex-shrink-0">Model</span>
                    <span class="text-[11px] text-gray-700 font-semibold text-right truncate" id="tdDeviceModel">--</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2 hover:bg-gray-50 transition-colors gap-3">
                    <span class="text-[11px] text-gray-500 font-medium flex-shrink-0">Device Type</span>
                    <span class="text-[11px] text-gray-700 font-semibold text-right" id="tdDeviceType">--</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2 hover:bg-gray-50 transition-colors gap-3">
                    <span class="text-[11px] text-gray-500 font-medium flex-shrink-0">Processor</span>
                    <span class="text-[11px] text-gray-700 font-semibold text-right truncate max-w-[200px]" id="tdProcessor">--</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2 hover:bg-gray-50 transition-colors gap-3">
                    <span class="text-[11px] text-gray-500 font-medium flex-shrink-0">Memory (RAM)</span>
                    <span class="text-[11px] text-gray-800 font-extrabold text-right" id="tdMemory">--</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2 hover:bg-gray-50 transition-colors gap-3">
                    <span class="text-[11px] text-gray-500 font-medium flex-shrink-0">Serial Number</span>
                    <span class="text-[11px] text-gray-600 font-mono text-right truncate" id="tdSerialNumber">--</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2 hover:bg-gray-50 transition-colors gap-3">
                    <span class="text-[11px] text-gray-500 font-medium flex-shrink-0">Architecture</span>
                    <span class="text-[11px] text-gray-700 font-semibold text-right" id="tdProcessorArchitecture">--</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2 hover:bg-gray-50 transition-colors gap-3">
                    <span class="text-[11px] text-gray-500 font-medium flex-shrink-0">Battery Level</span>
                    <span class="text-[11px] text-gray-700 font-semibold text-right" id="tdBatteryLevel">--</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2 hover:bg-gray-50 transition-colors gap-3">
                    <span class="text-[11px] text-gray-500 font-medium flex-shrink-0">UDID</span>
                    <span class="text-[11px] text-gray-600 font-mono text-right truncate" id="tdUDID">--</span>
                </div>
            </div>
        </div>

    </div>
</div>
