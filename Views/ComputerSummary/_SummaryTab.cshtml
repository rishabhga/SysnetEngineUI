<div id="Summary" class="tab-pane active">

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:10px;margin-bottom:10px;">

        <!-- Logical Drives Full-width Section (Now Side-by-Side) -->
        <div class="cs-card">
            <div class="hw-category-header hw-cat-slate" style="margin: 12px; margin-bottom: 0;">
                <div class="hw-category-icon"><i class="fas fa-hdd"></i></div>
                <div class="hw-category-text">
                    <div class="hw-category-title">Logical Drives</div>
                    <div class="hw-category-desc">Drive volumes and storage utilization</div>
                </div>
            </div>
            <div id="summaryLogicalDrivesContainer" style="padding: 12px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <div style="text-align:center; padding: 20px; color: var(--slate-400); font-weight: 500; font-size: 0.9rem; grid-column: 1 / -1;">
                    <i class="fas fa-circle-notch fa-spin"></i> Loading drives...
                </div>
            </div>
        </div>

        <!-- Asset Summary -->
        <div class="cs-card">
            <div class="hw-category-header hw-cat-cyan" style="margin: 12px; margin-bottom: 0;">
                <div class="hw-category-icon"><i class="fas fa-layer-group"></i></div>
                <div class="hw-category-text">
                    <div class="hw-category-title">Asset Summary</div>
                    <div class="hw-category-desc">Overview of hardware and software totals</div>
                </div>
            </div>
            <div class="cs-stat-grid" style="border-bottom:1px solid var(--slate-100); margin-top: 15px;">
                <div class="cs-stat-cell">
                    <div class="cs-stat-num" id="tdTotalHardware">--</div>
                    <div class="cs-stat-label">Hardware</div>
                </div>
                <div class="cs-stat-cell">
                    <div class="cs-stat-num" id="tdTotalSoftware">--</div>
                    <div class="cs-stat-label">Software</div>
                </div>
                <div class="cs-stat-cell">
                    <div class="cs-stat-num" id="tdCommercialSoftware">--</div>
                    <div class="cs-stat-label">Commercial</div>
                </div>
            </div>
            <div class="cs-kv-row">
                <span class="cs-kv-label">Non-Commercial Software</span>
                <span class="cs-kv-value" id="tdNonCommercialSoftware">--</span>
            </div>
            <div class="cs-kv-row">
                <span class="cs-kv-label">Prohibited Software</span>
                <span class="cs-kv-value" style="color:var(--red);font-weight:700;" id="tdProhibitedSoftware">--</span>
            </div>
            <div class="cs-kv-row">
                <span class="cs-kv-label">Missing Patches</span>
                <span class="cs-kv-value" style="color:var(--red);font-weight:700;" id="tdMissingPatches">--</span>
            </div>
        </div>

    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:10px;">

        <!-- Operating System -->
        <div class="cs-card">
            <div class="hw-category-header hw-cat-blue" style="margin: 12px; margin-bottom: 0;">
                <div class="hw-category-icon"><i class="fab fa-microsoft"></i></div>
                <div class="hw-category-text">
                    <div class="hw-category-title">Operating System</div>
                    <div class="hw-category-desc">Windows license and build details</div>
                </div>
            </div>
            <div style="margin-top:15px;">
                <div class="cs-kv-row"><span class="cs-kv-label">Operating System</span><span class="cs-kv-value" id="tdOperatingSystem">--</span></div>
                <div class="cs-kv-row"><span class="cs-kv-label">OS Version</span><span class="cs-kv-value" id="tdOSVersion">--</span></div>
                <div class="cs-kv-row"><span class="cs-kv-label">Registered To</span><span class="cs-kv-value" id="tdRegisteredTo">--</span></div>
                <div class="cs-kv-row"><span class="cs-kv-label">Product ID</span><span class="cs-kv-value mono" id="tdProductID">--</span></div>
                <div class="cs-kv-row"><span class="cs-kv-label">License Type</span><span class="cs-kv-value" id="tdLicenseType">--</span></div>
                <div class="cs-kv-row"><span class="cs-kv-label">System Drive</span><span class="cs-kv-value mono" id="tdSystemDrive">--</span></div>
                <div class="cs-kv-row"><span class="cs-kv-label">OS CD Key</span><span class="cs-kv-value mono" id="tdOSCDKey">--</span></div>
                <div class="cs-kv-row"><span class="cs-kv-label">Build Number</span><span class="cs-kv-value" id="tdOSBuildNumber">--</span></div>
            </div>
        </div>

        <!-- Device Information -->
        <div class="cs-card">
            <div class="hw-category-header hw-cat-amber" style="margin: 12px; margin-bottom: 0;">
                <div class="hw-category-icon"><i class="fas fa-laptop"></i></div>
                <div class="hw-category-text">
                    <div class="hw-category-title">Device Information</div>
                    <div class="hw-category-desc">Hardware model and specifications</div>
                </div>
            </div>
            <div style="margin-top:15px;">
                <div class="cs-kv-row"><span class="cs-kv-label">Manufacturer</span><span class="cs-kv-value" id="tdDeviceManufacturer">--</span></div>
                <div class="cs-kv-row"><span class="cs-kv-label">Model</span><span class="cs-kv-value" id="tdDeviceModel">--</span></div>
                <div class="cs-kv-row"><span class="cs-kv-label">Device Type</span><span class="cs-kv-value" id="tdDeviceType">--</span></div>
                <div class="cs-kv-row"><span class="cs-kv-label">Processor</span><span class="cs-kv-value" id="tdProcessor">--</span></div>
                <div class="cs-kv-row"><span class="cs-kv-label">Memory (RAM)</span><span class="cs-kv-value" style="font-weight:800;" id="tdMemory">--</span></div>
                <div class="cs-kv-row"><span class="cs-kv-label">Serial Number</span><span class="cs-kv-value mono" id="tdSerialNumber">--</span></div>
                <div class="cs-kv-row"><span class="cs-kv-label">Architecture</span><span class="cs-kv-value" id="tdProcessorArchitecture">--</span></div>
                <div class="cs-kv-row"><span class="cs-kv-label">Battery Level</span><span class="cs-kv-value" id="tdBatteryLevel">--</span></div>
                <div class="cs-kv-row"><span class="cs-kv-label">UDID</span><span class="cs-kv-value mono" id="tdUDID">--</span></div>
                <div class="cs-kv-row"><span class="cs-kv-label">Processors</span><span class="cs-kv-value" id="tdProcessorsCount">--</span></div>
            </div>
        </div>

    </div>

</div>
