@model List<ManageEngineWebApp.Models.VIPClient>

@{
    ViewData["Title"] = "Critical Monitoring Management";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var companyId = ViewBag.CompanyId;
    var groupId = ViewBag.GroupId;
    var locationId = ViewBag.LocationId;
    var companyName = ViewBag.CompanyName ?? "Unknown Company";
}

@section Styles {
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&display=swap');

        .vip-root {
            font-family: 'DM Sans', sans-serif;
        }

        .vip-wrap {
            max-width: 1100px;
            margin: 0 auto;
            padding: 12px 16px;
        }

        .vip-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
        }

        .vip-header-left {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .vip-back-btn {
            width: 26px;
            height: 26px;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background .15s;
            text-decoration: none;
            color: #64748b;
        }

            .vip-back-btn:hover {
                background: #f8fafc;
            }

            .vip-back-btn i {
                font-size: 10px;
            }

        .vip-crown-btn {
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
        }

        .vip-crown-box {
            width: 26px;
            height: 26px;
            border-radius: 6px;
            background: #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .2s;
            box-shadow: 0 1px 2px rgba(0,0,0,.05);
        }

            .vip-crown-box i {
                font-size: 10px;
                color: #94a3b8;
                transition: color .2s;
            }

            .vip-crown-box.active {
                background: linear-gradient(135deg, #f59e0b, #d97706);
                box-shadow: 0 2px 6px rgba(245,158,11,.3);
            }

                .vip-crown-box.active i {
                    color: #fff;
                }

        .vip-site-badge {
            position: absolute;
            bottom: -2px;
            right: -2px;
            background: #f59e0b;
            color: #fff;
            font-size: 5px;
            font-weight: 700;
            padding: 1px 2px;
            border-radius: 3px;
            letter-spacing: .3px;
        }

        .vip-title {
            font-size: 14px;
            font-weight: 700;
            color: #0f172a;
            margin: 0;
            line-height: 1.2;
        }

        .vip-subtitle {
            font-size: 10px;
            color: #94a3b8;
            display: flex;
            align-items: center;
            gap: 3px;
            margin: 0;
        }

        .vip-add-btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 10px;
            background: #0f172a;
            color: #fff;
            border: none;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: background .15s;
            white-space: nowrap;
        }

            .vip-add-btn:hover {
                background: #1e293b;
            }

            .vip-add-btn i {
                font-size: 9px;
            }

        .vip-stats-row {
            display: grid;
            grid-template-columns: 110px 1fr;
            gap: 8px;
            margin-bottom: 10px;
        }

        .vip-stat-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 8px 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .vip-stat-label {
            font-size: 8px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: .6px;
            margin-bottom: 1px;
        }

        .vip-stat-value {
            font-size: 18px;
            font-weight: 800;
            color: #0f172a;
            font-family: 'DM Mono', monospace;
            line-height: 1;
        }

        .vip-stat-icon {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            background: #fffbeb;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .vip-stat-icon i {
                font-size: 11px;
                color: #d97706;
            }

        .vip-search-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 6px 10px;
            display: flex;
            align-items: center;
        }

        .vip-search-wrap {
            position: relative;
            flex: 1;
        }

            .vip-search-wrap i {
                position: absolute;
                left: 8px;
                top: 50%;
                transform: translateY(-50%);
                color: #cbd5e1;
                font-size: 10px;
            }

        .vip-search-input {
            width: 100%;
            padding: 5px 8px 5px 28px;
            background: #f8fafc;
            border: 1px solid transparent;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 500;
            color: #1e293b;
            outline: none;
            transition: all .15s;
        }

            .vip-search-input:focus {
                border-color: #fbbf24;
                background: #fff;
                box-shadow: 0 0 0 3px rgba(251,191,36,.1);
            }

        .vip-loading, .vip-empty {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 32px;
            background: #fff;
            border: 1px dashed #e2e8f0;
            border-radius: 10px;
        }

        .vip-spinner {
            width: 22px;
            height: 22px;
            border: 2px solid #e2e8f0;
            border-top-color: #f59e0b;
            border-radius: 50%;
            animation: spin .7s linear infinite;
            margin-bottom: 8px;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .vip-loading-text {
            font-size: 11px;
            color: #94a3b8;
            font-weight: 500;
        }

        .vip-empty-icon {
            width: 38px;
            height: 38px;
            background: #fffbeb;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 8px;
        }

            .vip-empty-icon i {
                font-size: 16px;
                color: #fde68a;
            }

        .vip-empty h3 {
            font-size: 12px;
            font-weight: 700;
            color: #0f172a;
            margin: 0 0 2px;
        }

        .vip-empty p {
            font-size: 10px;
            color: #94a3b8;
            text-align: center;
            max-width: 260px;
            margin: 0 0 10px;
            line-height: 1.4;
        }

        .vip-empty-btn {
            padding: 5px 14px;
            background: #f59e0b;
            color: #fff;
            border: none;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            transition: background .15s;
        }

            .vip-empty-btn:hover {
                background: #d97706;
            }

        .vip-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 6px;
        }

        .critical-card {
            position: relative;
            background: #fff;
            border: 1px solid #f1f5f9;
            border-radius: 8px;
            padding: 10px;
            transition: all .2s;
            box-shadow: 0 1px 2px rgba(0,0,0,.03);
            background-image: radial-gradient(circle at top right, rgba(245,158,11,.03), transparent);
        }

            .critical-card:hover {
                border-color: #fde68a;
                box-shadow: 0 4px 12px rgba(245,158,11,.08);
                transform: translateY(-1px);
            }

        .card-crown-dot {
            position: absolute;
            top: -3px;
            right: -3px;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: #f59e0b;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity .2s;
            box-shadow: 0 1px 4px rgba(245,158,11,.3);
        }

        .critical-card:hover .card-crown-dot {
            opacity: 1;
        }

        .card-crown-dot i {
            font-size: 6px;
            color: #fff;
        }

        .card-body {
            display: flex;
            align-items: flex-start;
            gap: 8px;
        }

        .card-icon-wrap {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            background: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: background .2s;
        }

        .critical-card:hover .card-icon-wrap {
            background: #fffbeb;
        }

        .card-icon-wrap i {
            font-size: 11px;
            color: #94a3b8;
            transition: color .2s;
        }

        .critical-card:hover .card-icon-wrap i {
            color: #d97706;
        }

        .card-info {
            flex: 1;
            min-width: 0;
        }

        .card-name {
            font-size: 11px;
            font-weight: 700;
            color: #0f172a;
            margin: 0 0 2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .card-id {
            font-size: 9px;
            color: #94a3b8;
            font-family: 'DM Mono', monospace;
            display: flex;
            align-items: center;
            gap: 3px;
            margin-bottom: 5px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .card-id::before {
                content: '';
                display: inline-block;
                width: 4px;
                height: 4px;
                border-radius: 50%;
                background: #e2e8f0;
                flex-shrink: 0;
            }

        .card-badge {
            display: inline-flex;
            align-items: center;
            padding: 1px 6px;
            border-radius: 4px;
            font-size: 8px;
            font-weight: 700;
            letter-spacing: .3px;
            text-transform: uppercase;
        }

        .badge-manual {
            background: #fffbeb;
            color: #d97706;
            border: 1px solid #fde68a;
        }

        .badge-location {
            background: #eff6ff;
            color: #3b82f6;
            border: 1px solid #bfdbfe;
        }

        .card-del-btn {
            position: absolute;
            top: 6px;
            right: 6px;
            width: 22px;
            height: 22px;
            border-radius: 5px;
            background: #f8fafc;
            border: none;
            color: #94a3b8;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            opacity: 0;
            transition: all .15s;
        }

        .critical-card:hover .card-del-btn {
            opacity: 1;
        }

        .card-del-btn:hover {
            background: #fff1f2;
            color: #e11d48;
        }

        .card-del-btn i {
            font-size: 8px;
        }

        .vip-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.5);
            backdrop-filter: blur(4px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 100;
            padding: 12px;
            opacity: 0;
            transition: opacity .2s;
        }

            .vip-modal-overlay.visible {
                display: flex;
            }

            .vip-modal-overlay.shown {
                opacity: 1;
            }

        .vip-modal {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 20px 40px rgba(0,0,0,.12);
            width: 100%;
            max-width: 300px;
            overflow: hidden;
            transform: scale(.96) translateY(4px);
            transition: transform .2s;
        }

        .vip-modal-overlay.shown .vip-modal {
            transform: scale(1) translateY(0);
        }

        .vip-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 12px;
            border-bottom: 1px solid #f1f5f9;
        }

        .modal-header-left {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .modal-icon {
            width: 26px;
            height: 26px;
            border-radius: 6px;
            background: #f59e0b;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .modal-icon i {
                font-size: 10px;
                color: #fff;
            }

        .modal-title {
            font-size: 12px;
            font-weight: 700;
            color: #0f172a;
            margin: 0;
        }

        .modal-sub {
            font-size: 9px;
            color: #94a3b8;
            font-style: italic;
            margin: 0;
        }

        .modal-close {
            width: 24px;
            height: 24px;
            border-radius: 5px;
            border: none;
            background: none;
            color: #94a3b8;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background .15s;
        }

            .modal-close:hover {
                background: #f1f5f9;
            }

            .modal-close i {
                font-size: 10px;
            }

        .vip-modal-body {
            padding: 12px;
        }

        .form-group {
            margin-bottom: 10px;
        }

        .form-label {
            display: block;
            font-size: 8px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: .6px;
            margin-bottom: 3px;
        }

        .form-field-wrap {
            position: relative;
        }

            .form-field-wrap > i {
                position: absolute;
                left: 8px;
                top: 50%;
                transform: translateY(-50%);
                color: #cbd5e1;
                font-size: 10px;
                pointer-events: none;
                transition: color .15s;
            }

            .form-field-wrap:focus-within > i {
                color: #f59e0b;
            }

        .form-select, .form-input {
            width: 100%;
            padding: 6px 8px 6px 28px;
            background: #f8fafc;
            border: 1px solid transparent;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 500;
            color: #1e293b;
            outline: none;
            transition: all .15s;
            appearance: none;
        }

            .form-select:focus, .form-input:focus {
                border-color: #fbbf24;
                background: #fff;
                box-shadow: 0 0 0 2px rgba(251,191,36,.1);
            }

        .form-select {
            padding-right: 24px;
        }

        .form-chevron {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            color: #cbd5e1;
            font-size: 8px;
            pointer-events: none;
        }

        .form-hint {
            font-size: 8px;
            color: #cbd5e1;
            padding-left: 2px;
            margin-top: 2px;
            font-style: italic;
        }

        .form-actions {
            display: flex;
            gap: 6px;
            padding-top: 2px;
        }

        .btn-primary {
            flex: 1;
            padding: 7px;
            background: #f59e0b;
            color: #fff;
            border: none;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            transition: background .15s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }

            .btn-primary:hover {
                background: #d97706;
            }

            .btn-primary i {
                font-size: 9px;
                opacity: .8;
            }

        .btn-secondary {
            padding: 7px 12px;
            background: #f1f5f9;
            color: #475569;
            border: none;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: background .15s;
        }

            .btn-secondary:hover {
                background: #e2e8f0;
            }

        .vip-toast {
            position: fixed;
            bottom: 20px;
            right: 20px;
            padding: 8px 14px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 600;
            color: #fff;
            box-shadow: 0 6px 16px rgba(0,0,0,.12);
            z-index: 200;
            transition: all .3s;
            opacity: 0;
            transform: translateY(12px);
        }

            .vip-toast.show {
                opacity: 1;
                transform: translateY(0);
            }

            .vip-toast i {
                font-size: 11px;
            }

        .hidden {
            display: none !important;
        }
    </style>
}

<div class="vip-root">
    <div class="vip-wrap">
        <div class="vip-header">
            <div class="vip-header-left">
                <a href="javascript:history.back()" class="vip-back-btn"><i class="fas fa-arrow-left"></i></a>
                <button onclick="toggleLocationCriticality()" class="vip-crown-btn" id="locationCriticalToggleHeader">
                    <div id="locationCrownContainer" class="vip-crown-box">
                        <i id="locationCrownIcon" class="fas fa-crown"></i>
                    </div>
                    <div id="locationStatusBadge" class="vip-site-badge hidden">SITE</div>
                </button>
                <div>
                    <h1 class="vip-title">Critical Monitoring</h1>
                    <p class="vip-subtitle"><i class="fas fa-building"></i> @companyName</p>
                </div>
            </div>
            <button onclick="openAddModal()" class="vip-add-btn"><i class="fas fa-plus"></i> Add Device</button>
        </div>

        <div class="vip-stats-row">
            <div class="vip-stat-card">
                <div>
                    <div class="vip-stat-label">Monitored</div>
                    <div class="vip-stat-value" id="criticalCount">0</div>
                </div>
                <div class="vip-stat-icon"><i class="fas fa-microchip"></i></div>
            </div>
            <div class="vip-search-card">
                <div class="vip-search-wrap">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchCritical" class="vip-search-input" placeholder="Search by ID or name..." onkeyup="filterCriticalClients()">
                </div>
            </div>
        </div>

        <div id="loadingState" class="vip-loading">
            <div class="vip-spinner"></div>
            <p class="vip-loading-text">Synchronizing critical fleet data...</p>
        </div>
        <div id="criticalClientsList" class="vip-grid hidden"></div>
        <div id="emptyState" class="vip-empty hidden">
            <div class="vip-empty-icon"><i class="fas fa-crown"></i></div>
            <h3>No Devices Under Critical Watch</h3>
            <p>Devices added here will trigger high-priority alerts when resources are stressed.</p>
            <button onclick="openAddModal()" class="vip-empty-btn">Provision First Device</button>
        </div>
    </div>
</div>

<div id="addCriticalModal" class="vip-modal-overlay">
    <div class="vip-modal">
        <div class="vip-modal-header">
            <div class="modal-header-left">
                <div class="modal-icon"><i class="fas fa-plus"></i></div>
                <div>
                    <p class="modal-title">Provision Critical Device</p>
                    <p class="modal-sub">Scoped to @companyName</p>
                </div>
            </div>
            <button onclick="closeAddModal()" class="modal-close"><i class="fas fa-times"></i></button>
        </div>
        <div class="vip-modal-body">
            <form id="addCriticalForm">
                <div class="form-group">
                    <label class="form-label">Source Machine</label>
                    <div class="form-field-wrap">
                        <i class="fas fa-desktop"></i>
                        <select id="clientId" required class="form-select">
                            <option value="">Querying active fleet...</option>
                        </select>
                        <i class="fas fa-chevron-down form-chevron"></i>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Friendly Label</label>
                    <div class="form-field-wrap">
                        <i class="fas fa-tag"></i>
                        <input type="text" id="clientName" required class="form-input" placeholder="e.g. CEO Laptop, Main Server">
                    </div>
                    <p class="form-hint">Appears in all system-wide alerts.</p>
                </div>
                <div class="form-group" style="margin-top: 10px;">
                    <label class="form-label" style="display:flex; justify-content:space-between;">
                        <span>Custom Thresholds (%)</span>
                        <span style="font-weight:normal; text-transform:none; opacity:0.7;">Optional</span>
                    </label>
                    <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:6px;">
                        <div class="form-field-wrap">
                            <i class="fas fa-microchip"></i>
                            <input type="number" id="vipCpu" step="0.1" min="0" max="100" class="form-input" placeholder="CPU">
                        </div>
                        <div class="form-field-wrap">
                            <i class="fas fa-memory" style="color: #cbd5e1;"></i>
                            <input type="number" id="vipRam" step="0.1" min="0" max="100" class="form-input" placeholder="RAM">
                        </div>
                        <div class="form-field-wrap">
                            <i class="fas fa-hdd" style="color: #cbd5e1;"></i>
                            <input type="number" id="vipDisk" step="0.1" min="0" max="100" class="form-input" placeholder="Disk">
                        </div>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn-primary"><i class="fas fa-bolt"></i> Activate</button>
                    <button type="button" onclick="closeAddModal()" class="btn-secondary">Cancel</button>
                </div>
            </form>
        </div>
        </div>
    </div>
</div>

<div id="locationCriticalModal" class="vip-modal-overlay">
    <div class="vip-modal">
        <div class="vip-modal-header">
            <div class="modal-header-left">
                <div class="modal-icon"><i class="fas fa-building"></i></div>
                <div>
                    <p class="modal-title">Site-Wide Monitoring</p>
                    <p class="modal-sub">Enable location defaults</p>
                </div>
            </div>
            <button onclick="closeLocationModal()" class="modal-close"><i class="fas fa-times"></i></button>
        </div>
        <div class="vip-modal-body">
            <form id="locationCriticalForm">
                <p style="font-size:10px; color:#64748b; margin-bottom:12px; line-height:1.4;">
                    Set default thresholds for all devices in this location. Devices with individual VIP settings will override these defaults.
                </p>
                <div class="form-group">
                    <label class="form-label" style="display:flex; justify-content:space-between;">
                        <span>Location Thresholds (%)</span>
                        <span style="font-weight:normal; text-transform:none; opacity:0.7;">Optional</span>
                    </label>
                    <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:6px;">
                        <div class="form-field-wrap">
                            <i class="fas fa-microchip"></i>
                            <input type="number" id="locCpu" step="0.1" min="0" max="100" class="form-input" placeholder="CPU">
                        </div>
                        <div class="form-field-wrap">
                            <i class="fas fa-memory" style="color: #cbd5e1;"></i>
                            <input type="number" id="locRam" step="0.1" min="0" max="100" class="form-input" placeholder="RAM">
                        </div>
                        <div class="form-field-wrap">
                            <i class="fas fa-hdd" style="color: #cbd5e1;"></i>
                            <input type="number" id="locDisk" step="0.1" min="0" max="100" class="form-input" placeholder="Disk">
                        </div>
                    </div>
                </div>
                <div class="form-actions" style="margin-top: 15px;">
                    <button type="button" onclick="confirmLocationCriticality()" class="btn-primary" id="btnConfirmLoc"><i class="fas fa-check"></i> Apply</button>
                    <button type="button" onclick="closeLocationModal()" class="btn-secondary">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const companyId = @(ViewBag.CompanyId ?? 0);
        const groupId = @(ViewBag.GroupId ?? 0);
        const locationId = @(ViewBag.LocationId ?? 0);

        let allDevices = [];
        let allCriticalClients = [];
        let isLocationCritical = false;

        $(document).ready(function() {
            loadInitialData();
            checkLocationStatus();
            $('#addCriticalForm').on('submit', addCriticalClient);
        });

        function checkLocationStatus() {
            $.get('@Url.Action("GetLocationCriticalStatus", "ComputerSummary")', { locationId: locationId }, function(res) {
                isLocationCritical = res && res.isCritical;
                updateLocationHeaderUI(isLocationCritical);
            });
        }

        function updateLocationHeaderUI(isCritical) {
            const container = $('#locationCrownContainer');
            const icon = $('#locationCrownIcon');
            const badge = $('#locationStatusBadge');

            if (isCritical) {
                container.addClass('active');
                badge.removeClass('hidden');
            } else {
                container.removeClass('active');
                badge.addClass('hidden');
            }
        }

        function toggleLocationCriticality() {
            const newStatus = !isLocationCritical;
            if (newStatus) {
                $('#locationCriticalModal').addClass('visible');
                setTimeout(() => $('#locationCriticalModal').addClass('shown'), 10);
            } else {
                sysConfirm("Disable site-wide critical monitoring? (Individual VIP overrides will remain)", function() {
                    submitLocationCriticality(false, null, null, null);
                });
            }
        }

        function closeLocationModal() {
            const modal = $('#locationCriticalModal');
            modal.removeClass('shown');
            setTimeout(() => {
                modal.removeClass('visible');
                $('#locCpu').val('');
                $('#locRam').val('');
                $('#locDisk').val('');
            }, 280);
        }

        function confirmLocationCriticality() {
            const cpu = $('#locCpu').val();
            const ram = $('#locRam').val();
            const disk = $('#locDisk').val();
            
            if ((cpu && (cpu < 0 || cpu > 100)) || (ram && (ram < 0 || ram > 100)) || (disk && (disk < 0 || disk > 100))) {
                sysAlert('Thresholds must be between 0 and 100', 'error');
                return;
            }
            
            submitLocationCriticality(true, cpu, ram, disk);
            closeLocationModal();
        }

        function submitLocationCriticality(isCritical, cpu, ram, disk) {
            const icon = $('#locationCrownIcon');
            icon.addClass('fa-spin');

            $.ajax({
                url: '@Url.Action("Locationupdate", "Companies")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    Id: locationId,
                    IsCritical: isCritical,
                    GroupsID: groupId,
                    CompanyID: companyId,
                    LocationName: '@Html.Raw(ViewBag.LocationName)',
                    CpuThreshold: cpu ? parseFloat(cpu) : null,
                    RamThreshold: ram ? parseFloat(ram) : null,
                    DiskThreshold: disk ? parseFloat(disk) : null
                }),
                success: function() {
                    isLocationCritical = isCritical;
                    updateLocationHeaderUI(isCritical);
                    loadInitialData();
                    sysAlert(isCritical ? 'Site-wide monitoring active.' : 'Site-wide monitoring deactivated.', 'success');
                },
                error: function() {
                    sysAlert('Failed to update site status.', 'error');
                },
                complete: function() {
                    icon.removeClass('fa-spin');
                }
            });
        }

        async function loadInitialData() {
            $('#loadingState').show();
            $('#criticalClientsList').addClass('hidden');
            $('#emptyState').addClass('hidden');

            try {
                await Promise.all([loadAllDevices(), loadCriticalClients()]);
            } catch (err) {
                console.error("Initialization Failed", err);
            } finally {
                $('#loadingState').hide();
            }
        }

        function loadAllDevices() {
            return $.ajax({
                url: '@Url.Action("GetAllDevices", "ComputerSummary")',
                type: 'GET',
                data: { companyId, groupId, locationId },
                success: function(response) {
                    if (response && response.success && response.data) {
                        allDevices = response.data;
                        populateDeviceDropdown();
                    }
                }
            });
        }

        function populateDeviceDropdown() {
            const select = $('#clientId');
            select.empty().append('<option value="">Choose machine...</option>');

            if (allDevices) {
                allDevices.forEach(device => {
                    const label = `${device.domainName} (${device.userName || 'System'})`;
                    select.append(`<option value="${device.domainName}" data-username="${device.userName || ''}">${label}</option>`);
                });
            }

            select.off('change').on('change', function() {
                const username = $(this).find('option:selected').data('username');
                if (username) $('#clientName').val(username);
            });
        }

        function loadCriticalClients() {
            return $.ajax({
                url: '@Url.Action("GetCriticalClients", "ComputerSummary")',
                type: 'GET',
                data: { companyId, groupId, locationId },
                success: function(response) {
                    if (response && response.success && response.data) {
                        allCriticalClients = response.data;
                        renderCriticalClients(allCriticalClients);
                    } else {
                        showEmptyState();
                    }
                },
                error: function() {
                    showEmptyState();
                }
            });
        }

        function renderCriticalClients(clients) {
            const container = $('#criticalClientsList');
            const emptyState = $('#emptyState');

            if (!clients || clients.length === 0) {
                showEmptyState();
                return;
            }

            emptyState.addClass('hidden');
            container.empty().removeClass('hidden');
            $('#criticalCount').text(clients.length);

            clients.forEach(client => {
                const id = client.clientId || '';
                const name = client.clientName || 'Unnamed Device';
                const source = client.source || 'Manual';
                const badgeClass = source === 'Manual' ? 'badge-manual' : 'badge-location';
                const badgeLabel = source === 'Manual' ? 'Manual Priority' : 'Location Default';

                const card = $(`
                    <div class="critical-card" data-id="${(id || '').toLowerCase()}" data-name="${(name || '').toLowerCase()}">
                        <div class="card-crown-dot"><i class="fas fa-crown"></i></div>
                        <div class="card-body">
                            <div class="card-icon-wrap"><i class="fas fa-desktop"></i></div>
                            <div class="card-info">
                                <div class="card-name">${name}</div>
                                <div class="card-id">${id}</div>
                                <span class="card-badge ${badgeClass}">${badgeLabel}</span>
                            </div>
                        </div>
                        <button class="card-del-btn" onclick="removeCriticalClient('${id}', '${name.replace(/'/g, "\\'")}', '${source}')">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                `);
                container.append(card);
            });
        }

        function showEmptyState() {
            $('#criticalClientsList').addClass('hidden');
            $('#emptyState').removeClass('hidden');
            $('#criticalCount').text('0');
        }

        function openAddModal() {
            const modal = $('#addCriticalModal');
            modal.addClass('visible');
            setTimeout(() => modal.addClass('shown'), 10);
        }

        function closeAddModal() {
            const modal = $('#addCriticalModal');
            modal.removeClass('shown');
            setTimeout(() => {
                modal.removeClass('visible');
                $('#clientId').val('');
                $('#clientName').val('');
                $('#vipCpu').val('');
                $('#vipRam').val('');
                $('#vipDisk').val('');
            }, 280);
        }

        function addCriticalClient(e) {
            if (e && e.preventDefault) e.preventDefault();

            const clientId = $('#clientId').val()?.trim();
            const clientName = $('#clientName').val()?.trim();

            if (!clientId || !clientName) {
                showToast('Data requirements missing.', 'error');
                return;
            }

            const vipCpu = $('#vipCpu').val();
            const vipRam = $('#vipRam').val();
            const vipDisk = $('#vipDisk').val();

            if ((vipCpu && (vipCpu < 0 || vipCpu > 100)) || (vipRam && (vipRam < 0 || vipRam > 100)) || (vipDisk && (vipDisk < 0 || vipDisk > 100))) {
                showToast('Thresholds must be between 0 and 100', 'error');
                return;
            }

            $.ajax({
                url: '@Url.Action("AddCriticalClient", "ComputerSummary")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ClientId: clientId,
                    ClientName: clientName,
                    CompanyID: companyId,
                    GroupsID: groupId,
                    LocationID: locationId,
                    CpuThreshold: vipCpu ? parseFloat(vipCpu) : null,
                    RamThreshold: vipRam ? parseFloat(vipRam) : null,
                    DiskThreshold: vipDisk ? parseFloat(vipDisk) : null
                }),
                success: function(response) {
                    if (response && response.success) {
                        closeAddModal();
                        loadInitialData();
                        showToast('Monitoring successfully deployed.', 'success');
                    } else {
                        showToast((response && response.message) || 'Operation failed.', 'error');
                    }
                },
                error: function() {
                    showToast('Network synchronization failed.', 'error');
                }
            });
        }

        function removeCriticalClient(clientId, name, source) {
            const msg = source === 'Location'
                ? `Confirm explicit exclusion of ${name} from critical monitoring? (It is currently inherited from location settings)`
                : `Confirm detachment of critical monitoring for ${name}?`;

            sysConfirm(msg, function() {
                $.ajax({
                    url: '@Url.Action("RemoveCriticalClient", "ComputerSummary")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(clientId),
                    success: function(response) {
                        if (response && response.success) {
                            loadInitialData();
                            sysAlert('Monitoring detached successfully.', 'success');
                        }
                    },
                    error: function() {
                        sysAlert('Failed to detach monitoring.', 'error');
                    }
                });
            }, { type: 'danger' });
        }

        function filterCriticalClients() {
            const term = $('#searchCritical').val().toLowerCase();
            const cards = $('.critical-card');
            let count = 0;

            cards.each(function() {
                const card = $(this);
                const match = card.data('id').toString().includes(term) || card.data('name').toString().includes(term);
                card.toggle(match);
                if (match) count++;
            });

            if (term) $('#criticalCount').text(count);
            else $('#criticalCount').text(cards.length);
        }

        function showToast(message, type) {
            const icon = type === 'success' ? 'fa-check-circle' : 'fa-times-circle';
            const bg = type === 'success' ? '#059669' : '#dc2626';

            const toast = $(`
                <div class="vip-toast" style="background:${bg}">
                    <i class="fas ${icon}"></i>
                    <span>${message}</span>
                </div>
            `);

            $('body').append(toast);
            setTimeout(() => toast.addClass('show'), 50);
            setTimeout(() => {
                toast.removeClass('show');
                setTimeout(() => toast.remove(), 400);
            }, 3500);
        }
    </script>
}
