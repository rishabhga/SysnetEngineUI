@model List<ManageEngineWebApp.Models.VIPClient>

@{
    ViewData["Title"] = "Critical Monitoring Management";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var companyId = ViewBag.CompanyId;
    var groupId = ViewBag.GroupId;
    var locationId = ViewBag.LocationId;
    var companyName = ViewBag.CompanyName ?? "Unknown Company";
}

@section Styles {
    <style>
        .critical-card {
            background-image: radial-gradient(circle at top right, rgba(245, 158, 11, 0.03), transparent);
        }
        select option {
            background: #fff;
            color: #1e293b;
            padding: 12px;
        }
    </style>
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header Section -->
    <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center space-x-4">
            <a href="javascript:history.back()" 
               class="p-2 bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 rounded-xl transition-all shadow-sm group">
                <i class="fas fa-arrow-left group-hover:-translate-x-1 transition-transform"></i>
            </a>
            <div>
                <div class="flex items-center space-x-2">
                    <button onclick="toggleLocationCriticality()" class="group relative" id="locationCriticalToggleHeader" title="Toggle Location-wide Critical Monitoring">
                        <div id="locationCrownContainer" class="w-10 h-10 rounded-xl bg-slate-200 flex items-center justify-center shadow-lg transition-all duration-300">
                            <i id="locationCrownIcon" class="fas fa-crown text-slate-400 text-lg transition-colors"></i>
                        </div>
                        <div id="locationStatusBadge" class="absolute -bottom-1 -right-1 px-1 bg-amber-500 text-white text-[8px] font-bold rounded-sm shadow-sm hidden">SITE</div>
                    </button>
                    <div>
                        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Critical Monitoring</h1>
                        <p class="text-sm font-medium text-slate-500 flex items-center">
                            <i class="fas fa-building mr-1.5 text-slate-400"></i>
                            @companyName
                        </p>
                    </div>
                </div>
            </div>
        </div>
        
        <button onclick="openAddModal()" 
                class="inline-flex items-center px-5 py-2.5 bg-slate-900 text-white rounded-xl text-sm font-semibold hover:bg-slate-800 transition-all shadow-md shadow-slate-200 group">
            <i class="fas fa-plus mr-2 text-slate-400 group-hover:text-white transition-colors"></i>
            Add Critical Device
        </button>
    </div>

    <!-- Quick Stats & Tools -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-1">Total Monitored</p>
                <p class="text-3xl font-black text-slate-900" id="criticalCount">0</p>
            </div>
            <div class="w-14 h-14 rounded-2xl bg-amber-50 flex items-center justify-center">
                <i class="fas fa-microchip text-amber-600 text-2xl"></i>
            </div>
        </div>

        <div class="md:col-span-2 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-center">
             <div class="relative group">
                <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-amber-500 transition-colors"></i>
                <input type="text" id="searchCritical" 
                       class="w-full pl-12 pr-4 py-3 bg-slate-50 border-0 rounded-xl focus:ring-2 focus:ring-amber-500/20 focus:bg-white transition-all text-sm font-medium placeholder:text-slate-400"
                       placeholder="Search devices by ID or custom name..."
                       onkeyup="filterCriticalClients()">
            </div>
        </div>
    </div>

    <!-- Content Status -->
    <div id="loadingState" class="flex flex-col items-center justify-center py-20 bg-white rounded-3xl border border-dashed border-slate-300">
        <div class="relative mb-4">
             <div class="w-12 h-12 border-4 border-slate-200 border-t-amber-500 rounded-full animate-spin"></div>
        </div>
        <p class="text-slate-500 font-medium animate-pulse">Synchronizing critical fleet data...</p>
    </div>

    <div id="criticalClientsList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 hidden">
        <!-- Cards will be injected here -->
    </div>

    <div id="emptyState" class="hidden flex flex-col items-center justify-center py-24 bg-white rounded-3xl border border-dashed border-slate-300">
        <div class="w-24 h-24 bg-amber-50 rounded-full flex items-center justify-center mb-6">
            <i class="fas fa-crown text-amber-200 text-5xl"></i>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">No Devices Under Critical Watch</h3>
        <p class="text-slate-500 text-sm max-w-sm text-center mb-8 px-6">
            Devices added here will trigger high-priority alerts across the entire @companyName infrastructure when resources are stressed.
        </p>
        <button onclick="openAddModal()" 
                class="px-8 py-3 bg-amber-500 text-white rounded-xl text-sm font-bold hover:bg-amber-600 transition-all shadow-lg shadow-amber-100">
            Provision First Device
        </button>
    </div>
</div>

<!-- Professional Add Modal -->
<div id="addCriticalModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-md hidden items-center justify-center z-[100] px-4 opacity-0 transition-opacity duration-300">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden transform scale-95 transition-transform duration-300">
        <div class="flex items-center justify-between p-6 border-b border-slate-100">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-amber-500 flex items-center justify-center">
                    <i class="fas fa-plus text-white"></i>
                </div>
                <div>
                    <h3 class="font-bold text-slate-900">Provision Critical Device</h3>
                    <p class="text-xs text-slate-500 font-medium italic">Hierarchy Scoped to @companyName</p>
                </div>
            </div>
            <button onclick="closeAddModal()" class="w-8 h-8 rounded-full hover:bg-slate-100 flex items-center justify-center transition-colors">
                <i class="fas fa-times text-slate-400"></i>
            </button>
        </div>
        
        <div class="p-8">
            <form id="addCriticalForm" class="space-y-6">
                <div class="space-y-2">
                    <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest px-1">Source Machine</label>
                    <div class="relative group">
                        <i class="fas fa-desktop absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-amber-500 transition-colors"></i>
                        <select id="clientId" required 
                                class="w-full pl-12 pr-4 py-3 bg-slate-50 border-0 rounded-xl focus:ring-2 focus:ring-amber-500/20 focus:bg-white transition-all text-sm font-semibold appearance-none">
                            <option value="">Querying active fleet...</option>
                        </select>
                        <i class="fas fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-slate-300 pointer-events-none text-xs"></i>
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest px-1">Friendly Label</label>
                    <div class="relative group">
                        <i class="fas fa-tag absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-amber-500 transition-colors"></i>
                        <input type="text" id="clientName" required 
                               class="w-full pl-12 pr-4 py-3 bg-slate-50 border-0 rounded-xl focus:ring-2 focus:ring-amber-500/20 focus:bg-white transition-all text-sm font-semibold"
                               placeholder="e.g. CEO Laptop, Main Server">
                    </div>
                    <p class="text-[10px] text-slate-400 px-1 font-medium italic">This name will appear in all system-wide alerts.</p>
                </div>

                <div class="pt-4 flex gap-4">
                    <button type="submit" 
                            class="flex-1 bg-amber-500 text-white py-4 rounded-2xl text-sm font-black hover:bg-amber-600 transition-all shadow-lg shadow-amber-100 active:scale-95">
                        <i class="fas fa-bolt mr-2 opacity-80"></i>
                        Activate Monitoring
                    </button>
                    <button type="button" onclick="closeAddModal()" 
                            class="px-6 bg-slate-100 text-slate-600 py-4 rounded-2xl text-sm font-bold hover:bg-slate-200 transition-all active:scale-95">
                        Abort
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const companyId = @(ViewBag.CompanyId ?? 0);
        const groupId = @(ViewBag.GroupId ?? 0);
        const locationId = @(ViewBag.LocationId ?? 0);

        let allDevices = [];
        let allCriticalClients = [];

        let isLocationCritical = false;

        $(document).ready(function() {
            loadInitialData();
            checkLocationStatus();
            $('#addCriticalForm').on('submit', addCriticalClient);
        });

        function checkLocationStatus() {
            $.get('@Url.Action("GetLocationCriticalStatus", "ComputerSummary")', { locationId: locationId }, function(res) {
                isLocationCritical = res && res.isCritical;
                updateLocationHeaderUI(isLocationCritical);
            });
        }

        function updateLocationHeaderUI(isCritical) {
            const container = $('#locationCrownContainer');
            const icon = $('#locationCrownIcon');
            const badge = $('#locationStatusBadge');

            if (isCritical) {
                container.removeClass('bg-slate-200').addClass('bg-gradient-to-br from-amber-400 to-orange-600 shadow-amber-200');
                icon.removeClass('text-slate-400').addClass('text-white');
                badge.removeClass('hidden');
            } else {
                container.addClass('bg-slate-200').removeClass('bg-gradient-to-br from-amber-400 to-orange-600 shadow-amber-200');
                icon.addClass('text-slate-400').removeClass('text-white');
                badge.addClass('hidden');
            }
        }

        function toggleLocationCriticality() {
            const newStatus = !isLocationCritical;
            const msg = newStatus 
                ? "Switching to SITE-WIDE critical monitoring? This will mark all existing devices in this location as critical."
                : "Disable site-wide critical monitoring? (Individual VIP overrides will remain)";

            sysConfirm(msg, function() {
                const icon = $('#locationCrownIcon');
                icon.addClass('fa-spin');

                $.ajax({
                    url: '@Url.Action("Locationupdate", "Companies")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        Id: locationId,
                        IsCritical: newStatus,
                        GroupsID: groupId,
                        CompanyID: companyId,
                        LocationName: '@(ViewBag.LocationName ?? "This Location")'
                    }),
                    success: function() {
                        isLocationCritical = newStatus;
                        updateLocationHeaderUI(newStatus);
                        loadInitialData();
                        sysAlert(newStatus ? 'Site-wide monitoring active.' : 'Site-wide monitoring deactivated.', 'success');
                    },
                    error: function() {
                        sysAlert('Failed to update site status.', 'error');
                    },
                    complete: function() {
                        icon.removeClass('fa-spin');
                    }
                });
            });
        }

        async function loadInitialData() {
            $('#loadingState').removeClass('hidden').addClass('flex');
            $('#criticalClientsList').addClass('hidden');
            $('#emptyState').addClass('hidden');

            try {
                await Promise.all([loadAllDevices(), loadCriticalClients()]);
            } catch (err) {
                console.error("Initialization Failed", err);
            } finally {
                $('#loadingState').addClass('hidden').removeClass('flex');
            }
        }

        function loadAllDevices() {
             return $.ajax({
                url: '@Url.Action("GetAllDevices", "ComputerSummary")',
                type: 'GET',
                data: { companyId, groupId, locationId },
                success: function(response) {
                    if (response && response.success && response.data) {
                        allDevices = response.data;
                        populateDeviceDropdown();
                    }
                }
            });
        }

        function populateDeviceDropdown() {
            const select = $('#clientId');
            select.empty().append('<option value="">Choose machine...</option>');

            if (allDevices) {
                allDevices.forEach(device => {
                    const label = `${device.domainName} (${device.userName || 'System'})`;
                    select.append(`<option value="${device.domainName}" data-username="${device.userName || ''}">${label}</option>`);
                });
            }

            select.off('change').on('change', function() {
                const username = $(this).find('option:selected').data('username');
                if (username) $('#clientName').val(username);
            });
        }

        function loadCriticalClients() {
            return $.ajax({
                url: '@Url.Action("GetCriticalClients", "ComputerSummary")',
                type: 'GET',
                data: { companyId, groupId, locationId },
                success: function(response) {
                    if (response && response.success && response.data) {
                        allCriticalClients = response.data;
                        renderCriticalClients(allCriticalClients);
                    } else {
                        showEmptyState();
                    }
                },
                error: function() {
                    showEmptyState();
                }
            });
        }

        function renderCriticalClients(clients) {
            const container = $('#criticalClientsList');
            const emptyState = $('#emptyState');

            if (!clients || clients.length === 0) {
                showEmptyState();
                return;
            }

            emptyState.addClass('hidden');
            container.empty().removeClass('hidden');
            $('#criticalCount').text(clients.length);

            clients.forEach(client => {
                const id = client.clientId || '';
                const name = client.clientName || 'Unnamed Device';
                const source = client.source || 'Manual';
                const sourceBadge = source === 'Manual' 
                    ? '<span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[10px] font-bold bg-amber-50 text-amber-600 uppercase tracking-tighter border border-amber-100">Manual Priority</span>'
                    : '<span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[10px] font-bold bg-blue-50 text-blue-600 uppercase tracking-tighter border border-blue-100">Location Default</span>';
                
                const card = `
                    <div class="critical-card group relative bg-white rounded-3xl border border-slate-100 p-6 shadow-sm hover:shadow-xl hover:shadow-amber-500/5 hover:-translate-y-1 transition-all duration-300" 
                         data-id="${(id || '').toLowerCase()}" data-name="${(name || '').toLowerCase()}">
                        <div class="absolute -top-3 -right-3 w-8 h-8 rounded-full bg-amber-500 flex items-center justify-center shadow-lg shadow-amber-200 opacity-0 group-hover:opacity-100 transition-opacity">
                            <i class="fas fa-crown text-[10px] text-white"></i>
                        </div>
                        <div class="flex items-start space-x-4">
                            <div class="w-14 h-14 rounded-2xl bg-slate-50 flex items-center justify-center flex-shrink-0 group-hover:bg-amber-50 transition-colors">
                                <i class="fas fa-desktop text-slate-400 group-hover:text-amber-600 text-xl transition-colors"></i>
                            </div>
                            <div class="flex-1 min-w-0 pr-6">
                                <h3 class="text-base font-bold text-slate-900 truncate mb-0.5">${name}</h3>
                                <p class="text-xs font-semibold text-slate-400 mb-3 flex items-center truncate">
                                    <span class="w-1.5 h-1.5 rounded-full bg-slate-200 mr-2"></span>
                                    ${id}
                                </p>
                                <div class="flex items-center space-x-2">
                                    ${sourceBadge}
                                </div>
                            </div>
                        </div>
                        <button onclick="removeCriticalClient('${id}', '${name.replace(/'/g, "\\'")}', '${source}')" 
                                class="absolute top-6 right-6 w-10 h-10 rounded-xl bg-slate-50 text-slate-400 hover:bg-rose-50 hover:text-rose-600 flex items-center justify-center transition-all opacity-0 group-hover:opacity-100">
                             <i class="fas fa-trash-alt text-xs"></i>
                        </button>
                    </div>
                `;
                container.append(card);
            });
        }

        function showEmptyState() {
            $('#criticalClientsList').addClass('hidden');
            $('#emptyState').removeClass('hidden');
            $('#criticalCount').text('0');
        }

        function openAddModal() {
            const modal = $('#addCriticalModal');
            modal.removeClass('hidden').addClass('flex');
            setTimeout(() => {
                modal.removeClass('opacity-0').addClass('opacity-100');
                modal.find('> div').removeClass('scale-95').addClass('scale-100');
            }, 10);
        }

        function closeAddModal() {
            const modal = $('#addCriticalModal');
            modal.removeClass('opacity-100').addClass('opacity-0');
            modal.find('> div').removeClass('scale-100').addClass('scale-95');
            setTimeout(() => {
                modal.addClass('hidden').removeClass('flex');
                $('#clientId').val('');
                $('#clientName').val('');
            }, 300);
        }

        function addCriticalClient(e) {
            if (e && e.preventDefault) e.preventDefault();
            
            const clientId = $('#clientId').val();
            const clientName = $('#clientName').val();

            if (!clientId || !clientName) {
                showToast('Execution blocked: Data requirements missing.', 'error');
                return;
            }

            $.ajax({
                url: '@Url.Action("AddCriticalClient", "ComputerSummary")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ClientId: clientId,
                    ClientName: clientName,
                    CompanyID: companyId,
                    GroupsID: groupId,
                    LocationID: locationId
                }),
                success: function(response) {
                    if (response && response.success) {
                        closeAddModal();
                        loadInitialData();
                        showToast('Monitoring successfully deployed.', 'success');
                    } else {
                        showToast((response && response.message) || 'Operation failed.', 'error');
                    }
                },
                error: function() {
                    showToast('Network synchronization failed.', 'error');
                }
            });
        }

        function removeCriticalClient(clientId, name, source) {
            const msg = source === 'Location' 
                ? `Confirm explicit exclusion of ${name} from critical monitoring? (It is currently inherited from location settings)`
                : `Confirm detachment of critical monitoring for ${name}?`;

            sysConfirm(msg, function() {
                $.ajax({
                    url: '@Url.Action("RemoveCriticalClient", "ComputerSummary")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(clientId),
                    success: function(response) {
                        if (response && response.success) {
                            loadInitialData();
                            sysAlert('Monitoring detached successfully.', 'success');
                        }
                    },
                    error: function() {
                        sysAlert('Failed to detach monitoring.', 'error');
                    }
                });
            }, { type: 'danger' });
        }

        function filterCriticalClients() {
            const term = $('#searchCritical').val().toLowerCase();
            const cards = $('.critical-card');
            let count = 0;

            cards.each(function() {
                const card = $(this);
                const match = card.data('id').toString().includes(term) || card.data('name').toString().includes(term);
                card.toggle(match);
                if (match) count++;
            });

            if (term) $('#criticalCount').text(count);
            else $('#criticalCount').text(cards.length);
        }

        function showToast(message, type) {
            const icon = type === 'success' ? 'fa-check-circle' : 'fa-times-circle';
            const color = type === 'success' ? 'bg-emerald-600' : 'bg-rose-600';
            
            const toast = $(`
                <div class="fixed bottom-8 right-8 ${color} text-white px-6 py-4 rounded-2xl shadow-2xl z-[200] flex items-center space-x-3 transition-all duration-500 translate-y-20 opacity-0">
                    <i class="fas ${icon} text-xl"></i>
                    <span class="text-sm font-bold tracking-tight">${message}</span>
                </div>
            `);

            $('body').append(toast);
            setTimeout(() => toast.removeClass('translate-y-20 opacity-0'), 100);
            setTimeout(() => {
                toast.addClass('translate-y-20 opacity-0');
                setTimeout(() => toast.remove(), 500);
            }, 4000);
        }
    </script>
}
