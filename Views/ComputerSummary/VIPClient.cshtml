@model List<ManageEngineWebApp.Models.VIPClient>

@{
    ViewData["Title"] = "Critical Monitoring Management";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var companyId = ViewBag.CompanyId;
    var groupId = ViewBag.GroupId;
    var locationId = ViewBag.LocationId;
    var companyName = ViewBag.CompanyName ?? "Unknown Company";
}

@section Styles {
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&display=swap');

        .vip-root {
            font-family: 'DM Sans', sans-serif;
        }

        /* --- Layout --- */
        .vip-wrap {
            max-width: 1200px;
            margin: 0 auto;
            padding: 16px 20px;
        }

        /* --- Header --- */
        .vip-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
        }

        .vip-header-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .vip-back-btn {
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 7px;
            color: #64748b;
            cursor: pointer;
            transition: background .15s;
            text-decoration: none;
        }

            .vip-back-btn:hover {
                background: #f8fafc;
            }

            .vip-back-btn i {
                font-size: 11px;
            }

        .vip-crown-btn {
            position: relative;
            cursor: pointer;
            background: none;
            border: none;
            padding: 0;
        }

        .vip-crown-box {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .25s;
            box-shadow: 0 1px 3px rgba(0,0,0,.08);
        }

            .vip-crown-box i {
                font-size: 11px;
                color: #94a3b8;
                transition: color .25s;
            }

            .vip-crown-box.active {
                background: linear-gradient(135deg, #f59e0b, #d97706);
                box-shadow: 0 2px 8px rgba(245,158,11,.35);
            }

                .vip-crown-box.active i {
                    color: #fff;
                }

        .vip-site-badge {
            position: absolute;
            bottom: -3px;
            right: -3px;
            background: #f59e0b;
            color: #fff;
            font-size: 6px;
            font-weight: 700;
            padding: 1px 3px;
            border-radius: 3px;
            letter-spacing: .5px;
        }

        .vip-title {
            font-size: 15px;
            font-weight: 700;
            color: #0f172a;
            line-height: 1.2;
            margin: 0;
        }

        .vip-subtitle {
            font-size: 11px;
            color: #94a3b8;
            display: flex;
            align-items: center;
            gap: 4px;
            margin: 0;
        }

            .vip-subtitle i {
                font-size: 9px;
            }

        .vip-add-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: #0f172a;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: background .15s;
            white-space: nowrap;
            font-family: 'DM Sans', sans-serif;
        }

            .vip-add-btn:hover {
                background: #1e293b;
            }

            .vip-add-btn i {
                font-size: 10px;
                color: #94a3b8;
            }

        /* --- Stats Row --- */
        .vip-stats-row {
            display: grid;
            grid-template-columns: 140px 1fr;
            gap: 10px;
            margin-bottom: 14px;
        }

        .vip-stat-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 10px 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 1px 3px rgba(0,0,0,.04);
        }

        .vip-stat-label {
            font-size: 9px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: .8px;
            margin-bottom: 2px;
        }

        .vip-stat-value {
            font-size: 22px;
            font-weight: 800;
            color: #0f172a;
            font-family: 'DM Mono', monospace;
            line-height: 1;
        }

        .vip-stat-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: #fffbeb;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .vip-stat-icon i {
                font-size: 13px;
                color: #d97706;
            }

        .vip-search-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 8px 12px;
            display: flex;
            align-items: center;
            box-shadow: 0 1px 3px rgba(0,0,0,.04);
        }

        .vip-search-wrap {
            position: relative;
            flex: 1;
        }

            .vip-search-wrap i {
                position: absolute;
                left: 10px;
                top: 50%;
                transform: translateY(-50%);
                color: #cbd5e1;
                font-size: 11px;
            }

        .vip-search-input {
            width: 100%;
            padding: 6px 10px 6px 30px;
            background: #f8fafc;
            border: 1px solid transparent;
            border-radius: 7px;
            font-size: 12px;
            font-weight: 500;
            color: #1e293b;
            outline: none;
            transition: all .15s;
            font-family: 'DM Sans', sans-serif;
            box-sizing: border-box;
        }

            .vip-search-input:focus {
                border-color: #fbbf24;
                background: #fff;
                box-shadow: 0 0 0 3px rgba(251,191,36,.12);
            }

            .vip-search-input::placeholder {
                color: #cbd5e1;
            }

        /* --- States --- */
        .vip-loading {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px;
            background: #fff;
            border: 1px dashed #e2e8f0;
            border-radius: 12px;
        }

        .vip-spinner {
            width: 24px;
            height: 24px;
            border: 2px solid #e2e8f0;
            border-top-color: #f59e0b;
            border-radius: 50%;
            animation: spin .7s linear infinite;
            margin-bottom: 10px;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .vip-loading-text {
            font-size: 12px;
            color: #94a3b8;
            font-weight: 500;
        }

        .vip-empty {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px;
            background: #fff;
            border: 1px dashed #e2e8f0;
            border-radius: 12px;
        }

        .vip-empty-icon {
            width: 44px;
            height: 44px;
            background: #fffbeb;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
        }

            .vip-empty-icon i {
                font-size: 18px;
                color: #fde68a;
            }

        .vip-empty h3 {
            font-size: 13px;
            font-weight: 700;
            color: #0f172a;
            margin: 0 0 4px;
        }

        .vip-empty p {
            font-size: 11px;
            color: #94a3b8;
            text-align: center;
            max-width: 280px;
            margin: 0 0 14px;
            line-height: 1.5;
        }

        .vip-empty-btn {
            padding: 7px 16px;
            background: #f59e0b;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: background .15s;
            font-family: 'DM Sans', sans-serif;
        }

            .vip-empty-btn:hover {
                background: #d97706;
            }

        /* --- Cards Grid --- */
        .vip-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
            gap: 8px;
        }

        .critical-card {
            position: relative;
            background: #fff;
            border: 1px solid #f1f5f9;
            border-radius: 10px;
            padding: 12px;
            cursor: default;
            transition: all .2s;
            box-shadow: 0 1px 3px rgba(0,0,0,.04);
            background-image: radial-gradient(circle at top right, rgba(245,158,11,.03), transparent);
        }

            .critical-card:hover {
                border-color: #fde68a;
                box-shadow: 0 4px 16px rgba(245,158,11,.1);
                transform: translateY(-1px);
            }

        .card-crown-dot {
            position: absolute;
            top: -4px;
            right: -4px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #f59e0b;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity .2s;
            box-shadow: 0 2px 6px rgba(245,158,11,.4);
        }

        .critical-card:hover .card-crown-dot {
            opacity: 1;
        }

        .card-crown-dot i {
            font-size: 7px;
            color: #fff;
        }

        .card-body {
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

        .card-icon-wrap {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: background .2s;
        }

        .critical-card:hover .card-icon-wrap {
            background: #fffbeb;
        }

        .card-icon-wrap i {
            font-size: 13px;
            color: #94a3b8;
            transition: color .2s;
        }

        .critical-card:hover .card-icon-wrap i {
            color: #d97706;
        }

        .card-info {
            flex: 1;
            min-width: 0;
        }

        .card-name {
            font-size: 12px;
            font-weight: 700;
            color: #0f172a;
            margin: 0 0 2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .card-id {
            font-size: 10px;
            color: #94a3b8;
            font-family: 'DM Mono', monospace;
            display: flex;
            align-items: center;
            gap: 4px;
            margin-bottom: 7px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .card-id::before {
                content: '';
                display: inline-block;
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: #e2e8f0;
                flex-shrink: 0;
            }

        .card-badge {
            display: inline-flex;
            align-items: center;
            padding: 2px 7px;
            border-radius: 5px;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: .5px;
            text-transform: uppercase;
        }

        .badge-manual {
            background: #fffbeb;
            color: #d97706;
            border: 1px solid #fde68a;
        }

        .badge-location {
            background: #eff6ff;
            color: #3b82f6;
            border: 1px solid #bfdbfe;
        }

        .card-del-btn {
            position: absolute;
            top: 8px;
            right: 8px;
            width: 24px;
            height: 24px;
            border-radius: 6px;
            background: #f8fafc;
            border: none;
            color: #94a3b8;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            opacity: 0;
            transition: all .15s;
        }

        .critical-card:hover .card-del-btn {
            opacity: 1;
        }

        .card-del-btn:hover {
            background: #fff1f2;
            color: #e11d48;
        }

        .card-del-btn i {
            font-size: 9px;
        }

        /* --- Modal --- */
        .vip-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.5);
            backdrop-filter: blur(4px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 100;
            padding: 16px;
            opacity: 0;
            transition: opacity .25s;
        }

            .vip-modal-overlay.visible {
                display: flex;
            }

            .vip-modal-overlay.shown {
                opacity: 1;
            }

        .vip-modal {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 20px 60px rgba(0,0,0,.15);
            width: 100%;
            max-width: 340px;
            overflow: hidden;
            transform: scale(.96) translateY(8px);
            transition: transform .25s;
        }

        .vip-modal-overlay.shown .vip-modal {
            transform: scale(1) translateY(0);
        }

        .vip-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 16px;
            border-bottom: 1px solid #f1f5f9;
        }

        .modal-header-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .modal-icon {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: #f59e0b;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .modal-icon i {
                font-size: 11px;
                color: #fff;
            }

        .modal-title {
            font-size: 13px;
            font-weight: 700;
            color: #0f172a;
            margin: 0;
        }

        .modal-sub {
            font-size: 10px;
            color: #94a3b8;
            font-style: italic;
            margin: 0;
        }

        .modal-close {
            width: 26px;
            height: 26px;
            border-radius: 6px;
            border: none;
            background: none;
            color: #94a3b8;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background .15s;
        }

            .modal-close:hover {
                background: #f1f5f9;
            }

            .modal-close i {
                font-size: 11px;
            }

        .vip-modal-body {
            padding: 16px;
        }

        .form-group {
            margin-bottom: 12px;
        }

        .form-label {
            display: block;
            font-size: 9px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: .8px;
            margin-bottom: 5px;
            padding-left: 2px;
        }

        .form-field-wrap {
            position: relative;
        }

            .form-field-wrap > i {
                position: absolute;
                left: 10px;
                top: 50%;
                transform: translateY(-50%);
                color: #cbd5e1;
                font-size: 11px;
                pointer-events: none;
                transition: color .15s;
            }

            .form-field-wrap:focus-within > i {
                color: #f59e0b;
            }

        .form-select, .form-input {
            width: 100%;
            padding: 8px 10px 8px 30px;
            background: #f8fafc;
            border: 1px solid transparent;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 500;
            color: #1e293b;
            outline: none;
            transition: all .15s;
            appearance: none;
            box-sizing: border-box;
            font-family: 'DM Sans', sans-serif;
        }

            .form-select:focus, .form-input:focus {
                border-color: #fbbf24;
                background: #fff;
                box-shadow: 0 0 0 3px rgba(251,191,36,.12);
            }

        .form-select {
            padding-right: 28px;
        }

        .form-chevron {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #cbd5e1;
            font-size: 9px;
            pointer-events: none;
        }

        .form-hint {
            font-size: 9px;
            color: #cbd5e1;
            padding-left: 2px;
            margin-top: 3px;
            font-style: italic;
        }

        .form-actions {
            display: flex;
            gap: 8px;
            padding-top: 4px;
        }

        .btn-primary {
            flex: 1;
            padding: 9px;
            background: #f59e0b;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: background .15s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-family: 'DM Sans', sans-serif;
        }

            .btn-primary:hover {
                background: #d97706;
            }

            .btn-primary i {
                font-size: 10px;
                opacity: .8;
            }

        .btn-secondary {
            padding: 9px 14px;
            background: #f1f5f9;
            color: #475569;
            border: none;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: background .15s;
            font-family: 'DM Sans', sans-serif;
        }

            .btn-secondary:hover {
                background: #e2e8f0;
            }

        /* --- Toast --- */
        .vip-toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            padding: 10px 16px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            font-weight: 600;
            color: #fff;
            box-shadow: 0 8px 24px rgba(0,0,0,.15);
            z-index: 200;
            transition: all .4s;
            opacity: 0;
            transform: translateY(16px);
            font-family: 'DM Sans', sans-serif;
        }

            .vip-toast.show {
                opacity: 1;
                transform: translateY(0);
            }

            .vip-toast i {
                font-size: 13px;
            }

        select option {
            background: #fff;
            color: #1e293b;
        }
    </style>
}

<div class="vip-root">
    <div class="vip-wrap">

        <!-- Header -->
        <div class="vip-header">
            <div class="vip-header-left">
                <a href="javascript:history.back()" class="vip-back-btn">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <button onclick="toggleLocationCriticality()" class="vip-crown-btn" id="locationCriticalToggleHeader" title="Toggle Location-wide Critical Monitoring">
                    <div id="locationCrownContainer" class="vip-crown-box">
                        <i id="locationCrownIcon" class="fas fa-crown"></i>
                    </div>
                    <div id="locationStatusBadge" class="vip-site-badge hidden">SITE</div>
                </button>
                <div>
                    <h1 class="vip-title">Critical Monitoring</h1>
                    <p class="vip-subtitle"><i class="fas fa-building"></i> @companyName</p>
                </div>
            </div>
            <button onclick="openAddModal()" class="vip-add-btn">
                <i class="fas fa-plus"></i>
                Add Device
            </button>
        </div>

        <!-- Stats + Search -->
        <div class="vip-stats-row">
            <div class="vip-stat-card">
                <div>
                    <div class="vip-stat-label">Monitored</div>
                    <div class="vip-stat-value" id="criticalCount">0</div>
                </div>
                <div class="vip-stat-icon"><i class="fas fa-microchip"></i></div>
            </div>
            <div class="vip-search-card">
                <div class="vip-search-wrap">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchCritical" class="vip-search-input"
                           placeholder="Search by ID or name..."
                           onkeyup="filterCriticalClients()">
                </div>
            </div>
        </div>

        <!-- Loading -->
        <div id="loadingState" class="vip-loading">
            <div class="vip-spinner"></div>
            <p class="vip-loading-text">Synchronizing critical fleet data...</p>
        </div>

        <!-- Cards Grid -->
        <div id="criticalClientsList" class="vip-grid hidden"></div>

        <!-- Empty State -->
        <div id="emptyState" class="vip-empty hidden">
            <div class="vip-empty-icon"><i class="fas fa-crown"></i></div>
            <h3>No Devices Under Critical Watch</h3>
            <p>Devices added here will trigger high-priority alerts across the @companyName infrastructure when resources are stressed.</p>
            <button onclick="openAddModal()" class="vip-empty-btn">Provision First Device</button>
        </div>

    </div>
</div>

<!-- Add Modal -->
<div id="addCriticalModal" class="vip-modal-overlay">
    <div class="vip-modal">
        <div class="vip-modal-header">
            <div class="modal-header-left">
                <div class="modal-icon"><i class="fas fa-plus"></i></div>
                <div>
                    <p class="modal-title">Provision Critical Device</p>
                    <p class="modal-sub">Scoped to @companyName</p>
                </div>
            </div>
            <button onclick="closeAddModal()" class="modal-close"><i class="fas fa-times"></i></button>
        </div>
        <div class="vip-modal-body">
            <form id="addCriticalForm">
                <div class="form-group">
                    <label class="form-label">Source Machine</label>
                    <div class="form-field-wrap">
                        <i class="fas fa-desktop"></i>
                        <select id="clientId" required class="form-select">
                            <option value="">Querying active fleet...</option>
                        </select>
                        <i class="fas fa-chevron-down form-chevron"></i>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Friendly Label</label>
                    <div class="form-field-wrap">
                        <i class="fas fa-tag"></i>
                        <input type="text" id="clientName" required class="form-input" placeholder="e.g. CEO Laptop, Main Server">
                    </div>
                    <p class="form-hint">Appears in all system-wide alerts.</p>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn-primary">
                        <i class="fas fa-bolt"></i> Activate Monitoring
                    </button>
                    <button type="button" onclick="closeAddModal()" class="btn-secondary">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const companyId = @(ViewBag.CompanyId ?? 0);
        const groupId = @(ViewBag.GroupId ?? 0);
        const locationId = @(ViewBag.LocationId ?? 0);

        let allDevices = [];
        let allCriticalClients = [];
        let isLocationCritical = false;

        $(document).ready(function() {
            loadInitialData();
            checkLocationStatus();
            $('#addCriticalForm').on('submit', addCriticalClient);
        });

        function checkLocationStatus() {
            $.get('@Url.Action("GetLocationCriticalStatus", "ComputerSummary")', { locationId: locationId }, function(res) {
                isLocationCritical = res && res.isCritical;
                updateLocationHeaderUI(isLocationCritical);
            });
        }

        function updateLocationHeaderUI(isCritical) {
            const container = $('#locationCrownContainer');
            const icon = $('#locationCrownIcon');
            const badge = $('#locationStatusBadge');

            if (isCritical) {
                container.addClass('active');
                badge.removeClass('hidden');
            } else {
                container.removeClass('active');
                badge.addClass('hidden');
            }
        }

        function toggleLocationCriticality() {
            const newStatus = !isLocationCritical;
            const msg = newStatus
                ? "Switching to SITE-WIDE critical monitoring? This will mark all existing devices in this location as critical."
                : "Disable site-wide critical monitoring? (Individual VIP overrides will remain)";

            sysConfirm(msg, function() {
                const icon = $('#locationCrownIcon');
                icon.addClass('fa-spin');

                $.ajax({
                    url: '@Url.Action("Locationupdate", "Companies")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        Id: locationId,
                        IsCritical: newStatus,
                        GroupsID: groupId,
                        CompanyID: companyId,
                        LocationName: '@(ViewBag.LocationName ?? "This Location")'
                    }),
                    success: function() {
                        isLocationCritical = newStatus;
                        updateLocationHeaderUI(newStatus);
                        loadInitialData();
                        sysAlert(newStatus ? 'Site-wide monitoring active.' : 'Site-wide monitoring deactivated.', 'success');
                    },
                    error: function() {
                        sysAlert('Failed to update site status.', 'error');
                    },
                    complete: function() {
                        icon.removeClass('fa-spin');
                    }
                });
            });
        }

        async function loadInitialData() {
            $('#loadingState').show();
            $('#criticalClientsList').addClass('hidden');
            $('#emptyState').addClass('hidden');

            try {
                await Promise.all([loadAllDevices(), loadCriticalClients()]);
            } catch (err) {
                console.error("Initialization Failed", err);
            } finally {
                $('#loadingState').hide();
            }
        }

        function loadAllDevices() {
            return $.ajax({
                url: '@Url.Action("GetAllDevices", "ComputerSummary")',
                type: 'GET',
                data: { companyId, groupId, locationId },
                success: function(response) {
                    if (response && response.success && response.data) {
                        allDevices = response.data;
                        populateDeviceDropdown();
                    }
                }
            });
        }

        function populateDeviceDropdown() {
            const select = $('#clientId');
            select.empty().append('<option value="">Choose machine...</option>');

            if (allDevices) {
                allDevices.forEach(device => {
                    const label = `${device.domainName} (${device.userName || 'System'})`;
                    select.append(`<option value="${device.domainName}" data-username="${device.userName || ''}">${label}</option>`);
                });
            }

            select.off('change').on('change', function() {
                const username = $(this).find('option:selected').data('username');
                if (username) $('#clientName').val(username);
            });
        }

        function loadCriticalClients() {
            return $.ajax({
                url: '@Url.Action("GetCriticalClients", "ComputerSummary")',
                type: 'GET',
                data: { companyId, groupId, locationId },
                success: function(response) {
                    if (response && response.success && response.data) {
                        allCriticalClients = response.data;
                        renderCriticalClients(allCriticalClients);
                    } else {
                        showEmptyState();
                    }
                },
                error: function() {
                    showEmptyState();
                }
            });
        }

        function renderCriticalClients(clients) {
            const container = $('#criticalClientsList');
            const emptyState = $('#emptyState');

            if (!clients || clients.length === 0) {
                showEmptyState();
                return;
            }

            emptyState.addClass('hidden');
            container.empty().removeClass('hidden');
            $('#criticalCount').text(clients.length);

            clients.forEach(client => {
                const id = client.clientId || '';
                const name = client.clientName || 'Unnamed Device';
                const source = client.source || 'Manual';
                const badgeClass = source === 'Manual' ? 'badge-manual' : 'badge-location';
                const badgeLabel = source === 'Manual' ? 'Manual Priority' : 'Location Default';

                const card = $(`
                    <div class="critical-card" data-id="${(id || '').toLowerCase()}" data-name="${(name || '').toLowerCase()}">
                        <div class="card-crown-dot"><i class="fas fa-crown"></i></div>
                        <div class="card-body">
                            <div class="card-icon-wrap"><i class="fas fa-desktop"></i></div>
                            <div class="card-info">
                                <div class="card-name">${name}</div>
                                <div class="card-id">${id}</div>
                                <span class="card-badge ${badgeClass}">${badgeLabel}</span>
                            </div>
                        </div>
                        <button class="card-del-btn" onclick="removeCriticalClient('${id}', '${name.replace(/'/g, "\\'")}', '${source}')">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                `);
                container.append(card);
            });
        }

        function showEmptyState() {
            $('#criticalClientsList').addClass('hidden');
            $('#emptyState').removeClass('hidden');
            $('#criticalCount').text('0');
        }

        function openAddModal() {
            const modal = $('#addCriticalModal');
            modal.addClass('visible');
            setTimeout(() => modal.addClass('shown'), 10);
        }

        function closeAddModal() {
            const modal = $('#addCriticalModal');
            modal.removeClass('shown');
            setTimeout(() => {
                modal.removeClass('visible');
                $('#clientId').val('');
                $('#clientName').val('');
            }, 280);
        }

        function addCriticalClient(e) {
            if (e && e.preventDefault) e.preventDefault();

            const clientId = $('#clientId').val();
            const clientName = $('#clientName').val();

            if (!clientId || !clientName) {
                showToast('Data requirements missing.', 'error');
                return;
            }

            $.ajax({
                url: '@Url.Action("AddCriticalClient", "ComputerSummary")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ClientId: clientId,
                    ClientName: clientName,
                    CompanyID: companyId,
                    GroupsID: groupId,
                    LocationID: locationId
                }),
                success: function(response) {
                    if (response && response.success) {
                        closeAddModal();
                        loadInitialData();
                        showToast('Monitoring successfully deployed.', 'success');
                    } else {
                        showToast((response && response.message) || 'Operation failed.', 'error');
                    }
                },
                error: function() {
                    showToast('Network synchronization failed.', 'error');
                }
            });
        }

        function removeCriticalClient(clientId, name, source) {
            const msg = source === 'Location'
                ? `Confirm explicit exclusion of ${name} from critical monitoring? (It is currently inherited from location settings)`
                : `Confirm detachment of critical monitoring for ${name}?`;

            sysConfirm(msg, function() {
                $.ajax({
                    url: '@Url.Action("RemoveCriticalClient", "ComputerSummary")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(clientId),
                    success: function(response) {
                        if (response && response.success) {
                            loadInitialData();
                            sysAlert('Monitoring detached successfully.', 'success');
                        }
                    },
                    error: function() {
                        sysAlert('Failed to detach monitoring.', 'error');
                    }
                });
            }, { type: 'danger' });
        }

        function filterCriticalClients() {
            const term = $('#searchCritical').val().toLowerCase();
            const cards = $('.critical-card');
            let count = 0;

            cards.each(function() {
                const card = $(this);
                const match = card.data('id').toString().includes(term) || card.data('name').toString().includes(term);
                card.toggle(match);
                if (match) count++;
            });

            if (term) $('#criticalCount').text(count);
            else $('#criticalCount').text(cards.length);
        }

        function showToast(message, type) {
            const icon = type === 'success' ? 'fa-check-circle' : 'fa-times-circle';
            const bg = type === 'success' ? '#059669' : '#dc2626';

            const toast = $(`
                <div class="vip-toast" style="background:${bg}">
                    <i class="fas ${icon}"></i>
                    <span>${message}</span>
                </div>
            `);

            $('body').append(toast);
            setTimeout(() => toast.addClass('show'), 50);
            setTimeout(() => {
                toast.removeClass('show');
                setTimeout(() => toast.remove(), 400);
            }, 3500);
        }
    </script>
}
