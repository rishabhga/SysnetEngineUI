<style>
    .cpu-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
        background: var(--cyan-soft);
        border: 1px solid #d3f1fa;
        border-radius: var(--radius-md);
        padding: 12px 16px;
        position: relative;
        overflow: hidden;
        margin-bottom: 10px;
    }

    .cpu-hero-left {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .cpu-chip-icon {
        width: 38px;
        height: 38px;
        border-radius: var(--radius-sm);
        flex-shrink: 0;
        background: var(--cyan);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        color: #fff;
    }

    .cpu-hero-name {
        font-size: .92rem;
        font-weight: 800;
        line-height: 1.25;
        color: var(--text-main);
        word-break: break-word;
    }

    .cpu-hero-sub {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 5px;
    }

    .cpu-pill {
        font-size: .66rem;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 999px;
        background: #fff;
        border: 1px solid var(--slate-200);
        color: var(--slate-600);
        display: inline-flex;
        align-items: center;
        gap: 5px;
        letter-spacing: .02em;
    }

    .cpu-hero-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .cpu-status-badge {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: .72rem;
        font-weight: 800;
        background: #ecfdf5;
        border: 1px solid rgba(34,197,94,.35);
        color: #16a34a;
        padding: 5px 11px;
        border-radius: 999px;
        white-space: nowrap;
    }

        .cpu-status-badge.is-down {
            background: #fef2f2;
            border-color: rgba(239,68,68,.35);
            color: #dc2626;
        }

    .cpu-live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c55e;
        flex-shrink: 0;
        animation: cpuLiveDot 1.8s infinite;
    }

    .cpu-status-badge.is-down .cpu-live-dot {
        background: #ef4444;
    }

    @@keyframes cpuLiveDot {
        0% {
            box-shadow: 0 0 0 0 rgba(34,197,94,.5);
        }

        70% {
            box-shadow: 0 0 0 7px rgba(34,197,94,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(34,197,94,0);
        }
    }

    .cpu-updated {
        font-size: .66rem;
        color: var(--text-faint);
        font-weight: 600;
        white-space: nowrap;
    }

    .cpu-refresh-btn {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: 1px solid var(--slate-200);
        background: #fff;
        color: var(--slate-600);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .2s, color .2s;
    }

        .cpu-refresh-btn:hover {
            background: var(--cyan);
            color: #fff;
        }

        .cpu-refresh-btn.spinning i {
            animation: cpuSpin .8s linear infinite;
        }

    @@keyframes cpuSpin {
        to {
            transform: rotate(360deg);
        }
    }

    .cpu-section-label {
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: var(--slate-600);
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 18px 0 8px;
    }

    .cpu-cache-card {
        background: #fff;
        border: 1px solid var(--slate-200);
        border-radius: var(--radius-md);
        padding: 16px 18px;
        box-shadow: var(--shadow-sm);
    }

    .cpu-cache-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }

        .cpu-cache-row:last-child {
            margin-bottom: 0;
        }

    .cpu-cache-label {
        width: 30px;
        flex-shrink: 0;
        font-size: .74rem;
        font-weight: 800;
        color: var(--slate-700);
    }

    .cpu-cache-track {
        flex: 1;
        height: 10px;
        border-radius: 6px;
        background: var(--slate-100);
        overflow: hidden;
    }

    .cpu-cache-fill {
        height: 100%;
        border-radius: 6px;
        transition: width 1s cubic-bezier(.4,0,.2,1);
    }

    .cpu-cache-value {
        width: 76px;
        text-align: right;
        flex-shrink: 0;
        font-size: .76rem;
        font-weight: 700;
        color: var(--slate-600);
    }

    .cpu-thermal-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 22px;
        align-items: center;
        background: #fff;
        border: 1px solid var(--slate-200);
        border-radius: var(--radius-md);
        padding: 18px;
        box-shadow: var(--shadow-sm);
    }

    .cpu-core-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
        gap: 14px;
        flex: 1;
        min-width: 240px;
    }

    .cpu-core-gauge {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }

    .cpu-core-gauge-label {
        font-size: .64rem;
        font-weight: 700;
        color: var(--slate-500);
        text-transform: uppercase;
    }

    .cpu-core-gauge-value {
        font-size: .7rem;
        font-weight: 800;
    }

    .cpu-chart-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 16px;
    }

    .cpu-chart-card {
        background: #fff;
        border: 1px solid var(--slate-200);
        border-radius: var(--radius-md);
        padding: 14px 16px;
        box-shadow: var(--shadow-sm);
    }

    .chart-filter-pills {
        display: flex;
        gap: 4px;
        background: var(--slate-100);
        border-radius: 8px;
        padding: 3px;
    }

    .chart-filter-btn {
        border: none;
        background: transparent;
        color: var(--slate-500);
        font-size: .7rem;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 6px;
        cursor: pointer;
        transition: all .2s ease;
        letter-spacing: .02em;
    }

    .chart-filter-btn:hover {
        color: var(--slate-700);
        background: rgba(255,255,255,.6);
    }

    .chart-filter-btn.active {
        background: #fff;
        color: var(--primary);
        box-shadow: 0 1px 3px rgba(0,0,0,.1);
    }

    .chart-date-range {
        display: flex;
        align-items: center;
        gap: 4px;
        background: var(--slate-100);
        border-radius: 8px;
        padding: 3px;
    }

    .chart-date-input {
        border: 1px solid transparent;
        background: #fff;
        border-radius: 5px;
        padding: 3px 6px;
        font-size: .68rem;
        font-family: inherit;
        color: var(--slate-700);
        width: 120px;
        outline: none;
        transition: border-color .2s;
    }

    .chart-date-input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 2px rgba(14,165,233,.15);
    }

    .chart-date-apply {
        background: var(--primary) !important;
        color: #fff !important;
        padding: 4px 10px !important;
        border-radius: 5px !important;
        font-size: .7rem;
    }

    .chart-date-apply:hover {
        background: var(--primary-dark, #0284c7) !important;
    }

        .cpu-chart-card h4 {
            font-size: .8rem;
            font-weight: 700;
            color: var(--slate-700);
            margin: 0 0 10px;
        }

    @@media (max-width: 560px) {
        .cpu-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .cpu-hero-right {
            width: 100%;
            justify-content: space-between;
        }
    }

    /* ── Hard Disk responsive ───────────────────────── */
    .disk-hero-right {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }

    @@media (max-width: 600px) {
        #HardDiskHw .cpu-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        #HardDiskHw .cpu-hero-right {
            width: 100%;
            justify-content: flex-start;
            flex-wrap: wrap;
        }

        #HardDiskHw .cpu-hero-sub {
            flex-wrap: wrap;
        }

        #diskUsageContainer > div {
            padding: 12px !important;
        }

        #diskUsageContainer .disk-label-row {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 2px;
        }
    }

    /* ── Partition / Logical Drive cards ────────── */
    .partition-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 12px;
    }

    .partition-card {
        background: #fff;
        border: 1px solid var(--slate-200);
        border-radius: var(--radius-md);
        padding: 14px 16px;
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
        gap: 10px;
        transition: box-shadow .2s;
    }

        .partition-card:hover {
            box-shadow: 0 4px 16px -4px rgba(0,0,0,.1);
        }

    .partition-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .partition-drive-badge {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .partition-drive-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .9rem;
        flex-shrink: 0;
    }

    .partition-drive-letter {
        font-size: 1rem;
        font-weight: 800;
        color: var(--slate-800);
    }

    .partition-fs-badge {
        font-size: .6rem;
        font-weight: 700;
        letter-spacing: .04em;
        background: var(--slate-100);
        color: var(--slate-500);
        border-radius: 4px;
        padding: 2px 6px;
        text-transform: uppercase;
    }

    .partition-type-badge {
        font-size: .6rem;
        font-weight: 700;
        letter-spacing: .03em;
        padding: 2px 7px;
        border-radius: 999px;
        white-space: nowrap;
    }

    .partition-bar-wrap {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .partition-bar-track {
        height: 8px;
        border-radius: 4px;
        background: var(--slate-100);
        overflow: hidden;
    }

    .partition-bar-fill {
        height: 100%;
        border-radius: 4px;
        transition: width 1s cubic-bezier(.4,0,.2,1);
    }

    .partition-bar-labels {
        display: flex;
        justify-content: space-between;
        font-size: .68rem;
        font-weight: 700;
    }

    .partition-stats {
        display: flex;
        justify-content: space-between;
        border-top: 1px solid var(--slate-100);
        padding-top: 8px;
        gap: 6px;
    }

    .partition-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
    }

    .partition-stat-val {
        font-size: .8rem;
        font-weight: 800;
        color: var(--slate-800);
    }

    .partition-stat-lbl {
        font-size: .6rem;
        font-weight: 600;
        color: var(--slate-400);
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    @@media (max-width: 480px) {
        .partition-grid

    {
        grid-template-columns: 1fr;
    }

    }
</style>

