                        <div class="cs-info-box"><div class="cs-info-box-label">Design Capacity</div><div class="cs-info-box-value"><span id="auditDesignCap" style="font-size:1rem;">--</span> <span style="font-size:.68rem;color:var(--slate-400);">mWh</span></div></div>
                        <div class="cs-info-box"><div class="cs-info-box-label">Full Charge</div><div class="cs-info-box-value"><span id="auditFullCap" style="font-size:1rem;">--</span> <span style="font-size:.68rem;color:var(--slate-400);">mWh</span></div></div>
                        <div class="cs-info-box"><div class="cs-info-box-label">Cycle Count</div><div class="cs-info-box-value" id="auditCycleCount" style="font-size:1rem;">--</div></div>
                        <div class="cs-info-box"><div class="cs-info-box-label">Wear Rate</div><div class="cs-info-box-value"><span id="auditWearRate" style="font-size:1rem;">--</span> <span style="font-size:.68rem;color:var(--slate-400);">mWh/mo</span></div></div>
                        <div class="cs-info-box"><div class="cs-info-box-label">Est. Remaining</div><div class="cs-info-box-value"><span id="auditRemainingLife" style="font-size:1rem;">--</span> <span style="font-size:.68rem;color:var(--slate-400);">Months</span></div></div>
                    </div>
                    <div id="capacityChartContainer" style="display:none;margin-top:20px;padding:15px;background:#fff;border-radius:var(--radius-md);border:1px solid var(--slate-200);">
                        <h4 style="font-size:.85rem;font-weight:700;color:var(--slate-700);margin-bottom:10px;"><i class="fas fa-chart-line"></i> Capacity History Trend</h4>
                        <div style="position: relative; height: 250px; width: 100%;">
                            <canvas id="capacityTrendChart"></canvas>
                        </div>
                    </div>
