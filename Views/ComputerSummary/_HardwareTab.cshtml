                                        <th>Start Time</th>
                                        <th>State</th>
                                        <th>Duration</th>
                                        <th>Energy Drained</th>
                                    </tr>
                                </thead>
                                <tbody id="batteryUsageTableBody">
                                </tbody>
                            </table>
                        </div>

                        <h4 style="font-size:.85rem;font-weight:700;color:var(--slate-700);margin-bottom:10px;"><i class="fas fa-history"></i> Usage History (Active Duration)</h4>
                        <div class="table-responsive" style="max-height:250px;overflow-y:auto;">
                            <table class="table table-sm table-striped table-hover" style="font-size:0.75rem;margin:0;">
                                <thead style="position:sticky;top:0;background:#f8fafc;z-index:1;">
                                    <tr>
                                        <th>Period</th>
                                        <th>Battery Active</th>
                                        <th>AC Active</th>
                                    </tr>
                                </thead>
                                <tbody id="usageHistoryTableBody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

