                        <h4 style="font-size:.85rem;font-weight:700;color:var(--slate-700);margin-bottom:10px;"><i class="fas fa-bolt"></i> Recent Battery Drains</h4>
                        <div class="table-responsive" style="max-height:250px;overflow-y:auto;margin-bottom:20px;">
                            <table class="table table-sm table-striped table-hover" style="font-size:0.75rem;margin:0;">
