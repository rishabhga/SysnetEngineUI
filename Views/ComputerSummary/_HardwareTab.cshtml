        <div class="tab-content p-3">
            <div id="BatteryHw" class="tab-pane active">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; gap:12px; flex-wrap:wrap;">
                    <div class="hw-category-header hw-cat-green" style="margin-bottom:0; flex:1; min-width:220px;">
                        <div class="hw-category-icon"><i class="fas fa-battery-full"></i></div>
                        <div class="hw-category-text">
                            <div class="hw-category-title">Battery Information</div>
                            <div class="hw-category-desc">Power source &amp; health diagnostics</div>
                        </div>
                    </div>
                    <button id="btnAuditBattery" class="btn btn-sm" style="background:var(--cyan);color:#fff;border:none;font-weight:700;font-size:.76rem;border-radius:var(--radius-md);padding:8px 16px;transition:all .2s;box-shadow:0 4px 12px rgba(0,188,235,.3);white-space:nowrap;">
                        <i class="fas fa-stethoscope"></i> Audit Battery
                    </button>
                </div>
                <div class="cs-info-grid" style="grid-template-columns:repeat(auto-fill,minmax(150px,1fr));margin-bottom:16px;">
                    <div class="cs-info-box"><div class="cs-info-box-label">Manufacturer</div><div class="cs-info-box-value" id="batteryManufacturer">--</div></div>
                    <div class="cs-info-box"><div class="cs-info-box-label">Status</div><div class="cs-info-box-value" id="batteryStatus">--</div></div>
                    <div class="cs-info-box"><div class="cs-info-box-label">Battery Level</div><div class="cs-info-box-value accent" id="batteryLevel">--</div></div>
                    <div class="cs-info-box"><div class="cs-info-box-label">System Type</div><div class="cs-info-box-value" id="batterySystemType">--</div></div>
                    <div class="cs-info-box" style="grid-column:span 2;"><div class="cs-info-box-label">Description</div><div class="cs-info-box-value" style="font-size:.76rem;font-weight:500;" id="batteryDescription">--</div></div>
                </div>
                <div style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--slate-600);display:flex;align-items:center;gap:6px;padding-bottom:8px;">
                    <i class="fas fa-heartbeat" style="color:var(--red);"></i> Real-Time Health Audit
                </div>
                <div id="batteryAuditLoading" style="display:none;padding:18px;text-align:center;color:var(--slate-500);font-size:.82rem;background:var(--slate-50);border-radius:var(--radius-md);border:1px dashed var(--slate-200);">
                    <i class="fas fa-circle-notch fa-spin" style="font-size:1.4rem;color:var(--cyan);margin-bottom:8px;display:block;"></i>
                    Fetching live diagnostics from device, please wait...
                </div>
                <div id="batteryAuditResults" style="display:none;flex-direction:column;gap:12px;">
                    <div class="battery-gauge-container">
                        <div class="battery-gauge-ring">
                            <svg viewBox="0 0 100 100">
                                <circle class="gauge-bg" cx="50" cy="50" r="45"></circle>
                                <circle id="auditHealthCircle" class="gauge-fill" cx="50" cy="50" r="45" stroke="#22c55e" stroke-dasharray="0,283"></circle>
                            </svg>
                            <div class="battery-gauge-percent">
                                <div class="gauge-num" id="auditHealthPercentText">--%</div>
                            </div>
                        </div>
                        <div>
                            <h3 style="font-size:1rem;font-weight:800;color:var(--slate-900);margin:0 0 3px;">Health Score</h3>
                            <p style="font-size:.76rem;color:var(--slate-500);margin:0;font-weight:500;">Real-time diagnostics from the battery controller</p>
                        </div>
                    </div>
                    <div class="cs-info-grid" style="grid-template-columns:repeat(auto-fill,minmax(130px,1fr));">
                        <div class="cs-info-box"><div class="cs-info-box-label">Status</div><div class="cs-info-box-value" id="auditStatus" style="font-size:1rem;">--</div></div>
                        <div class="cs-info-box"><div class="cs-info-box-label">Design Capacity</div><div class="cs-info-box-value"><span id="auditDesignCap" style="font-size:1rem;">--</span> <span style="font-size:.68rem;color:var(--slate-400);">mWh</span></div></div>
                        <div class="cs-info-box"><div class="cs-info-box-label">Full Charge</div><div class="cs-info-box-value"><span id="auditFullCap" style="font-size:1rem;">--</span> <span style="font-size:.68rem;color:var(--slate-400);">mWh</span></div></div>
                        <div class="cs-info-box"><div class="cs-info-box-label">Cycle Count</div><div class="cs-info-box-value" id="auditCycleCount" style="font-size:1rem;">--</div></div>
                    </div>
                </div>
            </div>

