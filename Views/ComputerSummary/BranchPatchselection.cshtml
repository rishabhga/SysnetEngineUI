@model List<PatchDetailsservice>
@{
    ViewData["Title"] = "Third-Party Patch Selection - SYSNET";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-6">
        <div class="flex items-center justify-between">
            <div>
                <div class="flex items-center space-x-3">
                    <a href="javascript:history.back()" class="text-gray-400 hover:text-gray-600 transition-colors">
                        <i class="fas fa-arrow-left text-lg"></i>
                    </a>
                    <div>
                        <h1 class="text-2xl font-bold text-gray-900">Third-Party Patch Selection</h1>
                        <p class="text-sm text-gray-600 mt-1">Select patches to deploy to the selected devices</p>
                    </div>
                </div>
            </div>
            <button id="submitPatchBtn"
                    onclick="goPatchSelection()"
                    disabled
                    class="px-5 py-2.5 text-white rounded-lg font-medium transition-all flex items-center space-x-2 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed"
                    style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                <i class="fas fa-paper-plane"></i>
                <span>Deploy Selected Patches</span>
                <span id="selectedBadge" class="hidden ml-2 px-2 py-0.5 bg-white/20 rounded-full text-xs font-bold">0</span>
            </button>
        </div>
    </div>

    <!-- Stats Bar -->
    <div class="mb-4 grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="bg-white rounded-lg border border-gray-200 p-3 shadow-sm">
            <p class="text-xs text-gray-500 uppercase tracking-wide">Total Patches</p>
            <p class="text-xl font-bold text-gray-900">@(Model?.Count ?? 0)</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-3 shadow-sm">
            <p class="text-xs text-gray-500 uppercase tracking-wide">Available in Repo</p>
            <p class="text-xl font-bold text-green-600">@(Model?.Count(x => x.IsAvailableInRepo) ?? 0)</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-3 shadow-sm">
            <p class="text-xs text-gray-500 uppercase tracking-wide">Unavailable</p>
            <p class="text-xl font-bold text-gray-400">@(Model?.Count(x => !x.IsAvailableInRepo) ?? 0)</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-3 shadow-sm">
            <p class="text-xs text-gray-500 uppercase tracking-wide">Critical</p>
            <p class="text-xl font-bold text-red-600">@(Model?.Count(x => x.Severity == "Critical") ?? 0)</p>
        </div>
    </div>

    <!-- Search + Select All -->
    <div class="mb-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 bg-white rounded-lg border border-gray-200 p-4 shadow-sm">
        <div class="flex-1 flex flex-col sm:flex-row items-start sm:items-center gap-3 w-full">
            <div class="relative flex-1 w-full max-w-sm">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fas fa-search text-gray-400"></i>
                </div>
                <input type="text"
                       id="searchInput"
                       placeholder="Search patches..."
                       class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent text-sm"
                       onkeyup="filterTable()">
            </div>
            <select id="severityFilter" onchange="filterTable()"
                    class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent text-sm">
                <option value="">All Severity</option>
                <option value="Critical">Critical</option>
                <option value="Important">Important</option>
                <option value="Moderate">Moderate</option>
                <option value="Low">Low</option>
            </select>
        </div>
        <label class="flex items-center cursor-pointer whitespace-nowrap">
            <input type="checkbox" id="checkAll" onchange="toggleSelectAll()"
                   class="w-4 h-4 text-cyan-600 border-gray-300 rounded focus:ring-cyan-500">
            <span class="ml-2 text-sm font-medium text-gray-700">Select All Available</span>
        </label>
    </div>

    <!-- Patches Table -->
    @if (Model != null && Model.Any())
    {
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm" id="patchTable">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-200">
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wide">Patch ID</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wide">Bulletin</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wide">Patch Name</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wide">Severity</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wide">Current Ver.</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wide">Available Ver.</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wide">Detected</th>
                            <th class="px-4 py-3 text-center text-xs font-semibold text-gray-600 uppercase tracking-wide w-16">Select</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var item in Model)
                        {
                            var severityClass = item.Severity switch
                            {
                                "Critical" => "bg-red-100 text-red-700",
                                "Important" => "bg-orange-100 text-orange-700",
                                "Moderate" => "bg-yellow-100 text-yellow-700",
                                _ => "bg-gray-100 text-gray-600"
                            };
                            var rowClass = item.IsAvailableInRepo ? "hover:bg-gray-50" : "opacity-50 bg-gray-50";

                            <tr class="patch-row @rowClass transition-colors" data-severity="@item.Severity">
                                <td class="px-4 py-3 text-gray-900 font-mono text-xs">@item.PatchId</td>
                                <td class="px-4 py-3 text-gray-600">@item.Bulletin</td>
                                <td class="px-4 py-3 text-gray-900 font-medium max-w-xs truncate">@item.PatchName</td>
                                <td class="px-4 py-3">
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase @severityClass">@item.Severity</span>
                                </td>
                                <td class="px-4 py-3 text-gray-600 font-mono text-xs">@item.CurrentVersion</td>
                                <td class="px-4 py-3 text-cyan-700 font-mono text-xs font-medium">@item.AvailableVersion</td>
                                <td class="px-4 py-3 text-gray-500 text-xs">@item.DetectedAt.ToString("MMM dd, yyyy")</td>
                                <td class="px-4 py-3 text-center">
                                    @if (item.IsAvailableInRepo)
                                    {
                                        <input type="checkbox" class="rowCheck w-4 h-4 text-cyan-600 border-gray-300 rounded focus:ring-cyan-500"
                                               value="@item.Id" onchange="updateSelection()">
                                    }
                                    else
                                    {
                                        <span class="text-gray-400 text-xs" title="Not available in repo"><i class="fas fa-ban"></i></span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Footer -->
        <div class="mt-4 flex items-center justify-between bg-white rounded-lg border border-gray-200 p-4 shadow-sm">
            <div class="text-sm text-gray-700">
                Showing <span class="font-medium">@Model.Count</span> patches
            </div>
            <div class="flex items-center space-x-2">
                <span class="text-xs text-gray-500"><i class="fas fa-circle text-green-400 mr-1"></i>Available in repo</span>
                <span class="text-xs text-gray-500 ml-3"><i class="fas fa-ban text-gray-300 mr-1"></i>Not available</span>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-20 bg-white rounded-lg border border-gray-200 shadow-sm">
            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-box-open text-gray-400 text-2xl"></i>
            </div>
            <p class="text-gray-500 text-lg">No third-party patches found</p>
            <p class="text-gray-400 text-sm mt-1">There are no missing patches detected for the selected devices</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        function toggleSelectAll() {
            var isChecked = document.getElementById('checkAll').checked;
            document.querySelectorAll('.rowCheck:not(:disabled)').forEach(function(cb) {
                var row = cb.closest('tr');
                if (row && row.style.display !== 'none') {
                    cb.checked = isChecked;
                }
            });
            updateSelection();
        }

        function updateSelection() {
            var checked = document.querySelectorAll('.rowCheck:checked').length;
            var btn = document.getElementById('submitPatchBtn');
            var badge = document.getElementById('selectedBadge');

            btn.disabled = checked === 0;
            badge.textContent = checked;
            badge.classList.toggle('hidden', checked === 0);
        }

        function filterTable() {
            var search = document.getElementById('searchInput').value.toLowerCase();
            var severity = document.getElementById('severityFilter').value;
            var rows = document.querySelectorAll('.patch-row');

            rows.forEach(function(row) {
                var text = row.textContent.toLowerCase();
                var rowSeverity = row.getAttribute('data-severity');
                var matchSearch = !search || text.includes(search);
                var matchSeverity = !severity || rowSeverity === severity;
                row.style.display = (matchSearch && matchSeverity) ? '' : 'none';
            });
        }

        function goPatchSelection() {
            var companyid = '@ViewBag.companyid';
            var groupid = '@ViewBag.groupid';
            var locationid = '@ViewBag.locationid';
            var domainid = '@ViewBag.selectedIds';

            var selectedIds = [];
            document.querySelectorAll('.rowCheck:checked:not(:disabled)').forEach(function(cb) {
                selectedIds.push(cb.value);
            });

            if (selectedIds.length === 0) {
                sysAlert('Please select at least one patch!', 'warning');
                return;
            }

            // Show loading state
            var btn = document.getElementById('submitPatchBtn');
            var originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>Deploying...</span>';

            $.ajax({
                url: '@Url.Action("UpdatePatchselection", "ComputerSummary")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    companyid: parseInt(companyid),
                    groupid: parseInt(groupid),
                    locationid: parseInt(locationid),
                    selectedIds: selectedIds.join(','),
                    deviceIds: domainid
                }),
                success: function(response) {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                    if (response.success) {
                        showToast(response.message || 'Patches deployed successfully!', 'success');
                        // Remove successfully deployed patches from the table immediately
                        document.querySelectorAll('.rowCheck:checked').forEach(function(cb) { 
                            var row = cb.closest('.patch-row');
                            if (row) row.remove();
                        });
                        updateSelection();
                    } else {
                        showToast(response.message || response.error || 'Failed to deploy patches.', 'error');
                    }
                },
                error: function(xhr, status, error) {
                    showToast('Error deploying patches: ' + error, 'error');
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            });
        }

        function showToast(message, type) {
            var existing = document.getElementById('toast-notification');
            if (existing) existing.remove();

            var div = document.createElement('div');
            div.id = 'toast-notification';
            var isError = type === 'error';
            div.className = 'fixed top-4 right-4 px-6 py-4 rounded-xl shadow-2xl text-white transform transition-all duration-300 z-50 flex items-center gap-3 ' + (isError ? 'bg-red-600' : 'bg-green-600');
            div.innerHTML = '<i class="fas ' + (isError ? 'fa-exclamation-circle' : 'fa-check-circle') + ' text-xl"></i><div><h4 class="font-bold text-sm">' + (isError ? 'Error' : 'Success') + '</h4><p class="text-xs opacity-90">' + message + '</p></div>';
            document.body.appendChild(div);

            setTimeout(function() {
                div.classList.add('opacity-0', '-translate-y-2');
                setTimeout(function() { div.remove(); }, 300);
            }, 4000);
        }
    </script>
}
