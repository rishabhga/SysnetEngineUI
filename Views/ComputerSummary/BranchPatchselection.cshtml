@model List<PatchDetailsservice>
@{
    ViewData["Title"] = "Third-Party Patch Selection";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var companyid = ViewBag.companyid?.ToString() ?? "";
    var groupid = ViewBag.groupid?.ToString() ?? "";
    var locationid = ViewBag.locationid?.ToString() ?? "";
    string deviceIds = ViewBag.selectedIds != null ? (string)ViewBag.selectedIds : "";
    string domainids = ViewBag.domainids != null ? (string)ViewBag.domainids : "";
    var domainList = domainids.Split(',').Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().ToList();
}
<style>
    .pm-table {
        border-collapse: separate;
        border-spacing: 0
    }

        .pm-table thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            background: #f8fafc
        }

        .pm-table tbody tr:hover {
            background: #f0f9ff
        }

    .pm-cb {
        accent-color: #00BCEB
    }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border-radius: 999px;
        background: #e0f5fc;
        color: #0369a1;
        font-size: 10px;
        font-weight: 600;
        white-space: nowrap
    }

    #devicesPanel {
        transition: max-height .25s ease,opacity .2s;
        overflow: hidden
    }

        #devicesPanel.collapsed {
            max-height: 0 !important;
            opacity: 0
        }

    /* Rescan button spinner */
    #rescanBtn.scanning i {
        animation: rescanSpin 1s linear infinite;
    }

    @@keyframes rescanSpin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }
</style>

<div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-6 py-3">

    <!-- Header -->
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
            <a href="javascript:history.back()" class="text-gray-400 hover:text-gray-600"><i class="fas fa-arrow-left text-sm"></i></a>
            <div>
                <h1 class="text-base font-bold text-gray-900 flex items-center gap-1.5">
                    <i class="fas fa-cube text-cyan-500 text-sm"></i> Third-Party Patches
                </h1>
                <p class="text-[10px] text-gray-500">
                    Deploying to
                    <span class="font-semibold text-cyan-600">@domainList.Count device@(domainList.Count == 1 ? "" : "s")</span>
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <!-- Rescan Button -->
            <button id="rescanBtn" onclick="rescanDevices()"
                    class="px-3 py-1.5 bg-amber-50 border border-amber-300 text-amber-700 rounded-md text-xs font-semibold flex items-center gap-1.5 hover:bg-amber-100 transition-colors"
                    title="Re-scan all selected devices for missing patches">
                <i class="fas fa-sync-alt text-[10px]"></i>
                <span>Rescan</span>
            </button>

            <!-- Deploy Button -->
            <button id="submitPatchBtn" onclick="deployPatches()" disabled
                    class="px-3 py-1.5 text-white rounded-md text-xs font-semibold flex items-center gap-1.5 shadow-sm disabled:opacity-40 disabled:cursor-not-allowed"
                    style="background:linear-gradient(135deg,#00BCEB,#0096BE)">
                <i class="fas fa-paper-plane text-[10px]"></i>
                <span>Deploy</span>
                <span id="selectedBadge" class="hidden px-1.5 py-0.5 bg-white/25 rounded-full text-[9px] font-bold">0</span>
            </button>
        </div>
    </div>

    <!-- Target Devices Accordion -->
    @if (domainList.Any())
    {
        <div class="mb-3 bg-white border border-cyan-100 rounded-md shadow-sm">
            <button onclick="togglePanel()" class="w-full flex items-center justify-between px-3 py-2 hover:bg-cyan-50 rounded-md transition-colors">
                <span class="flex items-center gap-2 text-[11px] font-semibold text-cyan-700">
                    <i class="fas fa-desktop text-[10px]"></i>
                    Target Devices &nbsp;<span class="px-1.5 py-0.5 bg-cyan-100 rounded-full text-[9px]">@domainList.Count</span>
                </span>
                <i id="panelIcon" class="fas fa-chevron-down text-[9px] text-cyan-400 transition-transform"></i>
            </button>
            <div id="devicesPanel" style="max-height:120px">
                <div class="px-3 pb-2 flex flex-wrap gap-1.5">
                    @foreach (var d in domainList)
                    {
                        <span class="chip"><i class="fas fa-desktop text-[8px]"></i> @d</span>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Rescan result notification (Removed) -->

    <!-- Stats -->
    <div class="mb-3 grid grid-cols-2 sm:grid-cols-4 gap-2">
        <div class="bg-white rounded-md border border-gray-200 p-2.5 shadow-sm">
            <p class="text-[9px] text-gray-500 uppercase font-medium">Total</p>
            <p id="totalCount" class="text-lg font-bold text-gray-900 leading-none mt-1">@(Model?.Count ?? 0)</p>
        </div>
        <div class="bg-white rounded-md border border-gray-200 p-2.5 shadow-sm">
            <p class="text-[9px] text-gray-500 uppercase font-medium">In Repo</p>
            <p id="inRepoCount" class="text-lg font-bold text-emerald-600 leading-none mt-1">@(((IEnumerable<PatchDetailsservice>)Model)?.Count(x => x.IsAvailableInRepo) ?? 0)</p>
        </div>
        <div class="bg-white rounded-md border border-gray-200 p-2.5 shadow-sm">
            <p class="text-[9px] text-gray-500 uppercase font-medium">Not in Repo</p>
            <p id="notInRepoCount" class="text-lg font-bold text-gray-400 leading-none mt-1">@(((IEnumerable<PatchDetailsservice>)Model)?.Count(x => !x.IsAvailableInRepo) ?? 0)</p>
        </div>
        <div class="bg-white rounded-md border border-gray-200 p-2.5 shadow-sm">
            <p class="text-[9px] text-gray-500 uppercase font-medium">Critical</p>
            <p id="criticalCount" class="text-lg font-bold text-red-600 leading-none mt-1">@(((IEnumerable<PatchDetailsservice>)Model)?.Count(x => x.Severity == "Critical") ?? 0)</p>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="mb-2 flex flex-wrap items-center gap-2 bg-white rounded-md border border-gray-200 px-3 py-2 shadow-sm">
        <div class="relative flex-1 min-w-[160px] max-w-xs">
            <i class="fas fa-search absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400 text-[10px]"></i>
            <input id="searchInput" type="text" placeholder="Search patches..."
                   class="w-full pl-7 pr-2 py-1.5 border border-gray-300 rounded text-xs focus:outline-none focus:ring-1 focus:ring-cyan-400"
                   oninput="filterTable()">
        </div>
        <select id="severityFilter" onchange="filterTable()"
                class="px-2 py-1.5 border border-gray-300 rounded text-xs focus:outline-none focus:ring-1 focus:ring-cyan-400">
            <option value="">All Severity</option>
            <option value="Critical">Critical</option>
            <option value="Important">Important</option>
            <option value="Moderate">Moderate</option>
            <option value="Low">Low</option>
        </select>
        <label class="flex items-center gap-1.5 ml-auto cursor-pointer select-none">
            <input type="checkbox" id="checkAll" onchange="toggleSelectAll()" class="pm-cb w-3.5 h-3.5 rounded">
            <span class="text-[11px] text-gray-600 font-medium">Select all available</span>
        </label>
    </div>

    <div id="activeDeploymentsPanel" class="hidden mb-3 bg-slate-900 text-slate-100 rounded-md border border-slate-800 p-3 shadow-md">
        <div class="flex items-center justify-between border-b border-slate-800 pb-2 mb-2">
            <span class="text-xs font-semibold text-cyan-400 flex items-center gap-1.5">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
                </span>
                Active Deployments Progress
            </span>
            <span id="activeProgressPct" class="text-[10px] font-mono bg-slate-800 text-slate-400 px-1.5 py-0.5 rounded">0%</span>
        </div>
        <div id="activeDeploymentsList" class="space-y-1.5 max-h-36 overflow-y-auto font-mono text-[10px] divide-y divide-slate-800/50">
        </div>
    </div>

    <!-- Table -->
    @if (Model != null && Model.Any())
    {
        <div class="bg-white rounded-md border border-gray-200 shadow-sm overflow-hidden relative">
            <div id="tableLoaderOverlay" class="hidden absolute inset-0 bg-white/70 backdrop-blur-[2px] z-10 flex flex-col items-center justify-center">
                <i class="fas fa-circle-notch fa-spin text-3xl text-cyan-500 mb-2"></i>
                <span class="text-[11px] font-semibold text-gray-700 bg-white px-3 py-1 rounded-full shadow-sm border border-gray-100">Waiting for data...</span>
            </div>
            <div class="overflow-x-auto" style="max-height:calc(100vh - 360px);overflow-y:auto">
                <table class="pm-table w-full text-xs" style="table-layout: fixed;">
                    <thead>
                        <tr class="border-b border-gray-200 text-[9px] text-gray-500 uppercase">
                            <th class="pl-3 pr-2 py-2" style="width: 40px;"></th>
                            <th class="px-3 py-2 text-left font-semibold" style="width: 80px;">Patch ID</th>
                            <th class="px-3 py-2 text-left font-semibold" style="width: 100px;">Vendor</th>
                            <th class="px-3 py-2 text-left font-semibold">Patch Name</th>
                            <th class="px-3 py-2 text-left font-semibold" style="width: 90px;">Severity</th>
                            <th class="px-3 py-2 text-left font-semibold" style="width: 100px;">Current</th>
                            <th class="px-3 py-2 text-left font-semibold" style="width: 100px;">Available</th>
                            <th class="px-3 py-2 text-left font-semibold" style="width: 110px;">Detected</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var item in Model)
                        {
                            var sc = item.Severity switch
                            {
                                "Critical" => "bg-red-50 text-red-700 border border-red-200",
                                "Important" => "bg-orange-50 text-orange-700 border border-orange-200",
                                "Moderate" => "bg-yellow-50 text-yellow-700 border border-yellow-200",
                                _ => "bg-gray-100 text-gray-600"
                            };
                            <tr class="patch-row @(item.IsAvailableInRepo ? "hover:bg-gray-50" : "opacity-50 bg-gray-50") transition-colors" data-severity="@item.Severity" data-patchname="@item.PatchName" data-inrepo="@(item.IsAvailableInRepo ? "true" : "false")">
                                <td class="pl-3 pr-2 py-2 text-center">
                                    @if (item.IsAvailableInRepo)
                                    {
                                        <input type="checkbox" class="rowCheck pm-cb w-3.5 h-3.5 rounded" value="@item.Id" onchange="updateSel()">
                                    }
                                    else
                                    {
                                        <i class="fas fa-ban text-gray-300 text-[10px]" title="Not in repo"></i>
                                    }
                                </td>
                                <td class="px-3 py-2 font-mono text-[10px] text-gray-600 truncate">@item.PatchId</td>
                                <td class="px-3 py-2 text-gray-500 truncate">@item.Vendor</td>
                                <td class="px-3 py-2 patch-name-cell">
                                    <div class="text-gray-900 font-medium truncate max-w-md" title="@item.PatchName">@item.PatchName</div>
                                    @if (!string.IsNullOrEmpty(item.PatchDescription))
                                    {
                                        <div class="text-[9px] text-gray-400 truncate max-w-md mt-0.5" title="@item.PatchDescription">@item.PatchDescription</div>
                                    }
                                </td>
                                <td class="px-3 py-2"><span class="px-1.5 py-0.5 rounded-full text-[8px] font-bold @sc">@item.Severity</span></td>
                                <td class="px-3 py-2 font-mono text-[10px] text-gray-400 truncate">@item.CurrentVersion</td>
                                <td class="px-3 py-2 font-mono text-[10px] text-cyan-600 font-semibold truncate">@item.AvailableVersion</td>
                                <td class="px-3 py-2 text-[10px] text-gray-400 truncate">@item.DetectedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="flex items-center justify-between px-3 py-2 border-t border-gray-100 bg-gray-50">
                <span class="text-[10px] text-gray-500"><span id="visCount">@Model.Count</span> patches</span>
                <div class="flex items-center gap-3 text-[9px] text-gray-500">
                    <span><i class="fas fa-circle text-emerald-400 mr-0.5"></i>In repo</span>
                    <span><i class="fas fa-ban text-gray-300 mr-0.5"></i>Not available</span>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-16 bg-white rounded-md border border-gray-200 shadow-sm">
            <i class="fas fa-box-open text-4xl text-gray-200 mb-3"></i>
            <p class="text-gray-500 text-sm font-medium">No third-party patches found</p>
            <p class="text-[10px] text-gray-400 mt-1">Try rescanning the selected devices to refresh the patch list.</p>
            <button onclick="rescanDevices()"
                    class="mt-3 px-4 py-2 bg-amber-50 border border-amber-300 text-amber-700 rounded-md text-xs font-semibold inline-flex items-center gap-2 hover:bg-amber-100 transition-colors">
                <i class="fas fa-sync-alt"></i> Rescan Devices
            </button>
        </div>
    }
</div>

@section Scripts {
    <script>
        const PAGE_TYPE = '@(ViewData["Title"].ToString().Contains("Windows") ? "WinPatch" : "ThirdPartyPatch")';
        const DOMAIN_IDS = '@domainids'.split(',').map(s => s.trim()).filter(s => !!s);
        let activeActions = {};

        const DEPLOY_STORAGE_KEY  = `BranchPatch_Deployments_${'@companyid'}_${'@groupid'}_${'@locationid'}`;
        const ACTIONS_STORAGE_KEY = `BranchPatch_Actions_${'@companyid'}_${'@groupid'}_${'@locationid'}`;

        function saveDeploymentsToStorage() {
            localStorage.setItem(DEPLOY_STORAGE_KEY, JSON.stringify(activeDeployments));
            localStorage.setItem(ACTIONS_STORAGE_KEY, JSON.stringify(activeActions));
        }

        function registerAction(ids) {
            activeActions[ids] = true;
            saveDeploymentsToStorage();
            updateButtonState();
        }

        function unregisterAction(ids) {
            delete activeActions[ids];
            saveDeploymentsToStorage();
            updateButtonState();
        }

        function updateButtonState() {
            const btn = document.getElementById('submitPatchBtn');
            const hasActive = Object.keys(activeActions).length > 0;
            if (hasActive) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin text-[10px]"></i> <span>Deploying...</span>';
            } else {
                btn.disabled = document.querySelectorAll('.rowCheck:checked').length === 0;
                btn.innerHTML = '<i class="fas fa-paper-plane text-[10px]"></i> <span>Deploy</span>';
            }
        }

        // ── Rescan all target devices ──────────────────────────────
        function rescanDevices() {
            if (DOMAIN_IDS.length === 0) {
                sysAlert('No devices to rescan.', 'warning');
                return;
            }

            const btn = document.getElementById('rescanBtn');
            btn.classList.add('scanning');
            btn.disabled = true;
            
            const overlay = document.getElementById('tableLoaderOverlay');
            if (overlay) overlay.classList.remove('hidden');

            let succeeded = 0;

            const promises = DOMAIN_IDS.map(domain =>
                fetch('@Url.Action("ReScanPatches", "ComputerSummary")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ClientId: domain })
                })
                .then(r => r.json())
                .then(res => { if (res.success) succeeded++; })
                .catch(() => {})
            );

            Promise.all(promises).then(() => {
                if (succeeded === 0) {
                    btn.classList.remove('scanning');
                    btn.disabled = false;
                    if (overlay) overlay.classList.add('hidden');
                    sysAlert('Rescan command could not be delivered — devices may be offline.', 'error');
                } else {
                    sysAlert(`Rescan sent to ${succeeded}/${DOMAIN_IDS.length} device(s). Waiting for data...`, 'success');
                }
            });
        }

        // ── SignalR Hub ───────────────────────────────────────────
        let hubConnection = null;
        let machineNames = {};
        let activeDeployments = {};

        function updateProgressPercent() {
            const keys = Object.keys(activeDeployments);
            if (!keys.length) return;
            const completed = keys.filter(k => activeDeployments[k].status !== 'In Progress').length;
            const pct = Math.round((completed / keys.length) * 100);
            document.getElementById('activeProgressPct').textContent = `${pct}%`;
        }

        async function initHub() {
            const apiBase = (window.SYSNET_CONTEXT && window.SYSNET_CONTEXT.apiBaseUrl) || '';
            hubConnection = new signalR.HubConnectionBuilder()
                .withUrl(`${apiBase}/scanHub?clientId=BranchPatchTP&computerName=WebPortal`)
                .withAutomaticReconnect()
                .build();

            hubConnection.on('SendinstallReasultUpdate', (computerName, softwareName, isSuccess) => {
                const upperComp = (computerName || '').trim().toUpperCase();
                const upperSoft = (softwareName || '').trim().toUpperCase();

                let matchedKey = null;
                for (const key in activeDeployments) {
                    const [devPart, softPart] = key.split('_');
                    if (softPart === upperSoft) {
                        const devNameOnly = devPart.split('.')[0];
                        if (devPart === upperComp || devNameOnly === upperComp || upperComp.split('.')[0] === devNameOnly) {
                            matchedKey = key;
                            break;
                        }
                    }
                }

                if (matchedKey) {
                    const entry = activeDeployments[matchedKey];
                    entry.status = isSuccess ? 'Success' : 'Failed';
                    saveDeploymentsToStorage();

                    const consoleElId = `console_${matchedKey.replace(/[^a-zA-Z0-9]/g, '_')}`;
                    const consoleEl = document.getElementById(consoleElId);
                    if (consoleEl) {
                        const statusBadge = consoleEl.querySelector('.status-badge');
                        if (isSuccess) {
                            consoleEl.classList.replace('text-slate-300', 'text-emerald-400');
                            statusBadge.className = 'status-badge flex items-center gap-1 text-emerald-400 font-bold';
                            statusBadge.innerHTML = '<i class="fas fa-check text-[8px]"></i> COMPLETED';
                        } else {
                            consoleEl.classList.replace('text-slate-300', 'text-rose-400');
                            statusBadge.className = 'status-badge flex items-center gap-1 text-rose-400 font-bold';
                            statusBadge.innerHTML = '<i class="fas fa-times text-[8px]"></i> FAILED';
                        }
                    }

                    document.querySelectorAll(`.patch-row[data-patchname="${softwareName}"]`).forEach(row => {
                        const tdName = row.querySelector('.patch-name-cell');
                        if (tdName) {
                            const badge = tdName.querySelector('.deployment-row-status');
                            if (badge) {
                                if (isSuccess) {
                                    badge.className = 'deployment-row-status inline-flex items-center gap-1 ml-2 px-1.5 py-0.5 rounded text-[8px] font-medium bg-green-50 text-green-700 border border-green-200';
                                    badge.innerHTML = '<i class="fas fa-check"></i> Completed';
                                    setTimeout(() => {
                                        row.style.transition = 'all 0.5s ease';
                                        row.style.opacity = '0';
                                        setTimeout(() => { row.remove(); updateCounts(); }, 500);
                                    }, 2000);
                                } else {
                                    badge.className = 'deployment-row-status inline-flex items-center gap-1 ml-2 px-1.5 py-0.5 rounded text-[8px] font-medium bg-red-50 text-red-700 border border-red-200';
                                    badge.innerHTML = '<i class="fas fa-times"></i> Failed';
                                }
                            }
                        }
                    });

                    updateProgressPercent();

                    const keys = Object.keys(activeDeployments);
                    const completedCount = keys.filter(k => activeDeployments[k].status !== 'In Progress').length;
                    if (completedCount === keys.length) {
                        const successes = keys.filter(k => activeDeployments[k].status === 'Success').length;
                        sysAlert(`Deployment Completed! Successfully installed ${successes}/${keys.length} updates.`, successes === keys.length ? 'success' : 'warning');
                        setTimeout(() => {
                            document.getElementById('activeDeploymentsPanel').classList.add('hidden');
                            localStorage.removeItem(DEPLOY_STORAGE_KEY);
                            localStorage.removeItem(ACTIONS_STORAGE_KEY);
                        }, 5000);
                        Object.keys(activeActions).forEach(actKey => unregisterAction(actKey));
                    }
                } else {
                    const isMatch = DOMAIN_IDS.some(d => {
                        const cleanD = (d || '').trim().toUpperCase();
                        const cleanMachine = (machineNames[d] || '').trim().toUpperCase();
                        return cleanD === upperComp || (cleanMachine && cleanMachine === upperComp);
                    });

                    if (isMatch) {
                        sysAlert(`Deployment to ${computerName} ${isSuccess ? 'Successful' : 'Failed'}: ${softwareName}`, isSuccess ? 'success' : 'error');
                        if (isSuccess) {
                            document.querySelectorAll(`.patch-row[data-patchname="${softwareName}"]`).forEach(row => {
                                row.style.transition = 'all 0.5s ease';
                                row.style.opacity = '0';
                                setTimeout(() => { row.remove(); updateCounts(); }, 500);
                            });
                        }
                        Object.keys(activeActions).forEach(actKey => unregisterAction(actKey));
                    }
                }
            });

            hubConnection.on('PatchDataUpdated', function(domain, success, message) {
                if (DOMAIN_IDS.some(d => d.trim().toUpperCase() === (domain || '').trim().toUpperCase())) {
                    if(success) {
                        sysAlert(`Data updated successfully for ${domain}. Refreshing list...`, 'success');
                        setTimeout(() => window.location.reload(), 1500);
                    } else {
                        sysAlert(`Failed to update data for ${domain}: ${message}`, 'error');
                        const overlay = document.getElementById('tableLoaderOverlay');
                        if(overlay) overlay.classList.add('hidden');
                        const btn = document.getElementById('rescanBtn');
                        btn.classList.remove('scanning');
                        btn.disabled = false;
                    }
                }
            });

            try {
                await hubConnection.start();
            } catch (err) {
                console.error("SignalR Hub Error:", err);
            }
        }

        async function resolveMachineNames() {
            for (const domain of DOMAIN_IDS) {
                try {
                    const res = await $.get(`/ComputerSummary/GetUserDetailsJson?domain=${domain}`);
                    if (res.success) machineNames[domain] = res.domainName;
                } catch (e) {}
            }
        }

        let panelOpen = true;
        function togglePanel() {
            panelOpen = !panelOpen;
            document.getElementById('devicesPanel').classList.toggle('collapsed', !panelOpen);
            document.getElementById('panelIcon').style.transform = panelOpen ? '' : 'rotate(-90deg)';
        }

        function updateSel() {
            if (Object.keys(activeActions).length > 0) return;
            const n = document.querySelectorAll('.rowCheck:checked').length;
            const btn = document.getElementById('submitPatchBtn');
            if (btn) btn.disabled = n === 0;
            const b = document.getElementById('selectedBadge');
            if (b) { b.textContent = n; b.classList.toggle('hidden', n === 0); }

            const all = Array.from(document.querySelectorAll('.rowCheck')).filter(c => c.closest('tr').style.display !== 'none');
            const ca = document.getElementById('checkAll');
            const cn = all.filter(c => c.checked).length;
            if (ca) {
                ca.checked = cn > 0 && cn === all.length;
                ca.indeterminate = cn > 0 && cn < all.length;
            }
        }

        function toggleSelectAll() {
            const v = document.getElementById('checkAll').checked;
            document.querySelectorAll('.patch-row').forEach(r => {
                if (r.style.display !== 'none') { const c = r.querySelector('.rowCheck'); if (c) c.checked = v; }
            });
            updateSel();
        }

        function filterTable() {
            const s = document.getElementById('searchInput').value.toLowerCase();
            const sev = document.getElementById('severityFilter').value;
            let n = 0;
            document.querySelectorAll('.patch-row').forEach(r => {
                const show = (!s || r.textContent.toLowerCase().includes(s)) && (!sev || r.dataset.severity === sev);
                r.style.display = show ? '' : 'none'; if (show) n++;
            });
            document.getElementById('visCount').textContent = n;
            updateSel();
        }

        function restoreActiveDeployments() {
            const savedDeploy  = localStorage.getItem(DEPLOY_STORAGE_KEY);
            const savedActions = localStorage.getItem(ACTIONS_STORAGE_KEY);

            if (savedDeploy) {
                try { activeDeployments = JSON.parse(savedDeploy); }
                catch(e) { activeDeployments = {}; }
            }
            if (savedActions) {
                try { activeActions = JSON.parse(savedActions); }
                catch(e) { activeActions = {}; }
            }

            // Prune stuck deployments (older than 15 minutes)
            const now = Date.now();
            let dirty = false;
            for (const key in activeDeployments) {
                const entry = activeDeployments[key];
                if (!entry.timestamp || (now - entry.timestamp > 900000)) {
                    delete activeDeployments[key];
                    dirty = true;
                }
            }
            if (dirty) {
                if (Object.keys(activeDeployments).length === 0) {
                    activeDeployments = {};
                    activeActions = {};
                }
                saveDeploymentsToStorage();
            }

            const keys = Object.keys(activeDeployments);
            if (keys.length > 0) {
                const panel = document.getElementById('activeDeploymentsPanel');
                if (panel) panel.classList.remove('hidden');

                const listEl = document.getElementById('activeDeploymentsList');
                if (listEl) listEl.innerHTML = '';

                keys.forEach(k => {
                    const entry = activeDeployments[k];
                    const itemEl = document.createElement('div');
                    itemEl.id = `console_${k.replace(/[^a-zA-Z0-9]/g, '_')}`;

                    let badgeHtml = '';
                    if (entry.status === 'In Progress') {
                        itemEl.className = 'py-1 flex items-center justify-between text-slate-300';
                        badgeHtml = `<span class="status-badge flex items-center gap-1 text-cyan-400 font-semibold animate-pulse">
                            <i class="fas fa-circle-notch fa-spin text-[8px]"></i> IN PROCESS</span>`;
                        document.querySelectorAll(`.patch-row[data-patchname="${entry.patchName}"]`).forEach(row => {
                            const tdName = row.querySelector('.patch-name-cell');
                            if (tdName) {
                                const existing = tdName.querySelector('.deployment-row-status');
                                if (existing) existing.remove();
                                const badge = document.createElement('span');
                                badge.className = 'deployment-row-status inline-flex items-center gap-1 ml-2 px-1.5 py-0.5 rounded text-[8px] font-medium bg-blue-50 text-blue-600 border border-blue-100 animate-pulse';
                                badge.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Installing';
                                tdName.appendChild(badge);
                            }
                        });
                    } else if (entry.status === 'Success') {
                        itemEl.className = 'py-1 flex items-center justify-between text-emerald-400';
                        badgeHtml = `<span class="status-badge flex items-center gap-1 text-emerald-400 font-bold">
                            <i class="fas fa-check text-[8px]"></i> COMPLETED</span>`;
                    } else if (entry.status === 'Failed') {
                        itemEl.className = 'py-1 flex items-center justify-between text-rose-400';
                        badgeHtml = `<span class="status-badge flex items-center gap-1 text-rose-400 font-bold">
                            <i class="fas fa-times text-[8px]"></i> FAILED</span>`;
                    } else {
                        itemEl.className = 'py-1 flex items-center justify-between text-slate-500';
                        badgeHtml = `<span class="status-badge flex items-center gap-1 text-slate-500 font-bold">
                            <i class="fas fa-ban text-[8px]"></i> OFFLINE</span>`;
                    }

                    itemEl.innerHTML = `<div class="flex items-center gap-2 truncate">
                        <span class="text-cyan-400 font-bold">[${entry.device}]</span>
                        <span class="text-slate-400 truncate max-w-sm" title="${entry.patchName}">${entry.patchName}</span>
                    </div>${badgeHtml}`;
                    if (listEl) listEl.appendChild(itemEl);
                });

                updateProgressPercent();
                updateButtonState();

                const completedCount = keys.filter(k => activeDeployments[k].status !== 'In Progress').length;
                if (completedCount === keys.length) {
                    setTimeout(() => {
                        if (panel) panel.classList.add('hidden');
                        localStorage.removeItem(DEPLOY_STORAGE_KEY);
                        localStorage.removeItem(ACTIONS_STORAGE_KEY);
                    }, 5000);
                }
            }
        }

        function deployPatches() {
            const selectedChecks = Array.from(document.querySelectorAll('.rowCheck:checked'));
            if (!selectedChecks.length) { sysAlert('Please select at least one patch!', 'warning'); return; }

            const ids   = selectedChecks.map(c => c.value);
            const idStr = ids.join(',');
            registerAction(idStr);

            const selStorageKey = `BranchPatch_Selection_${'@companyid'}_${'@groupid'}_${'@locationid'}`;
            localStorage.removeItem(selStorageKey + '_Ids');
            localStorage.removeItem(selStorageKey + '_Domains');
            localStorage.removeItem(selStorageKey + '_Names');

            activeDeployments = {};
            const listEl = document.getElementById('activeDeploymentsList');
            listEl.innerHTML = '';
            document.getElementById('activeDeploymentsPanel').classList.remove('hidden');

            selectedChecks.forEach(c => {
                const row = c.closest('tr');
                const patchName = row.dataset.patchname;

                const tdName = row.querySelector('.patch-name-cell');
                if (tdName) {
                    const existing = tdName.querySelector('.deployment-row-status');
                    if (existing) existing.remove();
                    const badge = document.createElement('span');
                    badge.className = 'deployment-row-status inline-flex items-center gap-1 ml-2 px-1.5 py-0.5 rounded text-[8px] font-medium bg-blue-50 text-blue-600 border border-blue-100 animate-pulse';
                    badge.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Installing';
                    tdName.appendChild(badge);
                }

                DOMAIN_IDS.forEach(device => {
                    const cleanDev = device.trim().toUpperCase();
                    const key = `${cleanDev}_${patchName.trim().toUpperCase()}`;
                    activeDeployments[key] = { device: device.trim(), patchName: patchName.trim(), status: 'In Progress', timestamp: Date.now() };

                    const itemEl = document.createElement('div');
                    itemEl.id = `console_${key.replace(/[^a-zA-Z0-9]/g, '_')}`;
                    itemEl.className = 'py-1 flex items-center justify-between text-slate-300';
                    itemEl.innerHTML = `<div class="flex items-center gap-2 truncate">
                        <span class="text-cyan-400 font-bold">[${device.trim()}]</span>
                        <span class="text-slate-400 truncate max-w-sm" title="${patchName}">${patchName}</span>
                    </div>
                    <span class="status-badge flex items-center gap-1 text-cyan-400 font-semibold animate-pulse">
                        <i class="fas fa-circle-notch fa-spin text-[8px]"></i> IN PROCESS</span>`;
                    listEl.appendChild(itemEl);
                });
            });

            updateProgressPercent();
            saveDeploymentsToStorage();

            const safetyTimer = setTimeout(() => {
                if (activeActions[idStr]) {
                    unregisterAction(idStr);
                    sysAlert('Deploy request safety timeout reached. Check device connectivity.', 'warning');
                }
            }, 10 * 60 * 1000);

            $.ajax({
                url: '@Url.Action("UpdatePatchselection", "ComputerSummary")',
                type: 'POST',
                timeout: 60000,
                contentType: 'application/json',
                data: JSON.stringify({
                    companyid:  parseInt('@companyid') || 0,
                    groupid:    parseInt('@groupid') || 0,
                    locationid: parseInt('@locationid') || 0,
                    selectedIds: idStr,
                    deviceIds:  '@deviceIds',
                    domainids:  '@domainids'
                }),
                success: function(res) {
                    clearTimeout(safetyTimer);
                    if (res.success) {
                        var targetComp = DOMAIN_IDS.length > 0 ? DOMAIN_IDS.join(', ') : 'the selected device(s)';
                        var msg = `Deployment command sent! 🚀 Installation started on ${targetComp}.`;
                        if (res.offlineClients && res.offlineClients.length > 0) {
                            msg += ` (${res.offlineClients.length} device(s) offline.)`;
                            res.offlineClients.forEach(offDev => {
                                const cleanOff = offDev.trim().toUpperCase();
                                selectedChecks.forEach(c => {
                                    const row = c.closest('tr');
                                    const patchName = row.dataset.patchname;
                                    const key = `${cleanOff}_${patchName.trim().toUpperCase()}`;
                                    if (activeDeployments[key]) {
                                        activeDeployments[key].status = 'Failed';
                                        const consoleEl = document.getElementById(`console_${key.replace(/[^a-zA-Z0-9]/g, '_')}`);
                                        if (consoleEl) {
                                            consoleEl.classList.replace('text-slate-300', 'text-slate-500');
                                            const sb = consoleEl.querySelector('.status-badge');
                                            sb.className = 'status-badge flex items-center gap-1 text-slate-500 font-bold';
                                            sb.innerHTML = '<i class="fas fa-ban text-[8px]"></i> OFFLINE';
                                        }
                                    }
                                });
                            });
                            updateProgressPercent();
                            saveDeploymentsToStorage();
                        }
                        sysAlert(msg, 'success');
                    } else {
                        sysAlert(res.message || res.error || 'Deployment failed.', 'error');
                        document.getElementById('activeDeploymentsPanel').classList.add('hidden');
                        unregisterAction(idStr);
                        localStorage.removeItem(DEPLOY_STORAGE_KEY);
                        localStorage.removeItem(ACTIONS_STORAGE_KEY);
                    }
                },
                error: function(xhr) {
                    clearTimeout(safetyTimer);
                    const errMsg = xhr.status === 0 ? 'Connection lost.' :
                                   xhr.status === 408 ? 'Request timed out.' :
                                   `Server error (${xhr.status})`;
                    sysAlert(errMsg, 'error');
                    document.getElementById('activeDeploymentsPanel').classList.add('hidden');
                    unregisterAction(idStr);
                    localStorage.removeItem(DEPLOY_STORAGE_KEY);
                    localStorage.removeItem(ACTIONS_STORAGE_KEY);
                }
            });
        }

        function updateCounts() {
            const rows     = Array.from(document.querySelectorAll('.patch-row'));
            const total    = rows.length;
            const inRepo   = rows.filter(r => r.dataset.inrepo === 'true').length;
            const notInRepo = total - inRepo;
            const critical = rows.filter(r => r.dataset.severity === 'Critical').length;

            const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
            set('totalCount', total);
            set('inRepoCount', inRepo);
            set('notInRepoCount', notInRepo);
            set('criticalCount', critical);
            set('visCount', total);

            updateButtonState();
            // NOTE: Intentionally NOT auto-reloading on 0 to avoid infinite loop
        }

        document.addEventListener('DOMContentLoaded', () => {
            initHub().then(() => restoreActiveDeployments());
            resolveMachineNames();
            updateButtonState();
            filterTable();
        });
    </script>
}
