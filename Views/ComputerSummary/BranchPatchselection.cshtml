@model List<PatchDetailsservice>

<!DOCTYPE html>
<html>
<head>

    
    <link href="~/css/font-awesome.css" rel="stylesheet" type="text/css" />
    <link href="~/css/font-awesome.min.css" rel="stylesheet" type="text/css" />

    <link href="~/css/prettify.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" />

    <link rel="stylesheet" type="text/css" href="~/css/Custom.css" />
    <link href="~/css/datepicker.css" rel="stylesheet" />
    <script src="js/bootbox.min.js"></script>
    <script src="js/bootstrap.min.js"></script>
    <script src="js/bootstrap-datepicker.min.js"></script>
    <link href="../CSS/font-awesome.min.css" rel="stylesheet" />

    <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
    <link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <style>
        .margin {
            margin: 30px 20px 10px 20px;
        }

        .dataTables_length {
            display: none !important;
        }

        .dataTables_filter {
            display: none !important;
        }

        .no-footer {
            border-radius: 5px;
            border: 1px solid rgb(225, 227, 232);
            background-color: #f2f4f7;
        }

        .dataTables_info {
            margin-left: 10px;
            font-size: 12px;
        }

        .paginate_button {
            font-size: 12px;
        }

        /* #example_info {
                                    display: none !important;
                                }

                                #example_paginate {
                                    display: none !important;
                                }*/

        .bhead {
            text-align: center;
            padding: 10px;
            background-color: #f2f4f7;
        }

        .table_head_color {
            background-color: #f2f4f7;
            /*border-radius: 5px;
                                    border: 1px solid rgb(225, 227, 232);*/
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 10px 10px;
        }

        .status-indicator {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            margin-left: 10px;
        }

        .active {
            background-color: green;
        }

        .inactive {
            background-color: red;
        }

        .enabled-row {
            background-color: #d4edda !important; /* light green */
        }

        .disabled-row {
            background-color: #f8f9fa !important; /* light grey */
            opacity: 0.6;
        }
    </style>
</head>

<body>

    
    <div style="clear: both;"></div>
    <div class="margin">
        <div id="datatablesholder1">
            <button class="btn btn-primary" style="float:right;" onclick="goPatchSelection()">
                Submit Selected Patches
            </button>
            <br />
            <table class="table table-bordered font-monospace" id="locationTable">
                <thead>
                    <tr>
                        <th>PatchId</th>
                        <th>Bulletin</th>
                        <th>Patch Name</th>
                      @*   <th>Patch Description</th>
                        <th>Vendor</th> *@
                        <th>Severity</th>
                        <th>Current Version</th>
                        <th>Available Version</th>
                       @*  <th>Source</th> *@
                        <th>DetectedAt</th>
                        <th><input type="checkbox" id="checkAll">Select patch</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model)
                    {



                        <tr class="@(item.IsAvailableInRepo ? "enabled-row" : "disabled-row")">
                            <td>@item.PatchId  </td>
                            <td>@item.Bulletin</td>
                            <td>@item.PatchName</td> 
                           @*  <td>@item.PatchDescription</td>
                            <td>@item.Vendor</td> *@
                            <td>@item.Severity</td>
                            <td>@item.CurrentVersion</td>
                            <td>@item.AvailableVersion</td>
                           @*  <td>@item.Source</td> *@
                            <td>@item.DetectedAt</td>
                            <td>
                                <input type="checkbox"
                                       class="rowCheck"
                                       value="@item.Id"
                                       @(item.IsAvailableInRepo ? "" : "disabled") />
                            </td>

                           @*  <td class="btn btn-success" @(item.IsAvailableInRepo ? "" : "disabled")><input type="checkbox" class="rowCheck" value="@item.PatchId"></td> *@

                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
    <script src="js/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <script>

        // $('#checkAll').click(function () {
        //     $('.rowCheck').prop('checked', this.checked);
        //  });
                 // Select All checkbox
        $("#checkAll").on("change", function () {
            $(".rowCheck:not(:disabled)").prop("checked", $(this).prop("checked"));
        });


    </script>
      <script>
            function goPatchSelection() {

                var companyid = '@ViewBag.companyid';
                var groupid = '@ViewBag.groupid';
                var locationid = '@ViewBag.locationid';
                var domainid = '@ViewBag.selectedIds';

                var selectedIds = [];

                $(".rowCheck:checked:not(:disabled)").each(function () {
                    selectedIds.push($(this).val());
                });

                if (selectedIds.length === 0) {
                    alert("Please select at least one patch!");
                    return;
                }

                var idParam = selectedIds.join(',');

                window.location.href =
        `/ComputerSummary/UpdatePatchselection?companyid=${companyid}&groupid=${groupid}&locationid=${locationid}&selectedIds=${idParam}&domainids=${domainid}`;
            }
    </script>

  
</body>
</html>
