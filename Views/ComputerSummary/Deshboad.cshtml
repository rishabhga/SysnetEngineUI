                var isOnline = card.data('status') === 'online';

                $.get('@Url.Action("GetUserDetailsJson", "ComputerSummary")',
                    { domain: domain },
                    function(r) {
                        card.find('.ip-address-value').text(r.success ? r.ipAddress : 'N/A');
                    }
                ).fail(function() {
                    card.find('.ip-address-value').text('N/A');
