        async function generateOrRegenerateOtp() {
            if (!currentProtectionDomain) return;

            var btn = $('#generateBtn');
            if (!btn.prop('disabled')) {
                await generateNewCode();
            }
        }

        async function generateNewCode() {
            if (!currentProtectionDomain) return;

            var btn = $('#generateBtn');
            var originalHtml = btn.html();

            btn.html('<i class="fas fa-spinner fa-spin mr-2"></i>Generating...').prop('disabled', true);

            try {
                var response = await fetch(`@Url.Action("GenerateOtpCode", "ComputerSummary")?machineId=${encodeURIComponent(currentProtectionDomain)}`);
                var result = await response.json();

                if (result.success && result.otp) {
                    var expireAt = result.expiry ? new Date(result.expiry).getTime() : (Date.now() + 60000);

                    displayOtp(result.otp, expireAt, false);
                    updateGenerateButtonWithTimer();
                    startCountdownTimer(expireAt);

                    $('#expiryInfo').text('New OTP generated! Valid for 1 hour.').addClass('text-green-600');
                    setTimeout(function() {
                        $('#expiryInfo').removeClass('text-green-600').text('');
                    }, 3000);
                } else {
                    $('#expiryInfo').text('Failed: ' + (result.error || 'Unknown error')).addClass('text-red-500');
                    resetGenerateButton();
                }
            } catch (e) {
                $('#expiryInfo').text('Error: ' + e.message).addClass('text-red-500');
                resetGenerateButton();
            }
        }

        async function fetchOtpCode(domain) {
            $('#accessCode').html('<i class="fas fa-spinner fa-spin text-gray-400"></i>');
            $('#expiryInfo').text('Checking for existing code...');
            $('#timerSection').addClass('hidden');
            $('#copyCodeBtn').addClass('opacity-50 cursor-not-allowed').prop('disabled', true);

            try {
                var response = await fetch(`@Url.Action("GetOtpCode", "ComputerSummary")?machineId=${encodeURIComponent(domain)}`);
                var result = await response.json();

                if (result.success && result.otp) {
                    var isUsed = result.isUsed || false;

                    if (isUsed) {
                        showNoOtpState();
                        return;
                    }

                    var expireTime;
                    if (result.expireAt) {
                        var dateStr = result.expireAt.toString();
                        expireTime = Date.parse(dateStr);

                        if (isNaN(expireTime)) {
                            var d = new Date(dateStr);
                            expireTime = d.getTime();
                        }

                        if (isNaN(expireTime)) {
                            dateStr = dateStr.replace(' ', 'T');
                            expireTime = Date.parse(dateStr);
                        }
                    }

                    if (!isNaN(expireTime) && expireTime > Date.now()) {
                        displayOtp(result.otp, expireTime, false);
                        updateGenerateButtonWithTimer();
                        startCountdownTimer(expireTime);

                        $('#expiryInfo').text('Code loaded from server').addClass('text-green-600');
                        setTimeout(function() {
                            $('#expiryInfo').removeClass('text-green-600').text('');
                        }, 2000);
                        return;
                    }
                }

                showNoOtpState();
            } catch (e) {
                showNoOtpState();
            }
        }

        function showNoOtpState() {
            $('#accessCode').html('<span class="text-gray-400 text-sm">No active code</span>');
            $('#expiryInfo').text('Generate OTP when needed');
            $('#timerSection').addClass('hidden');
            $('#copyCodeBtn').addClass('opacity-50 cursor-not-allowed').prop('disabled', true);
            resetGenerateButton();
        }

        function displayOtp(otp, expireAt, isExpired) {
            var accessCodeEl = $('#accessCode');
            var copyBtn = $('#copyCodeBtn');

            if (isExpired) {
                accessCodeEl.html('<span class="text-red-500 text-sm">Code Expired</span>');
                copyBtn.addClass('opacity-50 cursor-not-allowed').prop('disabled', true);
                $('#expiryInfo').text('OTP expired. Generate new code when needed.').addClass('text-red-500');
                resetGenerateButton();
            } else {
                accessCodeEl.text(otp).addClass('text-2xl font-bold tracking-widest');
                copyBtn.removeClass('opacity-50 cursor-not-allowed').prop('disabled', false);
                $('#expiryInfo').text('').removeClass('text-red-500 text-green-600');
            }
        }

        function updateGenerateButtonWithTimer() {
            $('#generateBtn')
                .html('<i class="fas fa-clock mr-2"></i><span class="timer-text">01:00</span>')
                .prop('disabled', true)
                .removeClass('bg-green-500 hover:bg-green-600 bg-orange-500 hover:bg-orange-600')
                .addClass('cursor-not-allowed')
                .css({'background':'linear-gradient(135deg,#00BCEB,#0096BE)', 'opacity':'0.75'});
        }

        function updateButtonTimerText(mins, secs) {
            var timerText = String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
            $('#generateBtn').find('.timer-text').text(timerText);
        }

        function resetGenerateButton() {
            $('#generateBtn')
                .html('<i class="fas fa-key mr-2"></i>Generate OTP')
                .prop('disabled', false)
                .removeClass('cursor-not-allowed bg-blue-500 hover:bg-blue-600 bg-orange-500 hover:bg-orange-600')
                .addClass('bg-green-500 hover:bg-green-600')
                .css({'background':'', 'opacity':''});
        }


        function startCountdownTimer(expireAt) {
            var endTime = new Date(expireAt).getTime();
            var startTime = Date.now();
            var totalMs = endTime - startTime;

            $('#timerSection').removeClass('hidden');

            if (countdownInterval) {
                clearInterval(countdownInterval);
            }

            if (totalMs <= 0) {
                handleOtpExpired();
                return;
            }

            countdownInterval = setInterval(function() {
                var remaining = endTime - Date.now();

                if (remaining <= 0) {
                    clearInterval(countdownInterval);
                    countdownInterval = null;
                    handleOtpExpired();
                    return;
                }

                var mins = Math.floor(remaining / 60000);
                var secs = Math.floor((remaining % 60000) / 1000);

                $('#countdownTimer').text(String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0'));

                var percentage = (remaining / totalMs) * 100;
                $('#timerBar').css('width', percentage + '%');

                updateButtonTimerText(mins, secs);
            }, 1000);
        }

        function handleOtpExpired() {
            displayOtp(null, null, true);
            $('#expiryInfo').text('Code expired. Generate new code when needed.').addClass('text-red-500');
            $('#timerSection').addClass('hidden');
            resetGenerateButton();
        }

        function copyCode() {
            var code = $('#accessCode').text().trim();
            if (code && code.length > 0 && code !== 'No active code' && code !== 'Code Expired') {
                navigator.clipboard.writeText(code).then(function() {
                    var btn = $('#copyCodeBtn');
                    btn.html('<i class="fas fa-check mr-1"></i>Copied!')
                        .addClass('bg-green-500')
                        .removeClass('bg-orange-500');

                    setTimeout(function() {
                        btn.html('<i class="fas fa-copy mr-1"></i>Copy')
                            .removeClass('bg-green-500')
                            .addClass('bg-orange-500');
                    }, 1500);
                });
            }
        }

        function loadSystemUsageData(card, domain) {
            if (!domain) {
                setErrorState(card);
                return;
            }

            var cpuValue  = card.find('.cpu-value');
            var ramValue  = card.find('.ram-value');
            var diskValue = card.find('.disk-value');

            cpuValue.html('<i class="fas fa-circle-notch fa-spin text-gray-400 text-xs"></i>');
            ramValue.html('<i class="fas fa-circle-notch fa-spin text-gray-400 text-xs"></i>');
            diskValue.html('<i class="fas fa-circle-notch fa-spin text-gray-400 text-xs"></i>');

            $.ajax({
                url: '@Url.Action("GetRamCpuDiskData", "ComputerSummary")',
                type: 'GET',
                data: { domain: domain },
                timeout: 25000,
                success: function (response) {
                    if (response.status === 'success' && response.data) {
                        var data = response.data;

                        var cpuPercent  = parseFloat(data.cpuUsage);
                        var ramPercent  = parseFloat(data.ramUsage);
                        var diskPercent = parseFloat(data.diskUsage);

                        if (!isNaN(cpuPercent)) {
                            cpuValue.text(cpuPercent.toFixed(1) + '%');
                            card.find('.cpu-bar').css('width', cpuPercent + '%');
                            checkThreshold(domain, 'CPU', cpuPercent, card.find('.cpu-bar'));
                        } else {
                            cpuValue.text('N/A');
                            card.find('.cpu-bar').css('width', '0%');
                        }

                        if (!isNaN(ramPercent)) {
                            ramValue.text(ramPercent.toFixed(1) + '%');
                            card.find('.ram-bar').css('width', ramPercent + '%');
                            checkThreshold(domain, 'RAM', ramPercent, card.find('.ram-bar'));
                        } else {
                            ramValue.text('N/A');
                            card.find('.ram-bar').css('width', '0%');
                        }

                        if (!isNaN(diskPercent)) {
                            diskValue.text(diskPercent.toFixed(1) + '%');
                            card.find('.disk-bar').css('width', diskPercent + '%');
                            checkThreshold(domain, 'Disk', diskPercent, card.find('.disk-bar'));
                        } else {
                            diskValue.text('N/A');
                            card.find('.disk-bar').css('width', '0%');
                        }
                    } else if (response.status === 'timeout') {
                        setTimeoutState(card);
                    } else {
                        setErrorState(card);
                    }
                },
                error: function (xhr, status) {
                    if (status === 'timeout') {
                        setTimeoutState(card);
                    } else {
                        setErrorState(card);
                    }
                }
            });
        }

        function checkThreshold(domain, type, value, barElement) {
            const vip = (window.VIP_CLIENTS || []).find(v => (v.ClientId || '').toUpperCase() === domain.toUpperCase());

            let threshold = null;
            if (vip) {
                if (type === 'CPU') threshold = vip.CpuThreshold;
                else if (type === 'RAM') threshold = vip.RamThreshold;
                else if (type === 'Disk') threshold = vip.DiskThreshold;
            }

            // Fallback to location default if no VIP specific threshold
            if (threshold === null || threshold === undefined) {
                const locThres = $(`#loc${type}Threshold`).val();
                if (locThres) threshold = parseFloat(locThres);
            }

            if (threshold !== null && threshold !== undefined && value >= threshold) {
                barElement.addClass('bg-red-500').removeClass('bg-blue-500 bg-indigo-500 bg-amber-500');
                if (!barElement.data('alerted')) {
                    sysAlert(`Critical: ${domain} reached ${type} threshold (${value.toFixed(1)}% >= ${threshold}%)`, 'warning');
                    barElement.data('alerted', true);
                    setTimeout(() => barElement.data('alerted', false), 60000); // Re-alert after 1 min
                }
            } else {
                barElement.removeClass('bg-red-500');
                // Restore original colors if needed, but Tailwind usually handles via classes
            }
        }

        function setErrorState(card) {
            card.find('.cpu-value').text('N/A');
            card.find('.ram-value').text('N/A');
            card.find('.disk-value').text('N/A');
            card.find('.cpu-bar').css('width', '0%');
            card.find('.ram-bar').css('width', '0%');
            card.find('.disk-bar').css('width', '0%');
        }

        function setTimeoutState(card) {
            card.find('.cpu-value').html('<i class="fas fa-clock text-orange-500 text-xs" title="Timeout"></i>');
            card.find('.ram-value').html('<i class="fas fa-clock text-orange-500 text-xs" title="Timeout"></i>');
            card.find('.disk-value').html('<i class="fas fa-clock text-orange-500 text-xs" title="Timeout"></i>');
            card.find('.cpu-bar').css('width', '0%');
            card.find('.ram-bar').css('width', '0%');
            card.find('.disk-bar').css('width', '0%');
        }

        $(document).on('click', '.refresh-usage-btn', function(e) {
            e.preventDefault();
            e.stopPropagation();

            var btn = $(this);
            var card = btn.closest('.device-card');
            var domain = card.data('domain');
            var isOnline = card.data('status') === 'online';

            if (!isOnline) {
                sysAlert('Cannot refresh - device is offline', 'warning');
                return;
            }

            var originalHtml = btn.html();
            btn.html('<i class="fas fa-sync-alt fa-spin text-gray-500 text-xs"></i>')
                .prop('disabled', true);

            loadSystemUsageData(card, domain);

            setTimeout(function() {
                btn.html(originalHtml).prop('disabled', false);
            }, 2000);
        });

        function loadLastSeenTime(card, domain) {
            var lastSeenText = card.find('.last-seen-text');

            $.ajax({
                url: '@Url.Action("GetConnectedDevices", "ComputerSummary")',
                type: 'GET',
                timeout: 5000,
                success: function(devices) {
                    var isOnline = devices.some(d => d.toUpperCase() === domain.toUpperCase());
                    if (isOnline) {
                        lastSeenText.html('<span class="text-green-600 font-semibold">Online Now</span>');
                        return;
                    }
                    fetchLastSeenFromServer(lastSeenText, domain);
                },
                error: function() {
                    fetchLastSeenFromServer(lastSeenText, domain);
                }
            });
        }

        function fetchLastSeenFromServer(lastSeenText, domain) {
            $.ajax({
                url: '@Url.Action("GetLastSeenTime", "ComputerSummary")',
                type: 'GET',
                data: { domain: domain },
                timeout: 10000,
                success: function(response) {
                    if (response.success && response.lastSeen) {
                        var lastSeenDate = new Date(response.lastSeen);
                        var formattedText = formatTimeAgo(lastSeenDate);
                        lastSeenText.html('Last seen: ' + formattedText);
                    } else {
                        lastSeenText.text('Last seen: Never');
                    }
                },
                error: function() {
                    lastSeenText.text('Last seen: Unknown');
                }
            });
        }

        function formatTimeAgo(date) {
            var now = new Date();
            var diffMs = now - date;
            var diffMins = Math.floor(diffMs / 60000);
            var diffHours = Math.floor(diffMs / 3600000);
            var diffDays = Math.floor(diffMs / 86400000);

            if (diffMins < 1) {
                return 'Just now';
            } else if (diffMins < 60) {
                return diffMins + ' minute' + (diffMins !== 1 ? 's' : '') + ' ago';
            } else if (diffHours < 24) {
                return diffHours + ' hour' + (diffHours !== 1 ? 's' : '') + ' ago';
            } else if (diffDays < 7) {
                return diffDays + ' day' + (diffDays !== 1 ? 's' : '') + ' ago';
            } else {
                var options = { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' };
                return date.toLocaleDateString('en-US', options);
            }
        }

        $(document).on('searchEvent', function(e, term) {
            filterDevices(term);
        });

        $('#statusFilter').on('change', function() {
            filterDevices();
        });

        function filterDevices(searchTerm) {
            var term = (searchTerm !== undefined ? searchTerm : $('#globalSearchInput').val()).toLowerCase();
            var status = $('#statusFilter').val();

            $('#devicesGrid .device-card').each(function() {
                var card = $(this);
                var content = card.text().toLowerCase();
                var cardStatus = card.data('status');

                var matchesSearch = content.indexOf(term) > -1;
                var matchesStatus = status === 'all' || status === cardStatus;

                card.toggle(matchesSearch && matchesStatus);
            });
        }

        $(document).on('click', '.edit-name-btn', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var cell = $(this).closest('.deshboard-name-cell');
            cell.find('.display-name-section').hide();
            cell.find('.edit-section').removeClass('hidden');
        });

        $(document).on('click', '.cancel-edit-btn', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var cell = $(this).closest('.deshboard-name-cell');
            cell.find('.edit-section').addClass('hidden');
            cell.find('.display-name-section').show();
        });

        $(document).on('click', '.update-btn', function(e) {
            e.preventDefault();
            e.stopPropagation();

            var cell = $(this).closest('.deshboard-name-cell');
            var newName = cell.find('.edit-name').val().trim();

            if (!newName) {
                sysAlert('Name cannot be empty.', 'warning');
                return;
            }

            var btn = $(this);
            btn.html('<i class="fas fa-spinner fa-spin"></i>').prop('disabled', true);

            $.ajax({
                url: '@Url.Action("deshboardupdate", "ComputerSummary")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    Id: cell.data('id'),
                    DomainName: cell.data('domain-id'),
                    CompanyId: cell.data('company-id'),
                    GroupId: cell.data('group-id'),
                    LocationId: cell.data('location-id'),
                    UserName: newName
                }),
                success: function() {
                    cell.find('.display-name-section a').text(newName);
                    cell.find('.edit-section').addClass('hidden');
                    cell.find('.display-name-section').show();
                },
                error: function() {
                    sysAlert('Error updating name', 'error');
                },
                complete: function() {
                    btn.html('Save').prop('disabled', false);
                }
            });
        });

        $('.rescan-link').on('click', function() {
            if ($(this).prop('disabled')) return;

            var link   = $(this);
            var domain = link.data('domain');
            var card   = link.closest('.device-card');

            link.find('.rescan-text').html('<i class="fas fa-spinner fa-spin mr-0.5"></i>Scanning…');
            link.prop('disabled', true);
            card.addClass('opacity-75'); // Visual cue

            registerActiveRescan(domain);

            // Stale scan safety timeout (10 minutes)
            setTimeout(() => {
                if (activeScans[domain.toUpperCase()]) {
                    unregisterActiveRescan(domain);
                    resetRescanButton(link, card);
                    sysAlert('Scan timed out for ' + domain, 'warning');
                }
            }, 10 * 60 * 1000);

            $.post('@Url.Action("Comanddata", "ComputerSummary")?domain=' + domain, function(res) {
                if (res.success) {
                    sysAlert('Scan initiated for ' + domain, 'info');
                } else {
                    unregisterActiveRescan(domain);
                    resetRescanButton(link, card);
                    sysAlert('Failed: ' + (res.message || 'Server error'), 'error');
                }
            }).fail(function() {
                unregisterActiveRescan(domain);
                resetRescanButton(link, card);
                sysAlert('Could not start scan for ' + domain, 'error');
            });
        });

        function resetRescanButton(link, card) {
            link.find('.rescan-text').html(
                '<i class="fas fa-sync-alt mr-0.5 text-[7px]"></i><span class="js-txt">Rescan</span>'
            );
            link.prop('disabled', false);
            if (card) card.removeClass('opacity-75');
        }

        // Duplicate startDashboardHub removed

        // Initial load
        $(document).ready(function() {
            loadPersistedScans();
        });

        let activeScans = {};

        function registerActiveRescan(domain) {
            activeScans[domain.toUpperCase()] = Date.now();
            localStorage.setItem('activeScans', JSON.stringify(activeScans));
        }

        function unregisterActiveRescan(domain) {
            delete activeScans[domain.toUpperCase()];
            localStorage.setItem('activeScans', JSON.stringify(activeScans));
        }

        function loadPersistedScans() {
            const saved = localStorage.getItem('activeScans');
            if (saved) {
                try {
                    activeScans = JSON.parse(saved);
                    const now = Date.now();
                    const timeoutMs = 10 * 60 * 1000; // 10 minutes timeout

                    Object.keys(activeScans).forEach(domain => {
                        const registeredTime = activeScans[domain];

                        // If it has been more than 10 minutes, or is old format (boolean true)
                        if (typeof registeredTime !== 'number' || (now - registeredTime > timeoutMs)) {
                            delete activeScans[domain];
                            return;
                        }

                        // Case-insensitive card search
                        let card = null;
                        $('.device-card').each(function() {
                            const d = $(this).attr('data-domain');
                            if (d && d.toUpperCase() === domain.toUpperCase()) {
                                card = $(this);
                                return false;
                            }
                        });

                        if (card && card.length) {
                            const link = card.find('.rescan-link');
                            if (link.length) {
                                link.find('.rescan-text').html('<i class="fas fa-spinner fa-spin mr-0.5"></i>Scanning…');
                                link.prop('disabled', true);
                                card.addClass('opacity-75');

                                // Set timeout to clean up when the remaining time is reached
                                const remainingTime = timeoutMs - (now - registeredTime);
                                setTimeout(() => {
                                    if (activeScans[domain]) {
                                        unregisterActiveRescan(domain);
                                        resetRescanButton(link, card);
                                        sysAlert('Scan timed out for ' + domain, 'warning');
                                    }
                                }, remainingTime);
                            }
                        }
                    });
                    localStorage.setItem('activeScans', JSON.stringify(activeScans));
                } catch (e) {
                    activeScans = {};
                }
            }
        }


        $('.remote-link').on('click', function() {
            if (!$(this).prop('disabled')) {
                window.location.href = '@Url.Action("Live", "ComputerSummary")?domain=' + $(this).data('domain');
            }
        });

        $(document).on('click', '.open-chat-btn', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var domain = $(this).data('domain');
            if (domain) {
                window.openChatModal(domain);
            }
        });

    </script>


