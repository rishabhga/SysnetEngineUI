@using ManageEngineWebApp.Dtos
@using Newtonsoft.Json
@model List<ManageEngineWebApp.Models.WindowsUserDetails>
@{
    ViewData["Title"] = $"{ViewBag.locationName} - Devices";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var username = Context.Session.GetString("username");
    var userRole = Context.Session.GetString("role");
    var activeComputers = ViewBag.ActiveComputers as List<string> ?? new List<string>();

    var data = Model as List<ManageEngineWebApp.Models.WindowsUserDetails> ?? new List<ManageEngineWebApp.Models.WindowsUserDetails>();
    var totalDevices = data.Count;
    var onlineDevices = data.Count(x => activeComputers.Contains(x.DomainName, StringComparer.OrdinalIgnoreCase) || activeComputers.Contains(x.UserCode, StringComparer.OrdinalIgnoreCase));
    var offlineDevices = totalDevices - onlineDevices;
    var activeUsers = data.Count(x =>
        (activeComputers.Contains(x.DomainName, StringComparer.OrdinalIgnoreCase) || activeComputers.Contains(x.UserCode, StringComparer.OrdinalIgnoreCase)) &&
        !string.IsNullOrEmpty(x.UserName) &&
        x.UserName != "N/A");
}

<style>
    /* ── Base ── */
    * {
        box-sizing: border-box;
    }

    .hidden {
        display: none !important;
    }

    /* ── Animations ── */
    @@keyframes pulse {
        0%, 100% {
            opacity: 1
        }

        50% {
            opacity: .4
        }
    }

    .animate-pulse {
        animation: pulse 2s cubic-bezier(.4,0,.6,1) infinite;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-5px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    .menu-dropdown {
        animation: slideDown .15s ease-out;
    }

    /* ── Stat card backgrounds ── */
    .stat-total-bg {
        background: linear-gradient(135deg,#e8f9fe,#cff3fc);
    }

    .stat-online-bg {
        background: linear-gradient(135deg,#f0fdf4,#dcfce7);
    }

    .stat-remote-bg {
        background: linear-gradient(135deg,#fff7ed,#ffedd5);
    }

    .stat-offline-bg {
        background: linear-gradient(135deg,#f9fafb,#f3f4f6);
    }

    /* ── Stat grid ── */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 6px;
        margin-bottom: 7px;
    }

    @@media (max-width:640px) {
        .stats-grid {
            grid-template-columns: repeat(2,1fr);
        }
    }

    /* ── Card header tints ── */
    .card-header-online {
        background: linear-gradient(135deg,#f0fdf4,#dcfce7);
        border-bottom: 1px solid #bbf7d0;
    }

    .card-header-offline {
        background: linear-gradient(135deg,#f9fafb,#f3f4f6);
        border-bottom: 1px solid #e5e7eb;
    }

    /* ── Usage bar track ── */
    .usage-bar-track {
        height: 4px;
        border-radius: 4px;
        background: #e5e7eb;
        overflow: hidden;
        margin-top: 2px;
    }

    /* ── Usage bar fill – smooth grow only, no shimmer ── */
    .usage-bar-fill {
        height: 100%;
        border-radius: 4px;
        width: 0%;
        transition: width 0.9s cubic-bezier(.4,0,.2,1);
    }
    /* bar colors */
    .cpu-bar {
        background: linear-gradient(90deg,#00BCEB,#0096BE);
    }

    .ram-bar {
        background: linear-gradient(90deg,#f97316,#ea580c);
    }

    .disk-bar {
        background: linear-gradient(90deg,#B4D334,#8FB829);
    }
    /* alert override */
    .bar-alert {
        background: linear-gradient(90deg,#ef4444,#dc2626) !important;
    }

    /* ── Sparkline ── */
    .sparkline-wrap {
        position: relative;
        height: 30px;
        width: 100%;
    }

    /* ── Status badges ── */
    .status-badge-online {
        background: #dcfce7;
        color: #15803d;
    }

    .status-badge-offline {
        background: #f3f4f6;
        color: #6b7280;
    }

    /* ── Filter pills ── */
    .filter-pill {
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.13s;
        border: 1.5px solid transparent;
        line-height: 1.5;
    }

        .filter-pill.active {
            background: #00BCEB;
            color: #fff;
            border-color: #00BCEB;
        }

        .filter-pill:not(.active) {
            background: #fff;
            color: #4b5563;
            border-color: #e5e7eb;
        }

        .filter-pill:hover:not(.active) {
            border-color: #00BCEB;
            color: #00BCEB;
        }

    /* ── Device icon box ── */
    .device-illus {
        width: 34px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        flex-shrink: 0;
        position: relative;
    }

    .device-illus-online {
        background: linear-gradient(135deg,#e8f9fe,#cff3fc);
    }

    .device-illus-offline {
        background: linear-gradient(135deg,#f3f4f6,#e5e7eb);
    }

    /* ── Status dots ── */
    .online-dot, .offline-dot {
        position: absolute;
        bottom: -2px;
        right: -2px;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        border: 2px solid #fff;
    }

    .online-dot {
        background: #22c55e;
    }

    .offline-dot {
        background: #9ca3af;
    }

    /* ── Device grid ── */
    .devices-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
        gap: 7px;
    }

    @@media (max-width:480px) {
        .devices-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (min-width:481px) and (max-width:650px) {
        .devices-grid {
            grid-template-columns: repeat(2,1fr);
        }
    }

    @@media (min-width:651px) and (max-width:900px) {
        .devices-grid {
            grid-template-columns: repeat(3,1fr);
        }
    }

    @@media (min-width:901px) and (max-width:1200px) {
        .devices-grid {
            grid-template-columns: repeat(4,1fr);
        }
    }

    @@media (min-width:1201px) and (max-width:1500px) {
        .devices-grid {
            grid-template-columns: repeat(5,1fr);
        }
    }

    @@media (min-width:1501px) {
        .devices-grid {
            grid-template-columns: repeat(6,1fr);
        }
    }

    /* ── Device card ── */
    .device-card {
        transition: transform 0.18s ease, box-shadow 0.18s ease;
        border-radius: 10px;
    }

        .device-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 14px rgba(0,0,0,.09);
        }

    /* ── Protection badge ── */
    .temp-protection-badge {
        position: absolute;
        top: -3px;
        right: -3px;
        width: 8px;
        height: 8px;
        background: #f97316;
        border-radius: 50%;
        border: 1.5px solid #fff;
    }

    /* ── Info row ── */
    .info-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4px;
        margin-bottom: 5px;
    }

    .info-cell {
        background: #f8fafc;
        border-radius: 6px;
        padding: 3px 5px;
        min-width: 0;
    }

    .info-label {
        font-size: 7px;
        color: #9ca3af;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 1px;
    }

    .info-value {
        font-size: 9px;
        font-weight: 700;
        color: #374151;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ── Usage section ── */
    .usage-section {
        margin-bottom: 4px;
    }

    .usage-row {
        margin-bottom: 3px;
    }

    .usage-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 7px;
        margin-bottom: 1px;
    }

    .usage-name {
        display: flex;
        align-items: center;
        gap: 3px;
        color: #6b7280;
        font-weight: 600;
    }

    .usage-val {
        font-weight: 700;
        color: #374151;
        font-size: 8px;
    }
</style>

<div style="max-width:1400px; margin:0 auto; padding:5px 10px 12px;">

    <!-- ── Header ── -->
    <div style="margin-bottom:7px; display:flex; align-items:center; justify-content:space-between;">
        <div style="display:flex; align-items:center; gap:6px;">
            <a href="#" onclick="navigateToEncrypted('/Companies/GroupsDetails', {id: '@ViewBag.companyid', companyName: '@ViewBag.CompanyName'}); return false;"
               style="width:24px;height:24px;background:#fff;border:1px solid #e5e7eb;border-radius:7px;display:flex;align-items:center;justify-content:center;text-decoration:none;box-shadow:0 1px 2px rgba(0,0,0,.05);">
                <i class="fas fa-arrow-left" style="color:#6b7280;font-size:9px;"></i>
            </a>
            <div style="display:flex;align-items:center;gap:6px;">
                @{
                    var logoUrl = ViewBag.CompanyLogoUrl as string;
                }
                @if (!string.IsNullOrEmpty(logoUrl))
                {
                    <div style="width:26px;height:26px;border-radius:7px;overflow:hidden;border:1px solid #e5e7eb;background:#fff;display:flex;align-items:center;justify-content:center;">
                        <img src="/Companies/Logo?path=@Uri.EscapeDataString(logoUrl)" alt="@ViewBag.CompanyName" style="max-height:20px;object-fit:contain;"
                             onerror="let p=this.parentElement;if(p){p.innerHTML='<i class=\'fas fa-map-marker-alt\' style=\'color:#fff;font-size:9px;\'></i>';p.style.background='linear-gradient(135deg,#00BCEB,#0096BE)';}this.onerror=null;" />
                    </div>
                }
                else
                {
                    <div style="width:26px;height:26px;border-radius:7px;background:linear-gradient(135deg,#00BCEB,#0096BE);display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-map-marker-alt" style="color:#fff;font-size:9px;"></i>
                    </div>
                }
                <div>
                    <div style="display:flex;align-items:center;gap:5px;">
                        <h1 style="font-size:12px;font-weight:700;color:#111827;margin:0;">@ViewBag.locationName</h1>
                        @if (ViewBag.IsLocationCritical == true)
                        {
                            <span class="critical-indicator" title="Critical Location">
                                <i class="fas fa-crown" style="color:#f59e0b;font-size:11px;"></i>
                            </span>
                        }
                    </div>
                    <p style="font-size:8px;color:#9ca3af;margin:0;">@ViewBag.CompanyName › @ViewBag.groupName</p>
                </div>
            </div>
        </div>

        <input type="hidden" id="locCpuThreshold" value="@ViewBag.CpuThreshold" />
        <input type="hidden" id="locRamThreshold" value="@ViewBag.RamThreshold" />
        <input type="hidden" id="locDiskThreshold" value="@ViewBag.DiskThreshold" />
        <script>
            window.VIP_CLIENTS = @Html.Raw(JsonConvert.SerializeObject(ViewBag.VipClients ?? new List<VIPClient>()));
        </script>
    </div>

    <!-- ── Stat Cards ── -->
    <div class="stats-grid">

        <!-- Total -->
        <div class="stat-total-bg" style="border-radius:10px;padding:8px 10px;border:1px solid #bae6fd;display:flex;align-items:center;gap:8px;">
            <div style="width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,#00BCEB,#0096BE);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="13" rx="2" />
                    <polyline points="8,21 12,17 16,21" />
                    <line x1="12" y1="17" x2="12" y2="21" />
                </svg>
            </div>
            <div>
                <p style="font-size:8px;font-weight:700;color:#0284c7;text-transform:uppercase;letter-spacing:.05em;margin:0 0 1px;">Total</p>
                <p style="font-size:18px;font-weight:800;color:#0c4a6e;margin:0;line-height:1;">@totalDevices</p>
            </div>
        </div>

        <!-- Online -->
        <div class="stat-online-bg" style="border-radius:10px;padding:8px 10px;border:1px solid #bbf7d0;display:flex;align-items:center;gap:8px;">
            <div style="width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,#22c55e,#16a34a);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12" />
                </svg>
            </div>
            <div>
                <p style="font-size:8px;font-weight:700;color:#16a34a;text-transform:uppercase;letter-spacing:.05em;margin:0 0 1px;">Online</p>
                <p style="font-size:18px;font-weight:800;color:#14532d;margin:0;line-height:1;" id="onlineCount">@onlineDevices</p>
            </div>
        </div>

        <!-- Remote -->
        <div class="stat-remote-bg" style="border-radius:10px;padding:8px 10px;border:1px solid #fed7aa;display:flex;align-items:center;gap:8px;">
            <div style="width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,#f97316,#ea580c);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 6s4-5 11-5 11 5 11 5" />
                    <path d="M5 10s2.5-3 7-3 7 3 7 3" />
                    <path d="M9 14s1-1 3-1 3 1 3 1" />
                    <circle cx="12" cy="18" r="2" fill="white" stroke="none" />
                </svg>
            </div>
            <div>
                <p style="font-size:8px;font-weight:700;color:#ea580c;text-transform:uppercase;letter-spacing:.05em;margin:0 0 1px;">Remote</p>
                <p style="font-size:18px;font-weight:800;color:#7c2d12;margin:0;line-height:1;" id="remoteSessionCount">@(ViewBag.RemoteSessions ?? 0)</p>
            </div>
        </div>

        <!-- Offline -->
        <div class="stat-offline-bg" style="border-radius:10px;padding:8px 10px;border:1px solid #e5e7eb;display:flex;align-items:center;gap:8px;">
            <div style="width:30px;height:30px;border-radius:9px;background:#4b5563;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <circle cx="12" cy="16" r="0.5" fill="white" stroke="white" stroke-width="2" />
                </svg>
            </div>
            <div>
                <p style="font-size:8px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.05em;margin:0 0 1px;">Offline</p>
                <p style="font-size:18px;font-weight:800;color:#111827;margin:0;line-height:1;" id="offlineCount">@offlineDevices</p>
            </div>
        </div>

    </div>

    <!-- ── Filter Bar ── -->
    <div style="margin-bottom:7px;display:flex;align-items:center;justify-content:space-between;">
        <div style="display:flex;align-items:center;gap:6px;">
            <button class="filter-pill active" onclick="setStatusFilter('all', this)">All</button>
            <button class="filter-pill" onclick="setStatusFilter('online', this)">Online</button>
            <button class="filter-pill" onclick="setStatusFilter('offline', this)">Offline</button>
        </div>
        <span style="font-size:10px;color:#9ca3af;font-weight:600;display:none;" class="sm-show">
            <i class="fas fa-circle" style="color:#22c55e;font-size:7px;margin-right:4px;"></i>Live monitoring active
        </span>
    </div>

    @if (Model != null && Model.Any())
    {
        var vipClients = ViewBag.VipClients as List<ManageEngineWebApp.Models.VIPClient> ?? new List<ManageEngineWebApp.Models.VIPClient>();
        <div class="devices-grid" id="devicesGrid">
            @foreach (var item in Model)
            {
                var currentLocId = ViewBag.LocationId as int?;
                var isVip = vipClients.Any(v =>
                (v.LocationID == currentLocId) && (v.IsVIP == true) &&
                ((!string.IsNullOrEmpty(v.ClientId) && string.Equals(v.ClientId, item.DomainName, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(v.ClientId) && string.Equals(v.ClientId, item.UserCode, StringComparison.OrdinalIgnoreCase))));

                bool isActive = activeComputers.Any(d =>
                string.Equals(d, item.DomainName, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(d, item.UserCode, StringComparison.OrdinalIgnoreCase));

                bool isLaptop = item.DomainName.ToUpper().Contains("LAPTOP");
                bool isServer = item.DomainName.ToUpper().Contains("SERVER") || item.AccountType?.ToUpper().Contains("SERVER") == true;

                <div class="device-card"
                     style="background:#fff;border-radius:10px;border:1px solid @(isActive ? "#bbf7d0" : "#e5e7eb");overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.05);"
                     data-domain="@item.DomainName"
                     data-status="@(isActive ? "online" : "offline")"
                     data-device-id="@item.Id">

                    <!-- Card Header -->
                    <div class="@(isActive ? "card-header-online" : "card-header-offline")" style="padding:6px 8px;">
                        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:6px;">

                            <!-- Device illustration + name -->
                            <div style="display:flex;align-items:center;gap:8px;min-width:0;flex:1;">

                                <!-- Illustrated Device Icon -->
                                <div style="position:relative;flex-shrink:0;">
                                    <div class="device-illus js-status-icon-bg @(isActive ? "device-illus-online" : "device-illus-offline")">
                                        @if (isServer)
                                        {
                                            <!-- Server: rack illustration -->
                                            <svg width="32" height="32" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <rect x="6" y="8" width="36" height="9" rx="2.5" fill="@(isActive ? "#00BCEB" : "#9ca3af")" opacity=".15" />
                                                <rect x="6" y="8" width="36" height="9" rx="2.5" stroke="@(isActive ? "#00BCEB" : "#9ca3af")" stroke-width="1.6" fill="none" />
                                                <rect x="6" y="20" width="36" height="9" rx="2.5" fill="@(isActive ? "#00BCEB" : "#9ca3af")" opacity=".1" />
                                                <rect x="6" y="20" width="36" height="9" rx="2.5" stroke="@(isActive ? "#00BCEB" : "#9ca3af")" stroke-width="1.6" fill="none" />
                                                <rect x="6" y="32" width="36" height="8" rx="2.5" fill="@(isActive ? "#00BCEB" : "#9ca3af")" opacity=".07" />
                                                <rect x="6" y="32" width="36" height="8" rx="2.5" stroke="@(isActive ? "#00BCEB" : "#9ca3af")" stroke-width="1.6" fill="none" />
                                                <circle cx="34" cy="12.5" r="2" fill="@(isActive ? "#22c55e" : "#9ca3af")" />
                                                <circle cx="39" cy="12.5" r="2" fill="@(isActive ? "#00BCEB" : "#d1d5db")" />
                                                <circle cx="34" cy="24.5" r="2" fill="@(isActive ? "#22c55e" : "#9ca3af")" />
                                                <circle cx="39" cy="24.5" r="2" fill="@(isActive ? "#f97316" : "#d1d5db")" />
                                                <rect x="10" y="11" width="14" height="2.5" rx="1.2" fill="@(isActive ? "#00BCEB" : "#d1d5db")" opacity=".5" />
                                                <rect x="10" y="23" width="10" height="2.5" rx="1.2" fill="@(isActive ? "#00BCEB" : "#d1d5db")" opacity=".5" />
                                            </svg>
                                        }
                                        else if (isLaptop)
                                        {
                                            <!-- Laptop: realistic illustration -->
                                            <svg width="34" height="30" viewBox="0 0 52 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <!-- Screen body -->
                                                <rect x="8" y="2" width="36" height="26" rx="3" fill="@(isActive ? "#00BCEB" : "#9ca3af")" opacity=".13" />
                                                <rect x="8" y="2" width="36" height="26" rx="3" stroke="@(isActive ? "#00BCEB" : "#9ca3af")" stroke-width="1.8" fill="none" />
                                                <!-- Screen inner -->
                                                <rect x="11" y="5" width="30" height="20" rx="1.5" fill="@(isActive ? "#e0f7fe" : "#f3f4f6")" />
                                                @if (isActive)
                                                {
                                                    <!-- Screen content lines when online -->
                                                    <rect x="14" y="9" width="18" height="2" rx="1" fill="#00BCEB" opacity=".4" />
                                                    <rect x="14" y="13" width="22" height="1.5" rx=".75" fill="#0096BE" opacity=".3" />
                                                    <rect x="14" y="16" width="14" height="1.5" rx=".75" fill="#0096BE" opacity=".3" />
                                                }
                                                <!-- Hinge -->
                                                <rect x="8" y="27" width="36" height="2" rx="1" fill="@(isActive ? "#0096BE" : "#d1d5db")" />
                                                <!-- Base -->
                                                <path d="M4 29 Q4 32 8 32 H44 Q48 32 48 29 Z" fill="@(isActive ? "#00BCEB" : "#9ca3af")" opacity=".2" />
                                                <path d="M4 29 Q4 32 8 32 H44 Q48 32 48 29 Z" stroke="@(isActive ? "#00BCEB" : "#9ca3af")" stroke-width="1.6" fill="none" />
                                                <!-- Touchpad -->
                                                <rect x="21" y="34" width="10" height="6" rx="1.5" fill="none" stroke="@(isActive ? "#00BCEB" : "#d1d5db")" stroke-width="1.2" />
                                                <!-- Camera dot -->
                                                <circle cx="26" cy="4.5" r="1" fill="@(isActive ? "#00BCEB" : "#d1d5db")" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <!-- Desktop: monitor + tower illustration -->
                                            <svg width="34" height="32" viewBox="0 0 52 46" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <!-- Monitor -->
                                                <rect x="8" y="2" width="32" height="22" rx="3" fill="@(isActive ? "#00BCEB" : "#9ca3af")" opacity=".13" />
                                                <rect x="8" y="2" width="32" height="22" rx="3" stroke="@(isActive ? "#00BCEB" : "#9ca3af")" stroke-width="1.8" fill="none" />
                                                <!-- Screen -->
                                                <rect x="11" y="5" width="26" height="16" rx="1.5" fill="@(isActive ? "#e0f7fe" : "#f3f4f6")" />
                                                @if (isActive)
                                                {
                                                    <rect x="14" y="8" width="16" height="2" rx="1" fill="#00BCEB" opacity=".4" />
                                                    <rect x="14" y="12" width="20" height="1.5" rx=".75" fill="#0096BE" opacity=".3" />
