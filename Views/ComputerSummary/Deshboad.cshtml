            transition: all 0.3s ease;
        }

            .device-card:hover {
                transform: translateY(-2px);
            }

        .hidden {
            display: none !important;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0.5;
            }
