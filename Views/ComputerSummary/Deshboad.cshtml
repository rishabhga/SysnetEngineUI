        function updateLocationBadgeUI(isCritical) {
            const $indicator = $('.critical-indicator');
            if (isCritical) {
                if ($indicator.length === 0) {
                    $('h1.text-sm').after(`
                        <span class="critical-indicator" title="Critical Location">
                            <i class="fas fa-crown text-amber-500 text-[10px] shadow-sm"></i>
                        </span>
                    `);
                }
            } else {
