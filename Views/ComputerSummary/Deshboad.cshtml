                                                <rect x="44" y="8" width="6" height="18" rx="2" fill="@(isActive ? "#00BCEB" : "#9ca3af")" opacity=".15" />
                                                <rect x="44" y="8" width="6" height="18" rx="2" stroke="@(isActive ? "#00BCEB" : "#9ca3af")" stroke-width="1.4" fill="none" />
                                                <circle cx="47" cy="12" r="1.2" fill="@(isActive ? "#22c55e" : "#9ca3af")" />
                                                <rect x="45.5" y="15" width="3" height="1" rx=".5" fill="@(isActive ? "#00BCEB" : "#d1d5db")" opacity=".6" />
                                                <rect x="45.5" y="18" width="3" height="1" rx=".5" fill="@(isActive ? "#00BCEB" : "#d1d5db")" opacity=".4" />
