@using ManageEngineWebApp.Dtos
@model List<ManageEngineWebApp.Models.WindowsUserDetails>
@{
    ViewData["Title"] = $"{ViewBag.locationName} - Devices";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var username = Context.Session.GetString("username");
    var userRole = Context.Session.GetString("role");
    var activeComputers = ViewBag.ActiveComputers as List<string> ?? new List<string>();

    var data = Model as List<ManageEngineWebApp.Models.WindowsUserDetails> ?? new List<ManageEngineWebApp.Models.WindowsUserDetails>();
    var totalDevices = data.Count;
    var onlineDevices = data.Count(x => activeComputers.Contains(x.DomainName));
    var offlineDevices = totalDevices - onlineDevices;
    var activeUsers = data.Count(x =>
        activeComputers.Contains(x.DomainName) &&
        !string.IsNullOrEmpty(x.UserName) &&
        x.UserName != "N/A");
}

<div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-5 pt-2 sm:pt-3">
    <!-- Compact Header -->
    <div class="mb-2 flex items-center justify-between">
        <div class="flex items-center space-x-1.5">
            <a href="/Companies/GroupsDetails?id=@ViewBag.companyid&companyName=@ViewBag.CompanyName"
               class="w-6 h-6 bg-white border border-gray-200 hover:bg-gray-50 rounded-md flex items-center justify-center transition shadow-sm">
                <i class="fas fa-arrow-left text-gray-600 text-[10px]"></i>
            </a>
            <div class="flex items-center space-x-1.5">
                @{
                    var logoUrl = ViewBag.CompanyLogoUrl as string;
                }
                @if (!string.IsNullOrEmpty(logoUrl))
                {
                    <div class="w-7 h-7 rounded-md flex items-center justify-center overflow-hidden border border-gray-100 bg-white shadow-sm">
                        <img src="/Companies/Logo?path=@Uri.EscapeDataString(logoUrl)"
                             alt="@ViewBag.CompanyName"
                             class="max-h-5 object-contain"
                             onerror="let p = this.parentElement; if (p) { p.innerHTML = '<i class=\'fas fa-map-marker-alt text-white text-[10px]\'></i>'; p.style.background = 'linear-gradient(135deg, #00BCEB 0%, #0096BE 100%)'; } this.onerror = null;" />
                    </div>
                }
                else
                {
                    <div class="w-7 h-7 rounded-md flex items-center justify-center shadow-sm" style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                        <i class="fas fa-map-marker-alt text-white text-[10px]"></i>
                    </div>
                }
                <div>
                    <div class="flex items-center space-x-1.5">
                        <h1 class="text-sm font-bold text-gray-900">@ViewBag.locationName</h1>
                        @if (ManageEngineWebApp.Datacontext.RoleHelper.HasPermission(Context, "Companies.Edit"))
                        {
                            <button id="locationCriticalToggle" class="group" onclick="toggleCurrentLocationCriticality()" title="Toggle Critical Monitoring for entire Location">
                                <span id="locationCriticalBadge" class="hidden px-1.5 py-0.5 bg-amber-100 text-amber-700 rounded text-[8px] font-bold border border-amber-200 flex items-center hover:bg-amber-200 transition-all">
                                    <i class="fas fa-crown mr-0.5 text-[7px]"></i> CRITICAL
                                </span>
                                <span id="locationNotCriticalBadge" class="px-1.5 py-0.5 bg-gray-50 text-gray-400 rounded text-[8px] font-bold border border-gray-200 flex items-center hover:text-amber-600 hover:border-amber-300 hover:bg-amber-50 transition-all">
                                    <i class="fas fa-crown mr-0.5 text-[7px]"></i> MONITOR SITE
                                </span>
                            </button>
                        }
                        else
                        {
                            <div id="locationCriticalBadgeStatus">
                                <span id="locationCriticalBadge" class="hidden px-1.5 py-0.5 bg-amber-100 text-amber-700 rounded text-[8px] font-bold border border-amber-200 flex items-center">
                                    <i class="fas fa-crown mr-0.5 text-[7px]"></i> CRITICAL
                                </span>
                            </div>
                        }
                    </div>
                    <p class="text-[9px] text-gray-600">@ViewBag.CompanyName › @ViewBag.groupName</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-1.5">
            @if (ManageEngineWebApp.Datacontext.RoleHelper.HasPermission(Context, "DeviceSecurity.Index"))
            {
                <a href="/DeviceSecurity" class="px-2 py-1 bg-white border border-gray-200 hover:bg-gray-50 rounded-md text-[10px] font-bold text-gray-700 transition shadow-sm flex items-center gap-1">
                    <i class="fas fa-shield-alt text-[#00BCEB]"></i> USB LOCKS
                </a>
            }
        </div>
    </div>

    <!-- Compact Stats Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5 mb-2">
        <div class="bg-white rounded-md border border-gray-200 p-1.5 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[8px] font-medium text-gray-500 uppercase">Total</p>
                    <p class="text-sm font-bold text-gray-900 mt-0">@totalDevices</p>
                </div>
                <div class="w-6 h-6 rounded-md flex items-center justify-center" style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                    <i class="fas fa-desktop text-white text-[9px]"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-md border border-gray-200 p-1.5 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[8px] font-medium text-gray-500 uppercase">Online</p>
                    <p class="text-sm font-bold text-gray-900 mt-0" id="onlineCount">@onlineDevices</p>
                </div>
                <div class="w-6 h-6 rounded-md flex items-center justify-center" style="background: linear-gradient(135deg, #B4D334 0%, #8FB829 100%);">
                    <i class="fas fa-check-circle text-white text-[9px]"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-md border border-gray-200 p-1.5 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[8px] font-medium text-gray-500 uppercase">Remote</p>
                    <p class="text-sm font-bold text-gray-900 mt-0" id="remoteSessionCount">@(ViewBag.RemoteSessions ?? 0)</p>
                </div>
                <div class="w-6 h-6 rounded-md flex items-center justify-center" style="background: linear-gradient(135deg, #F97316 0%, #EA580C 100%);">
                    <i class="fas fa-broadcast-tower text-white text-[9px]"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-md border border-gray-200 p-1.5 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[8px] font-medium text-gray-500 uppercase">Offline</p>
                    <p class="text-sm font-bold text-gray-900 mt-0" id="offlineCount">@offlineDevices</p>
                </div>
                <div class="w-6 h-6 bg-gray-700 rounded-md flex items-center justify-center">
                    <i class="fas fa-power-off text-white text-[9px]"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Compact Status Filter -->
    <div class="mb-2 flex justify-end">
        <select id="statusFilter" class="px-2 py-1 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#00BCEB]/30 focus:border-[#00BCEB] text-[10px] font-medium transition-colors">
            <option value="all">All Status</option>
            <option value="online">Online</option>
            <option value="offline">Offline</option>
        </select>
    </div>

    @if (Model != null && Model.Any())
    {
        var vipClients = ViewBag.VipClients as List<ManageEngineWebApp.Models.VIPClient> ?? new List<ManageEngineWebApp.Models.VIPClient>();
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 xl:grid-cols-5 gap-1.5" id="devicesGrid">
            @foreach (var item in Model)
            {
                var vipStatus = vipClients.FirstOrDefault(v => string.Equals(v.ClientId, item.DomainName, StringComparison.OrdinalIgnoreCase));
                var isVip = vipStatus != null;
                bool isActive = activeComputers.Any(d => string.Equals(d, item.DomainName, StringComparison.OrdinalIgnoreCase));
                var deviceIcon = item.DomainName.ToUpper().Contains("LAPTOP") ? "fa-laptop" :
                item.DomainName.ToUpper().Contains("DESKTOP") ? "fa-desktop" : "fa-computer";

                <div class="device-card bg-white rounded-md shadow-sm overflow-hidden border border-gray-200 hover:shadow-md transition-all duration-200 @(isActive ? "js-is-online" : "js-is-offline")"
                     data-domain="@item.DomainName"
                     data-status="@(isActive ? "online" : "offline")"
                     data-device-id="@item.Id">

                    <!-- Compact Card Header -->
                    <div class="bg-white border-b border-gray-100 p-1.5">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-1 min-w-0 flex-1">
                                <div class="relative flex-shrink-0">
                                    <div class="js-status-icon-bg w-6 h-6 rounded-md flex items-center justify-center @(isActive ? "" : "bg-gray-200")"
                                         style="@(isActive ? "background: linear-gradient(135deg, #B4D334 0%, #8FB829 100%);" : "")">
                                        <i class="fas @deviceIcon js-status-icon @(isActive ? "text-white" : "text-gray-600") text-[9px]"></i>
                                    </div>
                                    <span class="temp-protection-badge hidden absolute -top-1 -right-1 w-2 h-2 bg-orange-500 rounded-full border border-white"></span>
                                    <span class="critical-user-crown hidden absolute -top-1 -left-1 w-3 h-3 bg-yellow-400 rounded-full border border-white flex items-center justify-center shadow-sm">
                                        <i class="fas fa-crown text-[6px] text-white"></i>
                                    </span>
                                </div>
                                <div class="min-w-0 flex-1 deshboard-name-cell" data-id="@item.Id" data-domain-id="@item.UserCode"
                                     data-company-id="@item.CompanyId" data-group-id="@item.GroupId" data-location-id="@item.LocationId">
                                    <div class="display-name-section">
                                        <a href="/ComputerSummary/Index?domain=@item.UserCode"
                                           class="text-[10px] font-bold text-gray-900 transition-colors block truncate" style="text-decoration:none;"
                                           title="@item.UserName">
                                            @(string.IsNullOrEmpty(item.UserName) ? "Unknown" : item.UserName)
                                        </a>
                                        <div class="flex items-center">
                                            <p class="text-[8px] text-gray-500 truncate">@item.AccountType</p>
                                            @if (ManageEngineWebApp.Datacontext.RoleHelper.HasPermission(Context, "ComputerSummary.Edit"))
                                            {
                                                <button class="edit-name-btn ml-1 text-gray-400 hover:text-blue-500 transition-colors">
                                                    <i class="fas fa-edit text-[7px]"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                    <div class="edit-section hidden mt-1">
                                        <input type="text" class="edit-name w-full px-1 py-0.5 border border-gray-300 rounded text-[9px] mb-0.5" value="@item.UserName" />
                                        <div class="flex gap-0.5">
                                            <button class="update-btn flex-1 px-1.5 py-0.5 text-white rounded text-[8px] font-medium"
                                                    style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                                                Save
                                            </button>
                                            <button class="cancel-edit-btn flex-1 px-1.5 py-0.5 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded text-[8px] font-medium">
                                                Cancel
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center space-x-0.5 flex-shrink-0">
                                <span class="status-badge px-1 py-0.5 text-[8px] rounded-full flex items-center @(isActive ? "text-white font-bold" : "bg-gray-200 text-gray-700 font-semibold")"
                                      style="@(isActive ? "background: linear-gradient(135deg, #B4D334 0%, #8FB829 100%);" : "")"
                                      data-online-html='<span class="w-1 h-1 bg-white rounded-full mr-0.5 animate-pulse"></span>online'
                                      data-offline-html='offline'>
                                    @if (isActive)
                                    {
                                        <span class="w-1 h-1 bg-white rounded-full mr-0.5 animate-pulse"></span>

                                        @:online
                                    }
                                    else
                                    {
                                        @:offline
                                    }
                                </span>
                                @if (ManageEngineWebApp.Datacontext.RoleHelper.HasPermission(Context, "ComputerSummary.OTP"))
                                {
                                    <div class="relative device-menu">
                                        <button class="menu-toggle w-4 h-4 rounded-md hover:bg-gray-100 flex items-center justify-center transition-colors"
                                                onclick="toggleMenu(this)">
                                            <i class="fas fa-ellipsis-v text-gray-600 text-[7px]"></i>
                                        </button>
                                        <div class="menu-dropdown hidden absolute right-0 mt-1 w-32 bg-white rounded-md shadow-lg border border-gray-200 z-50">
                                            <div class="py-0.5">
                                                <button class="temp-protection-toggle w-full px-2 py-1 text-left text-[9px] hover:bg-gray-50 flex items-center justify-between transition-colors @(isActive ? "text-gray-700" : "text-gray-400 cursor-not-allowed")"
                                                        onclick="toggleTempProtection(this, '@item.DomainName', '@item.Id')"
                                                        @(isActive ? "" : "disabled")>
                                                    <span class="flex items-center">
                                                        <i class="fas fa-shield-alt text-orange-500 mr-1 text-[8px]"></i>
                                                        <span>Protection</span>
                                                    </span>
                                                    <span class="protection-status text-[8px] font-semibold px-1 py-0.5 rounded-full bg-gray-200 text-gray-600">OFF</span>
                                                </button>
                                                <button class="view-otp-btn w-full px-2 py-1 text-left text-[9px] text-blue-600 hover:bg-blue-50 flex items-center transition-colors hidden"
                                                        onclick="viewOtpCode('@item.DomainName')">
                                                    <i class="fas fa-eye mr-1 text-[8px]"></i>
                                                    <span>View OTP</span>
                                                </button>
                                                <button class="usb-protection-toggle w-full px-2 py-1 text-left text-[9px] hover:bg-gray-50 flex items-center justify-between transition-colors @(isActive ? "text-gray-700" : "text-gray-400 cursor-not-allowed")"
                                                        onclick="toggleUsbRestriction(this, '@item.DomainName', '@item.Id')"
                                                        @(isActive ? "" : "disabled")>
                                                    <span class="flex items-center">
                                                        <i class="fas fa-usb text-blue-500 mr-1 text-[8px]"></i>
                                                        <span>USB Lock</span>
                                                    </span>
                                                    <span class="usb-status text-[8px] font-semibold px-1 py-0.5 rounded-full bg-gray-200 text-gray-600">OFF</span>
                                                </button>
                                                <button class="critical-settings-btn w-full px-2 py-1 text-left text-[9px] hover:bg-gray-50 flex items-center justify-between transition-colors"
                                                        onclick="openCriticalSettings('@item.DomainName', '@item.Id', '@item.UserName', @isVip.ToString().ToLower(), @(vipStatus?.CpuThreshold ?? 0), @(vipStatus?.RamThreshold ?? 0), @(vipStatus?.DiskThreshold ?? 0))">
                                                    <span class="flex items-center">
                                                        <i class="fas fa-crown text-yellow-500 mr-1 text-[8px]"></i>
                                                        <span>VIP Settings</span>
                                                    </span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Compact Card Body -->
                    <div class="p-1.5 bg-white">
                        <div class="mb-1 pb-1 border-b border-gray-100">
                            <p class="text-[8px] font-medium text-gray-500 uppercase tracking-wide mb-0">Domain</p>
                            <p class="text-[9px] font-semibold text-gray-900 truncate" title="@item.DomainName">@item.DomainName</p>
                        </div>

                        <div class="grid grid-cols-2 gap-1 text-[9px] mb-1.5">
                            <div>
                                <p class="text-gray-500 mb-0">IP Address</p>
                                <p class="font-semibold text-gray-900 ip-address-value">
                                    <i class="fas fa-circle-notch fa-spin text-gray-400 text-[8px]"></i>
                                </p>
                            </div>
                        </div>

                        <!-- Usage View (Shown when online) -->
                        <div class="js-online-view space-y-1 mb-1.5 @(isActive ? "" : "hidden")">
                            <div class="flex items-center justify-between mb-0.5">
                                <span class="text-[8px] font-semibold text-gray-700 uppercase tracking-wide">System Usage</span>
                                <button class="refresh-usage-btn w-4 h-4 rounded-md flex items-center justify-center hover:bg-gray-100 transition-colors"
                                        title="Refresh Usage Data">
                                    <i class="fas fa-sync-alt text-gray-500 text-[7px]"></i>
                                </button>
                            </div>
                            <div>
                                <div class="flex justify-between text-[8px] mb-0">
                                    <span class="text-gray-600 font-medium"><i class="fas fa-microchip mr-0.5" style="color: #00BCEB;"></i>CPU</span>
                                    <span class="font-bold text-gray-900 cpu-value">--</span>
                                </div>
                                <div class="w-full bg-gray-200 rounded-full h-0.5">
                                    <div class="cpu-bar h-0.5 rounded-full transition-all duration-300" style="width: 0%; background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between text-[8px] mb-0">
                                    <span class="text-gray-600 font-medium"><i class="fas fa-memory mr-0.5 text-orange-500"></i>RAM</span>
                                    <span class="font-bold text-gray-900 ram-value">--</span>
                                </div>
                                <div class="w-full bg-gray-200 rounded-full h-0.5">
                                    <div class="ram-bar bg-orange-500 h-0.5 rounded-full transition-all duration-300" style="width: 0%;"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between text-[8px] mb-0">
                                    <span class="text-gray-600 font-medium"><i class="fas fa-hdd mr-0.5" style="color: #B4D334;"></i>Disk</span>
                                    <span class="font-bold text-gray-900 disk-value">--</span>
                                </div>
                                <div class="w-full bg-gray-200 rounded-full h-0.5">
                                    <div class="disk-bar h-0.5 rounded-full transition-all duration-300" style="width: 0%; background: linear-gradient(135deg, #B4D334 0%, #8FB829 100%);"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Offline View (Shown when offline) -->
                        <div class="js-offline-view text-center py-2 bg-gray-50 rounded-md border border-gray-100 mb-1.5 @(isActive ? "hidden" : "")">
                            <i class="fas fa-moon text-gray-300 text-xs mb-0.5"></i>
                            <p class="text-[8px] text-gray-500 font-medium">Device Offline</p>
                            <p class="last-seen-section text-[8px] text-gray-400 mt-0.5" data-domain="@item.DomainName">
                                <i class="fas fa-clock mr-0.5"></i>
                                <span class="last-seen-text">Loading...</span>
                            </p>
                        </div>

                        <div class="flex gap-0.5">
                            @if (ManageEngineWebApp.Datacontext.RoleHelper.HasPermission(Context, "ComputerSummary.Chat"))
                            {
                                <a href="javascript:void(0)" onclick="window.openChatModal('@item.DomainName')" data-chat-domain="@item.DomainName" class="open-chat-btn relative flex-none p-1 bg-indigo-50 text-indigo-600 rounded-md hover:bg-indigo-100 transition-colors" title="Chat with Client">
                                    <i class="fas fa-comment-dots text-[9px]"></i>
                                    <span class="chat-unread-badge hidden">0</span>
                                </a>
                            }
                            @if (ManageEngineWebApp.Datacontext.RoleHelper.HasPermission(Context, "ComputerSummary.Scan"))
                            {
                                <button class="rescan-link flex-1 px-1.5 py-1 bg-orange-500 hover:bg-orange-600 text-white rounded-md text-[8px] font-semibold transition-all @(isActive ? "" : "opacity-50 cursor-not-allowed")"
                                        data-domain="@item.DomainName"
                                        @(isActive ? "" : "disabled")>
                                    <span class="rescan-text"><i class="fas fa-sync-alt mr-0.5 text-[7px]"></i><span class="js-txt">@(isActive ? "Rescan" : "Offline")</span></span>
                                </button>
                            }
                            @if (ManageEngineWebApp.Datacontext.RoleHelper.HasPermission(Context, "ComputerSummary.RemoteAccess"))
                            {
                                <button class="remote-link flex-1 px-1.5 py-1 text-white rounded-md text-[8px] font-semibold transition-all @(isActive ? "" : "opacity-50 cursor-not-allowed")"
                                        style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);"
                                        data-domain="@item.DomainName"
                                        @(isActive ? "" : "disabled")>
                                    <span class="remote-text"><i class="fas fa-desktop mr-0.5 text-[7px]"></i><span class="js-txt">@(isActive ? "Remote" : "Offline")</span></span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-8 bg-white rounded-md border border-gray-200 shadow-sm">
            <i class="fas fa-desktop text-3xl text-gray-300 mb-2"></i>
            <p class="text-gray-500 text-xs">No devices registered for this location yet</p>
        </div>
    }
</div>

    <!-- VIP Settings Modal -->
    <div id="vipSettingsModal" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 p-3 hidden items-center justify-center">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm overflow-hidden border border-gray-100">
            <div class="p-3 border-b border-gray-100 flex justify-between items-center" style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                <div class="flex items-center gap-2">
                    <div class="w-7 h-7 bg-white/20 rounded-lg flex items-center justify-center">
                        <i class="fas fa-crown text-white text-xs"></i>
                    </div>
                    <div>
                        <h3 class="text-xs font-bold text-white">VIP Monitoring Settings</h3>
                        <p id="vipDeviceName" class="text-[8px] text-white/80 font-mono"></p>
                    </div>
                </div>
                <button onclick="closeVipModal()" class="text-white/80 hover:text-white transition-colors">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="p-4 space-y-4">
                <input type="hidden" id="vipDeviceId" />
                <input type="hidden" id="vipDomain" />

                <div class="flex items-center justify-between p-3 bg-amber-50 rounded-lg border border-amber-100">
                    <div>
                        <p class="text-xs font-bold text-amber-900">Mark as VIP User</p>
                        <p class="text-[9px] text-amber-700">Enable prioritized resource monitoring</p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="vipIsCritical" class="sr-only peer">
                        <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-amber-500"></div>
                    </label>
                </div>

                <div class="space-y-3">
                    <h4 class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Custom Thresholds (%)</h4>
                    <div class="grid grid-cols-3 gap-3">
                        <div>
                            <label class="block text-[9px] font-bold text-gray-500 mb-1">CPU</label>
                            <input type="number" id="vipCpu" step="0.1" placeholder="90" class="w-full px-2 py-1.5 text-xs border border-gray-300 rounded-lg focus:ring-1 focus:ring-blue-500 outline-none" />
                        </div>
                        <div>
                            <label class="block text-[9px] font-bold text-gray-500 mb-1">RAM</label>
                            <input type="number" id="vipRam" step="0.1" placeholder="85" class="w-full px-2 py-1.5 text-xs border border-gray-300 rounded-lg focus:ring-1 focus:ring-blue-500 outline-none" />
                        </div>
                        <div>
                            <label class="block text-[9px] font-bold text-gray-500 mb-1">DISK</label>
                            <input type="number" id="vipDisk" step="0.1" placeholder="95" class="w-full px-2 py-1.5 text-xs border border-gray-300 rounded-lg focus:ring-1 focus:ring-blue-500 outline-none" />
                        </div>
                    </div>
                    <p class="text-[8px] text-gray-400 italic mt-1">Leave empty to use location or system defaults.</p>
                </div>

                <div class="flex gap-2 pt-2">
                    <button onclick="closeVipModal()" class="flex-1 px-4 py-2 bg-gray-50 hover:bg-gray-100 text-gray-700 rounded-lg text-xs font-bold border border-gray-200 transition-all">
                        Cancel
                    </button>
                    <button onclick="saveVipSettings()" id="saveVipBtn" class="flex-1 px-4 py-2 text-white rounded-lg text-xs font-bold shadow-lg shadow-blue-500/20 transition-all" style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                        Save Settings
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="tempProtectionModal" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 p-3" style="display:none; align-items:center; justify-content:center;">
        <div class="bg-white rounded-lg shadow-2xl w-full max-w-xs overflow-hidden">
        <div class="px-3 py-2 bg-gradient-to-r from-orange-500 to-red-500">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <div class="w-7 h-7 bg-white/20 rounded-md flex items-center justify-center mr-2">
                        <i class="fas fa-shield-alt text-white text-xs"></i>
                    </div>
                    <div>
                        <h3 class="text-xs font-bold text-white">Protection Code</h3>
                        <p id="modalDeviceName" class="text-[9px] text-white/80 truncate max-w-[130px]"></p>
                    </div>
                </div>
                <button onclick="closeProtectionModal()" class="w-5 h-5 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center">
                    <i class="fas fa-times text-white text-[9px]"></i>
                </button>
            </div>
        </div>
        <div class="p-3">
            <div class="bg-gradient-to-br from-gray-50 to-orange-50 rounded-md p-3 mb-2 border border-orange-100 text-center">
                <p class="text-[8px] text-gray-500 uppercase tracking-widest mb-0.5">Verification Code</p>
                <div id="accessCode" class="text-xl font-bold text-gray-900 tracking-[0.3em] font-mono min-h-[28px] flex items-center justify-center">
                </div>
                <div id="timerSection" class="mt-1 hidden">
                    <div class="flex items-center justify-center space-x-0.5">
                        <i class="fas fa-clock text-orange-500 text-[8px]"></i>
                        <span id="countdownTimer" class="text-[10px] font-bold text-orange-600">01:00</span>
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-0.5 mt-1">
                        <div id="timerBar" class="bg-gradient-to-r from-orange-500 to-red-500 h-0.5 rounded-full transition-all" style="width: 100%"></div>
                    </div>
                </div>
                <p id="expiryInfo" class="text-[9px] text-gray-500 mt-1"></p>
                <p class="text-[9px] text-orange-600 mt-0.5 font-medium">
                    <i class="fas fa-shield-alt mr-0.5"></i> Protection: <span id="protectionStatusText">Active</span>
                </p>
            </div>

            <button id="generateBtn" onclick="generateOrRegenerateOtp()"
                    class="w-full mb-2 px-2 py-1.5 bg-green-500 hover:bg-green-600 text-white rounded-md text-[10px] font-semibold transition-colors flex items-center justify-center disabled:bg-gray-400 disabled:cursor-not-allowed">
                <i class="fas fa-key mr-1"></i>Generate OTP
            </button>

            <div class="grid grid-cols-2 gap-1.5 mb-1.5">
                <button onclick="copyCode()"
                        id="copyCodeBtn"
                        class="px-2 py-1 bg-orange-500 hover:bg-orange-600 text-white rounded-md text-[10px] font-semibold transition-colors disabled:bg-gray-400 disabled:cursor-not-allowed"
                        disabled>
                    <i class="fas fa-copy mr-1"></i>Copy
                </button>
                <button onclick="closeProtectionModal()"
                        class="px-2 py-1 text-white rounded-md text-[10px] font-semibold"
                        style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                    <i class="fas fa-check mr-1"></i>Done
                </button>
            </div>

            <div class="mt-2 pt-2 border-t border-gray-200">
                <p class="text-[9px] text-gray-600 text-center">
                    <i class="fas fa-info-circle mr-0.5 text-blue-500"></i>
                    Protection remains active until manually turned off
                </p>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        var currentProtectionDomain = null;
        var countdownInterval = null;
        var connectedDevicesList = @Html.Raw(Json.Serialize(ViewBag.ActiveComputers ?? new List<string>()));
        var tempProtectionStates = {};
        var domainUserMap = {
        @foreach (var item in Model)
        {
                            var domainKey = item.DomainName?.Trim().ToUpper() ?? "";
                            var name = string.IsNullOrEmpty(item.UserName) ? "Unknown" : item.UserName;
                            if (!string.IsNullOrEmpty(domainKey))
                            {
                                                @: "@domainKey": "@name",
                            }
        }
        };

        function getUserNameFromDomain(domain) {
            if (!domain) return "";
            var key = domain.toUpperCase().trim();
            return domainUserMap[key] || "";
        }


        function getCurrentMachineId() {
            var card = $('.device-card').first();
            return card.data('domain');
        }

        var allCriticalClients = [];

        $(document).ready(function () {
            updateLocationBadgeUI(isLocationCurrentlyCritical); // Update UI immediately from ViewBag value
            loadLocationCriticalStatus(); // Still fetch to be sure
            loadCriticalClientsList();
            checkOtpStatusOnLoad();

            $('.device-card').each(function() {
                var card = $(this);
                var domain = card.data('domain');
                var isOnline = card.data('status') === 'online';

                $.get('@Url.Action("GetUserDetailsJson", "ComputerSummary")',
                    { domain: domain },
                    function(r) {
                        card.find('.ip-address-value').text(r.success ? r.ipAddress : 'N/A');
                    }
                ).fail(function() {
                    card.find('.ip-address-value').text('N/A');
                });

                if (isOnline) {
                    loadSystemUsageData(card, domain);
                } else {
                    loadLastSeenTime(card, domain);
                }
            });
        });

        let isLocationCurrentlyCritical = @(ViewBag.IsLocationCritical != null ? (ViewBag.IsLocationCritical ? "true" : "false") : "false");

        function loadLocationCriticalStatus() {
             $.get('@Url.Action("GetLocationCriticalStatus", "ComputerSummary")',
                { locationId: @ViewBag.locationid },
                function(res) {
                    isLocationCurrentlyCritical = res && res.isCritical;
                    updateLocationBadgeUI(isLocationCurrentlyCritical);
                });
        }

        function updateLocationBadgeUI(isCritical) {
            if (isCritical) {
                $('#locationCriticalBadge').removeClass('hidden');
                $('#locationNotCriticalBadge').addClass('hidden');
            } else {
                $('#locationCriticalBadge').addClass('hidden');
                $('#locationNotCriticalBadge').removeClass('hidden');
            }
        }

        function toggleCurrentLocationCriticality() {
            const newStatus = !isLocationCurrentlyCritical;
            const msg = newStatus
                ? "Mark this entire location as CRITICAL? This will start monitoring resource health for all machines here."
                : "Remove critical status from this location? (Individual VIP overrides will remain)";

            sysConfirm(msg, function() {
                const $btn = $('#locationCriticalToggle');
                $btn.find('i').addClass('fa-spin');

                $.ajax({
                    url: '@Url.Action("Locationupdate", "Companies")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        Id: @ViewBag.locationid,
                        IsCritical: newStatus,
                        GroupsID: @ViewBag.groupid,
                        CompanyID: @ViewBag.companyid,
                        LocationName: '@ViewBag.locationName'
                    }),
                    success: function() {
                        isLocationCurrentlyCritical = newStatus;
                        updateLocationBadgeUI(newStatus);
                        loadCriticalClientsList();
                        sysAlert('Location status updated.', 'success');
                    },
                    error: function() {
                        sysAlert('Failed to update location status.', 'error');
                    },
                    complete: function() {
                        $btn.find('i').removeClass('fa-spin');
                    }
                });
            });
        }

        function loadCriticalClientsList() {
            $.get('@Url.Action("GetCriticalClients", "ComputerSummary")',
                { companyId: @ViewBag.companyid, groupId: @ViewBag.groupid, locationId: @ViewBag.locationid },
                function(res) {
                    if (res && res.success && res.data) {
                        allCriticalClients = res.data;
                        markCriticalDevices();
                    }
                });
        }

        function markCriticalDevices() {
            var criticalIds = new Set(allCriticalClients.map(function(c) {
                return c.clientId.toUpperCase();
            }));
            $('.device-card').each(function() {
                var domain = $(this).data('domain').toUpperCase();
                if (criticalIds.has(domain)) {
                    $(this).find('.critical-user-crown').removeClass('hidden');
                }
            });
        }


        let dashHubConnection = null;

        function startDashboardHub() {
            const apiBase = (window.SYSNET_CONTEXT && window.SYSNET_CONTEXT.apiBaseUrl) || '';
            const hubUrl  = `${apiBase}/scanHub?clientId=Dashboard&computerName=WebPortal`;

            dashHubConnection = new signalR.HubConnectionBuilder()
                .withUrl(hubUrl, {
                    transport: signalR.HttpTransportType.WebSockets
                           | signalR.HttpTransportType.ServerSentEvents
                           | signalR.HttpTransportType.LongPolling
                })
                .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                .build();

            dashHubConnection.on('DeviceStatusChanged', function(connectedDevices) {
                if (Array.isArray(connectedDevices)) {
                    updateDeviceStatuses(connectedDevices);
                }
            });

            dashHubConnection.on('ReceiveConnectedDevices', function(connectedDevices) {
                if (Array.isArray(connectedDevices)) {
                    updateDeviceStatuses(connectedDevices);
                }
            });

            dashHubConnection.on('ScanResultReceived', function(domain, isSuccess, message) {
                const card = $(`.device-card[data-domain="${domain}"]`);
                const link = card.find('.rescan-link');
                
                if (link.length) {
                    link.find('.rescan-text').html(
                        '<i class="fas fa-sync-alt mr-0.5 text-[7px]"></i>' +
                        '<span class="js-txt">Rescan</span>'
                    );
                    link.prop('disabled', false);

                    if (isSuccess) {
                        loadSystemUsageData(card, domain);
                        $.get('@Url.Action("GetUserDetailsJson", "ComputerSummary")', { domain: domain }, function(res) {
                            card.find('.ip-address-value').text(res.success ? res.ipAddress : 'N/A');
                        }).fail(function() { card.find('.ip-address-value').text('N/A'); });
                        sysAlert('Scan complete for ' + domain, 'success');
                    } else {
                        sysAlert('Scan failed for ' + domain + ': ' + message, 'error');
                    }
                }
            });

            dashHubConnection.onreconnected(() => {
                dashHubConnection.invoke('RequestConnectedDevices').catch(() => {});
            });

            dashHubConnection.start()
                .then(() => {
                    return dashHubConnection.invoke('RequestConnectedDevices');
                })
                .catch(err => {
                    console.warn('Hub connection failed, falling back to HTTP poll:', err);
                    fallbackPoll();
                    setTimeout(startDashboardHub, 15000);
                });
        }

        function fallbackPoll() {
            fetch('@Url.Action("GetConnectedDevices", "ComputerSummary")')
                .then(r => r.ok ? r.json() : [])
                .then(devices => { if (Array.isArray(devices)) updateDeviceStatuses(devices); })
                .catch(() => {});
        }

        startDashboardHub();

        let hasReceivedInitialStatusSync = false;

        function updateDeviceStatuses(connectedDevices) {
            if (!Array.isArray(connectedDevices)) return;
            
            if (connectedDevices.length === 0 && !hasReceivedInitialStatusSync) return;

            let onlineCount = 0;
            let offlineCount = 0;

            const onlineSet = new Set(
                connectedDevices.map(d => (d || '').toString().trim().toUpperCase())
            );

            $('.device-card').each(function() {
                const card = $(this);
                const domain = (card.data('domain') || '').toString().trim().toUpperCase();
                const wasOnline = card.data('status') === 'online';

                const isOnline = onlineSet.has(domain);

                if (isOnline) {
                    card.data('miss-count', 0);
                    if (!wasOnline || !hasReceivedInitialStatusSync) {
                        setDeviceStatus(card, true, domain);
                    }
                } else {
                    // Safety: Don't mark as offline if we are currently rescanning this device
                    var rescanText = card.find('.rescan-text').text() || "";
                    if (rescanText.includes('Scanning')) {
                        console.log("Skipping offline status for " + domain + " because scan is in progress.");
                        return; 
                    }

                    let misses = (card.data('miss-count') || 0) + 1;
                    card.data('miss-count', misses);

                    // Increased threshold to 5 misses (approx 25-30s) to prevent flickering during heavy agent tasks
                    if (wasOnline && misses >= 5) {
                        setDeviceStatus(card, false, domain);
                    } else if (!wasOnline && !hasReceivedInitialStatusSync) {
                        setDeviceStatus(card, false, domain);
                    }
                }

                if (card.data('status') === 'online') onlineCount++;
                else offlineCount++;
            });

            $('#onlineCount').text(onlineCount);
            $('#offlineCount').text(offlineCount);

            if (connectedDevices.length > 0) {
                hasReceivedInitialStatusSync = true;
            }
        }

        function setDeviceStatus(card, isOnline, domain) {
            card.data('status', isOnline ? 'online' : 'offline');
            card.attr('data-status', isOnline ? 'online' : 'offline');

            if (isOnline) {
                card.removeClass('js-is-offline').addClass('js-is-online');
                card.find('.js-online-view').removeClass('hidden');
                card.find('.js-offline-view').addClass('hidden');
            } else {
                card.removeClass('js-is-online').addClass('js-is-offline');
                card.find('.js-online-view').addClass('hidden');
                card.find('.js-offline-view').removeClass('hidden');
            }

            const $badge = card.find('.status-badge');
            if (isOnline) {
                $badge.html($badge.data('online-html'))
                      .css('background', 'linear-gradient(135deg, #B4D334 0%, #8FB829 100%)')
                      .removeClass('bg-gray-200 text-gray-700 font-semibold').addClass('text-white font-bold');

                card.find('.js-status-icon-bg').css('background', 'linear-gradient(135deg, #B4D334 0%, #8FB829 100%)').removeClass('bg-gray-200');
                card.find('.js-status-icon').removeClass('text-gray-600').addClass('text-white');
            } else {
                $badge.html($badge.data('offline-html'))
                      .css('background', '')
                      .addClass('bg-gray-200 text-gray-700 font-semibold').removeClass('text-white font-bold');

                card.find('.js-status-icon-bg').css('background', '').addClass('bg-gray-200');
                card.find('.js-status-icon').addClass('text-gray-600').removeClass('text-white');
            }

            card.find('.rescan-link, .remote-link').each(function() {
                const $btn = $(this);
                if (isOnline) {
                    $btn.removeClass('opacity-50 cursor-not-allowed').prop('disabled', false);
                    $btn.find('.js-txt').text($btn.hasClass('rescan-link') ? 'Rescan' : 'Remote');
                } else {
                    $btn.addClass('opacity-50 cursor-not-allowed').prop('disabled', true);
                    $btn.find('.js-txt').text('Offline');
                }
            });

            if (isOnline) {
                loadSystemUsageData(card, domain);
            } else {
                loadLastSeenTime(card, domain);
            }
        }


        function updateCardUI(card, protectionEnabled) {
            var $card = $(card);
            var $badge = $card.find('.protection-status');
            var $viewBtn = $card.find('.view-otp-btn');
            var $protectionBadge = $card.find('.temp-protection-badge');
            var domain = $card.data('domain');

            if (protectionEnabled) {
                $badge.text('ON').removeClass('bg-gray-200 text-gray-600').addClass('bg-orange-500 text-white');
                $protectionBadge.removeClass('hidden');
                $viewBtn.removeClass('hidden');
                tempProtectionStates[domain] = true;
            } else {
                $badge.text('OFF').removeClass('bg-orange-500 text-white').addClass('bg-gray-200 text-gray-600');
                $protectionBadge.addClass('hidden');
                $viewBtn.addClass('hidden');
                delete tempProtectionStates[domain];
            }
        }

        function updateToggleButtonState(card, protectionEnabled) {
            var $card = $(card);
            var $toggleBtn = $card.find('.temp-protection-toggle');
            var $statusBadge = $toggleBtn.find('.protection-status');

            if (protectionEnabled) {
                $statusBadge.text('ON')
                    .removeClass('bg-gray-200 text-gray-600')
                    .addClass('bg-orange-500 text-white');
            } else {
                $statusBadge.text('OFF')
                    .removeClass('bg-orange-500 text-white')
                    .addClass('bg-gray-200 text-gray-600');
            }
        }

        async function checkOtpStatusOnLoad() {
            var onlineDevices = $('.device-card[data-status="online"]');

            for (let i = 0; i < onlineDevices.length; i++) {
                var $card = $(onlineDevices[i]);
                var domain = $card.data('domain');

                try {
                    var response = await fetch(`@Url.Action("GetOtpCode", "ComputerSummary")?machineId=${encodeURIComponent(domain)}`);
                    var result = await response.json();

                    if (result.success && result.otp && !result.isUsed) {
                        var expireTime;
                        if (result.expireAt) {
                            var dateStr = result.expireAt.toString();
                            expireTime = Date.parse(dateStr);

                            if (isNaN(expireTime)) {
                                var d = new Date(dateStr);
                                expireTime = d.getTime();
                            }

                            if (isNaN(expireTime)) {
                                dateStr = dateStr.replace(' ', 'T');
                                expireTime = Date.parse(dateStr);
                            }
                        }

                        if (!isNaN(expireTime) && expireTime > Date.now()) {
                            updateCardUI($card, true);
                            updateToggleButtonState($card, true);
                        }
                    }
                } catch (e) {
                }
            }
        }

        setInterval(function() {
            Object.keys(tempProtectionStates).forEach(async function(domain) {
                try {
                    var response = await fetch(`@Url.Action("GetOtpCode", "ComputerSummary")?machineId=${encodeURIComponent(domain)}`);
                    var result = await response.json();

                    var $card = $(`.device-card[data-domain="${domain}"]`);

                    if (!result.success || !result.otp || result.isUsed) {
                        updateCardUI($card, false);
                        updateToggleButtonState($card, false);
                        return;
                    }

                    if (result.expireAt) {
                        var dateStr = result.expireAt.toString();
                        var expireTime = Date.parse(dateStr);

                        if (isNaN(expireTime)) {
                            var d = new Date(dateStr);
                            expireTime = d.getTime();
                        }

                        if (isNaN(expireTime)) {
                            dateStr = dateStr.replace(' ', 'T');
                            expireTime = Date.parse(dateStr);
                        }

                        if (!isNaN(expireTime) && expireTime <= Date.now()) {
                            updateCardUI($card, false);
                            updateToggleButtonState($card, false);
                        }
                    }
                } catch (e) {
                }
            });
        }, 30000);

        $(document).on('click', function(e) {
            if (!$(e.target).closest('.device-menu').length) {
                $('.menu-dropdown').addClass('hidden');
            }
        });

        function toggleMenu(button) {
            var evt = window.event;
            if (evt) evt.stopPropagation();

            var menu = $(button).next('.menu-dropdown');
            $('.menu-dropdown').not(menu).addClass('hidden');
            menu.toggleClass('hidden');
        }

        function openCriticalSettings(domain, id, name, isCritical, cpu, ram, disk) {
            var evt = window.event;
            if (evt) evt.stopPropagation();
            
            $('#vipDomain').val(domain);
            $('#vipDeviceId').val(id);
            $('#vipDeviceName').text(`${name} (${domain})`);
            $('#vipIsCritical').prop('checked', isCritical === true);
            $('#vipCpu').val(cpu > 0 ? cpu : '');
            $('#vipRam').val(ram > 0 ? ram : '');
            $('#vipDisk').val(disk > 0 ? disk : '');
            
            $('#vipSettingsModal').removeClass('hidden').addClass('flex');
            $('.menu-dropdown').addClass('hidden');
        }

        function closeVipModal() {
            $('#vipSettingsModal').addClass('hidden').removeClass('flex');
        }

        async function saveVipSettings() {
            const domain = $('#vipDomain').val();
            const id = $('#vipDeviceId').val();
            const isCritical = $('#vipIsCritical').is(':checked');
            const cpu = $('#vipCpu').val();
            const ram = $('#vipRam').val();
            const disk = $('#vipDisk').val();

            const $btn = $('#saveVipBtn');
            const originalText = $btn.text();
            $btn.prop('disabled', true).text('Saving...');

            try {
                const response = await fetch('/ComputerSummary/UpdateCriticalSettings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        ClientId: domain,
                        ClientName: $('#vipDeviceName').text().split(' (')[0],
                        IsVIP: isCritical,
                        CpuThreshold: cpu ? parseFloat(cpu) : null,
                        RamThreshold: ram ? parseFloat(ram) : null,
                        DiskThreshold: disk ? parseFloat(disk) : null
                    })
                });
                const result = await response.json();

                if (result.success) {
                    sysAlert('VIP settings updated successfully', 'success');
                    closeVipModal();
                    // Update the crown icon on the card
                    const $card = $(`.device-card[data-device-id="${id}"]`);
                    if (isCritical) {
                        $card.find('.critical-user-crown').removeClass('hidden');
                    } else {
                        $card.find('.critical-user-crown').addClass('hidden');
                    }
                    // Update data attributes for next open
                    // Note: This is simplified, for a full fix we'd update the onclick string carefully
                    setTimeout(() => location.reload(), 1000); 
                } else {
                    sysAlert('Failed to update: ' + (result.message || 'Unknown error'), 'error');
                }
            } catch (e) {
                sysAlert('Error: ' + e.message, 'error');
            } finally {
                $btn.prop('disabled', false).text(originalText);
            }
        }

        async function toggleUsbRestriction(button, domain, deviceId) {
            var evt = window.event;
            if (evt) evt.stopPropagation();

            var $card = $(button).closest('.device-card');
            var isOnline = $card.data('status') === 'online';

            if (!isOnline) {
                sysAlert('USB control only available for ONLINE devices', 'warning');
                $(button).closest('.menu-dropdown').addClass('hidden');
                return;
            }

            var $statusBadge = $(button).find('.usb-status');
            var isBlocked = $statusBadge.text().trim() === 'ON';

            $(button).closest('.menu-dropdown').addClass('hidden');

            const targetBlock = !isBlocked;
            sysConfirm(`${targetBlock ? 'BLOCK' : 'UNBLOCK'} USB for ${domain}?`, async function() {
                try {
                    const response = await fetch('/DeviceSecurity/ToggleUsbStatus', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ clientId: domain, block: targetBlock })
                    });
                    const result = await response.json();

                    if (result.success) {
                        $statusBadge.text(targetBlock ? 'ON' : 'OFF');
                        $statusBadge.toggleClass('bg-red-100 text-red-700', targetBlock)
                                    .toggleClass('bg-gray-200 text-gray-600', !targetBlock);
                        sysAlert(result.message, 'success');
                    } else {
                        sysAlert('Failed: ' + result.message, 'error');
                    }
                } catch (e) {
                    sysAlert('Error: ' + e.message, 'error');
                }
            });
        }

        async function toggleTempProtection(button, domain, deviceId) {
            var evt = window.event;
            if (evt) evt.stopPropagation();

            var $card = $(button).closest('.device-card');
            var isOnline = $card.data('status') === 'online';

            if (!isOnline) {
                sysAlert('Protection only available for ONLINE devices', 'warning');
                $(button).closest('.menu-dropdown').addClass('hidden');
                return;
            }

            var $statusBadge = $(button).find('.protection-status');
            var isEnabled = $statusBadge.text().trim() === 'ON';

            $(button).closest('.menu-dropdown').addClass('hidden');

            if (isEnabled) {
                sysConfirm(`Disable Temporary Protection for ${domain}?`, async function() {
                    try {
                        var response = await fetch(`@Url.Action("ClearOtpCode", "ComputerSummary")?machineId=${encodeURIComponent(domain)}`);
                        var result = await response.json();

                        if (result.success) {
                            updateCardUI($card, false);
                            updateToggleButtonState($card, false);
                            sysAlert('Temporary Protection disabled', 'success');
                        } else {
                            sysAlert('Failed to disable protection: ' + (result.error || 'Unknown error'), 'error');
                        }
                    } catch (e) {
                        sysAlert('Error: ' + e.message, 'error');
                    }
                });
            } else {
                try {
                    var response = await fetch(`@Url.Action("EnableTempProtection", "ComputerSummary")?machineId=${encodeURIComponent(domain)}`);
                    var result = await response.json();

                    if (result.success || result.message) {
                        updateCardUI($card, true);
                        updateToggleButtonState($card, true);
                        showProtectionModal(domain);
                    } else {
                        sysAlert('Failed to enable protection: ' + (result.error || 'Client not connected'), 'error');
                    }
                } catch (e) {
                    sysAlert('Error: ' + e.message, 'error');
                }
            }
        }

        function viewOtpCode(domain) {
            var evt = window.event;
            if (evt) evt.stopPropagation();
            $('.menu-dropdown').addClass('hidden');
            showProtectionModal(domain);
        }

        async function showProtectionModal(domain) {
            currentProtectionDomain = domain;
            $('#modalDeviceName').text(domain);
            $('#tempProtectionModal').css('display','flex');
            updateProtectionStatusText();
            resetGenerateButton();
            await fetchOtpCode(domain);
        }

        function updateProtectionStatusText() {
            if (tempProtectionStates[currentProtectionDomain]) {
                $('#protectionStatusText').text('Active').removeClass('text-red-600').addClass('text-green-600');
            } else {
                $('#protectionStatusText').text('Inactive').removeClass('text-green-600').addClass('text-red-600');
            }
        }

        function closeProtectionModal() {
            $('#tempProtectionModal').css('display','none');
            if (countdownInterval) {
                clearInterval(countdownInterval);
                countdownInterval = null;
            }
            currentProtectionDomain = null;
        }

        async function generateOrRegenerateOtp() {
            if (!currentProtectionDomain) return;

            var btn = $('#generateBtn');
            if (!btn.prop('disabled')) {
                await generateNewCode();
            }
        }

        async function generateNewCode() {
            if (!currentProtectionDomain) return;

            var btn = $('#generateBtn');
            var originalHtml = btn.html();

            btn.html('<i class="fas fa-spinner fa-spin mr-2"></i>Generating...').prop('disabled', true);

            try {
                var response = await fetch(`@Url.Action("GenerateOtpCode", "ComputerSummary")?machineId=${encodeURIComponent(currentProtectionDomain)}`);
                var result = await response.json();

                if (result.success && result.otp) {
                    var expireAt = result.expiry ? new Date(result.expiry).getTime() : (Date.now() + 60000);

                    displayOtp(result.otp, expireAt, false);
                    updateGenerateButtonWithTimer();
                    startCountdownTimer(expireAt);

                    $('#expiryInfo').text('New OTP generated! Valid for 1 hour.').addClass('text-green-600');
                    setTimeout(function() {
                        $('#expiryInfo').removeClass('text-green-600').text('');
                    }, 3000);
                } else {
                    $('#expiryInfo').text('Failed: ' + (result.error || 'Unknown error')).addClass('text-red-500');
                    resetGenerateButton();
                }
            } catch (e) {
                $('#expiryInfo').text('Error: ' + e.message).addClass('text-red-500');
                resetGenerateButton();
            }
        }

        async function fetchOtpCode(domain) {
            $('#accessCode').html('<i class="fas fa-spinner fa-spin text-gray-400"></i>');
            $('#expiryInfo').text('Checking for existing code...');
            $('#timerSection').addClass('hidden');
            $('#copyCodeBtn').addClass('opacity-50 cursor-not-allowed').prop('disabled', true);

            try {
                var response = await fetch(`@Url.Action("GetOtpCode", "ComputerSummary")?machineId=${encodeURIComponent(domain)}`);
                var result = await response.json();

                if (result.success && result.otp) {
                    var isUsed = result.isUsed || false;

                    if (isUsed) {
                        showNoOtpState();
                        return;
                    }

                    var expireTime;
                    if (result.expireAt) {
                        var dateStr = result.expireAt.toString();
                        expireTime = Date.parse(dateStr);

                        if (isNaN(expireTime)) {
                            var d = new Date(dateStr);
                            expireTime = d.getTime();
                        }

                        if (isNaN(expireTime)) {
                            dateStr = dateStr.replace(' ', 'T');
                            expireTime = Date.parse(dateStr);
                        }
                    }

                    if (!isNaN(expireTime) && expireTime > Date.now()) {
                        displayOtp(result.otp, expireTime, false);
                        updateGenerateButtonWithTimer();
                        startCountdownTimer(expireTime);

                        $('#expiryInfo').text('Code loaded from server').addClass('text-green-600');
                        setTimeout(function() {
                            $('#expiryInfo').removeClass('text-green-600').text('');
                        }, 2000);
                        return;
                    }
                }

                showNoOtpState();
            } catch (e) {
                showNoOtpState();
            }
        }

        function showNoOtpState() {
            $('#accessCode').html('<span class="text-gray-400 text-sm">No active code</span>');
            $('#expiryInfo').text('Generate OTP when needed');
            $('#timerSection').addClass('hidden');
            $('#copyCodeBtn').addClass('opacity-50 cursor-not-allowed').prop('disabled', true);
            resetGenerateButton();
        }

        function displayOtp(otp, expireAt, isExpired) {
            var accessCodeEl = $('#accessCode');
            var copyBtn = $('#copyCodeBtn');

            if (isExpired) {
                accessCodeEl.html('<span class="text-red-500 text-sm">Code Expired</span>');
                copyBtn.addClass('opacity-50 cursor-not-allowed').prop('disabled', true);
                $('#expiryInfo').text('OTP expired. Generate new code when needed.').addClass('text-red-500');
                resetGenerateButton();
            } else {
                accessCodeEl.text(otp).addClass('text-2xl font-bold tracking-widest');
                copyBtn.removeClass('opacity-50 cursor-not-allowed').prop('disabled', false);
                $('#expiryInfo').text('').removeClass('text-red-500 text-green-600');
            }
        }

        function updateGenerateButtonWithTimer() {
            $('#generateBtn')
                .html('<i class="fas fa-clock mr-2"></i><span class="timer-text">01:00</span>')
                .prop('disabled', true)
                .removeClass('bg-green-500 hover:bg-green-600 bg-orange-500 hover:bg-orange-600')
                .addClass('cursor-not-allowed')
                .css({'background':'linear-gradient(135deg,#00BCEB,#0096BE)', 'opacity':'0.75'});
        }

        function updateButtonTimerText(mins, secs) {
            var timerText = String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
            $('#generateBtn').find('.timer-text').text(timerText);
        }

        function resetGenerateButton() {
            $('#generateBtn')
                .html('<i class="fas fa-key mr-2"></i>Generate OTP')
                .prop('disabled', false)
                .removeClass('cursor-not-allowed bg-blue-500 hover:bg-blue-600 bg-orange-500 hover:bg-orange-600')
                .addClass('bg-green-500 hover:bg-green-600')
                .css({'background':'', 'opacity':''});
        }


        function startCountdownTimer(expireAt) {
            var endTime = new Date(expireAt).getTime();
            var startTime = Date.now();
            var totalMs = endTime - startTime;

            $('#timerSection').removeClass('hidden');

            if (countdownInterval) {
                clearInterval(countdownInterval);
            }

            if (totalMs <= 0) {
                handleOtpExpired();
                return;
            }

            countdownInterval = setInterval(function() {
                var remaining = endTime - Date.now();

                if (remaining <= 0) {
                    clearInterval(countdownInterval);
                    countdownInterval = null;
                    handleOtpExpired();
                    return;
                }

                var mins = Math.floor(remaining / 60000);
                var secs = Math.floor((remaining % 60000) / 1000);

                $('#countdownTimer').text(String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0'));

                var percentage = (remaining / totalMs) * 100;
                $('#timerBar').css('width', percentage + '%');

                updateButtonTimerText(mins, secs);
            }, 1000);
        }

        function handleOtpExpired() {
            displayOtp(null, null, true);
            $('#expiryInfo').text('Code expired. Generate new code when needed.').addClass('text-red-500');
            $('#timerSection').addClass('hidden');
            resetGenerateButton();
        }

        function copyCode() {
            var code = $('#accessCode').text().trim();
            if (code && code.length > 0 && code !== 'No active code' && code !== 'Code Expired') {
                navigator.clipboard.writeText(code).then(function() {
                    var btn = $('#copyCodeBtn');
                    btn.html('<i class="fas fa-check mr-1"></i>Copied!')
                        .addClass('bg-green-500')
                        .removeClass('bg-orange-500');

                    setTimeout(function() {
                        btn.html('<i class="fas fa-copy mr-1"></i>Copy')
                            .removeClass('bg-green-500')
                            .addClass('bg-orange-500');
                    }, 1500);
                });
            }
        }

        function loadSystemUsageData(card, domain) {
            if (!domain) {
                setErrorState(card);
                return;
            }

            var cpuValue  = card.find('.cpu-value');
            var ramValue  = card.find('.ram-value');
            var diskValue = card.find('.disk-value');

            cpuValue.html('<i class="fas fa-circle-notch fa-spin text-gray-400 text-xs"></i>');
            ramValue.html('<i class="fas fa-circle-notch fa-spin text-gray-400 text-xs"></i>');
            diskValue.html('<i class="fas fa-circle-notch fa-spin text-gray-400 text-xs"></i>');

            $.ajax({
                url: '@Url.Action("GetRamCpuDiskData", "ComputerSummary")',
                type: 'GET',
                data: { domain: domain },
                timeout: 25000,
                success: function (response) {
                    if (response.status === 'success' && response.data) {
                        var data = response.data;

                        var cpuPercent  = parseFloat(data.cpuUsage);
                        var ramPercent  = parseFloat(data.ramUsage);
                        var diskPercent = parseFloat(data.diskUsage);

                        if (!isNaN(cpuPercent)) {
                            cpuValue.text(cpuPercent.toFixed(1) + '%');
                            card.find('.cpu-bar').css('width', cpuPercent + '%');
                        } else {
                            cpuValue.text('N/A');
                            card.find('.cpu-bar').css('width', '0%');
                        }

                        if (!isNaN(ramPercent)) {
                            ramValue.text(ramPercent.toFixed(1) + '%');
                            card.find('.ram-bar').css('width', ramPercent + '%');
                        } else {
                            ramValue.text('N/A');
                            card.find('.ram-bar').css('width', '0%');
                        }

                        if (!isNaN(diskPercent)) {
                            diskValue.text(diskPercent.toFixed(1) + '%');
                            card.find('.disk-bar').css('width', diskPercent + '%');
                        } else {
                            diskValue.text('N/A');
                            card.find('.disk-bar').css('width', '0%');
                        }
                    } else if (response.status === 'timeout') {
                        setTimeoutState(card);
                    } else {
                        setErrorState(card);
                    }
                },
                error: function (xhr, status) {
                    if (status === 'timeout') {
                        setTimeoutState(card);
                    } else {
                        setErrorState(card);
                    }
                }
            });
        }

        function setErrorState(card) {
            card.find('.cpu-value').text('N/A');
            card.find('.ram-value').text('N/A');
            card.find('.disk-value').text('N/A');
            card.find('.cpu-bar').css('width', '0%');
            card.find('.ram-bar').css('width', '0%');
            card.find('.disk-bar').css('width', '0%');
        }

        function setTimeoutState(card) {
            card.find('.cpu-value').html('<i class="fas fa-clock text-orange-500 text-xs" title="Timeout"></i>');
            card.find('.ram-value').html('<i class="fas fa-clock text-orange-500 text-xs" title="Timeout"></i>');
            card.find('.disk-value').html('<i class="fas fa-clock text-orange-500 text-xs" title="Timeout"></i>');
            card.find('.cpu-bar').css('width', '0%');
            card.find('.ram-bar').css('width', '0%');
            card.find('.disk-bar').css('width', '0%');
        }

        $(document).on('click', '.refresh-usage-btn', function(e) {
            e.preventDefault();
            e.stopPropagation();

            var btn = $(this);
            var card = btn.closest('.device-card');
            var domain = card.data('domain');
            var isOnline = card.data('status') === 'online';

            if (!isOnline) {
                sysAlert('Cannot refresh - device is offline', 'warning');
                return;
            }

            var originalHtml = btn.html();
            btn.html('<i class="fas fa-sync-alt fa-spin text-gray-500 text-xs"></i>')
                .prop('disabled', true);

            loadSystemUsageData(card, domain);

            setTimeout(function() {
                btn.html(originalHtml).prop('disabled', false);
            }, 2000);
        });

        function loadLastSeenTime(card, domain) {
            var lastSeenText = card.find('.last-seen-text');

            $.ajax({
                url: '@Url.Action("GetConnectedDevices", "ComputerSummary")',
                type: 'GET',
                timeout: 5000,
                success: function(devices) {
                    var isOnline = devices.some(d => d.toUpperCase() === domain.toUpperCase());
                    if (isOnline) {
                        lastSeenText.html('<span class="text-green-600 font-semibold">Online Now</span>');
                        return;
                    }
                    fetchLastSeenFromServer(lastSeenText, domain);
                },
                error: function() {
                    fetchLastSeenFromServer(lastSeenText, domain);
                }
            });
        }

        function fetchLastSeenFromServer(lastSeenText, domain) {
            $.ajax({
                url: '@Url.Action("GetLastSeenTime", "ComputerSummary")',
                type: 'GET',
                data: { domain: domain },
                timeout: 10000,
                success: function(response) {
                    if (response.success && response.lastSeen) {
                        var lastSeenDate = new Date(response.lastSeen);
                        var formattedText = formatTimeAgo(lastSeenDate);
                        lastSeenText.html('Last seen: ' + formattedText);
                    } else {
                        lastSeenText.text('Last seen: Never');
                    }
                },
                error: function() {
                    lastSeenText.text('Last seen: Unknown');
                }
            });
        }

        function formatTimeAgo(date) {
            var now = new Date();
            var diffMs = now - date;
            var diffMins = Math.floor(diffMs / 60000);
            var diffHours = Math.floor(diffMs / 3600000);
            var diffDays = Math.floor(diffMs / 86400000);

            if (diffMins < 1) {
                return 'Just now';
            } else if (diffMins < 60) {
                return diffMins + ' minute' + (diffMins !== 1 ? 's' : '') + ' ago';
            } else if (diffHours < 24) {
                return diffHours + ' hour' + (diffHours !== 1 ? 's' : '') + ' ago';
            } else if (diffDays < 7) {
                return diffDays + ' day' + (diffDays !== 1 ? 's' : '') + ' ago';
            } else {
                var options = { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' };
                return date.toLocaleDateString('en-US', options);
            }
        }

        $(document).on('searchEvent', function(e, term) {
            filterDevices(term);
        });

        $('#statusFilter').on('change', function() {
            filterDevices();
        });

        function filterDevices(searchTerm) {
            var term = (searchTerm !== undefined ? searchTerm : $('#globalSearchInput').val()).toLowerCase();
            var status = $('#statusFilter').val();

            $('#devicesGrid .device-card').each(function() {
                var card = $(this);
                var content = card.text().toLowerCase();
                var cardStatus = card.data('status');

                var matchesSearch = content.indexOf(term) > -1;
                var matchesStatus = status === 'all' || status === cardStatus;

                card.toggle(matchesSearch && matchesStatus);
            });
        }

        $(document).on('click', '.edit-name-btn', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var cell = $(this).closest('.deshboard-name-cell');
            cell.find('.display-name-section').hide();
            cell.find('.edit-section').removeClass('hidden');
        });

        $(document).on('click', '.cancel-edit-btn', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var cell = $(this).closest('.deshboard-name-cell');
            cell.find('.edit-section').addClass('hidden');
            cell.find('.display-name-section').show();
        });

        $(document).on('click', '.update-btn', function(e) {
            e.preventDefault();
            e.stopPropagation();

            var cell = $(this).closest('.deshboard-name-cell');
            var newName = cell.find('.edit-name').val().trim();

            if (!newName) {
                sysAlert('Name cannot be empty.', 'warning');
                return;
            }

            var btn = $(this);
            btn.html('<i class="fas fa-spinner fa-spin"></i>').prop('disabled', true);

            $.ajax({
                url: '@Url.Action("deshboardupdate", "ComputerSummary")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    Id: cell.data('id'),
                    DomainName: cell.data('domain-id'),
                    CompanyId: cell.data('company-id'),
                    GroupId: cell.data('group-id'),
                    LocationId: cell.data('location-id'),
                    UserName: newName
                }),
                success: function() {
                    cell.find('.display-name-section a').text(newName);
                    cell.find('.edit-section').addClass('hidden');
                    cell.find('.display-name-section').show();
                },
                error: function() {
                    sysAlert('Error updating name', 'error');
                },
                complete: function() {
                    btn.html('Save').prop('disabled', false);
                }
            });
        });

        $('.rescan-link').on('click', function() {
            if ($(this).prop('disabled')) return;

            var link   = $(this);
            var domain = link.data('domain');
            var card   = link.closest('.device-card');

            link.find('.rescan-text').html('<i class="fas fa-spinner fa-spin mr-0.5"></i>Scanning…');
            link.prop('disabled', true);

            $.post('@Url.Action("Comanddata", "ComputerSummary")?domain=' + domain, function() {
                // Now waiting for SignalR message 'ScanResultReceived'
                // No more setInterval here!
            }).fail(function() {
                link.find('.rescan-text').html(
                    '<i class="fas fa-sync-alt mr-0.5 text-[7px]"></i><span class="js-txt">Rescan</span>'
                );
                link.prop('disabled', false);
                sysAlert('Could not start scan for ' + domain, 'error');
            });
        });

        $('.remote-link').on('click', function() {
            if (!$(this).prop('disabled')) {
                window.location.href = '@Url.Action("Live", "ComputerSummary")?domain=' + $(this).data('domain');
            }
        });

        $(document).on('click', '.open-chat-btn', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var domain = $(this).data('domain');
            if (domain) {
                window.openChatModal(domain);
            }
        });

    </script>


