        async function checkOtpStatusOnLoad() {
            var onlineDevices = $('.device-card[data-status="online"]');

            for (let i = 0; i < onlineDevices.length; i++) {
                var $card = $(onlineDevices[i]);
                var domain = $card.data('domain');

                try {
                    var response = await fetch(`@Url.Action("GetOtpCode", "ComputerSummary")?machineId=${encodeURIComponent(domain)}`);
                    var result = await response.json();

                    if (result.success && result.otp && !result.isUsed) {
                        var expireTime;
                        if (result.expireAt) {
                            var dateStr = result.expireAt.toString();
                            expireTime = Date.parse(dateStr);

                            if (isNaN(expireTime)) {
                                var d = new Date(dateStr);
                                expireTime = d.getTime();
                            }

                            if (isNaN(expireTime)) {
                                dateStr = dateStr.replace(' ', 'T');
                                expireTime = Date.parse(dateStr);
                            }
                        }

                        if (!isNaN(expireTime) && expireTime > Date.now()) {
                            updateCardUI($card, true);
                            updateToggleButtonState($card, true);
                        }
                    }
                } catch (e) {
                }
            }
        }

        setInterval(function() {
            Object.keys(tempProtectionStates).forEach(async function(domain) {
                try {
                    var response = await fetch(`@Url.Action("GetOtpCode", "ComputerSummary")?machineId=${encodeURIComponent(domain)}`);
                    var result = await response.json();

                    var $card = $(`.device-card[data-domain="${domain}"]`);

                    if (!result.success || !result.otp || result.isUsed) {
                        updateCardUI($card, false);
                        updateToggleButtonState($card, false);
                        return;
                    }

                    if (result.expireAt) {
                        var dateStr = result.expireAt.toString();
                        var expireTime = Date.parse(dateStr);

                        if (isNaN(expireTime)) {
                            var d = new Date(dateStr);
                            expireTime = d.getTime();
                        }

                        if (isNaN(expireTime)) {
                            dateStr = dateStr.replace(' ', 'T');
                            expireTime = Date.parse(dateStr);
                        }

                        if (!isNaN(expireTime) && expireTime <= Date.now()) {
                            updateCardUI($card, false);
                            updateToggleButtonState($card, false);
                        }
                    }
                } catch (e) {
                }
