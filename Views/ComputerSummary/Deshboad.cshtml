        async function toggleTempProtection(button, domain, deviceId) {
            var evt = window.event;
            if (evt) evt.stopPropagation();

            var $card = $(button).closest('.device-card');
            var isOnline = $card.data('status') === 'online';

            if (!isOnline) {
                sysAlert('Protection only available for ONLINE devices', 'warning');
                $(button).closest('.menu-dropdown').addClass('hidden');
                return;
