@section Scripts {
    <script>
        var currentProtectionDomain = null;
        var countdownInterval = null;
        var connectedDevicesList = @Html.Raw(Json.Serialize(ViewBag.ActiveComputers ?? new List<string>()));
        var tempProtectionStates = {};
        var domainUserMap = {
        @foreach (var item in Model)
        {
                        var domainKey = item.DomainName?.Trim().ToUpper() ?? "";
                        var name = string.IsNullOrEmpty(item.UserName) ? "Unknown" : item.UserName;
                        if (!string.IsNullOrEmpty(domainKey))
                        {
                                        @: "@domainKey": "@name",
                        }
        }
        };

        function getUserNameFromDomain(domain) {
            if (!domain) return "";
            var key = domain.toUpperCase().trim();
            return domainUserMap[key] || "";
        }

        // ── SPARKLINE ──
        function drawSparkline(canvas, cpuVal, ramVal, diskVal) {
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var w = canvas.offsetWidth || 200;
            var h = canvas.offsetHeight || 36;
            canvas.width = w;
            canvas.height = h;
            ctx.clearRect(0, 0, w, h);

            function makeFakeHistory(currentVal) {
                var pts = []; var v = currentVal;
                for (var i = 0; i < 12; i++) {
                    v = Math.max(0, Math.min(100, v + (Math.random() - 0.5) * 14));
                    pts.unshift(v);
                }
                pts[pts.length - 1] = currentVal;
                return pts;
            }

            var lines = [
                { pts: makeFakeHistory(cpuVal || 0), color: '#00BCEB', alpha: 0.8, width: 1.5 },
                { pts: makeFakeHistory(ramVal || 0), color: '#f97316', alpha: 0.6, width: 1.3 },
                { pts: makeFakeHistory(diskVal || 0), color: '#B4D334', alpha: 0.6, width: 1.3 }
            ];

            lines.forEach(function (line) {
                if (!line.pts || line.pts.every(function (p) { return p === 0; })) return;
                var stepX = w / (line.pts.length - 1);

                // Fill area under line
                ctx.beginPath();
                line.pts.forEach(function (val, i) {
                    var x = i * stepX;
                    var y = h - (val / 100) * (h - 4) - 2;
                    if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
                });
                ctx.lineTo(w, h); ctx.lineTo(0, h); ctx.closePath();
                ctx.globalAlpha = 0.08;
                ctx.fillStyle = line.color;
                ctx.fill();

                // Line
                ctx.beginPath();
                ctx.strokeStyle = line.color;
                ctx.lineWidth = line.width;
                ctx.globalAlpha = line.alpha;
                line.pts.forEach(function (val, i) {
                    var x = i * stepX;
                    var y = h - (val / 100) * (h - 4) - 2;
                    if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
                });
                ctx.stroke();
                ctx.globalAlpha = 1;
            });
        }

        // ── FILTER ──
        function setStatusFilter(status, btn) {
            document.querySelectorAll('.filter-pill').forEach(function (el) { el.classList.remove('active'); });
            btn.classList.add('active');
            filterDevices(undefined, status);
        }

        // ── INIT ──
        $(document).ready(function () {
            loadLocationCriticalStatus();
            checkOtpStatusOnLoad();

            $('.device-card').each(function () {
                var card = $(this);
                var domain = card.data('domain');
                var isOnline = card.data('status') === 'online';

                $.get('@Url.Action("GetUserDetailsJson", "ComputerSummary")', { domain: domain }, function (r) {
                    card.find('.ip-address-value').text(r.success ? r.ipAddress : 'N/A');
                }).fail(function () { card.find('.ip-address-value').text('N/A'); });

                if (isOnline) loadSystemUsageData(card, domain);
                else loadLastSeenTime(card, domain);
            });
        });

        function updateLocationBadgeUI(isCritical) {
            const $indicator = $('.critical-indicator');
            if (isCritical) {
                if ($indicator.length === 0) {
                    $('h1').after('<span class="critical-indicator" title="Critical Location"><i class="fas fa-crown" style="color:#f59e0b;font-size:11px;"></i></span>');
                }
            } else { $indicator.remove(); }
        }

        function loadLocationCriticalStatus() {
            const locId = @(ViewBag.LocationId ?? 0);
            if (!locId) return;
            $.get('@Url.Action("GetLocationCriticalStatus", "ComputerSummary")', { locationId: locId }, function (res) {
                if (res && res.success) updateLocationBadgeUI(res.isCritical);
            });
        }

        let dashHubConnection = null;

        function startDashboardHub() {
            const apiBase = (window.SYSNET_CONTEXT && window.SYSNET_CONTEXT.apiBaseUrl) || '';
            const hubUrl = `${apiBase}/scanHub?clientId=Dashboard&computerName=WebPortal`;

            dashHubConnection = new signalR.HubConnectionBuilder()
                .withUrl(hubUrl, {
                    transport: signalR.HttpTransportType.WebSockets
                           | signalR.HttpTransportType.ServerSentEvents
                           | signalR.HttpTransportType.LongPolling
                })
                .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                .build();

            dashHubConnection.on('DeviceStatusChanged', function (connectedDevices) {
                if (Array.isArray(connectedDevices)) updateDeviceStatuses(connectedDevices);
            });
            dashHubConnection.on('ReceiveConnectedDevices', function (connectedDevices) {
                if (Array.isArray(connectedDevices)) updateDeviceStatuses(connectedDevices);
            });
            dashHubConnection.on('ScanResultReceived', function (domain, isSuccess, message) {
                let card = null;
                $('.device-card').each(function () {
                    const d = $(this).attr('data-domain');
                    if (d && d.toUpperCase() === domain.toUpperCase()) { card = $(this); return false; }
                });
                if (card && card.length) {
                    const link = card.find('.rescan-link');
                    const domainName = card.attr('data-domain');
                    if (link.length) {
                        unregisterActiveRescan(domainName);
                        link.find('.rescan-text').html('<i class="fas fa-sync-alt" style="font-size:7px;"></i><span class="js-txt">Rescan</span>');
                        link.prop('disabled', false);
                        card.removeClass('opacity-75');
                        if (isSuccess) {
                            loadSystemUsageData(card, domainName);
                            $.get('@Url.Action("GetUserDetailsJson", "ComputerSummary")', { domain: domainName }, function (res) {
                                card.find('.ip-address-value').text(res.success ? res.ipAddress : 'N/A');
                            }).fail(function () { card.find('.ip-address-value').text('N/A'); });
                            sysAlert('Scan complete for ' + domainName, 'success');
                        } else { sysAlert('Scan failed for ' + domainName + ': ' + message, 'error'); }
                    }
                }
            });
            dashHubConnection.on('NotificationReceived', function () {
                if (typeof loadNotificationCount === 'function') loadNotificationCount();
            });
            dashHubConnection.onreconnected(() => { dashHubConnection.invoke('RequestConnectedDevices').catch(() => {}); });
            dashHubConnection.start()
                .then(() => dashHubConnection.invoke('RequestConnectedDevices'))
                .catch(err => {
                    console.warn('Hub connection failed, falling back to HTTP poll:', err);
                    fallbackPoll();
                    setTimeout(startDashboardHub, 15000);
                });
        }

        function fallbackPoll() {
            fetch('@Url.Action("GetConnectedDevices", "ComputerSummary")')
                .then(r => r.ok ? r.json() : [])
                .then(devices => { if (Array.isArray(devices)) updateDeviceStatuses(devices); })
                .catch(() => {});
        }

        startDashboardHub();

        let hasReceivedInitialStatusSync = false;

        function updateDeviceStatuses(connectedDevices) {
            if (!Array.isArray(connectedDevices)) return;
            if (connectedDevices.length === 0 && !hasReceivedInitialStatusSync) return;

            let onlineCount = 0, offlineCount = 0;
            const onlineSet = new Set(connectedDevices.map(d => (d || '').toString().trim().toUpperCase()));

            $('.device-card').each(function () {
                const card = $(this);
                const domain = (card.data('domain') || '').toString().trim().toUpperCase();
                const wasOnline = card.data('status') === 'online';
                const isOnline = onlineSet.has(domain);

                if (isOnline) {
                    card.data('miss-count', 0);
                    if (!wasOnline || !hasReceivedInitialStatusSync) setDeviceStatus(card, true, domain);
                } else {
                    var rescanText = card.find('.rescan-text').text() || "";
                    if (rescanText.includes('Scanning')) return;
                    let misses = (card.data('miss-count') || 0) + 1;
                    card.data('miss-count', misses);
                    if (wasOnline && misses >= 5) setDeviceStatus(card, false, domain);
                    else if (!wasOnline && !hasReceivedInitialStatusSync) setDeviceStatus(card, false, domain);
                }

                if (card.data('status') === 'online') onlineCount++; else offlineCount++;
            });

            $('#onlineCount').text(onlineCount);
            $('#offlineCount').text(offlineCount);
            if (connectedDevices.length > 0) hasReceivedInitialStatusSync = true;
        }

        function setDeviceStatus(card, isOnline, domain) {
            card.data('status', isOnline ? 'online' : 'offline');
            card.attr('data-status', isOnline ? 'online' : 'offline');
            card.css('border-color', isOnline ? '#bbf7d0' : '#e5e7eb');

            if (isOnline) {
                card.removeClass('js-is-offline').addClass('js-is-online');
                card.find('.js-online-view').removeClass('hidden');
                card.find('.js-offline-view').addClass('hidden');
                card.find('.card-header-offline').removeClass('card-header-offline').addClass('card-header-online');
                card.find('.device-illus-offline').removeClass('device-illus-offline').addClass('device-illus-online');
                card.find('.online-dot, .offline-dot').attr('class', 'online-dot');
            } else {
                card.removeClass('js-is-online').addClass('js-is-offline');
                card.find('.js-online-view').addClass('hidden');
                card.find('.js-offline-view').removeClass('hidden');
                card.find('.card-header-online').removeClass('card-header-online').addClass('card-header-offline');
                card.find('.device-illus-online').removeClass('device-illus-online').addClass('device-illus-offline');
                card.find('.online-dot, .offline-dot').attr('class', 'offline-dot');
            }

            const $badge = card.find('.status-badge');
            if (isOnline) {
                $badge.html($badge.data('online-html'))
                      .attr('class', 'status-badge status-badge-online')
                      .css({ padding:'2px 7px', borderRadius:'20px', fontSize:'8px', fontWeight:'700', display:'flex', alignItems:'center', gap:'3px' });
            } else {
                $badge.html($badge.data('offline-html'))
                      .attr('class', 'status-badge status-badge-offline')
                      .css({ padding:'2px 7px', borderRadius:'20px', fontSize:'8px', fontWeight:'700', display:'flex', alignItems:'center', gap:'3px' });
            }

            card.find('.rescan-link, .remote-link').each(function () {
                const $btn = $(this);
                if (isOnline) {
                    $btn.css('opacity', '1').prop('disabled', false);
                    $btn.find('.js-txt').text($btn.hasClass('rescan-link') ? 'Rescan' : 'Remote');
                } else {
                    $btn.css('opacity', '.5').prop('disabled', true);
                    $btn.find('.js-txt').text('Offline');
                }
            });

            if (isOnline) loadSystemUsageData(card, domain);
            else loadLastSeenTime(card, domain);
        }

        function updateCardUI(card, protectionEnabled) {
            var $card = $(card);
            var $badge = $card.find('.protection-status');
            var $viewBtn = $card.find('.view-otp-btn');
            var $protectionBadge = $card.find('.temp-protection-badge');
            var domain = $card.data('domain');
            if (protectionEnabled) {
                $badge.text('ON').css({ background: '#f97316', color: '#fff' });
                $protectionBadge.removeClass('hidden');
                $viewBtn.removeClass('hidden');
                tempProtectionStates[domain] = true;
            } else {
                $badge.text('OFF').css({ background: '#f3f4f6', color: '#6b7280' });
                $protectionBadge.addClass('hidden');
                $viewBtn.addClass('hidden');
                delete tempProtectionStates[domain];
            }
        }

        function updateToggleButtonState(card, protectionEnabled) {
            var $card = $(card);
            var $statusBadge = $card.find('.temp-protection-toggle .protection-status');
            if (protectionEnabled) { $statusBadge.text('ON').css({ background: '#f97316', color: '#fff' }); }
            else { $statusBadge.text('OFF').css({ background: '#f3f4f6', color: '#6b7280' }); }
        }

        async function checkOtpStatusOnLoad() {
            var onlineDevices = $('.device-card[data-status="online"]');
            for (let i = 0; i < onlineDevices.length; i++) {
                var $card = $(onlineDevices[i]);
                var domain = $card.data('domain');
                try {
                    var response = await fetch(`@Url.Action("GetOtpCode", "ComputerSummary")?machineId=${encodeURIComponent(domain)}`);
                    var result = await response.json();
                    if (result.success && result.otp && !result.isUsed) {
                        var expireTime;
                        if (result.expireAt) {
                            var dateStr = result.expireAt.toString();
                            expireTime = Date.parse(dateStr);
                            if (isNaN(expireTime)) expireTime = new Date(dateStr).getTime();
                            if (isNaN(expireTime)) expireTime = Date.parse(dateStr.replace(' ', 'T'));
                        }
                        if (!isNaN(expireTime) && expireTime > Date.now()) {
                            updateCardUI($card, true);
                            updateToggleButtonState($card, true);
                        }
                    }
                } catch (e) { }
            }
        }

        $(document).on('click', function (e) {
            if (!$(e.target).closest('.device-menu').length) $('.menu-dropdown').addClass('hidden');
        });

        function toggleMenu(button) {
            var evt = window.event; if (evt) evt.stopPropagation();
            var menu = $(button).next('.menu-dropdown');
            $('.menu-dropdown').not(menu).addClass('hidden');
            menu.toggleClass('hidden');
        }

        async function toggleTempProtection(button, domain, deviceId) {
            var evt = window.event; if (evt) evt.stopPropagation();
            var $card = $(button).closest('.device-card');
            var isOnline = $card.data('status') === 'online';
            if (!isOnline) { sysAlert('Protection only available for ONLINE devices', 'warning'); $(button).closest('.menu-dropdown').addClass('hidden'); return; }
            var $statusBadge = $(button).find('.protection-status');
            var isEnabled = $statusBadge.text().trim() === 'ON';
            $(button).closest('.menu-dropdown').addClass('hidden');
            if (isEnabled) {
                sysConfirm(`Disable Temporary Protection for ${domain}?`, async function () {
                    try {
                        var response = await fetch(`@Url.Action("ClearOtpCode", "ComputerSummary")?machineId=${encodeURIComponent(domain)}`);
                        var result = await response.json();
                        if (result.success) { updateCardUI($card, false); updateToggleButtonState($card, false); sysAlert('Temporary Protection disabled', 'success'); }
                        else { sysAlert('Failed to disable: ' + (result.error || 'Unknown error'), 'error'); }
                    } catch (e) { sysAlert('Error: ' + e.message, 'error'); }
                });
            } else {
                try {
                    var response = await fetch(`@Url.Action("EnableTempProtection", "ComputerSummary")?machineId=${encodeURIComponent(domain)}`);
                    var result = await response.json();
                    if (result.success || result.message) { updateCardUI($card, true); updateToggleButtonState($card, true); showProtectionModal(domain); }
                    else { sysAlert('Failed to enable: ' + (result.error || 'Client not connected'), 'error'); }
                } catch (e) { sysAlert('Error: ' + e.message, 'error'); }
            }
        }

        function viewOtpCode(domain) {
            var evt = window.event; if (evt) evt.stopPropagation();
            $('.menu-dropdown').addClass('hidden');
            showProtectionModal(domain);
        }

        async function showProtectionModal(domain) {
            currentProtectionDomain = domain;
            $('#modalDeviceName').text(domain);
            $('#tempProtectionModal').css('display', 'flex');
            updateProtectionStatusText();
            resetGenerateButton();
            await fetchOtpCode(domain);
        }

        function updateProtectionStatusText() {
            if (tempProtectionStates[currentProtectionDomain]) {
                $('#protectionStatusText').text('Active').removeClass('text-red-600').addClass('text-green-600');
            } else {
                $('#protectionStatusText').text('Inactive').removeClass('text-green-600').addClass('text-red-600');
            }
        }

        function closeProtectionModal() {
            $('#tempProtectionModal').css('display', 'none');
            if (countdownInterval) { clearInterval(countdownInterval); countdownInterval = null; }
            currentProtectionDomain = null;
        }

        async function generateOrRegenerateOtp() {
            if (!currentProtectionDomain) return;
            var btn = $('#generateBtn');
            if (!btn.prop('disabled')) await generateNewCode();
        }

        async function generateNewCode() {
            if (!currentProtectionDomain) return;
            var btn = $('#generateBtn');
            btn.html('<i class="fas fa-spinner fa-spin mr-2"></i>Generating...').prop('disabled', true);
            try {
                var response = await fetch(`@Url.Action("GenerateOtpCode", "ComputerSummary")?machineId=${encodeURIComponent(currentProtectionDomain)}`);
                var result = await response.json();
                if (result.success && result.otp) {
                    var expireAt = result.expiry ? new Date(result.expiry).getTime() : (Date.now() + 60000);
                    displayOtp(result.otp, expireAt, false);
                    updateGenerateButtonWithTimer();
                    startCountdownTimer(expireAt);
                    $('#expiryInfo').text('New OTP generated! Valid for 1 hour.').addClass('text-green-600');
                    setTimeout(function () { $('#expiryInfo').removeClass('text-green-600').text(''); }, 3000);
                } else {
                    $('#expiryInfo').text('Failed: ' + (result.error || 'Unknown error')).addClass('text-red-500');
                    resetGenerateButton();
                }
            } catch (e) { $('#expiryInfo').text('Error: ' + e.message).addClass('text-red-500'); resetGenerateButton(); }
        }

        async function fetchOtpCode(domain) {
            $('#accessCode').html('<i class="fas fa-spinner fa-spin text-gray-400"></i>');
            $('#expiryInfo').text('Checking for existing code...');
            $('#timerSection').addClass('hidden');
            $('#copyCodeBtn').addClass('opacity-50 cursor-not-allowed').prop('disabled', true);
            try {
                var response = await fetch(`@Url.Action("GetOtpCode", "ComputerSummary")?machineId=${encodeURIComponent(domain)}`);
                var result = await response.json();
                if (result.success && result.otp) {
                    var isUsed = result.isUsed || false;
                    if (isUsed) { showNoOtpState(); return; }
                    var expireTime;
                    if (result.expireAt) {
                        var dateStr = result.expireAt.toString();
                        expireTime = Date.parse(dateStr);
                        if (isNaN(expireTime)) expireTime = new Date(dateStr).getTime();
                        if (isNaN(expireTime)) expireTime = Date.parse(dateStr.replace(' ', 'T'));
                    }
                    if (!isNaN(expireTime) && expireTime > Date.now()) {
                        displayOtp(result.otp, expireTime, false);
                        updateGenerateButtonWithTimer();
                        startCountdownTimer(expireTime);
                        $('#expiryInfo').text('Code loaded from server').addClass('text-green-600');
                        setTimeout(function () { $('#expiryInfo').removeClass('text-green-600').text(''); }, 2000);
                        return;
                    }
                }
                showNoOtpState();
            } catch (e) { showNoOtpState(); }
        }

        function showNoOtpState() {
            $('#accessCode').html('<span style="color:#9ca3af;font-size:14px;">No active code</span>');
            $('#expiryInfo').text('Generate OTP when needed');
            $('#timerSection').addClass('hidden');
            $('#copyCodeBtn').addClass('opacity-50 cursor-not-allowed').prop('disabled', true);
            resetGenerateButton();
        }

        function displayOtp(otp, expireAt, isExpired) {
            var accessCodeEl = $('#accessCode'); var copyBtn = $('#copyCodeBtn');
            if (isExpired) {
                accessCodeEl.html('<span style="color:#ef4444;font-size:14px;">Code Expired</span>');
                copyBtn.addClass('opacity-50 cursor-not-allowed').prop('disabled', true);
                $('#expiryInfo').text('OTP expired. Generate new code when needed.').addClass('text-red-500');
                resetGenerateButton();
            } else {
                accessCodeEl.text(otp).addClass('text-2xl font-bold tracking-widest');
                copyBtn.removeClass('opacity-50 cursor-not-allowed').prop('disabled', false);
                $('#expiryInfo').text('').removeClass('text-red-500 text-green-600');
            }
        }

        function updateGenerateButtonWithTimer() {
            $('#generateBtn').html('<i class="fas fa-clock mr-2"></i><span class="timer-text">01:00</span>').prop('disabled', true)
                .removeClass('bg-green-500 hover:bg-green-600').addClass('cursor-not-allowed')
                .css({ 'background': 'linear-gradient(135deg,#00BCEB,#0096BE)', 'opacity': '0.75' });
        }

        function updateButtonTimerText(mins, secs) {
            var t = String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
            $('#generateBtn').find('.timer-text').text(t);
        }

        function resetGenerateButton() {
            $('#generateBtn').html('<i class="fas fa-key mr-1.5"></i>Generate OTP').prop('disabled', false)
                .removeClass('cursor-not-allowed').addClass('bg-green-500 hover:bg-green-600').css({ 'background': '', 'opacity': '' });
        }

        function startCountdownTimer(expireAt) {
            var endTime = new Date(expireAt).getTime();
            var startTime = Date.now();
            var totalMs = endTime - startTime;
            $('#timerSection').removeClass('hidden');
            if (countdownInterval) clearInterval(countdownInterval);
            if (totalMs <= 0) { handleOtpExpired(); return; }
            countdownInterval = setInterval(function () {
                var remaining = endTime - Date.now();
                if (remaining <= 0) { clearInterval(countdownInterval); countdownInterval = null; handleOtpExpired(); return; }
                var mins = Math.floor(remaining / 60000);
                var secs = Math.floor((remaining % 60000) / 1000);
                $('#countdownTimer').text(String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0'));
                $('#timerBar').css('width', (remaining / totalMs) * 100 + '%');
                updateButtonTimerText(mins, secs);
            }, 1000);
        }

        function handleOtpExpired() {
            displayOtp(null, null, true);
            $('#expiryInfo').text('Code expired. Generate new code when needed.').addClass('text-red-500');
            $('#timerSection').addClass('hidden');
            resetGenerateButton();
        }

        function copyCode() {
            var code = $('#accessCode').text().trim();
            if (code && code.length > 0 && code !== 'No active code' && code !== 'Code Expired') {
                navigator.clipboard.writeText(code).then(function () {
                    var btn = $('#copyCodeBtn');
                    btn.html('<i class="fas fa-check mr-1"></i>Copied!').addClass('bg-green-500').removeClass('bg-orange-500');
                    setTimeout(function () { btn.html('<i class="fas fa-copy mr-1"></i>Copy').removeClass('bg-green-500').addClass('bg-orange-500'); }, 1500);
                });
            }
        }

        function loadSystemUsageData(card, domain) {
            if (!domain) { setErrorState(card); return; }
            var cpuValue = card.find('.cpu-value');
            var ramValue = card.find('.ram-value');
            var diskValue = card.find('.disk-value');

            cpuValue.html('<i class="fas fa-circle-notch fa-spin" style="color:#d1d5db;font-size:8px;"></i>');
            ramValue.html('<i class="fas fa-circle-notch fa-spin" style="color:#d1d5db;font-size:8px;"></i>');
            diskValue.html('<i class="fas fa-circle-notch fa-spin" style="color:#d1d5db;font-size:8px;"></i>');

            $.ajax({
                url: '@Url.Action("GetRamCpuDiskData", "ComputerSummary")',
                type: 'GET', data: { domain: domain }, timeout: 25000,
                success: function (response) {
                    if (response.status === 'success' && response.data) {
                        var data = response.data;
                        var cpuPercent = parseFloat(data.cpuUsage);
                        var ramPercent = parseFloat(data.ramUsage);
                        var diskPercent = parseFloat(data.diskUsage);

                        if (!isNaN(cpuPercent)) { cpuValue.text(cpuPercent.toFixed(1) + '%'); card.find('.cpu-bar').css('width', cpuPercent + '%'); checkThreshold(domain, 'CPU', cpuPercent, card.find('.cpu-bar')); }
                        else { cpuValue.text('N/A'); card.find('.cpu-bar').css('width', '0%'); }

                        if (!isNaN(ramPercent)) { ramValue.text(ramPercent.toFixed(1) + '%'); card.find('.ram-bar').css('width', ramPercent + '%'); checkThreshold(domain, 'RAM', ramPercent, card.find('.ram-bar')); }
                        else { ramValue.text('N/A'); card.find('.ram-bar').css('width', '0%'); }

                        if (!isNaN(diskPercent)) { diskValue.text(diskPercent.toFixed(1) + '%'); card.find('.disk-bar').css('width', diskPercent + '%'); checkThreshold(domain, 'Disk', diskPercent, card.find('.disk-bar')); }
                        else { diskValue.text('N/A'); card.find('.disk-bar').css('width', '0%'); }
                        var canvas = card.find('.sparkline-canvas')[0];
                        if (canvas) drawSparkline(canvas, isNaN(cpuPercent) ? 0 : cpuPercent, isNaN(ramPercent) ? 0 : ramPercent, isNaN(diskPercent) ? 0 : diskPercent);

                    } else if (response.status === 'timeout') { setTimeoutState(card); }
                    else { setErrorState(card); }
                },
                error: function (xhr, status) {
                    if (status === 'timeout') setTimeoutState(card); else setErrorState(card);
                }
            });
        }

        function checkThreshold(domain, type, value, barElement) {
            const vip = (window.VIP_CLIENTS || []).find(v => (v.ClientId || '').toUpperCase() === domain.toUpperCase());
            let threshold = null;
            if (vip) {
                if (type === 'CPU') threshold = vip.CpuThreshold;
                else if (type === 'RAM') threshold = vip.RamThreshold;
                else if (type === 'Disk') threshold = vip.DiskThreshold;
            }
            if (threshold === null || threshold === undefined) {
                const locThres = $(`#loc${type}Threshold`).val();
                if (locThres) threshold = parseFloat(locThres);
            }
            if (threshold !== null && threshold !== undefined && value >= threshold) {
                barElement.addClass('bar-alert');
                if (!barElement.data('alerted')) {
                    sysAlert(`Critical: ${domain} reached ${type} threshold (${value.toFixed(1)}% >= ${threshold}%)`, 'warning');
                    barElement.data('alerted', true);
                    setTimeout(() => barElement.data('alerted', false), 60000);
                }
            } else {
                barElement.removeClass('bar-alert');
            }
        }

        function setErrorState(card) {
            card.find('.cpu-value').text('N/A'); card.find('.ram-value').text('N/A'); card.find('.disk-value').text('N/A');
            card.find('.cpu-bar,.ram-bar,.disk-bar').css('width', '0%');
        }

        function setTimeoutState(card) {
            var icon = '<i class="fas fa-clock" style="color:#f97316;font-size:8px;" title="Timeout"></i>';
            card.find('.cpu-value').html(icon); card.find('.ram-value').html(icon); card.find('.disk-value').html(icon);
            card.find('.cpu-bar,.ram-bar,.disk-bar').css('width', '0%');
        }

        $(document).on('click', '.refresh-usage-btn', function (e) {
            e.preventDefault(); e.stopPropagation();
            var btn = $(this); var card = btn.closest('.device-card');
            var domain = card.data('domain'); var isOnline = card.data('status') === 'online';
            if (!isOnline) { sysAlert('Cannot refresh - device is offline', 'warning'); return; }
            var origHtml = btn.html();
            btn.html('<i class="fas fa-sync-alt fa-spin" style="color:#9ca3af;font-size:8px;"></i>').prop('disabled', true);
            loadSystemUsageData(card, domain);
            setTimeout(function () { btn.html(origHtml).prop('disabled', false); }, 2000);
        });

        function loadLastSeenTime(card, domain) {
            var lastSeenText = card.find('.last-seen-text');
            $.ajax({
                url: '@Url.Action("GetConnectedDevices", "ComputerSummary")', type: 'GET', timeout: 5000,
                success: function (devices) {
                    var isOnline = devices.some(d => d.toUpperCase() === domain.toUpperCase());
                    if (isOnline) { lastSeenText.html('<span style="color:#16a34a;font-weight:600;">Online Now</span>'); return; }
                    fetchLastSeenFromServer(lastSeenText, domain);
                },
                error: function () { fetchLastSeenFromServer(lastSeenText, domain); }
            });
        }

        function fetchLastSeenFromServer(lastSeenText, domain) {
            $.ajax({
                url: '@Url.Action("GetLastSeenTime", "ComputerSummary")', type: 'GET', data: { domain: domain }, timeout: 10000,
                success: function (response) {
                    if (response.success && response.lastSeen) { lastSeenText.html('Last seen: ' + formatTimeAgo(new Date(response.lastSeen))); }
                    else { lastSeenText.text('Last seen: Never'); }
                },
                error: function () { lastSeenText.text('Last seen: Unknown'); }
            });
        }

        function formatTimeAgo(date) {
            var now = new Date(); var diffMs = now - date;
            var diffMins = Math.floor(diffMs / 60000), diffHours = Math.floor(diffMs / 3600000), diffDays = Math.floor(diffMs / 86400000);
            if (diffMins < 1) return 'Just now';
            if (diffMins < 60) return diffMins + ' minute' + (diffMins !== 1 ? 's' : '') + ' ago';
            if (diffHours < 24) return diffHours + ' hour' + (diffHours !== 1 ? 's' : '') + ' ago';
            if (diffDays < 7) return diffDays + ' day' + (diffDays !== 1 ? 's' : '') + ' ago';
            return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
        }

        $(document).on('searchEvent', function (e, term) { filterDevices(term); });
        $('#statusFilter').on('change', function () { filterDevices(); });

        function filterDevices(searchTerm, forceStatus) {
            var term = (searchTerm !== undefined ? searchTerm : ($('#globalSearchInput').val() || '')).toLowerCase();
            var status = forceStatus !== undefined ? forceStatus : ($('#statusFilter').val() || 'all');
            $('#devicesGrid .device-card').each(function () {
                var card = $(this);
                var content = card.text().toLowerCase();
                var cardStatus = card.data('status');
                var matchesSearch = content.indexOf(term) > -1;
                var matchesStatus = status === 'all' || status === cardStatus;
                card.toggle(matchesSearch && matchesStatus);
            });
        }

        $(document).on('click', '.edit-name-btn', function (e) {
            e.preventDefault(); e.stopPropagation();
            var cell = $(this).closest('.deshboard-name-cell');
            cell.find('.display-name-section').hide();
            cell.find('.edit-section').removeClass('hidden');
        });

        $(document).on('click', '.cancel-edit-btn', function (e) {
            e.preventDefault(); e.stopPropagation();
            var cell = $(this).closest('.deshboard-name-cell');
            cell.find('.edit-section').addClass('hidden');
            cell.find('.display-name-section').show();
        });

        $(document).on('click', '.update-btn', function (e) {
            e.preventDefault(); e.stopPropagation();
            var cell = $(this).closest('.deshboard-name-cell');
            var newName = cell.find('.edit-name').val().trim();
            if (!newName) { sysAlert('Name cannot be empty.', 'warning'); return; }
            var btn = $(this);
            btn.html('<i class="fas fa-spinner fa-spin"></i>').prop('disabled', true);
            $.ajax({
                url: '@Url.Action("deshboardupdate", "ComputerSummary")', type: 'POST', contentType: 'application/json',
                data: JSON.stringify({
                    Id: cell.data('id'), DomainName: cell.data('domain-id'), CompanyId: cell.data('company-id'),
                    GroupId: cell.data('group-id'), LocationId: cell.data('location-id'), UserName: newName
                }),
                success: function () {
                    cell.find('.display-name-section a').text(newName);
                    cell.find('.edit-section').addClass('hidden');
                    cell.find('.display-name-section').show();
                },
                error: function () { sysAlert('Error updating name', 'error'); },
                complete: function () { btn.html('Save').prop('disabled', false); }
            });
        });

        $('.rescan-link').on('click', function () {
            if ($(this).prop('disabled')) return;
            var link = $(this); var domain = link.data('domain'); var card = link.closest('.device-card');
            link.find('.rescan-text').html('<i class="fas fa-spinner fa-spin" style="font-size:7px;"></i>Scanning…');
            link.prop('disabled', true); card.addClass('opacity-75');
            registerActiveRescan(domain);

            setTimeout(() => {
                if (activeScans[domain.toUpperCase()]) {
                    unregisterActiveRescan(domain); resetRescanButton(link, card);
                    sysAlert('Scan timed out for ' + domain, 'warning');
                }
            }, 10 * 60 * 1000);

            $.post('@Url.Action("Comanddata", "ComputerSummary")?domain=' + domain, function (res) {
                if (res.success) { sysAlert('Scan initiated for ' + domain, 'info'); }
                else { unregisterActiveRescan(domain); resetRescanButton(link, card); sysAlert('Failed: ' + (res.message || 'Server error'), 'error'); }
            }).fail(function () { unregisterActiveRescan(domain); resetRescanButton(link, card); sysAlert('Could not start scan for ' + domain, 'error'); });
        });

        function resetRescanButton(link, card) {
            link.find('.rescan-text').html('<i class="fas fa-sync-alt" style="font-size:7px;"></i><span class="js-txt">Rescan</span>');
            link.prop('disabled', false); if (card) card.removeClass('opacity-75');
        }

        $(document).ready(function () { loadPersistedScans(); });

        let activeScans = {};

        function registerActiveRescan(domain) { activeScans[domain.toUpperCase()] = Date.now(); localStorage.setItem('activeScans', JSON.stringify(activeScans)); }
        function unregisterActiveRescan(domain) { delete activeScans[domain.toUpperCase()]; localStorage.setItem('activeScans', JSON.stringify(activeScans)); }

        function loadPersistedScans() {
            const saved = localStorage.getItem('activeScans');
            if (saved) {
                try {
                    activeScans = JSON.parse(saved);
                    const now = Date.now(); const timeoutMs = 10 * 60 * 1000;
                    Object.keys(activeScans).forEach(domain => {
                        const registeredTime = activeScans[domain];
                        if (typeof registeredTime !== 'number' || (now - registeredTime > timeoutMs)) { delete activeScans[domain]; return; }
                        let card = null;
                        $('.device-card').each(function () {
                            const d = $(this).attr('data-domain');
                            if (d && d.toUpperCase() === domain.toUpperCase()) { card = $(this); return false; }
                        });
                        if (card && card.length) {
                            const link = card.find('.rescan-link');
                            if (link.length) {
                                link.find('.rescan-text').html('<i class="fas fa-spinner fa-spin" style="font-size:7px;"></i>Scanning…');
                                link.prop('disabled', true); card.addClass('opacity-75');
                                const remainingTime = timeoutMs - (now - registeredTime);
                                setTimeout(() => {
                                    if (activeScans[domain]) { unregisterActiveRescan(domain); resetRescanButton(link, card); sysAlert('Scan timed out for ' + domain, 'warning'); }
                                }, remainingTime);
                            }
                        }
                    });
                    localStorage.setItem('activeScans', JSON.stringify(activeScans));
                } catch (e) { activeScans = {}; }
            }
        }

        $('.remote-link').on('click', function () {
            if (!$(this).prop('disabled')) window.location.href = '@Url.Action("Live", "ComputerSummary")?domain=' + $(this).data('domain');
        });

        $(document).on('click', '.open-chat-btn', function (e) {
            e.preventDefault(); e.stopPropagation();
            var domain = $(this).data('domain');
            if (domain) window.openChatModal(domain);
        });
    </script>
}
