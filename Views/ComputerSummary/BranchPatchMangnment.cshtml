@model List<ManageEngineWebApp.Models.WindowsUserDetails>
@{
    ViewData["Title"] = "Patch Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var companyid = ViewBag.companyid;
    var groupid = ViewBag.groupid;
    var locationid = ViewBag.locationid;
    var activeComputers = ViewBag.ActiveComputers as List<string> ?? new List<string>();
}

<style>
    .pm-table tbody tr:hover {
        background: #f0f9ff;
    }

    .pm-table tbody tr.selected-row {
        background: #e0f5fc;
    }

    .pm-checkbox {
        accent-color: #00BCEB;
    }

    .pm-badge-online {
        background: #d1fae5;
        color: #065f46;
    }

    .pm-badge-offline {
        background: #f3f4f6;
        color: #6b7280;
    }

    #selectionBar {
        transition: all .2s ease;
    }

    .pm-table {
        border-collapse: separate;
        border-spacing: 0;
    }

        .pm-table thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            background: #f8fafc;
        }

    .pulse-dot {
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1
        }

        50% {
            opacity: .4
        }
    }

    .page-btn {
        min-width: 28px;
        height: 28px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        cursor: pointer;
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #374151;
        transition: .15s;
    }

        .page-btn:hover, .page-btn.active {
            background: #00BCEB;
            color: #fff;
            border-color: #00BCEB;
        }

        .page-btn:disabled {
            opacity: .4;
            cursor: default;
            background: #fff;
            color: #9ca3af;
        }

    /* ── live-sync indicator (top-right of toolbar) ── */
    #liveSyncIndicator {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 9px;
        color: #6b7280;
    }

    #liveSyncDot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #9ca3af;
        transition: background .4s;
    }

        #liveSyncDot.syncing {
            background: #00BCEB;
            animation: pulse 1s infinite;
        }

        #liveSyncDot.synced {
            background: #22c55e;
        }

        #liveSyncDot.error {
            background: #ef4444;
        }
</style>

<div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-6 py-3">

    <div class="mb-3 flex items-center justify-between flex-wrap gap-2">
        <div>
            <h1 class="text-base font-bold text-gray-900 flex items-center gap-1.5">
                <i class="fas fa-shield-alt text-cyan-500 text-sm"></i> Patch Management
            </h1>
            <p class="text-[10px] text-gray-500 mt-0.5">Select devices · deploy Windows or third-party patches</p>
        </div>

        <div class="flex items-center gap-2">
            <span id="liveSyncIndicator" title="Live status sync">
                <span id="liveSyncDot"></span>
                <span id="liveSyncLabel">Syncing…</span>
            </span>

            <span id="selectedPill" class="hidden items-center gap-1 px-2.5 py-1 bg-cyan-50 border border-cyan-200 rounded-full text-[11px] font-semibold text-cyan-700">
                <i class="fas fa-check-circle text-[9px]"></i>
                <span id="selCountPill">0</span> selected
            </span>

            <div class="relative">
                <button id="patchDropdownBtn" onclick="toggleDropdown()" disabled
                        class="px-3 py-1.5 text-white rounded-md font-medium text-xs flex items-center gap-1 shadow-sm disabled:opacity-40 disabled:cursor-not-allowed"
                        style="background:linear-gradient(135deg,#00BCEB,#0096BE)">
                    <i class="fas fa-bolt text-[10px]"></i> Patch
                    <i class="fas fa-chevron-down text-[9px] ml-0.5"></i>
                </button>
                <div id="patchDropdown"
                     class="hidden absolute right-0 mt-1 w-44 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-20">
                    <a onclick="goWinPatch()"
                       class="flex items-center gap-2 px-3 py-2 text-xs text-gray-700 hover:bg-gray-50 cursor-pointer">
                        <i class="fab fa-windows text-cyan-500"></i> Windows Patch
                    </a>
                    <a onclick="goPatchSelection()"
                       class="flex items-center gap-2 px-3 py-2 text-xs text-gray-700 hover:bg-gray-50 cursor-pointer border-t border-gray-100">
                        <i class="fas fa-cube text-cyan-500"></i> Third-Party Patch
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-2 flex flex-wrap items-center gap-3 bg-white rounded-md border border-gray-200 px-3 py-2.5 shadow-sm">
        <div class="relative flex-1 min-w-[200px] max-w-sm">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-[11px]"></i>
            <input id="searchInput" type="text" placeholder="Search by name, domain, or ID..."
                   class="w-full pl-8 pr-3 py-1.5 border border-gray-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-cyan-100 focus:border-cyan-400 transition-all"
                   oninput="applyFilters()">
        </div>

        <div class="flex items-center gap-1.5 bg-gray-50 p-1 rounded-lg border border-gray-100">
            <button onclick="setStatusFilter('')" id="filterAll" class="status-tab px-3 py-1 text-[10px] font-bold rounded-md transition-all bg-white shadow-sm ring-1 ring-gray-200 text-gray-700">All</button>
            <button onclick="setStatusFilter('online')" id="filterOnline" class="status-tab px-3 py-1 text-[10px] font-bold rounded-md transition-all text-gray-500 hover:text-gray-700">Online <span id="onlineCountTop" class="ml-1 opacity-60">0</span></button>
            <button onclick="setStatusFilter('offline')" id="filterOffline" class="status-tab px-3 py-1 text-[10px] font-bold rounded-md transition-all text-gray-500 hover:text-gray-700">Offline <span id="offlineCountTop" class="ml-1 opacity-60">0</span></button>
            <input type="hidden" id="statusFilter" value="">
        </div>

        <div class="h-6 w-px bg-gray-200 mx-1"></div>

        <div class="flex items-center gap-4 ml-auto">
            <label class="flex items-center gap-2 cursor-pointer select-none group">
                <div class="relative flex items-center justify-center">
                    <input type="checkbox" id="selectAll" onchange="toggleSelectAll(this)"
                           class="pm-checkbox w-4 h-4 rounded border-gray-300 text-cyan-500 focus:ring-cyan-500 transition-all cursor-pointer">
                </div>
                <div class="flex flex-col">
                    <span class="text-[11px] text-gray-700 font-bold leading-none">Select All</span>
                    <span class="text-[9px] text-gray-400 leading-none mt-1">Found <span id="visibleCount">0</span> devices</span>
                </div>
            </label>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="bg-white rounded-md border border-gray-200 shadow-sm overflow-hidden">
            <div class="overflow-x-auto" style="max-height:calc(100vh - 280px); overflow-y:auto;">
                <table class="pm-table w-full text-xs">
                    <thead>
                        <tr class="border-b border-gray-200 text-[10px] text-gray-500 uppercase tracking-wide">
                            <th class="pl-3 pr-2 py-2 w-8 text-left">
                            </th>
                            <th class="px-3 py-2 text-left font-semibold">Status</th>
                            <th class="px-3 py-2 text-left font-semibold">Domain / Device</th>
                            <th class="px-3 py-2 text-left font-semibold">Employee</th>
                            <th class="px-3 py-2 text-left font-semibold">Full Name</th>
                            <th class="px-3 py-2 text-left font-semibold">Department</th>
                            <th class="px-3 py-2 text-left font-semibold">Device ID</th>
                        </tr>
                    </thead>
                    <tbody id="deviceTableBody" class="divide-y divide-gray-100">
                        @foreach (var item in Model)
                        {
                            bool isOnline = activeComputers.Any(d => string.Equals(d, item.DomainName, StringComparison.OrdinalIgnoreCase) || string.Equals(d, item.UserCode, StringComparison.OrdinalIgnoreCase));
                            var statusClass = isOnline ? "text-green-500" : "text-gray-400";
                            <tr class="device-row transition-colors"
                                data-id="@item.Id"
                                data-domain="@item.DomainName"
                                data-username="@item.UserName"
                                data-fullname="@item.FullName"
                                data-dept="@item.AccountType"
                                data-status="@(isOnline ? "online" : "offline")">
                                <td class="pl-3 pr-2 py-2">
                                    <input type="checkbox"
                                           class="device-checkbox pm-checkbox w-3.5 h-3.5 rounded disabled:opacity-30 disabled:cursor-not-allowed"
                                           value="@item.Id"
                                           data-domain="@item.DomainName"
                                           data-name="@item.UserName"
                                           @(isOnline ? "" : "disabled")
                                           onchange="updateRowSelection(this)">
                                </td>
                                <td class="px-3 py-2 status-badge-cell">
                                    @if (isOnline)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-semibold pm-badge-online">
                                            <span class="w-1.5 h-1.5 rounded-full bg-green-500 pulse-dot"></span> Online
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-semibold pm-badge-offline">
                                            <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span> Offline
                                        </span>
                                    }
                                </td>
                                <td class="px-3 py-2 font-medium text-gray-900 max-w-[160px] truncate">@item.DomainName</td>
                                <td class="px-3 py-2 text-gray-700 max-w-[120px] truncate">@item.UserName</td>
                                <td class="px-3 py-2 text-gray-600 max-w-[140px] truncate">@item.FullName</td>
                                <td class="px-3 py-2 text-gray-500 max-w-[120px] truncate">@item.AccountType</td>
                                <td class="px-3 py-2 text-gray-400 font-mono">#@item.Id</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="flex items-center justify-between px-3 py-2 border-t border-gray-100 bg-gray-50">
                <span class="text-[10px] text-gray-500">
                    Page <span id="currentPageLabel">1</span> of <span id="totalPagesLabel">1</span>
                </span>
                <div id="paginationBtns" class="flex items-center gap-1"></div>
                <div class="flex items-center gap-1.5">
                    <span class="text-[10px] text-gray-500">Rows</span>
                    <select id="rowsPerPage" onchange="changePageSize()" class="text-[10px] border border-gray-300 rounded px-1 py-0.5">
                        <option value="25">25</option>
                        <option value="50" selected>50</option>
                        <option value="100">100</option>
                        <option value="9999">All</option>
                    </select>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-16 bg-white rounded-md border border-gray-200 shadow-sm">
            <i class="fas fa-desktop text-4xl text-gray-200 mb-3"></i>
            <p class="text-gray-500 text-sm font-medium">No devices registered for this location</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        const ALL_ROWS = Array.from(document.querySelectorAll('.device-row'));
        let filteredRows = [...ALL_ROWS];
        let currentPage  = 1;
        let pageSize     = 50;

        const STORAGE_KEY = `BranchPatch_Selection_${'@companyid'}_${'@groupid'}_${'@locationid'}`;
        
        let selectedIds     = new Set(JSON.parse(localStorage.getItem(STORAGE_KEY + '_Ids') || '[]'));
        let selectedDomains = new Map(JSON.parse(localStorage.getItem(STORAGE_KEY + '_Domains') || '[]'));
        let selectedNames   = new Map(JSON.parse(localStorage.getItem(STORAGE_KEY + '_Names') || '[]'));

        function saveSelection() {
            localStorage.setItem(STORAGE_KEY + '_Ids', JSON.stringify([...selectedIds]));
            localStorage.setItem(STORAGE_KEY + '_Domains', JSON.stringify([...selectedDomains]));
            localStorage.setItem(STORAGE_KEY + '_Names', JSON.stringify([...selectedNames]));
        }
        const syncDot   = document.getElementById('liveSyncDot');
        const syncLabel = document.getElementById('liveSyncLabel');

        function setSyncState(state) {
            syncDot.className = '';
            switch (state) {
                case 'connecting': syncDot.classList.add('syncing'); syncLabel.textContent = 'Connecting…'; break;
                case 'live':       syncDot.classList.add('synced');  syncLabel.textContent = 'Live';         break;
                case 'error':      syncDot.classList.add('error');   syncLabel.textContent = 'Reconnecting…'; break;
            }
        }

        let hasReceivedInitialSync = false;

        function applyDeviceStatuses(devices) {
            if (!Array.isArray(devices)) return;
            if (devices.length === 0 && !hasReceivedInitialSync) {
                return;
            }

            const onlineSet = new Set(
                devices.map(d => (d || '').toString().trim().toUpperCase())
            );

            ALL_ROWS.forEach(row => {
                const domain    = (row.dataset.domain || '').trim().toUpperCase();
                const wasOnline = row.dataset.status === 'online';
                const isOnline  = onlineSet.has(domain);

                if (isOnline) {
                    row.dataset.missCount = 0;
                    if (!wasOnline || !hasReceivedInitialSync) {
                        updateRowUI(row, true);
                    }
                } else {
                    let misses = (parseInt(row.dataset.missCount) || 0) + 1;
                    row.dataset.missCount = misses;
                    if (wasOnline && misses >= 2) {
                        updateRowUI(row, false);
                    } else if (!wasOnline && !hasReceivedInitialSync) {
                        updateRowUI(row, false);
                    }
                }
            });

            function updateRowUI(row, isOnline) {
                row.dataset.status = isOnline ? 'online' : 'offline';

                const badgeCell = row.querySelector('.status-badge-cell');
                if (badgeCell) {
                    badgeCell.innerHTML = isOnline
                        ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-semibold pm-badge-online">
                               <span class="w-1.5 h-1.5 rounded-full bg-green-500 pulse-dot"></span> Online
                           </span>`
                        : `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-semibold pm-badge-offline">
                               <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span> Offline
                           </span>`;
                }

                const cb = row.querySelector('.device-checkbox');
                if (cb) {
                    cb.disabled = !isOnline;
                    if (!isOnline && cb.checked) {
                        cb.checked = false;
                        const id = cb.value;
                        selectedIds.delete(id);
                        selectedDomains.delete(id);
                        selectedNames.delete(id);
                    }
                }
            }

            hasReceivedInitialSync = true;
            updateHeader();
            applyFilters();
        }

        function fallbackPoll() {
            fetch('@Url.Action("GetConnectedDevices", "ComputerSummary")')
                .then(r => r.ok ? r.json() : [])
                .then(devices => { 
                    if (Array.isArray(devices)) {
                        const ids = devices.map(d => d.clientId || d);
                        applyDeviceStatuses(ids); 
                    }
                })
                .catch(() => {});
        }

        let patchHubConnection = null;

        function startPatchHubConnection() {
            const apiBase = (window.SYSNET_CONTEXT && window.SYSNET_CONTEXT.apiBaseUrl) || '';
            const hubUrl  = `${apiBase}/scanHub?clientId=PatchPage&computerName=WebPortal`;

            patchHubConnection = new signalR.HubConnectionBuilder()
                .withUrl(hubUrl, {
                    transport: signalR.HttpTransportType.WebSockets
                           | signalR.HttpTransportType.ServerSentEvents
                           | signalR.HttpTransportType.LongPolling
                })
                .withAutomaticReconnect([0, 2000, 5000, 10000])
                .build();
            patchHubConnection.on('DeviceStatusChanged', function(connectedDevices) {
                applyDeviceStatuses(connectedDevices);
                setSyncState('live');
            });

            patchHubConnection.on('ReceiveConnectedDevices', function(connectedDevices) {
                applyDeviceStatuses(connectedDevices);
                setSyncState('live');
            });

            patchHubConnection.onreconnecting(() => setSyncState('connecting'));
            patchHubConnection.onreconnected(() => {
                setSyncState('live');
                patchHubConnection.invoke('RequestConnectedDevices').catch(() => {});
            });
            patchHubConnection.onclose(() => setSyncState('error'));

            setSyncState('connecting');
            patchHubConnection.start()
                .then(() => {
                    setSyncState('live');
                    return patchHubConnection.invoke('RequestConnectedDevices');
                })
                .catch(err => {
                    console.warn('Patch Hub connection failed, falling back to HTTP poll:', err);
                    setSyncState('error');
                    fallbackPoll();
                });
        }

        document.addEventListener('DOMContentLoaded', () => {
            startPatchHubConnection();
        });
        function renderPage() {
            const start = (currentPage - 1) * pageSize;
            const end   = start + pageSize;

            ALL_ROWS.forEach(r => r.style.display = 'none');
            filteredRows.forEach((r, i) => {
                r.style.display = (i >= start && i < end) ? '' : 'none';
            });

            syncRowHighlights();
            buildPaginationBtns();
            const selectableCount = filteredRows.filter(r => r.dataset.status === 'online').length;
            document.getElementById('visibleCount').textContent = selectableCount;
            document.getElementById('currentPageLabel').textContent = currentPage;
            document.getElementById('totalPagesLabel').textContent  = Math.max(1, Math.ceil(filteredRows.length / pageSize));
            updateSelectAllState();
        }

        function buildPaginationBtns() {
            const total = Math.ceil(filteredRows.length / pageSize);
            const cont  = document.getElementById('paginationBtns');
            cont.innerHTML = '';

            const addBtn = (label, page, disabled) => {
                const b = document.createElement('button');
                b.className = 'page-btn' + (page === currentPage ? ' active' : '');
                b.disabled  = disabled;
                b.innerHTML = label;
                b.onclick   = () => { currentPage = page; renderPage(); };
                cont.appendChild(b);
            };

            addBtn('<i class="fas fa-angle-left"></i>', currentPage - 1, currentPage === 1);

            let pages = [];
            if (total <= 7) {
                for (let i=1; i<=total; i++) pages.push(i);
            } else {
                pages = [1];
                if (currentPage > 3) pages.push('…');
                for (let i = Math.max(2, currentPage-1); i <= Math.min(total-1, currentPage+1); i++) pages.push(i);
                if (currentPage < total-2) pages.push('…');
                pages.push(total);
            }

            pages.forEach(p => {
                if (p === '…') {
                    const s = document.createElement('span');
                    s.className = 'text-[10px] text-gray-400 px-1';
                    s.textContent = '…';
                    cont.appendChild(s);
                } else {
                    addBtn(p, p, false);
                }
            });

            addBtn('<i class="fas fa-angle-right"></i>', currentPage + 1, currentPage >= total);
        }

        function changePageSize() {
            pageSize = parseInt(document.getElementById('rowsPerPage').value);
            currentPage = 1;
            renderPage();
        }

        function setStatusFilter(val) {
            document.getElementById('statusFilter').value = val;

            document.querySelectorAll('.status-tab').forEach(tab => {
                tab.classList.remove('bg-white', 'shadow-sm', 'ring-1', 'ring-gray-200', 'text-gray-700');
                tab.classList.add('text-gray-500');
            });

            const activeId = val === '' ? 'filterAll' : (val === 'online' ? 'filterOnline' : 'filterOffline');
            const activeTab = document.getElementById(activeId);
            activeTab.classList.remove('text-gray-500');
            activeTab.classList.add('bg-white', 'shadow-sm', 'ring-1', 'ring-gray-200', 'text-gray-700');

            applyFilters();
        }

        function applyFilters() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const status = document.getElementById('statusFilter').value;

            filteredRows = ALL_ROWS.filter(r => {
                const text    = r.textContent.toLowerCase();
                const rStatus = r.dataset.status;
                const matchesSearch = !search || text.includes(search);
                const matchesStatus = !status || rStatus === status;
                return matchesSearch && matchesStatus;
            });

            const onlineCount  = ALL_ROWS.filter(r => r.dataset.status === 'online').length;
            const offlineCount = ALL_ROWS.filter(r => r.dataset.status === 'offline').length;
            document.getElementById('onlineCountTop').textContent  = onlineCount;
            document.getElementById('offlineCountTop').textContent = offlineCount;

            currentPage = 1;
            renderPage();
        }

        function updateSelection() {
            syncRowHighlights();
            updateHeader();
        }

        function updateRowSelection(cb) {
            const id     = cb.value;
            const domain = cb.dataset.domain;
            const name   = cb.dataset.name || domain;

            if (cb.checked) {
                selectedIds.add(id);
                selectedDomains.set(id, domain);
                selectedNames.set(id, name);
            } else {
                selectedIds.delete(id);
                selectedDomains.delete(id);
                selectedNames.delete(id);
            }
            updateSelection();
            updateSelectAllState();
            saveSelection();
        }

        function syncRowHighlights() {
            document.querySelectorAll('.device-row').forEach(r => {
                const id = r.dataset.id;
                const cb = r.querySelector('.device-checkbox');
                if (selectedIds.has(id)) {
                    r.classList.add('selected-row');
                    if (cb) cb.checked = true;
                } else {
                    r.classList.remove('selected-row');
                    if (cb) cb.checked = false;
                }
            });
        }

        function toggleSelectAll(master) {
            filteredRows.forEach(r => {
                const id     = r.dataset.id;
                const domain = r.dataset.domain;
                const name   = r.dataset.username || domain;
                const status = r.dataset.status;

                if (master.checked) {
                    if (status === 'online') {
                        selectedIds.add(id);
                        selectedDomains.set(id, domain);
                        selectedNames.set(id, name);
                    }
                } else {
                    selectedIds.delete(id);
                    selectedDomains.delete(id);
                    selectedNames.delete(id);
                }
            });
            updateSelection();
            updateSelectAllState();
            saveSelection();
        }

        function updateSelectAllState() {
            const visibleCbs = getVisibleCheckboxes();
            const sa = document.getElementById('selectAll');
            if (!sa) return;
            if (visibleCbs.length === 0) { sa.checked = false; sa.indeterminate = false; return; }
            const checkedCount = visibleCbs.filter(cb => cb.checked).length;
            sa.checked       = checkedCount === visibleCbs.length;
            sa.indeterminate = checkedCount > 0 && checkedCount < visibleCbs.length;
        }

        function getVisibleCheckboxes() {
            return Array.from(document.querySelectorAll('.device-checkbox')).filter(cb => {
                return cb.closest('tr').style.display !== 'none';
            });
        }

        function updateHeader() {
            const count = selectedIds.size;
            const pill  = document.getElementById('selectedPill');
            const btn   = document.getElementById('patchDropdownBtn');
            document.getElementById('selCountPill').textContent = count;
            pill.classList.toggle('hidden', count === 0);
            pill.classList.toggle('inline-flex', count > 0);
            btn.disabled = count === 0;
        }

        function goWinPatch() {
            if (selectedIds.size === 0) { sysAlert('Please select at least one device', 'warning'); return; }
            navigate('BranchWinPatchselection');
        }
        function goPatchSelection() {
            if (selectedIds.size === 0) { sysAlert('Please select at least one device', 'warning'); return; }
            navigate('BranchPatchselection');
        }
        function navigate(action) {
            const ids     = [...selectedIds].join(',');
            const domains = [...selectedDomains.values()].join(',');
            // Clear selection when navigating to deployment? 
            // Actually, keep it in case they hit back. 
            window.location.href = `/ComputerSummary/${action}?companyid=@companyid&groupid=@groupid&locationid=@locationid&selectedIds=${ids}&domainids=${domains}`;
        }

        function toggleDropdown() {
            document.getElementById('patchDropdown').classList.toggle('hidden');
        }
        document.addEventListener('click', e => {
            const dd  = document.getElementById('patchDropdown');
            const btn = document.getElementById('patchDropdownBtn');
            if (dd && btn && !btn.contains(e.target) && !dd.contains(e.target)) dd.classList.add('hidden');
        });

        document.addEventListener('DOMContentLoaded', () => {
            applyFilters();
            renderPage();
            updateHeader(); // Ensure button state reflects persisted selection
        });
    </script>
}
