@model List<WindowsUserDetails>
@{
    ViewData["Title"] = "Computer Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userRole = Context.Session.GetString("role");
    var isCompanyUser = userRole == "CompanyUser";
}

@section Styles {
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/responsive/2.4.1/css/responsive.dataTables.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --brand-cyan: #00BCEB;
            --brand-cyan-dark: #0096BE;
            --brand-slate: #1e293b;
            --brand-slate-light: #334155;
        }
        
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }

        .table-modern-container {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }

        .dataTables_wrapper .dataTables_length select,
        .dataTables_wrapper .dataTables_filter input {
            padding: 0.5rem 1rem !important;
            border-radius: 8px !important;
            border: 1px solid #cbd5e1 !important;
            font-size: 0.85rem !important;
            font-weight: 500 !important;
            color: var(--brand-slate) !important;
        }

        table.dataTable {
            border-collapse: separate !important;
            border-spacing: 0 !important;
            width: 100% !important;
            margin: 1rem 0 !important;
            border: none !important;
        }

        table.dataTable thead th {
            background-color: #00BCEB !important;
            background-image: none !important;
            color: #ffffff !important;
            font-family: 'Outfit', sans-serif !important;
            font-weight: 700 !important;
            text-transform: uppercase !important;
            font-size: 11px !important;
            letter-spacing: 0.05em !important;
            padding: 16px 20px !important;
            border: none !important;
            position: relative !important;
        }

        table.dataTable thead .sorting::after,
        table.dataTable thead .sorting_asc::after,
        table.dataTable thead .sorting_desc::after {
            color: rgba(255, 255, 255, 0.6) !important;
            opacity: 1 !important;
        }

        table.dataTable tbody tr {
            background: #ffffff !important;
            transition: all 0.2s ease;
        }

        table.dataTable tbody tr:hover {
            background: #f1f5f9 !important;
        }

        table.dataTable td {
            padding: 14px 20px !important;
            font-size: 12px !important;
            color: var(--brand-slate) !important;
            border-bottom: 1px solid #e2e8f0 !important;
            font-weight: 500 !important;
        }

        .dataTables_paginate .paginate_button {
            border-radius: 8px !important;
            border: 1px solid #cbd5e1 !important;
            padding: 0.4rem 0.8rem !important;
            margin-left: 6px !important;
            font-weight: 600 !important;
            font-size: 0.8rem !important;
            color: var(--brand-slate-light) !important;
        }
        .dataTables_paginate .paginate_button.current {
            background: var(--brand-cyan) !important;
            color: white !important;
            border-color: var(--brand-cyan) !important;
            box-shadow: 0 4px 10px rgba(0, 188, 235, 0.2) !important;
        }
        .cs-tab-nav {
            border-bottom: 1px solid #e2e8f0;
            background: #ffffff;
        }
        .tab-item a {
            color: #64748b;
            border-bottom: 2px solid transparent;
            padding: 0.75rem 1.25rem !important;
            font-family: 'Outfit', sans-serif !important;
            font-weight: 600 !important;
            transition: all 0.3s;
        }
        .tab-item a:hover {
            color: #00BCEB;
            background: #f0f9ff;
        }
        .tab-item.active a {
            color: #00BCEB !important;
            border-bottom-color: #00BCEB !important;
            background: #f0f9ff !important;
        }

        .system-tab a, .software-tab a, .security-tab a, .hardware-tab a, .restriction-tab a, .usb-tab a {
            color: #64748b;
            padding: 0.6rem 1rem !important;
            border-left: 3px solid transparent;
            font-family: 'Inter', sans-serif !important;
            font-weight: 500 !important;
            transition: all 0.2s;
        }
        .system-tab a:hover, .software-tab a:hover, .security-tab a:hover, .hardware-tab a:hover, .restriction-tab a:hover, .usb-tab a:hover {
            background: #f8fafc;
            color: #00BCEB;
        }
        .system-tab.active a, .software-tab.active a, .security-tab.active a, .hardware-tab.active a, .restriction-tab.active a, .usb-tab.active a {
            background: #f0f9ff !important;
            color: #00BCEB !important;
            border-left-color: #00BCEB !important;
            font-weight: 700 !important;
        }
    </style>
}

<div class="max-w-[1600px] mx-auto px-3 sm:px-4 lg:px-5 pt-2 sm:pt-3 pb-8">

    <div class="relative overflow-hidden rounded-2xl bg-white border border-slate-200 shadow-[0_8px_30px_rgb(0,0,0,0.04)] mb-4">
        <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-br from-[#00BCEB]/5 to-transparent rounded-full -mr-32 -mt-32 pointer-events-none"></div>

        <div class="relative z-10 flex flex-wrap items-center justify-between gap-6 px-6 py-6">
            <div class="flex items-center gap-5">
                <div class="header-avatar-glow">
                    <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#00BCEB] to-[#0096BE] flex items-center justify-center shadow-lg shadow-[#00BCEB]/20">
                        <i class="fab fa-windows text-3xl text-white"></i>
                    </div>
                </div>
                
                <div class="min-w-0">
                    <nav class="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-1">
                        <a href="/Companies" class="hover:text-[#00BCEB] transition-colors">COMPANIES</a>
                        <i class="fas fa-chevron-right text-[7px] text-slate-300"></i>
                        <span>DEVICE SUMMARY</span>
                    </nav>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight truncate" style="font-family: 'Outfit', sans-serif;">
                        @(!string.IsNullOrEmpty(ViewBag.LastLogUser) && ViewBag.LastLogUser != "N/A" ? ViewBag.LastLogUser : "Unknown Device")
                    </h1>
                    <div class="flex items-center gap-2 mt-0.5">
                        <span class="w-2 h-2 rounded-full bg-[#B4D334] animate-pulse"></span>
                        <p class="text-[12px] font-semibold text-slate-500">@ViewBag.windowdetails</p>
                    </div>
                </div>
            </div>

            <div class="flex flex-col items-end gap-3">
                <div class="flex flex-wrap justify-end gap-2">
                    <span class="meta-pill flex items-center gap-2 px-3 py-1.5 rounded-xl text-[10px] shadow-sm">
                        <i class="fas fa-fingerprint text-[#00BCEB]"></i> @ViewBag.UserName
                    </span>
                    <span class="meta-pill flex items-center gap-2 px-3 py-1.5 rounded-xl text-[10px] shadow-sm">
                        <i class="fas fa-clock text-[#00BCEB]"></i> @ViewBag.scanTime
                    </span>
                    <span class="meta-pill flex items-center gap-2 px-3 py-1.5 rounded-xl text-[10px] shadow-sm">
                        <i class="fas fa-network-wired text-[#00BCEB]"></i> @ViewBag.ip
                    </span>
                </div>
                
                <button onclick="location.reload()" class="flex items-center gap-2 px-5 py-2.5 rounded-xl text-[12px] font-bold text-white bg-slate-900 hover:bg-slate-800 transition-all shadow-lg shadow-slate-900/10 hover:-translate-y-0.5 active:translate-y-0">
                    <i class="fas fa-sync-alt text-[11px]"></i> REFRESH DATA
                </button>
            </div>
        </div>
    </div>

    <input id="domainid" value="@ViewBag.UserName" type="hidden" />

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-4 overflow-hidden">
        <ul class="cs-tab-nav flex overflow-x-auto gap-1 hide-scrollbar" id="mainComputerTabs" role="tablist">
            <li class="tab-item active flex-shrink-0">
                <a href="#Summary" data-toggle="tab" class="flex items-center gap-1.5 px-3 py-2 rounded-md text-[11px] font-medium whitespace-nowrap transition-all">
                    <i class="fas fa-chart-pie text-[10px]"></i><span>Summary</span>
                </a>
            </li>
            <li class="tab-item flex-shrink-0">
                <a href="#System" data-toggle="tab" class="flex items-center gap-1.5 px-3 py-2 rounded-md text-[11px] font-medium whitespace-nowrap transition-all">
                    <i class="fas fa-cogs text-[10px]"></i><span>System</span>
                </a>
            </li>
            <li class="tab-item flex-shrink-0">
                <a href="#Hardware" data-toggle="tab" class="flex items-center gap-1.5 px-3 py-2 rounded-md text-[11px] font-medium whitespace-nowrap transition-all">
                    <i class="fas fa-microchip text-[10px]"></i><span>Hardware</span>
                </a>
            </li>
            <li class="tab-item flex-shrink-0">
                <a href="#Software" data-toggle="tab" class="flex items-center gap-1.5 px-3 py-2 rounded-md text-[11px] font-medium whitespace-nowrap transition-all">
                    <i class="fas fa-laptop-code text-[10px]"></i><span>Software</span>
                </a>
            </li>
            <li class="tab-item flex-shrink-0">
                <a href="#security" data-toggle="tab" class="flex items-center gap-1.5 px-3 py-2 rounded-md text-[11px] font-medium whitespace-nowrap transition-all">
                    <i class="fas fa-shield-alt text-[10px]"></i><span>Security</span>
                </a>
            </li>
            <li class="tab-item flex-shrink-0">
                <a href="#PatchManagment" data-toggle="tab" class="flex items-center gap-1.5 px-3 py-2 rounded-md text-[11px] font-medium whitespace-nowrap transition-all">
                    <i class="fas fa-band-aid text-[10px]"></i><span>Patches</span>
                </a>
            </li>
            <li class="tab-item flex-shrink-0">
                <a href="#Restriction" data-toggle="tab" class="flex items-center gap-1.5 px-3 py-2 rounded-md text-[11px] font-medium whitespace-nowrap transition-all">
                    <i class="fas fa-ban text-[10px]"></i><span>Restrictions</span>
                </a>
            </li>
            <li class="tab-item flex-shrink-0">
                <a href="#UsbAudit" data-toggle="tab" class="flex items-center gap-1.5 px-3 py-2 rounded-md text-[11px] font-medium whitespace-nowrap transition-all">
                    <i class="fas fa-usb text-[10px]"></i><span>USB Audit</span>
                </a>
            </li>
            <li class="tab-item flex-shrink-0">
                <a href="#History" data-toggle="tab" class="flex items-center gap-1.5 px-3 py-2 rounded-md text-[11px] font-medium whitespace-nowrap transition-all">
                    <i class="fas fa-history text-[10px]"></i><span>History</span>
                </a>
            </li>
            <li class="tab-item flex-shrink-0">
                <a href="#Updatelogs" data-toggle="tab" class="flex items-center gap-1.5 px-3 py-2 rounded-md text-[11px] font-medium whitespace-nowrap transition-all">
                    <i class="fas fa-file-alt text-[10px]"></i><span>Change Logs</span>
                </a>
            </li>
        </ul>
    </div>

    <div class="tab-content">
        <partial name="_SummaryTab" />
        <partial name="_SystemTab" />
        <partial name="_HardwareTab" />
        <partial name="_SoftwareTab" />
        <partial name="_SecurityTab" />
        <partial name="_PatchTab" />
        <partial name="_RestrictionTab" />
        <partial name="_UsbAuditTab" />
        <partial name="_HistoryTab" />
        <partial name="_UpdateLogsTab" />
    </div>

</div>
<partial name="_SoftwareModals" />

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/computer-summary.js"></script>
}
