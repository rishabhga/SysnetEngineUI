@model List<WindowsUserDetails>
@{
    ViewData["Title"] = "Computer Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userRole = Context.Session.GetString("role");
    var isCompanyUser = userRole == "CompanyUser";
}

@section Styles {
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/responsive/2.4.1/css/responsive.dataTables.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>
        /* ── Root Variables ── */
        :root {
            --cyan: #00BCEB;
            --cyan-dark: #0096BE;
            --cyan-soft: #e8f8fd;
            --slate-900: #0f172a;
            --slate-800: #1e293b;
            --slate-700: #334155;
            --slate-500: #64748b;
            --slate-400: #94a3b8;
            --slate-200: #e2e8f0;
            --slate-100: #f1f5f9;
            --slate-50: #f8fafc;
            --green: #B4D334;
            --red: #ef4444;
            --amber: #f59e0b;
            --text-main: #1e293b;
            --text-muted: #475569;
            --text-faint: #64748b;
            --font-main: 'DM Sans', system-ui, sans-serif;
            --font-mono: 'DM Mono', monospace;
            --radius-sm: 6px;
            --radius-md: 8px;
            --radius-lg: 12px;
            --shadow-sm: 0 1px 3px rgba(0,0,0,.07), 0 1px 2px rgba(0,0,0,.04);
            --shadow-md: 0 4px 12px rgba(0,0,0,.06);
        }

        /* ── Global Reset / Base ── */
        *, *::before, *::after {
            box-sizing: border-box;
        }

        html {
            font-size: 13px;
        }
        /* ← THIS fixes the "too big at 100% zoom" */
        body {
            font-family: var(--font-main);
            background: var(--slate-50);
            color: var(--text-main);
        }

        /* ── Layout wrapper ── */
        .cs-page {
            width: 100%;
            max-width: 1480px;
            margin: 0 auto;
            padding: 12px 16px 24px;
        }

        /* ── Header Card ── */
        .cs-header {
            background: #fff;
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            padding: 14px 20px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .cs-header-icon {
            width: 44px;
            height: 44px;
            flex-shrink: 0;
            border-radius: var(--radius-md);
            background: linear-gradient(135deg, var(--cyan), var(--cyan-dark));
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 10px rgba(0,188,235,.25);
        }

            .cs-header-icon i {
                font-size: 1.25rem;
                color: #fff;
            }

        .cs-header-text {
            flex: 1;
            min-width: 0;
        }

        .cs-breadcrumb {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--slate-400);
            margin-bottom: 2px;
        }

            .cs-breadcrumb a {
                color: inherit;
                text-decoration: none;
            }

                .cs-breadcrumb a:hover {
                    color: var(--cyan);
                }

            .cs-breadcrumb i {
                font-size: .6rem;
            }

        .cs-device-name {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--slate-900);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            line-height: 1.2;
        }

        .cs-device-sub {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 2px;
        }

        .cs-online-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--green);
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: .4;
            }
        }

        .cs-device-sub span {
            font-size: .75rem;
            color: var(--text-faint);
            font-weight: 500;
        }

        /* Meta pills */
        .cs-meta-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            align-items: center;
        }

        .cs-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 20px;
            background: var(--slate-50);
            border: 1px solid var(--slate-200);
            font-size: .72rem;
            font-weight: 600;
            color: var(--text-muted);
        }

            .cs-pill i {
                color: var(--cyan);
                font-size: .68rem;
            }

        /* ── Tab Nav ── */
        .cs-tab-bar {
            background: #fff;
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            margin-bottom: 10px;
            overflow: hidden;
        }

        .cs-tab-list {
            display: flex;
            overflow-x: auto;
            list-style: none;
            margin: 0;
            padding: 0 6px;
            gap: 2px;
            scrollbar-width: none;
        }

            .cs-tab-list::-webkit-scrollbar {
                display: none;
            }

            .cs-tab-list li {
                flex-shrink: 0;
            }

                .cs-tab-list li a {
                    display: flex;
                    align-items: center;
                    gap: 5px;
                    padding: 9px 13px;
                    font-size: .78rem;
                    font-weight: 600;
                    color: var(--text-faint);
                    border-bottom: 2px solid transparent;
                    text-decoration: none;
                    white-space: nowrap;
                    transition: color .2s, border-color .2s, background .2s;
                    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
                }

                    .cs-tab-list li a i {
                        font-size: .72rem;
                    }

                    .cs-tab-list li a:hover {
                        color: var(--cyan);
                        background: var(--cyan-soft);
                    }

                .cs-tab-list li.active a {
                    color: var(--cyan) !important;
                    border-bottom-color: var(--cyan) !important;
                    background: var(--cyan-soft) !important;
                }

        /* ── Tab Content ── */
        .tab-content > .tab-pane {
            display: none !important;
        }

            .tab-content > .tab-pane.active {
                display: block !important;
            }

        .tab-pane .tab-pane {
            display: none !important;
        }

            .tab-pane .tab-pane.active {
                display: block !important;
            }

        /* ── DataTables Global Style ── */
        .dataTables_wrapper {
            width: 100%;
            font-size: .8rem;
        }

            .dataTables_wrapper .dataTables_length select,
            .dataTables_wrapper .dataTables_filter input {
                padding: 5px 9px !important;
                border-radius: var(--radius-sm) !important;
                border: 1px solid var(--slate-200) !important;
                font-size: .78rem !important;
                font-weight: 500 !important;
                color: var(--text-main) !important;
                background: #fff !important;
                font-family: var(--font-main) !important;
            }

            .dataTables_wrapper .dataTables_filter label {
                font-weight: 600;
                color: var(--text-muted);
            }

            .dataTables_wrapper .dataTables_length label {
                font-weight: 600;
                color: var(--text-muted);
            }

        table.dataTable {
            border-collapse: separate !important;
            border-spacing: 0 !important;
            width: 100% !important;
            margin: 6px 0 !important;
            border: none !important;
            table-layout: auto !important;
        }

            table.dataTable thead th {
                background: var(--cyan) !important;
                color: #fff !important;
                font-family: var(--font-main) !important;
                font-weight: 700 !important;
                text-transform: uppercase !important;
                font-size: .7rem !important;
                letter-spacing: .05em !important;
                padding: 9px 12px !important;
                border: none !important;
                white-space: nowrap !important;
            }

            table.dataTable thead .sorting::after,
            table.dataTable thead .sorting_asc::after,
            table.dataTable thead .sorting_desc::after {
                color: rgba(255,255,255,.65) !important;
                opacity: 1 !important;
            }

            table.dataTable tbody tr {
                background: #fff !important;
                transition: background .15s;
            }

                table.dataTable tbody tr:hover {
                    background: var(--slate-50) !important;
                }

            table.dataTable td {
                padding: 8px 12px !important;
                font-size: .78rem !important;
                color: var(--text-main) !important;
                border-bottom: 1px solid var(--slate-100) !important;
                font-weight: 500 !important;
                vertical-align: middle !important;
                word-break: break-word !important;
                overflow-wrap: anywhere !important;
            }

        /* Pagination */
        .dataTables_paginate .paginate_button {
            border-radius: var(--radius-sm) !important;
            border: 1px solid var(--slate-200) !important;
            padding: 4px 9px !important;
            margin-left: 3px !important;
            font-weight: 600 !important;
            font-size: .72rem !important;
            color: var(--text-muted) !important;
        }

            .dataTables_paginate .paginate_button.current {
                background: var(--cyan) !important;
                color: #fff !important;
                border-color: var(--cyan) !important;
            }

            .dataTables_paginate .paginate_button:hover:not(.current) {
                background: var(--slate-100) !important;
                color: var(--text-main) !important;
            }

        .dataTables_info {
            font-size: .72rem;
            color: var(--text-faint);
        }

        /* ── Sub-nav (side panels) ── */
        .cs-subnav {
            background: #fff;
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            position: sticky;
            top: 8px;
        }

        .cs-subnav-header {
            padding: 9px 14px;
            background: var(--slate-50);
            border-bottom: 1px solid var(--slate-200);
            font-size: .7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--slate-700);
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .cs-subnav-header i {
                color: var(--cyan);
            }

        .cs-subnav ul {
            list-style: none;
            margin: 0;
            padding: 5px 0;
            max-height: 560px;
            overflow-y: auto;
        }

            .cs-subnav ul li a {
                display: flex;
                align-items: center;
                gap: 9px;
                padding: 7px 14px;
                font-size: .78rem;
                font-weight: 500;
                color: var(--text-muted);
                text-decoration: none;
                border-left: 3px solid transparent;
                transition: all .15s;
            }

                .cs-subnav ul li a i {
                    width: 14px;
                    text-align: center;
                    font-size: .72rem;
                }

                .cs-subnav ul li a:hover {
                    background: var(--slate-50);
                    color: var(--cyan);
                }

            .cs-subnav ul li.active a {
                background: var(--cyan-soft) !important;
                color: var(--cyan) !important;
                border-left-color: var(--cyan) !important;
                font-weight: 700 !important;
            }

        /* Patch horizontal sub-tabs */
        .cs-patch-subtabs {
            display: flex;
            gap: 3px;
            padding: 8px 10px;
            background: var(--slate-50);
            border-bottom: 1px solid var(--slate-200);
        }

            .cs-patch-subtabs li {
                list-style: none;
            }

                .cs-patch-subtabs li a {
                    display: block;
                    padding: 5px 12px;
                    border-radius: var(--radius-sm);
                    font-size: .76rem;
                    font-weight: 600;
                    color: var(--text-faint);
                    text-decoration: none;
                    border-bottom: 2px solid transparent;
                    transition: all .15s;
                }

                    .cs-patch-subtabs li a:hover {
                        background: var(--cyan-soft);
                        color: var(--cyan);
                    }

                .cs-patch-subtabs li.active a {
                    background: var(--cyan-soft) !important;
                    color: var(--cyan) !important;
                    border-bottom-color: var(--cyan) !important;
                }

        /* ── Info Cards (key-value grids) ── */
        .cs-card {
            background: #fff;
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }

        .cs-card-header {
            padding: 9px 14px;
            background: var(--slate-50);
            border-bottom: 1px solid var(--slate-200);
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: var(--slate-700);
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .cs-kv-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 7px 14px;
            border-bottom: 1px solid var(--slate-100);
            gap: 12px;
            transition: background .1s;
        }

            .cs-kv-row:last-child {
                border-bottom: none;
            }

            .cs-kv-row:hover {
                background: var(--slate-50);
            }

        .cs-kv-label {
            font-size: .78rem;
            color: var(--text-faint);
            font-weight: 500;
            flex-shrink: 0;
        }

        .cs-kv-value {
            font-size: .78rem;
            color: var(--text-main);
            font-weight: 600;
            text-align: right;
            word-break: break-all;
        }

            .cs-kv-value.mono {
                font-family: var(--font-mono);
                font-size: .74rem;
            }

        /* ── Stat Chips ── */
        .cs-stat-grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
        }

        .cs-stat-cell {
            text-align: center;
            padding: 10px 8px;
            border-right: 1px solid var(--slate-100);
        }

            .cs-stat-cell:last-child {
                border-right: none;
            }

        .cs-stat-num {
            font-size: 1.2rem;
            font-weight: 800;
            color: var(--slate-900);
        }

        .cs-stat-label {
            font-size: .65rem;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--slate-400);
            margin-top: 2px;
            font-weight: 600;
        }

        /* ── Mini info boxes ── */
        .cs-info-grid {
            display: grid;
            gap: 8px;
        }

        .cs-info-box {
            background: var(--slate-50);
            border: 1px solid var(--slate-100);
            border-radius: var(--radius-sm);
            padding: 9px 11px;
        }

        .cs-info-box-label {
            font-size: .65rem;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: var(--slate-400);
            font-weight: 700;
            margin-bottom: 3px;
        }

        .cs-info-box-value {
            font-size: .82rem;
            font-weight: 700;
            color: var(--text-main);
        }

            .cs-info-box-value.accent {
                color: var(--cyan);
                font-size: 1rem;
            }

            .cs-info-box-value.green {
                color: #22c55e;
                font-size: 1rem;
            }

            .cs-info-box-value.amber {
                color: var(--amber);
                font-size: 1rem;
            }

        /* ── Utility ── */
        .w-full {
            width: 100%;
        }

        .min-w-0 {
            min-width: 0;
        }

        .flex {
            display: flex;
        }

        .flex-1 {
            flex: 1;
            min-width: 0;
        }

        .flex-col {
            flex-direction: column;
        }

        .flex-shrink-0 {
            flex-shrink: 0;
        }

        .gap-3 {
            gap: 10px;
        }

        .items-start {
            align-items: flex-start;
        }

        .overflow-hidden {
            overflow: hidden;
        }

        .p-3 {
            padding: 10px;
        }

        .p-4 {
            padding: 14px;
        }

        .mb-2 {
            margin-bottom: 6px;
        }

        .mb-3 {
            margin-bottom: 10px;
        }

        .mt-3 {
            margin-top: 10px;
        }

        .space-y-3 > * + * {
            margin-top: 10px;
        }

        .space-y-6 > * + * {
            margin-top: 18px;
        }

        .text-center {
            text-align: center;
        }

        @@media (min-width: 1024px) {
            .lg-flex {
                display: flex !important;
            }

            .lg-w-48 {
                width: 176px !important;
            }

            .lg-w-52 {
                width: 200px !important;
            }

            .lg-w-56 {
                width: 212px !important;
            }
        }
    </style>
}

<div class="cs-page">

    <!-- ── Header ── -->
    <div class="cs-header">
        <div class="cs-header-icon">
            <i class="fab fa-windows"></i>
        </div>
        <div class="cs-header-text">
            <div class="cs-breadcrumb">
                <a href="/Companies">Companies</a>
                <i class="fas fa-chevron-right"></i>
                <span>Device Summary</span>
            </div>
            <div class="cs-device-name">
                @(!string.IsNullOrEmpty(ViewBag.LastLogUser) && ViewBag.LastLogUser != "N/A" ? ViewBag.LastLogUser : "Unknown Device")
            </div>
            <div class="cs-device-sub">
                <div class="cs-online-dot"></div>
                <span>@ViewBag.windowdetails</span>
            </div>
        </div>
        <div class="cs-meta-pills">
            <span class="cs-pill"><i class="fas fa-fingerprint"></i> @ViewBag.UserName</span>
            <span class="cs-pill"><i class="fas fa-clock"></i> @ViewBag.scanTime</span>
            <span class="cs-pill"><i class="fas fa-network-wired"></i> @ViewBag.ip</span>
        </div>
    </div>

    <input id="domainid" value="@ViewBag.UserName" type="hidden" />
    <input id="domainName" value="@ViewBag.DomainNameForCommand" type="hidden" />

    <!-- ── Tab Navigation ── -->
    <div class="cs-tab-bar">
        <ul class="cs-tab-list" id="mainComputerTabs" role="tablist">
            <li class="tab-item active">
                <a href="#Summary" data-toggle="tab"><i class="fas fa-chart-pie"></i> Summary</a>
            </li>
            <li class="tab-item">
                <a href="#System" data-toggle="tab"><i class="fas fa-cogs"></i> System</a>
            </li>
            <li class="tab-item">
                <a href="#Hardware" data-toggle="tab"><i class="fas fa-microchip"></i> Hardware</a>
            </li>
            <li class="tab-item">
                <a href="#Software" data-toggle="tab"><i class="fas fa-laptop-code"></i> Software</a>
            </li>
            <li class="tab-item">
                <a href="#security" data-toggle="tab"><i class="fas fa-shield-alt"></i> Security</a>
            </li>
            <li class="tab-item">
                <a href="#PatchManagment" data-toggle="tab"><i class="fas fa-band-aid"></i> Patches</a>
            </li>
            <li class="tab-item">
                <a href="#Restriction" data-toggle="tab"><i class="fas fa-ban"></i> Restrictions</a>
            </li>
            <li class="tab-item">
                <a href="#UsbAudit" data-toggle="tab"><i class="fas fa-usb"></i> USB Audit</a>
            </li>
            <li class="tab-item">
                <a href="#History" data-toggle="tab"><i class="fas fa-history"></i> History</a>
            </li>
            <li class="tab-item">
                <a href="#Updatelogs" data-toggle="tab"><i class="fas fa-file-alt"></i> Change Logs</a>
            </li>
        </ul>
    </div>

    <div class="tab-content">
        <partial name="_SummaryTab" />
        <partial name="_SystemTab" />
        <partial name="_HardwareTab" />
        <partial name="_SoftwareTab" />
        <partial name="_SecurityTab" />
        <partial name="_PatchTab" />
        <partial name="_RestrictionTab" />
        <partial name="_UsbAuditTab" />
        <partial name="_HistoryTab" />
        <partial name="_UpdateLogsTab" />
    </div>

</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/computer-summary.js" asp-append-version="true"></script>
}
