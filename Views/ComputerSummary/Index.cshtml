@model List<WindowsUserDetails>
@{
    ViewData["Title"] = "Computer Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userRole = Context.Session.GetString("role");
    var isCompanyUser = userRole == "CompanyUser";
}

@section Styles {
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/responsive/2.4.1/css/responsive.dataTables.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>
        :root {
            --cyan: #00BCEB;
            --cyan-dark: #0096BE;
            --cyan-soft: #e8f8fd;
            --slate-900: #0f172a;
            --slate-800: #1e293b;
            --slate-700: #334155;
            --slate-600: #475569;
            --slate-500: #64748b;
            --slate-400: #94a3b8;
            --slate-300: #cbd5e1;
            --slate-200: #e2e8f0;
            --slate-100: #f1f5f9;
            --slate-50: #f8fafc;
            --green: #22c55e;
            --red: #ef4444;
            --amber: #f59e0b;
            --text-main: #1e293b;
            --text-muted: #475569;
            --text-faint: #64748b;
            --font-main: 'Inter', system-ui, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --radius-sm: 6px;
            --radius-md: 8px;
            --radius-lg: 12px;
            --shadow-sm: 0 1px 3px rgba(0,0,0,.07);
            --shadow-md: 0 4px 12px rgba(0,0,0,.08);
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html {
            font-size: 13px;
        }

        body {
            font-family: var(--font-main);
            background: var(--slate-50);
            color: var(--text-main);
        }

        .cs-page {
            width: 100%;
            max-width: 100%;
            padding: 10px 16px 20px;
        }

        .cs-header {
            position: relative;
            background: linear-gradient(135deg, var(--slate-800) 0%, var(--slate-900) 100%);
            border-radius: var(--radius-lg);
            padding: 12px 18px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: var(--shadow-md);
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.05);
        }

            .cs-header::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(circle at top right, rgba(0,188,235,.18), transparent 60%);
                pointer-events: none;
            }

        .cs-header-icon {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            border-radius: var(--radius-md);
            background: linear-gradient(135deg, var(--cyan), var(--cyan-dark));
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 14px rgba(0,188,235,.4);
            position: relative;
            z-index: 1;
        }

            .cs-header-icon i {
                font-size: 1rem;
                color: #fff;
            }

        .cs-header-text {
            flex: 1;
            min-width: 0;
            position: relative;
            z-index: 1;
        }

        .cs-breadcrumb {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--cyan);
            margin-bottom: 2px;
        }

            .cs-breadcrumb a {
                color: var(--slate-400);
                text-decoration: none;
                transition: color .2s;
            }

                .cs-breadcrumb a:hover {
                    color: #fff;
                }

            .cs-breadcrumb i {
                font-size: .6rem;
                color: var(--slate-500);
            }

        .cs-device-name {
            font-size: 1.15rem;
            font-weight: 800;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            line-height: 1.25;
            letter-spacing: -.01em;
        }

        .cs-device-sub {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-top: 3px;
        }

        .cs-online-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #22c55e;
            box-shadow: 0 0 6px #22c55e;
            animation: pulse-dot 2s infinite;
        }

        @@keyframes pulse-dot {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: .4;
            }
        }

        .cs-device-sub span {
            font-size: .75rem;
            color: var(--slate-300);
            font-weight: 500;
        }

        .cs-meta-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            align-items: center;
            position: relative;
            z-index: 1;
            flex-shrink: 0;
        }

        .cs-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 10px;
            border-radius: 20px;
            background: rgba(255,255,255,.1);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255,255,255,.12);
            font-size: .72rem;
            font-weight: 600;
            color: #fff;
            white-space: nowrap;
        }

            .cs-pill i {
                color: var(--cyan);
                font-size: .7rem;
            }

        .cs-tab-bar {
            background: #fff;
            border-radius: var(--radius-md);
            border: 1px solid var(--slate-200);
            box-shadow: var(--shadow-sm);
            margin-bottom: 14px;
            padding: 0 8px;
        }

        .cs-tab-list {
            display: flex;
            gap: 2px;
            list-style: none;
            padding: 0;
            margin: 0;
            overflow-x: auto;
            scrollbar-width: thin;
            scrollbar-color: var(--slate-300) transparent;
        }

            .cs-tab-list::-webkit-scrollbar {
                height: 6px;
            }
            .cs-tab-list::-webkit-scrollbar-thumb {
                background: var(--slate-300);
                border-radius: 4px;
            }

            .cs-tab-list li {
                flex-shrink: 0;
            }

                .cs-tab-list li a {
                    display: flex;
                    align-items: center;
                    gap: 6px;
                    padding: 11px 13px;
                    color: var(--slate-500);
                    font-size: .8rem;
                    font-weight: 600;
                    text-decoration: none;
                    border-bottom: 2px solid transparent;
                    transition: all .18s;
                    white-space: nowrap;
                }

                    .cs-tab-list li a i {
                        font-size: .78rem;
                        color: var(--slate-400);
                        transition: color .18s;
                    }

                    .cs-tab-list li a:hover {
                        color: var(--slate-800);
                        border-bottom-color: var(--slate-200);
                    }

                .cs-tab-list li.active a {
                    color: var(--cyan);
                    border-bottom-color: var(--cyan);
                    font-weight: 700;
                }

                    .cs-tab-list li.active a i {
                        color: var(--cyan);
                    }

        .tab-pane {
            display: none !important;
        }

            .tab-pane.active {
                display: block !important;
            }

        .cs-subtab-bar {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 10px 12px 0;
            overflow-x: auto;
            scrollbar-width: thin;
            scrollbar-color: var(--slate-300) transparent;
            border-bottom: 1px solid var(--slate-100);
            margin-bottom: 14px;
        }

            .cs-subtab-bar::-webkit-scrollbar {
                height: 6px;
            }
            .cs-subtab-bar::-webkit-scrollbar-thumb {
                background: var(--slate-300);
                border-radius: 4px;
            }

            .cs-subtab-bar li {
                list-style: none;
                flex-shrink: 0;
            }

                .cs-subtab-bar li a {
                    display: flex;
                    align-items: center;
                    gap: 5px;
                    padding: 6px 12px;
                    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
                    font-size: .78rem;
                    font-weight: 600;
                    color: var(--slate-500);
                    text-decoration: none;
                    border-bottom: 2px solid transparent;
                    transition: all .15s;
                    white-space: nowrap;
                }

                    .cs-subtab-bar li a i {
                        font-size: .74rem;
                    }

                    .cs-subtab-bar li a:hover {
                        color: var(--slate-700);
                        background: var(--slate-50);
                    }

                .cs-subtab-bar li.active a {
                    color: var(--cyan);
                    border-bottom-color: var(--cyan);
                    background: var(--cyan-soft);
                    font-weight: 700;
                }

        .cs-card {
            background: #fff;
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }

        .cs-card-header {
            padding: 9px 14px;
            background: var(--slate-50);
            border-bottom: 1px solid var(--slate-200);
            font-size: .7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: var(--slate-700);
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .cs-kv-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 7px 14px;
            border-bottom: 1px solid var(--slate-100);
            gap: 12px;
            transition: background .1s;
        }

            .cs-kv-row:last-child {
                border-bottom: none;
            }

            .cs-kv-row:hover {
                background: var(--slate-50);
            }

        .cs-kv-label {
            font-size: .78rem;
            color: var(--text-faint);
            font-weight: 500;
            flex-shrink: 0;
        }

        .cs-kv-value {
            font-size: .78rem;
            color: var(--text-main);
            font-weight: 600;
            text-align: right;
            word-break: break-all;
        }

            .cs-kv-value.mono {
                font-family: var(--font-mono);
                font-size: .72rem;
            }

        .cs-stat-grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
        }

        .cs-stat-cell {
            text-align: center;
            padding: 10px 6px;
            border-right: 1px solid var(--slate-100);
        }

            .cs-stat-cell:last-child {
                border-right: none;
            }

        .cs-stat-num {
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--slate-900);
            line-height: 1;
        }

        .cs-stat-label {
            font-size: .68rem;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: var(--slate-400);
            margin-top: 3px;
            font-weight: 700;
        }

        .cs-info-grid {
            display: grid;
            gap: 8px;
        }

        .cs-info-box {
            background: var(--slate-50);
            border: 1px solid var(--slate-100);
            border-radius: var(--radius-sm);
            padding: 8px 10px;
        }

        .cs-info-box-label {
            font-size: .68rem;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: var(--slate-400);
            font-weight: 700;
            margin-bottom: 3px;
        }

        .cs-info-box-value {
            font-size: .88rem;
            font-weight: 700;
            color: var(--text-main);
        }

            .cs-info-box-value.accent {
                color: var(--cyan);
                font-size: 1rem;
            }

            .cs-info-box-value.green {
                color: var(--green);
                font-size: 1rem;
            }

            .cs-info-box-value.amber {
                color: var(--amber);
                font-size: 1rem;
            }

        .hw-category-header {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            border-radius: var(--radius-md);
            margin-bottom: 10px;
        }

        .hw-category-icon {
            width: 30px;
            height: 30px;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .82rem;
            color: #fff;
            flex-shrink: 0;
        }

        .hw-category-title {
            font-size: .82rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .hw-category-desc {
            font-size: .68rem;
            color: var(--text-faint);
            font-weight: 500;
            margin-top: 1px;
        }

        .hw-cat-cyan {
            background: var(--cyan-soft);
        }

            .hw-cat-cyan .hw-category-icon {
                background: var(--cyan);
            }

        .hw-cat-green {
            background: #f0fdf4;
        }

            .hw-cat-green .hw-category-icon {
                background: #22c55e;
            }

        .hw-cat-blue {
            background: #eff6ff;
        }

            .hw-cat-blue .hw-category-icon {
                background: #3b82f6;
            }

        .hw-cat-amber {
            background: #fffbeb;
        }

            .hw-cat-amber .hw-category-icon {
                background: #f59e0b;
            }

        .hw-cat-purple {
            background: #faf5ff;
        }

            .hw-cat-purple .hw-category-icon {
                background: #a855f7;
            }

        .hw-cat-slate {
            background: var(--slate-100);
        }

            .hw-cat-slate .hw-category-icon {
                background: var(--slate-500);
            }

        .hw-cat-red {
            background: #fef2f2;
        }

            .hw-cat-red .hw-category-icon {
                background: #ef4444;
            }

        .battery-gauge-container {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 14px;
            background: var(--slate-50);
            border-radius: var(--radius-md);
            border: 1px solid var(--slate-200);
        }

        .battery-gauge-ring {
            position: relative;
            width: 76px;
            height: 76px;
            flex-shrink: 0;
        }

            .battery-gauge-ring svg {
                width: 100%;
                height: 100%;
                transform: rotate(-90deg);
            }

        .gauge-bg {
            fill: none;
            stroke: var(--slate-200);
            stroke-width: 8;
        }

        .gauge-fill {
            fill: none;
            stroke-width: 8;
            stroke-linecap: round;
            transition: stroke-dasharray 1s ease-in-out;
        }

        .battery-gauge-percent {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .gauge-num {
            font-size: .95rem;
            font-weight: 800;
            color: var(--slate-800);
        }

        table.dataTable {
            border-collapse: collapse !important;
            width: 100% !important;
        }

            table.dataTable thead th {
                background: var(--slate-50);
                color: var(--slate-600);
                font-size: .68rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .06em;
                padding: 9px 12px;
                border-bottom: 2px solid var(--slate-200);
            }

            table.dataTable tbody td {
                padding: 8px 12px;
                font-size: .8rem;
                border-bottom: 1px solid var(--slate-100);
                color: var(--text-muted);
            }

            table.dataTable tbody tr:hover td {
                background: #f0f9ff;
            }

        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate {
            font-size: .76rem;
            padding: 8px 2px;
        }

            .dataTables_wrapper .dataTables_filter input {
                border: 1px solid var(--slate-200);
                border-radius: var(--radius-sm);
                padding: 4px 8px;
                font-size: .76rem;
            }

            .dataTables_wrapper .dataTables_length select {
                border: 1px solid var(--slate-200);
                border-radius: var(--radius-sm);
                padding: 2px 4px;
                font-size: .76rem;
            }

        .cs-drive-card {
            transition: transform .2s, box-shadow .2s;
        }

            .cs-drive-card:hover {
                transform: translateY(-2px);
                box-shadow: var(--shadow-md);
            }

        .w-full {
            width: 100%;
        }

        .min-w-0 {
            min-width: 0;
        }

        .flex {
            display: flex;
        }

        .flex-1 {
            flex: 1;
            min-width: 0;
        }

        .flex-col {
            flex-direction: column;
        }

        .gap-3 {
            gap: 10px;
        }

        .items-start {
            align-items: flex-start;
        }

        .overflow-hidden {
            overflow: hidden;
        }

        .p-3 {
            padding: 10px;
        }

        .p-4 {
            padding: 14px;
        }

        .mb-2 {
            margin-bottom: 6px;
        }

        .mb-3 {
            margin-bottom: 10px;
        }

        .mt-3 {
            margin-top: 10px;
        }

        .space-y-3 > * + * {
            margin-top: 10px;
        }

        .space-y-6 > * + * {
            margin-top: 18px;
        }

        .text-center {
            text-align: center;
        }

        .tab-pane .cs-card {
            overflow-x: auto;
        }

        @@media (max-width: 768px) {
            .cs-meta-pills {
                display: none;
            }

            .cs-device-name {
                font-size: 1rem;
            }

            .cs-tab-list li a {
                padding: 10px 10px;
                font-size: .75rem;
            }
        }

        @@media (max-width: 480px) {
            .cs-header {
                padding: 10px 12px;
                gap: 10px;
            }

            html {
                font-size: 12px;
            }
        }
    </style>
}

<div class="cs-page">

    <div class="cs-header">
        <div class="cs-header-icon">
            <i class="fab fa-windows"></i>
        </div>
        <div class="cs-header-text">
            <div class="cs-breadcrumb">
                <a href="/Companies">Companies</a>
                <i class="fas fa-chevron-right"></i>
                <span>Device Summary</span>
            </div>
            <div class="cs-device-name">
                @(!string.IsNullOrEmpty(ViewBag.LastLogUser) && ViewBag.LastLogUser != "N/A" ? ViewBag.LastLogUser : "Unknown Device")
            </div>
            <div class="cs-device-sub">
                <div class="cs-online-dot"></div>
                <span>@ViewBag.windowdetails</span>
            </div>
        </div>
        <div class="cs-meta-pills">
            <span class="cs-pill"><i class="fas fa-fingerprint"></i> @ViewBag.UserName</span>
            <span class="cs-pill"><i class="fas fa-clock"></i> @ViewBag.scanTime</span>
            <span class="cs-pill"><i class="fas fa-network-wired"></i> @ViewBag.ip</span>
        </div>
    </div>

    <input id="domainid" value="@ViewBag.UserName" type="hidden" />
    <input id="domainName" value="@ViewBag.DomainNameForCommand" type="hidden" />

    <div class="cs-tab-bar">
        <ul class="cs-tab-list" role="tablist" id="mainTabList">
            <li class="main-tab active" data-target="#Summary">
                <a href="#Summary" data-tab="main"><i class="fas fa-chart-pie"></i> Summary</a>
            </li>
            <li class="main-tab" data-target="#System">
                <a href="#System" data-tab="main"><i class="fas fa-cogs"></i> System</a>
            </li>
            <li class="main-tab" data-target="#Hardware">
                <a href="#Hardware" data-tab="main"><i class="fas fa-microchip"></i> Hardware</a>
            </li>
            <li class="main-tab" data-target="#Software">
                <a href="#Software" data-tab="main"><i class="fas fa-laptop-code"></i> Software</a>
            </li>
            <li class="main-tab" data-target="#security">
                <a href="#security" data-tab="main"><i class="fas fa-shield-alt"></i> Security</a>
            </li>
            <li class="main-tab" data-target="#PatchManagment">
                <a href="#PatchManagment" data-tab="main"><i class="fas fa-band-aid"></i> Patches</a>
            </li>
            <li class="main-tab" data-target="#Restriction">
                <a href="#Restriction" data-tab="main"><i class="fas fa-ban"></i> Restrictions</a>
            </li>
            <li class="main-tab" data-target="#UsbAudit">
                <a href="#UsbAudit" data-tab="main"><i class="fas fa-usb"></i> USB Audit</a>
            </li>
            <li class="main-tab" data-target="#History">
                <a href="#History" data-tab="main"><i class="fas fa-history"></i> History</a>
            </li>
            <li class="main-tab" data-target="#Updatelogs">
                <a href="#Updatelogs" data-tab="main"><i class="fas fa-file-alt"></i> Change Logs</a>
            </li>
        </ul>
    </div>

    <div class="tab-content" id="mainTabContent">
        <partial name="_SummaryTab" />
        <partial name="_SystemTab" />
        <partial name="_HardwareTab" />
        <partial name="_SoftwareTab" />
        <partial name="_SecurityTab" />
        <partial name="_PatchTab" />
        <partial name="_RestrictionTab" />
        <partial name="_UsbAuditTab" />
        <partial name="_HistoryTab" />
        <partial name="_UpdateLogsTab" />
    </div>

</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/rowgroup/1.3.1/js/dataTables.rowGroup.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        window.SYSNET_CONTEXT = { apiBaseUrl: '@ViewBag.ApiBaseUrl' };
    </script>
    <script src="~/js/computer-summary.js" asp-append-version="true"></script>
}
