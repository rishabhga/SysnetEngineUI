     <script>
function uploadSoftware() {
    var formData = new FormData($('#uploadForm')[0]);

    $.ajax({
        url: "/Software/Upload",
        type: "POST",
        data: formData,
        processData: false,
        contentType: false,
        success: function (res) {
            sysAlert("Uploaded Successfully", "success");
            $('#uploadSoftwareModal').modal('hide');
        },
        error: function () {
            sysAlert("Upload failed", "error");
        }
    });
}


    
    </script> 