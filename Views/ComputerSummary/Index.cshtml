                <!-- Raise Ticket Modal -->
                <div id="raiseTicketModal" class="modal fade" role="dialog">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal">&times;</button>
                                <h4 class="modal-title">Raise New Ticket</h4>
                            </div>
                            <div class="modal-body">
                                <form id="raiseTicketForm">
                                    <div class="form-group">
                                        <label>Computer/Domain:</label>
                                        <input type="text" class="form-control" id="ticketDomain" readonly>
                                    </div>
                                    <div class="form-group">
                                        <label>Subject:</label>
                                        <input type="text" class="form-control" id="ticketSubject" placeholder="Brief summary of the issue" required>
                                    </div>
                                    <div class="form-group">
                                        <label>Priority:</label>
                                        <select class="form-control" id="ticketPriority">
                                            <option value="Low">Low</option>
                                            <option value="Medium" selected>Medium</option>
                                            <option value="High">High</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label>Description:</label>
                                        <textarea class="form-control" id="ticketDescription" rows="4" placeholder="Detailed description..." required></textarea>
                                    </div>
                                </form>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                                <button type="button" class="btn btn-primary" onclick="submitTicket()">Submit Ticket</button>
                            </div>
                        </div>
                    </div>
                </div>

                <script>
                    function loadComputerTickets() {
                        var domain = $('#domainid').val();
                        if (!domain) return;
                        
                        // Use ServiceDesk controller with clientId filter
                        $.get('/ServiceDesk/GetTickets?clientId=' + encodeURIComponent(domain), function(data) {
                            var html = '';
                            if (!data || data.length === 0) {
                                html = '<tr><td colspan="6" class="text-center">No tickets found for this device.</td></tr>';
                            } else {
                                data.forEach(function(t) {
                                    var badgeClass = t.status === 'Open' ? 'label-success' : (t.status === 'Closed' ? 'label-default' : 'label-primary');
                                    html += '<tr>' +
                                        '<td>#' + (t.ticketNo || t.id) + '</td>' +
                                        '<td>' + (t.subject || 'No Subject') + '</td>' +
                                        '<td><span class="label ' + badgeClass + '">' + (t.status || 'Open') + '</span></td>' +
                                        '<td>' + (t.priority || 'Medium') + '</td>' +
                                        '<td>' + (t.assignedToName || '<em class="text-muted">Unassigned</em>') + '</td>' +
                                        '<td>' + new Date(t.createdOn).toLocaleDateString() + '</td>' +
                                        '</tr>';
                                });
                            }
                            $('#ticketListBody').html(html);
                        });
                    }

                    function openRaiseTicketModal() {
                        $('#ticketDomain').val($('#domainid').val());
                        $('#raiseTicketModal').modal('show');
                    }

                    function submitTicket() {
                        var domain = $('#ticketDomain').val();
                        var subject = $('#ticketSubject').val();
                        var priority = $('#ticketPriority').val();
                        var description = $('#ticketDescription').val();

                        if (!subject || !description) {
                            sysAlert('Please fill in all fields', 'warning');
                            return;
                        }

                        // Use ServiceDesk/SaveTicket with JSON payload
                        $.ajax({
                            url: '/ServiceDesk/SaveTicket',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({
                                clientId: domain,
                                subject: subject,
                                priority: priority,
                                remark: description,
                                category: 'Hardware', // Default for computer summary
                                requesterName: '@Context.Session.GetString("username")' || 'System User'
                            }),
                            success: function(response) {
                                if (response && response.success) {
                                    $('#raiseTicketModal').modal('hide');
                                    sysAlert('Ticket raised successfully!', 'success');
                                    $('#ticketSubject').val('');
                                    $('#ticketDescription').val('');
                                    loadComputerTickets(); // Refresh list
                                } else {
                                    sysAlert('Error raising ticket: ' + (response.message || 'Unknown error'), 'error');
                                }
                            },
                            error: function(xhr, status, error) {
                                sysAlert('Error raising ticket: ' + error, 'error');
                            }
                        });
                    }
                </script>
