@model List<WindowsUserDetails>
@{
    ViewData["Title"] = "Computer Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userRole = Context.Session.GetString("role");
    var isCompanyUser = userRole == "CompanyUser";
}

@section Styles {
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/responsive/2.4.1/css/responsive.dataTables.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>
        :root {
            --cyan: #00BCEB;
            --cyan-dark: #0096BE;
            --cyan-soft: #e8f8fd;
            --slate-900: #0f172a;
            --slate-800: #1e293b;
            --slate-700: #334155;
            --slate-600: #475569;
            --slate-500: #64748b;
            --slate-400: #94a3b8;
            --slate-300: #cbd5e1;
            --slate-200: #e2e8f0;
            --slate-100: #f1f5f9;
            --slate-50: #f8fafc;
            --green: #22c55e;
            --red: #ef4444;
            --amber: #f59e0b;
            --text-main: #1e293b;
            --text-muted: #475569;
            --text-faint: #64748b;
            --font-main: 'Inter', system-ui, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --radius-sm: 6px;
            --radius-md: 8px;
            --radius-lg: 12px;
            --shadow-sm: 0 1px 3px rgba(0,0,0,.07);
            --shadow-md: 0 4px 12px rgba(0,0,0,.08);
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html {
            font-size: 13px;
        }

        body {
            font-family: var(--font-main);
            background: var(--slate-50);
            color: var(--text-main);
        }

        .cs-page {
            width: 100%;
            max-width: 100%;
            padding: 10px 16px 20px;
        }

        .cs-header {
            position: relative;
            background: linear-gradient(135deg, var(--slate-800) 0%, var(--slate-900) 100%);
            border-radius: var(--radius-lg);
            padding: 12px 18px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: var(--shadow-md);
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.05);
        }

            .cs-header::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(circle at top right, rgba(0,188,235,.18), transparent 60%);
                pointer-events: none;
            }

        .cs-header-icon {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            border-radius: var(--radius-md);
            background: linear-gradient(135deg, var(--cyan), var(--cyan-dark));
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 14px rgba(0,188,235,.4);
            position: relative;
            z-index: 1;
        }

            .cs-header-icon i {
                font-size: 1rem;
                color: #fff;
            }

        .cs-header-text {
            flex: 1;
            min-width: 0;
            position: relative;
            z-index: 1;
        }

        .cs-breadcrumb {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--cyan);
            margin-bottom: 2px;
        }

            .cs-breadcrumb a {
                color: var(--slate-400);
                text-decoration: none;
                transition: color .2s;
            }

                .cs-breadcrumb a:hover {
                    color: #fff;
                }

            .cs-breadcrumb i {
                font-size: .6rem;
                color: var(--slate-500);
            }

        .cs-device-name {
            font-size: 1.15rem;
            font-weight: 800;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            line-height: 1.25;
            letter-spacing: -.01em;
        }

        .cs-device-sub {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-top: 3px;
        }

        .cs-online-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #22c55e;
            box-shadow: 0 0 6px #22c55e;
            animation: pulse-dot 2s infinite;
        }

        @@keyframes pulse-dot {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: .4;
            }
        }

        .cs-device-sub span {
            font-size: .75rem;
            color: var(--slate-300);
            font-weight: 500;
        }

        .cs-meta-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            align-items: center;
            position: relative;
            z-index: 1;
            flex-shrink: 0;
        }

        .cs-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 10px;
            border-radius: 20px;
            background: rgba(255,255,255,.1);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255,255,255,.12);
            font-size: .72rem;
            font-weight: 600;
            color: #fff;
            white-space: nowrap;
        }

            .cs-pill i {
                color: var(--cyan);
                font-size: .7rem;
            }

        .cs-view-toggle-row {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding: 8px 0 0;
        }

        .cs-view-toggle-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 16px;
            border-radius: var(--radius-md);
            border: 1px solid var(--slate-200);
            background: #fff;
            color: var(--slate-700);
            font-size: .78rem;
            font-weight: 700;
            cursor: pointer;
            transition: all .18s;
            box-shadow: var(--shadow-sm);
        }

            .cs-view-toggle-btn:hover {
                background: var(--cyan-soft);
                border-color: var(--cyan);
                color: var(--cyan-dark);
            }

            .cs-view-toggle-btn i {
                font-size: .82rem;
                color: var(--cyan);
            }

        .cs-tab-bar {
            display: flex;
            align-items: center;
            background: #fff;
            border-bottom: 1px solid var(--slate-200);
        }

        /* ── Entry banner (shown under Summary) ── */
        .cs-entry-banner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            background: linear-gradient(135deg, var(--slate-800), var(--slate-900));
            border-radius: var(--radius-lg);
            padding: 14px 18px;
            margin-bottom: 14px;
            box-shadow: var(--shadow-md);
        }

        .cs-entry-banner-text {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #fff;
            font-size: .85rem;
            font-weight: 600;
        }

            .cs-entry-banner-text i {
                color: var(--cyan);
                font-size: 1rem;
            }

        .cs-entry-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: linear-gradient(135deg, var(--cyan), var(--cyan-dark));
            color: #fff;
            border: none;
            font-weight: 700;
            font-size: .8rem;
            padding: 10px 18px;
            border-radius: var(--radius-md);
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(0,188,235,.4);
            transition: transform .15s, box-shadow .15s;
            white-space: nowrap;
        }

            .cs-entry-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 18px rgba(0,188,235,.5);
            }

        /* ── Card grids (main + sub category selection) ── */
        .cs-card-grid-wrap {
            background: #fff;
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            padding: 16px;
            margin-bottom: 14px;
        }

        .cs-card-grid-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 14px;
            flex-wrap: wrap;
        }

            .cs-card-grid-header h3 {
                margin: 0;
                font-size: 1rem;
                font-weight: 800;
                color: var(--slate-800);
            }

        .cs-back-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: var(--slate-100);
            color: var(--slate-600);
            border: 1px solid var(--slate-200);
            font-weight: 700;
            font-size: .76rem;
            padding: 8px 14px;
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: all .15s;
        }

            .cs-back-btn:hover {
                background: var(--cyan-soft);
                color: var(--cyan-dark);
                border-color: var(--cyan);
            }

        .cs-sub-back-btn {
            margin-bottom: 12px;
        }

        .cs-card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
            gap: 16px;
        }

        .cs-card-grid-sm {
            grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
            gap: 14px;
        }

        .cs-nav-card {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: var(--slate-50);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-lg);
            padding: 18px 12px;
            cursor: pointer;
            text-align: center;
            transition: all .18s;
        }

            .cs-nav-card:hover {
                background: var(--cyan-soft);
                border-color: var(--cyan);
                transform: translateY(-3px);
                box-shadow: var(--shadow-md);
            }

        .cs-nav-card-img {
            width: 68px;
            height: 68px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--cyan), var(--cyan-dark));
            box-shadow: 0 4px 12px rgba(0,188,235,.3);
            overflow: hidden;
            flex-shrink: 0;
        }

            .cs-nav-card-img i {
                font-size: 1.5rem;
                color: #fff;
            }

            /* Real image badges: large, fills most of the card, no boxed background */
            .cs-nav-card-img.cs-img-box {
                width: 118px;
                height: 118px;
                border-radius: 0;
                background: transparent;
                border: none;
                box-shadow: none;
                padding: 0;
            }

                .cs-nav-card-img.cs-img-box img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                }

        .cs-nav-card-sm .cs-nav-card-img {
            width: 54px;
            height: 54px;
        }

            .cs-nav-card-sm .cs-nav-card-img i {
                font-size: 1.15rem;
            }

            .cs-nav-card-sm .cs-nav-card-img.cs-img-box {
                width: 84px;
                height: 84px;
            }

        .cs-nav-card-label {
            font-size: .82rem;
            font-weight: 700;
            color: var(--slate-700);
            line-height: 1.3;
        }

        .cs-nav-card-arrow {
            position: absolute;
            top: 10px;
            right: 10px;
            font-size: .65rem;
            color: var(--slate-300);
        }

        .cs-subtab-card-grid-wrap {
            margin-bottom: 4px;
            padding: 12px;
        }

        .cs-subtab-card-grid-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }

        .cs-subtab-card-grid-title {
            margin: 0;
            font-size: .88rem;
            font-weight: 800;
            color: var(--slate-800);
        }

        .cs-tab-list {
            display: flex;
            gap: 2px;
            list-style: none;
            padding: 0;
            margin: 0;
            overflow-x: auto;
            scrollbar-width: thin;
            scrollbar-color: var(--slate-300) transparent;
        }

            .cs-tab-list::-webkit-scrollbar {
                height: 6px;
            }
            .cs-tab-list::-webkit-scrollbar-thumb {
                background: var(--slate-300);
                border-radius: 4px;
            }

            .cs-tab-list li {
                flex-shrink: 0;
            }

                .cs-tab-list li a {
                    display: flex;
                    align-items: center;
                    gap: 6px;
                    padding: 11px 13px;
                    color: var(--slate-500);
                    font-size: .8rem;
                    font-weight: 600;
                    text-decoration: none;
                    border-bottom: 2px solid transparent;
                    transition: all .18s;
                    white-space: nowrap;
                }

                    .cs-tab-list li a i {
                        font-size: .78rem;
                        color: var(--slate-400);
                        transition: color .18s;
                    }

                    .cs-tab-list li a:hover {
                        color: var(--slate-800);
                        border-bottom-color: var(--slate-200);
                    }

                .cs-tab-list li.active a {
                    color: var(--cyan);
                    border-bottom-color: var(--cyan);
                    font-weight: 700;
                }

                    .cs-tab-list li.active a i {
                        color: var(--cyan);
                    }

        .tab-pane {
            display: none !important;
        }

            .tab-pane.active {
                display: block !important;
            }

        .cs-subtab-bar {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 10px 12px 0;
            overflow-x: auto;
            scrollbar-width: thin;
            scrollbar-color: var(--slate-300) transparent;
            border-bottom: 1px solid var(--slate-100);
            margin-bottom: 14px;
        }

            .cs-subtab-bar::-webkit-scrollbar {
                height: 6px;
            }
            .cs-subtab-bar::-webkit-scrollbar-thumb {
                background: var(--slate-300);
                border-radius: 4px;
            }

            .cs-subtab-bar li {
                list-style: none;
                flex-shrink: 0;
            }

                .cs-subtab-bar li a {
                    display: flex;
                    align-items: center;
                    gap: 5px;
                    padding: 6px 12px;
                    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
                    font-size: .78rem;
                    font-weight: 600;
                    color: var(--slate-500);
                    text-decoration: none;
                    border-bottom: 2px solid transparent;
                    transition: all .15s;
                    white-space: nowrap;
                }

                    .cs-subtab-bar li a i {
                        font-size: .74rem;
                    }

                    .cs-subtab-bar li a:hover {
                        color: var(--slate-700);
                        background: var(--slate-50);
                    }

                .cs-subtab-bar li.active a {
                    color: var(--cyan);
                    border-bottom-color: var(--cyan);
                    background: var(--cyan-soft);
                    font-weight: 700;
                }

        .cs-card {
            background: #fff;
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }

        .cs-card-header {
            padding: 9px 14px;
            background: var(--slate-50);
            border-bottom: 1px solid var(--slate-200);
            font-size: .7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: var(--slate-700);
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .cs-kv-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 7px 14px;
            border-bottom: 1px solid var(--slate-100);
            gap: 12px;
            transition: background .1s;
        }

            .cs-kv-row:last-child {
                border-bottom: none;
            }

            .cs-kv-row:hover {
                background: var(--slate-50);
            }

        .cs-kv-label {
            font-size: .78rem;
            color: var(--text-faint);
            font-weight: 500;
            flex-shrink: 0;
        }

        .cs-kv-value {
            font-size: .78rem;
            color: var(--text-main);
            font-weight: 600;
            text-align: right;
            word-break: break-all;
        }

            .cs-kv-value.mono {
                font-family: var(--font-mono);
                font-size: .72rem;
            }

        .cs-stat-grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
        }

        .cs-stat-cell {
            text-align: center;
            padding: 10px 6px;
            border-right: 1px solid var(--slate-100);
        }

            .cs-stat-cell:last-child {
                border-right: none;
            }

        .cs-stat-num {
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--slate-900);
            line-height: 1;
        }

        .cs-stat-label {
            font-size: .68rem;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: var(--slate-400);
            margin-top: 3px;
            font-weight: 700;
        }

        .cs-info-grid {
            display: grid;
            gap: 8px;
        }

        .cs-info-box {
            background: var(--slate-50);
            border: 1px solid var(--slate-100);
            border-radius: var(--radius-sm);
            padding: 8px 10px;
        }

        .cs-info-box-label {
            font-size: .68rem;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: var(--slate-400);
            font-weight: 700;
            margin-bottom: 3px;
        }

        .cs-info-box-value {
            font-size: .88rem;
            font-weight: 700;
            color: var(--text-main);
        }

            .cs-info-box-value.accent {
                color: var(--cyan);
                font-size: 1rem;
            }

            .cs-info-box-value.green {
                color: var(--green);
                font-size: 1rem;
            }

            .cs-info-box-value.amber {
                color: var(--amber);
                font-size: 1rem;
            }

        .hw-category-header {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            border-radius: var(--radius-md);
            margin-bottom: 10px;
        }

        .hw-category-icon {
            width: 30px;
            height: 30px;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .82rem;
            color: #fff;
            flex-shrink: 0;
        }

        .hw-category-title {
            font-size: .82rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .hw-category-desc {
            font-size: .68rem;
            color: var(--text-faint);
            font-weight: 500;
            margin-top: 1px;
        }

        .hw-cat-cyan {
            background: var(--cyan-soft);
        }

            .hw-cat-cyan .hw-category-icon {
                background: var(--cyan);
            }

        .hw-cat-green {
            background: #f0fdf4;
        }

            .hw-cat-green .hw-category-icon {
                background: #22c55e;
            }

        .hw-cat-blue {
            background: #eff6ff;
        }

            .hw-cat-blue .hw-category-icon {
                background: #3b82f6;
            }

        .hw-cat-amber {
            background: #fffbeb;
        }

            .hw-cat-amber .hw-category-icon {
                background: #f59e0b;
            }

        .hw-cat-purple {
            background: #faf5ff;
        }

            .hw-cat-purple .hw-category-icon {
                background: #a855f7;
            }

        .hw-cat-slate {
            background: var(--slate-100);
        }

            .hw-cat-slate .hw-category-icon {
                background: var(--slate-500);
            }

        .hw-cat-red {
            background: #fef2f2;
        }

            .hw-cat-red .hw-category-icon {
                background: #ef4444;
            }

        .battery-gauge-container {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 14px;
            background: var(--slate-50);
            border-radius: var(--radius-md);
            border: 1px solid var(--slate-200);
        }

        .battery-gauge-ring {
            position: relative;
            width: 76px;
            height: 76px;
            flex-shrink: 0;
        }

            .battery-gauge-ring svg {
                width: 100%;
                height: 100%;
                transform: rotate(-90deg);
            }

        .gauge-bg {
            fill: none;
            stroke: var(--slate-200);
            stroke-width: 8;
        }

        .gauge-fill {
            fill: none;
            stroke-width: 8;
            stroke-linecap: round;
            transition: stroke-dasharray 1s ease-in-out;
        }

        .battery-gauge-percent {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .gauge-num {
            font-size: .95rem;
            font-weight: 800;
            color: var(--slate-800);
        }

        table.dataTable {
            border-collapse: collapse !important;
            width: 100% !important;
        }

            table.dataTable thead th {
                background: var(--slate-50);
                color: var(--slate-600);
                font-size: .68rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .06em;
                padding: 9px 12px;
                border-bottom: 2px solid var(--slate-200);
            }

            table.dataTable tbody td {
                padding: 8px 12px;
                font-size: .8rem;
                border-bottom: 1px solid var(--slate-100);
                color: var(--text-muted);
            }

            table.dataTable tbody tr:hover td {
                background: #f0f9ff;
            }

        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate {
            font-size: .76rem;
            padding: 8px 2px;
        }

            .dataTables_wrapper .dataTables_filter input {
                border: 1px solid var(--slate-200);
                border-radius: var(--radius-sm);
                padding: 4px 8px;
                font-size: .76rem;
            }

            .dataTables_wrapper .dataTables_length select {
                border: 1px solid var(--slate-200);
                border-radius: var(--radius-sm);
                padding: 2px 4px;
                font-size: .76rem;
            }

        .cs-drive-card {
            transition: transform .2s, box-shadow .2s;
        }

            .cs-drive-card:hover {
                transform: translateY(-2px);
                box-shadow: var(--shadow-md);
            }

        .w-full {
            width: 100%;
        }

        .min-w-0 {
            min-width: 0;
        }

        .flex {
            display: flex;
        }

        .flex-1 {
            flex: 1;
            min-width: 0;
        }

        .flex-col {
            flex-direction: column;
        }

        .gap-3 {
            gap: 10px;
        }

        .items-start {
            align-items: flex-start;
        }

        .overflow-hidden {
            overflow: hidden;
        }

        .p-3 {
            padding: 10px;
        }

        .p-4 {
            padding: 14px;
        }

        .mb-2 {
            margin-bottom: 6px;
        }

        .mb-3 {
            margin-bottom: 10px;
        }

        .mt-3 {
            margin-top: 10px;
        }

        .space-y-3 > * + * {
            margin-top: 10px;
        }

        .space-y-6 > * + * {
            margin-top: 18px;
        }

        .text-center {
            text-align: center;
        }

        .tab-pane .cs-card {
            overflow-x: auto;
        }

        @@media (max-width: 768px) {
            .cs-meta-pills {
                display: none;
            }

            .cs-device-name {
                font-size: 1rem;
            }

            .cs-tab-list li a {
                padding: 10px 10px;
                font-size: .75rem;
            }
        }

        @@media (max-width: 480px) {
            .cs-header {
                padding: 10px 12px;
                gap: 10px;
            }

            html {
                font-size: 12px;
            }
        }
    </style>
}

<div class="cs-page">

    <div class="cs-header">
        <div class="cs-header-icon">
            <i class="fab fa-windows"></i>
        </div>
        <div class="cs-header-text">
            <div class="cs-breadcrumb">
                <a href="/Companies">Companies</a>
                <i class="fas fa-chevron-right"></i>
                <span>Device Summary</span>
            </div>
            <div class="cs-device-name">
                @(!string.IsNullOrEmpty(ViewBag.LastLogUser) && ViewBag.LastLogUser != "N/A" ? ViewBag.LastLogUser : "Unknown Device")
            </div>
            <div class="cs-device-sub">
                <div class="cs-online-dot"></div>
                <span>@ViewBag.windowdetails</span>
            </div>
        </div>
        <div class="cs-meta-pills">
            <span class="cs-pill"><i class="fas fa-fingerprint"></i> @ViewBag.UserName</span>
            <span class="cs-pill"><i class="fas fa-clock"></i> @ViewBag.scanTime</span>
            <span class="cs-pill"><i class="fas fa-network-wired"></i> @ViewBag.ip</span>
        </div>
    </div>

    <input id="domainid" value="@ViewBag.UserName" type="hidden" />
    <input id="domainName" value="@ViewBag.DomainNameForCommand" type="hidden" />

    <div id="csEntryBanner" class="cs-entry-banner">
        <div class="cs-entry-banner-text">
            <i class="fas fa-info-circle"></i>
            <span>Need hardware, software, security, patch or other device details?</span>
        </div>
        <button type="button" id="btnOpenSystemInfo" class="cs-entry-btn">
            <i class="fas fa-layer-group"></i> View System Info
        </button>
    </div>

    <!-- Summary Dashboard Container -->
    <div id="summaryDashboardContainer">
        <div class="tab-content">
            <partial name="_SummaryTab" />
        </div>
    </div>

    <!-- System Health Wrapper - Only visible when inside System Info -->
    <div id="systemHealthWrapper" style="display:none;">
        <!-- System Health Banner -->
        <div id="systemHealthBanner" style="display:none; background: #fff; border-radius: var(--radius-lg); padding: 16px; margin-bottom: 12px; box-shadow: var(--shadow-sm); align-items: center; justify-content: space-between; border: 1px solid var(--slate-200);">
            <div style="display:flex; align-items:center; gap: 16px;">
                <div id="systemHealthIcon" style="width: 48px; height: 48px; border-radius: 50%; display:flex; align-items:center; justify-content:center; background: #f1f5f9; font-size: 20px;">
                    <i class="fas fa-heartbeat"></i>
                </div>
                <div>
                    <div style="font-size: 13px; color: var(--slate-500); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">System Health Score</div>
                    <div style="font-size: 24px; font-weight: 700; color: var(--slate-900); display:flex; align-items:center; gap:8px;">
                        <span id="systemHealthScoreText">--%</span>
                        <span id="systemHealthStatusLabel" style="font-size: 13px; padding: 2px 8px; border-radius: 12px; background: #f1f5f9; color: var(--slate-600); font-weight: 600;">Calculating...</span>
                    </div>
                </div>
            </div>
            <div style="display:flex; gap: 32px; color: var(--slate-500); font-size: 12px; font-weight: 500;">
                <div style="text-align:center;">
                    <div style="color:var(--slate-400); margin-bottom:4px; text-transform:uppercase; font-size:10px; letter-spacing:0.5px;">Storage</div>
                    <div id="sh-storage" style="color:var(--slate-700); font-weight:600; font-size:16px;">--</div>
                </div>
                <div style="text-align:center;">
                    <div style="color:var(--slate-400); margin-bottom:4px; text-transform:uppercase; font-size:10px; letter-spacing:0.5px;">Motherboard</div>
                    <div id="sh-mobo" style="color:var(--slate-700); font-weight:600; font-size:16px;">--</div>
                </div>
                <div style="text-align:center;">
                    <div style="color:var(--slate-400); margin-bottom:4px; text-transform:uppercase; font-size:10px; letter-spacing:0.5px;">Processor</div>
                    <div id="sh-cpu" style="color:var(--slate-700); font-weight:600; font-size:16px;">--</div>
                </div>
                <div style="text-align:center;">
                    <div style="color:var(--slate-400); margin-bottom:4px; text-transform:uppercase; font-size:10px; letter-spacing:0.5px;">Memory</div>
                    <div id="sh-mem" style="color:var(--slate-700); font-weight:600; font-size:16px;">--</div>
                </div>
            </div>
        </div>

    </div>

    <!-- Unified System Info Header (Only visible inside System Info Section) -->
    <div id="systemInfoHeader" style="display: none; align-items: center; justify-content: space-between; margin-bottom: 15px; padding-top: 10px;">
        <div style="display: flex; align-items: center; gap: 15px;">
            <button type="button" id="btnBackToSummary" class="cs-back-btn" style="margin: 0;">
                <i class="fas fa-arrow-left"></i> Back to Summary
            </button>
            <h3 style="margin: 0; font-size: 1.25rem; font-weight: 700; color: var(--slate-800);">System Information</h3>
        </div>
        <div class="cs-view-toggle-row" id="viewToggleRow" style="padding: 0;">
            <button type="button" id="btnUniversalViewToggle" class="cs-view-toggle-btn">
                <i class="fas fa-th-large"></i> <span>Card View</span>
            </button>
        </div>
    </div>

    <div id="mainTabCardGrid" class="cs-card-grid-wrap" style="display:none;">
        <div class="cs-card-grid" id="mainTabCardGridInner"></div>
    </div>


    <div id="tabViewContainer" style="display: none;">
        <div class="cs-tab-bar" style="margin-top: 0;">
            <ul class="cs-tab-list" role="tablist" id="mainTabList">
                <li class="main-tab active" data-target="#System">
                    <a href="#System" data-tab="main"><i class="fas fa-cogs"></i> System</a>
                </li>
                <li class="main-tab" data-target="#Hardware">
                    <a href="#Hardware" data-tab="main"><i class="fas fa-microchip"></i> Hardware</a>
                </li>
                <li class="main-tab" data-target="#Software">
                    <a href="#Software" data-tab="main"><i class="fas fa-laptop-code"></i> Software</a>
                </li>
                <li class="main-tab" data-target="#security">
                    <a href="#security" data-tab="main"><i class="fas fa-shield-alt"></i> Security</a>
                </li>
                <li class="main-tab" data-target="#PatchManagment">
                    <a href="#PatchManagment" data-tab="main"><i class="fas fa-band-aid"></i> Patches</a>
                </li>
                <li class="main-tab" data-target="#Restriction">
                    <a href="#Restriction" data-tab="main"><i class="fas fa-ban"></i> Restrictions</a>
                </li>
                <li class="main-tab" data-target="#UsbAudit">
                    <a href="#UsbAudit" data-tab="main"><i class="fas fa-usb"></i> USB Audit</a>
                </li>
                <li class="main-tab" data-target="#History">
                    <a href="#History" data-tab="main"><i class="fas fa-history"></i> History</a>
                </li>
                <li class="main-tab" data-target="#Updatelogs">
                    <a href="#Updatelogs" data-tab="main"><i class="fas fa-file-alt"></i> Change Logs</a>
                </li>
            </ul>
        </div>

        <div class="tab-content" id="mainTabContent">
            <partial name="_SystemTab" />
            <partial name="_HardwareTab" />
            <partial name="_SoftwareTab" />
            <partial name="_SecurityTab" />
            <partial name="_PatchTab" />
            <partial name="_RestrictionTab" />
            <partial name="_UsbAuditTab" />
            <partial name="_HistoryTab" />
            <partial name="_UpdateLogsTab" />
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/rowgroup/1.3.1/js/dataTables.rowGroup.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        window.SYSNET_CONTEXT = { apiBaseUrl: '@ViewBag.ApiBaseUrl' };
    </script>
    <script src="~/js/computer-summary.js" asp-append-version="true"></script>
}
