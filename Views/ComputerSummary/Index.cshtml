                        return;
                    }

                    formData.append("file", fileInput);

                    $.ajax({
                        url: "/ComputerSummary/UploadSoftware",
                        type: "POST",
                        data: formData,
                        contentType: false,
                        processData: false,
                        success: function (res) {
                            sysAlert(res, "info");
                            $("#uploadModal").modal("hide");
                            $('#InstallationSoftwarelist').DataTable().ajax.reload();
                        },
                        error: function () {
                            sysAlert("Upload failed.", "error");
                        }
                    });
                });


