        //PhysicalMemory
       
         $.ajax({
                url: `/ComputerSummary/PhysicalMemory?domain=${domaindata}`,  // Controller se JSON fetch karega
                type: 'GET',
                //dataType: 'json',
                success: function (data) {
                   // debugger;
                    // JSON se values set karna
                    $('#tdMaximumSupportedRAM').text(data.maximumSupportedRAM);
                    $('#tdLocation').text(data.location);
                    $('#tdSlotsAvailable').text(data.slotsAvailable);
                    $('#tdSlotsUsed').text(data.slotsUsed);

                    $('#slotsTable tbody').empty();

                    if (data.slots && data.slots.length > 0) {
                     data.slots.forEach(function (slot) {
                         const row = `
                        <tr>
                            <td>${slot.slot}</td>
                            <td>${slot.memoryType}</td>
                            <td>${slot.availableMemory}</td>
                            <td>${slot.speed}</td>
                            <td>${slot.bankLabel}</td>
                        </tr>
                    `;
                    $('tbody#slotsTable').append(row);
                 });
            }

                else {
                    // If no slots available, show a message
                    const emptyRow = `
                        <tr>
                            <td colspan="5">No slot details available</td>
                        </tr>
                    `;
                    $('#slotsTable tbody').append(emptyRow);
                }
             
            },
            error: function () {
                sysAlert("Error loading data", "error");
            }
        });

