    <!-- Main Content Section -->
    <div class="main-container">
        <!-- Vertical Menu -->
        <div class="vertical-menu" id="vertical-menu">
            <ul>
                <!-- Items will be dynamically loaded here -->
            </ul>
        </div>

        <!-- Content Area -->
        <div class="content-area" id="content-area">
            <h2>Welcome</h2>
            <p>Select a menu item to load its content.</p>
        </div>
    </div>

<script>
    function loadVerticalMenu(menuType) {
        // Hide all vertical menus
        const menus = document.querySelectorAll('.vertical-menu');
        menus.forEach(function (menu) {
            menu.style.display = 'none';
        });

        // Show the relevant vertical menu
        const verticalMenu = document.getElementById('vertical-menu-' + menuType);
        if (verticalMenu) {
            verticalMenu.style.display = 'block';
        }
    }
</script>


