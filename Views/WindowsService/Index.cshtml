<table class="table table-bordered font-monospace">
    <thead>
        <tr>
            <th>Id</th>
            <th>Display Name</th>
            <th>Startup Type</th>
            <th>Description</th>
            <th>Logon Name</th>
            <th>State</th>           
            <th>Date Time</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
            <td>@item.Id</td>
            <td class="col-md-3">@item.DisplayName</td>
            <td>@item.StartupType</td>
            <td>@item.Description</td>
            <td>@item.LogonName</td>
            <td>@item.State</td>            
            <td>@item.DateTime</td>
            </tr>
        }
    </tbody>
</table>

