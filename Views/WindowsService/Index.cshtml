@model List<WindowsService>
@{
    ViewData["Title"] = "Windows Services";
}

<div class="max-w-7xl mx-auto px-4 pt-3">
    <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-3">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center shadow-sm" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                <i class="fas fa-cogs text-white text-sm"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold text-gray-900">Windows Services</h1>
                <p class="text-[10px] text-gray-400 font-medium uppercase tracking-wider">System Service Details</p>
            </div>
        </div>
        <span class="px-3 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-lg border border-emerald-200">
            @(Model?.Count ?? 0) Services
        </span>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-xs">
                <thead>
                    <tr class="border-b border-gray-100" style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">#</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Display Name</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Startup Type</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Description</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Logon</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">State</th>
                        <th class="px-4 py-3 text-left text-[10px] font-black text-gray-400 uppercase tracking-wider">Date</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @if (Model != null && Model.Any())
                    {
                        var idx = 0;
                        @foreach (var item in Model)
                        {
                            idx++;
                            <tr class="hover:bg-emerald-50/40 transition-colors">
                                <td class="px-4 py-2.5 text-gray-400 font-mono">@idx</td>
                                <td class="px-4 py-2.5 font-semibold text-gray-800">@item.DisplayName</td>
                                <td class="px-4 py-2.5">
                                    @if (item.StartupType == "Automatic")
                                    {
                                        <span class="px-2 py-0.5 bg-blue-50 text-blue-600 text-[10px] font-bold rounded-md border border-blue-200">@item.StartupType</span>
                                    }
                                    else if (item.StartupType == "Manual")
                                    {
                                        <span class="px-2 py-0.5 bg-amber-50 text-amber-600 text-[10px] font-bold rounded-md border border-amber-200">@item.StartupType</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 bg-gray-50 text-gray-500 text-[10px] font-bold rounded-md border border-gray-200">@item.StartupType</span>
                                    }
                                </td>
                                <td class="px-4 py-2.5 text-gray-500 max-w-[250px] truncate" title="@item.Description">@item.Description</td>
                                <td class="px-4 py-2.5 text-gray-500 font-mono text-[10px]">@item.LogonName</td>
                                <td class="px-4 py-2.5">
                                    @if (item.State == "Running")
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 bg-green-50 text-green-700 text-[10px] font-bold rounded-md border border-green-200">
                                            <span class="w-1.5 h-1.5 bg-green-500 rounded-full mr-1 animate-pulse"></span>@item.State
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 bg-gray-50 text-gray-500 text-[10px] font-bold rounded-md border border-gray-200">
                                            <span class="w-1.5 h-1.5 bg-gray-400 rounded-full mr-1"></span>@item.State
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-2.5 text-gray-400">@item.DateTime</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="px-4 py-12 text-center">
                                <div class="flex flex-col items-center">
                                    <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center mb-3">
                                        <i class="fas fa-cogs text-gray-300 text-lg"></i>
                                    </div>
                                    <p class="text-gray-400 font-semibold text-sm">No service data available</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
