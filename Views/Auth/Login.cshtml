    @model ManageEngineWebApp.Dtos.LoginDto

@{
    ViewData["Title"] = "Sign In - SYSNET";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <meta name="theme-color" content="#020617">
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preload"
          href="/images/sysnet-trinetra.webp"
          as="image"
          fetchpriority="high" />
    <style>
        * {
            box-sizing: border-box;
        }

        body, html {
            overflow-x: hidden;
            overflow-y: auto;
            height: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
        }

        .login-bg {
            background-image: url('/images/sysnet-trinetra.webp');
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            background-color: #020617;
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            padding: 0 1rem 1.5rem 1rem;
            position: relative;
        }

        /* Fix background on mobile/tablet */
        @@media (max-width: 1024px) {
            .login-bg {
                background-attachment: scroll;
                background-position: center center;
                padding-bottom: 1rem;
            }
        }

        @@media (max-width: 768px) {
            .login-bg {
                background-position: 35% center;
            }
        }

        @@media (max-width: 640px) {
            .login-bg {
                background-position: 30% center;
            }
        }

        @@media (max-width: 480px) {
            .login-bg {
                background-position: 25% center;
            }
        }

        /* Subtle overlay for better readability */
        .login-bg::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(to bottom, rgba(2, 6, 23, 0.05) 0%, rgba(2, 6, 23, 0.15) 100%);
            pointer-events: none;
        }

        .login-container {
            position: relative;
            width: 100%;
            max-width: 320px;
            z-index: 10;
            animation: fadeInUp 0.6s ease-out;
            animation-fill-mode: forwards !important;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* CRITICAL: Lock card transparency permanently */
        .glass-card {
            background: rgba(15, 23, 42, 0.9) !important; /* Significantly increased opacity */
            backdrop-filter: blur(40px) saturate(180%) !important;
            -webkit-backdrop-filter: blur(40px) saturate(180%) !important;
            border: 1px solid rgba(255, 255, 255, 0.12) !important;
            box-shadow: 0 10px 40px -5px rgba(0, 0, 0, 0.45) !important;
        }

            /* Force transparency in ALL states - no exceptions */
            .glass-card:hover,
            .glass-card:focus,
            .glass-card:focus-within,
            .glass-card:active {
                background: rgba(15, 23, 42, 0.9) !important;
                backdrop-filter: blur(40px) saturate(180%) !important;
            }

        /* Lock input transparency */
        .input-glass {
            background: rgba(255, 255, 255, 0.05) !important; 
            backdrop-filter: blur(16px) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            color: white !important;
            transition: all 0.3s ease !important;
        }

            .input-glass:hover {
                background: rgba(30, 41, 59, 0.5) !important;
                border-color: rgba(148, 163, 184, 0.4) !important;
            }

            .input-glass:focus {
                background: rgba(30, 41, 59, 0.6) !important;
                border-color: rgba(6, 182, 212, 0.7) !important;
                box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.1) !important;
                outline: none;
            }

        /* Enhanced autofill styling */
        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus,
        input:-webkit-autofill:active {
            -webkit-box-shadow: 0 0 0 1000px rgba(30, 41, 59, 0.5) inset !important;
            -webkit-text-fill-color: white !important;
            caret-color: white !important;
            transition: background-color 5000s ease-in-out 0s !important;
            border: 1px solid rgba(100, 116, 139, 0.3) !important;
        }

        /* Firefox autofill */
        input:-moz-autofill,
        input:-moz-autofill-preview {
            filter: none !important;
            background-color: rgba(30, 41, 59, 0.5) !important;
            color: white !important;
        }

        input:-internal-autofill-selected {
            background-color: rgba(30, 41, 59, 0.5) !important;
            background-image: none !important;
            color: white !important;
        }

        /* Better text rendering */
        input[type="text"],
        input[type="password"] {
            color: white !important;
            font-size: 16px;
            -webkit-text-fill-color: white !important;
            font-weight: 400;
        }

        /* Better placeholder */
        input::placeholder {
            color: rgba(203, 213, 225, 0.6) !important; 
            opacity: 1;
            font-weight: 300;
        }

        input:-ms-input-placeholder {
            color: rgba(203, 213, 225, 0.6) !important;
        }

        input::-ms-input-placeholder {
            color: rgba(203, 213, 225, 0.6) !important;
        }


        .glow-button {
            background: linear-gradient(135deg, rgba(6, 182, 212, 0.5) 0%, rgba(2, 132, 199, 0.5) 100%) !important;
            backdrop-filter: blur(12px) !important;
            -webkit-backdrop-filter: blur(12px) !important;
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.5), 0 4px 15px rgba(0, 0, 0, 0.2) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            transition: all 0.3s ease;
        }

            .glow-button:hover {
                background: linear-gradient(135deg, rgba(6, 182, 212, 0.7) 0%, rgba(2, 132, 199, 0.7) 100%) !important;
                box-shadow: 0 0 35px rgba(6, 182, 212, 0.7), 0 0 70px rgba(6, 182, 212, 0.4) !important;
                transform: translateY(-2px);
            }

        .error-alert {
            background: rgba(239, 68, 68, 0.15) !important;
            backdrop-filter: blur(16px) !important;
            -webkit-backdrop-filter: blur(16px) !important;
            border: 1px solid rgba(248, 113, 113, 0.3) !important;
        }

        /* Better text visibility */
        h2, p, label, span, a {
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
        }

        /* Responsive adjustments */
        @@media (max-width: 640px) {
            .login-bg {
                padding: 0 0.5rem 1rem 0.5rem;
            }

            .login-container {
                max-width: 100%;
            }

            .glass-card {
                padding: 0.75rem !important;
            }

            input, button {
                min-height: 40px;
                touch-action: manipulation;
            }
        }

        @@media (max-width: 480px) {
            .login-bg {
                padding: 0 0.5rem 0.75rem 0.5rem;
            }

            .glass-card {
                padding: 0.625rem !important;
            }
        }

        /* Small laptops */
        @@media (min-width: 1024px) and (max-height: 768px) {
            .login-bg {
                padding: 0 1rem 1rem 1rem;
            }

            .login-container {
                max-width: 300px;
            }
        }
    </style>

</head>
<body class="login-bg">

    <div class="login-container">
        <div class="glass-card rounded-xl px-4 py-3 sm:px-5 sm:py-4">

            <h2 class="text-center text-sm sm:text-base font-semibold text-white mb-0.5">
                Sign in to your account
            </h2>
            <p class="text-center text-[10px] sm:text-xs text-white mb-3 sm:mb-4">
                Welcome back! Please enter your credentials
            </p>

            @if (TempData["msg"] != null)
            {
                <div class="error-alert mb-2.5 sm:mb-3 rounded-lg px-2.5 py-1.5 text-[10px] sm:text-xs text-red-100">
                    <i class="fas fa-exclamation-circle mr-1.5"></i>@TempData["msg"]
                </div>
            }

            <form asp-action="Login" method="post" class="space-y-3">
                <div>
                    <label asp-for="Username" class="block text-xs font-medium text-white/95 mb-1 drop-shadow">
                        <i class="fas fa-user text-cyan-400 mr-1"></i> Username
                    </label>
                    <input asp-for="Username"
                           class="input-glass w-full rounded-lg border border-white/25 px-3 py-1.5 text-sm
                          text-white placeholder-gray-300
                          focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/60 focus:bg-slate-900/60 outline-none transition-all"
                           placeholder="enter Your username" />
                    <span asp-validation-for="Username" class="text-[10px] text-red-300 mt-0.5 block drop-shadow"></span>
                </div>

                <div>
                    <label asp-for="Password" class="block text-xs font-medium text-white/95 mb-1 drop-shadow">
                        <i class="fas fa-lock text-cyan-400 mr-1"></i> Password
                    </label>
                    <div class="relative">
                        <input asp-for="Password"
                               type="password"
                               id="passwordInput"
                               class="input-glass w-full rounded-lg border border-white/25 px-3 py-1.5 pr-9 text-sm
                              text-white placeholder-gray-300
                              focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/60 focus:bg-slate-900/60 outline-none transition-all"
                               placeholder="enter your password" />
                        <button type="button"
                                onclick="togglePassword()"
                                class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-gray-300 hover:text-cyan-300 transition-colors">
                            <i class="fas fa-eye text-xs" id="toggleIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-[10px] text-red-300 mt-0.5 block drop-shadow"></span>
                </div>

                <div class="flex items-center justify-between text-[11px]">
                    <label class="inline-flex items-center text-white/90 drop-shadow cursor-pointer">
                        <input type="checkbox" asp-for="RememberMe"
                               class="h-3.5 w-3.5 rounded border-white/30 bg-slate-900/50 text-cyan-500 focus:ring-cyan-500/70 cursor-pointer" />
                        <span class="ml-1.5">Remember me</span>
                    </label>
                    <a asp-action="ForgotPassword" class="text-cyan-300 hover:text-cyan-200 font-medium drop-shadow transition-colors">
                        Forgot password?
                    </a>
                </div>

                <button type="submit"
                        class="glow-button w-full rounded-lg bg-gradient-to-r from-cyan-500 to-blue-600
                       hover:from-cyan-400 hover:to-blue-500 text-white text-sm font-semibold
                       py-2 flex items-center justify-center gap-2
                       transition-all duration-300 transform hover:-translate-y-1 hover:scale-[1.02]">
                    <i class="fas fa-sign-in-alt text-sm"></i>
                    <span>Sign In</span>
                </button>

                <p class="pt-1 text-center text-[11px] text-white/90 drop-shadow-md">
                    Don't have an account?
                    <a asp-action="Register" class="text-cyan-300 hover:text-cyan-200 font-semibold transition-colors">
                        Create Account
                    </a>
                </p>
            </form>
        </div>

        <div class="mt-3 text-center text-[10px] text-white/80 drop-shadow-lg">
            <a asp-controller="Home" asp-action="Index"
               class="inline-flex items-center gap-1 hover:text-white transition-colors">
                <i class="fas fa-arrow-left text-[9px]"></i>
                Back to Home
            </a>
        </div>
    </div>

    <script>
        let lastTouchEnd = 0;
        document.addEventListener('touchend', function (event) {
            const now = (new Date()).getTime();
            if (now - lastTouchEnd <= 300) {
                event.preventDefault();
            }
            lastTouchEnd = now;
        }, false);

        document.addEventListener('gesturestart', function (e) {
            e.preventDefault();
        });

        document.addEventListener('gesturechange', function (e) {
            e.preventDefault();
        });

        document.addEventListener('gestureend', function (e) {
            e.preventDefault();
        });

        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('toggleIcon');
            if (!input) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
