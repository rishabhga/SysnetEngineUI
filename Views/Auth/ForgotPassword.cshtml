@model ManageEngineWebApp.ViewModels.ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <meta name="theme-color" content="#020617">
    <title>Forgot Password - SYSNET</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="preload" href="/images/sysnet-trinetra.webp" as="image" fetchpriority="high" />
    <style>
        * {
            box-sizing: border-box;
        }

        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            width: 100%;
            overflow-x: hidden;
            overflow-y: auto;
            font-family: 'Segoe UI', ui-sans-serif, system-ui, sans-serif;
        }

        .bg-page {
            position: relative;
            background-color: #020617;
            background-image: url('/images/sysnet-trinetra.webp');
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            padding: 0 1rem 1.5rem 1rem;
        }

        @@media (max-width: 1024px) {
            .bg-page {
                background-attachment: scroll;
            }
        }

        @@media (max-width: 768px) {
            .bg-page {
                background-position: 35% center;
            }
        }

        @@media (max-width: 640px) {
            .bg-page {
                background-position: 30% center;
                padding: 0 0.5rem 1rem 0.5rem;
            }
        }

        @@media (max-width: 480px) {
            .bg-page {
                background-position: 25% center;
            }
        }

        @@media (min-width: 1024px) and (max-height: 768px) {
            .bg-page {
                padding: 0 1rem 1rem 1rem;
            }
        }

        /* Overlay - same gradient as Login/Register */
        .bg-page::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, rgba(2,6,23,0.05) 0%, rgba(2,6,23,0.20) 100%);
            pointer-events: none;
        }

        .login-container {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 380px;
            animation: fadeInUp 0.55s ease-out forwards;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(28px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .glass-card {
            background: rgba(15, 23, 42, 0.9) !important;
            backdrop-filter: blur(40px) saturate(180%) !important;
            -webkit-backdrop-filter: blur(40px) saturate(180%) !important;
            border: 1px solid rgba(255, 255, 255, 0.12) !important;
            box-shadow: 0 10px 40px -5px rgba(0, 0, 0, 0.45) !important;
        }

        .input-glass {
            background: rgba(255, 255, 255, 0.05) !important;
            backdrop-filter: blur(16px) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            color: white !important;
            transition: all 0.3s ease !important;
        }

            .input-glass:hover {
                background: rgba(30, 41, 59, 0.5) !important;
                border-color: rgba(148, 163, 184, 0.4) !important;
            }

            .input-glass:focus {
                background: rgba(30, 41, 59, 0.6) !important;
                border-color: rgba(6, 182, 212, 0.7) !important;
                box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.1) !important;
                outline: none;
            }

        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus {
            -webkit-box-shadow: 0 0 0 1000px rgba(30, 41, 59, 0.5) inset !important;
            -webkit-text-fill-color: white !important;
            caret-color: white !important;
            transition: background-color 5000s ease-in-out 0s !important;
        }

        input[type="email"] {
            color: white !important;
            -webkit-text-fill-color: white !important;
            font-size: 16px;
        }

        input::placeholder {
            color: rgba(203, 213, 225, 0.6) !important;
            opacity: 1;
        }

        .glow-button {
            background: linear-gradient(135deg, rgba(6, 182, 212, 0.5) 0%, rgba(2, 132, 199, 0.5) 100%) !important;
            backdrop-filter: blur(12px) !important;
            -webkit-backdrop-filter: blur(12px) !important;
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.5), 0 4px 15px rgba(0, 0, 0, 0.2) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            transition: all 0.3s ease;
        }

            .glow-button:hover {
                background: linear-gradient(135deg, rgba(6, 182, 212, 0.7) 0%, rgba(2, 132, 199, 0.7) 100%) !important;
                box-shadow: 0 0 35px rgba(6, 182, 212, 0.7), 0 0 70px rgba(6, 182, 212, 0.4) !important;
                transform: translateY(-2px);
            }

        .success-alert {
            background: rgba(16, 185, 129, 0.15) !important;
            backdrop-filter: blur(16px) !important;
            border: 1px solid rgba(52, 211, 153, 0.35) !important;
        }

        .error-alert {
            background: rgba(239, 68, 68, 0.15) !important;
            backdrop-filter: blur(16px) !important;
            border: 1px solid rgba(248, 113, 113, 0.3) !important;
        }

        .icon-badge {
            background: linear-gradient(135deg, rgba(6,182,212,0.9), rgba(2,132,199,0.9));
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.45);
        }

        h2, p, label, span, a {
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
        }

        @@media (max-width: 640px) {
            .login-container {
                max-width: 100%;
            }

            input, button {
                min-height: 40px;
                touch-action: manipulation;
            }
        }

        @@media (min-width: 1024px) and (max-height: 768px) {
            .login-container {
                max-width: 340px;
            }
        }
    </style>
</head>
<body class="bg-page">

    <div class="login-container">
        <div class="glass-card rounded-xl px-5 py-5 sm:px-6 sm:py-6 relative overflow-hidden">

            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-cyan-400 to-blue-600"></div>

            <div class="text-center mb-5">
                <div class="icon-badge w-12 h-12 rounded-full inline-flex items-center justify-center mb-3">
                    <i class="fa fa-unlock-keyhole text-white text-lg"></i>
                </div>
                <h2 class="text-base sm:text-lg font-bold text-white mb-1">Forgot Password</h2>
                <p class="text-white/70 text-[11px] sm:text-xs leading-relaxed">Enter your registered email and we'll send you a link to reset your password.</p>
            </div>

            @if (TempData["SuccessMsg"] != null)
            {
                <div class="success-alert mb-4 rounded-lg px-3 py-2.5 flex items-start gap-2.5">
                    <i class="fa fa-circle-check mt-0.5 text-green-300 flex-shrink-0"></i>
                    <div class="text-xs font-medium text-green-100">@TempData["SuccessMsg"]</div>
                </div>
                <div class="text-center">
                    <a href="/Auth/Login"
                       class="inline-flex items-center gap-1 text-xs font-semibold text-cyan-300 hover:text-cyan-200 transition-colors">
                        <i class="fa fa-arrow-left"></i> Return to Login
                    </a>
                </div>
            }
            else
            {
                @if (!ViewData.ModelState.IsValid)
                {
                    var errors = ViewData.ModelState[""]?.Errors;
                    if (errors != null && errors.Count > 0)
                    {
                        foreach (var err in errors)
                        {
                            <div class="error-alert mb-3 rounded-lg px-3 py-2.5 flex items-start gap-2.5">
                                <i class="fa fa-triangle-exclamation mt-0.5 text-red-300 flex-shrink-0"></i>
                                <div class="text-xs font-medium text-red-100">@err.ErrorMessage</div>
                            </div>
                        }
                    }
                }

                <form method="post" id="fpForm" class="space-y-4">
                    @Html.AntiForgeryToken()

                    <div>
                        <label asp-for="Email" class="block text-xs font-medium text-white/95 mb-1 drop-shadow">Email Address</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-300">
                                <i class="fa fa-envelope text-xs"></i>
                            </span>
                            <input asp-for="Email"
                                   type="email"
                                   class="input-glass w-full rounded-lg pl-9 pr-3 py-2 text-sm text-white placeholder-gray-300 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/60 outline-none transition-all"
                                   placeholder="e.g. name@company.com"
                                   autocomplete="email"
                                   required />
                        </div>
                        <span asp-validation-for="Email" class="text-[10px] text-red-300 mt-0.5 block drop-shadow"></span>
                    </div>

                    <button type="submit"
                            id="btnSubmit"
                            class="glow-button w-full rounded-lg text-white text-sm font-semibold py-2.5 flex items-center justify-center gap-2 transition-all duration-300 transform hover:-translate-y-1 hover:scale-[1.02]">
                        <span>Send Reset Link</span>
                        <i class="fa fa-paper-plane text-xs"></i>
                    </button>
                </form>

                <p class="pt-4 text-center text-[11px] text-white/90 drop-shadow-md">
                    <a href="/Auth/Login" class="inline-flex items-center gap-1 text-cyan-300 hover:text-cyan-200 font-semibold transition-colors">
                        <i class="fa fa-arrow-left text-[10px]"></i> Back to Login
                    </a>
                </p>
            }
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.getElementById('fpForm')?.addEventListener('submit', function (e) {
            if ($(this).valid()) {
                const btn = document.getElementById('btnSubmit');
                btn.innerHTML = '<i class="fa fa-spinner fa-spin mr-2"></i> Sending...';
                btn.style.opacity = '0.8';
                btn.style.pointerEvents = 'none';
            }
        });
    </script>
</body>
</html>
