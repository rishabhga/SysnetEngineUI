@model ManageEngineWebApp.ViewModels.ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Forgot Password</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body {
            background: linear-gradient(135deg,#0f2347,#1a3c6e,#1e5799);
            font-family: 'Segoe UI',system-ui,sans-serif;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">

    <div class="bg-white rounded-2xl w-full max-w-md p-10 shadow-[0_20px_60px_rgba(0,0,0,0.35)] relative overflow-hidden">
        
        <div class="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-[#00BCEB] to-[#0096BE]"></div>

        <div class="text-center mb-8">
            <div class="w-16 h-16 bg-gradient-to-br from-[#1a3c6e] to-[#2a5c9e] rounded-full inline-flex items-center justify-center mb-4 shadow-lg">
                <i class="fa fa-unlock-keyhole text-white text-2xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-[#1a3c6e] mb-2">Forgot Password</h2>
            <p class="text-gray-500 text-sm">Enter your registered email and we'll send you a link to reset your password.</p>
        </div>

        @if (TempData["SuccessMsg"] != null)
        {
            <div class="mb-6 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl flex items-start gap-3 shadow-sm">
                <i class="fa fa-circle-check mt-0.5 text-green-500"></i>
                <div class="text-sm font-medium">@TempData["SuccessMsg"]</div>
            </div>
            
            <div class="mt-6 text-center">
                <a href="/Auth/Login" class="inline-block text-sm font-semibold text-[#1a3c6e] hover:text-[#00BCEB] transition-colors">
                    <i class="fa fa-arrow-left mr-1"></i> Return to Login
                </a>
            </div>
        }
        else
        {
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl flex items-start gap-3 shadow-sm">
                    <i class="fa fa-triangle-exclamation mt-0.5 text-red-500"></i>
                    <div class="text-sm">@Html.ValidationSummary(false)</div>
                </div>
            }

            <form method="post" id="fpForm">
                @Html.AntiForgeryToken()

                <div class="mb-6">
                    <label asp-for="Email" class="block text-sm font-semibold text-gray-700 mb-2"></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
                            <i class="fa fa-envelope"></i>
                        </span>
                        <input asp-for="Email" type="email" class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-[#00BCEB] focus:border-[#00BCEB] outline-none transition-all text-sm" placeholder="e.g. name@company.com" autocomplete="email" required />
                    </div>
                    <span asp-validation-for="Email" class="text-red-500 text-xs mt-1.5 block"></span>
                </div>

                <button type="submit" class="w-full bg-gradient-to-r from-[#1a3c6e] to-[#2a5c9e] hover:from-[#153058] hover:to-[#1a3c6e] text-white font-bold py-3 px-4 rounded-xl shadow-md transition-all flex justify-center items-center gap-2 mb-6" id="btnSubmit">
                    <span>Send Reset Link</span>
                    <i class="fa fa-paper-plane ml-1"></i>
                </button>
            </form>

            <div class="text-center">
                <a href="/Auth/Login" class="text-sm font-semibold text-[#1a3c6e] hover:text-[#00BCEB] transition-colors">
                    <i class="fa fa-arrow-left mr-1"></i> Back to Login
                </a>
            </div>
        }
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.getElementById('fpForm')?.addEventListener('submit', function (e) {
            if ($(this).valid()) {
                const btn = document.getElementById('btnSubmit');
                btn.innerHTML = '<i class="fa fa-spinner fa-spin mr-2"></i> Sending...';
                btn.style.opacity = '0.8';
                btn.style.pointerEvents = 'none';
            }
        });
    </script>
</body>
</html>
