@model ManageEngineWebApp.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="flex justify-center mt-6">
    <div class="w-full max-w-lg">

        @if (TempData["SuccessMsg"] != null)
        {
            <div class="mb-4 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg flex items-center gap-2 shadow-sm">
                <i class="fa fa-circle-check text-green-500"></i> @TempData["SuccessMsg"]
            </div>
        }

        <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100">
            <div class="bg-gradient-to-r from-[#1a3c6e] to-[#2a5c9e] px-5 py-4 border-b border-gray-200">
                <h5 class="text-white font-semibold flex items-center mb-0 text-lg">
                    <i class="fa fa-key mr-2"></i>Change Password
                </h5>
            </div>
            <div class="p-6">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex items-start gap-2 shadow-sm">
                        <i class="fa fa-triangle-exclamation mt-0.5 text-red-500"></i>
                        <div class="text-sm">@Html.ValidationSummary(false)</div>
                    </div>
                }

                <form method="post" id="cpForm">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Username</label>
                        <div class="relative flex opacity-75">
                            <span class="inline-flex items-center px-3 rounded-l-lg border border-r-0 border-gray-300 bg-gray-100 text-gray-500">
                                <i class="fa fa-user"></i>
                            </span>
                            <input type="text" asp-for="Username" class="flex-1 min-w-0 block w-full px-3 py-2 rounded-r-lg border border-gray-300 bg-gray-100 text-gray-600 sm:text-sm" disabled readonly />
                        </div>
                        <p class="text-xs text-gray-500 mt-1"><i class="fa fa-circle-info mr-1"></i>You can only change your own password.</p>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CurrentPassword" class="block text-sm font-semibold text-gray-700 mb-1"></label>
                        <div class="relative flex">
                            <span class="inline-flex items-center px-3 rounded-l-lg border border-r-0 border-gray-300 bg-gray-50 text-gray-500">
                                <i class="fa fa-lock"></i>
                            </span>
                            <input asp-for="CurrentPassword" type="password" class="flex-1 min-w-0 block w-full px-3 py-2 rounded-none border border-gray-300 focus:ring-[#00BCEB] focus:border-[#00BCEB] text-sm transition-colors" id="curPw" placeholder="Your current password" />
                            <button class="inline-flex items-center px-3 rounded-r-lg border border-l-0 border-gray-300 bg-white text-gray-400 hover:text-gray-600 hover:bg-gray-50 transition-colors" type="button" onclick="tog('curPw',this)">
                                <i class="fa fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="NewPassword" class="block text-sm font-semibold text-gray-700 mb-1"></label>
                        <div class="relative flex">
                            <span class="inline-flex items-center px-3 rounded-l-lg border border-r-0 border-gray-300 bg-gray-50 text-gray-500">
                                <i class="fa fa-lock-open"></i>
                            </span>
                            <input asp-for="NewPassword" type="password" class="flex-1 min-w-0 block w-full px-3 py-2 rounded-none border border-gray-300 focus:ring-[#00BCEB] focus:border-[#00BCEB] text-sm transition-colors" id="newPw" placeholder="Min 8 characters" />
                            <button class="inline-flex items-center px-3 rounded-r-lg border border-l-0 border-gray-300 bg-white text-gray-400 hover:text-gray-600 hover:bg-gray-50 transition-colors" type="button" onclick="tog('newPw',this)">
                                <i class="fa fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <div class="w-full bg-gray-200 rounded-full h-1.5 mb-1 mt-2">
                        <div class="h-1.5 rounded-full transition-all duration-300" id="sBar" style="width:0; background-color: transparent;"></div>
                    </div>
                    <small id="sTxt" class="block mb-4 text-xs font-medium h-4"></small>

                    <div class="mb-6">
                        <label asp-for="ConfirmNewPassword" class="block text-sm font-semibold text-gray-700 mb-1"></label>
                        <div class="relative flex">
                            <span class="inline-flex items-center px-3 rounded-l-lg border border-r-0 border-gray-300 bg-gray-50 text-gray-500">
                                <i class="fa fa-lock-open"></i>
                            </span>
                            <input asp-for="ConfirmNewPassword" type="password" class="flex-1 min-w-0 block w-full px-3 py-2 rounded-none border border-gray-300 focus:ring-[#00BCEB] focus:border-[#00BCEB] text-sm transition-colors" id="conPw" placeholder="Re-enter new password" />
                            <button class="inline-flex items-center px-3 rounded-r-lg border border-l-0 border-gray-300 bg-white text-gray-400 hover:text-gray-600 hover:bg-gray-50 transition-colors" type="button" onclick="tog('conPw',this)">
                                <i class="fa fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmNewPassword" class="text-red-500 text-xs mt-1 block"></span>
                        <div id="matchMsg" class="text-xs mt-1.5 font-medium h-4"></div>
                    </div>

                    <button type="submit" class="w-full bg-gradient-to-r from-[#1a3c6e] to-[#2a5c9e] hover:from-[#153058] hover:to-[#1a3c6e] text-white font-bold py-2.5 px-4 rounded-lg shadow transition-all flex justify-center items-center gap-2">
                        <i class="fa fa-floppy-disk"></i> Update Password
                    </button>
                </form>
            </div>
        </div>

        <div class="bg-gray-50 rounded-xl border border-gray-200 mt-4 p-4 shadow-sm">
            <p class="mb-2 font-semibold text-gray-600 text-sm flex items-center">
                <i class="fa fa-shield-halved mr-2"></i>Requirements
            </p>
            <ul class="text-xs text-gray-500 space-y-1 ml-6 list-disc marker:text-gray-400">
                <li id="r1" class="transition-colors duration-200">At least 8 characters</li>
                <li id="r2" class="transition-colors duration-200">One uppercase letter</li>
                <li id="r3" class="transition-colors duration-200">One number</li>
                <li id="r4" class="transition-colors duration-200">One special character</li>
            </ul>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function tog(id,btn){
          const i=document.getElementById(id);
          i.type=i.type==='password'?'text':'password';
          btn.querySelector('i').className=i.type==='text'?'fa fa-eye-slash':'fa fa-eye';
        }
        
        const pw=document.getElementById('newPw');
        const cpw=document.getElementById('conPw');
        const colors=['transparent','#ef4444','#f97316','#eab308','#22c55e'];
        
        pw.addEventListener('input',()=>{
          const v=pw.value;
          const c=[v.length>=8,/[A-Z]/.test(v),/[0-9]/.test(v),/[^A-Za-z0-9]/.test(v)];
          const s=c.filter(Boolean).length;
          
          document.getElementById('sBar').style.cssText=`width:${s*25}%;background-color:${colors[s]}`;
          document.getElementById('sTxt').textContent=['','Weak','Fair','Good','Strong'][s];
          document.getElementById('sTxt').style.color=colors[s] !== 'transparent' ? colors[s] : '';
          
          ['r1','r2','r3','r4'].forEach((id,i)=>{
            const el = document.getElementById(id);
            if(c[i]){
                el.classList.add('text-green-600', 'font-medium');
                el.classList.remove('text-gray-500');
            } else {
                el.classList.remove('text-green-600', 'font-medium');
                el.classList.add('text-gray-500');
            }
          });
          checkMatch();
        });
        
        cpw.addEventListener('input',checkMatch);
        
        function checkMatch(){
          const m=document.getElementById('matchMsg');
          if(!cpw.value){m.textContent='';return;}
          if(pw.value===cpw.value){
              m.innerHTML='<span class="text-green-600"><i class="fa fa-check mr-1"></i> Passwords match</span>';
          }else{
              m.innerHTML='<span class="text-red-500"><i class="fa fa-xmark mr-1"></i> Passwords do not match</span>';
          }
        }
    </script>
}
