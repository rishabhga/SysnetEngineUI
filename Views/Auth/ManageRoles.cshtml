@model List<ManageEngineWebApp.Datacontext.UserRoleDto>
@{
    ViewData["Title"] = "Manage User Roles";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var username = Context.Session.GetString("username");
}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-4 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="flex items-center space-x-3 w-full sm:w-auto">
            <a href="@Url.Action("Companies", "Companies")"
               class="w-8 h-8 bg-white border border-gray-200 hover:bg-gray-50 rounded-lg flex items-center justify-center transition shadow-sm text-sm">
                <i class="fas fa-arrow-left text-gray-600"></i>
            </a>
            <div class="flex items-center space-x-3">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center shadow-md bg-gradient-to-br from-cyan-500 to-blue-600">
                    <i class="fas fa-user-shield text-white text-base"></i>
                </div>
                <div>
                    <h1 class="text-lg font-bold text-gray-900 leading-tight">Role Management</h1>
                    <p class="text-xs text-gray-600 hidden sm:block">Manage user roles and permissions</p>
                </div>
            </div>
        </div>
        <div class="flex items-center space-x-2 w-full sm:w-auto justify-end">
            <a href="@Url.Action("Register", "Auth")"
               class="px-3 py-1.5 text-white rounded-md text-xs font-semibold uppercase tracking-wide transition-colors flex items-center space-x-1 shadow-sm bg-gradient-to-r from-lime-500 to-lime-600 hover:from-lime-600 hover:to-lime-700">
                <i class="fas fa-user-plus"></i>
                <span>Register</span>
            </a>
            <button onclick="openAssignRoleModal()"
                    class="px-3 py-1.5 text-white rounded-md text-xs font-semibold uppercase tracking-wide transition-colors flex items-center space-x-1 shadow-sm bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-600 hover:to-blue-700">
                <i class="fas fa-plus"></i>
                <span>Assign</span>
            </button>
        </div>
    </div>

    <!-- Stats Cards - Compact -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
        <div class="bg-white rounded-lg border border-gray-200 p-3 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Super Admin</p>
                    <p class="text-xl font-bold text-gray-900 mt-0.5">1</p>
                </div>
                <div class="w-8 h-8 rounded-md flex items-center justify-center bg-gradient-to-br from-red-500 to-red-600 shadow-sm">
                    <i class="fas fa-crown text-white text-sm"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-3 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Company Admins</p>
                    <p class="text-xl font-bold text-gray-900 mt-0.5">@Model.Count(u => u.Role == "CompanyAdmin")</p>
                </div>
                <div class="w-8 h-8 rounded-md flex items-center justify-center bg-gradient-to-br from-cyan-500 to-blue-600 shadow-sm">
                    <i class="fas fa-building text-white text-sm"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-3 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Company Users</p>
                    <p class="text-xl font-bold text-gray-900 mt-0.5">@Model.Count(u => u.Role == "CompanyUser")</p>
                </div>
                <div class="w-8 h-8 bg-purple-500 rounded-md flex items-center justify-center shadow-sm">
                    <i class="fas fa-user text-white text-sm"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-3 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">No Role</p>
                    <p class="text-xl font-bold text-gray-900 mt-0.5">@Model.Count(u => string.IsNullOrEmpty(u.Role))</p>
                </div>
                <div class="w-8 h-8 bg-gray-500 rounded-md flex items-center justify-center shadow-sm">
                    <i class="fas fa-user-clock text-white text-sm"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table - Density Compact -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden text-sm">
        <div class="overflow-x-auto">
            <table class="w-full whitespace-nowrap">
                <thead class="bg-slate-50 border-b border-gray-200">
                    <tr>
                        <th class="px-4 py-3 text-left text-[11px] font-bold text-gray-500 uppercase tracking-wider">Username</th>
                        <th class="px-4 py-3 text-left text-[11px] font-bold text-gray-500 uppercase tracking-wider">Role</th>
                        <th class="px-4 py-3 text-left text-[11px] font-bold text-gray-500 uppercase tracking-wider">Company</th>
                        <th class="px-4 py-3 text-left text-[11px] font-bold text-gray-500 uppercase tracking-wider">Device</th>
                        <th class="px-4 py-3 text-right text-[11px] font-bold text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var user in Model)
                    {
                        <tr class="hover:bg-cyan-50/30 transition-colors group">
                            <td class="px-4 py-2.5">
                                <div class="flex items-center">
                                    <div class="w-7 h-7 rounded bg-gray-100 flex items-center justify-center mr-2 text-gray-500 group-hover:bg-cyan-100 group-hover:text-cyan-600 transition">
                                        <i class="fas fa-user text-xs"></i>
                                    </div>
                                    <span class="font-semibold text-gray-700">@user.Username</span>
                                </div>
                            </td>
                            <td class="px-4 py-2.5">
                                @if (user.Role == "SuperAdmin")
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-red-100 text-red-700 border border-red-200">
                                        <i class="fas fa-crown mr-1"></i>Super Admin
                                    </span>
                                }
                                else if (user.Role == "CompanyAdmin")
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-cyan-100 text-cyan-700 border border-cyan-200">
                                        <i class="fas fa-building mr-1"></i>Company Admin
                                    </span>
                                }
                                else if (user.Role == "CompanyUser")
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-purple-100 text-purple-700 border border-purple-200">
                                        <i class="fas fa-user mr-1"></i>Company User
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 bg-gray-100 text-gray-500 rounded text-[10px] font-medium border border-gray-200">
                                        <i class="fas fa-user-clock mr-1"></i>No Role
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-2.5 text-gray-600 text-xs">
                                @if (user.CompanyId.HasValue)
                                {
                                    <div class="flex flex-col">
                                        <span class="font-medium text-gray-700">@user.CompanyName</span>
                                        <span class="text-[10px] text-gray-400">ID: @user.CompanyId</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-gray-400">-</span>
                                }
                            </td>
                            <td class="px-4 py-2.5 text-gray-600 text-xs">
                                @if (!string.IsNullOrEmpty(user.DomainName))
                                {
                                    <span class="font-medium text-purple-600 bg-purple-50 px-2 py-0.5 rounded border border-purple-100">@user.DomainName</span>
                                }
                                else
                                {
                                    <span class="text-gray-400">-</span>
                                }
                            </td>
                            <td class="px-4 py-2.5 text-right">
                                @if (user.Role != "SuperAdmin")
                                {
                                    <div class="flex items-center justify-end space-x-2">
                                        <button onclick="editRole('@user.Username', '@user.Role', @(user.CompanyId?.ToString() ?? "null"), '@(user.DomainName ?? "")')"
                                                class="inline-flex items-center px-2.5 py-1 text-white rounded-md hover:opacity-90 text-[11px] font-bold uppercase tracking-wide shadow-sm transition-all"
                                                style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                                            <i class="fas fa-edit mr-1"></i>Edit
                                        </button>
                                        <button onclick="removeRole('@user.Username')"
                                                class="inline-flex items-center px-2.5 py-1 bg-red-500 text-white rounded-md hover:bg-red-600 text-[11px] font-bold uppercase tracking-wide shadow-sm transition-all">
                                            <i class="fas fa-trash mr-1"></i>Remove
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-gray-300 text-[10px] italic">Protected</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- Assign Role Modal -->
<div id="assignRoleModal" class="fixed inset-0 bg-black bg-opacity-50 backdrop-blur-sm z-50 hidden items-center justify-center">
    <div class="bg-white rounded-xl shadow-2xl max-w-md w-full mx-4">
        <div class="px-6 py-4 rounded-t-xl flex items-center justify-between" style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
            <h3 class="text-lg font-bold text-white">Assign Role</h3>
            <button onclick="closeAssignRoleModal()" class="text-white hover:text-gray-200 text-xl">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="p-6">
            <div class="mb-4">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Username *</label>
                <input type="text" id="assignUsername"
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:border-transparent"
                       placeholder="Enter username" required>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Role *</label>
                <select id="assignRole" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:border-transparent">
                    <option value="">-- Select Role --</option>
                    <option value="CompanyAdmin">Company Admin</option>
                    <option value="CompanyUser">Company User</option>
                </select>
                <small class="text-gray-500">Super Admin role is hardcoded.</small>
            </div>
            <div class="mb-4 hidden" id="companySelectDiv">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Company *</label>
                <select id="assignCompany" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:border-transparent">
                    <option value="">Loading...</option>
                </select>
            </div>
            <!-- NEW: Device Dropdown for CompanyUser -->
            <div class="mb-4 hidden" id="domainSelectDiv">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Assign Device *</label>
                <select id="assignDomain" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:border-transparent">
                    <option value="">-- Select Company First --</option>
                </select>
            </div>
            <div id="assignMessage" class="mt-4 p-3 rounded-lg text-sm font-medium hidden"></div>
            <div class="flex justify-end space-x-3 mt-6">
                <button onclick="closeAssignRoleModal()" class="px-5 py-2.5 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 font-medium">
                    Cancel
                </button>
                <button onclick="submitAssignRole()" id="assignRoleBtn"
                        class="px-5 py-2.5 text-white rounded-lg hover:opacity-90 font-medium shadow-sm"
                        style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                    <i class="fas fa-check mr-2"></i>Assign Role
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        function openAssignRoleModal() {
            document.getElementById('assignRoleModal').classList.remove('hidden');
            document.getElementById('assignRoleModal').classList.add('flex');
            document.getElementById('assignMessage').classList.add('hidden');
            loadCompaniesForModal();
        }

        function closeAssignRoleModal() {
            document.getElementById('assignRoleModal').classList.add('hidden');
            document.getElementById('assignRoleModal').classList.remove('flex');
            document.getElementById('assignUsername').value = '';
            document.getElementById('assignRole').value = '';
            document.getElementById('assignCompany').value = '';
            document.getElementById('assignDomain').value = '';
            $('#companySelectDiv').addClass('hidden');
            $('#domainSelectDiv').addClass('hidden');
        }
        // Role change handler - Show/hide dropdowns
        $('#assignRole').on('change', function () {
            var role = $(this).val();
            if (role === 'CompanyAdmin') {
                $('#companySelectDiv').removeClass('hidden');
                $('#domainSelectDiv').addClass('hidden');
                $('#assignDomain').val('');
            } else if (role === 'CompanyUser') {
                $('#companySelectDiv').removeClass('hidden');
                $('#domainSelectDiv').removeClass('hidden');
            } else {
                $('#companySelectDiv').addClass('hidden');
                $('#domainSelectDiv').addClass('hidden');
                $('#assignDomain').val('');
            }
        });
        // Company change handler - Load devices for CompanyUser
        $('#assignCompany').on('change', function () {
            var companyId = $(this).val();
            var role = $('#assignRole').val();
            if (companyId && role === 'CompanyUser') {
                $('#assignDomain').html('<option value="">Loading devices...</option>');

                $.ajax({
                    url: '/ComputerSummary/GetDevicesByCompany?companyId=' + companyId,
                    type: 'GET',
                    success: function (data) {
                        var options = '<option value="">-- Select Device --</option>';
                        if (data && data.length > 0) {
                            data.forEach(function (device) {
                                options += '<option value="' + device.domainName + '">' +
                                           device.domainName + ' (' + (device.userName || 'N/A') + ')</option>';
                            });
                        } else {
                            options = '<option value="">No devices found</option>';
                        }
                        $('#assignDomain').html(options);
                    },
                    error: function () {
                        $('#assignDomain').html('<option value="">Error loading devices</option>');
                    }
                });
            }
        });
        function loadCompaniesForModal() {
            $.ajax({
                url: '/Companies/GetCompaniesForDropdown',
                type: 'GET',
                success: function (companies) {
                    $('#assignCompany').html('<option value="">-- Select Company --</option>');
                    if (companies && companies.length > 0) {
                        companies.forEach(function (company) {
                            $('#assignCompany').append('<option value="' + company.id + '">' + company.companyName + '</option>');
                        });
                    } else {
                        $('#assignCompany').html('<option value="">No companies available</option>');
                    }
                },
                error: function () {
                    $('#assignCompany').html('<option value="">Error loading companies</option>');
                }
            });
        }
        function submitAssignRole() {
            const username = $('#assignUsername').val().trim();
            const role = $('#assignRole').val();
            const companyId = $('#assignCompany').val();
            const domainName = $('#assignDomain').val();
            const messageEl = $('#assignMessage');
            const btn = $('#assignRoleBtn');
            if (!username) {
                showMessage(messageEl, 'Please enter a username!', 'error');
                return false;
            }
            if (!role) {
                showMessage(messageEl, 'Please select a role!', 'error');
                return false;
            }
            if ((role === 'CompanyAdmin' || role === 'CompanyUser') && !companyId) {
                showMessage(messageEl, 'Please select a company!', 'error');
                return false;
            }
            if (role === 'CompanyUser' && !domainName) {
                showMessage(messageEl, 'Please select a device for Company User!', 'error');
                return false;
            }
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-2"></i>Assigning...');
            $.ajax({
                url: '@Url.Action("AssignRole", "Auth")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    Username: username,
                    Role: role,
                    CompanyId: companyId ? parseInt(companyId) : null,
                    DomainName: domainName || null
                }),
                success: function (response) {
                    if (response.success) {
                        showMessage(messageEl, response.message, 'success');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showMessage(messageEl, response.message, 'error');
                        btn.prop('disabled', false).html('<i class="fas fa-check mr-2"></i>Assign Role');
                    }
                },
                error: function (xhr, status, error) {
                    showMessage(messageEl, 'Network error: ' + error, 'error');
                    btn.prop('disabled', false).html('<i class="fas fa-check mr-2"></i>Assign Role');
                }
            });
        }
        function editRole(username, currentRole, companyId, domainName) {
            $('#assignUsername').val(username);
            $('#assignRole').val(currentRole).trigger('change');
            setTimeout(function() {
                if (companyId) {
                    $('#assignCompany').val(companyId);
                    if (currentRole === 'CompanyUser') {
                        $('#assignCompany').trigger('change');

                        setTimeout(function() {
                            if (domainName) {
                                $('#assignDomain').val(domainName);
                            }
                        }, 1500);
                    }
                }
            }, 800);

            openAssignRoleModal();
        }
        function removeRole(username) {
            if (!confirm('Remove role from user "' + username + '"?')) return;
            $.ajax({
                url: '@Url.Action("RemoveRole", "Auth")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ Username: username }),
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert('Error removing role');
                }
            });
        }
        function showMessage(el, message, type) {
            el.removeClass('hidden bg-red-50 text-red-700 bg-green-50 text-green-700');
            if (type === 'success') {
                el.addClass('bg-green-50 text-green-700');
            } else {
                el.addClass('bg-red-50 text-red-700');
            }
            el.text(message).removeClass('hidden');
        }
    </script>
}