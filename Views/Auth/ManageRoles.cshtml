                                <button onclick="selectAllMenus()" class="text-[10px] text-sky-500 hover:text-sky-700 font-semibold">Select All</button>
                                <button onclick="clearAllMenus()" class="text-[10px] text-gray-400 hover:text-gray-600 font-semibold">Clear</button>
