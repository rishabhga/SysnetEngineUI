@model List<ManageEngineWebApp.Dtos.UserRoleDto>
@{
    ViewData["Title"] = "Manage User Roles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@functions {
    public string FormatRole(string name) =>
        string.IsNullOrEmpty(name) ? "" :
        System.Text.RegularExpressions.Regex.Replace(name, "([A-Z])", " $1").Trim();
}

<style>
    .pop-wrap {
        position: relative;
        display: inline-block;
    }

        .pop-wrap .pop-box {
            display: none;
            position: absolute;
            left: 0;
            top: calc(100% + 4px);
            min-width: 180px;
            max-width: 240px;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            box-shadow: 0 8px 24px -4px rgba(0,0,0,.14);
            padding: 6px;
            z-index: 200;
        }

        .pop-wrap:hover .pop-box {
            display: block;
        }

    .pop-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 4px 6px;
        border-radius: 5px;
        font-size: 10px;
        color: #374151;
        gap: 4px;
    }

        .pop-item:hover {
            background: #f0f9ff;
        }

    .pop-del {
        color: #d1d5db;
        cursor: pointer;
        border: none;
        background: none;
        padding: 0;
        line-height: 1;
    }

        .pop-del:hover {
            color: #ef4444;
        }

    .scope-badge {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        padding: 2px 7px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 600;
        cursor: default;
        white-space: nowrap;
    }

    .rm-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.55);
        backdrop-filter: blur(6px);
        z-index: 50;
        align-items: center;
        justify-content: center;
    }

        .rm-overlay.open {
            display: flex;
            animation: rmFadeIn .18s ease;
        }

    @@keyframes rmFadeIn {
        from {
            opacity: 0
        }

        to {
            opacity: 1
        }
    }

    .mc-list {
        max-height: 160px;
        overflow-y: auto;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #f8fafc;
    }

        .mc-list::-webkit-scrollbar {
            width: 4px;
        }

        .mc-list::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

    .mc-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        font-size: 11px;
        color: #374151;
        cursor: pointer;
        border-bottom: 1px solid #f1f5f9;
        transition: background .1s;
    }

        .mc-item:last-child {
            border-bottom: none;
        }

        .mc-item:hover:not(.mc-disabled) {
            background: #e0f5fc;
        }

        .mc-item.mc-disabled {
            opacity: .55;
            cursor: not-allowed;
        }

        .mc-item input[type=checkbox] {
            accent-color: #00BCEB;
            flex-shrink: 0;
        }

        .mc-item .already-tag {
            margin-left: auto;
            font-size: 9px;
            font-weight: 700;
            background: #d1fae5;
            color: #065f46;
            padding: 1px 5px;
            border-radius: 4px;
        }

    .role-tbl tbody tr {
        transition: background .15s;
    }

        .role-tbl tbody tr:hover {
            background: #f0f9ff;
        }

    .role-tbl thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: #f8fafc;
    }
</style>

<div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-6 py-4">

    <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
            <a href="@Url.Action("Companies", "Companies")"
               class="w-7 h-7 bg-white border border-gray-200 hover:bg-gray-50 rounded-lg flex items-center justify-center shadow-sm">
                <i class="fas fa-arrow-left text-gray-600 text-xs"></i>
            </a>
            <div class="w-9 h-9 rounded-lg flex items-center justify-center shadow-sm bg-gradient-to-br from-cyan-500 to-blue-600">
                <i class="fas fa-user-shield text-white text-sm"></i>
            </div>
            <div>
                <h1 class="text-base font-bold text-gray-900">Role Management</h1>
                <p class="text-[10px] text-gray-500">Users, permissions &amp; scope assignments</p>
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-1.5">
            <button onclick="openCreateRoleModal()"
                    class="px-2.5 py-1.5 text-white rounded-lg text-xs font-semibold flex items-center gap-1.5 shadow-sm"
                    style="background:linear-gradient(135deg,#00BCEB,#0096BE)">
                <i class="fas fa-plus-circle text-[10px]"></i> New Role
            </button>
            <a href="@Url.Action("Register", "Auth")"
               class="px-2.5 py-1.5 text-white rounded-lg text-xs font-semibold flex items-center gap-1.5 shadow-sm"
               style="background:linear-gradient(135deg,#84cc16,#65a30d)">
                <i class="fas fa-user-plus text-[10px]"></i> Register
            </a>
            <button onclick="openAssignRoleModal()"
                    class="px-2.5 py-1.5 text-white rounded-lg text-xs font-semibold flex items-center gap-1.5 shadow-sm"
                    style="background:linear-gradient(135deg,#00BCEB,#0096BE)">
                <i class="fas fa-user-tag text-[10px]"></i> Assign
            </button>
            <button onclick="openManageRolesListModal()"
                    class="px-2.5 py-1.5 text-white rounded-lg text-xs font-semibold flex items-center gap-1.5 shadow-sm"
                    style="background:linear-gradient(135deg,#64748b,#475569)">
                <i class="fas fa-tasks text-[10px]"></i> Manage Roles
            </button>
        </div>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-2 mb-4" id="roleStatsContainer">
        @for (int s = 0; s < 6; s++)
        {
            <div class="bg-white rounded-lg border border-gray-100 p-2.5 shadow-sm animate-pulse">
                <div class="h-2 bg-gray-200 rounded w-3/4 mb-2"></div>
                <div class="h-5 bg-gray-200 rounded w-1/2"></div>
            </div>
        }
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto" style="max-height:calc(100vh - 280px);overflow-y:auto">
            <table class="w-full text-xs role-tbl">
                <thead>
                    <tr class="border-b border-gray-200 text-[10px] text-gray-500 uppercase tracking-wide">
                        <th class="px-3 py-2.5 text-left font-semibold">User</th>
                        <th class="px-3 py-2.5 text-left font-semibold">Role</th>
                        <th class="px-3 py-2.5 text-left font-semibold">Companies</th>
                        <th class="px-3 py-2.5 text-left font-semibold">Groups</th>
                        <th class="px-3 py-2.5 text-left font-semibold">Locations</th>
                        <th class="px-3 py-2.5 text-left font-semibold">Devices</th>
                        <th class="px-3 py-2.5 text-right font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @foreach (var user in Model)
                    {
                        var mappings = user.Mappings ?? new List<ManageEngineWebApp.Dtos.RoleMappingDto>();
                        
                        // Group by ID to get unique entities for counts and unique lists
                        var companies = mappings.Where(m => m.CompanyId.HasValue).GroupBy(m => m.CompanyId).Select(g => g.First()).ToList();
                        var groups = mappings.Where(m => m.GroupId.HasValue).GroupBy(m => m.GroupId).Select(g => g.First()).ToList();
                        var locations = mappings.Where(m => m.LocationId.HasValue).GroupBy(m => m.LocationId).Select(g => g.First()).ToList();
                        var devices = mappings.Where(m => m.ScopeType == "Device").ToList();

                        <tr>
                            <td class="px-3 py-2">
                                <div class="flex items-center gap-2">
                                    <div class="w-6 h-6 rounded-md bg-gray-100 flex items-center justify-center text-gray-500 text-[9px] font-bold flex-shrink-0">
                                        @user.Username?.Substring(0, 1).ToUpper()
                                    </div>
                                    <span class="font-semibold text-gray-800">@user.Username</span>
                                </div>
                            </td>

                            <td class="px-3 py-2">
                                @if (user.Roles != null && user.Roles.Any())
                                {
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var r in user.Roles)
                                        {
                                            var h = Math.Abs(r.GetHashCode() % 360);
                                            <span class="px-2 py-0.5 rounded-full text-[9px] font-bold border"
                                                  style="background:hsl(@h,70%,95%);color:hsl(@h,70%,35%);border-color:hsl(@h,70%,82%)">
                                                @FormatRole(r)
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-gray-300 text-[9px] italic">No role</span>
                                }
                            </td>

                            <td class="px-3 py-2">
                                @if (companies.Any())
                                {
                                    <div class="pop-wrap">
                                        <span class="scope-badge bg-blue-50 text-blue-700 border border-blue-200">
                                            <i class="fas fa-building text-[8px]"></i>
                                            @companies.Count
                                        </span>
                                        <div class="pop-box">
                                            @{
                                                var uniqueCompanies = mappings.Where(m => m.CompanyId.HasValue)
                                                                            .GroupBy(m => new { m.CompanyId, m.CompanyName })
                                                                            .Select(g => g.First());
                                            }
                                            @foreach (var m in uniqueCompanies)
                                            {
                                                <div class="pop-item">
                                                    <span class="truncate">@(m.CompanyName ?? "N/A")</span>
                                                    @* Note: Deleting a unique company here deletes one of the mappings; 
                                                       Backend should handle cascaded removal if intended, 
                                                       or we keep it simple by removing that specific entry. *@
                                                    <button class="pop-del" title="Remove"
                                                            onclick="deleteMapping(@m.Id,'@user.Username','@m.RoleName','@(m.CompanyName ?? "")')">
                                                        <i class="fas fa-times text-[9px]"></i>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {

                                    <span class="text-gray-200 text-[9px]">—</span>
                                }
                            </td>

                            <td class="px-3 py-2">
                                @if (groups.Any())
                                {
                                    <div class="pop-wrap">
                                        <span class="scope-badge bg-orange-50 text-orange-700 border border-orange-200">
                                            <i class="fas fa-layer-group text-[8px]"></i>
                                            @groups.Count
                                        </span>
                                        <div class="pop-box">
                                            @{
                                                var uniqueGroups = mappings.Where(m => m.GroupId.HasValue)
                                                                         .GroupBy(m => new { m.GroupId, m.GroupName })
                                                                         .Select(g => g.First());
                                            }
                                            @foreach (var m in uniqueGroups)
                                            {
                                                <div class="pop-item">
                                                    <span class="truncate">@(m.GroupName ?? "N/A")</span>
                                                    <button class="pop-del" title="Remove"
                                                            onclick="deleteMapping(@m.Id,'@user.Username','@m.RoleName','@(m.GroupName ?? "")')">
                                                        <i class="fas fa-times text-[9px]"></i>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {

                                    <span class="text-gray-200 text-[9px]">—</span>
                                }
                            </td>

                            <td class="px-3 py-2">
                                @if (locations.Any())
                                {
                                    <div class="pop-wrap">
                                        <span class="scope-badge bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <i class="fas fa-map-marker-alt text-[8px]"></i>
                                            @locations.Count
                                        </span>
                                        <div class="pop-box">
                                            @{
                                                var uniqueLocs = mappings.Where(m => m.LocationId.HasValue)
                                                                       .GroupBy(m => new { m.LocationId, m.LocationName })
                                                                       .Select(g => g.First());
                                            }
                                            @foreach (var m in uniqueLocs)
                                            {
                                                <div class="pop-item">
                                                    <span class="truncate">@(m.LocationName ?? "N/A")</span>
                                                    <button class="pop-del" title="Remove"
                                                            onclick="deleteMapping(@m.Id,'@user.Username','@m.RoleName','@(m.LocationName ?? "")')">
                                                        <i class="fas fa-times text-[9px]"></i>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {

                                    <span class="text-gray-200 text-[9px]">—</span>
                                }
                            </td>

                            <td class="px-3 py-2">
                                @if (devices.Any())
                                {
                                    <div class="pop-wrap">
                                        <span class="scope-badge bg-purple-50 text-purple-700 border border-purple-200">
                                            <i class="fas fa-desktop text-[8px]"></i>
                                            @devices.Count
                                        </span>
                                        <div class="pop-box">
                                            @foreach (var m in devices)
                                            {
                                                <div class="pop-item">
                                                    <span class="truncate">@(m.ScopeName ?? "N/A")</span>
                                                    <button class="pop-del" title="Remove"
                                                            onclick="deleteMapping(@m.Id,'@user.Username','@m.RoleName','@(m.ScopeName ?? "")')">
                                                        <i class="fas fa-times text-[9px]"></i>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {

                                    <span class="text-gray-200 text-[9px]">—</span>
                                }
                            </td>

                            <td class="px-3 py-2 text-right whitespace-nowrap">
                                @if (user.Roles == null || !user.Roles.Contains("SuperAdmin"))
                                {
                                    <button onclick="editRole('@user.Username','@(user.Roles?.FirstOrDefault() ?? "")',@(user.CompanyId?.ToString() ?? "null"),'@(user.Mappings?.FirstOrDefault(m => !string.IsNullOrEmpty(m.ScopeName))?.ScopeName ?? "")')"
                                            class="px-2 py-1 text-white rounded text-[9px] font-bold mr-1 transition-all"
                                            style="background:linear-gradient(135deg,#00BCEB,#0096BE)">
                                        <i class="fas fa-edit text-[8px] mr-0.5"></i>Edit
                                    </button>
                                    <button onclick="removeUserRole('@user.Username','@(user.Roles?.FirstOrDefault() ?? "")')"
                                            class="px-2 py-1 bg-red-500 hover:bg-red-600 text-white rounded text-[9px] font-bold transition-all">
                                        <i class="fas fa-trash text-[8px] mr-0.5"></i>Del
                                    </button>
                                }
                                else
                                {
                                    <span class="text-gray-400 text-[9px] italic flex items-center justify-end gap-1">
                                        <i class="fas fa-lock text-[8px]"></i>Protected
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<div id="assignRoleModal" class="rm-overlay">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md mx-3 flex flex-col max-h-[90vh]">
        <div class="px-4 py-3 rounded-t-2xl flex items-center justify-between bg-gradient-to-r from-cyan-500 to-blue-600 flex-shrink-0">
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
                <i class="fas fa-user-tag"></i> Assign Role to User
            </h3>
            <button onclick="closeAssignRoleModal()" class="text-white/80 hover:text-white">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div class="p-4 overflow-y-auto flex-1">
            <div class="mb-3">
                <label class="block text-[10px] font-bold text-gray-600 mb-1 uppercase tracking-wide">Username *</label>
                <input type="text" id="assignUsername"
                       class="w-full px-3 py-2 text-xs border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-400"
                       placeholder="Enter username" required>
            </div>

            <div class="mb-3">
                <label class="block text-[10px] font-bold text-gray-600 mb-1 uppercase tracking-wide">Role *</label>
                <select id="assignRole"
                        class="w-full px-3 py-2 text-xs border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-400">
                    <option value="">Loading roles...</option>
                </select>
            </div>

            <div id="companySelectDiv" class="mb-3 hidden">
                <label class="block text-[10px] font-bold text-gray-600 mb-1 uppercase tracking-wide">
                    Companies
                    <span class="ml-1 text-cyan-600 font-normal normal-case">(select multiple)</span>
                </label>
                <div class="relative mb-1">
                    <i class="fas fa-search absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400 text-[9px]"></i>
                    <input type="text" id="companySearch" placeholder="Filter companies..."
                           class="w-full pl-7 pr-2 py-1.5 text-[10px] border border-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-cyan-400"
                           oninput="filterList('companyList', this.value)">
                </div>
                <div id="companyList" class="mc-list">
                    <div class="mc-item text-gray-400"><i class="fas fa-spinner fa-spin mr-1"></i>Loading...</div>
                </div>
                <p class="text-[9px] text-gray-400 mt-1">
                    <i class="fas fa-info-circle mr-0.5"></i>
                    Greyed items are already assigned. Checked = will be added.
                </p>
            </div>

            <div id="groupSelectDiv" class="mb-3 hidden">
                <label class="block text-[10px] font-bold text-gray-600 mb-1 uppercase tracking-wide">
                    Groups <span class="ml-1 text-cyan-600 font-normal normal-case">(select multiple)</span>
                </label>
                <div class="relative mb-1">
                    <i class="fas fa-search absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400 text-[9px]"></i>
                    <input type="text" placeholder="Filter groups..."
                           class="w-full pl-7 pr-2 py-1.5 text-[10px] border border-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-cyan-400"
                           oninput="filterList('groupList', this.value)">
                </div>
                <div id="groupList" class="mc-list">
                    <div class="mc-item text-gray-400">Select a company first</div>
                </div>
            </div>

            <div id="locationSelectDiv" class="mb-3 hidden">
                <label class="block text-[10px] font-bold text-gray-600 mb-1 uppercase tracking-wide">
                    Locations <span class="ml-1 text-cyan-600 font-normal normal-case">(select multiple)</span>
                </label>
                <div class="relative mb-1">
                    <i class="fas fa-search absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400 text-[9px]"></i>
                    <input type="text" placeholder="Filter locations..."
                           class="w-full pl-7 pr-2 py-1.5 text-[10px] border border-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-cyan-400"
                           oninput="filterList('locationList', this.value)">
                </div>
                <div id="locationList" class="mc-list">
                    <div class="mc-item text-gray-400">Select a group first</div>
                </div>
            </div>

            <div id="domainSelectDiv" class="mb-3 hidden">
                <label class="block text-[10px] font-bold text-gray-600 mb-1 uppercase tracking-wide">Device *</label>
                <select id="assignDomain"
                        class="w-full px-3 py-2 text-xs border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-400">
                    <option value="">Select location first</option>
                </select>
            </div>

            <div id="assignMessage" class="hidden p-2 rounded-lg text-xs font-medium mt-2"></div>
        </div>

        <div class="px-4 py-3 border-t flex justify-end gap-2 flex-shrink-0">
            <button onclick="closeAssignRoleModal()"
                    class="px-3 py-1.5 text-xs bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 font-semibold">
                Cancel
            </button>
            <button onclick="submitAssignRole()" id="assignRoleBtn"
                    class="px-4 py-1.5 text-xs text-white rounded-lg font-semibold shadow-sm"
                    style="background:linear-gradient(135deg,#00BCEB,#0096BE)">
                <i class="fas fa-check mr-1"></i>Assign Role
            </button>
        </div>
    </div>
</div>


<div id="createRoleModal" class="rm-overlay">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-xl mx-3 flex flex-col max-h-[90vh]">
        <div class="px-4 py-3 rounded-t-2xl flex items-center justify-between bg-gradient-to-r from-cyan-500 to-blue-600 flex-shrink-0">
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
                <i class="fas fa-plus-circle"></i> Create / Edit Role
            </h3>
            <button onclick="closeCreateRoleModal()" class="text-white/80 hover:text-white">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="p-4 overflow-y-auto flex-1">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Left -->
                <div>
                    <div class="mb-3">
                        <label class="block text-[10px] font-bold text-gray-600 mb-1 uppercase tracking-wide">Role Name *</label>
                        <input type="text" id="newRoleName"
                               class="w-full px-3 py-2 text-xs border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-400"
                               placeholder="e.g. LocationEngineer"
                               oninput="this.value=this.value.replace(/[\s]/g,'');validateRoleName(this);"
                               autocomplete="off" spellcheck="false">
                        <p id="roleNameHint" class="text-[9px] text-gray-400 mt-0.5">No spaces. Use CamelCase (e.g. SiteEngineer).</p>
                    </div>
                    <div class="mb-3">
                        <label class="block text-[10px] font-bold text-gray-600 mb-1 uppercase tracking-wide">Description</label>
                        <textarea id="newRoleDescription" rows="2"
                                  class="w-full px-3 py-2 text-xs border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-400"
                                  placeholder="Brief description..."></textarea>
                    </div>
                    <div class="bg-gray-50 rounded-lg border border-gray-200 p-3">
                        <p class="text-[10px] font-bold text-gray-600 mb-2 uppercase tracking-wide">Hierarchy Requirements</p>
                        <div class="space-y-1.5">
                            <label class="flex items-center text-xs text-gray-700 cursor-pointer gap-2">
                                <input type="checkbox" id="roleRequiresCompany" class="rounded accent-cyan-500">
                                Requires Company
                            </label>
                            <label class="flex items-center text-xs text-gray-700 cursor-pointer gap-2">
                                <input type="checkbox" id="roleRequiresGroup" class="rounded accent-cyan-500">
                                Requires Group
                            </label>
                            <label class="flex items-center text-xs text-gray-700 cursor-pointer gap-2">
                                <input type="checkbox" id="roleRequiresLocation" class="rounded accent-cyan-500">
                                Requires Location
                            </label>
                            <label class="flex items-center text-xs text-gray-700 cursor-pointer gap-2">
                                <input type="checkbox" id="roleRequiresDevice" class="rounded accent-cyan-500">
                                Requires Device
                            </label>
                        </div>
                    </div>
                </div>
                <!-- Right -->
                <div>
                    <div class="flex border-b mb-3">
                        <button onclick="switchRoleTab('perms')" id="tabBtn_perms"
                                class="role-tab-btn px-3 py-1.5 text-xs font-bold border-b-2 border-cyan-500 text-cyan-600">
                            Permissions
                        </button>
                        <button onclick="switchRoleTab('menus')" id="tabBtn_menus"
                                class="role-tab-btn px-3 py-1.5 text-xs font-bold border-b-2 border-transparent text-gray-400 hover:text-cyan-600">
                            Menus
                        </button>
                    </div>
                    <div id="tabContent_perms">
                        <div class="flex justify-between items-center mb-1.5">
                            <span class="text-[10px] font-bold text-gray-600 uppercase">Permissions *</span>
                            <div class="flex gap-2">
                                <button onclick="selectAllPermissions()" class="text-[9px] text-cyan-600 hover:underline">All</button>
                                <button onclick="clearAllPermissions()" class="text-[9px] text-gray-400 hover:underline">Clear</button>
                            </div>
                        </div>
                        <div id="permissionTree" class="border rounded-lg p-2 max-h-44 overflow-y-auto bg-gray-50 text-xs">
                            <p class="text-gray-400 text-center py-4">Loading...</p>
                        </div>
                    </div>
                    <div id="tabContent_menus" class="hidden">
                        <div class="flex justify-between items-center mb-1.5">
                            <span class="text-[10px] font-bold text-gray-600 uppercase">Menus *</span>
                            <div class="flex gap-2">
                                <button onclick="selectAllMenus()" class="text-[9px] text-cyan-600 hover:underline">All</button>
                                <button onclick="clearAllMenus()" class="text-[9px] text-gray-400 hover:underline">Clear</button>
                            </div>
                        </div>
                        <div id="menuTree" class="border rounded-lg p-2 max-h-44 overflow-y-auto bg-gray-50 text-xs">
                            <p class="text-gray-400 text-center py-4">Loading...</p>
                        </div>
                    </div>
                </div>
            </div>
            <div id="createRoleMessage" class="mt-3 p-2 rounded-lg text-xs font-medium hidden"></div>
        </div>
        <div class="px-4 py-3 border-t flex justify-end gap-2 flex-shrink-0">
            <button onclick="closeCreateRoleModal()"
                    class="px-3 py-1.5 text-xs bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 font-semibold">
                Cancel
            </button>
            <button onclick="submitCreateRole()" id="createRoleBtn"
                    class="px-4 py-1.5 text-xs text-white rounded-lg font-semibold shadow-sm"
                    style="background:linear-gradient(135deg,#00BCEB,#0096BE)">
                <i class="fas fa-save mr-1"></i><span id="createRoleBtnText">Create Role</span>
            </button>
        </div>
    </div>
</div>


<div id="manageRolesListModal" class="rm-overlay">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md mx-3 flex flex-col max-h-[80vh]">
        <div class="px-4 py-3 rounded-t-2xl flex items-center justify-between bg-gradient-to-r from-amber-500 to-orange-600 flex-shrink-0">
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
                <i class="fas fa-list"></i> System Roles
            </h3>
            <button onclick="closeManageRolesListModal()" class="text-white/80 hover:text-white">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="p-3 overflow-y-auto flex-1">
            <div id="rolesListContainer" class="space-y-1.5">
                <p class="text-gray-400 text-xs text-center py-4">Loading roles...</p>
            </div>
        </div>
        <div class="px-4 py-3 border-t flex justify-end flex-shrink-0">
            <button onclick="closeManageRolesListModal()"
                    class="px-3 py-1.5 text-xs bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 font-semibold">
                Close
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var systemRoles = [];
        var roleConfigs = {};
        var allUsers = @Html.Raw(Json.Serialize(Model));

        var existingAssignments = {};
        (allUsers || []).forEach(function(u) {
            var maps = u.Mappings || u.mappings || [];
            existingAssignments[u.Username || u.username] = {
                companyIds:  maps.filter(function(m){ return m.CompanyId  != null || m.companyId  != null; }).map(function(m){ return parseInt(m.CompanyId  || m.companyId); }),
                groupIds:    maps.filter(function(m){ return m.GroupId    != null || m.groupId    != null; }).map(function(m){ return parseInt(m.GroupId    || m.groupId);   }),
                locationIds: maps.filter(function(m){ return m.LocationId != null || m.locationId != null; }).map(function(m){ return parseInt(m.LocationId || m.locationId);}),
                devices:     maps.filter(function(m){ return (m.ScopeType||m.scopeType) === 'Device'; }).map(function(m){ return m.ScopeName || m.scopeName || ''; })
            };
        });

        function openModal(id)  { document.getElementById(id).classList.add('open'); }
        function closeModal(id) { document.getElementById(id).classList.remove('open'); }

        function formatRoleName(n) {
            return (n || '').replace(/([A-Z])/g, ' $1').trim();
        }

        function filterList(listId, term) {
            const t = term.toLowerCase();
            document.querySelectorAll('#' + listId + ' .mc-item').forEach(el => {
                el.style.display = (!t || el.textContent.toLowerCase().includes(t)) ? '' : 'none';
            });
        }

        function renderStats() {
            const c = $('#roleStatsContainer').empty();
            addStat(c, 'Total Users', allUsers.length, '#10b981', 'fa-users');
            
            const sa = allUsers.filter(u => {
                const rs = u.roles || u.Roles || [];
                return rs.some(r => r.toLowerCase() === 'superadmin');
            }).length;
            addStat(c, 'Super Admin', sa, '#ef4444', 'fa-crown');
            
            systemRoles.forEach(r => {
                const n = typeof r === 'string' ? r : (r.name || r.RoleName);
                if (!n || n.toLowerCase() === 'superadmin') return;
                
                const count = allUsers.filter(u => {
                    const rs = u.roles || u.Roles || [];
                    return rs.some(role => role.toLowerCase() === n.toLowerCase());
                }).length;
                
                addStat(c, n, count, '#00BCEB', 'fa-tag');
            });
            
            const noRoleCount = allUsers.filter(u => !(u.roles || u.Roles || []).length).length;
            addStat(c, 'No Role', noRoleCount, '#9ca3af', 'fa-user-slash');
        }

        function addStat(c, title, val, color, icon) {
            c.append(`<div class="bg-white rounded-lg border border-gray-100 p-2.5 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-[9px] font-bold text-gray-400 uppercase tracking-wider">${formatRoleName(title)}</p>
                        <p class="text-xl font-black text-gray-800 mt-0.5">${val}</p>
                    </div>
                    <div class="w-8 h-8 rounded-lg flex items-center justify-center shadow-sm flex-shrink-0"
                         style="background:linear-gradient(135deg,${color},${color}cc)">
                        <i class="fas ${icon} text-white text-[11px]"></i>
                    </div>
                </div>
            </div>`);
        }

        function loadSystemRoles() {
            $.get('@Url.Action("GetAllSystemRoles", "Auth")', function(roles) {
                systemRoles = roles || [];
                roleConfigs = { 'SuperAdmin': { requiresCompany:false,requiresGroup:false,requiresDevice:false,requiresLocation:false,isSystem:true } };
                systemRoles.forEach(r => {
                    const n = typeof r === 'string' ? r : (r.name||r.RoleName);
                    roleConfigs[n] = { requiresCompany:r.requiresCompany||false, requiresGroup:r.requiresGroup||false, requiresDevice:r.requiresDevice||false, requiresLocation:r.requiresLocation||false, isSystem:r.isSystem||false };
                });
                updateRoleDropdown();
                renderStats();
            }).fail(() => renderStats());
        }

        function updateRoleDropdown() {
            const opts = ['<option value="">-- Select Role --</option>']
                .concat(systemRoles.filter(r => { const n=typeof r==='string'?r:(r.name||r.RoleName); return n!=='SuperAdmin'; })
                    .map(r => { const n=typeof r==='string'?r:(r.name||r.RoleName); return `<option value="${n}">${formatRoleName(n)}</option>`; }))
                .join('');
            $('#assignRole').html(opts || '<option value="">No roles yet</option>');
        }

        function openAssignRoleModal() {
            openModal('assignRoleModal');
            loadSystemRoles();
            loadCompaniesForModal();
            $('#assignMessage').addClass('hidden');
            $('#companySelectDiv,#groupSelectDiv,#locationSelectDiv,#domainSelectDiv').addClass('hidden');
        }
        function closeAssignRoleModal() {
            closeModal('assignRoleModal');
            $('#assignUsername').val('');
            $('#assignRole').val('');
        }

        $('#assignRole').on('change', function() {
            const cfg = roleConfigs[$(this).val()] || {};
            if (cfg.requiresCompany || cfg.requiresGroup || cfg.requiresDevice || cfg.requiresLocation)
                $('#companySelectDiv').removeClass('hidden');
            else
                $('#companySelectDiv').addClass('hidden');
            $('#groupSelectDiv,#locationSelectDiv,#domainSelectDiv').addClass('hidden');
        });

        function buildCheckboxList(containerId, items, valueKey, labelKey, alreadyIds) {
            const already = new Set((alreadyIds || []).map(x => String(parseInt(x))));
            if (!items || !items.length) {
                $('#' + containerId).html('<div class="mc-item text-gray-400">None found</div>');
                return;
            }
            const html = items.map(item => {
                const val   = item[valueKey] || item[valueKey.toLowerCase()];
                const label = item[labelKey] || item[labelKey.toLowerCase()];
                const isDup = already.has(String(parseInt(val)));
                return `<label class="mc-item ${isDup ? 'mc-disabled' : ''}">
                    <input type="checkbox" value="${val}" ${isDup ? 'disabled checked' : ''}>
                    <span class="flex-1 truncate">${label}</span>
                    ${isDup ? '<span class="already-tag">assigned</span>' : ''}
                </label>`;
            }).join('');
            $('#' + containerId).html(html);
        }

        function loadCompaniesForModal() {
            const username = $('#assignUsername').val().trim();
            const existing = (existingAssignments[username] || {}).companyIds || [];
            $('#companyList').html('<div class="mc-item text-gray-400"><i class="fas fa-spinner fa-spin mr-1"></i>Loading...</div>');
            $.get('/Companies/GetCompaniesForDropdown', function(data) {
                buildCheckboxList('companyList', data, 'id', 'companyName', existing);
            });
        }

        var usernameDebounce;
        $('#assignUsername').on('input', function() {
            clearTimeout(usernameDebounce);
            usernameDebounce = setTimeout(function() {
                const role = $('#assignRole').val();
                const cfg  = roleConfigs[role] || {};
                if (role && (cfg.requiresCompany || cfg.requiresGroup || cfg.requiresDevice || cfg.requiresLocation)) {
                    loadCompaniesForModal();
                    $('#groupSelectDiv,#locationSelectDiv,#domainSelectDiv').addClass('hidden');
                    $('#groupList').html('<div class="mc-item text-gray-400">Select a company first</div>');
                    $('#locationList').html('<div class="mc-item text-gray-400">Select a group first</div>');
                }
            }, 400);
        });
        $('#assignUsername').on('change blur', function() {
            if ($('#assignRole').val() && (roleConfigs[$('#assignRole').val()]?.requiresCompany))
                loadCompaniesForModal();
        });

        $('#companyList').on('change', 'input[type=checkbox]', function() {
            const checkedIds = $('#companyList input:checked:not(:disabled)').map((i,el) => $(el).val()).get();
            if (!checkedIds.length) { $('#groupSelectDiv').addClass('hidden'); return; }
            const role = $('#assignRole').val();
            const cfg  = roleConfigs[role] || {};
            if (!cfg.requiresGroup && !cfg.requiresDevice && !cfg.requiresLocation) return;
            $('#groupSelectDiv').removeClass('hidden');
            const username = $('#assignUsername').val().trim();
            const existingGroups = (existingAssignments[username] || {}).groupIds || [];
            $('#groupList').html('<div class="mc-item text-gray-400"><i class="fas fa-spinner fa-spin mr-1"></i>Loading...</div>');
            
            const promises = checkedIds.map(cid => $.get('/Companies/GetGroupsByCompany?companyId=' + cid));
            Promise.all(promises.map(p => new Promise(res => { p.then(res).fail(() => res([])); })))
                .then(results => {
                    const seen = new Set();
                    const allGroups = [];
                    results.forEach(arr => (arr||[]).forEach(g => {
                        const id = g.id || g.Id;
                        if (!seen.has(id)) { seen.add(id); allGroups.push(g); }
                    }));
                    buildCheckboxList('groupList', allGroups, 'id', 'groupName', existingGroups);
                });
        });

        $('#groupList').on('change', 'input[type=checkbox]', function() {
            const checkedGroupIds = $('#groupList input:checked:not(:disabled)').map((i,el)=>$(el).val()).get();
            if (!checkedGroupIds.length) { $('#locationSelectDiv').addClass('hidden'); return; }
            const role = $('#assignRole').val();
            const cfg  = roleConfigs[role] || {};
            if (!cfg.requiresLocation && !cfg.requiresDevice) return;
            $('#locationSelectDiv').removeClass('hidden');
            const cids = $('#companyList input:checked:not(:disabled)').map((i,el)=>$(el).val()).get();
            const username = $('#assignUsername').val().trim();
            const existingLocs = (existingAssignments[username] || {}).locationIds || [];
            $('#locationList').html('<div class="mc-item text-gray-400"><i class="fas fa-spinner fa-spin mr-1"></i>Loading...</div>');
            
            const promises = [];
            cids.forEach(cid => {
                checkedGroupIds.forEach(gid => {
                    promises.push($.get('/Companies/GetLocationsByGroup?companyId=' + cid + '&groupId=' + gid));
                });
            });

            Promise.all(promises.map(p => new Promise((res) => { p.then(res).fail(() => res([])); })))
                .then(results => {
                    const seen = new Set();
                    const allLocs = [];
                    results.forEach(arr => (arr||[]).forEach(loc => {
                        const id = loc.id || loc.Id;
                        if (!seen.has(id)) { seen.add(id); allLocs.push(loc); }
                    }));
                    buildCheckboxList('locationList', allLocs, 'id', 'locationName', existingLocs);
                });
        });

        $('#locationList').on('change', 'input[type=checkbox]', function() {
            const checkedLocIds = $('#locationList input:checked:not(:disabled)').map((i,el)=>$(el).val()).get();
            if (!checkedLocIds.length) { $('#domainSelectDiv').addClass('hidden'); return; }
            const cfg = roleConfigs[$('#assignRole').val()] || {};
            if (!cfg.requiresDevice) return;
            $('#domainSelectDiv').removeClass('hidden');
            const cid = $('#companyList input:checked:not(:disabled)').first().val();
            const gid = $('#groupList input:checked:not(:disabled)').first().val();
            const lid = checkedLocIds[0];
            $('#assignDomain').html('<option value="">Loading devices...</option>');
            $.get('/ComputerSummary/GetDevicesByLocation?companyId='+cid+'&groupId='+gid+'&locationId='+lid, function(data) {
                const opts = '<option value="">-- Select Device --</option>' +
                    (data||[]).map(d => `<option value="${d.domainName}">${d.domainName} (${d.userName||'N/A'})</option>`).join('');
                $('#assignDomain').html(opts);
            });
        });

        async function submitAssignRole() {
            const username = $('#assignUsername').val().trim();
            const role     = $('#assignRole').val();
            const msgEl    = $('#assignMessage');
            const btn      = $('#assignRoleBtn');

            if (!username) { showMsg(msgEl,'Please enter a username','error'); return; }
            if (!role)     { showMsg(msgEl,'Please select a role','error'); return; }

            const cfg = roleConfigs[role] || {};
            const companyIds  = $('#companyList  input:checked:not(:disabled)').map((i,el)=>parseInt($(el).val())).get();
            const groupIds    = $('#groupList    input:checked:not(:disabled)').map((i,el)=>parseInt($(el).val())).get();
            const locationIds = $('#locationList input:checked:not(:disabled)').map((i,el)=>parseInt($(el).val())).get();
            const domainName  = $('#assignDomain').val();

            if (cfg.requiresCompany && !companyIds.length)  { showMsg(msgEl,'Select at least one company','error'); return; }
            if (cfg.requiresDevice  && !domainName)          { showMsg(msgEl,'Select a device','error'); return; }

            // Front-end duplicate guard: check if user already has THIS role for THESE specific selections
            const userMappings = (allUsers.find(u => u.username === username) || {}).mappings || [];
            const roleLower = role.toLowerCase();
            
            const payloads = [];
            if (companyIds.length) {
                companyIds.forEach(cid => {
                    if (groupIds.length) {
                        groupIds.forEach(gid => {
                            if (locationIds.length) {
                                locationIds.forEach(lid => {
                                    payloads.push({ Username:username, Role:role, CompanyId:cid, GroupId:gid, LocationId:lid, DomainName:domainName||null });
                                });
                            } else {
                                payloads.push({ Username:username, Role:role, CompanyId:cid, GroupId:gid, LocationId:null, DomainName:domainName||null });
                            }
                        });
                    } else {
                        payloads.push({ Username:username, Role:role, CompanyId:cid, GroupId:null, LocationId:null, DomainName:domainName||null });
                    }
                });
            } else {
                payloads.push({ Username:username, Role:role, CompanyId:null, GroupId:null, LocationId:null, DomainName:domainName||null });
            }

            // Precisely filter out payloads that already exist in userMappings
            const finalPayloads = payloads.filter(p => !userMappings.some(m => 
                m.roleName.toLowerCase() === roleLower &&
                (m.companyId || m.CompanyId) === p.CompanyId &&
                (m.groupId || m.GroupId) === p.GroupId &&
                (m.locationId || m.LocationId) === p.LocationId
            ));

            if (payloads.length > 0 && finalPayloads.length === 0) {
                showMsg(msgEl, 'Selected mapping(s) are already assigned to this user.', 'error');
                btn.prop('disabled', false).html('<i class="fas fa-check mr-1"></i>Assign Role');
                return;
            }

            btn.prop('disabled',true).html('<i class="fas fa-spinner fa-spin mr-1"></i>Assigning...');

            let successCount = 0, failMessages = [];
            for (const payload of finalPayloads) {
                try {
                    const res = await $.ajax({ url:'@Url.Action("AssignRole", "Auth")', type:'POST', contentType:'application/json', data:JSON.stringify(payload) });
                    if (res.success) successCount++;
                    else failMessages.push(res.message);
                } catch(e) { failMessages.push('Network error'); }
            }

            btn.prop('disabled',false).html('<i class="fas fa-check mr-1"></i>Assign Role');

            if (successCount > 0) {
                showMsg(msgEl, `${successCount} assignment(s) added successfully!`, 'success');
                setTimeout(() => location.reload(), 1000);
            } else {
                showMsg(msgEl, failMessages.join('; ') || 'Assignment failed', 'error');
            }
        }

        function deleteMapping(id, username, roleName, scopeName) {
            sysConfirm(`Remove "${roleName}" in "${scopeName}" for user "${username}"?`, function() {
                $.post('@Url.Action("RemoveMapping", "Auth")/' + id, function(res) {
                    if (res.success) { sysAlert('Assignment removed','success'); setTimeout(()=>location.reload(),600); }
                    else sysAlert(res.message,'error');
                }).fail(() => sysAlert('Error removing assignment','error'));
            }, { type:'danger' });
        }

        function removeUserRole(username, roleName) {
            sysConfirm(`Remove role "${roleName}" from "${username}"?`, function() {
                $.ajax({ url:'@Url.Action("RemoveRole", "Auth")', type:'POST', contentType:'application/json',
                    data: JSON.stringify({ Username:username }),
                    success: res => { if(res.success){sysAlert('Role removed','success');setTimeout(()=>location.reload(),600);}else sysAlert(res.message,'error'); },
                    error: () => sysAlert('Error removing role','error')
                });
            }, { type:'danger' });
        }

        function editRole(username, currentRole, companyId, domainName) {
            openAssignRoleModal();
            setTimeout(() => {
                $('#assignUsername').val(username);
                $('#assignRole').val(currentRole).trigger('change');
            }, 300);
        }

        function validateRoleName(input) {
            const val = input.value;
            const hint = document.getElementById('roleNameHint');
            if (!val) { hint.className = 'text-[9px] text-gray-400 mt-0.5'; hint.textContent = 'No spaces. Use CamelCase (e.g. SiteEngineer).'; return; }
            if (/[^a-zA-Z0-9_]/.test(val)) {
                hint.className = 'text-[9px] text-red-500 mt-0.5';
                hint.textContent = '⚠ Only letters, numbers and underscores allowed.';
                input.classList.add('border-red-400');
            } else if (val.length < 3) {
                hint.className = 'text-[9px] text-amber-500 mt-0.5';
                hint.textContent = 'Role name must be at least 3 characters.';
                input.classList.remove('border-red-400');
            } else {
                // Check for duplicate role name against existing roles
                const exists = systemRoles.some(r => {
                    const n = typeof r === 'string' ? r : (r.name || r.RoleName || '');
                    return n.toLowerCase() === val.toLowerCase();
                });
                if (exists && !isEditMode) {
                    hint.className = 'text-[9px] text-red-500 mt-0.5';
                    hint.textContent = '⚠ A role with this name already exists.';
                    input.classList.add('border-red-400');
                } else {
                    hint.className = 'text-[9px] text-green-600 mt-0.5';
                    hint.textContent = '✓ Valid role name.';
                    input.classList.remove('border-red-400');
                }
            }
        }


        var isEditMode = false, currentEditingRole = '', permissionsData = [], menusData = [], currentRoleData = null;

        function switchRoleTab(tab) {
            $('.role-tab-btn').removeClass('border-cyan-500 text-cyan-600').addClass('border-transparent text-gray-400');
            $('#tabBtn_'+tab).addClass('border-cyan-500 text-cyan-600').removeClass('border-transparent text-gray-400');
            $('#tabContent_perms,#tabContent_menus').addClass('hidden');
            $('#tabContent_'+tab).removeClass('hidden');
        }

        function openCreateRoleModal() {
            isEditMode = false; currentEditingRole = '';
            $('#createRoleBtnText').text('Create Role');
            $('#newRoleName').val('').prop('readonly',false);
            $('#newRoleDescription').val('');
            $('#roleRequiresCompany,#roleRequiresGroup,#roleRequiresDevice,#roleRequiresLocation').prop('checked',false);
            openModal('createRoleModal');
            $('#createRoleMessage').addClass('hidden');
            switchRoleTab('perms');
            loadCreatePermissions(); loadCreateMenus();
        }
        function closeCreateRoleModal() { closeModal('createRoleModal'); }

        function loadCreatePermissions() {
            $('#permissionTree').html('<p class="text-gray-400 text-center py-4 text-xs">Loading...</p>');
            $.get('@Url.Action("GetGroupedPermissions", "Auth")', function(data) {
                permissionsData = data; renderPermissionTree(data);
                if (isEditMode) syncRolePermissions();
            }).fail(() => $('#permissionTree').html('<p class="text-red-500 text-center py-4 text-xs">Failed to load</p>'));
        }
        function loadCreateMenus() {
            $('#menuTree').html('<p class="text-gray-400 text-center py-4 text-xs">Loading...</p>');
            $.get('@Url.Action("GetMenusGroupedByModule", "Auth")', function(data) {
                menusData = data; renderMenuTree(data);
                if (isEditMode) syncRoleMenus();
            }).fail(() => $('#menuTree').html('<p class="text-red-500 text-center py-4 text-xs">Failed to load</p>'));
        }

        function renderPermissionTree(modules) {
            if (!modules?.length) { $('#permissionTree').html('<p class="text-gray-400 text-center py-4 text-xs">No permissions</p>'); return; }
            $('#permissionTree').html(modules.map(m => {
                const mid = m.moduleName.replace(/\s+/g,'');
                return `<div class="mb-2">
                    <label class="flex items-center gap-1.5 mb-1 cursor-pointer">
                        <input type="checkbox" id="mod_${mid}" class="rounded accent-cyan-500" onchange="toggleModulePerms('${mid}')">
                        <span class="text-[10px] font-semibold text-gray-700"><i class="${m.moduleIcon||'fas fa-folder'} mr-1 text-gray-400"></i>${m.moduleName}</span>
                    </label>
                    <div class="ml-5 space-y-0.5" id="perms_${mid}">
                        ${(m.permissions||[]).map(p => `<label class="flex items-center gap-1.5 text-[10px] text-gray-600 hover:bg-gray-100 px-1 py-0.5 rounded cursor-pointer">
                            <input type="checkbox" class="perm-checkbox rounded accent-cyan-500" name="permissions" value="${p.permissionCode}" data-module="${mid}">
                            <span class="flex-1">${p.permissionName}</span>
                            <span class="text-[9px] ${p.actionType==='View'?'text-green-600':'text-amber-600'}">${p.actionType}</span>
                        </label>`).join('')}
                    </div>
                </div>`;
            }).join(''));
        }

        function toggleModulePerms(mid) { const v=$('#mod_'+mid).is(':checked'); $('#perms_'+mid+' input').prop('checked',v); }
        function selectAllPermissions() { $('#permissionTree input').prop('checked',true); }
        function clearAllPermissions()  { $('#permissionTree input').prop('checked',false); }

        function renderMenuTree(modules) {
            if (!modules?.length) { $('#menuTree').html('<p class="text-gray-400 text-center py-4 text-xs">No menus</p>'); return; }
            $('#menuTree').html(modules.map(m => {
                const mid = (m.moduleName||'').replace(/\s+/g,'')+'_m';
                return `<div class="mb-2">
                    <label class="flex items-center gap-1.5 mb-1 cursor-pointer">
                        <input type="checkbox" id="mod_menu_${mid}" class="rounded accent-cyan-500" onchange="toggleModuleMenus('${mid}')">
                        <span class="text-[10px] font-semibold text-gray-700">${m.moduleName||'Unknown'}</span>
                    </label>
                    <div class="ml-5 space-y-0.5" id="menu_container_${mid}">
                        ${(m.menus||m.Menus||[]).map(mn => `<label class="flex items-center gap-1.5 text-[10px] text-gray-600 hover:bg-gray-100 px-1 py-0.5 rounded cursor-pointer">
                            <input type="checkbox" class="menu-checkbox rounded accent-cyan-500" name="menuIds" value="${mn.id||mn.Id}" data-module="${mid}">
                            <span>${mn.menuName||mn.MenuName}</span>
                        </label>`).join('')}
                    </div>
                </div>`;
            }).join(''));
        }
        function toggleModuleMenus(mid) { const v=$('#mod_menu_'+mid).is(':checked'); $('#menu_container_'+mid+' input').prop('checked',v); }
        function selectAllMenus() { $('#menuTree input').prop('checked',true); }
        function clearAllMenus()  { $('#menuTree input').prop('checked',false); }

        function syncRolePermissions() {
            if (!currentRoleData?.permissions) return;
            $('input[name="permissions"]').prop('checked',false);
            currentRoleData.permissions.forEach(c => $(`input[name="permissions"][value="${c}"]`).prop('checked',true));
        }
        function syncRoleMenus() {
            if (!currentRoleData?.menus) return;
            $('input[name="menuIds"]').prop('checked',false);
            currentRoleData.menus.forEach(id => $(`input[name="menuIds"][value="${id}"]`).prop('checked',true));
        }

        function editSystemRole(roleName) {
            closeManageRolesListModal();
            isEditMode = true; currentEditingRole = roleName;
            $('#createRoleBtnText').text('Save Changes');
            $('#newRoleName').val(roleName).prop('readonly',true);
            openModal('createRoleModal');
            $('#createRoleMessage').addClass('hidden');
            $.get('@Url.Action("GetRoleDetails", "Auth")?roleName=' + roleName, function(data) {
                currentRoleData = data;
                $('#newRoleDescription').val(data.description);
                $('#roleRequiresCompany').prop('checked',data.requiresCompany);
                $('#roleRequiresGroup').prop('checked',data.requiresGroup);
                $('#roleRequiresDevice').prop('checked',data.requiresDevice);
                $('#roleRequiresLocation').prop('checked',data.requiresLocation);
                loadCreatePermissions(); loadCreateMenus();
            });
        }

        function submitCreateRole() {
            const roleName = $('#newRoleName').val().trim();
            const perms = $('input[name="permissions"]:checked').map((i,el) => $(el).val()).get();
            const menus = $('input[name="menuIds"]:checked').map((i,el) => parseInt($(el).val())).get();
            const msgEl = $('#createRoleMessage');
            if (!roleName) { showMsg(msgEl,'Enter a role name','error'); return; }
            if (/[\s]/.test(roleName)) { showMsg(msgEl,'No spaces — use CamelCase (e.g. SiteEngineer)','error'); return; }
            if (/[^a-zA-Z0-9_]/.test(roleName)) { showMsg(msgEl,'Only letters, numbers and underscores allowed','error'); return; }
            if (roleName.length < 3) { showMsg(msgEl,'Role name must be at least 3 characters','error'); return; }
            // Duplicate check (only for create, not edit)
            if (!isEditMode) {
                const dupExists = systemRoles.some(r => {
                    const n = typeof r === 'string' ? r : (r.name || r.RoleName || '');
                    return n.toLowerCase() === roleName.toLowerCase();
                });
                if (dupExists) { showMsg(msgEl,'A role with this name already exists — choose a different name','error'); return; }
            }
            if (!perms.length) { showMsg(msgEl,'Select at least one permission','error'); return; }

            const btn = $('#createRoleBtn').prop('disabled',true).html('<i class="fas fa-spinner fa-spin mr-1"></i>Saving...');
            const url = isEditMode ? '@Url.Action("UpdateRoleWithPermissions", "Auth")' : '@Url.Action("CreateRoleWithPermissions", "Auth")';
            $.ajax({ url, type:'POST', contentType:'application/json',
                data: JSON.stringify({
                    RoleName: roleName,
                    Description: $('#newRoleDescription').val(),
                    RequiresCompany:  $('#roleRequiresCompany').is(':checked'),
                    RequiresGroup:    $('#roleRequiresGroup').is(':checked'),
                    RequiresDevice:   $('#roleRequiresDevice').is(':checked'),
                    RequiresLocation: $('#roleRequiresLocation').is(':checked'),
                    Permissions: perms, MenuIds: menus
                }),
                success: res => {
                    if (res.success) {
                        showMsg(msgEl, isEditMode ? 'Role updated!' : 'Role created!','success');
                        setTimeout(() => { closeCreateRoleModal(); loadSystemRoles(); },900);
                    } else { showMsg(msgEl, res.message||'Error','error'); }
                    btn.prop('disabled',false).html('<i class="fas fa-save mr-1"></i><span id="createRoleBtnText">'+(isEditMode?'Save Changes':'Create Role')+'</span>');
                },
                error: () => { showMsg(msgEl,'Network error','error'); btn.prop('disabled',false); }
            });
        }

        function openManageRolesListModal() { openModal('manageRolesListModal'); loadRolesList(); }
        function closeManageRolesListModal() { closeModal('manageRolesListModal'); }

        function loadRolesList() {
            $('#rolesListContainer').html('<p class="text-gray-400 text-xs text-center py-4">Loading...</p>');
            $.get('@Url.Action("GetAllSystemRoles", "Auth")', function(roles) {
                const saCount = allUsers.filter(u => {
                    const rs = u.roles || u.Roles || [];
                    return rs.some(r => r.toLowerCase() === 'superadmin');
                }).length;

                let html = createRoleItem({ name: 'SuperAdmin', isSystem: true, userCount: saCount }, '#ef4444');
                (roles || []).forEach(r => { html += createRoleItem(r, '#00BCEB'); });
                $('#rolesListContainer').html(html);
            }).fail(() => $('#rolesListContainer').html('<p class="text-red-500 text-xs text-center py-4">Error loading roles</p>'));
        }

        function createRoleItem(role, color) {
            const n = typeof role==='string' ? role : (role.name||role.RoleName);
            const btns = role.isSystem
                ? '<span class="text-[9px] text-gray-400 italic flex items-center gap-1"><i class="fas fa-lock text-[8px]"></i>Protected</span>'
                : `<div class="flex gap-1.5">
                     <button onclick="editSystemRole('${n}')" class="text-cyan-600 hover:text-cyan-800 text-xs" title="Edit"><i class="fas fa-edit"></i></button>
                     <button onclick="deleteRole('${role.id||0}','${n}')" class="text-red-500 hover:text-red-700 text-xs" title="Delete"><i class="fas fa-trash"></i></button>
                   </div>`;
            return `<div class="flex items-center justify-between p-2.5 bg-gray-50 rounded-lg border hover:bg-white hover:shadow-sm transition-all">
                <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded-full text-[9px] font-bold text-white shadow-sm"
                          style="background:linear-gradient(135deg,${color},${color}cc)">${formatRoleName(n)}</span>
                    ${role.isSystem ? '<span class="text-[8px] bg-gray-200 text-gray-500 px-1 py-0.5 rounded font-bold">SYSTEM</span>' : ''}
                </div>
                <div class="flex items-center gap-3">
                    <span class="text-[10px] text-gray-500">${role.userCount||0} users</span>
                    ${btns}
                </div>
            </div>`;
        }

        function deleteRole(id, name) {
            sysConfirm(`Delete role "${name}"? Users will lose access.`, function() {
                $.ajax({ url:'/Auth/DeleteRole', type:'POST', contentType:'application/json',
                    data:JSON.stringify({RoleName:name}),
                    success: res => { if(res.success){sysAlert(res.message,'success'); loadRolesList();}else sysAlert(res.message,'error'); },
                    error: () => sysAlert('Error deleting role','error')
                });
            }, { type:'danger' });
        }

        function showMsg(el, msg, type) {
            el.removeClass('hidden bg-red-50 text-red-700 bg-green-50 text-green-700');
            el.addClass(type==='success' ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-red-50 text-red-700 border border-red-200');
            el.text(msg);
        }

        $(document).ready(function() { loadSystemRoles(); });
    </script>
}
