                            <div class="flex gap-3">
                                <button onclick="selectAllPolicies()" class="text-[10px] text-sky-500 hover:text-sky-700 font-semibold">Select All</button>
                                <button onclick="clearAllPolicies()" class="text-[10px] text-gray-400 hover:text-gray-600 font-semibold">Clear</button>
