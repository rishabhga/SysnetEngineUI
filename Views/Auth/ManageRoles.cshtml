<!-- ══════════════════════════════════════════
     MODAL: MANAGE SYSTEM ROLES LIST
     ══════════════════════════════════════════ -->
<div id="manageRolesListModal" class="rm-overlay" role="dialog" aria-modal="true" aria-labelledby="manageRolesTitle">
    <div class="rm-modal" style="max-width:440px;">
        <div class="rm-modal-header" style="background:linear-gradient(135deg,#f59e0b,#d97706);">
            <h3 id="manageRolesTitle"><i class="fas fa-list"></i> System Roles</h3>
            <button class="rm-modal-close" onclick="closeManageRolesListModal()" aria-label="Close">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="rm-modal-body">
            <div id="rolesListContainer" class="space-y-2">
                <p class="text-gray-400 text-xs text-center py-4">Loading roles…</p>
            </div>
        </div>
        <div class="rm-modal-footer">
            <button onclick="closeManageRolesListModal()" class="btn-secondary">Close</button>
        </div>
    </div>
