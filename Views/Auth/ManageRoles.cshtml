@section Scripts {
    <script>
        var systemRoles = [];
        var roleConfigs = {};
        var allUsers = @Html.Raw(Json.Serialize(Model));
        var existingAssignments = {};

        /* Build existing assignment index */
        (allUsers || []).forEach(function(u) {
            var maps = u.Mappings || u.mappings || [];
            existingAssignments[u.Username || u.username] = {
                companyIds:  maps.filter(m => m.CompanyId  != null || m.companyId  != null).map(m => parseInt(m.CompanyId  || m.companyId)),
                groupIds:    maps.filter(m => m.GroupId    != null || m.groupId    != null).map(m => parseInt(m.GroupId    || m.groupId)),
                locationIds: maps.filter(m => m.LocationId != null || m.locationId != null).map(m => parseInt(m.LocationId || m.locationId)),
                devices:     maps.filter(m => (m.ScopeType||m.scopeType) === 'Device').map(m => m.ScopeName || m.scopeName || '')
            };
        });

        /* ── Modal helpers ── */
        function openModal(id)  { document.getElementById(id).classList.add('open'); document.body.style.overflow = 'hidden'; }
        function closeModal(id) { document.getElementById(id).classList.remove('open'); document.body.style.overflow = ''; }

        /* Close on overlay click */
        document.querySelectorAll('.rm-overlay').forEach(function(overlay) {
            overlay.addEventListener('click', function(e) {
                if (e.target === overlay) closeModal(overlay.id);
            });
        });

        /* Close on Escape */
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.rm-overlay.open').forEach(function(m) { closeModal(m.id); });
            }
        });

        /* ── Utility ── */
        function formatRoleName(n) { return (n||'').replace(/([A-Z])/g,' $1').trim(); }

        function filterList(listId, term) {
            const t = term.toLowerCase();
            document.querySelectorAll('#'+listId+' .mc-item').forEach(el => {
                el.style.display = (!t || el.textContent.toLowerCase().includes(t)) ? '' : 'none';
            });
        }

        function filterUserTable(term) {
            const t = term.toLowerCase();
            let visible = 0;
            document.querySelectorAll('#roleTableBody tr').forEach(function(row) {
                const uname = row.getAttribute('data-username') || '';
                const match = !t || uname.includes(t);
                row.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            const el = document.getElementById('visibleCount');
            if (el) el.textContent = visible;
        }

        function valueOf(obj, pascal, camel) { return obj ? (obj[pascal] ?? obj[camel]) : null; }
        function normalizeUser(user) {
            return { username: valueOf(user,'Username','username')||'', roles: valueOf(user,'Roles','roles')||[], mappings: valueOf(user,'Mappings','mappings')||[], companyId: valueOf(user,'CompanyId','companyId') };
        }

        /* ── Render stats ── */
        function renderStats() {
            const c = $('#roleStatsContainer').empty();
            addStat(c,'Total Users', allUsers.length,'#0ea5e9','fa-users');
            const sa = allUsers.filter(u => (u.roles||u.Roles||[]).some(r => r.toLowerCase()==='superadmin')).length;
            addStat(c,'Super Admin', sa,'#ef4444','fa-crown');
            systemRoles.forEach(r => {
                const n = typeof r==='string'?r:(r.name||r.RoleName);
                if (!n || n.toLowerCase()==='superadmin') return;
                const count = allUsers.filter(u => (u.roles||u.Roles||[]).some(role => role.toLowerCase()===n.toLowerCase())).length;
                addStat(c, n, count, '#0ea5e9','fa-tag');
            });
            const noRole = allUsers.filter(u => !(u.roles||u.Roles||[]).length).length;
            addStat(c,'No Role', noRole,'#9ca3af','fa-user-slash');
        }

        function addStat(c, title, val, color, icon) {
            c.append(`<div class="stat-card"><div class="flex items-center justify-between"><div><p class="text-[9px] font-bold text-gray-400 uppercase tracking-wide mb-0.5">${formatRoleName(title)}</p><p class="text-xl font-black text-gray-900">${val}</p></div><div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0" style="background:linear-gradient(135deg,${color},${color}cc);"><i class="fas ${icon} text-white text-[11px]"></i></div></div></div>`);
        }

        /* ── Load system roles ── */
        function loadSystemRoles() {
            $.get('@Url.Action("GetAllSystemRoles", "Auth")', function(roles) {
                systemRoles = roles || [];
                roleConfigs = { 'SuperAdmin': { requiresCompany:false,requiresGroup:false,requiresDevice:false,requiresLocation:false,isSystem:true } };
                systemRoles.forEach(r => {
                    const n = typeof r==='string'?r:(r.name||r.RoleName);
                    roleConfigs[n] = { requiresCompany:r.requiresCompany||false,requiresGroup:r.requiresGroup||false,requiresDevice:r.requiresDevice||false,requiresLocation:r.requiresLocation||false,isSystem:r.isSystem||false };
                });
                updateRoleDropdown();
                renderStats();
            }).fail(() => renderStats());
        }

        function updateRoleDropdown() {
            const opts = ['<option value="">-- Select Role --</option>']
                .concat(systemRoles.filter(r => { const n=typeof r==='string'?r:(r.name||r.RoleName); return n!=='SuperAdmin'; })
                    .map(r => { const n=typeof r==='string'?r:(r.name||r.RoleName); return `<option value="${n}">${formatRoleName(n)}</option>`; }))
                .join('');
            $('#assignRole').html(opts || '<option value="">No roles available</option>');
        }

        /* ── Assign Role Modal ── */
        function openAssignRoleModal() {
            $('#assignUsername').val('');
            $('#assignRole').val('');
            $('#assignMessage').addClass('hidden');
            $('#companySelectDiv,#groupSelectDiv,#locationSelectDiv,#domainSelectDiv').addClass('hidden');
            openModal('assignRoleModal');
            loadSystemRoles();
            loadCompaniesForModal();
        }

        function closeAssignRoleModal() {
            closeModal('assignRoleModal');
            $('#assignUsername').val('');
            $('#assignRole').val('');
            $('#assignMessage').addClass('hidden');
        }

        $('#assignRole').on('change', function() {
            const cfg = roleConfigs[$(this).val()] || {};
            const needsScope = cfg.requiresCompany || cfg.requiresGroup || cfg.requiresDevice || cfg.requiresLocation;
            // Company selection div is removed, we now logic based on the user's registered company
            $('#groupSelectDiv,#locationSelectDiv,#domainSelectDiv').addClass('hidden');
            if (needsScope) {
                // Trigger username search to find company
                $('#assignUsername').trigger('input');
            }
        });

        function buildCheckboxList(containerId, items, valueKey, labelKey, alreadyIds) {
            const already = new Set((alreadyIds||[]).map(x => String(parseInt(x))));
            if (!items || !items.length) { $('#'+containerId).html('<div class="mc-item text-gray-400">None found</div>'); return; }
            const html = items.map(item => {
                const val   = item[valueKey] || item[valueKey.toLowerCase()];
                const label = item[labelKey] || item[labelKey.toLowerCase()];
                const isDup = already.has(String(parseInt(val)));
                return `<label class="mc-item ${isDup?'mc-disabled':''}"><input type="checkbox" value="${val}" ${isDup?'disabled checked':''}><span class="flex-1 truncate">${label}</span>${isDup?'<span class="already-tag">assigned</span>':''}</label>`;
            }).join('');
            $('#'+containerId).html(html);
        }

        function loadCompaniesForModal() {
            const username = $('#assignUsername').val().trim();
            const existing = (existingAssignments[username]||{}).companyIds||[];
            $('#companyList').html('<div class="mc-item text-gray-400"><i class="fas fa-spinner fa-spin mr-1"></i>Loading…</div>');
            $.get('/Companies/GetCompaniesForDropdown', function(data) {
                buildCheckboxList('companyList', data, 'id', 'companyName', existing);
            });
        }

        var usernameDebounce;
        $('#assignUsername').on('input', function() {
            clearTimeout(usernameDebounce);
            usernameDebounce = setTimeout(function() {
                const uname = $('#assignUsername').val().trim().toLowerCase();
                const role = $('#assignRole').val();
                const cfg  = roleConfigs[role] || {};
                
                // Find user's company
                const user = allUsers.find(u => (u.Username||u.username||"").toLowerCase() === uname);
                if (user && (user.CompanyId || user.companyId)) {
                    $('#companyIdHidden').val(user.CompanyId || user.companyId);
                    
                    if (role && (cfg.requiresGroup || cfg.requiresDevice || cfg.requiresLocation)) {
                        loadGroupsForImplicitCompany(user.CompanyId || user.companyId);
                    }
                } else {
                    $('#companyIdHidden').val('');
                }
            }, 400);
        });

        function loadGroupsForImplicitCompany(cid) {
            const username = $('#assignUsername').val().trim();
            const existingGroups = (existingAssignments[username]||{}).groupIds||[];
            $('#groupSelectDiv').removeClass('hidden');
            $('#groupList').html('<div class="mc-item text-gray-400"><i class="fas fa-spinner fa-spin mr-1"></i>Loading…</div>');
            $.get('/Companies/GetGroupsByCompany?companyId='+cid, function(groups) {
                buildCheckboxList('groupList', groups, 'id', 'groupName', existingGroups);
            });
        }

        $('#companyList').on('change', 'input[type=checkbox]', function() {
            const checkedIds = $('#companyList input:checked:not(:disabled)').map((i,el) => $(el).val()).get();
            if (!checkedIds.length) { $('#groupSelectDiv').addClass('hidden'); return; }
            const cfg = roleConfigs[$('#assignRole').val()] || {};
            if (!cfg.requiresGroup && !cfg.requiresDevice && !cfg.requiresLocation) return;
            $('#groupSelectDiv').removeClass('hidden');
            const username = $('#assignUsername').val().trim();
            const existingGroups = (existingAssignments[username]||{}).groupIds||[];
            $('#groupList').html('<div class="mc-item text-gray-400"><i class="fas fa-spinner fa-spin mr-1"></i>Loading…</div>');
            const promises = checkedIds.map(cid => $.get('/Companies/GetGroupsByCompany?companyId='+cid));
            Promise.all(promises.map(p => new Promise(res => { p.then(res).fail(()=>res([])); }))).then(results => {
                const seen=new Set(); const allGroups=[];
                results.forEach(arr => (arr||[]).forEach(g => { const id=g.id||g.Id; if(!seen.has(id)){seen.add(id);allGroups.push(g);} }));
                buildCheckboxList('groupList', allGroups, 'id', 'groupName', existingGroups);
            });
        });

        $('#groupList').on('change', 'input[type=checkbox]', function() {
            const checkedGroupIds = $('#groupList input:checked:not(:disabled)').map((i,el)=>$(el).val()).get();
            if (!checkedGroupIds.length) { $('#locationSelectDiv').addClass('hidden'); return; }
            const cfg = roleConfigs[$('#assignRole').val()] || {};
            if (!cfg.requiresLocation && !cfg.requiresDevice) return;
            $('#locationSelectDiv').removeClass('hidden');
            const cid = $('#companyIdHidden').val();
            const username = $('#assignUsername').val().trim();
            const existingLocs = (existingAssignments[username]||{}).locationIds||[];
            $('#locationList').html('<div class="mc-item text-gray-400"><i class="fas fa-spinner fa-spin mr-1"></i>Loading…</div>');
            const promises = checkedGroupIds.map(gid => $.get('/Companies/GetLocationsByGroup?companyId='+cid+'&groupId='+gid));
            Promise.all(promises.map(p => new Promise(res => { p.then(res).fail(()=>res([])); }))).then(results => {
                const seen=new Set(); const allLocs=[];
                results.forEach(arr => (arr||[]).forEach(loc => { const id=loc.id||loc.Id; if(!seen.has(id)){seen.add(id);allLocs.push(loc);} }));
                buildCheckboxList('locationList', allLocs, 'id', 'locationName', existingLocs);
            });
        });

        $('#locationList').on('change', 'input[type=checkbox]', function() {
            const checkedLocIds = $('#locationList input:checked:not(:disabled)').map((i,el)=>$(el).val()).get();
            if (!checkedLocIds.length) { $('#domainSelectDiv').addClass('hidden'); return; }
            const cfg = roleConfigs[$('#assignRole').val()] || {};
            if (!cfg.requiresDevice) return;
            $('#domainSelectDiv').removeClass('hidden');

            const cids = $('#companyList input:checked:not(:disabled)').map((i,el)=>$(el).val()).get();
            const gids = $('#groupList input:checked:not(:disabled)').map((i,el)=>$(el).val()).get();
            
            const cid = cids.length ? cids[0] : $('#companyIdHidden').val();
            const gid = gids.length ? gids[0] : null;
            const lid = checkedLocIds[0];
            
            const username = $('#assignUsername').val().trim();
            const existingDevices = (existingAssignments[username]||{}).devices||[];
            
            $('#domainList').html('<div class="mc-item text-gray-400"><i class="fas fa-spinner fa-spin mr-1"></i>Loading…</div>');
            $.get('/ComputerSummary/GetDevicesByLocation?companyId='+cid+'&groupId='+gid+'&locationId='+lid, function(data) {
                buildCheckboxList('domainList', data, 'domainName', 'domainName', existingDevices);
            });
        });

        async function submitAssignRole() {
            const username = $('#assignUsername').val().trim();
            const role     = $('#assignRole').val();
            const msgEl    = $('#assignMessage');
            const btn      = $('#assignRoleBtn');

            msgEl.addClass('hidden');

            if (!username) { showMsg(msgEl,'Please enter a username','error'); return; }
            if (!role)     { showMsg(msgEl,'Please select a role','error'); return; }

            const cfg = roleConfigs[role] || {};
            const implicitCid = parseInt($('#companyIdHidden').val());
            const cidsFromList = $('#companyList input:checked:not(:disabled)').map((i,el)=>parseInt($(el).val())).get();
            const companyIds  = cidsFromList.length ? cidsFromList : (implicitCid ? [implicitCid] : []);
            const groupIds    = $('#groupList input:checked:not(:disabled)').map((i,el)=>parseInt($(el).val())).get();
            const locationIds = $('#locationList input:checked:not(:disabled)').map((i,el)=>parseInt($(el).val())).get();
            const domainNames = $('#domainList input:checked:not(:disabled)').map((i,el)=>$(el).val()).get();

            if (cfg.requiresCompany && !companyIds.length) { showMsg(msgEl,'User must have a company assigned.','error'); return; }
            if (cfg.requiresGroup && !groupIds.length) { showMsg(msgEl,'Select at least one group','error'); return; }
            if (cfg.requiresLocation && !locationIds.length) { showMsg(msgEl,'Select at least one location','error'); return; }
            if (cfg.requiresDevice  && !domainNames.length) { showMsg(msgEl,'Select at least one device','error'); return; }

            /* Build payloads iteratively */
            const payloads = [];
            const companiesLoop = companyIds.length ? companyIds : [null];
            const groupsLoop = groupIds.length ? groupIds : [null];
            const locationsLoop = locationIds.length ? locationIds : [null];
            const domainsLoop = domainNames.length ? domainNames : [null];
            
            companiesLoop.forEach(cid => {
                groupsLoop.forEach(gid => {
                    locationsLoop.forEach(lid => {
                        domainsLoop.forEach(domain => {
                            payloads.push({
                                Username: username,
                                Role: role,
                                CompanyId: cid,
                                GroupId: gid,
                                LocationId: lid,
                                DomainName: domain
                            });
                        });
                    });
                });
            });

            /* Dedup check */
            const userMappings = (allUsers.find(u => (u.username||u.Username)===username)||{}).mappings || [];
            const roleLower = role.toLowerCase();
            const finalPayloads = payloads.filter(p => !userMappings.some(m =>
                (m.roleName||m.RoleName||'').toLowerCase()===roleLower &&
                (m.companyId||m.CompanyId) === p.CompanyId &&
                (m.groupId||m.GroupId) === p.GroupId &&
                (m.locationId||m.LocationId) === p.LocationId
            ));

            if (payloads.length > 0 && finalPayloads.length === 0) {
                showMsg(msgEl,'Selected mapping(s) are already assigned.','error');
                return;
            }

            btn.prop('disabled',true).html('<i class="fas fa-spinner fa-spin mr-1.5"></i>Assigning…');

            let successCount = 0, failMessages = [];
            for (const payload of finalPayloads) {
                try {
                    const res = await $.ajax({ url:'@Url.Action("AssignRole", "Auth")', type:'POST', contentType:'application/json', data:JSON.stringify(payload) });
                    if (res.success) successCount++;
                    else failMessages.push(res.message || 'Failed');
                } catch(e) { failMessages.push('Network error'); }
            }

            btn.prop('disabled',false).html('<i class="fas fa-check mr-1.5 text-[10px]"></i>Assign Role');

            if (successCount > 0) {
                // ✅ Close modal and show success toast
                setTimeout(() => {
                    closeAssignRoleModal();
                    sysAlert(`${successCount} assignment(s) added successfully!`, 'success');
                    refreshRoleData();
                }, 200);
            } else {
                showMsg(msgEl, failMessages.join('; ') || 'Assignment failed', 'error');
            }
        }

        /* ── Remove mapping ── */
        function deleteMapping(id, username, roleName, scopeName) {
            sysConfirm(`Remove "${roleName}" in "${scopeName}" for "${username}"?`, function() {
                $.post('@Url.Action("RemoveMapping", "Auth")/' + id, function(res) {
                    if (res.success) { sysAlert('Assignment removed','success'); refreshRoleData(); }
                    else sysAlert(res.message || 'Failed','error');
                }).fail(() => sysAlert('Error removing assignment','error'));
            }, { type:'danger' });
        }

        /* ── Remove user role entirely ── */
        function removeUserRole(username, roleName) {
            sysConfirm(`Remove all roles from "${username}"? This will revoke their access.`, function() {
                $.ajax({ url:'@Url.Action("RemoveRole", "Auth")', type:'POST', contentType:'application/json',
                    data: JSON.stringify({ Username: username }),
                    success: res => {
                        if (res.success) { sysAlert('Role removed','success'); refreshRoleData(); }
                        else sysAlert(res.message || 'Failed','error');
                    },
                    error: () => sysAlert('Error removing role','error')
                });
            }, { type:'danger' });
        }

        /* ── Edit role (opens Assign modal pre-filled) ── */
        function editRole(username, currentRole, companyId, domainName) {
            openAssignRoleModal();
            setTimeout(() => {
                $('#assignUsername').val(username);
                if (currentRole) { $('#assignRole').val(currentRole).trigger('change'); }
            }, 300);
        }

        /* ── Refresh table data ── */
        function refreshRoleData() {
            return $.get('@Url.Action("ManageRoles", "Auth")').done(function(html) {
                const scriptMatch = html.match(/var allUsers = ([\s\S]*?);\s*var existingAssignments/);
                if (scriptMatch && scriptMatch[1]) { try { allUsers = JSON.parse(scriptMatch[1]); } catch(_){} }

                const doc = new DOMParser().parseFromString(html, 'text/html');
                const tableBody = doc.getElementById('roleTableBody');
                if (tableBody) document.getElementById('roleTableBody').innerHTML = tableBody.innerHTML;
                else renderRoleRows();

                existingAssignments = {};
                (allUsers||[]).forEach(function(u) {
                    var maps = u.Mappings||u.mappings||[];
                    existingAssignments[u.Username||u.username] = {
                        companyIds:  maps.filter(m => m.CompanyId  != null||m.companyId  != null).map(m => parseInt(m.CompanyId||m.companyId)),
                        groupIds:    maps.filter(m => m.GroupId    != null||m.groupId    != null).map(m => parseInt(m.GroupId||m.groupId)),
                        locationIds: maps.filter(m => m.LocationId != null||m.locationId != null).map(m => parseInt(m.LocationId||m.locationId)),
                        devices:     maps.filter(m => (m.ScopeType||m.scopeType)==='Device').map(m => m.ScopeName||m.scopeName||'')
                    };
                });
                renderStats();
            });
        }

        /* ── Create Role Modal ── */
        var isEditMode = false, currentEditingRole = '', permissionsData = [], menusData = [], policiesData = [], currentRoleData = null;

        function openCreateRoleModal() {
            isEditMode = false; currentEditingRole = '';
            $('#createRoleBtnText').text('Create Role');
            $('#newRoleName').val('').prop('readonly',false);
            $('#newRoleDescription').val('');
            $('#roleRequiresCompany,#roleRequiresGroup,#roleRequiresDevice,#roleRequiresLocation').prop('checked',false);
            $('#createRoleMessage').addClass('hidden');
            openModal('createRoleModal');
            switchRoleTab('perms');
            loadCreatePermissions(); loadCreateMenus(); loadCreatePolicies();
        }

        function closeCreateRoleModal() { closeModal('createRoleModal'); }

        function switchRoleTab(tab) {
            $('.role-tab-btn').removeClass('active');
            $('#tabBtn_'+tab).addClass('active');
            $('#tabContent_perms,#tabContent_menus,#tabContent_policies').addClass('hidden');
            $('#tabContent_'+tab).removeClass('hidden');
        }

        function loadCreatePermissions() {
            $('#permissionTree').html('<p class="text-gray-400 text-center py-4 text-xs">Loading…</p>');
            $.get('@Url.Action("GetGroupedPermissions", "Auth")', function(data) {
                permissionsData = data; renderPermissionTree(data);
                if (isEditMode) syncRolePermissions();
            }).fail(() => $('#permissionTree').html('<p class="text-red-400 text-center py-4 text-xs">Failed to load</p>'));
        }

        function loadCreateMenus() {
            $('#menuTree').html('<p class="text-gray-400 text-center py-4 text-xs">Loading…</p>');
            $.get('@Url.Action("GetMenusGroupedByModule", "Auth")', function(data) {
                menusData = data; renderMenuTree(data);
                if (isEditMode) syncRoleMenus();
            }).fail(() => $('#menuTree').html('<p class="text-red-400 text-center py-4 text-xs">Failed to load</p>'));
        }

        function loadCreatePolicies() {
            $('#policyTree').html('<p class="text-gray-400 text-center py-4 text-xs">Loading…</p>');
            $.get('@Url.Action("Templates", "Policy")', function(data) {
                policiesData = data; renderPolicyTree(data);
                if (isEditMode) syncRolePolicies();
            }).fail(() => $('#policyTree').html('<p class="text-red-400 text-center py-4 text-xs">Failed to load policies</p>'));
        }

        function renderPermissionTree(modules) {
            if (!modules?.length) { $('#permissionTree').html('<p class="text-gray-400 text-center py-4 text-xs">No permissions</p>'); return; }
            $('#permissionTree').html(modules.map(m => {
                const mid = m.moduleName.replace(/\s+/g,'');
                return `<div class="mb-3"><label class="flex items-center gap-1.5 mb-1.5 cursor-pointer"><input type="checkbox" id="mod_${mid}" class="rounded accent-sky-500" onchange="toggleModulePerms('${mid}')"><span class="text-[10px] font-semibold text-gray-700"><i class="${m.moduleIcon||'fas fa-folder'} mr-1 text-gray-400"></i>${m.moduleName}</span></label><div class="ml-5 space-y-0.5" id="perms_${mid}">${(m.permissions||[]).map(p => `<label class="flex items-center gap-1.5 text-[10px] text-gray-600 hover:bg-sky-50 px-1.5 py-0.5 rounded cursor-pointer"><input type="checkbox" class="perm-checkbox rounded accent-sky-500" name="permissions" value="${p.permissionCode}" data-module="${mid}"><span class="flex-1">${p.permissionName}</span><span class="text-[9px] ${p.actionType==='View'?'text-emerald-600':'text-amber-500'}">${p.actionType}</span></label>`).join('')}</div></div>`;
            }).join(''));
        }

        function toggleModulePerms(mid) { const v=$('#mod_'+mid).is(':checked'); $('#perms_'+mid+' input').prop('checked',v); }
        function selectAllPermissions() { $('#permissionTree input').prop('checked',true); }
        function clearAllPermissions()  { $('#permissionTree input').prop('checked',false); }

        function renderMenuTree(modules) {
            if (!modules?.length) { $('#menuTree').html('<p class="text-gray-400 text-center py-4 text-xs">No menus</p>'); return; }
            $('#menuTree').html(modules.map(m => {
                const mid = (m.moduleName||'').replace(/\s+/g,'')+'_m';
                return `<div class="mb-3"><label class="flex items-center gap-1.5 mb-1.5 cursor-pointer"><input type="checkbox" id="mod_menu_${mid}" class="rounded accent-sky-500" onchange="toggleModuleMenus('${mid}')"><span class="text-[10px] font-semibold text-gray-700">${m.moduleName||'Unknown'}</span></label><div class="ml-5 space-y-0.5" id="menu_container_${mid}">${(m.menus||m.Menus||[]).map(mn => `<label class="flex items-center gap-1.5 text-[10px] text-gray-600 hover:bg-sky-50 px-1.5 py-0.5 rounded cursor-pointer"><input type="checkbox" class="menu-checkbox rounded accent-sky-500" name="menuIds" value="${mn.id||mn.Id}"><span>${mn.menuName||mn.MenuName}</span></label>`).join('')}</div></div>`;
            }).join(''));
        }

        function toggleModuleMenus(mid) { const v=$('#mod_menu_'+mid).is(':checked'); $('#menu_container_'+mid+' input').prop('checked',v); }
        function selectAllMenus() { $('#menuTree input').prop('checked',true); }
        function clearAllMenus()  { $('#menuTree input').prop('checked',false); }

        function renderPolicyTree(policies) {
            if (!policies?.length) { $('#policyTree').html('<p class="text-gray-400 text-center py-4 text-xs">No policies assigned to system yet.</p>'); return; }
            $('#policyTree').html('<div class="space-y-1 mt-2">' + policies.map(p => {
                return `<label class="flex items-center gap-2 p-2 bg-gray-50 border border-gray-100 rounded-lg cursor-pointer hover:bg-sky-50 transition-colors"><input type="checkbox" name="policyIds" class="policy-checkbox rounded accent-sky-500 w-4 h-4" value="${p.id}" onchange="handlePolicyChange(${p.id}, this.checked)"><div class="flex-1 min-w-0"><p class="text-xs font-bold text-gray-800">${p.displayName||p.policyName}</p><p class="text-[10px] text-gray-500 truncate">${p.description||'Contains '+p.permissionCount+' permissions'}</p></div></label>`;
            }).join('') + '</div>');
        }

        function handlePolicyChange(policyId, isChecked) {
            const policy = policiesData.find(p => p.id === policyId);
            if (!policy || !policy.permissions) return;
            policy.permissions.forEach(code => {
                const $chk = $(`input[name="permissions"][value="${code}"]`);
                if ($chk.length) {
                    $chk.prop('checked', isChecked);
                    const mid = $chk.closest('div[id^="perms_"]').attr('id').replace('perms_', '');
                    updateModuleCheckbox(mid);
                }
            });
        }

        function updateModuleCheckbox(mid) {
            const total = $(`#perms_${mid} input`).length;
            const checked = $(`#perms_${mid} input:checked`).length;
            $(`#mod_${mid}`).prop('checked', total > 0 && total === checked);
            $(`#mod_${mid}`).prop('indeterminate', checked > 0 && checked < total);
        }

        function selectAllPolicies() { $('#policyTree input').prop('checked',true); }
        function clearAllPolicies()  { $('#policyTree input').prop('checked',false); }

        function syncRolePermissions() {
            if (!currentRoleData?.permissions) return;
            $('input[name="permissions"]').prop('checked',false);
            currentRoleData.permissions.forEach(c => $(`input[name="permissions"][value="${c}"]`).prop('checked',true));
        }
        function syncRoleMenus() {
            if (!currentRoleData?.menus) return;
            $('input[name="menuIds"]').prop('checked',false);
            currentRoleData.menus.forEach(id => $(`input[name="menuIds"][value="${id}"]`).prop('checked',true));
        }
        function syncRolePolicies() {
            if (!currentRoleData?.policies) return;
            $('input[name="policyIds"]').prop('checked',false);
            currentRoleData.policies.forEach(id => $(`input[name="policyIds"][value="${id}"]`).prop('checked',true));
        }

        function validateRoleName(input) {
            const val = input.value;
            const hint = document.getElementById('roleNameHint');
            if (!val) { hint.className='text-[10px] text-gray-400 mt-1'; hint.textContent='No spaces. Use CamelCase (e.g. SiteEngineer).'; return; }
            if (/[^a-zA-Z0-9_]/.test(val)) {
                hint.className='text-[10px] text-red-500 mt-1'; hint.textContent=' Only letters, numbers and underscores.';
                input.classList.add('border-red-400');
            } else if (val.length < 3) {
                hint.className='text-[10px] text-amber-500 mt-1'; hint.textContent='At least 3 characters.';
                input.classList.remove('border-red-400');
            } else {
                const exists = !isEditMode && systemRoles.some(r => { const n=typeof r==='string'?r:(r.name||r.RoleName||''); return n.toLowerCase()===val.toLowerCase(); });
                if (exists) { hint.className='text-[10px] text-red-500 mt-1'; hint.textContent=' Role name already exists.'; input.classList.add('border-red-400'); }
                else { hint.className='text-[10px] text-emerald-600 mt-1'; hint.textContent='✓ Valid role name.'; input.classList.remove('border-red-400'); }
            }
        }

        function submitCreateRole() {
            const roleName = $('#newRoleName').val().trim();
            const perms = $('input[name="permissions"]:checked').map((i,el) => $(el).val()).get();
            const menus = $('input[name="menuIds"]:checked').map((i,el) => parseInt($(el).val())).get();
            const policies = $('input[name="policyIds"]:checked').map((i,el) => parseInt($(el).val())).get();
            const msgEl = $('#createRoleMessage');

            if (!roleName) { showMsg(msgEl,'Enter a role name','error'); return; }
            if (/[\s]/.test(roleName)) { showMsg(msgEl,'No spaces — use CamelCase','error'); return; }
            if (/[^a-zA-Z0-9_]/.test(roleName)) { showMsg(msgEl,'Only letters, numbers and underscores','error'); return; }
            if (roleName.length < 3) { showMsg(msgEl,'At least 3 characters','error'); return; }
            if (!isEditMode) {
                const dup = systemRoles.some(r => { const n=typeof r==='string'?r:(r.name||r.RoleName||''); return n.toLowerCase()===roleName.toLowerCase(); });
                if (dup) { showMsg(msgEl,'A role with this name already exists','error'); return; }
            }
            if (!perms.length) { showMsg(msgEl,'Select at least one permission','error'); return; }

            const btn = $('#createRoleBtn').prop('disabled',true).html('<i class="fas fa-spinner fa-spin mr-1.5"></i>Saving…');
            const url = isEditMode ? '@Url.Action("UpdateRoleWithPermissions", "Auth")' : '@Url.Action("CreateRoleWithPermissions", "Auth")';

            $.ajax({ url, type:'POST', contentType:'application/json',
                data: JSON.stringify({
                    RoleName: roleName, Description: $('#newRoleDescription').val(),
                    RequiresCompany:  $('#roleRequiresCompany').is(':checked'),
                    RequiresGroup:    $('#roleRequiresGroup').is(':checked'),
                    RequiresDevice:   $('#roleRequiresDevice').is(':checked'),
                    RequiresLocation: $('#roleRequiresLocation').is(':checked'),
                    Permissions: perms, MenuIds: menus, PolicyIds: policies
                }),
                success: res => {
                    if (res.success) {
                        setTimeout(() => {
                            closeCreateRoleModal();
                            sysAlert(isEditMode ? 'Role updated successfully!' : 'Role created successfully!', 'success');
                            loadSystemRoles();
                        }, 200);
                    } else { showMsg(msgEl, res.message||'Error saving role','error'); }
                    btn.prop('disabled',false).html('<i class="fas fa-save mr-1.5 text-[10px]"></i><span id="createRoleBtnText">'+(isEditMode?'Save Changes':'Create Role')+'</span>');
                },
                error: () => { showMsg(msgEl,'Network error','error'); btn.prop('disabled',false); }
            });
        }

        function editSystemRole(roleName) {
            closeManageRolesListModal();
            isEditMode = true; currentEditingRole = roleName;
            $('#createRoleBtnText').text('Save Changes');
            $('#newRoleName').val(roleName).prop('readonly',true);
            openModal('createRoleModal');
            $('#createRoleMessage').addClass('hidden');

            $.get('@Url.Action("GetRoleDetails", "Auth")?roleName=' + roleName, function(data) {
                currentRoleData = data;
                $('#newRoleDescription').val(data.description);
                $('#roleRequiresCompany').prop('checked', data.requiresCompany);
                $('#roleRequiresGroup').prop('checked', data.requiresGroup);
                $('#roleRequiresDevice').prop('checked', data.requiresDevice);
                $('#roleRequiresLocation').prop('checked', data.requiresLocation);
                loadCreatePermissions(); loadCreateMenus(); loadCreatePolicies();
            });
        }

        function openManageRolesListModal() { openModal('manageRolesListModal'); loadRolesList(); }
        function closeManageRolesListModal() { closeModal('manageRolesListModal'); }

        function loadRolesList() {
            $('#rolesListContainer').html('<p class="text-gray-400 text-xs text-center py-4">Loading…</p>');
            $.get('@Url.Action("GetAllSystemRoles", "Auth")', function(roles) {
                const saCount = allUsers.filter(u => (u.roles||u.Roles||[]).some(r => r.toLowerCase()==='superadmin')).length;
                let html = createRoleItem({name:'SuperAdmin',isSystem:true,userCount:saCount}, '#ef4444');
                (roles||[]).forEach(r => { html += createRoleItem(r,'#0ea5e9'); });
                $('#rolesListContainer').html(html);
            }).fail(() => $('#rolesListContainer').html('<p class="text-red-400 text-xs text-center py-4">Error loading roles</p>'));
        }

        function createRoleItem(role, color) {
            const n = typeof role==='string' ? role : (role.name||role.RoleName);
            const btns = role.isSystem
                ? '<span class="text-[10px] text-gray-400 italic flex items-center gap-1"><i class="fas fa-lock text-[9px]"></i>Protected</span>'
                : `<div class="flex gap-2"><button onclick="editSystemRole('${n}')" class="text-sky-500 hover:text-sky-700 text-xs transition-colors" title="Edit"><i class="fas fa-edit"></i></button><button onclick="deleteRole('${role.id||0}','${n}')" class="text-red-400 hover:text-red-600 text-xs transition-colors" title="Delete"><i class="fas fa-trash"></i></button></div>`;
            return `<div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-white hover:shadow-sm transition-all">
                <div class="flex items-center gap-2 min-w-0">
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold text-white flex-shrink-0" style="background:linear-gradient(135deg,${color},${color}cc);">${formatRoleName(n)}</span>
                    ${role.isSystem ? '<span class="text-[9px] bg-gray-200 text-gray-500 px-1.5 py-0.5 rounded font-bold flex-shrink-0">SYSTEM</span>' : ''}
                </div>
                <div class="flex items-center gap-3 flex-shrink-0 ml-2">
                    <span class="text-[10px] text-gray-400 whitespace-nowrap">${role.userCount||0} users</span>
                    ${btns}
                </div>
            </div>`;
        }

        function deleteRole(id, name) {
            sysConfirm(`Delete role "${name}"? Users with this role will lose access.`, function() {
                $.ajax({ url:'/Auth/DeleteRole', type:'POST', contentType:'application/json',
                    data: JSON.stringify({RoleName:name}),
                    success: res => {
                        if (res.success) { sysAlert(res.message,'success'); loadRolesList(); loadSystemRoles(); }
                        else sysAlert(res.message,'error');
                    },
                    error: () => sysAlert('Error deleting role','error')
                });
            }, { type:'danger' });
        }

        function renderRoleRows() {
            const tbody = $('#roleTableBody');
            if (!tbody.length || !allUsers.length) return;
            const rows = allUsers.map(function(raw) {
                const user = normalizeUser(raw);
                const mappings = user.mappings || [];
                const companies = mappings.filter(m => valueOf(m,'CompanyId','companyId') != null);
                const groups    = mappings.filter(m => valueOf(m,'GroupId','groupId') != null);
                const locations = mappings.filter(m => valueOf(m,'LocationId','locationId') != null);
                const devices   = mappings.filter(m => (valueOf(m,'ScopeType','scopeType')||'') === 'Device');
                const roleChips = (user.roles||[]).map(r => {
                    const h = Math.abs((r||'').split('').reduce((a,c) => a+c.charCodeAt(0),0) % 360);
                    return `<span class="role-chip" style="background:hsl(${h},60%,94%);color:hsl(${h},65%,35%);border-color:hsl(${h},60%,80%)">${formatRoleName(r)}</span>`;
                }).join('');
                const safeUser = String(user.username||'').replace(/'/g,"\\'");
                const firstRole = (user.roles||[])[0]||'';
                const safeRole  = String(firstRole||'').replace(/'/g,"\\'");
                const isSuperAdmin = (user.roles||[]).some(r => (r||'').toLowerCase()==='superadmin');
                return `<tr data-username="${(user.username||'').toLowerCase()}">
                    <td><div class="flex items-center gap-2.5"><div class="w-7 h-7 rounded-lg bg-gradient-to-br from-sky-400 to-blue-500 flex items-center justify-center text-white text-[10px] font-bold flex-shrink-0">${(user.username||'U').charAt(0).toUpperCase()}</div><span class="font-semibold text-gray-800 text-xs">${user.username}</span></div></td>
                    <td>${roleChips||'<span class="text-gray-300 text-[10px] italic">No role</span>'}</td>
                    <td class="hidden sm:table-cell"><span class="scope-badge bg-blue-50 text-blue-600 border border-blue-200"><i class="fas fa-building text-[8px]"></i>${new Set(companies.map(c => valueOf(c,'CompanyId','companyId'))).size||0}</span></td>
                    <td class="hidden md:table-cell"><span class="scope-badge bg-orange-50 text-orange-600 border border-orange-200"><i class="fas fa-layer-group text-[8px]"></i>${new Set(groups.map(c => valueOf(c,'GroupId','groupId'))).size||0}</span></td>
                    <td class="hidden lg:table-cell"><span class="scope-badge bg-emerald-50 text-emerald-600 border border-emerald-200"><i class="fas fa-map-marker-alt text-[8px]"></i>${new Set(locations.map(c => valueOf(c,'LocationId','locationId'))).size||0}</span></td>
                    <td class="hidden xl:table-cell"><span class="scope-badge bg-purple-50 text-purple-600 border border-purple-200"><i class="fas fa-desktop text-[8px]"></i>${devices.length||0}</span></td>
                    <td class="text-right whitespace-nowrap">
                        ${isSuperAdmin ? '<span class="text-gray-300 text-[10px] italic flex items-center justify-end gap-1"><i class="fas fa-lock text-[9px]"></i>Protected</span>' :
                            `<button onclick="editRole('${safeUser}','${safeRole}',null,'')" class="btn-sm text-white mr-1" style="background:linear-gradient(135deg,#0ea5e9,#0284c7);"><i class="fas fa-edit text-[9px] mr-0.5"></i>Edit</button>
                             <button onclick="removeUserRole('${safeUser}','${safeRole}')" class="btn-sm text-white" style="background:linear-gradient(135deg,#ef4444,#dc2626);"><i class="fas fa-trash text-[9px] mr-0.5"></i>Remove</button>`
                        }
                    </td>
                </tr>`;
            }).join('');
            tbody.html(rows);
            const countEl = document.getElementById('visibleCount');
            if (countEl) countEl.textContent = allUsers.length;
        }

        /* ── Message helper ── */
        function showMsg(el, msg, type) {
            el.removeClass('hidden success error').addClass(type === 'success' ? 'success' : 'error');
            el.text(msg);
        }

        /* ── Init ── */
        $(document).ready(function() { loadSystemRoles(); });
        $(document).on('searchEvent', function(e, term) {
            if (typeof filterUserTable === 'function') {
                filterUserTable(term);
            }
        });
    </script>
}
