@model List<ManageEngineWebApp.Dtos.UserRoleDto>
@{
    ViewData["Title"] = "Manage User Roles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@functions {
    public string FormatRole(string name) =>
        string.IsNullOrEmpty(name) ? "" :
        System.Text.RegularExpressions.Regex.Replace(name, "([A-Z])", " $1").Trim();
}

@section Styles {
    <style>
        :root {
            --brand: #0ea5e9;
            --brand-dk: #0284c7;
            --brand-lt: #e0f2fe;
            --success: #10b981;
            --danger: #ef4444;
            --warn: #f59e0b;
        }

        .scope-badge {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            padding: 2px 7px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 600;
            cursor: default;
            white-space: nowrap;
            transition: all .15s;
        }

        .pop-wrap {
            position: relative;
            display: inline-block;
        }

            .pop-wrap .pop-box {
                display: none;
                position: absolute;
                left: 0;
                top: calc(100% + 4px);
                min-width: 200px;
                max-width: 260px;
                background: #fff;
                border: 1px solid #e2e8f0;
                border-radius: 10px;
                box-shadow: 0 10px 30px -8px rgba(0,0,0,.15);
                padding: 6px;
                z-index: 300;
            }

            .pop-wrap:hover .pop-box {
                display: block;
            }

        .pop-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 5px 8px;
            border-radius: 6px;
            font-size: 11px;
            color: #374151;
            gap: 6px;
            transition: background .1s;
        }

            .pop-item:hover {
                background: #f0f9ff;
            }

        .pop-del {
            color: #cbd5e1;
            cursor: pointer;
            border: none;
            background: none;
            padding: 2px;
            line-height: 1;
            border-radius: 4px;
            transition: color .15s;
            flex-shrink: 0;
        }

            .pop-del:hover {
                color: #ef4444;
            }

        .role-tbl {
            border-collapse: separate;
            border-spacing: 0;
            width: 100%;
        }

            .role-tbl thead th {
                position: sticky;
                top: 0;
                z-index: 2;
                background: #f8fafc;
                font-size: 10px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .06em;
                color: #94a3b8;
                padding: 10px 14px;
                border-bottom: 1px solid #e2e8f0;
            }

            .role-tbl tbody td {
                padding: 10px 14px;
                vertical-align: middle;
                font-size: 12px;
            }

            .role-tbl tbody tr {
                border-bottom: 1px solid #f1f5f9;
                transition: background .12s;
            }

                .role-tbl tbody tr:hover {
                    background: #f8fafc;
                }

                .role-tbl tbody tr:last-child {
                    border-bottom: none;
                }

        .rm-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.55);
            backdrop-filter: blur(4px);
            z-index: 1050;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

            .rm-overlay.open {
                display: flex;
            }

        .rm-modal {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 25px 50px -10px rgba(0,0,0,.25);
            display: flex;
            flex-direction: column;
            width: 100%;
            max-width: 500px;
            max-height: calc(100vh - 40px);
            margin: auto;
            overflow: hidden;
            animation: modalIn .2s cubic-bezier(.4,0,.2,1);
        }

        @@keyframes modalIn {
            from {
                opacity: 0;
                transform: scale(.96) translateY(10px);
            }

            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .rm-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 18px;
            flex-shrink: 0;
        }

            .rm-modal-header h3 {
                font-size: 14px;
                font-weight: 700;
                color: #fff;
                display: flex;
                align-items: center;
                gap: 8px;
                margin: 0;
            }

        .rm-modal-close {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            background: rgba(255,255,255,.2);
            border: none;
            color: #fff;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            transition: background .15s;
            flex-shrink: 0;
        }

            .rm-modal-close:hover {
                background: rgba(255,255,255,.3);
            }

        .rm-modal-body {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 18px;
        }

            .rm-modal-body::-webkit-scrollbar {
                width: 4px;
            }

            .rm-modal-body::-webkit-scrollbar-thumb {
                background: #e2e8f0;
                border-radius: 4px;
            }

        .rm-modal-footer {
            padding: 12px 18px;
            border-top: 1px solid #f1f5f9;
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            flex-shrink: 0;
            background: #fafafa;
        }

        .rm-label {
            display: block;
            font-size: 10px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: .06em;
            margin-bottom: 5px;
        }

        .rm-input {
            width: 100%;
            padding: 8px 12px;
            font-size: 12px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            background: #fafafa;
            color: #1e293b;
            outline: none;
            transition: border-color .15s, box-shadow .15s;
        }

            .rm-input:focus {
                border-color: var(--brand);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(14,165,233,.12);
            }

        .mc-list {
            max-height: 120px;
            overflow-y: auto;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            background: #f8fafc;
        }

            .mc-list::-webkit-scrollbar {
                width: 3px;
            }

            .mc-list::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 3px;
            }

        .mc-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 7px 10px;
            font-size: 11px;
            color: #374151;
            cursor: pointer;
            border-bottom: 1px solid #f1f5f9;
            transition: background .1s;
        }

            .mc-item:last-child {
                border-bottom: none;
            }

            .mc-item:hover:not(.mc-disabled) {
                background: #e0f7fd;
            }

            .mc-item.mc-disabled {
                opacity: .6;
                cursor: not-allowed;
            }

            .mc-item input[type=checkbox] {
                accent-color: var(--brand);
                flex-shrink: 0;
            }

            .mc-item .already-tag {
                margin-left: auto;
                font-size: 9px;
                font-weight: 700;
                background: #d1fae5;
                color: #065f46;
                padding: 1px 6px;
                border-radius: 4px;
            }

        .btn-primary {
            padding: 8px 18px;
            font-size: 12px;
            font-weight: 600;
            color: #fff;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            background: linear-gradient(135deg, var(--brand), var(--brand-dk));
            box-shadow: 0 2px 8px rgba(14,165,233,.25);
            transition: all .18s;
        }

            .btn-primary:hover:not(:disabled) {
                opacity: .9;
                transform: translateY(-1px);
            }

            .btn-primary:disabled {
                opacity: .6;
                cursor: not-allowed;
                transform: none;
            }

        .btn-secondary {
            padding: 8px 16px;
            font-size: 12px;
            font-weight: 600;
            color: #475569;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            cursor: pointer;
            transition: all .15s;
        }

            .btn-secondary:hover {
                background: #f8fafc;
                border-color: #cbd5e1;
            }

        .btn-danger {
            padding: 8px 16px;
            font-size: 12px;
            font-weight: 600;
            color: #fff;
            background: linear-gradient(135deg,#ef4444,#dc2626);
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all .15s;
        }

            .btn-danger:hover {
                opacity: .88;
            }

        .btn-sm {
            padding: 4px 10px;
            font-size: 10px;
            font-weight: 700;
            border-radius: 6px;
            cursor: pointer;
            border: none;
            transition: all .15s;
        }

        .role-tab-btn {
            padding: 8px 14px;
            font-size: 11px;
            font-weight: 600;
            border: none;
            background: none;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            color: #94a3b8;
            transition: all .15s;
        }

            .role-tab-btn.active {
                color: var(--brand);
                border-bottom-color: var(--brand);
            }

            .role-tab-btn:hover:not(.active) {
                color: #64748b;
            }

        .perm-tree {
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 10px;
            max-height: 180px;
            overflow-y: auto;
            background: #fafafa;
        }

            .perm-tree::-webkit-scrollbar {
                width: 3px;
            }

            .perm-tree::-webkit-scrollbar-thumb {
                background: #e2e8f0;
                border-radius: 3px;
            }

        .stat-card {
            background: #fff;
            border-radius: 12px;
            border: 1px solid #f1f5f9;
            padding: 14px;
            box-shadow: 0 1px 3px rgba(0,0,0,.05);
            transition: box-shadow .15s;
        }

            .stat-card:hover {
                box-shadow: 0 4px 12px rgba(0,0,0,.08);
            }

        .role-chip {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            padding: 2px 8px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 700;
            border: 1px solid;
        }

        .rm-msg {
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 500;
        }

            .rm-msg.success {
                background: #ecfdf5;
                color: #065f46;
                border: 1px solid #a7f3d0;
            }

            .rm-msg.error {
                background: #fef2f2;
                color: #b91c1c;
                border: 1px solid #fecaca;
            }

        @@media (max-width: 640px) {
            .rm-modal-body {
                padding: 14px;
            }

            .role-tbl {
                font-size: 11px;
            }

                .role-tbl thead th, .role-tbl tbody td {
                    padding: 8px 10px;
                }

            .stat-grid {
                grid-template-columns: repeat(2, 1fr) !important;
            }
        }
    </style>
}

<div class="max-w-7xl mx-auto">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <a href="@Url.Action("Companies", "Companies")"
               class="w-8 h-8 bg-white border border-gray-200 rounded-lg flex items-center justify-center shadow-sm hover:bg-gray-50 transition-colors">
                <i class="fas fa-arrow-left text-gray-500 text-xs"></i>
            </a>
            <div class="w-9 h-9 rounded-xl flex items-center justify-center shadow-sm"
                 style="background:linear-gradient(135deg,#0ea5e9,#0284c7);">
                <i class="fas fa-user-shield text-white text-sm"></i>
            </div>
            <div>
                <h1 class="text-base font-bold text-gray-900 leading-tight">Role Management</h1>
                <p class="text-[11px] text-gray-400">Users, roles &amp; permission assignments</p>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <button onclick="openCreateRoleModal()"
                    class="btn-primary flex items-center gap-1.5 text-xs">
                <i class="fas fa-plus-circle text-[10px]"></i> New Role
            </button>
            <a href="@Url.Action("Register", "Auth")"
               class="btn-sm text-white flex items-center gap-1.5"
               style="background:linear-gradient(135deg,#84cc16,#65a30d);">
                <i class="fas fa-user-plus text-[9px]"></i> Register
            </a>
            <button onclick="openAssignRoleModal()"
                    class="btn-primary flex items-center gap-1.5 text-xs">
                <i class="fas fa-user-tag text-[10px]"></i> Assign Role
            </button>
            <button onclick="openManageRolesListModal()"
                    class="btn-sm text-white flex items-center gap-1.5"
                    style="background:linear-gradient(135deg,#64748b,#475569);">
                <i class="fas fa-tasks text-[9px]"></i> Manage Roles
            </button>
        </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 mb-5 stat-grid" id="roleStatsContainer">
        @for (int s = 0; s < 6; s++)
        {
            <div class="stat-card animate-pulse">
                <div class="h-2 bg-gray-200 rounded w-3/4 mb-2"></div>
                <div class="h-5 bg-gray-200 rounded w-1/3"></div>
            </div>
        }
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-4 py-3 border-b border-gray-100 flex items-center gap-3 flex-wrap">
            <div class="flex-1 min-w-[180px]">
                <!-- Local search removed, using global search -->
            </div>
            <span class="text-xs text-gray-400"><span id="visibleCount">@Model.Count</span> users</span>
        </div>

        <div class="overflow-x-auto" style="max-height:calc(100vh - 340px); overflow-y:auto;">
            <table class="role-tbl">
                <thead>
                    <tr>
                        <th class="text-left">User</th>
                        <th class="text-left">Role</th>
                        <th class="text-left hidden sm:table-cell">Companies</th>
                        <th class="text-left hidden md:table-cell">Groups</th>
                        <th class="text-left hidden lg:table-cell">Locations</th>
                        <th class="text-left hidden xl:table-cell">Devices</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody id="roleTableBody" class="divide-y divide-gray-50">
                    @foreach (var user in Model)
                    {
                        var mappings = user.Mappings ?? new List<ManageEngineWebApp.Dtos.RoleMappingDto>();
                        var companies = mappings.Where(m => m.CompanyId.HasValue).GroupBy(m => m.CompanyId).Select(g => g.First()).ToList();
                        var groups = mappings.Where(m => m.GroupId.HasValue).GroupBy(m => m.GroupId).Select(g => g.First()).ToList();
                        var locations = mappings.Where(m => m.LocationId.HasValue).GroupBy(m => m.LocationId).Select(g => g.First()).ToList();
                        var devices = mappings.Where(m => m.ScopeType == "Device").ToList();

                        <tr data-username="@user.Username?.ToLower()">
                            <td>
                                <div class="flex items-center gap-2.5">
                                    <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-sky-400 to-blue-500 flex items-center justify-center text-white text-[10px] font-bold flex-shrink-0">
                                        @user.Username?.Substring(0, 1).ToUpper()
                                    </div>
                                    <span class="font-semibold text-gray-800 text-xs">@user.Username</span>
                                </div>
                            </td>
                            <td>
                                @if (user.Roles != null && user.Roles.Any())
                                {
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var r in user.Roles)
                                        {
                                            var h = Math.Abs(r.GetHashCode() % 360);
                                            <span class="role-chip"
                                                  style="background:hsl(@h,60%,94%);color:hsl(@h,65%,35%);border-color:hsl(@h,60%,80%)">
                                                @FormatRole(r)
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-gray-300 text-[10px] italic">No role</span>
                                }
                            </td>
                            <td class="hidden sm:table-cell">
                                @if (companies.Any())
                                {
                                    <div class="pop-wrap">
                                        <span class="scope-badge bg-blue-50 text-blue-600 border border-blue-200 cursor-pointer">
                                            <i class="fas fa-building text-[8px]"></i> @companies.Count
                                        </span>
                                        <div class="pop-box">
                                            @{
                                                var uniqueCompanies = mappings.Where(m => m.CompanyId.HasValue).GroupBy(m => new { m.CompanyId, m.CompanyName }).Select(g => g.First());
                                            }
                                            @foreach (var m in uniqueCompanies)
                                            {
                                                <div class="pop-item">
                                                    <span class="truncate flex-1">@(m.CompanyName ?? "N/A")</span>
                                                    <button class="pop-del" title="Remove mapping"
                                                            onclick="deleteMapping(@m.Id,'@user.Username','@m.RoleName','@(m.CompanyName ?? "")')">
                                                        <i class="fas fa-times text-[9px]"></i>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {

                                    <span class="text-gray-200 text-[9px]">—</span>
                                }
                            </td>
                            <td class="hidden md:table-cell">
                                @if (groups.Any())
                                {
                                    <div class="pop-wrap">
                                        <span class="scope-badge bg-orange-50 text-orange-600 border border-orange-200 cursor-pointer">
                                            <i class="fas fa-layer-group text-[8px]"></i> @groups.Count
                                        </span>
                                        <div class="pop-box">
                                            @{
                                                var uniqueGroups = mappings.Where(m => m.GroupId.HasValue).GroupBy(m => new { m.GroupId, m.GroupName }).Select(g => g.First());
                                            }
                                            @foreach (var m in uniqueGroups)
                                            {
                                                <div class="pop-item">
                                                    <span class="truncate flex-1">@(m.GroupName ?? "N/A")</span>
                                                    <button class="pop-del" title="Remove mapping"
                                                            onclick="deleteMapping(@m.Id,'@user.Username','@m.RoleName','@(m.GroupName ?? "")')">
                                                        <i class="fas fa-times text-[9px]"></i>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {

                                    <span class="text-gray-200 text-[9px]">—</span>
                                }
                            </td>
                            <td class="hidden lg:table-cell">
                                @if (locations.Any())
                                {
                                    <div class="pop-wrap">
                                        <span class="scope-badge bg-emerald-50 text-emerald-600 border border-emerald-200 cursor-pointer">
                                            <i class="fas fa-map-marker-alt text-[8px]"></i> @locations.Count
                                        </span>
                                        <div class="pop-box">
                                            @{
                                                var uniqueLocs = mappings.Where(m => m.LocationId.HasValue).GroupBy(m => new { m.LocationId, m.LocationName }).Select(g => g.First());
                                            }
                                            @foreach (var m in uniqueLocs)
                                            {
                                                <div class="pop-item">
                                                    <span class="truncate flex-1">@(m.LocationName ?? "N/A")</span>
                                                    <button class="pop-del" title="Remove mapping"
                                                            onclick="deleteMapping(@m.Id,'@user.Username','@m.RoleName','@(m.LocationName ?? "")')">
                                                        <i class="fas fa-times text-[9px]"></i>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {

                                    <span class="text-gray-200 text-[9px]">—</span>
                                }
                            </td>
                            <td class="hidden xl:table-cell">
                                @if (devices.Any())
                                {
                                    <div class="pop-wrap">
                                        <span class="scope-badge bg-purple-50 text-purple-600 border border-purple-200 cursor-pointer">
                                            <i class="fas fa-desktop text-[8px]"></i> @devices.Count
                                        </span>
                                        <div class="pop-box">
                                            @foreach (var m in devices)
                                            {
                                                <div class="pop-item">
                                                    <span class="truncate flex-1">@(m.ScopeName ?? "N/A")</span>
                                                    <button class="pop-del" title="Remove mapping"
                                                            onclick="deleteMapping(@m.Id,'@user.Username','@m.RoleName','@(m.ScopeName ?? "")')">
                                                        <i class="fas fa-times text-[9px]"></i>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {

                                    <span class="text-gray-200 text-[9px]">—</span>
                                }
                            </td>
                            <td class="text-right whitespace-nowrap">
                                @if (user.Roles == null || !user.Roles.Contains("SuperAdmin"))
                                {
                                    <button onclick="editRole('@user.Username','@(user.Roles?.FirstOrDefault() ?? "")',@(user.CompanyId?.ToString() ?? "null"),'@(user.Mappings?.FirstOrDefault(m => !string.IsNullOrEmpty(m.ScopeName))?.ScopeName ?? "")')"
                                            class="btn-sm text-white mr-1"
                                            style="background:linear-gradient(135deg,#0ea5e9,#0284c7);">
                                        <i class="fas fa-edit text-[9px] mr-0.5"></i>Edit
                                    </button>
                                    <button onclick="removeUserRole('@user.Username','@(user.Roles?.FirstOrDefault() ?? "")')"
                                            class="btn-sm text-white"
                                            style="background:linear-gradient(135deg,#ef4444,#dc2626);">
                                        <i class="fas fa-trash text-[9px] mr-0.5"></i>Remove
                                    </button>
                                }
                                else
                                {
                                    <span class="text-gray-300 text-[10px] italic flex items-center justify-end gap-1">
                                        <i class="fas fa-lock text-[9px]"></i> Protected
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<div id="assignRoleModal" class="rm-overlay" role="dialog" aria-modal="true" aria-labelledby="assignRoleTitle">
    <div class="rm-modal" style="max-width:460px;">
        <div class="rm-modal-header" style="background:linear-gradient(135deg,#0ea5e9,#0284c7);">
            <h3 id="assignRoleTitle"><i class="fas fa-user-tag"></i> Assign Role to User</h3>
            <button class="rm-modal-close" onclick="closeAssignRoleModal()" aria-label="Close">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="rm-modal-body">
            <div class="mb-4">
                <label class="rm-label">Username *</label>
                <input type="text" id="assignUsername" class="rm-input" placeholder="Enter username" autocomplete="off">
            </div>
            <div class="mb-4">
                <label class="rm-label">Role *</label>
                <select id="assignRole" class="rm-input">
                    <option value="">Loading roles…</option>
                </select>
            </div>

            <div id="companySelectDiv" class="mb-4 hidden">
                <label class="rm-label">Companies <span class="text-sky-500 font-normal normal-case ml-1">(select multiple)</span></label>
                <div class="relative mb-1.5">
                    <input type="text" placeholder="Filter companies…"
                           class="rm-input py-1.5 text-xs"
                           oninput="filterList('companyList',this.value)">
                </div>
                <div id="companyList" class="mc-list">
                    <div class="mc-item text-gray-400">Loading companies...</div>
                </div>
            </div>
            <input type="hidden" id="companyIdHidden" value="">
            <div id="groupSelectDiv" class="mb-4 hidden">
                <label class="rm-label">Groups <span class="text-sky-500 font-normal normal-case ml-1">(select multiple)</span></label>
                <div class="relative mb-1.5">
                    <input type="text" placeholder="Filter groups…"
                           class="rm-input py-1.5 text-xs"
                           oninput="filterList('groupList',this.value)">
                </div>
                <div id="groupList" class="mc-list">
                    <div class="mc-item text-gray-400">Select a company first</div>
                </div>
            </div>

            <div id="locationSelectDiv" class="mb-4 hidden">
                <label class="rm-label">Locations <span class="text-sky-500 font-normal normal-case ml-1">(select multiple)</span></label>
                <div class="relative mb-1.5">
                    <input type="text" placeholder="Filter locations…"
                           class="rm-input py-1.5 text-xs"
                           oninput="filterList('locationList',this.value)">
                </div>
                <div id="locationList" class="mc-list">
                    <div class="mc-item text-gray-400">Select a group first</div>
                </div>
            </div>

            <div id="domainSelectDiv" class="mb-4 hidden">
                <label class="rm-label">Devices <span class="text-sky-500 font-normal normal-case ml-1">(select multiple, or leave blank for all)</span></label>
                <div class="relative mb-1.5">
                    <input type="text" placeholder="Filter devices…"
                           class="rm-input py-1.5 text-xs"
                           oninput="filterList('domainList',this.value)">
                </div>
                <div id="domainList" class="mc-list">
                    <div class="mc-item text-gray-400">Select location first</div>
                </div>
            </div>

            <div id="assignMessage" class="rm-msg hidden mt-2"></div>
        </div>
        <div class="rm-modal-footer">
            <button onclick="closeAssignRoleModal()" class="btn-secondary">Cancel</button>
            <button onclick="submitAssignRole()" id="assignRoleBtn" class="btn-primary">
                <i class="fas fa-check mr-1.5 text-[10px]"></i>Assign Role
            </button>
        </div>
    </div>
</div>


