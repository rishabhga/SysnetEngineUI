@model ManageEngineWebApp.ViewModels.ResetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Reset Password</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body {
            background: linear-gradient(135deg,#0f2347,#1a3c6e,#1e5799);
            font-family: 'Segoe UI',system-ui,sans-serif;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">

    <div class="bg-white rounded-2xl w-full max-w-md p-10 shadow-[0_20px_60px_rgba(0,0,0,0.35)] relative overflow-hidden">
        
        <div class="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-[#00BCEB] to-[#0096BE]"></div>

        <div class="text-center mb-6">
            <div class="w-16 h-16 bg-gradient-to-br from-[#1a3c6e] to-[#2a5c9e] rounded-full inline-flex items-center justify-center mb-4 shadow-lg">
                <i class="fa fa-key text-white text-2xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-[#1a3c6e] mb-2">Create New Password</h2>
            <p class="text-gray-500 text-sm">Please set a strong password for your account.</p>
        </div>

        @if (TempData["SuccessMsg"] != null)
        {
            <div class="mb-6 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl flex items-start gap-3 shadow-sm">
                <i class="fa fa-circle-check mt-0.5 text-green-500"></i>
                <div class="text-sm font-medium">@TempData["SuccessMsg"]</div>
            </div>
            
            <div class="mt-6 text-center">
                <a href="/Auth/Login" class="inline-block text-sm font-semibold text-[#1a3c6e] hover:text-[#00BCEB] transition-colors">
                    <i class="fa fa-arrow-left mr-1"></i> Go to Login
                </a>
            </div>
        }
        else
        {
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl flex items-start gap-3 shadow-sm">
                    <i class="fa fa-triangle-exclamation mt-0.5 text-red-500"></i>
                    <div class="text-sm">@Html.ValidationSummary(false)</div>
                </div>
            }

            <form method="post" id="rpForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />

                <div class="mb-4">
                    <label asp-for="Password" class="block text-sm font-semibold text-gray-700 mb-2"></label>
                    <div class="relative flex">
                        <span class="inline-flex items-center px-4 py-3 rounded-l-xl border border-r-0 border-gray-300 bg-gray-50 text-gray-400">
                            <i class="fa fa-lock"></i>
                        </span>
                        <input asp-for="Password" type="password" class="flex-1 min-w-0 block w-full px-3 py-3 rounded-none border border-gray-300 focus:ring-2 focus:ring-[#00BCEB] focus:border-[#00BCEB] text-sm transition-all" id="newPw" placeholder="Min 8 characters" required />
                        <button class="inline-flex items-center px-4 rounded-r-xl border border-l-0 border-gray-300 bg-white text-gray-400 hover:text-gray-600 hover:bg-gray-50 transition-colors" type="button" onclick="tog('newPw',this)">
                            <i class="fa fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-red-500 text-xs mt-1.5 block"></span>
                </div>
                
                <div class="w-full bg-gray-200 rounded-full h-1.5 mb-1 mt-2">
                    <div class="h-1.5 rounded-full transition-all duration-300" id="sBar" style="width:0; background-color: transparent;"></div>
                </div>
                <small id="sTxt" class="block mb-4 text-xs font-medium h-4"></small>

                <div class="mb-6">
                    <label asp-for="ConfirmPassword" class="block text-sm font-semibold text-gray-700 mb-2"></label>
                    <div class="relative flex">
                        <span class="inline-flex items-center px-4 py-3 rounded-l-xl border border-r-0 border-gray-300 bg-gray-50 text-gray-400">
                            <i class="fa fa-lock-open"></i>
                        </span>
                        <input asp-for="ConfirmPassword" type="password" class="flex-1 min-w-0 block w-full px-3 py-3 rounded-none border border-gray-300 focus:ring-2 focus:ring-[#00BCEB] focus:border-[#00BCEB] text-sm transition-all" id="conPw" placeholder="Confirm your new password" required />
                        <button class="inline-flex items-center px-4 rounded-r-xl border border-l-0 border-gray-300 bg-white text-gray-400 hover:text-gray-600 hover:bg-gray-50 transition-colors" type="button" onclick="tog('conPw',this)">
                            <i class="fa fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs mt-1.5 block"></span>
                    <div id="matchMsg" class="text-xs mt-1.5 font-medium h-4"></div>
                </div>
                
                <div class="bg-gray-50 rounded-xl border border-gray-200 mb-6 p-4 shadow-sm">
                    <p class="mb-2 font-semibold text-gray-600 text-sm flex items-center">
                        <i class="fa fa-shield-halved mr-2"></i>Requirements
                    </p>
                    <ul class="text-xs text-gray-500 space-y-1 ml-6 list-disc marker:text-gray-400">
                        <li id="r1" class="transition-colors duration-200">At least 8 characters</li>
                        <li id="r2" class="transition-colors duration-200">One uppercase letter</li>
                        <li id="r3" class="transition-colors duration-200">One number</li>
                        <li id="r4" class="transition-colors duration-200">One special character</li>
                    </ul>
                </div>

                <button type="submit" class="w-full bg-gradient-to-r from-[#1a3c6e] to-[#2a5c9e] hover:from-[#153058] hover:to-[#1a3c6e] text-white font-bold py-3 px-4 rounded-xl shadow-md transition-all flex justify-center items-center gap-2 mb-4" id="btnSubmit">
                    <i class="fa fa-floppy-disk"></i> Reset Password
                </button>
            </form>
        }
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function tog(id,btn){
            const i=document.getElementById(id);
            i.type=i.type==='password'?'text':'password';
            btn.querySelector('i').className=i.type==='text'?'fa fa-eye-slash text-gray-600':'fa fa-eye text-gray-400';
        }
        
        const pw=document.getElementById('newPw'),cpw=document.getElementById('conPw');
        const cols=['transparent','#ef4444','#f97316','#eab308','#22c55e'];
        
        pw?.addEventListener('input',()=>{
          const v=pw.value;
          const c=[v.length>=8,/[A-Z]/.test(v),/[0-9]/.test(v),/[^A-Za-z0-9]/.test(v)];
          const s=c.filter(Boolean).length;
          
          document.getElementById('sBar').style.cssText=`width:${s*25}%;background-color:${cols[s]}`;
          document.getElementById('sTxt').textContent=['','Weak','Fair','Good','Strong'][s];
          document.getElementById('sTxt').style.color=cols[s] !== 'transparent' ? cols[s] : '';
          
          ['r1','r2','r3','r4'].forEach((id,i)=>{
            const el = document.getElementById(id);
            if(c[i]){
                el.classList.add('text-green-600', 'font-medium');
                el.classList.remove('text-gray-500');
            } else {
                el.classList.remove('text-green-600', 'font-medium');
                el.classList.add('text-gray-500');
            }
          });
          checkMatch();
        });
        
        cpw?.addEventListener('input',checkMatch);
        
        function checkMatch(){
          const m=document.getElementById('matchMsg');
          if(!cpw.value){m.textContent='';return;}
          if(pw.value===cpw.value){
              m.innerHTML='<span class="text-green-600"><i class="fa fa-check mr-1"></i> Passwords match</span>';
          }else{
              m.innerHTML='<span class="text-red-500"><i class="fa fa-xmark mr-1"></i> Passwords do not match</span>';
          }
        }

        document.getElementById('rpForm')?.addEventListener('submit', function (e) {
            if ($(this).valid()) {
                const btn = document.getElementById('btnSubmit');
                btn.innerHTML = '<i class="fa fa-spinner fa-spin mr-2"></i> Resetting...';
                btn.style.opacity = '0.8';
                btn.style.pointerEvents = 'none';
            }
        });
    </script>
</body>
</html>
