@{
    ViewData["Title"] = "Company Email Configuration";
}

<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-2">
        <h1 class="text-base font-bold text-gray-900 flex items-center gap-1.5">
            <i class="fa fa-envelope-open-text text-cyan-500 text-sm"></i> Company Email Configuration
        </h1>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-4">

    @* Form *@
    <div class="lg:col-span-4">
        <div class="bg-white rounded-md shadow-sm border border-gray-200">
            <div class="px-4 py-3 border-b border-gray-100 bg-gray-50">
                <h6 class="text-gray-800 font-semibold text-sm flex items-center mb-0">
                    <i class="fa fa-gear text-cyan-500 mr-2 text-xs"></i>SMTP Settings
                </h6>
            </div>
            <div class="p-4">
                
                <div id="formAlert" class="hidden mb-4 p-3 rounded-lg flex items-center gap-2 text-sm font-medium"></div>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Company <span class="text-red-400">*</span></label>
                    <select id="selCompany" class="w-full rounded-lg border-gray-300 border px-3 py-2 text-sm focus:ring-[#00BCEB] focus:border-[#00BCEB] outline-none transition" onchange="loadConfig(this.value)">
                        <option value="">- Select Company -</option>
                        @if (ViewBag.Companies != null)
                        {
                            foreach (var company in ViewBag.Companies)
                            {
                                <option value="@company.id">@company.companyName</option>
                            }
                        }
                    </select>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-semibold text-gray-700 mb-1">SMTP Host <span class="text-red-400">*</span></label>
                        <input type="text" id="smtpHost" class="w-full rounded border-gray-300 border px-3 py-1.5 text-xs focus:ring-[#00BCEB] focus:border-[#00BCEB] outline-none transition" placeholder="smtp.gmail.com" />
                    </div>
                    <div class="sm:col-span-1">
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Port <span class="text-red-400">*</span></label>
                        <input type="number" id="smtpPort" class="w-full rounded border-gray-300 border px-3 py-1.5 text-xs focus:ring-[#00BCEB] focus:border-[#00BCEB] outline-none transition" value="587" />
                    </div>
                </div>

                <div class="mb-4 flex items-center">
                    <input type="checkbox" id="enableSsl" class="w-4 h-4 text-[#00BCEB] bg-gray-100 border-gray-300 rounded focus:ring-[#00BCEB] focus:ring-2 cursor-pointer" checked>
                    <label for="enableSsl" class="ml-2 text-sm font-semibold text-gray-700 cursor-pointer">Enable SSL / TLS</label>
                </div>

                <div class="mb-4">
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Sender Email <span class="text-red-400">*</span></label>
                    <input type="email" id="senderEmail" class="w-full rounded border-gray-300 border px-3 py-1.5 text-xs focus:ring-[#00BCEB] focus:border-[#00BCEB] outline-none transition" placeholder="noreply@company.com" />
                </div>

                <div class="mb-4">
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Sender Display Name</label>
                    <input type="text" id="senderName" class="w-full rounded border-gray-300 border px-3 py-1.5 text-xs focus:ring-[#00BCEB] focus:border-[#00BCEB] outline-none transition" placeholder="IT Support" />
                </div>

                <div class="mb-4">
                    <label class="block text-xs font-semibold text-gray-700 mb-1">SMTP Username <span class="text-red-400">*</span></label>
                    <input type="text" id="smtpUsername" class="w-full rounded border-gray-300 border px-3 py-1.5 text-xs focus:ring-[#00BCEB] focus:border-[#00BCEB] outline-none transition" placeholder="smtp-user@company.com" />
                </div>

                <div class="mb-4">
                    <label class="block text-xs font-semibold text-gray-700 mb-1">SMTP Password</label>
                    <div class="relative">
                        <input type="password" id="smtpPassword" class="w-full rounded border-gray-300 border px-3 py-1.5 pr-8 text-xs focus:ring-[#00BCEB] focus:border-[#00BCEB] outline-none transition" placeholder="Leave blank to keep existing" />
                        <button type="button" onclick="togPw()" class="absolute inset-y-0 right-0 pr-2 flex items-center text-gray-400 hover:text-gray-600">
                            <i class="fa fa-eye text-xs" id="pwEye"></i>
                        </button>
                    </div>
                    <p class="text-xs text-gray-500 mt-1">Leave blank when editing to keep the stored password.</p>
                </div>

                <div class="flex gap-2 mt-2">
                    <button id="btnSave" onclick="saveConfig()" class="flex-1 text-white rounded-md text-xs font-semibold py-1.5 px-3 shadow-sm transition-all flex items-center justify-center gap-1.5 hover:shadow-md disabled:opacity-50 disabled:cursor-not-allowed" style="background:linear-gradient(135deg,#00BCEB,#0096BE)">
                        <i class="fa fa-floppy-disk text-[10px]"></i> Save
                    </button>
                    <button id="btnTest" onclick="openTestModal()" class="bg-white hover:bg-gray-50 text-gray-700 text-xs font-semibold py-1.5 px-3 rounded-md shadow-sm border border-gray-200 transition-all flex items-center gap-1.5 disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fa fa-paper-plane text-[10px]"></i> Test
                    </button>
                    <button onclick="clearForm()" class="bg-white hover:bg-gray-50 text-gray-500 text-xs font-semibold py-1.5 px-3 rounded-md shadow-sm border border-gray-200 transition-all flex items-center gap-1.5" title="Clear form">
                        <i class="fa fa-eraser text-[10px]"></i>
                    </button>
                </div>

            </div>
        </div>
    </div>

    @* Table *@
    <div class="lg:col-span-8">
        <div class="bg-white rounded-md shadow-sm border border-gray-200">
            <div class="px-4 py-3 border-b border-gray-100 bg-gray-50">
                <h6 class="text-gray-800 font-semibold text-sm flex items-center mb-0">
                    <i class="fa fa-list text-cyan-500 mr-2 text-xs"></i>Configured Companies
                </h6>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left text-gray-600">
                    <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th scope="col" class="px-4 py-3 font-semibold">Company</th>
                            <th scope="col" class="px-4 py-3 font-semibold">Host</th>
                            <th scope="col" class="px-4 py-3 font-semibold">Port</th>
                            <th scope="col" class="px-4 py-3 font-semibold">Sender</th>
                            <th scope="col" class="px-4 py-3 font-semibold text-center">Status</th>
                            <th scope="col" class="px-4 py-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="configTbody" class="divide-y divide-gray-100">
                        <tr>
                            <td colspan="6" class="px-4 py-8 text-center text-gray-500">
                                <i class="fa fa-spinner fa-spin mr-2"></i>Loading...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@* Test email modal *@
<div id="testModal" class="fixed inset-0 z-50 hidden bg-gray-900 bg-opacity-50 flex items-center justify-center backdrop-blur-sm transition-opacity">
    <div class="bg-white rounded-md shadow-xl max-w-sm w-full mx-4 overflow-hidden transform scale-95 transition-transform" id="testModalContent">
        <div class="flex items-center justify-between px-3 py-2.5 border-b border-gray-100 bg-gray-50">
            <h6 class="font-semibold text-gray-800 text-sm m-0">Send Test Email</h6>
            <button type="button" onclick="closeTestModal()" class="text-gray-400 hover:text-gray-600 focus:outline-none">
                <i class="fa fa-xmark"></i>
            </button>
        </div>
        <div class="p-4">
            <label class="block text-xs font-semibold text-gray-700 mb-1">Recipient Email <span class="text-red-400">*</span></label>
            <input type="email" id="testEmail" class="w-full rounded border-gray-300 border px-3 py-1.5 text-xs focus:ring-[#00BCEB] focus:border-[#00BCEB] outline-none transition" placeholder="admin@company.com" />
            <p id="testEmailError" class="text-xs text-red-500 mt-1 hidden">Please enter a valid email address.</p>
        </div>
        <div class="px-3 py-2 border-t border-gray-100 bg-gray-50 flex justify-end gap-2">
            <button onclick="closeTestModal()" class="px-3 py-1.5 text-xs font-medium text-gray-600 bg-white border border-gray-300 rounded hover:bg-gray-50 transition">Cancel</button>
            <button id="btnSendTest" onclick="sendTest()" class="px-3 py-1.5 text-xs font-medium text-white rounded shadow-sm hover:shadow transition disabled:opacity-50 disabled:cursor-not-allowed" style="background:linear-gradient(135deg,#00BCEB,#0096BE)">
                <i class="fa fa-paper-plane text-[10px] mr-1"></i>Send
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── Robust API wrapper with proper error handling ──
        async function api(url, opts = {}) {
            try {
                const res = await fetch(url, {
                    headers: { 'Content-Type': 'application/json' },
                    ...opts
                });

                const text = await res.text();
                let data;
                try { data = JSON.parse(text); } catch { data = { message: text }; }

                if (!res.ok) {
                    return {
                        success: false,
                        message: data.message || data.title || `Server error (${res.status})`
                    };
                }
                return data;
            } catch (err) {
                console.error('API call failed:', err);
                return { success: false, message: 'Network error — could not reach the server.' };
            }
        }

        // ── Alert system ──
        let alertTimer = null;
        function showAlert(msg, isSuccess) {
            const el = document.getElementById('formAlert');
            if (alertTimer) clearTimeout(alertTimer);

            el.classList.remove('hidden', 'bg-red-50', 'text-red-700', 'border-red-200',
                                'bg-green-50', 'text-green-700', 'border-green-200',
                                'bg-amber-50', 'text-amber-700', 'border-amber-200');
            
            if (isSuccess) {
                el.classList.add('bg-green-50', 'text-green-700', 'border', 'border-green-200');
                el.innerHTML = '<i class="fa fa-circle-check text-green-500"></i><span>' + msg + '</span>';
            } else {
                el.classList.add('bg-red-50', 'text-red-700', 'border', 'border-red-200');
                el.innerHTML = '<i class="fa fa-triangle-exclamation text-red-500"></i><span>' + msg + '</span>';
            }
            
            alertTimer = setTimeout(() => el.classList.add('hidden'), 8000);
        }

        // ── Button loading helpers ──
        function setButtonLoading(btn, loading, originalHtml) {
            if (!btn) return;
            if (loading) {
                btn._origHtml = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fa fa-spinner fa-spin text-[10px]"></i> Please wait...';
            } else {
                btn.disabled = false;
                btn.innerHTML = originalHtml || btn._origHtml || 'Submit';
            }
        }

        // ── Load all configs into table ──
        async function loadAll() {
            try {
                const data = await api('/Auth/api/CompanyEmailConfig');
                const tbody = document.getElementById('configTbody');

                if (!Array.isArray(data) || !data.length) {
                    tbody.innerHTML = `<tr><td colspan="6" class="px-4 py-8 text-center text-gray-400">
                        <i class="fa fa-inbox text-2xl mb-2 block"></i>No email configurations found.<br>
                        <span class="text-xs">Select a company and fill in the SMTP details to get started.</span>
                    </td></tr>`;
                    return;
                }

                tbody.innerHTML = data.map(r => `
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-3 font-medium text-gray-800">${r.companyName || '-'}</td>
                        <td class="px-4 py-3 text-gray-600 font-mono text-xs">${r.smtpHost || '-'}</td>
                        <td class="px-4 py-3 text-gray-600">${r.smtpPort || '-'}</td>
                        <td class="px-4 py-3 text-gray-600 text-xs">${r.senderEmail || '-'}</td>
                        <td class="px-4 py-3 text-center">
                            <span class="px-2 py-1 text-[10px] font-bold uppercase tracking-wide rounded-full ${r.isActive ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600'}">
                                ${r.isActive ? 'Active' : 'Off'}
                            </span>
                        </td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex items-center justify-end gap-1">
                                <button class="text-[#00BCEB] hover:text-[#0096BE] p-1 transition-colors" onclick="editRow(${r.companyId})" title="Edit">
                                    <i class="fa fa-pen text-xs"></i>
                                </button>
                                <button class="text-gray-400 hover:text-red-500 p-1 transition-colors" onclick="deleteConfig(${r.companyId}, '${(r.companyName || '').replace(/'/g, "\\'")}')" title="Delete">
                                    <i class="fa fa-trash text-xs"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `).join('');
            } catch (e) {
                console.error('Failed to load configs', e);
                document.getElementById('configTbody').innerHTML = '<tr><td colspan="6" class="px-4 py-8 text-center text-red-500"><i class="fa fa-triangle-exclamation mr-1"></i>Error loading configurations.</td></tr>';
            }
        }

        // ── Load a specific company config into the form ──
        async function loadConfig(companyId) {
            if (!companyId) { clearForm(true); return; }
            try {
                const d = await api('/Auth/api/CompanyEmailConfig/' + companyId);
                if (d && d.id) {
                    document.getElementById('smtpHost').value     = d.smtpHost || '';
                    document.getElementById('smtpPort').value     = d.smtpPort || 587;
                    document.getElementById('enableSsl').checked  = d.enableSsl !== false;
                    document.getElementById('senderEmail').value  = d.senderEmail || '';
                    document.getElementById('senderName').value   = d.senderName || '';
                    document.getElementById('smtpUsername').value  = d.smtpUsername || '';
                    document.getElementById('smtpPassword').value = '';
                } else {
                    // New config for this company — clear fields but keep company selected
                    clearForm(true);
                }
            } catch (e) {
                console.error('Failed to load config', e);
            }
        }

        // ── Edit row from table ──
        function editRow(companyId) {
            document.getElementById('selCompany').value = companyId;
            loadConfig(companyId);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ── Clear form ──
        function clearForm(keepCompany) {
            if (!keepCompany) document.getElementById('selCompany').value = '';
            document.getElementById('smtpHost').value     = '';
            document.getElementById('smtpPort').value     = '587';
            document.getElementById('enableSsl').checked  = true;
            document.getElementById('senderEmail').value  = '';
            document.getElementById('senderName').value   = '';
            document.getElementById('smtpUsername').value  = '';
            document.getElementById('smtpPassword').value = '';
        }

        // ── Validate form ──
        function validateForm() {
            const companyId    = document.getElementById('selCompany').value;
            const smtpHost     = document.getElementById('smtpHost').value.trim();
            const smtpPort     = document.getElementById('smtpPort').value;
            const senderEmail  = document.getElementById('senderEmail').value.trim();
            const smtpUsername  = document.getElementById('smtpUsername').value.trim();

            if (!companyId)    { showAlert('Please select a company.', false); return false; }
            if (!smtpHost)     { showAlert('SMTP Host is required.', false); return false; }
            if (!smtpPort || parseInt(smtpPort) <= 0) { showAlert('Please enter a valid port number.', false); return false; }
            if (!senderEmail)  { showAlert('Sender Email is required.', false); return false; }
            if (!smtpUsername)  { showAlert('SMTP Username is required.', false); return false; }
            return true;
        }

        // ── Save config ──
        async function saveConfig() {
            if (!validateForm()) return;

            const btn = document.getElementById('btnSave');
            const origHtml = btn.innerHTML;
            setButtonLoading(btn, true);

            const pw = document.getElementById('smtpPassword').value;
            const body = {
                companyId:    parseInt(document.getElementById('selCompany').value),
                smtpHost:     document.getElementById('smtpHost').value.trim(),
                smtpPort:     parseInt(document.getElementById('smtpPort').value),
                enableSsl:    document.getElementById('enableSsl').checked,
                senderEmail:  document.getElementById('senderEmail').value.trim(),
                senderName:   document.getElementById('senderName').value.trim(),
                smtpUsername:  document.getElementById('smtpUsername').value.trim(),
                smtpPassword: pw || '__KEEP__'  
            };

            const res = await api('/Auth/api/CompanyEmailConfig', {
                method: 'POST',
                body: JSON.stringify(body)
            });
            
            setButtonLoading(btn, false, origHtml);
            showAlert(res.message || (res.success ? 'Configuration saved successfully.' : 'Failed to save configuration.'), res.success);
            if (res.success) loadAll();
        }

        // ── Delete config ──
        async function deleteConfig(companyId, companyName) {
            if (!confirm(`Are you sure you want to delete the email configuration for "${companyName}"?\n\nThis action cannot be undone.`)) return;

            const res = await api('/Auth/api/CompanyEmailConfig/delete/' + companyId, {
                method: 'POST'
            });
            
            if (res.success) {
                showAlert(`Configuration for "${companyName}" deleted successfully.`, true);
                loadAll();
                // If the deleted company was selected in form, clear it
                if (document.getElementById('selCompany').value == companyId) {
                    clearForm();
                }
            } else {
                showAlert(res.message || 'Failed to delete configuration.', false);
            }
        }

        // ── Test email modal ──
        function openTestModal() {
            if (!document.getElementById('selCompany').value) {
                showAlert('Select a company first to test its configuration.', false);
                return;
            }
            document.getElementById('testEmail').value = '';
            document.getElementById('testEmailError').classList.add('hidden');
            const modal = document.getElementById('testModal');
            const content = document.getElementById('testModalContent');
            modal.classList.remove('hidden');
            setTimeout(() => {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            }, 10);
            // Focus the email input
            setTimeout(() => document.getElementById('testEmail').focus(), 100);
        }

        function closeTestModal() {
            const modal = document.getElementById('testModal');
            const content = document.getElementById('testModalContent');
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
            setTimeout(() => modal.classList.add('hidden'), 200);
        }

        async function sendTest() {
            const companyId = document.getElementById('selCompany').value;
            const toEmail = document.getElementById('testEmail').value.trim();
            const errEl = document.getElementById('testEmailError');
            
            // Validate email
            if (!toEmail || !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(toEmail)) {
                errEl.classList.remove('hidden');
                document.getElementById('testEmail').focus();
                return;
            }
            errEl.classList.add('hidden');

            const btn = document.getElementById('btnSendTest');
            const origHtml = btn.innerHTML;
            setButtonLoading(btn, true);

            const res = await api('/Auth/api/CompanyEmailConfig/test/' + companyId, {
                method: 'POST',
                body: JSON.stringify({ toEmail: toEmail })
            });
            
            setButtonLoading(btn, false, origHtml);
            closeTestModal();

            if (res.success) {
                showAlert(res.message || `Test email sent successfully to ${toEmail}!`, true);
            } else {
                showAlert(res.message || 'Failed to send test email. Check your SMTP settings.', false);
            }
        }

        // ── Toggle password visibility ──
        function togPw() {
            const inp = document.getElementById('smtpPassword');
            inp.type = inp.type === 'password' ? 'text' : 'password';
            document.getElementById('pwEye').className = inp.type === 'text' ? 'fa fa-eye-slash text-xs' : 'fa fa-eye text-xs';
        }

        // ── Allow Enter key to submit test email ──
        document.addEventListener("DOMContentLoaded", () => {
            loadAll();

            document.getElementById('testEmail')?.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') { e.preventDefault(); sendTest(); }
            });
        });
    </script>
}
