@{
    ViewData["Title"] = "Company Email Configuration";
}

<div class="mb-6 flex items-center gap-3">
    <i class="fa fa-envelope-open-text text-2xl text-[#1a3c6e]"></i>
    <h4 class="text-xl font-bold text-[#1a3c6e] mb-0">Company Email Configuration</h4>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

    @* Form *@
    <div class="lg:col-span-5">
        <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100">
            <div class="bg-gradient-to-r from-[#1a3c6e] to-[#2a5c9e] px-4 py-3 border-b border-gray-200">
                <h6 class="text-white font-semibold flex items-center mb-0">
                    <i class="fa fa-gear mr-2"></i>SMTP Settings
                </h6>
            </div>
            <div class="p-6">
                
                <div id="formAlert" class="hidden mb-4 p-3 rounded-lg flex items-center gap-2 text-sm font-medium"></div>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Company</label>
                    <select id="selCompany" class="w-full rounded-lg border-gray-300 border px-3 py-2 text-sm focus:ring-[#00BCEB] focus:border-[#00BCEB] outline-none transition" onchange="loadConfig(this.value)">
                        <option value="">- Select Company -</option>
                        @if (ViewBag.Companies != null)
                        {
                            foreach (var company in ViewBag.Companies)
                            {
                                <option value="@company.id">@company.companyName</option>
                            }
                        }
                    </select>
                </div>

                <div class="grid grid-cols-3 gap-4 mb-4">
                    <div class="col-span-2">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">SMTP Host</label>
                        <input type="text" id="smtpHost" class="w-full rounded-lg border-gray-300 border px-3 py-2 text-sm focus:ring-[#00BCEB] focus:border-[#00BCEB] outline-none transition" placeholder="smtp.gmail.com" />
                    </div>
                    <div class="col-span-1">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Port</label>
                        <input type="number" id="smtpPort" class="w-full rounded-lg border-gray-300 border px-3 py-2 text-sm focus:ring-[#00BCEB] focus:border-[#00BCEB] outline-none transition" value="587" />
                    </div>
                </div>

                <div class="mb-4 flex items-center">
                    <input type="checkbox" id="enableSsl" class="w-4 h-4 text-[#00BCEB] bg-gray-100 border-gray-300 rounded focus:ring-[#00BCEB] focus:ring-2 cursor-pointer" checked>
                    <label for="enableSsl" class="ml-2 text-sm font-semibold text-gray-700 cursor-pointer">Enable SSL / TLS</label>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Sender Email</label>
                    <input type="email" id="senderEmail" class="w-full rounded-lg border-gray-300 border px-3 py-2 text-sm focus:ring-[#00BCEB] focus:border-[#00BCEB] outline-none transition" placeholder="noreply@company.com" />
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Sender Display Name</label>
                    <input type="text" id="senderName" class="w-full rounded-lg border-gray-300 border px-3 py-2 text-sm focus:ring-[#00BCEB] focus:border-[#00BCEB] outline-none transition" placeholder="IT Support" />
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">SMTP Username</label>
                    <input type="text" id="smtpUsername" class="w-full rounded-lg border-gray-300 border px-3 py-2 text-sm focus:ring-[#00BCEB] focus:border-[#00BCEB] outline-none transition" placeholder="smtp-user@company.com" />
                </div>

                <div class="mb-5">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">SMTP Password</label>
                    <div class="relative">
                        <input type="password" id="smtpPassword" class="w-full rounded-lg border-gray-300 border px-3 py-2 pr-10 text-sm focus:ring-[#00BCEB] focus:border-[#00BCEB] outline-none transition" placeholder="Leave blank to keep existing" />
                        <button type="button" onclick="togPw()" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600">
                            <i class="fa fa-eye" id="pwEye"></i>
                        </button>
                    </div>
                    <p class="text-xs text-gray-500 mt-1">Leave blank when editing to keep the stored password.</p>
                </div>

                <div class="flex gap-3">
                    <button onclick="saveConfig()" class="flex-1 bg-gradient-to-r from-[#00BCEB] to-[#0096BE] text-white font-semibold py-2 px-4 rounded-lg shadow hover:shadow-md transition-all flex items-center justify-center gap-2">
                        <i class="fa fa-floppy-disk"></i> Save
                    </button>
                    <button onclick="openTestModal()" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2 px-4 rounded-lg shadow-sm border border-gray-200 transition-all flex items-center gap-2">
                        <i class="fa fa-paper-plane"></i> Test
                    </button>
                </div>

            </div>
        </div>
    </div>

    @* Table *@
    <div class="lg:col-span-7">
        <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100">
            <div class="bg-gradient-to-r from-[#1a3c6e] to-[#2a5c9e] px-4 py-3 border-b border-gray-200">
                <h6 class="text-white font-semibold flex items-center mb-0">
                    <i class="fa fa-list mr-2"></i>Configured Companies
                </h6>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left text-gray-600">
                    <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th scope="col" class="px-4 py-3 font-semibold">Company</th>
                            <th scope="col" class="px-4 py-3 font-semibold">Host</th>
                            <th scope="col" class="px-4 py-3 font-semibold">Port</th>
                            <th scope="col" class="px-4 py-3 font-semibold">Sender</th>
                            <th scope="col" class="px-4 py-3 font-semibold text-center">Status</th>
                            <th scope="col" class="px-4 py-3 text-right"></th>
                        </tr>
                    </thead>
                    <tbody id="configTbody" class="divide-y divide-gray-100">
                        <tr>
                            <td colspan="6" class="px-4 py-8 text-center text-gray-500">
                                <i class="fa fa-spinner fa-spin mr-2"></i>Loading...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@* Test email modal *@
<div id="testModal" class="fixed inset-0 z-50 hidden bg-gray-900 bg-opacity-50 flex items-center justify-center backdrop-blur-sm transition-opacity">
    <div class="bg-white rounded-xl shadow-xl max-w-sm w-full mx-4 overflow-hidden transform scale-95 transition-transform" id="testModalContent">
        <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100 bg-gray-50">
            <h6 class="font-semibold text-gray-800 m-0">Send Test Email</h6>
            <button type="button" onclick="closeTestModal()" class="text-gray-400 hover:text-gray-600 focus:outline-none">
                <i class="fa fa-xmark text-lg"></i>
            </button>
        </div>
        <div class="p-4">
            <label class="block text-sm font-semibold text-gray-700 mb-1">Recipient Email</label>
            <input type="email" id="testEmail" class="w-full rounded-lg border-gray-300 border px-3 py-2 text-sm focus:ring-[#00BCEB] focus:border-[#00BCEB] outline-none transition" placeholder="admin@company.com" />
        </div>
        <div class="px-4 py-3 border-t border-gray-100 bg-gray-50 flex justify-end gap-2">
            <button onclick="closeTestModal()" class="px-3 py-1.5 text-sm font-medium text-gray-600 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition">Cancel</button>
            <button onclick="sendTest()" class="px-3 py-1.5 text-sm font-medium text-white bg-gradient-to-r from-[#1a3c6e] to-[#2a5c9e] rounded-lg shadow-sm hover:shadow transition">Send</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function api(url, opts = {}) {
            const res = await fetch(url, {
                headers: {
                    'Content-Type': 'application/json'
                },
                ...opts
            });
            return res.json();
        }

        function showAlert(msg, isSuccess) {
            const el = document.getElementById('formAlert');
            el.classList.remove('hidden', 'bg-red-50', 'text-red-700', 'border-red-200', 'bg-green-50', 'text-green-700', 'border-green-200');
            
            if (isSuccess) {
                el.classList.add('bg-green-50', 'text-green-700', 'border', 'border-green-200');
                el.innerHTML = '<i class="fa fa-circle-check text-green-500"></i><span>' + msg + '</span>';
            } else {
                el.classList.add('bg-red-50', 'text-red-700', 'border', 'border-red-200');
                el.innerHTML = '<i class="fa fa-triangle-exclamation text-red-500"></i><span>' + msg + '</span>';
            }
            
            setTimeout(() => {
                el.classList.add('hidden');
            }, 6000);
        }

        async function loadAll() {
            try {
                const data = await api('/Auth/api/CompanyEmailConfig');
                const tbody = document.getElementById('configTbody');

                if (!Array.isArray(data) || !data.length) {
                    tbody.innerHTML = '<tr><td colspan="6" class="px-4 py-8 text-center text-gray-500">No configurations found.</td></tr>';
                    return;
                }

                tbody.innerHTML = data.map(r => `
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-3 font-medium text-gray-800">${r.companyName || '-'}</td>
                        <td class="px-4 py-3 text-gray-600">${r.smtpHost}</td>
                        <td class="px-4 py-3 text-gray-600">${r.smtpPort}</td>
                        <td class="px-4 py-3 text-gray-600">${r.senderEmail}</td>
                        <td class="px-4 py-3 text-center">
                            <span class="px-2 py-1 text-[10px] font-bold uppercase tracking-wide rounded-full ${r.isActive ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600'}">
                                ${r.isActive ? 'Active' : 'Off'}
                            </span>
                        </td>
                        <td class="px-4 py-3 text-right">
                            <button class="text-[#00BCEB] hover:text-[#1a3c6e] p-1 transition-colors" onclick="editRow(${r.companyId})" title="Edit">
                                <i class="fa fa-pen"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');
            } catch (e) {
                console.error('Failed to load configs', e);
                document.getElementById('configTbody').innerHTML = '<tr><td colspan="6" class="px-4 py-8 text-center text-red-500">Error loading configurations.</td></tr>';
            }
        }

        async function loadConfig(companyId) {
            if (!companyId) return;
            try {
                const d = await api('/Auth/api/CompanyEmailConfig/' + companyId);
                if (d && d.id) {
                    document.getElementById('smtpHost').value = d.smtpHost || '';
                    document.getElementById('smtpPort').value = d.smtpPort || 587;
                    document.getElementById('enableSsl').checked = d.enableSsl;
                    document.getElementById('senderEmail').value = d.senderEmail || '';
                    document.getElementById('senderName').value = d.senderName || '';
                    document.getElementById('smtpUsername').value = d.smtpUsername || '';
                    document.getElementById('smtpPassword').value = ''; 
                }
            } catch (e) {
                console.error('Failed to load config', e);
            }
        }

        function editRow(companyId) {
            document.getElementById('selCompany').value = companyId;
            loadConfig(companyId);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        async function saveConfig() {
            const companyId = document.getElementById('selCompany').value;
            if (!companyId) { 
                showAlert('Please select a company.', false); 
                return; 
            }

            const pw = document.getElementById('smtpPassword').value;

            const body = {
                companyId: parseInt(companyId),
                smtpHost: document.getElementById('smtpHost').value,
                smtpPort: parseInt(document.getElementById('smtpPort').value),
                enableSsl: document.getElementById('enableSsl').checked,
                senderEmail: document.getElementById('senderEmail').value,
                senderName: document.getElementById('senderName').value,
                smtpUsername: document.getElementById('smtpUsername').value,
                smtpPassword: pw || '__KEEP__'  
            };

            const res = await api('/Auth/api/CompanyEmailConfig', {
                method: 'POST',
                body: JSON.stringify(body)
            });
            
            showAlert(res.message, res.success);
            if (res.success) loadAll();
        }

        function openTestModal() {
            if (!document.getElementById('selCompany').value) {
                showAlert('Select a company first to test its configuration.', false);
                return;
            }
            const modal = document.getElementById('testModal');
            const content = document.getElementById('testModalContent');
            modal.classList.remove('hidden');
            setTimeout(() => {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeTestModal() {
            const modal = document.getElementById('testModal');
            const content = document.getElementById('testModalContent');
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }

        async function sendTest() {
            const companyId = document.getElementById('selCompany').value;
            const toEmail = document.getElementById('testEmail').value;
            
            if (!toEmail) { 
                alert('Enter a recipient email.'); 
                return; 
            }

            const res = await api('/Auth/api/CompanyEmailConfig/test/' + companyId, {
                method: 'POST',
                body: JSON.stringify({ toEmail })
            });
            
            closeTestModal();
            showAlert(res.message, res.success);
        }

        function togPw() {
            const inp = document.getElementById('smtpPassword');
            inp.type = inp.type === 'password' ? 'text' : 'password';
            document.getElementById('pwEye').className = inp.type === 'text' ? 'fa fa-eye-slash' : 'fa fa-eye';
        }

        document.addEventListener("DOMContentLoaded", () => {
            loadAll();
        });
    </script>
}
