@{
    ViewData["Title"] = "System Management";
}

<!-- Toast Container -->
<div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2"></div>

<div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-6 py-4 sm:py-6">
    <!-- Header -->
    <div class="mb-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
        <div class="flex items-center gap-2">
            <div class="p-1.5 bg-sky-600 rounded-md">
                <i class="fas fa-cog text-white text-xs"></i>
            </div>
            <div>
                <h1 class="text-lg font-semibold text-gray-900">System Management</h1>
                <p class="text-xs text-gray-500">Manage modules, permissions & menus</p>
            </div>
        </div>
        <button onclick="openMenuModal()" class="w-full sm:w-auto bg-sky-600 hover:bg-sky-700 text-white px-3 py-1.5 rounded-md text-xs font-medium flex items-center justify-center gap-1.5">
            <i class="fas fa-plus"></i>Add Menu
        </button>
    </div>

    <!-- Stats - Compact Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 mb-4" id="statsContainer">
        <!-- Skeleton Loaders -->
        <div class="bg-white rounded-lg border border-gray-100 p-3 animate-pulse">
            <div class="h-3 bg-gray-200 rounded w-16 mb-2"></div>
            <div class="h-5 bg-gray-300 rounded w-12"></div>
        </div>
        <div class="bg-white rounded-lg border border-gray-100 p-3 animate-pulse">
            <div class="h-3 bg-gray-200 rounded w-16 mb-2"></div>
            <div class="h-5 bg-gray-300 rounded w-12"></div>
        </div>
        <div class="bg-white rounded-lg border border-gray-100 p-3 animate-pulse">
            <div class="h-3 bg-gray-200 rounded w-16 mb-2"></div>
            <div class="h-5 bg-gray-300 rounded w-12"></div>
        </div>
        <div class="bg-white rounded-lg border border-gray-100 p-3 animate-pulse">
            <div class="h-3 bg-gray-200 rounded w-16 mb-2"></div>
            <div class="h-5 bg-gray-300 rounded w-12"></div>
        </div>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-3 mb-4">
        <!-- Menus List -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
                <div class="px-3 py-2 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
                    <h2 class="text-xs font-semibold text-gray-700 flex items-center gap-1.5">
                        <i class="fas fa-list-ul text-sky-600 text-xs"></i>
                        Menus <span class="text-gray-400 text-[10px] font-normal" id="menuCount">0</span>
                    </h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full text-xs">
                        <thead class="bg-gray-50/50">
                            <tr>
                                <th class="px-3 py-2 text-left font-medium text-gray-600">Name</th>
                                <th class="px-3 py-2 text-left font-medium text-gray-600">Route</th>
                                <th class="px-3 py-2 text-left font-medium text-gray-600">Module</th>
                                <th class="px-3 py-2 text-right font-medium text-gray-600"></th>
                            </tr>
                        </thead>
                        <tbody id="menuTableBody" class="divide-y divide-gray-100">
                            <tr><td colspan="4" class="px-3 py-4 text-center text-gray-400 text-[10px]">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Modules List -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
                <div class="px-3 py-2 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
                    <h2 class="text-xs font-semibold text-gray-700 flex items-center gap-1.5">
                        <i class="fas fa-cubes text-amber-600 text-xs"></i>
                        Modules <span class="text-gray-400 text-[10px] font-normal" id="moduleCount">0</span>
                    </h2>
                    <button onclick="openModuleModal()" class="text-amber-600 hover:text-amber-700 p-0.5">
                        <i class="fas fa-plus text-[10px]"></i>
                    </button>
                </div>
                <div id="moduleList" class="p-2 space-y-1.5 max-h-[280px] overflow-y-auto">
                    <!-- Dynamic Content -->
                </div>
            </div>
        </div>
    </div>

    <!-- Permissions Section -->
    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
        <div class="px-3 py-2 border-b border-gray-100 bg-gray-50">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                <h2 class="text-xs font-semibold text-gray-700 flex items-center gap-1.5">
                    <i class="fas fa-key text-emerald-600 text-xs"></i>
                    Permissions <span class="text-gray-400 text-[10px] font-normal" id="permissionCount">0</span>
                </h2>
                <div class="flex items-center gap-2 w-full sm:w-auto">
                    <select id="filterController" class="text-[10px] border-gray-200 rounded px-2 py-1 bg-gray-50 w-full sm:w-32">
                        <option value="">All Controllers</option>
                    </select>
                    <button onclick="openPermissionModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-2 py-1 rounded text-[10px] font-medium flex items-center gap-1 whitespace-nowrap">
                        <i class="fas fa-plus"></i>Add
                    </button>
                </div>
            </div>
        </div>
        <div class="overflow-x-auto max-h-72">
            <table class="min-w-full text-xs">
                <thead class="bg-gray-50/50 sticky top-0">
                    <tr>
                        <th class="px-3 py-2 text-left font-medium text-gray-600">Code</th>
                        <th class="px-3 py-2 text-left font-medium text-gray-600">Name</th>
                        <th class="px-3 py-2 text-left font-medium text-gray-600">Module</th>
                        <th class="px-3 py-2 text-left font-medium text-gray-600">Type</th>
                        <th class="px-3 py-2 text-right font-medium text-gray-600"></th>
                    </tr>
                </thead>
                <tbody id="permissionTableBody" class="divide-y divide-gray-100">
                    <tr><td colspan="5" class="px-3 py-4 text-center text-gray-400 text-[10px]">Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Menu Modal - Compact -->
<div id="menuModal" class="hidden fixed inset-0 bg-gray-900/50 z-50 flex items-center justify-center p-3">
    <div class="bg-white rounded-lg w-full max-w-sm">
        <div class="px-4 py-3 border-b border-gray-100 flex justify-between items-center">
            <h3 class="text-sm font-semibold text-gray-900" id="menuModalTitle">Add Menu</h3>
            <button onclick="closeMenuModal()" class="text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>
        <form id="menuForm" class="p-4 space-y-3">
            <input type="hidden" id="menuId">
            <input type="hidden" id="menuIcon" value="fas fa-circle">
            <input type="hidden" id="menuSortOrder" value="0">
            <input type="hidden" id="routeController" value="">
            <input type="hidden" id="routeAction" value="">

            <div class="grid grid-cols-2 gap-2">
                <div class="col-span-2">
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Display Name</label>
                    <input type="text" id="menuName" required class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs" placeholder="e.g. Companies">
                </div>

                <div class="col-span-2">
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Module</label>
                    <select id="menuModuleSelect" required class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                        <option value="">Select Module</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Controller</label>
                    <select id="controllerSelect" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                        <option value="">Select</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Action</label>
                    <select id="actionSelect" disabled class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs disabled:opacity-50">
                        <option value="">Select</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-[10px] font-medium text-gray-600 mb-1">Required Permission</label>
                <select id="menuRequiredPermission" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                    <option value="">None</option>
                </select>
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="closeMenuModal()" class="px-3 py-1.5 text-xs text-gray-600 bg-gray-100 hover:bg-gray-200 rounded">Cancel</button>
                <button type="submit" class="px-3 py-1.5 text-xs text-white bg-sky-600 hover:bg-sky-700 rounded">Save</button>
            </div>
        </form>
    </div>
</div>

<!-- Module Modal - Compact -->
<div id="moduleModal" class="hidden fixed inset-0 bg-gray-900/50 z-50 flex items-center justify-center p-3">
    <div class="bg-white rounded-lg w-full max-w-sm">
        <div class="px-4 py-3 border-b border-gray-100 flex justify-between items-center">
            <h3 class="text-sm font-semibold text-gray-900" id="moduleModalTitle">Manage Module</h3>
            <button onclick="closeModuleModal()" class="text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>
        <form id="moduleForm" class="p-4 space-y-3">
            <input type="hidden" id="moduleId">

            <div>
                <label class="block text-[10px] font-medium text-gray-600 mb-1">Module Name</label>
                <input type="text" id="moduleName" required class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
            </div>

            <div>
                <label class="block text-[10px] font-medium text-gray-600 mb-1">Description</label>
                <input type="text" id="moduleDesc" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
            </div>

            <div>
                <label class="block text-[10px] font-medium text-gray-600 mb-1">Icon (FontAwesome)</label>
                <input type="text" id="moduleIcon" placeholder="fas fa-folder" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="closeModuleModal()" class="px-3 py-1.5 text-xs text-gray-600 bg-gray-100 hover:bg-gray-200 rounded">Cancel</button>
                <button type="submit" class="px-3 py-1.5 text-xs text-white bg-amber-600 hover:bg-amber-700 rounded">Save</button>
            </div>
        </form>
    </div>
</div>

<!-- Permission Modal - Compact -->
<div id="permissionModal" class="hidden fixed inset-0 bg-gray-900/50 z-50 flex items-center justify-center p-3">
    <div class="bg-white rounded-lg w-full max-w-md">
        <div class="px-4 py-3 border-b border-gray-100 flex justify-between items-center">
            <h3 class="text-sm font-semibold text-gray-900" id="permissionModalTitle">Add Permission</h3>
            <button onclick="closePermissionModal()" class="text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>
        <form id="permissionForm" class="p-4 space-y-3">
            <input type="hidden" id="permissionId">

            <div class="bg-emerald-50/50 p-3 rounded border border-emerald-100">
                <label class="block text-[10px] font-medium text-emerald-700 mb-1.5">Discover from Route</label>
                <div class="flex gap-2">
                    <select id="permControllerSelect" class="flex-1 px-2.5 py-1.5 bg-white border border-emerald-200 rounded text-xs">
                        <option value="">Controller</option>
                    </select>
                    <select id="permActionSelect" disabled class="flex-1 px-2.5 py-1.5 bg-white border border-emerald-200 rounded text-xs disabled:opacity-50">
                        <option value="">Action</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div class="col-span-2">
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Permission Code</label>
                    <input type="text" id="permissionCode" required class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                </div>

                <div class="col-span-2">
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Permission Name</label>
                    <input type="text" id="permissionName" required class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                </div>

                <div>
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Module</label>
                    <select id="permissionModuleId" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs"></select>
                </div>

                <div>
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Action Type</label>
                    <select id="permissionActionType" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                        <option>View</option>
                        <option>Create</option>
                        <option>Edit</option>
                        <option>Delete</option>
                        <option>Action</option>
                    </select>
                </div>

                <div class="col-span-2">
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Description</label>
                    <input type="text" id="permissionDescription" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                </div>
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="closePermissionModal()" class="px-3 py-1.5 text-xs text-gray-600 bg-gray-100 hover:bg-gray-200 rounded">Cancel</button>
                <button type="submit" class="px-3 py-1.5 text-xs text-white bg-emerald-600 hover:bg-emerald-700 rounded">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const AUTH_CTRL = '@Url.Content("~/Auth")';
        let _allPermissions = []; // Store for client-side filtering

        // Toast Notification System
        function showToast(message, isError = false) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `flex items-center gap-2 px-3 py-2 rounded shadow-lg text-white text-xs ${
                isError ? 'bg-red-600' : 'bg-green-600'
            }`;
            toast.innerHTML = `
                <i class="fas ${isError ? 'fa-exclamation-circle' : 'fa-check-circle'} text-[10px]"></i>
                <span>${message}</span>
            `;
            container.appendChild(toast);

            setTimeout(() => {
                toast.remove();
            }, 3000);
        }

        $(document).ready(() => {
            // System Management initialized
            loadAllData();
            loadDiscoveredRoutes();
        });

        async function scanAndAddPermissions() {
            sysConfirm("This will scan all controllers and assume permissions/routes. Continue?", function() {
                $('.scan-btn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-2"></i>Scanning...');

                $.ajax({
                    url: '/Auth/ScanPermissions',
                    type: 'POST',
                    success: function (res) {
                        if (res.success) {
                            sysAlert(res.message, "success");
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            sysAlert(res.message, "error");
                            $('.scan-btn').prop('disabled', false).html('<i class="fas fa-search mr-2"></i>Scan & Add Permissions');
                        }
                    },
                    error: function () {
                        sysAlert("Scanning failed", "error");
                        $('.scan-btn').prop('disabled', false).html('<i class="fas fa-search mr-2"></i>Scan & Add Permissions');
                    }
                });
            });
        }

        function seedDatabase() {
            sysConfirm("This will scan all controllers and assume permissions/routes. Continue?", function() {
                $.ajax({
                    url: '@Url.Action("SeedPermissions", "Auth")',
                    type: 'POST',
                    success: (res) => {
                        if(res.success) { showToast(res.message); loadAllData(); }
                        else showToast(res.message, true);
                    },
                    error: () => showToast("Failed to seed database", true)
                });
            });
        }

        function loadDiscoveredRoutes() {
            $.get('@Url.Action("GetDiscoveredRoutes", "Auth")', routes => {
                if(routes && routes.length) {
                    // Group routes by controller for cleaner logic
                    const grouped = {};
                    routes.forEach(r => {
                        if (!grouped[r.controller]) grouped[r.controller] = [];
                        if (!grouped[r.controller].includes(r.action)) {
                            grouped[r.controller].push(r.action);
                        }
                    });

                    window._discoveredRoutes = grouped;

                    // Populate Controller Dropdowns (Menu + Permission + Filter)
                    const controllers = Object.keys(grouped).sort();
                    const options = '<option value="">-- Select Controller --</option>' +
                        controllers.map(c => `<option value="${c}">${c}</option>`).join('');

                    $('#controllerSelect').html(options); // Menu Modal
                    $('#permControllerSelect').html(options); // Permission Modal
                    $('#filterController').html('<option value="">All Controllers</option>' + controllers.map(c => `<option value="${c}">${c}</option>`).join(''));
                }
            });
        }

        // ================== CASCADING DROPDOWNS & FILTERING ==================

        // 1. Menu Modal Logic
        $(document).on('change', '#controllerSelect', function() {
            const ctrl = $(this).val();
            updateActionSelect(ctrl, '#actionSelect');

            // Update hidden fields
            $('#routeController').val(ctrl);
            $('#routeAction').val('');
        });

        $(document).on('change', '#actionSelect', function() {
            const action = $(this).val();
            $('#routeAction').val(action);
        });

        // 2. Permission Modal Logic
        $(document).on('change', '#permControllerSelect', function() {
            const ctrl = $(this).val();
            updateActionSelect(ctrl, '#permActionSelect');

            // Auto-fill Permission Code and Name if both are selected
            $('#permissionCode').val('');
            $('#permissionName').val('');
        });

        $(document).on('change', '#permActionSelect', function() {
           const ctrl = $('#permControllerSelect').val();
           const action = $(this).val();
           if(ctrl && action) {
               const code = `${ctrl}.${action}`; // Default code convention
               $('#permissionCode').val(code);
               $('#permissionName').val(`${action} ${ctrl}`);

               // Auto-detect action type
               let type = 'Action';
               const lower = action.toLowerCase();
               if(lower.includes('index') || lower.includes('details') || lower.includes('view') || lower.includes('get')) type = 'View';
               else if(lower.includes('create') || lower.includes('add') || lower.includes('insert')) type = 'Create';
               else if(lower.includes('edit') || lower.includes('update') || lower.includes('modify')) type = 'Edit';
               else if(lower.includes('delete') || lower.includes('remove')) type = 'Delete';

               $('#permissionActionType').val(type);
           }
        });

        // 3. Filter Logic for Permission Table
        $(document).on('change', '#filterController', function() {
            const selectedCtrl = $(this).val();
            renderPermissionsTable(selectedCtrl);
        });

        function updateActionSelect(ctrl, selector) {
            const actionSel = $(selector);
            if (ctrl && window._discoveredRoutes && window._discoveredRoutes[ctrl]) {
                const actions = window._discoveredRoutes[ctrl].sort();
                actionSel.html('<option value="">-- Select Page --</option>' +
                    actions.map(a => `<option value="${a}">${a}</option>`).join(''));
                actionSel.prop('disabled', false).removeClass('bg-gray-100');
            } else {
                actionSel.html('<option value="">-- Select Page --</option>');
                actionSel.prop('disabled', true).addClass('bg-gray-100');
            }
        }

        function loadAllData() {
            loadStats();
            loadMenus();
            loadModules();
            loadPermissions();
        }

        function loadStats() {
            $.get('@Url.Action("GetStats", "Auth")', stats => {
                if (stats.error) {
                    $('#statsContainer').html(`<div class="col-span-4 bg-red-50 p-3 rounded-lg text-red-600 text-xs border border-red-100"><i class="fas fa-exclamation-triangle mr-1"></i>API Error: ${stats.error}</div>`);
                    return;
                }

                const html = `
                    <div class="bg-white rounded-lg border border-gray-200 p-3 hover:shadow-sm transition">
                        <p class="text-[10px] font-medium text-gray-500 uppercase mb-1">Modules</p>
                        <p class="text-lg font-bold text-gray-800">${stats.modules}</p>
                    </div>
                    <div class="bg-white rounded-lg border border-gray-200 p-3 hover:shadow-sm transition">
                        <p class="text-[10px] font-medium text-gray-500 uppercase mb-1">Permissions</p>
                        <p class="text-lg font-bold text-gray-800">${stats.perms}</p>
                    </div>
                    <div class="bg-white rounded-lg border border-gray-200 p-3 hover:shadow-sm transition">
                        <p class="text-[10px] font-medium text-gray-500 uppercase mb-1">Active Menus</p>
                        <p class="text-lg font-bold text-gray-800">${stats.menus}</p>
                    </div>
                    <div class="bg-white rounded-lg border border-gray-200 p-3 hover:shadow-sm transition">
                        <p class="text-[10px] font-medium text-gray-500 uppercase mb-1">Roles</p>
                        <p class="text-lg font-bold text-gray-800">${stats.roles}</p>
                    </div>
                `;
                $('#statsContainer').html(html);
            }).fail(() => {
                $('#statsContainer').html('<div class="col-span-4 bg-amber-50 p-3 rounded-lg text-amber-600 text-xs border border-amber-100"><i class="fas fa-plug mr-1"></i>Cannot connect to API.</div>');
                showToast("Failed to connect to API", true);
            });
        }

        // ================== MENUS ==================
        function loadMenus() {
             $.get('@Url.Action("GetMenus", "Auth")', menus => {
                $('#menuCount').text(menus.length);
                const rows = menus.map(m => {
                    const link = m.routeController && m.routeAction ? `/${m.routeController}/${m.routeAction}` : '#';
                    return `
                    <tr class="hover:bg-gray-50/50">
                        <td class="px-3 py-2">
                            <div class="flex items-center gap-2">
                                <i class="${m.menuIcon || 'fas fa-link'} text-gray-400 text-[10px]"></i>
                                <span class="text-xs font-medium text-gray-900">${m.menuName}</span>
                                ${m.requiredPermissionCode ? `<span class="px-1.5 py-0.5 bg-amber-50 text-amber-600 rounded text-[8px] font-medium">Req</span>` : ''}
                            </div>
                        </td>
                        <td class="px-3 py-2">
                            <span class="text-[10px] font-mono bg-gray-50 px-1.5 py-0.5 rounded text-gray-600">${m.routeController}/${m.routeAction}</span>
                        </td>
                        <td class="px-3 py-2">
                            <span class="text-[10px] bg-amber-50 text-amber-600 px-1.5 py-0.5 rounded">${m.moduleName || 'Unassigned'}</span>
                        </td>
                        <td class="px-3 py-2 text-right">
                            <button onclick='editMenu(${JSON.stringify(m)})' class="text-sky-600 hover:text-sky-700 mr-1 p-1 rounded hover:bg-sky-50" title="Edit">
                                <i class="fas fa-edit text-[10px]"></i>
                            </button>
                            <button onclick="deleteMenu(${m.id || m.Id})" class="text-red-400 hover:text-red-500 p-1 rounded hover:bg-red-50" title="Delete">
                                <i class="fas fa-trash text-[10px]"></i>
                            </button>
                        </td>
                    </tr>`;
                }).join('');
                $('#menuTableBody').html(rows || '<tr><td colspan="4" class="text-center py-4 text-gray-400 text-[10px]">No menus found</td></tr>');
             }).fail((xhr) => {
                 $('#menuTableBody').html('<tr><td colspan="4" class="text-center py-4 text-red-500 text-[10px]">Failed to load menus</td></tr>');
                 showToast("Failed to load menus", true);
             });
        }

        function deleteMenu(id) {
            sysConfirm('Are you sure you want to delete this menu?', function() {
                $.ajax({
                    url: '/Auth/DeleteMenu/' + id,
                    type: 'POST',
                    success: function (res) {
                        if (res.success) { showToast('Menu deleted'); loadAllData(); }
                        else sysAlert(res.message || 'Failed to delete menu', "error");
                    },
                    error: function (xhr) {
                        var msg = 'Failed to delete menu';
                        if (xhr.status === 404) msg = 'Delete menu action not found. Check MVC controller.';
                        else if (xhr.status === 405) msg = 'Wrong HTTP method for DeleteMenu on MVC controller.';
                        sysAlert(msg, 'error');
                    }
                });
            }, { type: 'danger' });
        }

        // ================== MODULES ==================
        function loadModules() {
             $.get('@Url.Action("GetModules", "Auth")', modules => {
                 $('#moduleCount').text(modules.length);
                 const list = modules.map(m => `
                    <div class="flex items-center justify-between p-2 bg-white rounded border border-gray-100 hover:border-amber-200 transition">
                        <div class="flex items-center min-w-0">
                            <div class="w-6 h-6 rounded bg-amber-50 flex items-center justify-center mr-2">
                                <i class="${m.iconClass || 'fas fa-box'} text-amber-600 text-[10px]"></i>
                            </div>
                            <span class="text-xs font-medium text-gray-800 truncate">${m.moduleName}</span>
                        </div>
                        <button onclick="deleteModule(${m.id || m.Id})" class="text-gray-300 hover:text-red-500 p-0.5 rounded hover:bg-red-50">
                            <i class="fas fa-times text-[8px]"></i>
                        </button>
                    </div>`).join('');
                 $('#moduleList').html(list || '<div class="text-center py-4 text-gray-400 text-[10px]">No modules</div>');
             }).fail((xhr) => {
                 $('#moduleList').html('<div class="text-center text-red-500 text-[10px]">Failed to load modules</div>');
                 showToast("Failed to load modules", true);
             });
        }

        function deleteModule(id) {
            sysConfirm('Delete this module? Assignments will be lost.', function() {
                $.ajax({
                    url: '/Auth/DeleteModule/' + id,
                    type: 'POST',
                    success: function (res) {
                        if (res.success) { showToast('Module deleted'); loadAllData(); }
                        else sysAlert(res.message || 'Failed to delete module', "error");
                    },
                    error: function (xhr) {
                        var msg = 'Failed to delete module';
                        if (xhr.status === 404) msg = 'Delete module action not found. Check MVC controller.';
                        else if (xhr.status === 405) msg = 'Wrong HTTP method for DeleteModule on MVC controller.';
                        sysAlert(msg, 'error');
                    }
                });
            }, { type: 'danger' });
        }

        // ================== PERMISSIONS ==================
        function loadPermissions() {
             $.get('@Url.Action("GetPermissions", "Auth")', perms => {
                 _allPermissions = perms; // Store all loaded permissions
                 $('#permissionCount').text(perms.length);
                 renderPermissionsTable();

                 // Populate Required Permission dropdown in Menu Modal
                 const options = '<option value="">-- No Permission Required --</option>' +
                     perms.sort((a,b) => a.permissionCode.localeCompare(b.permissionCode))
                          .map(p => `<option value="${p.permissionCode}">${p.permissionCode}</option>`).join('');
                 $('#menuRequiredPermission').html(options);
             }).fail((xhr) => {
                 $('#permissionTableBody').html('<tr><td colspan="5" class="text-center py-4 text-red-500 text-[10px]">Failed to load permissions</td></tr>');
                 showToast("Failed to load permissions", true);
             });
        }

        function renderPermissionsTable(filterController = "") {
            let filtered = _allPermissions;
            if (filterController) {
                filtered = filtered.filter(p => {
                    if(p.routeController && p.routeController === filterController) return true;
                    if(p.permissionCode && p.permissionCode.startsWith(filterController + '.')) return true;
                    return false;
                });
            }

            const rows = filtered.map(p => {
                let link = '#';
                if(p.routeController && p.routeAction) link = `/${p.routeController}/${p.routeAction}`;
                else if(p.permissionCode && p.permissionCode.includes('.')) {
                    const parts = p.permissionCode.split('.');
                    if(parts.length == 2) link = `/${parts[0]}/${parts[1]}`;
                }

                return `
                <tr class="hover:bg-gray-50/50">
                    <td class="px-3 py-2">
                        <div class="flex items-center gap-1">
                            <span class="text-[10px] font-mono bg-emerald-50 text-emerald-700 px-1.5 py-0.5 rounded">${p.permissionCode}</span>
                            ${link !== '#' ? `<a href="${link}" target="_blank" class="text-emerald-400 hover:text-emerald-600"><i class="fas fa-external-link-alt text-[8px]"></i></a>` : ''}
                        </div>
                    </td>
                    <td class="px-3 py-2 text-xs text-gray-700">${p.permissionName}</td>
                    <td class="px-3 py-2 text-[10px] text-gray-500">${p.moduleId || '-'}</td>
                    <td class="px-3 py-2">
                        <span class="text-[8px] px-1.5 py-0.5 rounded ${p.actionType === 'View' ? 'bg-indigo-50 text-indigo-600' : 'bg-amber-50 text-amber-600'}">
                            ${p.actionType || 'Action'}
                        </span>
                    </td>
                    <td class="px-3 py-2 text-right">
                        <button onclick='editPermission(${JSON.stringify(p)})' class="text-emerald-600 hover:text-emerald-700 mr-1 p-1 rounded hover:bg-emerald-50">
                            <i class="fas fa-edit text-[10px]"></i>
                        </button>
                        <button onclick="deletePermission(${p.id || p.Id})" class="text-red-400 hover:text-red-500 p-1 rounded hover:bg-red-50">
                            <i class="fas fa-trash text-[10px]"></i>
                        </button>
                    </td>
                </tr>`;
            }).join('');

            $('#permissionTableBody').html(rows || '<tr><td colspan="5" class="text-center py-4 text-gray-400 text-[10px]">No permissions found</td></tr>');
        }

        function deletePermission(id) {
            sysConfirm('Delete this permission?', function() {
                $.ajax({
                    url: '/Auth/DeletePermission/' + id,
                    type: 'POST',
                    success: function (res) {
                        if (res.success) { showToast('Permission deleted'); loadAllData(); }
                        else sysAlert(res.message || 'Failed to delete permission', "error");
                    },
                    error: function (xhr) {
                        var msg = 'Failed to delete permission';
                        if (xhr.status === 404) msg = 'Delete permission action not found. Check MVC controller.';
                        else if (xhr.status === 405) msg = 'Wrong HTTP method for DeletePermission on MVC controller.';
                        sysAlert(msg, 'error');
                    }
                });
            }, { type: 'danger' });
        }

        // Modal helpers
        function openMenuModal(cb) {
            $('#menuModal').removeClass('hidden');
            // Populate Module Dropdown
            $.get('@Url.Action("GetModules", "Auth")', modules => {
                const options = '<option value="">Select Module</option>' +
                    modules.map(m => `<option value="${m.id || m.Id}">${m.moduleName}</option>`).join('');
                $('#menuModuleSelect').html(options);
                if(cb) cb();
            });
        }
        function closeMenuModal() {
            $('#menuModal').addClass('hidden'); $('#menuForm')[0].reset();
            $('#menuId').val('');
            $('#menuIcon').val('fas fa-circle'); $('#menuSortOrder').val('0');
            $('#routeController').val(''); $('#routeAction').val('');
            $('#controllerSelect').val('');
            $('#actionSelect').val('').prop('disabled', true);
            $('#menuRequiredPermission').val('');
            $('#menuModuleSelect').val('');
            $('#menuModalTitle').text('Add Menu');
        }

        function openModuleModal() { $('#moduleModal').removeClass('hidden'); $('#moduleForm')[0].reset(); }
        function closeModuleModal() { $('#moduleModal').addClass('hidden'); }

        function openPermissionModal(cb) {
            $('#permissionModal').removeClass('hidden');
            loadModuleOptionsForPermission(cb);
            $('#permControllerSelect').val('');
            $('#permActionSelect').val('').prop('disabled', true);
        }
        function closePermissionModal() { $('#permissionModal').addClass('hidden'); $('#permissionForm')[0].reset(); }
        function loadModuleOptionsForPermission(cb) { $.get('@Url.Action("GetModules", "Auth")', m => { $('#permissionModuleId').html('<option value="">Select Module</option>' + m.map(x=>`<option value="${x.id || x.Id}">${x.moduleName}</option>`).join('')); if(cb) cb(); }); }

        // Form Submissions
        $('#menuForm').on('submit', function(e) {
            e.preventDefault();
            const controller = $('#routeController').val();
            const action = $('#routeAction').val();

            if (!controller || !action) {
                showToast('Please check both Controller and Page selections', true);
                return;
            }
            const idVal = $('#menuId').val();
            const moduleId = $('#menuModuleSelect').val();

            if (!moduleId) {
                showToast('Please select a Module for this menu', true);
                return;
            }

            const data = {
                id: idVal ? parseInt(idVal) : 0,
                menuName: $('#menuName').val(),
                routeController: controller,
                routeAction: action,
                menuIcon: $('#menuIcon').val() || 'fas fa-circle',
                sortOrder: parseInt($('#menuSortOrder').val()) || 0,
                moduleId: parseInt(moduleId) || 0,
                requiredPermissionCode: $('#menuRequiredPermission').val(),
                isActive: true
            };
            $.ajax({
                url: '@Url.Action("SaveMenu", "Auth")', type: 'POST', contentType: 'application/json',
                data: JSON.stringify(data),
                success: res => {
                    if(res.success) { showToast('Menu saved'); closeMenuModal(); loadAllData(); }
                    else showToast(res.message || 'Failed to save menu', true);
                },
                error: (xhr) => showToast('Failed to save menu', true)
            });
        });

        $('#moduleForm').on('submit', function(e) {
            e.preventDefault();
            const idVal = $('#moduleId').val();
            const data = {
                id: idVal ? parseInt(idVal) : 0,
                moduleName: $('#moduleName').val(),
                description: $('#moduleDesc').val(),
                iconClass: $('#moduleIcon').val(),
                sortOrder: 1, isActive: true
            };
            $.ajax({
                url: '@Url.Action("SaveModule", "Auth")', type: 'POST', contentType: 'application/json',
                data: JSON.stringify(data),
                success: res => {
                    if(res.success) { showToast('Module saved'); closeModuleModal(); loadAllData(); }
                    else showToast(res.message, true);
                },
                error: () => showToast('Failed to save module', true)
            });
        });

        $('#permissionForm').on('submit', function(e) {
            e.preventDefault();
            const idVal = $('#permissionId').val();
            const data = {
                id: idVal ? parseInt(idVal) : 0,
                permissionCode: $('#permissionCode').val(),
                permissionName: $('#permissionName').val(),
                moduleId: $('#permissionModuleId').val(),
                actionType: $('#permissionActionType').val(),
                description: $('#permissionDescription').val(),
                sortOrder: 1, isActive: true,
                routeController: $('#permControllerSelect').val(),
                routeAction: $('#permActionSelect').val()
            };
             $.ajax({
                url: '@Url.Action("SavePermission", "Auth")', type: 'POST', contentType: 'application/json',
                data: JSON.stringify(data),
                success: res => {
                    if(res.success) { showToast('Permission saved'); closePermissionModal(); loadAllData(); }
                    else showToast(res.message, true);
                },
                error: () => showToast('Failed to save permission', true)
            });
        });

        // Edit helpers
        function editMenu(m) {
            openMenuModal(() => {
                $('#menuId').val(m.id || m.Id);
                $('#menuName').val(m.menuName);
                $('#menuModalTitle').text('Edit Menu');

                // Set hidden route fields immediately
                $('#routeController').val(m.routeController);
                $('#routeAction').val(m.routeAction);

                // Set Module
                $('#menuModuleSelect').val(m.moduleId || '');

                // Cascading UI update
                $('#controllerSelect').val(m.routeController);

                // IMPORTANT: Manually update action dropdown and set value WITHOUT triggering 'change' loop
                updateActionSelect(m.routeController, '#actionSelect');
                $('#actionSelect').val(m.routeAction);

                $('#menuIcon').val(m.menuIcon || 'fas fa-circle');
                $('#menuSortOrder').val(m.sortOrder || 0);
                $('#menuRequiredPermission').val(m.requiredPermissionCode || '');
            });
        }
        function editPermission(p) {
             openPermissionModal(() => {
                 $('#permissionId').val(p.id||p.Id); $('#permissionCode').val(p.permissionCode); $('#permissionName').val(p.permissionName);
                 $('#permissionModuleId').val(p.moduleId); $('#permissionActionType').val(p.actionType); $('#permissionDescription').val(p.description);
                 $('#permissionModalTitle').text('Edit Permission');

                 if(p.routeController) {
                     $('#permControllerSelect').val(p.routeController).trigger('change');
                     if(p.routeAction) $('#permActionSelect').val(p.routeAction);
                 } else if (p.permissionCode && p.permissionCode.includes('.')) {
                     const parts = p.permissionCode.split('.');
                     if(parts.length === 2) {
                         $('#permControllerSelect').val(parts[0]).trigger('change');
                         $('#permActionSelect').val(parts[1]);
                     }
                 }
             });
        }
    </script>
}