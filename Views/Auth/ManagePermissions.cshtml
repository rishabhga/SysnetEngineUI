        $('#policyForm').on('submit', function(e) {
            e.preventDefault();
            const id = parseInt($('#policyId').val() || '0');
            const data = {
                Id: id,
                PolicyName: $('#policyName').val(),
                DisplayName: $('#policyDisplayName').val(),
                Category: $('#policyCategory').val(),
                Description: $('#policyDescription').val(),
                CreatedBy: 'WebApp',
                ModifiedBy: 'WebApp',
                IsActive: true
            };

            $.ajax({
                url: '@Url.Action("SavePolicyTemplate", "Auth")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(res) {
                    if (res.success) {
                        showToast(res.message || 'Policy template saved');
                        closePolicyModal();
                        loadPolicyTemplates();
                    } else {
                        showToast(res.message || 'Failed to save policy template', true);
                    }
                },
                error: function() {
                    showToast('Failed to save policy template', true);
                }
            });
        });

      
        $('#menuForm').on('submit', function(e) {
            e.preventDefault();
            const controller = $('#routeController').val();
            const action = $('#routeAction').val();

            if (!controller || !action) {
                showToast('Please check both Controller and Page selections', true);
                return;
            }
            const idVal = $('#menuId').val();
            const moduleId = $('#menuModuleSelect').val();

            if (!moduleId) {
                showToast('Please select a Module for this menu', true);
                return;
            }

            const data = {
                id: idVal ? parseInt(idVal) : 0,
                menuName: $('#menuName').val(),
                routeController: controller,
                routeAction: action,
                menuIcon: $('#menuIcon').val() || 'fas fa-circle',
                sortOrder: parseInt($('#menuSortOrder').val()) || 0,
                moduleId: parseInt(moduleId) || 0,
                parentId: $('#menuParentId').val() ? parseInt($('#menuParentId').val()) : null,
                requiredPermissionCode: $('#menuRequiredPermission').val(),
                visibilityController: $('#visibilityController').val(),
                visibilityAction: $('#visibilityAction').val(),
                isActive: true
            };
            $.ajax({
                url: '@Url.Action("SaveMenu", "Auth")', type: 'POST', contentType: 'application/json',
                data: JSON.stringify(data),
                success: res => {
                    if(res.success) { showToast('Menu saved'); closeMenuModal(); loadAllData(); }
                    else showToast(res.message || 'Failed to save menu', true);
                },
                error: (xhr) => showToast('Failed to save menu', true)
            });
        });

        $('#moduleForm').on('submit', function(e) {
            e.preventDefault();
            const idVal = $('#moduleId').val();
            const data = {
                id: idVal ? parseInt(idVal) : 0,
                moduleName: $('#moduleName').val(),
                description: $('#moduleDesc').val(),
                iconClass: $('#moduleIcon').val(),
                sortOrder: 1, isActive: true
            };
            $.ajax({
                url: '@Url.Action("SaveModule", "Auth")', type: 'POST', contentType: 'application/json',
                data: JSON.stringify(data),
                success: res => {
                    if(res.success) { showToast('Module saved'); closeModuleModal(); loadAllData(); }
                    else showToast(res.message, true);
                },
                error: () => showToast('Failed to save module', true)
            });
        });

        $('#permissionForm').on('submit', function(e) {
            e.preventDefault();
            const idVal = $('#permissionId').val();
            const data = {
                id: idVal ? parseInt(idVal) : 0,
                permissionCode: $('#permissionCode').val(),
                permissionName: $('#permissionName').val(),
                moduleId: $('#permissionModuleId').val(),
                actionType: $('#permissionActionType').val(),
                description: $('#permissionDescription').val(),
                sortOrder: 1, isActive: true,
                routeController: $('#permControllerSelect').val(),
                routeAction: $('#permActionSelect').val()
            };
             $.ajax({
                url: '@Url.Action("SavePermission", "Auth")', type: 'POST', contentType: 'application/json',
                data: JSON.stringify(data),
                success: res => {
                    if(res.success) { showToast('Permission saved'); closePermissionModal(); loadAllData(); }
                    else showToast(res.message, true);
                },
                error: () => showToast('Failed to save permission', true)
            });
        });


        function editMenu(m) {
            openMenuModal(() => {
                $('#menuId').val(m.id || m.Id);
                $('#menuName').val(m.menuName);
                $('#menuModalTitle').text('Edit Menu');

                $('#routeController').val(m.routeController);
                $('#routeAction').val(m.routeAction);

                $('#menuModuleSelect').val(m.moduleId || '');

             
                $('#controllerSelect').val(m.routeController);

                updateActionSelect(m.routeController, '#actionSelect');
                $('#actionSelect').val(m.routeAction);

                $('#menuIcon').val(m.menuIcon || 'fas fa-circle');
                $('#menuSortOrder').val(m.sortOrder || 0);
                $('#menuRequiredPermission').val(m.requiredPermissionCode || '');
                $('#menuParentId').val(m.parentId || '');
                $('#visibilityController').val(m.visibilityController || '').trigger('change');
                if(m.visibilityAction) $('#visibilityAction').val(m.visibilityAction);
            });
        }
        function editPermission(p) {
             openPermissionModal(() => {
                 $('#permissionId').val(p.id||p.Id); $('#permissionCode').val(p.permissionCode); $('#permissionName').val(p.permissionName);
                 $('#permissionModuleId').val(p.moduleId); $('#permissionActionType').val(p.actionType); $('#permissionDescription').val(p.description);
                 $('#permissionModalTitle').text('Edit Permission');

                 if(p.routeController) {
                     $('#permControllerSelect').val(p.routeController).trigger('change');
                     if(p.routeAction) $('#permActionSelect').val(p.routeAction);
                 } else if (p.permissionCode && p.permissionCode.includes('.')) {
                     const parts = p.permissionCode.split('.');
                     if(parts.length === 2) {
                         $('#permControllerSelect').val(parts[0]).trigger('change');
                         $('#permActionSelect').val(parts[1]);
                     }
                 }
             });
        }
    </script>
}