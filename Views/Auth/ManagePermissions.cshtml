@{
    ViewData["Title"] = "System Management";
}

<style>
    .mgmt-header-icon {
        width: 42px; height: 42px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);
        box-shadow: 0 4px 12px rgba(0,188,235,0.3);
    }
    .mgmt-stat {
        background: #fff; border: 1px solid #e2e8f0; border-radius: 14px;
        padding: 14px 16px; position: relative; overflow: hidden; transition: all 0.3s;
    }
    .mgmt-stat::before {
        content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
        border-radius: 14px 14px 0 0;
    }
    .mgmt-stat:hover { transform: translateY(-2px); box-shadow: 0 8px 16px rgba(0,0,0,0.06); }
    .mgmt-stat.s-cyan::before { background: linear-gradient(90deg, #00BCEB, #0096BE); }
    .mgmt-stat.s-emerald::before { background: linear-gradient(90deg, #10b981, #059669); }
    .mgmt-stat.s-amber::before { background: linear-gradient(90deg, #f59e0b, #d97706); }
    .mgmt-stat.s-violet::before { background: linear-gradient(90deg, #8b5cf6, #7c3aed); }
</style>

<!-- Toast Container -->
<div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2"></div>

<div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-6 py-4 sm:py-6">
    <!-- Header -->
    <div class="mb-5 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
        <div class="flex items-center gap-3">
            <div class="mgmt-header-icon">
                <i class="fas fa-cog text-white text-lg"></i>
            </div>
            <div>
                <h1 class="text-xl font-black text-gray-900">System Management</h1>
                <p class="text-xs text-gray-500 mt-0.5">Manage modules, permissions & menus</p>
            </div>
        </div>
        <button onclick="openMenuModal()" class="w-full sm:w-auto text-white px-4 py-2 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 shadow-lg transition hover:shadow-xl" style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%); box-shadow: 0 4px 12px rgba(0,188,235,0.3);">
            <i class="fas fa-plus"></i>Add Menu
        </button>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5" id="statsContainer">
        <div class="mgmt-stat s-amber animate-pulse"><div class="h-3 bg-gray-200 rounded w-16 mb-2"></div><div class="h-6 bg-gray-300 rounded w-12"></div></div>
        <div class="mgmt-stat s-emerald animate-pulse"><div class="h-3 bg-gray-200 rounded w-16 mb-2"></div><div class="h-6 bg-gray-300 rounded w-12"></div></div>
        <div class="mgmt-stat s-cyan animate-pulse"><div class="h-3 bg-gray-200 rounded w-16 mb-2"></div><div class="h-6 bg-gray-300 rounded w-12"></div></div>
        <div class="mgmt-stat s-violet animate-pulse"><div class="h-3 bg-gray-200 rounded w-16 mb-2"></div><div class="h-6 bg-gray-300 rounded w-12"></div></div>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-5">
        <!-- Menus List -->
        <div class="lg:col-span-2">
            <div class="mgmt-card">
                <div class="mgmt-card-header">
                    <h2 class="text-xs font-bold text-gray-700 flex items-center gap-2">
                        <i class="fas fa-list-ul text-xs" style="color: #00BCEB;"></i>
                        Menus <span class="text-gray-400 text-[10px] font-normal ml-1" id="menuCount">0</span>
                    </h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full text-xs">
                        <thead style="background: #f8fafc;">
                            <tr>
                                <th class="px-4 py-2.5 text-left font-semibold text-gray-500 uppercase text-[10px] tracking-wider">Name</th>
                                <th class="px-4 py-2.5 text-left font-semibold text-gray-500 uppercase text-[10px] tracking-wider">Route</th>
                                <th class="px-4 py-2.5 text-left font-semibold text-gray-500 uppercase text-[10px] tracking-wider">Module</th>
                                <th class="px-4 py-2.5 text-left font-semibold text-gray-500 uppercase text-[10px] tracking-wider">Visibility</th>
                                <th class="px-4 py-2.5 text-right font-semibold text-gray-500 uppercase text-[10px] tracking-wider"></th>
                            </tr>
                        </thead>
                        <tbody id="menuTableBody" class="divide-y divide-gray-100">
                            <tr><td colspan="4" class="px-4 py-6 text-center text-gray-400 text-[10px]">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Modules List -->
        <div class="lg:col-span-1">
            <div class="mgmt-card">
                <div class="mgmt-card-header">
                    <h2 class="text-xs font-bold text-gray-700 flex items-center gap-2">
                        <i class="fas fa-cubes text-xs text-amber-500"></i>
                        Modules <span class="text-gray-400 text-[10px] font-normal ml-1" id="moduleCount">0</span>
                    </h2>
                    <button onclick="openModuleModal()" class="w-6 h-6 rounded-lg flex items-center justify-center hover:bg-amber-50 text-amber-500 transition">
                        <i class="fas fa-plus text-[10px]"></i>
                    </button>
                </div>
                <div id="moduleList" class="p-3 space-y-2 max-h-[300px] overflow-y-auto">
                    <!-- Dynamic Content -->
                </div>
            </div>
        </div>
    </div>

    <!-- Permissions Section -->
    <div class="mgmt-card mb-5">
        <div class="mgmt-card-header">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 w-full">
                <h2 class="text-xs font-bold text-gray-700 flex items-center gap-2">
                    <i class="fas fa-key text-xs text-emerald-500"></i>
                    Permissions <span class="text-gray-400 text-[10px] font-normal ml-1" id="permissionCount">0</span>
                </h2>
                <div class="flex items-center gap-2 w-full sm:w-auto">
                    <select id="filterController" class="text-[11px] border border-gray-200 rounded-lg px-3 py-1.5 bg-white w-full sm:w-36 focus:ring-2 focus:ring-emerald-200 focus:border-emerald-400 outline-none">
                        <option value="">All Controllers</option>
                    </select>
                    <button onclick="openPermissionModal()" class="bg-emerald-500 hover:bg-emerald-600 text-white px-3 py-1.5 rounded-lg text-[11px] font-semibold flex items-center gap-1.5 whitespace-nowrap shadow-sm transition">
                        <i class="fas fa-plus text-[9px]"></i>Add
                    </button>
                </div>
            </div>
        </div>
        <div class="overflow-x-auto max-h-80">
            <table class="min-w-full text-xs">
                <thead class="sticky top-0" style="background: #f8fafc;">
                    <tr>
                        <th class="px-4 py-2.5 text-left font-semibold text-gray-500 uppercase text-[10px] tracking-wider">Code</th>
                        <th class="px-4 py-2.5 text-left font-semibold text-gray-500 uppercase text-[10px] tracking-wider">Name</th>
                        <th class="px-4 py-2.5 text-left font-semibold text-gray-500 uppercase text-[10px] tracking-wider">Module</th>
                        <th class="px-4 py-2.5 text-left font-semibold text-gray-500 uppercase text-[10px] tracking-wider">Type</th>
                        <th class="px-4 py-2.5 text-right font-semibold text-gray-500 uppercase text-[10px] tracking-wider"></th>
                    </tr>
                </thead>
                <tbody id="permissionTableBody" class="divide-y divide-gray-100">
                    <tr><td colspan="5" class="px-4 py-6 text-center text-gray-400 text-[10px]">Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="mgmt-card">
        <div class="mgmt-card-header">
            <h2 class="text-xs font-bold text-gray-700 flex items-center gap-2">
                <i class="fas fa-sitemap text-xs text-violet-500"></i>
                Policy Templates <span class="text-gray-400 text-[10px] font-normal ml-1" id="policyTemplateCount">0</span>
            </h2>
            <button onclick="openPolicyModal()" class="bg-violet-500 hover:bg-violet-600 text-white px-3 py-1.5 rounded-lg text-[11px] font-semibold flex items-center gap-1.5 shadow-sm transition">
                <i class="fas fa-plus text-[9px]"></i>Template
            </button>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 p-4">
            <div>
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-2">Templates</p>
                <div id="policyTemplateList" class="space-y-2 max-h-80 overflow-y-auto">
                    <p class="text-gray-400 text-[10px]">Loading templates...</p>
                </div>
            </div>
            <div>
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-2">Permission Editor</p>
                <div class="border border-dashed border-gray-200 rounded-xl p-3 bg-gray-50/50 mb-3">
                    <p class="text-[11px] text-gray-500 flex items-center gap-2">
                        <i class="fas fa-info-circle text-violet-400"></i>
                        Select a template, then check permissions to assign and save.
                    </p>
                </div>
                <div id="policyPermissionEditor" class="max-h-72 overflow-y-auto border border-gray-200 rounded-xl p-3 bg-white">
                    <p class="text-gray-400 text-[10px]">Select a policy template to edit permissions.</p>
                </div>
                <div class="flex justify-end mt-3">
                    <button id="savePolicyPermsBtn" onclick="savePolicyPermissions()" class="bg-violet-500 hover:bg-violet-600 text-white px-4 py-2 rounded-lg text-[11px] font-bold hidden shadow-sm transition">
                        <i class="fas fa-save mr-1.5"></i>Save Template Permissions
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Menu Modal - Compact -->
<div id="menuModal" class="hidden fixed inset-0 bg-gray-900/50 z-50 flex items-center justify-center p-3">
    <div class="bg-white rounded-lg w-full max-w-sm">
        <div class="px-4 py-3 border-b border-gray-100 flex justify-between items-center">
            <h3 class="text-sm font-semibold text-gray-900" id="menuModalTitle">Add Menu</h3>
            <button onclick="closeMenuModal()" class="text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>
        <form id="menuForm" class="p-4 space-y-3">
            <input type="hidden" id="menuId">
            <input type="hidden" id="menuIcon" value="fas fa-circle">
            <input type="hidden" id="menuSortOrder" value="0">
            <input type="hidden" id="routeController" value="">
            <input type="hidden" id="routeAction" value="">

            <div class="grid grid-cols-2 gap-2">
                <div class="col-span-2">
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Display Name</label>
                    <input type="text" id="menuName" required class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs" placeholder="e.g. Companies">
                </div>

                <div class="col-span-2">
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Module</label>
                    <select id="menuModuleSelect" required class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                        <option value="">Select Module</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Controller</label>
                    <select id="controllerSelect" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                        <option value="">Select</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Action</label>
                    <select id="actionSelect" disabled class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs disabled:opacity-50">
                        <option value="">Select</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Parent Menu</label>
                    <select id="menuParentId" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                        <option value="">None (Top Level)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Required Permission</label>
                    <select id="menuRequiredPermission" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                        <option value="">None</option>
                    </select>
                </div>
            </div>

            <div class="bg-blue-50/50 p-2 rounded border border-blue-100">
                <label class="block text-[10px] font-bold text-blue-700 mb-1.5 uppercase tracking-wider">Visibility Context (Optional)</label>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-[9px] font-medium text-blue-600 mb-0.5">Show on Controller</label>
                        <select id="visibilityController" class="w-full px-2 py-1 bg-white border border-blue-200 rounded text-[11px]">
                            <option value="">Always Visible</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[9px] font-medium text-blue-600 mb-0.5">Show on Action</label>
                        <select id="visibilityAction" disabled class="w-full px-2 py-1 bg-white border border-blue-200 rounded text-[11px] disabled:opacity-50">
                            <option value="">All Actions</option>
                        </select>
                    </div>
                </div>
                <p class="text-[9px] text-blue-500 mt-1"><i class="fas fa-info-circle mr-1"></i>If set, this menu only appears on specific pages.</p>
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="closeMenuModal()" class="px-3 py-1.5 text-xs text-gray-600 bg-gray-100 hover:bg-gray-200 rounded">Cancel</button>
                <button type="submit" class="px-3 py-1.5 text-xs text-white bg-sky-600 hover:bg-sky-700 rounded">Save</button>
            </div>
        </form>
    </div>
</div>

<!-- Module Modal - Compact -->
<div id="moduleModal" class="hidden fixed inset-0 bg-gray-900/50 z-50 flex items-center justify-center p-3">
    <div class="bg-white rounded-lg w-full max-w-sm">
        <div class="px-4 py-3 border-b border-gray-100 flex justify-between items-center">
            <h3 class="text-sm font-semibold text-gray-900" id="moduleModalTitle">Manage Module</h3>
            <button onclick="closeModuleModal()" class="text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>
        <form id="moduleForm" class="p-4 space-y-3">
            <input type="hidden" id="moduleId">

            <div>
                <label class="block text-[10px] font-medium text-gray-600 mb-1">Module Name</label>
                <input type="text" id="moduleName" required class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
            </div>

            <div>
                <label class="block text-[10px] font-medium text-gray-600 mb-1">Description</label>
                <input type="text" id="moduleDesc" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
            </div>

            <div>
                <label class="block text-[10px] font-medium text-gray-600 mb-1">Icon (FontAwesome)</label>
                <input type="text" id="moduleIcon" placeholder="fas fa-folder" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="closeModuleModal()" class="px-3 py-1.5 text-xs text-gray-600 bg-gray-100 hover:bg-gray-200 rounded">Cancel</button>
                <button type="submit" class="px-3 py-1.5 text-xs text-white bg-amber-600 hover:bg-amber-700 rounded">Save</button>
            </div>
        </form>
    </div>
</div>

<!-- Permission Modal - Compact -->
<div id="permissionModal" class="hidden fixed inset-0 bg-gray-900/50 z-50 flex items-center justify-center p-3">
    <div class="bg-white rounded-lg w-full max-w-md">
        <div class="px-4 py-3 border-b border-gray-100 flex justify-between items-center">
            <h3 class="text-sm font-semibold text-gray-900" id="permissionModalTitle">Add Permission</h3>
            <button onclick="closePermissionModal()" class="text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>
        <form id="permissionForm" class="p-4 space-y-3">
            <input type="hidden" id="permissionId">

            <div class="bg-emerald-50/50 p-3 rounded border border-emerald-100">
                <label class="block text-[10px] font-medium text-emerald-700 mb-1.5">Discover from Route</label>
                <div class="flex gap-2">
                    <select id="permControllerSelect" class="flex-1 px-2.5 py-1.5 bg-white border border-emerald-200 rounded text-xs">
                        <option value="">Controller</option>
                    </select>
                    <select id="permActionSelect" disabled class="flex-1 px-2.5 py-1.5 bg-white border border-emerald-200 rounded text-xs disabled:opacity-50">
                        <option value="">Action</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div class="col-span-2">
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Permission Code</label>
                    <input type="text" id="permissionCode" required class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                </div>

                <div class="col-span-2">
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Permission Name</label>
                    <input type="text" id="permissionName" required class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                </div>

                <div>
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Module</label>
                    <select id="permissionModuleId" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs"></select>
                </div>

                <div>
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Action Type</label>
                    <select id="permissionActionType" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                        <option>View</option>
                        <option>Create</option>
                        <option>Edit</option>
                        <option>Delete</option>
                        <option>Action</option>
                    </select>
                </div>

                <div class="col-span-2">
                    <label class="block text-[10px] font-medium text-gray-600 mb-1">Description</label>
                    <input type="text" id="permissionDescription" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                </div>
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="closePermissionModal()" class="px-3 py-1.5 text-xs text-gray-600 bg-gray-100 hover:bg-gray-200 rounded">Cancel</button>
                <button type="submit" class="px-3 py-1.5 text-xs text-white bg-emerald-600 hover:bg-emerald-700 rounded">Save</button>
            </div>
        </form>
    </div>
</div>

<div id="policyModal" class="hidden fixed inset-0 bg-gray-900/50 z-50 flex items-center justify-center p-3">
    <div class="bg-white rounded-lg w-full max-w-md">
        <div class="px-4 py-3 border-b border-gray-100 flex justify-between items-center">
            <h3 class="text-sm font-semibold text-gray-900" id="policyModalTitle">Add Policy Template</h3>
            <button onclick="closePolicyModal()" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times text-xs"></i></button>
        </div>
        <form id="policyForm" class="p-4 space-y-3">
            <input type="hidden" id="policyId">
            <div>
                <label class="block text-[10px] font-medium text-gray-600 mb-1">Policy Name</label>
                <input type="text" id="policyName" required class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs" />
            </div>
            <div>
                <label class="block text-[10px] font-medium text-gray-600 mb-1">Display Name</label>
                <input type="text" id="policyDisplayName" required class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs" />
            </div>
            <div>
                <label class="block text-[10px] font-medium text-gray-600 mb-1">Category</label>
                <input type="text" id="policyCategory" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs" />
            </div>
            <div>
                <label class="block text-[10px] font-medium text-gray-600 mb-1">Description</label>
                <input type="text" id="policyDescription" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded text-xs" />
            </div>
            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="closePolicyModal()" class="px-3 py-1.5 text-xs text-gray-600 bg-gray-100 hover:bg-gray-200 rounded">Cancel</button>
                <button type="submit" class="px-3 py-1.5 text-xs text-white bg-violet-600 hover:bg-violet-700 rounded">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const AUTH_CTRL = '@Url.Content("~/Auth")';
        let _allPermissions = []; 
        let _policyTemplates = [];
        let _selectedPolicy = null;

        function showToast(message, isError = false) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `flex items-center gap-2 px-3 py-2 rounded shadow-lg text-white text-xs ${
                isError ? 'bg-red-600' : 'bg-green-600'
            }`;
            toast.innerHTML = `
                <i class="fas ${isError ? 'fa-exclamation-circle' : 'fa-check-circle'} text-[10px]"></i>
                <span>${message}</span>
            `;
            container.appendChild(toast);

            setTimeout(() => {
                toast.remove();
            }, 3000);
        }

        $(document).ready(() => {

            loadAllData();
            loadDiscoveredRoutes();
            loadPolicyTemplates();
        });

        async function scanAndAddPermissions() {
            sysConfirm("This will scan all controllers and assume permissions/routes. Continue?", function() {
                $('.scan-btn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-2"></i>Scanning...');

                $.ajax({
                    url: '/Auth/ScanPermissions',
                    type: 'POST',
                    success: function (res) {
                        if (res.success) {
                            sysAlert(res.message, "success");
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            sysAlert(res.message, "error");
                            $('.scan-btn').prop('disabled', false).html('<i class="fas fa-search mr-2"></i>Scan & Add Permissions');
                        }
                    },
                    error: function () {
                        sysAlert("Scanning failed", "error");
                        $('.scan-btn').prop('disabled', false).html('<i class="fas fa-search mr-2"></i>Scan & Add Permissions');
                    }
                });
            });
        }

        function seedDatabase() {
            sysConfirm("This will scan all controllers and assume permissions/routes. Continue?", function() {
                $.ajax({
                    url: '@Url.Action("SeedPermissions", "Auth")',
                    type: 'POST',
                    success: (res) => {
                        if(res.success) { showToast(res.message); loadAllData(); }
                        else showToast(res.message, true);
                    },
                    error: () => showToast("Failed to seed database", true)
                });
            });
        }

        function loadDiscoveredRoutes() {
            $.get('@Url.Action("GetDiscoveredRoutes", "Auth")', routes => {
                if(routes && routes.length) {
                   
                    const grouped = {};
                    routes.forEach(r => {
                        if (!grouped[r.controller]) grouped[r.controller] = [];
                        if (!grouped[r.controller].includes(r.action)) {
                            grouped[r.controller].push(r.action);
                        }
                    });

                    window._discoveredRoutes = grouped;

          
                    const controllers = Object.keys(grouped).sort();
                    const options = '<option value="">-- Select Controller --</option>' +
                        controllers.map(c => `<option value="${c}">${c}</option>`).join('');

                    $('#controllerSelect').html(options); 
                    $('#permControllerSelect').html(options); 
                    $('#visibilityController').html('<option value="">Always Visible</option>' + controllers.map(c => `<option value="${c}">${c}</option>`).join(''));
                    $('#filterController').html('<option value="">All Controllers</option>' + controllers.map(c => `<option value="${c}">${c}</option>`).join(''));
                }
            });
        }

      
        $(document).on('change', '#controllerSelect', function() {
            const ctrl = $(this).val();
            updateActionSelect(ctrl, '#actionSelect');
       
            $('#routeController').val(ctrl);
            $('#routeAction').val('');
        });

        $(document).on('change', '#visibilityController', function() {
            const ctrl = $(this).val();
            updateActionSelect(ctrl, '#visibilityAction', "-- All Actions --");
        });

        $(document).on('change', '#actionSelect', function() {
            const action = $(this).val();
            $('#routeAction').val(action);
        });

        $(document).on('change', '#permControllerSelect', function() {
            const ctrl = $(this).val();
            updateActionSelect(ctrl, '#permActionSelect');

         
            $('#permissionCode').val('');
            $('#permissionName').val('');
        });

        $(document).on('change', '#permActionSelect', function() {
           const ctrl = $('#permControllerSelect').val();
           const action = $(this).val();
           if(ctrl && action) {
               const code = `${ctrl}.${action}`; 
               $('#permissionCode').val(code);
               $('#permissionName').val(`${action} ${ctrl}`);

        
               let type = 'Action';
               const lower = action.toLowerCase();
               if(lower.includes('index') || lower.includes('details') || lower.includes('view') || lower.includes('get')) type = 'View';
               else if(lower.includes('create') || lower.includes('add') || lower.includes('insert')) type = 'Create';
               else if(lower.includes('edit') || lower.includes('update') || lower.includes('modify')) type = 'Edit';
               else if(lower.includes('delete') || lower.includes('remove')) type = 'Delete';

               $('#permissionActionType').val(type);
           }
        });

 
        $(document).on('change', '#filterController', function() {
            const selectedCtrl = $(this).val();
            renderPermissionsTable(selectedCtrl);
        });

        function updateActionSelect(ctrl, selector, defaultText = "-- Select Page --") {
            const actionSel = $(selector);
            if (ctrl && window._discoveredRoutes && window._discoveredRoutes[ctrl]) {
                const actions = window._discoveredRoutes[ctrl].sort();
                actionSel.html(`<option value="">${defaultText}</option>` +
                    actions.map(a => `<option value="${a}">${a}</option>`).join(''));
                actionSel.prop('disabled', false).removeClass('bg-gray-100');
            } else {
                actionSel.html(`<option value="">${defaultText}</option>`);
                actionSel.prop('disabled', true).addClass('bg-gray-100');
            }
        }

        function loadAllData() {
            loadStats();
            loadMenus();
            loadModules();
            loadPermissions();
        }

        function loadPolicyTemplates() {
            $.get('@Url.Action("GetPolicyTemplates", "Auth")', templates => {
                _policyTemplates = templates || [];
                $('#policyTemplateCount').text(_policyTemplates.length);
                renderPolicyTemplateList();
            }).fail(() => {
                $('#policyTemplateList').html('<p class="text-red-500 text-[10px]">Failed to load policy templates</p>');
            });
        }

        function renderPolicyTemplateList() {
            const list = $('#policyTemplateList');
            if (!_policyTemplates.length) {
                list.html('<p class="text-gray-400 text-[10px]">No policy templates found.</p>');
                return;
            }

            const html = _policyTemplates.map(t => {
                const isSelected = _selectedPolicy && _selectedPolicy.id === t.id;
                return `<div class="p-2 rounded border ${isSelected ? 'border-violet-300 bg-violet-50' : 'border-gray-200 bg-white'}">
                    <div class="flex justify-between items-start gap-2">
                        <button onclick="selectPolicyTemplate(${t.id})" class="text-left flex-1">
                            <p class="text-xs font-semibold text-gray-800">${t.displayName || t.policyName}</p>
                            <p class="text-[10px] text-gray-500">${t.policyName} • ${t.category || 'General'} • ${t.permissionCount || 0} perms</p>
                        </button>
                        <div class="flex items-center gap-1">
                            <button onclick="editPolicyTemplate(${t.id})" class="text-sky-600 hover:text-sky-700 text-[10px]"><i class="fas fa-edit"></i></button>
                            <button onclick="deletePolicyTemplate(${t.id},'${(t.policyName || '').replace(/'/g, "\\'")}')" class="text-red-500 hover:text-red-700 text-[10px]"><i class="fas fa-trash"></i></button>
                        </div>
                    </div>
                </div>`;
            }).join('');
            list.html(html);
        }

        function selectPolicyTemplate(id) {
            const t = (_policyTemplates || []).find(x => x.id === id);
            if (!t) return;
            _selectedPolicy = t;
            renderPolicyTemplateList();

            $.get('@Url.Action("GetPolicyTemplateDetails", "Auth")?id=' + id, detail => {
                const selectedIds = new Set((detail.permissions || []).map(p => p.permissionId));
                const grouped = {};
                (_allPermissions || []).forEach(p => {
                    const module = p.module || p.moduleName || 'General';
                    if (!grouped[module]) grouped[module] = [];
                    grouped[module].push(p);
                });

                const html = Object.keys(grouped).sort().map(module => {
                    const permissions = grouped[module].sort((a,b) => (a.permissionCode || '').localeCompare(b.permissionCode || ''));
                    return `<div class="mb-2">
                        <p class="text-[10px] font-semibold text-gray-700 mb-1">${module}</p>
                        <div class="space-y-1">
                            ${permissions.map(p => `<label class="flex items-center gap-2 text-[10px] text-gray-600">
                                <input type="checkbox" class="policy-perm-checkbox rounded accent-violet-500" value="${p.id || p.Id}" ${selectedIds.has(p.id || p.Id) ? 'checked' : ''} />
                                <span>${p.permissionCode}</span>
                            </label>`).join('')}
                        </div>
                    </div>`;
                }).join('');

                $('#policyPermissionEditor').html(html || '<p class="text-gray-400 text-[10px]">No permissions available.</p>');
                $('#savePolicyPermsBtn').removeClass('hidden');
            }).fail(() => {
                $('#policyPermissionEditor').html('<p class="text-red-500 text-[10px]">Failed to load policy template details.</p>');
                $('#savePolicyPermsBtn').addClass('hidden');
            });
        }

        function openPolicyModal() {
            $('#policyModal').removeClass('hidden');
            $('#policyModalTitle').text('Add Policy Template');
            $('#policyId').val('');
            $('#policyForm')[0].reset();
        }

        function closePolicyModal() {
            $('#policyModal').addClass('hidden');
            $('#policyForm')[0].reset();
            $('#policyId').val('');
        }

        function editPolicyTemplate(id) {
            const t = (_policyTemplates || []).find(x => x.id === id);
            if (!t) return;
            $('#policyModal').removeClass('hidden');
            $('#policyModalTitle').text('Edit Policy Template');
            $('#policyId').val(t.id);
            $('#policyName').val(t.policyName);
            $('#policyDisplayName').val(t.displayName);
            $('#policyCategory').val(t.category);
            $('#policyDescription').val(t.description);
        }

        function deletePolicyTemplate(id, name) {
            sysConfirm(`Delete policy template "${name}"?`, function() {
                $.post('@Url.Action("DeletePolicyTemplate", "Auth")/' + id, function(res) {
                    if (res.success) {
                        showToast(res.message || 'Policy template deleted');
                        if (_selectedPolicy && _selectedPolicy.id === id) {
                            _selectedPolicy = null;
                            $('#policyPermissionEditor').html('<p class="text-gray-400 text-[10px]">Select a policy template to edit permissions.</p>');
                            $('#savePolicyPermsBtn').addClass('hidden');
                        }
                        loadPolicyTemplates();
                    } else {
                        showToast(res.message || 'Failed to delete policy template', true);
                    }
                }).fail(() => showToast('Failed to delete policy template', true));
            }, { type: 'danger' });
        }

        function savePolicyPermissions() {
            if (!_selectedPolicy) return;
            const permissionIds = $('.policy-perm-checkbox:checked').map((i, el) => parseInt($(el).val())).get();
            $.ajax({
                url: '@Url.Action("SetPolicyTemplatePermissions", "Auth")?id=' + _selectedPolicy.id,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ permissionIds: permissionIds }),
                success: function(res) {
                    if (res.success) {
                        showToast(res.message || 'Policy template permissions updated');
                        loadPolicyTemplates();
                        selectPolicyTemplate(_selectedPolicy.id);
                    } else {
                        showToast(res.message || 'Failed to update policy permissions', true);
                    }
                },
                error: function() {
                    showToast('Failed to update policy permissions', true);
                }
            });
        }

