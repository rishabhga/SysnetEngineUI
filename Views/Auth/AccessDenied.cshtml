@{
    Layout = "_Layout";
    ViewData["Title"] = "Access Denied";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card shadow-lg p-4 text-center" style="max-width: 500px;">
        <div class="card-body">
            <h1 class="display-1 text-danger">🚫</h1>
            <h3 class="card-title text-danger mb-4">Access Denied</h3>
            <p class="text-muted">You don't have permission to access this page.</p>
            <p class="text-muted">Please contact your administrator if you believe this is an error.</p>
            
            @if (ViewBag.RequiredPermission != null)
            {
                <div class="alert alert-warning text-start">
                    <h5 class="alert-heading"><i class="fas fa-key me-2"></i>Missing Permission</h5>
                    <p class="mb-0 font-monospace fw-bold text-danger">@ViewBag.RequiredPermission</p>
                </div>
            }

            <div class="alert alert-secondary text-start mt-3">
                <h6 class="alert-heading">Your Access Details:</h6>
                <div class="small">
                    <div><strong>Role:</strong> @(ViewBag.UserRole ?? "None")</div>
                    <div class="mt-1">
                        <strong>Permissions:</strong>
                        @if (!string.IsNullOrEmpty(ViewBag.UserPermissions))
                        {
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @foreach (var p in ((string)ViewBag.UserPermissions).Split(','))
                                {
                                    <span class="badge bg-secondary text-white fw-normal">@p.Trim()</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">None</span>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a asp-controller="Auth" asp-action="Logout" class="btn btn-danger">Logout</a>
                <a asp-controller="Companies" asp-action="Companies" class="btn btn-primary ms-2">Go to Home</a>
            </div>
        </div>
    </div>
</div>
