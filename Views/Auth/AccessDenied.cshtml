@{
    Layout = "_Layout";
    ViewData["Title"] = "Access Denied";
    string? requiredPerm = ViewBag.RequiredPermission as string;
    string? userRole = ViewBag.UserRole as string;
}

<style>
    .denied-card {
        background: linear-gradient(135deg, rgba(15,23,42,0.95) 0%, rgba(7,16,35,0.98) 100%);
        border: 1px solid rgba(239,68,68,0.2);
        border-radius: 20px;
        box-shadow: 0 0 0 1px rgba(239,68,68,0.07) inset, 0 24px 64px rgba(0,0,0,0.45), 0 0 80px rgba(239,68,68,0.05);
        max-width: 480px;
        width: 100%;
        overflow: hidden;
        animation: popIn .5s cubic-bezier(.22,.68,0,1.2) both;
    }

    @@keyframes popIn {
        from {
            opacity: 0;
            transform: scale(.94) translateY(16px);
        }

        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .denied-top-line {
        height: 3px;
        background: linear-gradient(90deg, transparent, #ef4444, transparent);
    }

    .lock-ring {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: radial-gradient(circle at 35% 35%, rgba(239,68,68,0.25), rgba(239,68,68,0.08));
        border: 1.5px solid rgba(239,68,68,0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 30px rgba(239,68,68,0.15);
        animation: pulse 2.5s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            box-shadow: 0 0 30px rgba(239,68,68,0.15);
        }

        50% {
            box-shadow: 0 0 45px rgba(239,68,68,0.30);
        }
    }

    .perm-tag {
        background: rgba(239,68,68,0.08);
        border: 1px solid rgba(239,68,68,0.2);
        border-left: 3px solid #ef4444;
        border-radius: 8px;
        padding: .65rem .9rem;
    }

    .role-tag {
        background: rgba(6,182,212,0.07);
        border: 1px solid rgba(6,182,212,0.18);
        border-radius: 6px;
        padding: .2rem .65rem;
        font-size: .7rem;
        color: #7dd3fc;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

    .btn-logout {
        background: transparent;
        border: 1px solid rgba(239,68,68,0.35);
        border-radius: 10px;
        color: #fca5a5;
        font-size: .8rem;
        font-weight: 600;
        padding: .6rem 1.25rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        transition: all .25s;
    }

        .btn-logout:hover {
            background: rgba(239,68,68,0.1);
            border-color: #ef4444;
            color: #fca5a5;
        }

    .btn-home {
        background: linear-gradient(135deg, rgba(6,182,212,0.5), rgba(2,132,199,0.55));
        border: 1px solid rgba(6,182,212,0.4);
        border-radius: 10px;
        color: #fff;
        font-size: .8rem;
        font-weight: 600;
        padding: .6rem 1.25rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        transition: all .25s;
    }

        .btn-home:hover {
            background: linear-gradient(135deg, rgba(6,182,212,0.7), rgba(2,132,199,0.75));
            box-shadow: 0 0 20px rgba(6,182,212,0.3);
            color: #fff;
        }

    .grid-bg {
        background-image: linear-gradient(rgba(239,68,68,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(239,68,68,0.03) 1px, transparent 1px);
        background-size: 40px 40px;
        position: absolute;
        inset: 0;
        border-radius: 20px;
        pointer-events: none;
    }
</style>

<div class="d-flex align-items-center justify-content-center" style="min-height:72vh; padding: 2rem 1rem;">
    <div class="denied-card position-relative">
        <div class="grid-bg"></div>
        <div class="denied-top-line"></div>

        <div class="p-4 p-sm-5 text-center position-relative" style="z-index:1;">

            <div class="d-flex justify-content-center mb-4">
                <div class="lock-ring">
                    <i class="fas fa-lock" style="font-size:1.6rem;color:#f87171;"></i>
                </div>
            </div>

            <h2 style="font-family:'Rajdhani',sans-serif;font-size:1.6rem;font-weight:700;letter-spacing:.04em;color:#f1f5f9;margin-bottom:.35rem;">
                Access Denied
            </h2>
            <p style="color:#94a3b8;font-size:.8rem;max-width:320px;margin:0 auto 1.25rem;">
                You don't have permission to view this page. Contact your administrator if you believe this is an error.
            </p>

            @if (!string.IsNullOrEmpty(userRole))
            {
                <div class="d-flex justify-content-center mb-3">
                    <span class="role-tag">
                        <i class="fas fa-id-badge" style="font-size:.65rem;"></i>
                        Your role: <strong style="color:#e2f8ff;">@userRole</strong>
                    </span>
                </div>
            }

            @if (!string.IsNullOrEmpty(requiredPerm))
            {
                <div class="perm-tag text-start mb-4">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="fas fa-key" style="color:#fbbf24;font-size:.75rem;"></i>
                        <span style="font-size:.7rem;font-weight:600;color:#fde68a;letter-spacing:.04em;text-transform:uppercase;">Required Permission</span>
                    </div>
                    <code style="font-size:.78rem;color:#fca5a5;background:rgba(239,68,68,0.1);padding:2px 10px;border-radius:6px;display:inline-block;">
                        @requiredPerm
                    </code>
                </div>
            }

            <div style="height:1px;background:linear-gradient(90deg,transparent,rgba(239,68,68,0.2),transparent);margin:1.25rem 0;"></div>

            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-controller="Auth" asp-action="Logout" class="btn-logout">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
                <a asp-controller="Companies" asp-action="Companies" class="btn-home">
                    <i class="fas fa-home"></i> Go to Home
                </a>
            </div>

            <p class="mt-4" style="font-size:.7rem;color:#475569;">
                Need access?
                <a href="mailto:admin@sysnet.com" style="color:#67e8f9;text-decoration:none;">Contact your system administrator</a>
            </p>
        </div>
    </div>
</div>

<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@700&display=swap" rel="stylesheet" />
