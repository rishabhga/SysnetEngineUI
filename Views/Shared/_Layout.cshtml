@{
    var username = Context.Session.GetString("username");
    var userRole = Context.Session.GetString("role");
    var isSuperAdmin = userRole == "SuperAdmin";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SYSNET</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/bootbox.min.js"></script>
    <script src="~/js/bootstrap-datepicker.min.js"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ManageEngineWebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">
    <link href="~/css/prettify.css" rel="stylesheet" />
    <link href="~/css/datepicker.css" rel="stylesheet" />
    <link href="~/css/Custom.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap">

    <style>
        * {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: #f9fafb;
        }

        main {
            flex: 1;
            padding-top: 2rem;
            padding-bottom: 2rem;
        }

        /* Navigation Styles */
        .nav-gradient {
            background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 50%, #0369a1 100%);
            box-shadow: 0 4px 6px -1px rgba(14, 165, 233, 0.1), 0 2px 4px -1px rgba(14, 165, 233, 0.06);
        }

        .logo-container {
            transition: transform 0.3s ease;
        }

            .logo-container:hover {
                transform: translateY(-2px);
            }

            .logo-container img {
                filter: brightness(0) invert(1);
                height: 32px;
                width: auto;
            }

        /* Dropdown Styles */
        .dropdown {
            position: relative;
        }

        .dropdown-menu {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            margin-top: 0.5rem;
            min-width: 280px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            z-index: 50;
            opacity: 0;
            transform: translateY(-8px);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
        }

        .dropdown:hover .dropdown-menu {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }

        .dropdown-header {
            padding: 1.25rem;
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
            border-bottom: 1px solid #e0e7ff;
        }

        .dropdown-menu a {
            display: flex;
            align-items: center;
            padding: 0.75rem 1.25rem;
            font-size: 0.875rem;
            font-weight: 500;
            color: #374151;
            transition: all 0.15s ease;
            text-decoration: none;
            border-left: 3px solid transparent;
        }

            .dropdown-menu a:hover {
                background: linear-gradient(90deg, #eff6ff 0%, #dbeafe 100%);
                color: #0369a1;
                border-left-color: #0ea5e9;
            }

            .dropdown-menu a i {
                width: 20px;
                margin-right: 0.875rem;
                font-size: 1rem;
                transition: transform 0.2s;
            }

            .dropdown-menu a:hover i {
                transform: scale(1.15);
            }

        .dropdown-divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, #e5e7eb, transparent);
            margin: 0.5rem 0;
        }

        .logout-btn {
            color: #dc2626 !important;
        }

            .logout-btn:hover {
                background: linear-gradient(90deg, #fef2f2 0%, #fee2e2 100%) !important;
                border-left-color: #dc2626 !important;
            }

        /* Profile Button */
        .profile-btn {
            background: white;
            border: 1px solid rgba(255, 255, 255, 0.3);
            backdrop-filter: blur(10px);
            padding: 0.5rem 1rem;
            border-radius: 12px;
            transition: all 0.2s ease;
        }

            .profile-btn:hover {
                background: rgba(255, 255, 255, 0.95);
                border-color: rgba(14, 165, 233, 0.3);
                box-shadow: 0 4px 12px rgba(14, 165, 233, 0.15);
                transform: translateY(-1px);
            }

        .profile-avatar {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: white;
            font-size: 0.875rem;
            box-shadow: 0 2px 8px rgba(245, 158, 11, 0.3);
        }

        .dropdown-avatar {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: white;
            font-size: 1.125rem;
            box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
        }

        /* Badge Styles */
        .badge-superadmin {
            background: linear-gradient(135deg, #b4d334 0%, #8fb829 100%);
            color: white;
            padding: 0.375rem 0.875rem;
            border-radius: 8px;
            font-size: 0.75rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            box-shadow: 0 2px 8px rgba(180, 211, 52, 0.3);
            letter-spacing: 0.025em;
        }

        .badge-role {
            background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
            color: white;
            padding: 0.375rem 0.875rem;
            border-radius: 8px;
            font-size: 0.75rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            box-shadow: 0 2px 8px rgba(14, 165, 233, 0.3);
        }

        /* Footer Styles */
        .footer-gradient {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: #94a3b8;
        }

        .footer-logo {
            height: 36px;
            width: auto;
            opacity: 0.9;
            transition: opacity 0.3s ease;
        }

            .footer-logo:hover {
                opacity: 1;
            }

        .footer-link {
            color: #94a3b8;
            transition: color 0.2s ease;
            text-decoration: none;
        }

            .footer-link:hover {
                color: #0ea5e9;
            }

        /* DataTables Styling */
        .dataTables_length,
        .dataTables_filter {
            display: none !important;
        }

        .no-footer {
            border-radius: 8px;
            border: 1px solid #e5e7eb;
            background-color: white;
        }

        .dataTables_info {
            margin-left: 10px;
            font-size: 0.875rem;
            color: #6b7280;
        }

        .paginate_button {
            font-size: 0.875rem;
        }

        .bhead {
            text-align: center;
            padding: 0.75rem;
            background-color: #f9fafb;
            border-radius: 8px;
        }

        .table_head_color {
            background-color: #f9fafb;
        }

        table.dataTable thead th,
        table.dataTable thead td {
            padding: 0.75rem;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Navigation -->
    <nav class="nav-gradient sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <a href="@Url.Action("Companies", "Companies")" class="logo-container flex items-center space-x-3">
                    <img src="~/images/footer-logo.png" alt="SYSNET Logo" />
                </a>
                <div class="flex items-center space-x-4">
                    @if (currentController == "ComputerSummary" && currentAction == "Deshboad")
                    {
                        <div class="relative">
                            <button id="notificationBell"
                                    class="w-9 h-9 rounded-full bg-white shadow flex items-center justify-center hover:bg-sky-50 border border-gray-200 relative">
                                <i class="fas fa-bell text-gray-600 text-sm"></i>
                                <span id="notificationBadge"
                                      class="hidden absolute -top-1 -right-1 bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full">
                                    0
                                </span>
                            </button>

                            <div id="notificationPanel"
                                 class="hidden absolute right-0 mt-2 w-80 bg-white rounded-xl shadow-2xl border border-gray-200 z-50">
                                <div class="px-3 py-2 border-b flex items-center justify-between">
                                    <span class="text-xs font-semibold text-gray-700">Notifications</span>
                                    <span class="text-[10px] text-gray-400" id="notificationCountLabel">0 new</span>
                                </div>
                                <div id="notificationList" class="max-h-80 overflow-y-auto text-xs">
                                </div>
                            </div>
                        </div>
                    }

                    <!-- User Menu (same for all pages, including groups and dashboard) -->
                    <div class="dropdown">
                        <button class="profile-btn flex items-center space-x-3">
                            <div class="profile-avatar">
                                @(username?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <div class="text-left hidden sm:block">
                                <p class="text-sm font-semibold text-gray-900">@username</p>
                                <p class="text-xs text-gray-500">@(isSuperAdmin ? "Super Admin" : userRole)</p>
                            </div>
                            <i class="fas fa-chevron-down text-xs text-gray-400"></i>
                        </button>
                        <div class="dropdown-menu">
                            <div class="dropdown-header">
                                <div class="flex items-center space-x-3 mb-3">
                                    <div class="dropdown-avatar">
                                        @(username?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <div>
                                        <p class="text-xs text-gray-500 font-medium">Signed in as</p>
                                        <p class="font-bold text-gray-900">@username</p>
                                    </div>
                                </div>
                                @if (isSuperAdmin)
                                {
                                    <span class="badge-superadmin">
                                        <i class="fas fa-crown mr-1.5"></i>Super Admin
                                    </span>
                                }
                                else if (!string.IsNullOrEmpty(userRole))
                                {
                                    <span class="badge-role">
                                        <i class="fas fa-user mr-1.5"></i>@userRole
                                    </span>
                                }
                            </div>

                            <div class="py-2">
                                @{
                                    var dynamicMenus = await ManageEngineWebApp.Datacontext.RoleHelper.GetDynamicMenusAsync();
                                    var authorizedMenus = dynamicMenus.Where(m => ManageEngineWebApp.Datacontext.RoleHelper.HasPermission(Context, m.RequiredPermissionCode)).OrderBy(m => m.SortOrder).ToList();
                                }

                                @foreach (var menu in authorizedMenus)
                                {
                                    <a href="@Url.Action(menu.RouteAction, menu.RouteController)"
                                       class="@(currentController == menu.RouteController && currentAction == menu.RouteAction ? "active" : "")">
                                        <i class="@menu.MenuIcon"></i>
                                        <span>@menu.MenuName</span>
                                    </a>
                                }

                                @if (isSuperAdmin || ManageEngineWebApp.Datacontext.RoleHelper.HasPermission(Context, "ServiceDesk.View"))
                                {
                                    <div class="dropdown-divider"></div>
                                    <a asp-controller="ServiceDesk" asp-action="Index"
                                       class="@(currentController == "ServiceDesk" && currentAction == "Index" ? "active" : "")">
                                        <i class="fas fa-headset"></i>
                                        <span>Service Desk</span>
                                    </a>
                                }
                                @if (isSuperAdmin)
                                {
                                    <a asp-controller="Auth" asp-action="ManagePermissions"
                                       class="@(currentController == "Auth" && currentAction == "ManagePermissions" ? "active" : "")">
                                        <i class="fas fa-tools"></i>
                                        <span>System Management</span>
                                    </a>
                                    <a asp-controller="Auth" asp-action="ManageRoles"
                                       class="@(currentController == "Auth" && currentAction == "ManageRoles" ? "active" : "")">
                                        <i class="fas fa-user-shield"></i>
                                        <span>Manage Roles</span>
                                    </a>
                                }

                                <div class="dropdown-divider"></div>

                                <a asp-controller="Auth" asp-action="Logout" class="logout-btn">
                                    <i class="fas fa-sign-out-alt"></i>
                                    <span>Logout</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
    </nav>

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer-gradient mt-auto">
        <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
                <div class="flex items-center space-x-3">
                    <img src="~/images/footer-logo.png" alt="SYSNET" class="footer-logo" />
                </div>

                <div class="text-xs">
                    <p>&copy; @DateTime.Now.Year SYSNET.</p>
                </div>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
