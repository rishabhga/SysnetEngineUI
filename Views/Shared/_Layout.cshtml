@{
    var username = Context.Session.GetString("username");
    var userRole = Context.Session.GetString("role");
    var isSuperAdmin = userRole == "SuperAdmin";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SYSNET</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/bootbox.min.js"></script>
    <script src="~/js/bootstrap-datepicker.min.js"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ManageEngineWebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap">

    <style>
        * {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        body {
            background-color: #f8fafc;
            color: #1e293b;
        }

        /* Sidebar Custom Styles */
        .sidebar {
            background-color: #ffffff;
            color: #64748b;
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            width: 280px;
            border-right: 1px solid #e2e8f0;
        }

        .sidebar.collapsed {
            width: 0;
            padding: 0;
            border: none;
        }

        .sidebar.collapsed .sidebar-item span,
        .sidebar.collapsed .sidebar-category,
        .sidebar.collapsed .sidebar-profile .profile-details,
        .sidebar.collapsed .logo-text {
            display: none;
        }

        .sidebar.collapsed .sidebar-item {
            justify-content: center;
            padding: 0.75rem 0;
            margin: 0.5rem auto;
            width: 44px;
        }

        .sidebar.collapsed .sidebar-item i {
            margin-right: 0;
            font-size: 1.25rem;
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            padding: 0.75rem 1.25rem;
            border-radius: 0.75rem;
            margin: 0.25rem 1rem;
            font-weight: 500;
            font-size: 0.875rem;
            transition: all 0.2s ease;
            text-decoration: none;
            color: #64748b;
            white-space: nowrap;
            overflow: hidden;
        }

        .sidebar-item:hover {
            background-color: #f1f5f9;
            color: #0ea5e9;
        }

        .sidebar-item.active {
            background: linear-gradient(135deg, #06b6d4 0%, #2563eb 100%);
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
        }

        .sidebar-item i {
            width: 24px;
            font-size: 1.125rem;
            margin-right: 0.75rem;
            transition: all 0.2s;
            text-align: center;
        }

        .sidebar-item:hover i, .sidebar-item.active i {
            transform: scale(1.1);
        }

        .sidebar-category {
            font-size: 0.625rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #94a3b8;
            margin: 1.5rem 1.75rem 0.5rem;
            white-space: nowrap;
        }

        /* Profile Section */
        .sidebar-profile {
            border-top: 1px solid #f1f5f9;
            padding: 1.25rem 1rem;
            margin-top: auto;
            background-color: #ffffff;
        }

        .avatar-initial {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #06b6d4 0%, #2563eb 100%);
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: white;
            box-shadow: 0 4px 10px rgba(37, 99, 235, 0.15);
        }

        .sidebar.collapsed .avatar-initial {
            width: 36px;
            height: 36px;
            margin: 0 auto;
        }

        /* Header / Top Bar */
        .top-bar {
            height: 64px;
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem;
            position: sticky;
            top: 0;
            z-index: 40;
        }

        .toggle-btn {
            width: 36px;
            height: 36px;
            border-radius: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #64748b;
            cursor: pointer;
            transition: all 0.2s;
        }

        .toggle-btn:hover {
            background-color: #f1f5f9;
            color: #0ea5e9;
        }

        /* Content Area Transition */
        .main-content {
            transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Logo Logic */
        .nav-logo {
            display: none;
        }

        #sidebar.collapsed ~ .flex-grow .nav-logo {
            display: flex;
        }

        #sidebar.collapsed .sidebar-logo-container {
            display: none;
        }

        /* Scrollbar */
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 20px; }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body class="flex h-screen overflow-hidden">
    <aside id="sidebar" class="sidebar flex-shrink-0 flex flex-col h-full z-50">
        <!-- Logo -->
        <div class="px-5 py-6 flex items-center justify-center sidebar-logo-container">
            <div class="flex-shrink-0 flex items-center justify-center">
                <img src="~/images/footer-logo.png" alt="Sysnet" class="w-32 h-auto" />
            </div>
        </div>

        <!-- Scrollable Menu -->
        <div class="flex-grow overflow-y-auto custom-scrollbar pb-6 mt-2">
            <div class="sidebar-category text-blue-600/50">Main Menu</div>
            <nav>
                <a href="@Url.Action("Companies", "Companies")" class="sidebar-item @(currentController == "Companies" ? "active" : "")">
                    <i class="fas fa-th-large"></i>
                    <span>Dashboard</span>
                </a>
                
                @{
                    var dynamicMenus = await ManageEngineWebApp.Datacontext.RoleHelper.GetDynamicMenusAsync();
                    var authorizedMenus = dynamicMenus.Where(m => ManageEngineWebApp.Datacontext.RoleHelper.HasPermission(Context, m.RequiredPermissionCode)).OrderBy(m => m.SortOrder).ToList();
                }

                @foreach (var menu in authorizedMenus)
                {
                    <a href="@Url.Action(menu.RouteAction, menu.RouteController)"
                       class="sidebar-item @(currentController == menu.RouteController && currentAction == menu.RouteAction ? "active" : "")">
                        <i class="@menu.MenuIcon"></i>
                        <span>@menu.MenuName</span>
                    </a>
                }
            </nav>

            @if (isSuperAdmin)
            {
                <div class="sidebar-category text-blue-600/50">Administration</div>
                <nav>
                    <a asp-controller="ServiceDesk" asp-action="Index"
                       class="sidebar-item @(currentController == "ServiceDesk" ? "active" : "")">
                        <i class="fas fa-headset"></i>
                        <span>Service Desk</span>
                    </a>
                    <a asp-controller="Auth" asp-action="ManagePermissions"
                       class="sidebar-item @(currentController == "Auth" && currentAction == "ManagePermissions" ? "active" : "")">
                        <i class="fas fa-shield-halved"></i>
                        <span>Permissions</span>
                    </a>
                    <a asp-controller="Auth" asp-action="ManageRoles"
                       class="sidebar-item @(currentController == "Auth" && currentAction == "ManageRoles" ? "active" : "")">
                        <i class="fas fa-users-gear"></i>
                        <span>User Roles</span>
                    </a>
                </nav>
            }
        </div>

        <!-- Profile Section -->
        <div class="sidebar-profile">
            <div class="flex items-center gap-3">
                <div class="avatar-initial flex-shrink-0">
                    @(username?.Substring(0, 1).ToUpper() ?? "U")
                </div>
                <div class="flex-grow min-w-0 profile-details">
                    <p class="text-slate-900 font-bold text-sm truncate">@username</p>
                    <p class="text-[10px] text-blue-600 font-semibold uppercase tracking-wider">@(isSuperAdmin ? "Super Admin" : userRole)</p>
                </div>
                <a asp-controller="Auth" asp-action="Logout" class="text-slate-400 hover:text-red-500 transition-colors ml-auto" title="Logout">
                    <i class="fas fa-sign-out-alt text-lg"></i>
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-grow flex flex-col min-w-0 overflow-hidden relative">
        <!-- Top Bar -->
        <header class="top-bar">
            <div class="flex items-center gap-3">
                <button type="button" id="toggleSidebar" class="toggle-btn">
                    <i class="fas fa-bars"></i>
                </button>
                
                <!-- Nav Logo (Shown only when sidebar is collapsed) -->
                <div class="nav-logo flex items-center ml-2">
                    <div class="flex items-center justify-center">
                        <img src="~/images/footer-logo.png" alt="Sysnet" class="w-24 h-auto" />
                    </div>
                </div>
            </div>
            
            <div class="flex items-center gap-4">
                @if (currentController == "ComputerSummary" && currentAction == "Deshboad")
                {
                    <div class="relative">
                        <button id="notificationBell"
                                class="w-10 h-10 rounded-xl bg-white shadow-sm flex items-center justify-center hover:bg-gray-50 border border-gray-200 relative transition-all">
                            <i class="fas fa-bell text-gray-500 text-lg"></i>
                            <span id="notificationBadge"
                                  class="hidden absolute -top-1 -right-1 bg-red-500 text-white text-[10px] font-bold h-5 w-5 flex items-center justify-center rounded-full border-2 border-white">
                                0
                            </span>
                        </button>

                        <div id="notificationPanel"
                             class="hidden absolute right-0 mt-2 w-80 bg-white rounded-xl shadow-2xl border border-gray-200 z-50 overflow-hidden">
                            <div class="px-4 py-3 bg-gray-50 border-b flex items-center justify-between">
                                <span class="text-sm font-bold text-gray-700">Notifications</span>
                                <span class="bg-sky-100 text-sky-600 text-[10px] font-bold px-2 py-0.5 rounded-full" id="notificationCountLabel">0 New</span>
                            </div>
                            <div id="notificationList" class="max-h-80 overflow-y-auto">
                                <!-- Notifications here -->
                            </div>
                        </div>
                    </div>
                }
                
                <div class="h-8 w-[1px] bg-gray-200 mx-2"></div>
                
                <div class="flex items-center gap-3">
                     <span class="text-xs font-semibold text-gray-500">Welcome, <span class="text-gray-900">@username</span></span>
                </div>
            </div>
        </header>

        <!-- Dynamic Content -->
        <main class="flex-grow overflow-y-auto custom-scrollbar bg-slate-50/50">
            @RenderBody()
        </main>
        
        <!-- Subtle Footer in Main Content if needed -->
    </div>

    @await RenderSectionAsync("Scripts", required: false)
    
    <script>
        // Sidebar Toggle Persistence
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('toggleSidebar');
        
        const isCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';
        if (isCollapsed) sidebar.classList.add('collapsed');

        toggleBtn.addEventListener('click', () => {
            sidebar.classList.toggle('collapsed');
            localStorage.setItem('sidebar-collapsed', sidebar.classList.contains('collapsed'));
        });

        // Notification Logic
        const bell = document.getElementById('notificationBell');
        const panel = document.getElementById('notificationPanel');
        if(bell && panel) {
            bell.addEventListener('click', (e) => {
                e.stopPropagation();
                panel.classList.toggle('hidden');
            });
            document.addEventListener('click', (e) => {
                if(!bell.contains(e.target) && !panel.contains(e.target)) panel.classList.add('hidden');
            });
        }
    </script>
</body>
</html>
