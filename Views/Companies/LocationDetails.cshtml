   <script>
        function downloadInstaller(locationId, groupId, companyId, locationName) {
            // Disable all download buttons
            const buttons = $('.btn-primary');
            buttons.prop('disabled', true);

            const clickedButton = event.currentTarget;
            const originalHtml = clickedButton.innerHTML;
            clickedButton.innerHTML = `<span class="spinner-border spinner-border-sm"></span> Downloading...`;

            const requestData = {
                CompanyId: companyId,
                GroupId: groupId,
                LocationId: locationId,
                LocationName: locationName
            };

            $.ajax({
                url: '/Installer/GenerateInstaller',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(requestData),
                xhrFields: {
                    responseType: 'blob'  // ?? important for binary file
                },
                success: function (blob) {
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');

                    const safeLocation = locationName.replace(/[^a-zA-Z0-9]/g, '_');
                    a.href = url;
                    a.download = `${safeLocation}_C${companyId}_G${groupId}_Installer.exe`;

                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    window.URL.revokeObjectURL(url);
                },
                error: function (xhr, status, error) {
                    sysAlert('Download failed: ' + error, "error");
                },
                complete: function () {
                    buttons.prop('disabled', false);
                    clickedButton.innerHTML = originalHtml;
                }
            });
        }

   </script>
   
    

</body>
</html>



