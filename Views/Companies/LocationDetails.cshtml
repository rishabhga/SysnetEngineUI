@model IEnumerable<Locations>
@{
    ViewData["Title"] = $"{ViewBag.CompanyName} - {ViewBag.groupName} - Locations";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
}

<!DOCTYPE html>
<html>
<head>

    <title>Computer</title>
    <link href="~/css/font-awesome.css" rel="stylesheet" type="text/css" />
    <link href="~/css/font-awesome.min.css" rel="stylesheet" type="text/css" />

    <link href="~/css/prettify.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" />

    <link rel="stylesheet" type="text/css" href="~/css/Custom.css" />
    <link href="~/css/datepicker.css" rel="stylesheet" />
    <script src="js/bootbox.min.js"></script>
    <script src="js/bootstrap.min.js"></script>
    <script src="js/bootstrap-datepicker.min.js"></script>
    <link href="../CSS/font-awesome.min.css" rel="stylesheet" />

    <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
    <link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <style>
        .margin {
            margin: 30px 20px 10px 20px;
        }

        .dataTables_length {
            display: none !important;
        }

        .dataTables_filter {
            display: none !important;
        }

        .no-footer {
            border-radius: 5px;
            border: 1px solid rgb(225, 227, 232);
            background-color: #f2f4f7;
        }

        .dataTables_info {
            margin-left: 10px;
            font-size: 12px;
        }

        .paginate_button {
            font-size: 12px;
        }

        /* #example_info {
                                    display: none !important;
                                }

                                #example_paginate {
                                    display: none !important;
                                }*/

        .bhead {
            text-align: center;
            padding: 10px;
            background-color: #f2f4f7;
        }

        .table_head_color {
            background-color: #f2f4f7;
            /*border-radius: 5px;
                                    border: 1px solid rgb(225, 227, 232);*/
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 10px 10px;
        }

    </style>
</head>

<body>
    <div class="bhead">
        <h4 style="margin-bottom: 0px;"><strong>@ViewBag.CompanyName -  @ViewBag.groupName - Locations </strong></h4>
    </div>



    
    <div class="margin">
        <div id="datatablesholder1">
            <table class="table table-bordered font-monospace">
                <thead>
                    <tr>
                        <th>S.N</th>                        
                        <th>LocationName</th>
                        <th>Alert Status</th>
                        <th>Download EXE</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Group</td>
                        <td>
                            <input type="text" id="newlocationName" class="form-control" placeholder="Enter new Location" />
                            <input type="hidden" id="locationIdHidden" value="@ViewBag.CompanyId" />
                            <input type="hidden" id="locationgroupIdHidden" value="@ViewBag.groupId" />
                        </td>
                        <td>
                            <div class="checkbox">
                                <label><input type="checkbox" id="newLocationCritical"> Critical</label>
                            </div>
                        </td>
                        <td>
                            <button id="addlocationInlineBtn" class="btn btn-success"><i class="fas fa-plus-circle"></i> Add</button>
                        </td>
                    </tr>

                    @foreach (var item in Model)
                    {

                        <tr>
                            
                            <td>@item.Id</td>
                            @* <td>@item.LocationName</td> *@
                            <td class="location-name-cell" data-id="@item.Id" data-group-id="@item.GroupsID" data-company-id="@item.CompanyID">
                                <span class="display-name">@item.LocationName</span>
                                <input type="text" class="edit-name form-control d-none" value="@item.LocationName" style="width: 150px; display: inline-block;" />
                                <button class="btn btn-sm btn-warning d-none update-btn">Update</button>
                            </td>
                            <td>
                                <button onclick="toggleLocationCritical(@item.Id, @item.IsCritical.ToString().ToLower(), @item.GroupsID, @item.CompanyID)" 
                                        class="btn btn-sm @(item.IsCritical ? "btn-danger" : "btn-default")"
                                        title="@(item.IsCritical ? "Highly Critical - Click to demote" : "Mark as Critical")">
                                    <i class="fas fa-crown"></i> @(item.IsCritical ? "Critical" : "Standard")
                                </button>
                            </td>

                            <td>
                               @*  <a href="/Companies/Dwonload?locationId=@item.Id&&groupid=@item.GroupsID&&comId=@item.CompanyID"><i class="fa fa-download"></i></a> *@
                                <button class="btn btn-primary" onclick="downloadInstaller(@item.Id, @item.GroupsID, @item.CompanyID,'@item.LocationName')"><i class="fa fa-download"></i></button>

                            </td>

                            <td>
                                <a href="/ComputerSummary/Deshboad?locationId=@item.Id&&locationName=@item.LocationName&&groupid=@item.GroupsID&&groupName=@ViewBag.groupName&&comId=@item.CompanyID&&companyName=@ViewBag.CompanyName">view Branch</a>
                                
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
    <div style="margin: 10px 20px;">
        <a href="/Companies/GroupsDetails?id=@ViewBag.CompanyId&companyName=@ViewBag.CompanyName" class="btn btn-primary">
            <i class="fas fa-arrow-left"></i> Back to Groups
        </a>
    </div>
    <script src="~/js/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

    <script>
        $("#addlocationInlineBtn").click(function () {
            const locatioName = $("#newlocationName").val().trim();
            const groupid = $("#locationgroupIdHidden").val();
            const comid = $("#locationIdHidden").val();
            const isCritical = $("#newLocationCritical").is(":checked");
            if (locatioName === "" || groupid === "" || comid ==="") {
                sysAlert("Please enter a location name.", "warning");
                return;
            }

            $.ajax({
                url: '/Companies/LocationAdd',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ LocationName: locatioName, GroupsID: groupid, CompanyID: comid, IsCritical: isCritical }),
                success: function (response) {
                    sysAlert("Location added successfully!", "success");
                    setTimeout(() => location.reload(), 1500);
                },
                error: function () {
                    sysAlert("Error adding location.", "error");
                }
            });
        });

        function toggleLocationCritical(locationId, currentStatus, groupId, companyId) {
            const newStatus = !currentStatus;
            const locationName = $(`.location-name-cell[data-id="${locationId}"] .display-name`).text().trim();

            $.ajax({
                url: '/Companies/Locationupdate',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    Id: parseInt(locationId),
                    IsCritical: newStatus,
                    GroupsID: parseInt(groupId),
                    CompanyID: parseInt(companyId),
                    LocationName: locationName
                }),
                success: function() {
                    location.reload();
                },
                error: function(xhr) {
                    sysAlert('Error updating critical status', 'error');
                }
            });
        }
    </script>
    <script>
        $(document).ready(function () {
            // When company name cell is clicked
            $(".location-name-cell").on("click", function () {
                const $cell = $(this);
                $cell.find(".display-name").hide();
                $cell.find(".edit-name, .update-btn").removeClass("d-none");
            });

            // When Update button is clicked
            $(".update-btn").on("click", function (e) {
                e.stopPropagation();

                const $btn = $(this);
                const $cell = $btn.closest(".location-name-cell");
                const newName = $cell.find(".edit-name").val().trim();
                const Idlo = $cell.data("id");
                const groupId = $cell.data("group-id");
                const compId = $cell.data("company-id");

                if (newName === "") {
                    sysAlert("Location name cannot be empty.", "warning");
                    return;
                }
                
                // AJAX Call to Update
                $.ajax({
                    url: '/Companies/Locationupdate',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ Id: Idlo, GroupsID: groupId, CompanyID: compId, LocationName: newName }),
                    success: function (response) {
                        $cell.find(".display-name").text(newName).show();
                        $cell.find(".edit-name, .update-btn").addClass("d-none");
                        sysAlert("Location updated successfully!", "success");
                    },
                    error: function () {
                        sysAlert("Error updating Location.", "error");
                    }
                });
            });
        });
    </script>

