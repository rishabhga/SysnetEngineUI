@model List<ManageEngineWebApp.Dtos.CompanyHierarchyDto>
@{
    ViewData["Title"] = "Companies - SYSNET";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var username = Context.Session.GetString("username");

    var activeComputers = ViewBag.ActiveComputers as List<string> ?? new List<string>();

    var totalCompanies = Model?.Count ?? 0;
    var totalGroups = Model?.Sum(c => c.Groups?.Count ?? 0) ?? 0;
    var totalLocations = Model?.Sum(c => c.Groups?.Sum(g => g.Locations?.Count ?? 0) ?? 0) ?? 0;
    var totalUsers = Model?.Sum(c => c.Groups?.Sum(g => g.Locations?.Sum(l => l.Users?.Count ?? 0) ?? 0) ?? 0) ?? 0;

    var activeCount = 0;
    if (Model != null)
    {
        foreach (var company in Model)
        {
            if (company.Groups != null)
            {
                foreach (var group in company.Groups)
                {
                    if (group.Locations != null)
                    {
                        foreach (var location in group.Locations)
                        {
                            if (location.Users != null)
                            {
                                foreach (var user in location.Users)
                                {
                                    var userDomain = user.DomainName?.Trim().ToUpper() ?? "";
                                    if (!string.IsNullOrEmpty(userDomain) && activeComputers.Contains(userDomain))
                                    {
                                        activeCount++;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

<div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-6">
    <!-- Header -->
    <div class="mb-4 flex items-center justify-between">
        <div>
            <h1 class="text-xl font-bold text-gray-900">Companies</h1>
            <p class="text-xs text-gray-600 mt-0.5">Manage your organization's companies</p>
        </div>
        @if (ManageEngineWebApp.Datacontext.RoleHelper.HasPermission(Context, "Companies.Create"))
        {
            <button onclick="openAddCompanyModal()"
                    class="px-3 py-1.5 text-white rounded-lg text-sm font-medium transition-colors flex items-center space-x-1.5 shadow-sm"
                    style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                <i class="fas fa-plus text-xs"></i>
                <span>Add Company</span>
            </button>
        }
    </div>



    <!-- Stats Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 mb-4">
        <div class="bg-white rounded-lg border border-gray-200 p-2.5 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[10px] font-medium text-gray-500 uppercase">Total Companies</p>
                    <p class="text-lg font-bold text-gray-900 mt-0.5">@totalCompanies</p>
                </div>
                <div class="w-9 h-9 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                    <i class="fas fa-building text-white text-sm"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-2.5 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[10px] font-medium text-gray-500 uppercase">Total Locations</p>
                    <p class="text-lg font-bold text-gray-900 mt-0.5">@totalLocations</p>
                </div>
                <div class="w-9 h-9 bg-orange-500 rounded-lg flex items-center justify-center">
                    <i class="fas fa-map-marker-alt text-white text-sm"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-2.5 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[10px] font-medium text-gray-500 uppercase">Online Devices</p>
                    <p class="text-lg font-bold text-gray-900 mt-0.5">@activeCount</p>
                </div>
                <div class="w-9 h-9 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #B4D334 0%, #8FB829 100%);">
                    <i class="fas fa-check-circle text-white text-sm"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-2.5 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[10px] font-medium text-gray-500 uppercase">Total Devices</p>
                    <p class="text-lg font-bold text-gray-900 mt-0.5">@totalUsers</p>
                </div>
                <div class="w-9 h-9 bg-purple-500 rounded-lg flex items-center justify-center">
                    <i class="fas fa-desktop text-white text-sm"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Debug -->
    <div class="mb-4 flex gap-2">
        <div class="flex-1 relative">
            <input type="text" id="searchCompanies"
                   class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:border-transparent text-sm"
                   placeholder="Search companies, groups, or locations...">
            <div class="absolute right-3 top-1/2 transform -translate-y-1/2">
                <i class="fas fa-search text-gray-400 text-sm"></i>
            </div>
        </div>

    </div>

    <!-- Companies Grid -->
    @if (Model != null && Model.Any())
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
            @foreach (var company in Model)
            {
                var companyOnline = 0;
                var companyTotalUsers = 0;

                if (company.Groups != null)
                {
                    foreach (var group in company.Groups)
                    {
                        if (group.Locations != null)
                        {
                            foreach (var location in group.Locations)
                            {
                                if (location.Users != null)
                                {
                                    companyTotalUsers += location.Users.Count;
                                    foreach (var user in location.Users)
                                    {
                                        var userDomain = user.DomainName?.Trim().ToUpper() ?? "";
                                        if (!string.IsNullOrEmpty(userDomain) && activeComputers.Contains(userDomain))
                                        {
                                            companyOnline++;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                var companyGroups = company.Groups?.Count ?? 0;
                var companyLocations = company.Groups?.Sum(g => g.Locations?.Count ?? 0) ?? 0;

                <div class="bg-white rounded-lg shadow-md overflow-hidden border border-gray-200 h-72 flex flex-col">
                    <div class="bg-white border-b border-gray-200 p-2.5 flex-shrink-0">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-2">
                                @{
                                    var baseUrl = ViewBag.ApiBaseUrl as string ?? "";
                                }
                                @if (!string.IsNullOrEmpty(company.LogoUrl))
                                {
                                    <div class="w-8 h-8 rounded-lg flex items-center justify-center overflow-hidden border border-gray-100 bg-white">
                                        <img src="/Companies/Logo?path=@Uri.EscapeDataString(company.LogoUrl)"
                                             alt="@company.CompanyName"
                                             class="max-h-6 object-contain"
                                             onerror="
                                             var p=this.parentElement;
                                             if (p) {
                                             p.innerHTML='<i class=\' fas fa-building text-white text-sm\'></i>';
                                        p.style.background = 'linear-gradient(135deg, #00BCEB 0%, #0096BE 100%)';
                                        }
                                        this.onerror = null;
                                        " />
                                    </div>
                                }
                                else
                                {
                                    <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                                        <i class="fas fa-building text-white text-sm"></i>
                                    </div>
                                }
                                <div>
                                    <h3 class="text-sm font-semibold text-gray-900">@company.CompanyName</h3>
                                    <p class="text-[10px] text-gray-500">@companyOnline/@companyTotalUsers Online</p>
                                </div>
                            </div>
                                @if (ManageEngineWebApp.Datacontext.RoleHelper.HasPermission(Context, "Companies.Create"))
                                {
                                    <button onclick="openEditCompanyModal(@company.CompanyId, '@company.CompanyName')"
                                            class="w-7 h-7 hover:bg-gray-100 rounded-lg flex items-center justify-center transition-colors"
                                            title="Edit Company">
                                        <i class="fas fa-edit text-xs"></i>
                                    </button>
                                }
                        </div>
                    </div>
                    <!-- Groups -->
                    <div class="p-2.5 bg-white flex-grow overflow-y-auto">
                        @if (company.Groups != null && company.Groups.Any())
                        {
                            <div class="space-y-1.5">
                                @foreach (var group in company.Groups)
                                {
                                    var groupOnline = 0;
                                    var groupUsers = 0;

                                    if (group.Locations != null)
                                    {
                                        foreach (var location in group.Locations)
                                        {
                                            if (location.Users != null)
                                            {
                                                groupUsers += location.Users.Count;
                                                foreach (var user in location.Users)
                                                {
                                                    var userDomain = user.DomainName?.Trim().ToUpper() ?? "";
                                                    if (!string.IsNullOrEmpty(userDomain) && activeComputers.Contains(userDomain))
                                                    {
                                                        groupOnline++;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    var groupLocations = group.Locations?.Count ?? 0;

                                    <div class="flex items-center justify-between p-1.5 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                                        <div class="flex items-center space-x-1.5">
                                            <div class="w-6 h-6 rounded flex items-center justify-center" style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                                                <i class="fas fa-layer-group text-white text-[10px]"></i>
                                            </div>
                                            <div>
                                                <p class="text-xs font-semibold text-gray-900 truncate max-w-[100px]">@group.GroupName</p>
                                                <p class="text-[10px] text-gray-500">@groupOnline/@groupUsers Online · @groupLocations Loc</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="flex items-center justify-center h-full">
                                <div class="text-center">
                                    <div class="w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-1">
                                        <i class="fas fa-layer-group text-gray-400 text-sm"></i>
                                    </div>
                                    <p class="text-xs text-gray-600">No groups</p>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="p-2.5 bg-white border-t border-gray-200 flex-shrink-0">
                        <a href="/Companies/GroupsDetails?id=@company.CompanyId&companyName=@Uri.EscapeDataString(company.CompanyName)"
                           class="w-full px-2 py-1.5 text-white rounded-lg text-xs font-medium transition-colors flex items-center justify-center space-x-1"
                           style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                            <i class="fas fa-eye text-[10px]"></i>
                            <span>View Details</span>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-12 bg-white rounded-lg border border-gray-200 shadow-sm">
            <i class="fas fa-building text-4xl text-gray-300 mb-3"></i>
            <p class="text-gray-500 text-sm">No companies found</p>
            <button onclick="openAddCompanyModal()"
                    class="mt-4 px-4 py-2 text-white rounded-lg text-sm font-medium transition-colors"
                    style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                <i class="fas fa-plus mr-1.5"></i>
                Add Your First Company
            </button>
        </div>
    }
</div>

<!-- Add Company Modal -->
<div id="addCompanyModal" class="modal fixed inset-0 bg-black bg-opacity-50 items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-sm mx-4">
        <div class="px-4 py-3 rounded-t-lg" style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
            <h3 class="text-sm font-bold text-white">Add New Company</h3>
        </div>
        <div class="p-4">
            <div class="mb-3">
                <label class="block text-xs font-medium text-gray-700 mb-1.5">
                    <i class="fas fa-building mr-1" style="color: #00BCEB;"></i> Company Name
                </label>
                <input type="text" id="addCompanyName"
                       class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:border-transparent"
                       placeholder="Enter company name" autocomplete="off" />
                <p id="addCompanyNameError" class="text-red-600 text-[10px] mt-1" style="display:none;"></p>
            </div>
            <div class="mb-3">
                <label class="block text-xs font-medium text-gray-700 mb-1.5">
                    <i class="fas fa-image mr-1" style="color: #00BCEB;"></i> Company Logo
                </label>
                <input type="file" id="addCompanyLogo" accept="image/*"
                       class="w-full text-sm text-gray-500 file:mr-4 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-sky-50 file:text-sky-700 hover:file:bg-sky-100" />
            </div>
            <div class="flex space-x-2 mt-4">
                <button type="button" onclick="closeAddCompanyModal()"
                        class="flex-1 px-3 py-1.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 text-sm font-medium transition-colors">
                    Cancel
                </button>
                <button type="button" id="addCompanyBtn" onclick="handleAddCompany()"
                        class="flex-1 px-3 py-1.5 text-white rounded-lg text-sm font-medium transition-colors"
                        style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                    Add
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Company Modal -->
<div id="editCompanyModal" class="modal fixed inset-0 bg-black bg-opacity-50 items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-sm mx-4">
        <div class="px-4 py-3 rounded-t-lg" style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
            <h3 class="text-sm font-bold text-white">Edit Company</h3>
        </div>
        <div class="p-4">
            <input type="hidden" id="editCompanyId" />
            <div class="mb-3">
                <label class="block text-xs font-medium text-gray-700 mb-1.5">
                    <i class="fas fa-building mr-1" style="color: #00BCEB;"></i> Company Name
                </label>
                <input type="text" id="editCompanyName"
                       class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:border-transparent"
                       placeholder="Enter company name" autocomplete="off" />
                <p id="editCompanyNameError" class="text-red-600 text-[10px] mt-1" style="display:none;"></p>
            </div>
            <div class="mb-3">
                <label class="block text-xs font-medium text-gray-700 mb-1.5">
                    <i class="fas fa-image mr-1" style="color: #00BCEB;"></i> Update Logo
                </label>
                <input type="file" id="editCompanyLogo" accept="image/*"
                       class="w-full text-sm text-gray-500 file:mr-4 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-sky-50 file:text-sky-700 hover:file:bg-sky-100" />
            </div>
            <div class="flex space-x-2 mt-4">
                <button type="button" onclick="closeEditCompanyModal()"
                        class="flex-1 px-3 py-1.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 text-sm font-medium transition-colors">
                    Cancel
                </button>
                <button type="button" id="updateCompanyBtn" onclick="handleUpdateCompany()"
                        class="flex-1 px-3 py-1.5 text-white rounded-lg text-sm font-medium transition-colors"
                        style="background: linear-gradient(135deg, #00BCEB 0%, #0096BE 100%);">
                    Update
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .modal {
        display: none;
    }

        .modal.active {
            display: flex !important;
        }
</style>

<script>
    function openAddCompanyModal() {
        document.getElementById('addCompanyModal').classList.add('active');
        document.getElementById('addCompanyName').value = '';
        document.getElementById('addCompanyLogo').value = '';
        document.getElementById('addCompanyNameError').style.display = 'none';
    }

    function closeAddCompanyModal() {
        document.getElementById('addCompanyModal').classList.remove('active');
        document.getElementById('addCompanyName').value = '';
        document.getElementById('addCompanyLogo').value = '';
        document.getElementById('addCompanyNameError').style.display = 'none';
        var btn = document.getElementById('addCompanyBtn');
        btn.disabled = false;
        btn.innerHTML = 'Add';
    }

    function openEditCompanyModal(id, name) {
        document.getElementById('editCompanyModal').classList.add('active');
        document.getElementById('editCompanyId').value = id;
        document.getElementById('editCompanyName').value = name;
        document.getElementById('editCompanyLogo').value = '';
        document.getElementById('editCompanyNameError').style.display = 'none';
    }

    function closeEditCompanyModal() {
        document.getElementById('editCompanyModal').classList.remove('active');
        document.getElementById('editCompanyId').value = '';
        document.getElementById('editCompanyName').value = '';
        document.getElementById('editCompanyLogo').value = '';
        document.getElementById('editCompanyNameError').style.display = 'none';
        var btn = document.getElementById('updateCompanyBtn');
        btn.disabled = false;
        btn.innerHTML = 'Update';
    }

    window.onclick = function(e) {
        if (e.target.classList.contains('modal')) {
            e.target.classList.remove('active');
        }
    };

    // Validation
    function validateCompanyName(name) {
        if (!name || name.trim().length === 0) return 'Company name is required';
        if (name.trim().length < 2) return 'Must be at least 2 characters';
        if (name.trim().length > 100) return 'Must not exceed 100 characters';
        if (!/^[a-zA-Z0-9\s\-&.()]+$/.test(name)) return 'Invalid characters';
        return null;
    }

    function handleAddCompany() {
        var name = document.getElementById('addCompanyName').value.trim();
        var error = document.getElementById('addCompanyNameError');
        var btn = document.getElementById('addCompanyBtn');

        error.style.display = 'none';
        var validationError = validateCompanyName(name);

        if (validationError) {
            error.textContent = validationError;
            error.style.display = 'block';
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i>Saving...';

        $.ajax({
            url: '/Companies/CheckCompanyName',
            type: 'GET',
            data: { name: name },
            success: function(res) {
                console.log('Check Response:', res);
                var exists = (res && res.exists === true) || (Array.isArray(res) && res.length > 0);

                if (exists) {
                    error.textContent = 'Company already exists';
                    error.style.display = 'block';
                    btn.disabled = false;
                    btn.innerHTML = 'Add';
                } else {
                    $.ajax({
                        url: '/Companies/CompanyAdd',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            CompanyName: name
                        }),
                        success: function(response) {
                            console.log('Add Response:', response);
                            var newCompanyId = response.id || response.Id;
                            var fileInput = document.getElementById('addCompanyLogo');

                            if (fileInput.files.length > 0 && newCompanyId) {
                                var formData = new FormData();
                                formData.append('logo', fileInput.files[0]);
                                formData.append('companyId', newCompanyId);
                                
                                $.ajax({
                                    url: '/Companies/UploadLogo',
                                    type: 'POST',
                                    data: formData,
                                    processData: false,
                                    contentType: false,
                                    success: function() {
                                        closeAddCompanyModal();
                                        showSuccessMessage('Company and logo added successfully');
                                        setTimeout(function() { location.reload(); }, 500);
                                    },
                                    error: function() {
                                        closeAddCompanyModal();
                                        showSuccessMessage('Company added but logo upload failed');
                                        setTimeout(function() { location.reload(); }, 1000);
                                    }
                                });
                            } else {
                                closeAddCompanyModal();
                                showSuccessMessage('Company added successfully');
                                setTimeout(function() { location.reload(); }, 500);
                            }
                        },
                        error: function(xhr, status, err) {
                            console.error('Add Error:', xhr.status, xhr.responseText);
                            error.textContent = 'Error adding company';
                            error.style.display = 'block';
                            btn.disabled = false;
                            btn.innerHTML = 'Add';
                        }
                    });
                }
            },
            error: function(xhr, status, err) {
                console.error('Check Error:', xhr.status, xhr.responseText);
                error.textContent = 'Error checking name';
                error.style.display = 'block';
                btn.disabled = false;
                btn.innerHTML = 'Add';
            }
        });
    }

    function handleUpdateCompany() {
        var id = document.getElementById('editCompanyId').value;
        var name = document.getElementById('editCompanyName').value.trim();
        var error = document.getElementById('editCompanyNameError');
        var btn = document.getElementById('updateCompanyBtn');

        error.style.display = 'none';
        var validationError = validateCompanyName(name);

        if (validationError) {
            error.textContent = validationError;
            error.style.display = 'block';
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i>Updating...';

        // Update company
        $.ajax({
            url: '/Companies/UpdateCompany',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                Id: parseInt(id),
                CompanyName: name
            }),
            success: function(response) {
                console.log('Update Response:', response);
                var fileInput = document.getElementById('editCompanyLogo');
                var currentCompanyId = parseInt(id);

                if (fileInput.files.length > 0 && currentCompanyId) {
                    var formData = new FormData();
                    formData.append('logo', fileInput.files[0]);
                    formData.append('companyId', currentCompanyId);
                    
                    $.ajax({
                        url: '/Companies/UploadLogo',
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        success: function() {
                            closeEditCompanyModal();
                            showSuccessMessage('Company and logo updated successfully');
                            setTimeout(function() { location.reload(); }, 500);
                        },
                        error: function() {
                            closeEditCompanyModal();
                            showSuccessMessage('Company updated but logo upload failed');
                            setTimeout(function() { location.reload(); }, 1000);
                        }
                    });
                } else {
                    closeEditCompanyModal();
                    showSuccessMessage('Company updated successfully');
                    setTimeout(function() { location.reload(); }, 500);
                }
            },
            error: function(xhr, status, err) {
                console.error('Update Error:', xhr.status, xhr.responseText);
                error.textContent = 'Error updating company';
                error.style.display = 'block';
                btn.disabled = false;
                btn.innerHTML = 'Update';
            }
        });
    }

        function showSuccessMessage(message) {
        const notification = document.createElement('div');
        notification.className = 'fixed top-4 right-4 bg-green-500 text-white px-4 py-3 rounded-lg shadow-lg z-50 flex items-center space-x-2';
        notification.innerHTML = `
            <i class="fas fa-check-circle"></i>
            <span>${message}</span>
        `;

        document.body.appendChild(notification);

        setTimeout(() => {
            notification.style.opacity = '0';
            notification.style.transition = 'opacity 0.3s';
            setTimeout(() => notification.remove(), 300);
        }, 3000);
    }




    $(document).ready(function() {
        $('#searchCompanies').on('keyup', function() {
            var term = $(this).val().toLowerCase().trim();
            $('.grid > div').each(function() {
                $(this).toggle(!term || $(this).text().toLowerCase().indexOf(term) > -1);
            });
        });
    });
</script>

